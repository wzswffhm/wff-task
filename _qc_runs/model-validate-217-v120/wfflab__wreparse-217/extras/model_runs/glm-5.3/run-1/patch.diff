+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation. See the contract under docs/
+#
+# Canonical form used for every comparison and for the report:
+#   * full (rooted) path with '.' and '..' collapsed and '/' folded to '\'
+#   * no trailing directory separator, except for a volume root ('C:\')
+#   * original casing preserved - never lower-cased, because the report must
+#     show the on-disk spelling the operator can act on
+# Only Get-WReparseCanonicalPath / Test-WReparseWithinRoot /
+# Resolve-WReparseLinkTarget are exported (see WReparse.psm1); everything else
+# in this file is module-private.
+
+$script:WReparseDirectorySeparator = [string][char]0x5C   # '\'
+$script:WReparseAltSeparator = [string][char]0x2F         # '/'
+$script:WReparseSeparatorChars = @([char]0x5C, [char]0x2F)
+
+function Get-WReparseCanonicalPath {
+    # Contract section 5.1. Returns $null when the argument cannot be turned
+    # into an absolute path at all (empty string, illegal characters, ...);
+    # callers translate that into the 'invalid_argument' error code.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path
+    )
+    if ([string]::IsNullOrEmpty($Path)) { return $null }
+
+    $full = $null
+    try {
+        # GetFullPath collapses '.' / '..' segments, folds '/' into '\' and
+        # resolves relative input against the process working directory. It
+        # throws ArgumentException on input that is not a usable path at all.
+        $full = [System.IO.Path]::GetFullPath($Path)
+    }
+    catch {
+        return $null
+    }
+    if ([string]::IsNullOrEmpty($full)) { return $null }
+
+    $trimmed = $full.TrimEnd($script:WReparseSeparatorChars)
+    if ([string]::IsNullOrEmpty($trimmed)) {
+        # '\'-only input that survived GetFullPath: keep the root form.
+        return $full
+    }
+    # A volume root keeps its separator ('C:\'), everything else loses it.
+    if ($trimmed.Length -eq 2 -and $trimmed[1] -eq ':') {
+        return ($trimmed + $script:WReparseDirectorySeparator)
+    }
+    # A UNC share root keeps the '\\server\share' form rather than collapsing
+    # down to the server component.
+    if ($trimmed.StartsWith($script:WReparseDirectorySeparator + $script:WReparseDirectorySeparator, [System.StringComparison]::Ordinal)) {
+        $uncParts = @($trimmed.Split([char]0x5C))
+        if ($uncParts.Count -le 4) { return $trimmed }
+    }
+    return $trimmed
+}
+
+function Get-WReparseRootPrefix {
+    # Directory-boundary prefix of a canonical root: the root plus one
+    # separator, unless the root already ends with one (volume root).
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowEmptyString()][string]$CanonicalRoot)
+    if ([string]::IsNullOrEmpty($CanonicalRoot)) { return $script:WReparseDirectorySeparator }
+    if ($CanonicalRoot.EndsWith($script:WReparseDirectorySeparator, [System.StringComparison]::Ordinal)) {
+        return $CanonicalRoot
+    }
+    return ($CanonicalRoot + $script:WReparseDirectorySeparator)
+}
+
+function Test-WReparseWithinRoot {
+    # Contract section 5.2: containment is decided on DIRECTORY boundaries, so
+    # 'C:\root2' is NOT inside 'C:\root' even though the raw string starts with
+    # it. Comparison is ordinal and case-insensitive (Windows path semantics),
+    # never culture-aware. The root itself counts as inside.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root
+    )
+    if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) { return $false }
+
+    $candidate = Get-WReparseCanonicalPath -Path $Path
+    $rootCanonical = Get-WReparseCanonicalPath -Path $Root
+    if ($null -eq $candidate -or $null -eq $rootCanonical) { return $false }
+
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($candidate, $rootCanonical)) { return $true }
+
+    $prefix = Get-WReparseRootPrefix -CanonicalRoot $rootCanonical
+    return [bool]$candidate.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
+}
+
+function Get-WReparseRelativePath {
+    # Relative path of a scanned entry with respect to the scan root, using the
+    # Windows separator. The root itself yields '.'. Casing is preserved.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$FullPath,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root
+    )
+    if ([string]::IsNullOrEmpty($FullPath)) { return '.' }
+
+    $candidate = Get-WReparseCanonicalPath -Path $FullPath
+    $rootCanonical = Get-WReparseCanonicalPath -Path $Root
+    if ($null -eq $candidate) { return $FullPath }
+    if ($null -eq $rootCanonical) { return $candidate }
+
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($candidate, $rootCanonical)) { return '.' }
+
+    $prefix = Get-WReparseRootPrefix -CanonicalRoot $rootCanonical
+    if ($candidate.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $candidate.Substring($prefix.Length)
+    }
+    return $candidate
+}
+
+function Resolve-WReparseLinkTarget {
+    # Contract section 5.3. A relative target is resolved against the directory
+    # that CONTAINS the link - never against the process working directory and
+    # never against the scan root. Unresolvable input yields $null.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$LinkFullPath,
+        [AllowNull()][AllowEmptyString()][string]$RawTarget
+    )
+    if ([string]::IsNullOrWhiteSpace($RawTarget)) { return $null }
+    if ([string]::IsNullOrWhiteSpace($LinkFullPath)) { return $null }
+
+    $linkCanonical = Get-WReparseCanonicalPath -Path $LinkFullPath
+    if ($null -eq $linkCanonical) { return $null }
+
+    $linkDirectory = [System.IO.Path]::GetDirectoryName($linkCanonical)
+    if ([string]::IsNullOrEmpty($linkDirectory)) {
+        # The link sits directly in a volume root: 'C:\' -> GetDirectoryName
+        # returns $null, so fall back to the root itself.
+        $linkDirectory = [System.IO.Path]::GetPathRoot($linkCanonical)
+    }
+    if ([string]::IsNullOrEmpty($linkDirectory)) { return $null }
+
+    $candidate = $null
+    try {
+        if ([System.IO.Path]::IsPathRooted($RawTarget)) {
+            # Absolute target: normalise as-is.
+            $candidate = [System.IO.Path]::GetFullPath($RawTarget)
+        }
+        else {
+            # Relative target: join onto the link's own directory, then let
+            # GetFullPath collapse '.' / '..' segments.
+            $joined = [System.IO.Path]::Combine($linkDirectory, $RawTarget.TrimEnd($script:WReparseSeparatorChars))
+            $candidate = [System.IO.Path]::GetFullPath($joined)
+        }
+    }
+    catch {
+        return $null
+    }
+    if ([string]::IsNullOrEmpty($candidate)) { return $null }
+    return Get-WReparseCanonicalPath -Path $candidate
+}
+
+function Compare-WReparsePath {
+    # Stable ordering key (contract section 6): ordinal case-insensitive
+    # primary key, ordinal case-sensitive tie-break. Neither comparer is
+    # culture-aware, so the report cannot be reshuffled by the host locale
+    # (a culture-aware sort would push 'A' with a diacritic before ASCII 'Z').
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Left,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Right
+    )
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($Left, $Right)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($Left, $Right)
+}
+
+function Test-WReparseInAncestry {
+    # Ordinal-ignore-case membership test for the per-branch ancestor chain
+    # used by cycle detection.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Chain,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Value
+    )
+    foreach ($entry in $Chain) {
+        if ([string]::IsNullOrEmpty($entry)) { continue }
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals($entry, $Value)) { return $true }
+    }
+    return $false
+}
