+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse implementation. See the contract under docs/
+#
+# Nothing in this file except Get-WReparseReport / ConvertTo-WReparseJson is
+# exported (see WReparse.psm1).
+
+function Sort-WReparseStable {
+    # Iterative bottom-up merge sort driven by an explicit comparison callback.
+    # Sort-Object is deliberately NOT used anywhere: its default string
+    # comparison is culture-aware, and on a host whose locale treats 'A'
+    # (U+00C4) as a variant of 'A' it would order non-ASCII names ahead of
+    # ASCII 'Z' - a different report per machine. The comparison callback only
+    # ever uses ordinal comparers (see Compare-WReparsePath) and the merge is
+    # stable, so equal keys keep their discovery order.
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][object[]]$Items,
+        [Parameter(Mandatory = $true)][scriptblock]$Comparison
+    )
+    $source = @($Items)
+    $count = $source.Count
+    if ($count -le 1) { return @($source) }
+
+    # Merge between two buffers instead of allocating per level: the result
+    # depends only on the comparison outcome, never on the enumeration order or
+    # on the host culture.
+    $buffer = New-Object System.Collections.ArrayList
+    [void]$buffer.AddRange([object[]]$source)
+    $width = 1
+    while ($width -lt $count) {
+        $merged = New-Object System.Collections.ArrayList
+        for ($start = 0; $start -lt $count; $start = $start + (2 * $width)) {
+            $leftIndex = $start
+            $leftEnd = [Math]::Min(($start + $width), $count)
+            $rightIndex = $leftEnd
+            $rightEnd = [Math]::Min(($start + (2 * $width)), $count)
+            while (($leftIndex -lt $leftEnd) -or ($rightIndex -lt $rightEnd)) {
+                if ($leftIndex -ge $leftEnd) {
+                    [void]$merged.Add($buffer[$rightIndex]); $rightIndex++
+                }
+                elseif ($rightIndex -ge $rightEnd) {
+                    [void]$merged.Add($buffer[$leftIndex]); $leftIndex++
+                }
+                else {
+                    $order = [int](& $Comparison $buffer[$leftIndex] $buffer[$rightIndex])
+                    if ($order -le 0) {
+                        [void]$merged.Add($buffer[$leftIndex]); $leftIndex++
+                    }
+                    else {
+                        [void]$merged.Add($buffer[$rightIndex]); $rightIndex++
+                    }
+                }
+            }
+        }
+        $buffer = $merged
+        $width = 2 * $width
+    }
+    return @($buffer.ToArray())
+}
+
+function Compare-WReparseRecordOrder {
+    # Records: RelativePath only (contract section 6.1).
+    [CmdletBinding()]
+    param($Left, $Right)
+    $leftPath = ''
+    $rightPath = ''
+    if ($null -ne $Left) { $leftPath = [string]$Left.RelativePath }
+    if ($null -ne $Right) { $rightPath = [string]$Right.RelativePath }
+    return (Compare-WReparsePath -Left $leftPath -Right $rightPath)
+}
+
+function Compare-WReparseErrorOrder {
+    # Errors: RelativePath first, Code second (contract section 6.3).
+    [CmdletBinding()]
+    param($Left, $Right)
+    $leftPath = ''
+    $rightPath = ''
+    $leftCode = ''
+    $rightCode = ''
+    if ($null -ne $Left) {
+        $leftPath = [string]$Left.RelativePath
+        $leftCode = [string]$Left.Code
+    }
+    if ($null -ne $Right) {
+        $rightPath = [string]$Right.RelativePath
+        $rightCode = [string]$Right.Code
+    }
+    $byPath = Compare-WReparsePath -Left $leftPath -Right $rightPath
+    if ($byPath -ne 0) { return $byPath }
+    return (Compare-WReparsePath -Left $leftCode -Right $rightCode)
+}
+
+function Get-WReparseStats {
+    # Contract section 3.3: the three counters are mutually exclusive, each one
+    # counts exactly the records of the matching Kind, and their sum equals the
+    # number of records.
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        if ($null -eq $record) { continue }
+        $kind = [string]$record.Kind
+        if ($kind -eq $script:WReparseKindDirectory) { $directories++; continue }
+        if ($kind -eq $script:WReparseKindFile) { $files++; continue }
+        if ($kind -eq $script:WReparseKindReparse) { $reparse++; continue }
+    }
+    return (New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+            -Skipped $Skipped -Errors $ErrorCount)
+}
+
+function Get-WReparseReport {
+    # Contract section 2 / section 3. -Root is mandatory, -MaxDepth defaults to
+    # 32 (negative values behave like 0), -Follow defaults to off.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+
+    $walk = Invoke-WReparseWalk -Root $Root -MaxDepth $MaxDepth -Follow:$Follow
+
+    # The pipeline unrolls the arrays returned by the sorter; @() rebuilds a
+    # real array so that Records / Errors are never $null and never a scalar.
+    $records = @(Sort-WReparseStable -Items @($walk.Records) `
+            -Comparison { param($Left, $Right) Compare-WReparseRecordOrder -Left $Left -Right $Right } )
+    $errors = @(Sort-WReparseStable -Items @($walk.Errors) `
+            -Comparison { param($Left, $Right) Compare-WReparseErrorOrder -Left $Left -Right $Right } )
+
+    $stats = Get-WReparseStats -Records $records -Skipped ([int]$walk.Skipped) -ErrorCount $errors.Count
+
+    return (New-WReparseReport -Root ([string]$walk.Root) -Records $records -Errors $errors -Stats $stats)
+}
+
+function ConvertTo-WReparseJson {
+    # Contract section 8. ConvertTo-Json with -Depth 12 so nested report data is
+    # never truncated; $null fields serialise as JSON null, empty collections as
+    # []. No timestamp and no machine-specific value is ever emitted.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]$Report
+    )
+    return ($Report | ConvertTo-Json -Depth 12)
+}
