+
+# --- path semantics ---
+Write-Output ('canon keep-case: ' + (Get-WReparseCanonicalPath -Path ($ws + '\WReparse\')))
+Write-Output ('canon volroot: ' + (Get-WReparseCanonicalPath -Path 'C:\'))
+Write-Output ('canon dotdot: ' + (Get-WReparseCanonicalPath -Path ($ws + '\WReparse\..\WReparse')))
+Write-Output ('canon relative: ' + (Get-WReparseCanonicalPath -Path '.\WReparse'))
+Write-Output ('canon invalid: ' + [string](Get-WReparseCanonicalPath -Path 'C:\bad|path'))
+Write-Output ('canon invalid2: ' + [string](Get-WReparseCanonicalPath -Path ''))
+Write-Output ('canon unc: ' + (Get-WReparseCanonicalPath -Path '\\server\share\sub\'))
+Write-Output ('within root2: ' + (Test-WReparseWithinRoot -Path 'C:\root2' -Root 'C:\root'))
+Write-Output ('within real: ' + (Test-WReparseWithinRoot -Path 'C:\root\sub' -Root 'C:\root'))
+Write-Output ('within case: ' + (Test-WReparseWithinRoot -Path 'C:\ROOT\SUB' -Root 'C:\root'))
+Write-Output ('within itself: ' + (Test-WReparseWithinRoot -Path 'C:\root' -Root 'C:\root'))
+Write-Output ('resolve rel: ' + (Resolve-WReparseLinkTarget -LinkFullPath 'C:\root\sub\link' -RawTarget '..\docs'))
+Write-Output ('resolve abs: ' + (Resolve-WReparseLinkTarget -LinkFullPath 'C:\root\sub\link' -RawTarget 'C:\other\thing'))
+Write-Output ('resolve empty: ' + [string](Resolve-WReparseLinkTarget -LinkFullPath 'C:\root\sub\link' -RawTarget ''))
