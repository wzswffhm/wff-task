diff --git a/_scratch/json.ps1 b/_scratch/json.ps1
new file mode 100644
index 0000000..88e734c
--- /dev/null
+++ b/_scratch/json.ps1
@@ -0,0 +1,42 @@
+$ErrorActionPreference = 'Stop'
+$ws = (Get-Location).Path
+Import-Module (Join-Path $ws 'WReparse\WReparse.psd1') -Force
+$tree = Join-Path $ws '_scratch\fixture\tree'
+
+$r = Get-WReparseReport -Root $tree
+$j = ConvertTo-WReparseJson -Report $r
+$lines = $j -split "`r?`n"
+Write-Output '--- first 40 lines of json ---'
+$lines | Select-Object -First 40 | ForEach-Object { $_ }
+Write-Output '--- lines around a null Target ---'
+$idx = 0
+foreach ($l in $lines) {
+    if ($l -match 'null') { Write-Output ($idx.ToString() + ': ' + $l) }
+    $idx++
+}
+Write-Output '--- non-ascii handling ---'
+foreach ($l in $lines) { if ($l -match 'dir|file\.txt') { Write-Output $l } }
+Write-Output ('raw umlaut present: ' + ($j.Contains([string][char]0x00C4)))
+Write-Output ('escaped umlaut present: ' + ($j.Contains('\u00')))
+
+# round trip
+$o = $j | ConvertFrom-Json
+Write-Output ('roundtrip records: ' + @($o.Records).Count)
+Write-Output ('roundtrip target null count: ' + @($o.Records | Where-Object { $null -eq $_.Target }).Count)
+Write-Output ('roundtrip record count with string target: ' + @($o.Records | Where-Object { $_.Target -is [string] }).Count)
+
+# single-record report
+$single = Get-WReparseReport -Root (Join-Path $tree 'Zdir')
+Write-Output ('single records type: ' + $single.Records.GetType().FullName + ' count=' + $single.Records.Count)
+$sj = ConvertTo-WReparseJson -Report $single
+Write-Output ($sj -split "`r?`n" | Select-Object -First 12 | ForEach-Object { $_ })
+$so = $sj | ConvertFrom-Json
+Write-Output ('roundtrip single records count: ' + @($so.Records).Count)
+
+# empty array roundtrip
+$e = Get-WReparseReport -Root (Join-Path $tree 'empty') | ConvertTo-WReparseJson | ConvertFrom-Json
+Write-Output ('roundtrip empty records isnull: ' + ($null -eq $e.Records) + ' type=' + $(if ($null -ne $e.Records) { $e.Records.GetType().FullName } else { 'null' }))
+
+# canonical path casing / relative root
+Write-Output ('root given as relative+trailing: ' + (Get-WReparseReport -Root ('_scratch\fixture\tree\')).Root)
+Write-Output ('root given uppercased: ' + (Get-WReparseReport -Root $tree.ToUpperInvariant()).Root)
diff --git a/_scratch/mkfixture.ps1 b/_scratch/mkfixture.ps1
new file mode 100644
index 0000000..e1429bf
--- /dev/null
+++ b/_scratch/mkfixture.ps1
@@ -0,0 +1,48 @@
+$ErrorActionPreference = 'Stop'
+$base = Join-Path (Get-Location).Path '_scratch\fixture'
+if (Test-Path $base) { Remove-Item -LiteralPath $base -Recurse -Force }
+$tree = Join-Path $base 'tree'
+$tree2 = Join-Path $base 'tree2'
+New-Item -ItemType Directory -Path (Join-Path $tree 'docs') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $tree 'empty') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $tree 'shared') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $tree 'b1') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $tree 'b2') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $tree2 'x') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $tree 'Zdir') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $tree ([char]0x00C4 + 'dir')) -Force | Out-Null
+
+Set-Content -LiteralPath (Join-Path $tree 'plain.txt') -Value 'plain-content' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $tree 'docs\a.md') -Value 'markdown' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $tree 'shared\inner.txt') -Value 'inner' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $tree2 'x\outside.txt') -Value 'outside' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $tree ([char]0x00F6 + 'file.txt')) -Value 'umlaut' -NoNewline -Encoding ASCII
+
+New-Item -ItemType HardLink -Path (Join-Path $tree 'hardlink.txt') -Target (Join-Path $tree 'plain.txt') | Out-Null
+New-Item -ItemType Junction -Path (Join-Path $tree 'junction-docs') -Target (Join-Path $tree 'docs') | Out-Null
+
+function New-Link([string]$Kind, [string]$Path, [string]$Target) {
+    $dir = Split-Path -Parent $Path
+    Push-Location -LiteralPath $dir
+    $leaf = Split-Path -Leaf $Path
+    $null = (& cmd.exe /c "mklink $Kind ""$leaf"" ""$Target""" 2>&1)
+    Pop-Location
+    if (-not (Test-Path -LiteralPath $Path)) { throw "mklink failed for $Path -> $Target" }
+}
+
+New-Link '/D' (Join-Path $tree 'link-rel') 'docs'
+New-Link '/D' (Join-Path $tree 'link-out') 'C:\Windows'
+New-Link '/D' (Join-Path $tree 'link-sibling') '..\tree2\x'
+New-Link '/D' (Join-Path $tree 'loop') '.'
+New-Link '/D' (Join-Path $tree 'dangling') 'nope'
+New-Link '' (Join-Path $tree 'file-link') 'plain.txt'
+New-Link '/D' (Join-Path $tree 'b1\lnk') '..\shared'
+New-Link '/D' (Join-Path $tree 'b2\lnk') '..\shared'
+New-Link '/D' (Join-Path $tree 'docs\up') '..\docs'
+
+Get-ChildItem -LiteralPath $tree -Force | ForEach-Object {
+    $t = $_.Target
+    $tt = 'null'
+    if ($null -ne $t) { $tt = $t.GetType().FullName + ' = ' + (@($t) -join '|') }
+    Write-Output ('ITEM ' + $_.Name + ' | attrs=' + [int]$_.Attributes + ' | linkType=' + [string]$_.LinkType + ' | target[' + $tt + '] | isContainer=' + $_.PSIsContainer)
+}
diff --git a/_scratch/mkfixture2.ps1 b/_scratch/mkfixture2.ps1
new file mode 100644
index 0000000..0778b23
--- /dev/null
+++ b/_scratch/mkfixture2.ps1
@@ -0,0 +1,10 @@
+$ErrorActionPreference = 'Stop'
+$base = Join-Path (Get-Location).Path '_scratch\fixture'
+$tree = Join-Path $base 'tree'
+$tree2 = Join-Path $base 'tree2'
+# recreate link-out with an absolute target that is small enough to follow
+Remove-Item -LiteralPath (Join-Path $tree 'link-out') -Force -Recurse
+cmd.exe /c "mklink /D ""$(Join-Path $tree 'link-out')"" ""$tree2""" | Out-Null
+Get-ChildItem -LiteralPath $tree -Force | Where-Object { $_.Name -eq 'link-out' } | ForEach-Object {
+    Write-Output ('link-out target: ' + (@($_.Target) -join '|'))
+}
