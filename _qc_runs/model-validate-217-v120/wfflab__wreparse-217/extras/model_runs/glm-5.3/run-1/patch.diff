+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse implementation.
+#
+# Nothing in this file is exported; the module surface is fixed by the contract
+# (see WReparse.psm1).
+
+# FILE_ATTRIBUTE_REPARSEPOINT (0x400). This is the ONLY reliable marker of a
+# reparse point: a hard link reports LinkType 'HardLink' yet carries no
+# reparse attribute, and must therefore be recorded as a plain File.
+$script:WReparseAttributeReparsePoint = [int][System.IO.FileAttributes]::ReparsePoint
+
+function Get-WReparseMemberValue {
+    # Null-safe property lookup; enumeration results are FileSystemInfo but the
+    # provider is free to attach (or omit) note properties such as LinkType.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
+function Test-WReparseIsReparsePoint {
+    # Contract section 3.1: classification depends solely on the
+    # FILE_ATTRIBUTE_REPARSE_POINT attribute bit. LinkType is NOT consulted
+    # here - a hard link has a LinkType but is an ordinary file.
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)]$Item)
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return $false }
+    $flags = 0
+    try { $flags = [int]$attributes }
+    catch { return $false }
+    return ((($flags -band $script:WReparseAttributeReparsePoint) -ne 0))
+}
+
+function Get-WReparseReparseKind {
+    # Maps the provider link type onto the contract vocabulary. Only entries
+    # that carry the reparse attribute reach this function.
+    [CmdletBinding()]
+    param([AllowNull()][AllowEmptyString()][string]$LinkType)
+    if ([string]::IsNullOrWhiteSpace($LinkType)) { return $script:WReparseReparseKindUnknown }
+    $trimmed = $LinkType.Trim()
+    if ($trimmed -eq $script:WReparseReparseKindSymbolicLink) { return $script:WReparseReparseKindSymbolicLink }
+    if ($trimmed -eq $script:WReparseReparseKindJunction) { return $script:WReparseReparseKindJunction }
+    if ($trimmed -eq $script:WReparseReparseKindMountPoint) { return $script:WReparseReparseKindMountPoint }
+    return $script:WReparseReparseKindUnknown
+}
+
+function Get-WReparseRawTarget {
+    # The provider exposes .Target as a collection (a reparse point may carry
+    # several substitutions) and PowerShell unrolls a single-element array into
+    # the element itself. The contract defines Target as ONE string, so the
+    # first substitution is taken and explicitly coerced; the type therefore
+    # never changes with the number of targets.
+    [CmdletBinding()]
+    param([AllowNull()]$Value)
+    if ($null -eq $Value) { return $null }
+    if ($Value -is [string]) {
+        if ($Value.Length -eq 0) { return $null }
+        return $Value
+    }
+    $items = @($Value)
+    foreach ($element in $items) {
+        if ($null -eq $element) { continue }
+        $text = [string]$element
+        if ($text.Length -gt 0) { return $text }
+    }
+    return $null
+}
+
+function Test-WReparsePathExists {
+    # Read-only existence probe that never throws and never goes through the
+    # provider pipeline.
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path)
+    if ([string]::IsNullOrWhiteSpace($Path)) { return $false }
+    if ([System.IO.Directory]::Exists($Path)) { return $true }
+    return [bool][System.IO.File]::Exists($Path)
+}
+
+function Test-WReparseIsDirectory {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path)
+    if ([string]::IsNullOrWhiteSpace($Path)) { return $false }
+    return [bool][System.IO.Directory]::Exists($Path)
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+function Invoke-WReparseDirectoryWalk {
+    # Enumerates one physical directory and emits it into $State. $RealDirectory
+    # is the location actually read; $VirtualDirectory is the path the entry is
+    # REPORTED under. They only differ when a reparse point was followed, in
+    # which case the children keep the LINK path as their prefix (contract
+    # section 4.2) instead of the real target path.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$VirtualDirectory,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+
+    # Contract section 4.3: a directory whose depth already equals -MaxDepth is
+    # not enumerated and yields one 'too_deep' error. Depth starts at 0 for the
+    # scan root, so -MaxDepth 0 (and any negative value, clamped to 0) stops at
+    # the root itself.
+    if ($Depth -ge $State.MaxDepth) {
+        $relative = Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root
+        Add-WReparseError -State $State -RelativePath $relative -Code 'too_deep' `
+            -Message ("Depth limit of {0} reached; children were not enumerated." -f $State.MaxDepth)
+        return
+    }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch {
+        # Contract section 4.4: one failing directory never aborts the scan.
+        $relative = Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root
+        Add-WReparseError -State $State -RelativePath $relative -Code 'access_denied' `
+            -Message 'The directory could not be enumerated.'
+        return
+    }
+
+    foreach ($child in $children) {
+        $childDepth = $Depth + 1
+        $childName = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        if ([string]::IsNullOrEmpty($childName)) { continue }
+        $virtualChild = Join-Path -Path $VirtualDirectory -ChildPath $childName
+        $relative = Get-WReparseRelativePath -FullPath $virtualChild -Root $State.Root
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = Get-WReparseRawTarget -Value (Get-WReparseMemberValue -InputObject $child -Name 'Target')
+
+            # ResolvedTarget / InScope are always reported (they are pure path
+            # arithmetic), but the follow-only error codes are only produced in
+            # follow mode (contract section 7).
+            $resolved = $null
+            if ($null -ne $rawTarget) {
+                $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+            }
+            $inScope = $false
+            if ($null -ne $resolved) {
+                $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+            }
+
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative `
+                    -Kind $script:WReparseKindReparse `
+                    -ReparseKind (Get-WReparseReparseKind -LinkType $linkType) `
+                    -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                    -Depth $childDepth -Size 0))
+
+            if (-not $State.Follow) {
+                # Default mode: register the entry, never descend, count it as
+                # skipped (contract section 4.1).
+                $State.Skipped++
+                continue
+            }
+
+            if ($null -eq $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target could not be resolved.'
+                continue
+            }
+            if (-not (Test-WReparsePathExists -Path $resolved)) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+            if (Test-WReparseInAncestry -Chain $Ancestry -Value $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                    -Message 'The reparse target is already an ancestor on this branch.'
+                continue
+            }
+            if (Test-WReparseIsDirectory -Path $resolved) {
+                # Descend through the link, reporting children under the LINK
+                # path, not under the target path.
+                Invoke-WReparseDirectoryWalk -RealDirectory $resolved -VirtualDirectory $virtualChild `
+                    -Depth $childDepth -Ancestry ($Ancestry + $resolved) -State $State
+            }
+            # A link whose target is a file contributes no children at all.
+            continue
+        }
+
+        $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) { $size = [long]$length }
+        }
+        $kind = $script:WReparseKindFile
+        if ($isContainer) { $kind = $script:WReparseKindDirectory }
+
+        # InScope is only meaningful for reparse points: a plain entry is by
+        # definition the entry itself, so it stays false.
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+                -InScope $false -Depth $childDepth -Size $size))
+
+        if ($isContainer) {
+            $realChildCanonical = Get-WReparseCanonicalPath -Path $realChild
+            if ($null -eq $realChildCanonical) { $realChildCanonical = $realChild }
+            Invoke-WReparseDirectoryWalk -RealDirectory $realChildCanonical -VirtualDirectory $virtualChild `
+                -Depth $childDepth -Ancestry ($Ancestry + $realChildCanonical) -State $State
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    # Entry point of the traversal. Returns the raw (unsorted) records, the
+    # errors and the skip counter; ordering and statistics belong to the report
+    # assembly step.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+
+    # Contract section 4.3: a negative -MaxDepth behaves exactly like 0.
+    $effectiveMaxDepth = [int]$MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $state = @{
+        Records  = New-Object System.Collections.ArrayList
+        Errors   = New-Object System.Collections.ArrayList
+        Skipped  = 0
+        Root     = $null
+        Follow   = [bool]$Follow.IsPresent
+        MaxDepth = $effectiveMaxDepth
+    }
+
+    $canonicalRoot = Get-WReparseCanonicalPath -Path $Root
+    if ($null -eq $canonicalRoot) {
+        # Contract section 7: the root string cannot be canonicalised.
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message 'The scan root could not be canonicalised.'
+        return [pscustomobject][ordered]@{
+            Root    = [string]$Root
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+
+    if (-not (Test-WReparsePathExists -Path $canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message 'The scan root does not exist.'
+        return [pscustomobject][ordered]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+
+    if (-not (Test-WReparseIsDirectory -Path $canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message 'The scan root is not a directory.'
+        return [pscustomobject][ordered]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+
+    $state.Root = $canonicalRoot
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualDirectory $canonicalRoot `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return [pscustomobject][ordered]@{
+        Root    = $canonicalRoot
+        Records = @($state.Records.ToArray())
+        Errors  = @($state.Errors.ToArray())
+        Skipped = [int]$state.Skipped
+    }
+}
diff --git a/_scratch/check.ps1 b/_scratch/check.ps1
new file mode 100644
index 0000000..e1df604
--- /dev/null
+++ b/_scratch/check.ps1
@@ -0,0 +1,110 @@
+$ErrorActionPreference = 'Stop'
+$ws = (Get-Location).Path
+Import-Module (Join-Path $ws 'WReparse\WReparse.psd1') -Force
+$tree = Join-Path $ws '_scratch\fixture\tree'
+
+function Check([string]$Name, $Value, $Expected) {
+    if ("$Value" -eq "$Expected") { Write-Output ("[PASS] " + $Name) }
+    else { Write-Output ("[FAIL] " + $Name + " -> got=[" + $Value + "] want=[" + $Expected + "]") }
+}
+
+# make the process CWD something unrelated, to prove link targets are not
+# resolved against it
+Push-Location -LiteralPath 'C:\Windows'
+try {
+    # ---------- default scan ----------
+    $r = Get-WReparseReport -Root $tree
+    $j1 = ConvertTo-WReparseJson -Report $r
+    $r2 = Get-WReparseReport -Root $tree
+    $j2 = ConvertTo-WReparseJson -Report $r2
+    Check 'report fields' (($r.PSObject.Properties | ForEach-Object { $_.Name }) -join ',') 'SchemaVersion, Root, Records, Errors, Stats'
+    Check 'record fields' (($r.Records[0].PSObject.Properties | ForEach-Object { $_.Name }) -join ',') 'RelativePath, Kind, ReparseKind, Target, ResolvedTarget, InScope, Depth, Size'
+    Check 'json deterministic' ($j1 -ceq $j2) 'True'
+    Check 'records is array' ($r.Records -is [array]) 'True'
+    Check 'errors empty array' ("$($r.Errors.Length) $($r.Errors -is [array])") '0 True'
+    Check 'skipped == reparse count' "$($r.Stats.Skipped) $($r.Stats.ReparsePoints)" "$($r.Stats.ReparsePoints) $($r.Stats.ReparsePoints)"
+    Check 'stats sum' ($r.Stats.Directories + $r.Stats.Files + $r.Stats.ReparsePoints) $r.Records.Count
+    Check 'no cycle/broken w/o follow' ([bool]($r.Errors | Where-Object { $_.Code -in @('cycle', 'broken_target') })) 'False'
+    Check 'root casing' $r.Root $tree
+
+    Write-Output '--- default records ---'
+    foreach ($rec in $r.Records) {
+        Write-Output ("  {0,-22} {1,-12} {2,-12} T={3} R={4} In={5} D={6} S={7}" -f $rec.RelativePath, $rec.Kind, $rec.ReparseKind, $rec.Target, $rec.ResolvedTarget, $rec.InScope, $rec.Depth, $rec.Size)
+    }
+    Write-Output '--- default stats ---'
+    Write-Output ($r.Stats | ConvertTo-Json -Compress)
+
+    foreach ($rec in $r.Records) {
+        if ($rec.Kind -ne 'ReparsePoint') {
+            if ($null -ne $rec.ReparseKind -or $null -ne $rec.Target -or $null -ne $rec.ResolvedTarget) { Write-Output ('[FAIL] non-reparse nulls: ' + $rec.RelativePath) }
+            if ($rec.InScope) { Write-Output ('[FAIL] non-reparse InScope true: ' + $rec.RelativePath) }
+        }
+        else {
+            if ($rec.Target -isnot [string]) { Write-Output ('[FAIL] Target not string: ' + $rec.RelativePath + ' ' + $rec.Target.GetType().FullName) }
+        }
+    }
+    Check 'hardlink is File' (($r.Records | Where-Object { $_.RelativePath -eq 'hardlink.txt' }).Kind) 'File'
+    Check 'plain InScope false' (($r.Records | Where-Object { $_.RelativePath -eq 'plain.txt' }).InScope) 'False'
+    Check 'docs InScope false' (($r.Records | Where-Object { $_.RelativePath -eq 'docs' }).InScope) 'False'
+    Check 'junction kind' (($r.Records | Where-Object { $_.RelativePath -eq 'junction-docs' }).ReparseKind) 'Junction'
+    Check 'symlink kind' (($r.Records | Where-Object { $_.RelativePath -eq 'link-rel' }).ReparseKind) 'SymbolicLink'
+    Check 'rel resolved' (($r.Records | Where-Object { $_.RelativePath -eq 'link-rel' }).ResolvedTarget) (Join-Path $tree 'docs')
+    Check 'link-rel inScope' (($r.Records | Where-Object { $_.RelativePath -eq 'link-rel' }).InScope) 'True'
+    Check 'link-sibling inScope' (($r.Records | Where-Object { $_.RelativePath -eq 'link-sibling' }).InScope) 'False'
+    Check 'link-sibling resolved' (($r.Records | Where-Object { $_.RelativePath -eq 'link-sibling' }).ResolvedTarget) (Join-Path $ws '_scratch\fixture\tree2\x')
+    Check 'link-out inScope' (($r.Records | Where-Object { $_.RelativePath -eq 'link-out' }).InScope) 'False'
+    Check 'docs\up resolved' (($r.Records | Where-Object { $_.RelativePath -eq 'docs\up' }).ResolvedTarget) (Join-Path $tree 'docs')
+    Check 'depth of direct children' (($r.Records | Where-Object { $_.RelativePath -eq 'plain.txt' }).Depth) 1
+    Check 'depth of nested' (($r.Records | Where-Object { $_.RelativePath -eq 'docs\a.md' }).Depth) 2
+    Check 'empty dir present' (($r.Records | Where-Object { $_.RelativePath -eq 'empty' }).Kind) 'Directory'
+    Check 'ordinal order Z before A-umlaut' ($r.Records[0].RelativePath) 'Zdir'
+    $names = @($r.Records | ForEach-Object { $_.RelativePath })
+    Check 'Zdir before Aumlaut' ($names.IndexOf('Zdir') -lt $names.IndexOf([string]([char]0x00C4) + 'dir')) 'True'
+    Check 'json has null Target' ($j1 -match '"Target": null') 'True'
+    Check 'json has [] records or objects' ($j1 -match '"Errors": \[\]') 'True'
+
+    # ---------- follow scan ----------
+    $f = Get-WReparseReport -Root $tree -Follow
+    Write-Output '--- follow records ---'
+    foreach ($rec in $f.Records) { Write-Output ("  {0,-24} {1,-12} {2,-12} D={3}" -f $rec.RelativePath, $rec.Kind, $rec.ReparseKind, $rec.Depth) }
+    Write-Output '--- follow errors ---'
+    foreach ($e in $f.Errors) { Write-Output ("  {0,-24} {1,-14} {2}" -f $e.RelativePath, $e.Code, $e.Message) }
+    Check 'follow link-rel prefix' ([bool]($f.Records | Where-Object { $_.RelativePath -eq 'link-rel\a.md' })) 'True'
+    Check 'follow file-link no children' ([bool]($f.Records | Where-Object { $_.RelativePath -like 'file-link\*' })) 'False'
+    Check 'follow b1 shared entered' ([bool]($f.Records | Where-Object { $_.RelativePath -eq 'b1\lnk\inner.txt' })) 'True'
+    Check 'follow b2 shared entered' ([bool]($f.Records | Where-Object { $_.RelativePath -eq 'b2\lnk\inner.txt' })) 'True'
+    Check 'follow no cycle for siblings' ([bool]($f.Errors | Where-Object { $_.Code -eq 'cycle' -and $_.RelativePath -like 'b?*' })) 'False'
+    Check 'follow loop cycle' ([bool]($f.Errors | Where-Object { $_.Code -eq 'cycle' -and $_.RelativePath -eq 'loop' })) 'True'
+    Check 'follow dangling broken' ([bool]($f.Errors | Where-Object { $_.Code -eq 'broken_target' -and $_.RelativePath -eq 'dangling' })) 'True'
+    Check 'follow skipped zero' $f.Stats.Skipped 0
+    Check 'follow outside prefix' ([bool]($f.Records | Where-Object { $_.RelativePath -eq 'link-out\x\outside.txt' })) 'True'
+
+    # ---------- depth ----------
+    $d0 = Get-WReparseReport -Root $tree -MaxDepth 0
+    $dneg = Get-WReparseReport -Root $tree -MaxDepth -3
+    Check 'maxdepth0 == negative' ((ConvertTo-WReparseJson -Report $d0) -ceq (ConvertTo-WReparseJson -Report $dneg)) 'True'
+    Check 'maxdepth0 records empty' $d0.Records.Count 0
+    Check 'maxdepth0 error' ($d0.Errors | ForEach-Object { $_.Code + '@' + $_.RelativePath }) 'too_deep@.'
+    $d1 = Get-WReparseReport -Root $tree -MaxDepth 1
+    Check 'maxdepth1 max record depth' (@($d1.Records | Measure-Object -Property Depth -Maximum).Maximum) 1
+    Check 'maxdepth1 too_deep dirs' ((@($d1.Errors | Where-Object { $_.Code -eq 'too_deep' }).Count) -gt 0) 'True'
+
+    # ---------- root errors ----------
+    $nf = Get-WReparseReport -Root (Join-Path $ws '_scratch\nope')
+    Check 'not_found' ($nf.Errors | ForEach-Object { $_.Code + '@' + $_.RelativePath }) 'not_found@.'
+    $st = Get-WReparseReport -Root (Join-Path $tree 'plain.txt')
+    Check 'structure' ($st.Errors | ForEach-Object { $_.Code + '@' + $_.RelativePath }) 'structure@.'
+    $ia = Get-WReparseReport -Root 'C:\bad|path'
+    Check 'invalid_argument' ($ia.Errors | ForEach-Object { $_.Code + '@' + $_.RelativePath }) 'invalid_argument@.'
+
+    # ---------- empty tree ----------
+    $emp = Get-WReparseReport -Root (Join-Path $ws '_scratch\fixture\tree\empty')
+    $empJson = ConvertTo-WReparseJson -Report $emp
+    Check 'empty records json' ($empJson -match '"Records": \[\]') 'True'
+    Check 'empty errors json' ($empJson -match '"Errors": \[\]') 'True'
+    Check 'empty stats' ($emp.Stats | ConvertTo-Json -Compress) '{"Directories":0,"Files":0,"ReparsePoints":0,"Skipped":0,"Errors":0}'
+    Write-Output $empJson
+}
+finally {
+    Pop-Location
+}
diff --git a/_scratch/edge.ps1 b/_scratch/edge.ps1
new file mode 100644
index 0000000..ce840a6
--- /dev/null
+++ b/_scratch/edge.ps1
@@ -0,0 +1,48 @@
+$ErrorActionPreference = 'Stop'
+$ws = (Get-Location).Path
+Import-Module (Join-Path $ws 'WReparse\WReparse.psd1') -Force
+$tree = Join-Path $ws '_scratch\fixture\tree'
+
+function Check([string]$Name, $Value, $Expected) {
+    if ("$Value" -eq "$Expected") { Write-Output ("[PASS] " + $Name) }
+    else { Write-Output ("[FAIL] " + $Name + " -> got=[" + $Value + "] want=[" + $Expected + "]") }
+}
+
+# single record array
+$one = Get-WReparseReport -Root (Join-Path $tree 'shared')
+Check 'single record array' ($one.Records.GetType().FullName + '/' + $one.Records.Count) ('System.Object[]/1')
+$oneJ = ConvertTo-WReparseJson -Report $one
+$oneO = $oneJ | ConvertFrom-Json
+Check 'single record json array' (@($oneO.Records).Count) 1
+
+# empty string root
+$es = Get-WReparseReport -Root ''
+Check 'empty root -> invalid_argument' (@($es.Errors) | ForEach-Object { $_.Code }) 'invalid_argument'
+Check 'empty root records' (@($es.Records).Count) 0
+
+# access denied subtree
+$ad = Join-Path $tree 'locked'
+New-Item -ItemType Directory -Path (Join-Path $ad 'inner') -Force | Out-Null
+Set-Content -LiteralPath (Join-Path $ad 'inner\secret.txt') -Value 'x' -NoNewline -Encoding ASCII
+$icaclsOut = icacls (Join-Path $ad 'inner') /deny 'Everyone:(OI)(CI)F' 2>&1
+Write-Output ('icacls: ' + ($icaclsOut -join ' '))
+$canRead = $true
+try { Get-ChildItem -LiteralPath (Join-Path $ad 'inner') -Force -ErrorAction Stop | Out-Null } catch { $canRead = $false }
+Write-Output ('provider can still read: ' + $canRead)
+$rep = Get-WReparseReport -Root $ad
+foreach ($e in $rep.Errors) { Write-Output ('err: ' + $e.RelativePath + ' ' + $e.Code) }
+foreach ($rec in $rep.Records) { Write-Output ('rec: ' + $rec.RelativePath + ' ' + $rec.Kind) }
+Check 'failure isolation kept root record' ([bool]($rep.Records | Where-Object { $_.RelativePath -eq 'inner' })) $true
+icacls (Join-Path $ad 'inner') /remove:d '*S-1-1-0' 2>&1 | Out-Null
+icacls (Join-Path $ad 'inner') /grant 'Everyone:(OI)(CI)F' 2>&1 | Out-Null
+Remove-Item -LiteralPath $ad -Recurse -Force
+
+# root is a symlink to a directory
+$symRoot = Get-WReparseReport -Root (Join-Path $tree 'link-rel')
+Write-Output ('symroot records: ' + (@($symRoot.Records) | ForEach-Object { $_.RelativePath }) -join ',')
+Write-Output ('symroot errors: ' + (@($symRoot.Errors) | Measure-Object).Count)
+
+# root with trailing separator and mixed case
+$tr = Get-WReparseReport -Root (($tree.ToUpperInvariant()) + '\')
+Check 'trailing+upper root' $tr.Root $tree
+Check 'trailing+upper records' (@($tr.Records).Count) 22
