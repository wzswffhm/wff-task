+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation. See the contract under docs/
+
+Set-StrictMode -Version Latest
+
+# Canonical form used for every comparison and for the report:
+#   * full (rooted) path with '.' and '..' collapsed
+#   * no trailing directory separator, except for a volume root ('C:\')
+#     or a UNC share root ('\\server\share')
+#   * original casing preserved (the report must echo the caller's casing)
+# A string that cannot be canonicalised raises; callers turn that into the
+# 'invalid_argument' error code.
+function Get-WReparseCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Path
+    )
+    if ([string]::IsNullOrWhiteSpace($Path)) {
+        throw [System.ArgumentException]::new('Path is empty or whitespace.', 'Path')
+    }
+
+    $full = [System.IO.Path]::GetFullPath($Path)
+
+    # A volume root keeps its separator: 'C:\' must not degrade to 'C:',
+    # which no longer denotes the root directory.
+    if ($full -match '^[A-Za-z]:\\$') { return $full }
+
+    $trimmed = $full.TrimEnd([char]'\', [char]'/')
+
+    # 'C:' alone is drive-relative, not the volume root; restore the root.
+    if ($trimmed -match '^[A-Za-z]:$') { return $trimmed + '\' }
+
+    # A UNC share root ('\\server\share') has nothing to trim beyond the
+    # trailing separator, which TrimEnd already removed.
+    if ([string]::IsNullOrEmpty($trimmed)) { return $full }
+
+    return $trimmed
+}
+
+# Appends the separator needed to test for a child path. A volume root and a
+# UNC share root already end with (or need) exactly one separator.
+function Get-WReparsePathPrefix {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][string]$CanonicalPath)
+    if ($CanonicalPath.EndsWith('\')) { return $CanonicalPath }
+    return $CanonicalPath + '\'
+}
+
+# Directory-boundary aware containment. 'C:\root2' is NOT inside 'C:\root'
+# even though 'C:\root2'.StartsWith('C:\root') is true. Windows path
+# comparison is case-insensitive, so the ordinal-ignore-case comparer is used.
+function Test-WReparseWithinRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root
+    )
+    if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) {
+        return $false
+    }
+    try {
+        $p = Get-WReparseCanonicalPath -Path $Path
+        $r = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        return $false
+    }
+    # The root itself counts as inside the root.
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return $true }
+    $prefix = Get-WReparsePathPrefix -CanonicalPath $r
+    return $p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
+}
+
+# Relative path of a scanned entry with respect to the scan root, using the
+# Windows separator. The root itself yields '.'.
+function Get-WReparseRelativePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$FullPath,
+        [Parameter(Mandatory = $true)][string]$Root
+    )
+    $p = Get-WReparseCanonicalPath -Path $FullPath
+    $r = Get-WReparseCanonicalPath -Path $Root
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return '.' }
+    $prefix = Get-WReparsePathPrefix -CanonicalPath $r
+    if ($p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $p.Substring($prefix.Length)
+    }
+    return $p
+}
+
+# The reparse target stored on disk may be relative. A relative target is
+# resolved against the directory that CONTAINS the link, never against the
+# process working directory and never against the scan root.
+function Resolve-WReparseLinkTarget {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$LinkFullPath,
+        [Parameter(Mandatory = $false)][AllowEmptyString()][AllowNull()][string]$RawTarget
+    )
+    if ([string]::IsNullOrWhiteSpace($RawTarget)) { return $null }
+
+    $target = $RawTarget
+    # Strip the NT object-manager prefix that some providers surface.
+    if ($target.StartsWith('\??\')) { $target = $target.Substring(4) }
+    if ([string]::IsNullOrWhiteSpace($target)) { return $null }
+
+    $linkDirectory = $null
+    if (-not [string]::IsNullOrWhiteSpace($LinkFullPath)) {
+        try {
+            $linkCanonical = Get-WReparseCanonicalPath -Path $LinkFullPath
+            $linkDirectory = [System.IO.Path]::GetDirectoryName($linkCanonical)
+        }
+        catch {
+            $linkDirectory = $null
+        }
+    }
+
+    try {
+        $candidate = $null
+        if ([System.IO.Path]::IsPathRooted($target)) {
+            $root = [System.IO.Path]::GetPathRoot($target)
+            if ($root -eq '\' -or $root -eq '/') {
+                # Root-relative target ('\docs'): rooted, but the volume comes
+                # from the link itself, not from the process current drive.
+                if ([string]::IsNullOrWhiteSpace($linkDirectory)) { return $null }
+                $volume = [System.IO.Path]::GetPathRoot($linkDirectory)
+                if ([string]::IsNullOrWhiteSpace($volume)) { return $null }
+                $candidate = [System.IO.Path]::Combine($volume, $target.TrimStart([char]'\', [char]'/'))
+            }
+            else {
+                $candidate = $target
+            }
+        }
+        else {
+            if ([string]::IsNullOrWhiteSpace($linkDirectory)) { return $null }
+            $candidate = [System.IO.Path]::Combine($linkDirectory, $target)
+        }
+        return Get-WReparseCanonicalPath -Path $candidate
+    }
+    catch {
+        return $null
+    }
+}
+
+# Stable ordering key: ordinal, case-insensitive first, with a case-sensitive
+# tie-break so that two entries whose names differ only by case keep a
+# deterministic position. Ordinal throughout: a culture-aware comparison
+# would reorder non-ASCII names differently on different hosts.
+function Compare-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Left,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Right
+    )
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($Left, $Right)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($Left, $Right)
+}
