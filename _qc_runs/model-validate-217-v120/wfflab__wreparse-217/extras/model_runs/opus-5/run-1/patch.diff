+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse reference implementation.
+
+Set-StrictMode -Version Latest
+
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
+# Maps the provider link type to the contract vocabulary. Only entries whose
+# file attributes carry FILE_ATTRIBUTE_REPARSE_POINT reach this function, so a
+# hard link (which has a link type but no reparse attribute) is never mapped.
+# A junction and a symbolic link are distinct kinds and must not be merged.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $false)][AllowNull()][AllowEmptyString()][string]$LinkType)
+    switch ($LinkType) {
+        'SymbolicLink' { return 'SymbolicLink' }
+        'Junction' { return 'Junction' }
+        'MountPoint' { return 'MountPoint' }
+        default { return 'Unknown' }
+    }
+}
+
+# FILE_ATTRIBUTE_REPARSE_POINT is the only reliable marker. A hard link
+# reports LinkType = 'HardLink' but carries no reparse attribute, so testing
+# the link type would misclassify it as a reparse point.
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)]$Item)
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return $false }
+    try {
+        $flags = [System.IO.FileAttributes]$attributes
+    }
+    catch {
+        return $false
+    }
+    return (($flags -band [System.IO.FileAttributes]::ReparsePoint) -ne 0)
+}
+
+# The provider exposes Target as a System.String[] (a reparse point may carry
+# several substitutions) and PowerShell unrolls single-element arrays, so the
+# forwarded type would otherwise vary with the number of targets. The contract
+# defines Target as one string: take the first entry and normalise the type.
+function Get-WReparseRawTarget {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Value)
+    if ($null -eq $Value) { return $null }
+    if ($Value -is [string]) {
+        if ([string]::IsNullOrWhiteSpace($Value)) { return $null }
+        return [string]$Value
+    }
+    foreach ($candidate in @($Value)) {
+        if ($null -eq $candidate) { continue }
+        $text = [string]$candidate
+        if (-not [string]::IsNullOrWhiteSpace($text)) { return $text }
+    }
+    return $null
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+# A cycle is a target that is already on the ancestor chain of THIS branch.
+# Two links on sibling branches pointing at one target are not a cycle: each
+# branch carries its own chain. A target that CONTAINS an ancestor closes a
+# loop just as surely as an exact match, so both are reported.
+function Test-WReparseAncestorCycle {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][string]$Candidate
+    )
+    foreach ($ancestor in $Ancestry) {
+        if ([string]::IsNullOrWhiteSpace($ancestor)) { continue }
+        if (Test-WReparseWithinRoot -Path $ancestor -Root $Candidate) { return $true }
+    }
+    return $false
+}
+
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][string]$VirtualDirectory,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+    # $Depth is the depth of this directory itself; its children sit one level
+    # deeper (the scan root is depth 0, so its children are depth 1).
+    if ($Depth -ge $State.MaxDepth) {
+        $relative = Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root
+        Add-WReparseError -State $State -RelativePath $relative -Code 'too_deep' `
+            -Message "Depth limit of $($State.MaxDepth) reached; not enumerating."
+        return
+    }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch {
+        $relative = Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root
+        $message = 'Access denied while enumerating the directory.'
+        if ($_.Exception -and -not [string]::IsNullOrWhiteSpace($_.Exception.Message)) {
+            $message = $_.Exception.Message
+        }
+        Add-WReparseError -State $State -RelativePath $relative -Code 'access_denied' -Message $message
+        return
+    }
+
+    foreach ($child in $children) {
+        $childDepth = $Depth + 1
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        if ([string]::IsNullOrWhiteSpace($realChild)) { continue }
+        $leaf = Split-Path -Path $realChild -Leaf
+        $virtualChild = Join-Path -Path $VirtualDirectory -ChildPath $leaf
+        $relative = Get-WReparseRelativePath -FullPath $virtualChild -Root $State.Root
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = Get-WReparseRawTarget -Value (Get-WReparseMemberValue -InputObject $child -Name 'Target')
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+            $inScope = $false
+            if ($null -ne $resolved) {
+                $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+            }
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind 'ReparsePoint' `
+                -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                -Depth $childDepth -Size 0))
+
+            # Default mode: register the entry, never enter the target, and
+            # never report cycle or broken_target.
+            if (-not $State.Follow) {
+                $State.Skipped = $State.Skipped + 1
+                continue
+            }
+
+            if ($null -eq $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target could not be resolved.'
+                continue
+            }
+            if (-not (Test-Path -LiteralPath $resolved)) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+            if (Test-WReparseAncestorCycle -Ancestry $Ancestry -Candidate $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                    -Message 'The reparse target is an ancestor already visited on this branch.'
+                continue
+            }
+            # A link to a file yields no children at all.
+            if (Test-Path -LiteralPath $resolved -PathType Container) {
+                # Entries below a followed link keep the LINK path as prefix,
+                # not the real target path.
+                Invoke-WReparseDirectoryWalk -RealDirectory $resolved -VirtualDirectory $virtualChild `
+                    -Depth $childDepth -Ancestry (@($Ancestry) + @($resolved)) -State $State
+            }
+            continue
+        }
+
+        $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) { $size = [long]$length }
+        }
+        $kind = if ($isContainer) { 'Directory' } else { 'File' }
+        # InScope is meaningful for reparse entries only; plain files,
+        # directories and hard links are always $false.
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+            -InScope $false -Depth $childDepth -Size $size))
+
+        if ($isContainer) {
+            $realChildCanonical = Get-WReparseCanonicalPath -Path $realChild
+            Invoke-WReparseDirectoryWalk -RealDirectory $realChildCanonical -VirtualDirectory $virtualChild `
+                -Depth $childDepth -Ancestry (@($Ancestry) + @($realChildCanonical)) -State $State
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root,
+        [switch]$Follow,
+        [int]$MaxDepth = 32
+    )
+    # A negative depth budget behaves exactly like 0.
+    $effectiveDepth = $MaxDepth
+    if ($effectiveDepth -lt 0) { $effectiveDepth = 0 }
+
+    $state = @{
+        Records  = New-Object System.Collections.ArrayList
+        Errors   = New-Object System.Collections.ArrayList
+        Skipped  = 0
+        Root     = $null
+        Follow   = [bool]$Follow
+        MaxDepth = $effectiveDepth
+    }
+
+    $canonicalRoot = $null
+    try { $canonicalRoot = Get-WReparseCanonicalPath -Path $Root }
+    catch {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message 'The scan root could not be canonicalised.'
+        return [pscustomobject]@{
+            Root    = $null
+            Records = @()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+
+    $state.Root = $canonicalRoot
+
+    if (-not (Test-Path -LiteralPath $canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+    if (-not (Test-Path -LiteralPath $canonicalRoot -PathType Container)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualDirectory $canonicalRoot `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return [pscustomobject]@{
+        Root    = $canonicalRoot
+        Records = $state.Records.ToArray()
+        Errors  = $state.Errors.ToArray()
+        Skipped = $state.Skipped
+    }
+}
diff --git a/verifyD.ps1 b/verifyD.ps1
new file mode 100644
index 0000000..d73130c
--- /dev/null
+++ b/verifyD.ps1
@@ -0,0 +1,57 @@
+[CmdletBinding()]
+param([string]$Workspace)
+$ErrorActionPreference = 'Stop'
+Import-Module (Join-Path $Workspace 'WReparse\WReparse.psd1') -Force
+
+$script:fail = 0
+function ok($name, $cond, $detail) {
+    if ($cond) { Write-Host "[PASS] $name" }
+    else { Write-Host "[FAIL] $name :: $detail"; $script:fail++ }
+}
+
+$common = @([System.Management.Automation.PSCmdlet]::CommonParameters) +
+          @([System.Management.Automation.PSCmdlet]::OptionalCommonParameters)
+
+$expect = @{
+    'Get-WReparseReport'        = @('Root', 'MaxDepth', 'Follow')
+    'ConvertTo-WReparseJson'    = @('Report')
+    'Get-WReparseSchemaVersion' = @()
+    'Test-WReparseWithinRoot'   = @('Path', 'Root')
+    'Get-WReparseCanonicalPath' = @('Path')
+    'Resolve-WReparseLinkTarget' = @('LinkFullPath', 'RawTarget')
+}
+
+foreach ($name in @($expect.Keys | Sort-Object)) {
+    $cmd = Get-Command -Name $name -Module WReparse -ErrorAction SilentlyContinue
+    if ($null -eq $cmd) { ok "$name exists" $false 'not found'; continue }
+    $actual = @($cmd.Parameters.Keys | Where-Object { $common -notcontains $_ } | Sort-Object)
+    $wanted = @($expect[$name] | Sort-Object)
+    ok "$name parameters are exactly ($($wanted -join ', '))" `
+        (($actual -join ',') -eq ($wanted -join ',')) ($actual -join ',')
+}
+
+# -Root is mandatory on Get-WReparseReport
+$rootParam = (Get-Command Get-WReparseReport -Module WReparse).Parameters['Root']
+ok 'Get-WReparseReport -Root is mandatory' `
+    (@($rootParam.Attributes | Where-Object { $_ -is [System.Management.Automation.ParameterAttribute] -and $_.Mandatory }).Count -ge 1) 'optional'
+# -MaxDepth defaults to 32, -Follow is a switch
+ok 'Get-WReparseReport -Follow is a switch' `
+    ((Get-Command Get-WReparseReport -Module WReparse).Parameters['Follow'].ParameterType.FullName -eq 'System.Management.Automation.SwitchParameter') 'not a switch'
+ok 'Get-WReparseReport -MaxDepth is an int' `
+    ((Get-Command Get-WReparseReport -Module WReparse).Parameters['MaxDepth'].ParameterType.FullName -eq 'System.Int32') 'not an int'
+
+# the default MaxDepth is 32: a 33-level tree is cut at depth 32
+$deepRoot = Join-Path $env:TEMP ('wrdeep-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
+$p = $deepRoot
+for ($i = 1; $i -le 34; $i++) { $p = Join-Path $p ('d' + $i) }
+New-Item -ItemType Directory -Force -Path $p | Out-Null
+$dr = Get-WReparseReport -Root $deepRoot
+$maxSeen = (@($dr.Records | ForEach-Object { $_.Depth }) | Measure-Object -Maximum).Maximum
+ok 'default MaxDepth 32 caps the recorded depth at 32' ($maxSeen -eq 32) ([string]$maxSeen)
+ok 'the capped directory reports too_deep' (@($dr.Errors | Where-Object { $_.Code -eq 'too_deep' }).Count -ge 1) 'none'
+Remove-Item -LiteralPath $deepRoot -Recurse -Force -ErrorAction SilentlyContinue
+
+# Get-WReparseSchemaVersion returns the contract string
+ok 'Get-WReparseSchemaVersion returns wreparse/1.0' ((Get-WReparseSchemaVersion) -ceq 'wreparse/1.0') (Get-WReparseSchemaVersion)
+
+Write-Host "FAILCOUNT=$script:fail"
