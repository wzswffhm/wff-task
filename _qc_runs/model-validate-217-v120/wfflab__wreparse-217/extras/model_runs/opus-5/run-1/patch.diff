+# WReparse - data model
+# Shared vocabulary: error codes, enumerations, and factory helpers.
+# Part of the WReparse implementation. See the contract under docs/
+
+Set-StrictMode -Version Latest
+
+# Error codes are part of the public contract. Order is stable and is not
+# sorted at serialisation time; callers match on the literal string.
+$script:WReparseErrorCode = @(
+    'not_found'
+    'access_denied'
+    'cycle'
+    'broken_target'
+    'structure'
+    'too_deep'
+    'invalid_argument'
+)
+
+$script:WReparseSchemaVersion = ('wreparse' + '/1.0')
+
+# Entry kinds. A hard link is a FILE, not a reparse point: the two NTFS
+# directory entries share one data stream and neither entry carries a
+# reparse attribute. Only entries whose file attributes contain
+# FILE_ATTRIBUTE_REPARSE_POINT are reported with Kind = 'ReparsePoint'.
+$script:WReparseKindDirectory = 'Directory'
+$script:WReparseKindFile = 'File'
+$script:WReparseKindReparse = 'ReparsePoint'
+
+function Get-WReparseErrorCode {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseErrorCode
+}
+
+function Get-WReparseSchemaVersion {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseSchemaVersion
+}
+
+# Normalises any collection into a real object[]. $null and empty input yield
+# an empty array rather than a one-element array holding $null.
+# NOTE: PowerShell unrolls an empty array on return, so every caller must
+# wrap the call as [object[]]@( ... ) before storing the result.
+function ConvertTo-WReparseArray {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $false)][AllowNull()][AllowEmptyCollection()]$Value)
+    $list = New-Object System.Collections.ArrayList
+    if ($null -ne $Value) {
+        foreach ($item in @($Value)) {
+            if ($null -eq $item) { continue }
+            [void]$list.Add($item)
+        }
+    }
+    return [object[]]$list.ToArray()
+}
+
+function New-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    if ($script:WReparseErrorCode -notcontains $Code) {
+        throw "Unknown WReparse error code: $Code"
+    }
+    return [pscustomobject][ordered]@{
+        RelativePath = $RelativePath
+        Code         = $Code
+        Message      = $Message
+    }
+}
+
+# Record factory. ReparseKind / Target / ResolvedTarget stay untyped so that
+# $null survives (a [string] cast would turn them into '' and serialise as ""
+# instead of the JSON null the contract requires).
+function New-WReparseRecord {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Kind,
+        $ReparseKind = $null,
+        $Target = $null,
+        $ResolvedTarget = $null,
+        [bool]$InScope = $false,
+        [int]$Depth = 0,
+        [long]$Size = 0
+    )
+    if ($Kind -ne $script:WReparseKindReparse) {
+        # Non-reparse entries never carry link information and InScope is
+        # meaningless for them: pin the contract's values here so no caller
+        # can leak a '' or a $true into the report.
+        $ReparseKind = $null
+        $Target = $null
+        $ResolvedTarget = $null
+        $InScope = $false
+    }
+    else {
+        # Target is one string, never a collection: the provider hands out a
+        # String[] and PowerShell unrolls single-element arrays, so without
+        # this the field's type would vary with the number of targets.
+        if ($null -ne $Target -and $Target -isnot [string]) {
+            $first = @($Target) | Select-Object -First 1
+            $Target = if ($null -eq $first) { $null } else { [string]$first }
+        }
+        if ($null -ne $ResolvedTarget -and $ResolvedTarget -isnot [string]) {
+            $firstResolved = @($ResolvedTarget) | Select-Object -First 1
+            $ResolvedTarget = if ($null -eq $firstResolved) { $null } else { [string]$firstResolved }
+        }
+        if ($null -ne $Target -and [string]::IsNullOrEmpty([string]$Target)) { $Target = $null }
+        if ($null -ne $ResolvedTarget -and [string]::IsNullOrEmpty([string]$ResolvedTarget)) { $ResolvedTarget = $null }
+    }
+    return [pscustomobject][ordered]@{
+        RelativePath   = $RelativePath
+        Kind           = $Kind
+        ReparseKind    = $ReparseKind
+        Target         = $Target
+        ResolvedTarget = $ResolvedTarget
+        InScope        = $InScope
+        Depth          = $Depth
+        Size           = $Size
+    }
+}
+
+function New-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [int]$Directories = 0,
+        [int]$Files = 0,
+        [int]$ReparsePoints = 0,
+        [int]$Skipped = 0,
+        [int]$Errors = 0
+    )
+    return [pscustomobject][ordered]@{
+        Directories   = $Directories
+        Files         = $Files
+        ReparsePoints = $ReparsePoints
+        Skipped       = $Skipped
+        Errors        = $Errors
+    }
+}
+
+# The report carries exactly the five contract fields. No timestamp, no
+# process id, no machine name: two consecutive scans of one tree must
+# serialise byte for byte identically.
+function New-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [Parameter(Mandatory = $false)][AllowNull()][AllowEmptyCollection()]$Records = @(),
+        [Parameter(Mandatory = $false)][AllowNull()][AllowEmptyCollection()]$Errors = @(),
+        [Parameter(Mandatory = $true)][object]$Stats
+    )
+    # The arrays are materialised into locals first: an inline call would be
+    # unrolled to AutomationNull when empty and serialise as {} instead of [].
+    $recordArray = [object[]]@(ConvertTo-WReparseArray -Value $Records)
+    $errorArray = [object[]]@(ConvertTo-WReparseArray -Value $Errors)
+    return [pscustomobject][ordered]@{
+        SchemaVersion = $script:WReparseSchemaVersion
+        Root          = $Root
+        Records       = $recordArray
+        Errors        = $errorArray
+        Stats         = $Stats
+    }
+}
