+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse reference implementation.
+
+Set-StrictMode -Version Latest
+
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
+# Maps the provider link type to the contract vocabulary. Only entries whose
+# attributes carry FILE_ATTRIBUTE_REPARSE_POINT reach here, so a hard link
+# (link type 'HardLink', no reparse attribute) is never mapped. A junction and
+# a symbolic link must land on DIFFERENT kinds.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $false)][AllowNull()][AllowEmptyString()][string]$LinkType)
+    switch ($LinkType) {
+        'SymbolicLink' { return 'SymbolicLink' }
+        'Junction' { return 'Junction' }
+        'MountPoint' { return 'MountPoint' }
+        default { return 'Unknown' }
+    }
+}
+
+# The reparse attribute is the only reliable marker: testing LinkType instead
+# would misclassify a hard link as a reparse point.
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Item)
+    if ($null -eq $Item) { return $false }
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return $false }
+    try { $flags = [System.IO.FileAttributes]$attributes } catch { return $false }
+    return (($flags -band [System.IO.FileAttributes]::ReparsePoint) -eq [System.IO.FileAttributes]::ReparsePoint)
+}
+
+# Normalises the provider's Target to a single string. Get-ChildItem exposes
+# Target as a string[] and PowerShell unrolls single-element arrays when they
+# are forwarded, so the type is pinned down explicitly here.
+function Get-WReparseRawTarget {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Item)
+    $value = Get-WReparseMemberValue -InputObject $Item -Name 'Target'
+    if ($null -eq $value) { return $null }
+    if ($value -is [string]) {
+        if ([string]::IsNullOrWhiteSpace($value)) { return $null }
+        return [string]$value
+    }
+    foreach ($candidate in @($value)) {
+        if ($null -eq $candidate) { continue }
+        $text = [string]$candidate
+        if (-not [string]::IsNullOrWhiteSpace($text)) { return $text }
+    }
+    return $null
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+# Relative paths follow the VIRTUAL route taken to reach an entry, so entries
+# found through a followed link are named after the link ('link-in\readme.txt').
+function Join-WReparseRelativePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Prefix,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ([string]::IsNullOrEmpty($Prefix)) { return $Name }
+    return ($Prefix + '\' + $Name)
+}
+
+# Ancestry membership uses ordinal-ignore-case comparison (Windows semantics).
+function Test-WReparseAncestryContains {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][string]$Candidate
+    )
+    foreach ($entry in @($Ancestry)) {
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([string]$entry, $Candidate)) { return $true }
+    }
+    return $false
+}
+
+# Descends into a directory unless its own Depth has reached MaxDepth, in
+# which case its children are not enumerated and IT gets the 'too_deep' entry.
+# The scan root carries no Depth of its own and is always enumerated.
+function Invoke-WReparseDescend {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][string]$RelativePrefix,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+    if ($Depth -ge $State.MaxDepth) {
+        Add-WReparseError -State $State -RelativePath $RelativePrefix -Code 'too_deep' `
+            -Message "Depth limit of $($State.MaxDepth) reached; not enumerating."
+        return
+    }
+    Invoke-WReparseDirectoryWalk -RealDirectory $RealDirectory -RelativePrefix $RelativePrefix `
+        -Depth $Depth -Ancestry $Ancestry -State $State
+}
+
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePrefix,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+    $self = if ([string]::IsNullOrEmpty($RelativePrefix)) { '.' } else { $RelativePrefix }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch {
+        # Failure to enumerate one directory must never abort the whole scan.
+        $message = 'Access denied while enumerating the directory.'
+        if ($_.Exception -isnot [System.UnauthorizedAccessException]) {
+            $message = [string]$_.Exception.Message
+        }
+        Add-WReparseError -State $State -RelativePath $self -Code 'access_denied' -Message $message
+        return
+    }
+
+    foreach ($child in $children) {
+        $childDepth = $Depth + 1
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        $name = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        if ([string]::IsNullOrEmpty($name)) { $name = Split-Path -Leaf $realChild }
+        $relative = Join-WReparseRelativePath -Prefix $RelativePrefix -Name $name
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = Get-WReparseRawTarget -Item $child
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+            $inScope = $false
+            if ($null -ne $resolved) {
+                $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+            }
+
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind 'ReparsePoint' `
+                -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                -Depth $childDepth -Size 0))
+
+            # Default mode: register the entry, never enter the target, count
+            # it as skipped. No cycle / broken_target diagnosis happens here:
+            # that would require inspecting the target.
+            if (-not $State.Follow) {
+                $State.Skipped++
+                continue
+            }
+
+            if ($null -eq $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target could not be resolved.'
+                continue
+            }
+            if (-not (Test-Path -LiteralPath $resolved)) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+
+            # A cycle is an ancestor of THIS branch. Two sibling links to the
+            # same target are not a cycle: neither appears on the other's chain.
+            if (Test-WReparseAncestryContains -Ancestry $Ancestry -Candidate $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                    -Message 'The reparse target is an ancestor already visited on this branch.'
+                continue
+            }
+
+            # A link to a file contributes the link record only: no children.
+            if (Test-Path -LiteralPath $resolved -PathType Container) {
+                Invoke-WReparseDescend -RealDirectory $resolved -RelativePrefix $relative `
+                    -Depth $childDepth -Ancestry (@($Ancestry) + @($resolved)) -State $State
+            }
+            continue
+        }
+
+        $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) { $size = [long]$length }
+        }
+        $kind = if ($isContainer) { 'Directory' } else { 'File' }
+
+        # InScope is meaningful for reparse entries only; plain files and
+        # directories (including hard links) always report false.
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+            -Depth $childDepth -Size $size))
+
+        if ($isContainer) {
+            $realChildCanonical = $realChild
+            try { $realChildCanonical = Get-WReparseCanonicalPath -Path $realChild } catch { }
+            Invoke-WReparseDescend -RealDirectory $realChildCanonical -RelativePrefix $relative `
+                -Depth $childDepth -Ancestry (@($Ancestry) + @($realChildCanonical)) -State $State
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [ValidateSet('Never', 'Always')][string]$FollowMode = 'Never',
+        [int]$MaxDepth = 32
+    )
+    # A negative depth budget behaves exactly like 0.
+    $effectiveMaxDepth = $MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $state = @{
+        Records  = New-Object System.Collections.ArrayList
+        Errors   = New-Object System.Collections.ArrayList
+        Skipped  = 0
+        Root     = $null
+        Follow   = ($FollowMode -eq 'Always')
+        MaxDepth = $effectiveMaxDepth
+    }
+
+    $canonicalRoot = $null
+    try { $canonicalRoot = Get-WReparseCanonicalPath -Path $Root }
+    catch {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message 'The scan root could not be canonicalised.'
+        return New-WReparseWalkResult -Root $Root -State $state -IncludeRecords $false
+    }
+
+    $state.Root = $canonicalRoot
+
+    if (-not (Test-Path -LiteralPath $canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return New-WReparseWalkResult -Root $canonicalRoot -State $state -IncludeRecords $false
+    }
+    if (-not (Test-Path -LiteralPath $canonicalRoot -PathType Container)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return New-WReparseWalkResult -Root $canonicalRoot -State $state -IncludeRecords $false
+    }
+
+    # The root itself produces no record; its direct children are depth 1.
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -RelativePrefix '' `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return New-WReparseWalkResult -Root $canonicalRoot -State $state -IncludeRecords $true
+}
+
+function New-WReparseWalkResult {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [bool]$IncludeRecords = $true
+    )
+    $records = @()
+    if ($IncludeRecords) { $records = $State.Records.ToArray() }
+    return [pscustomobject]@{
+        Root    = $Root
+        Records = [object[]]@($records)
+        Errors  = [object[]]@($State.Errors.ToArray())
+        Skipped = [int]$State.Skipped
+    }
+}
