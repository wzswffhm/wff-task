+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse reference implementation.
+
+Set-StrictMode -Version Latest
+
+# Stable merge sort so the report never depends on the enumerator order or on
+# the host culture. Sort-Object is deliberately not used: its default string
+# comparison is culture-aware and would order non-ASCII names differently on
+# different hosts (it sorts 'Ä' and 'ö' before ASCII 'Z', while the ordinal
+# rule required by the contract puts 'Z' first).
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $false)][AllowEmptyCollection()][AllowNull()][object[]]$Items,
+        [Parameter(Mandatory = $true)][scriptblock]$Comparer
+    )
+    $array = @($Items)
+    if ($array.Count -le 1) { return [object[]]@($array) }
+
+    $middle = [int][System.Math]::Floor($array.Count / 2)
+    $leftInput = [object[]]@($array[0..($middle - 1)])
+    $rightInput = [object[]]@($array[$middle..($array.Count - 1)])
+    $left = @(Sort-WReparseStable -Items $leftInput -Comparer $Comparer)
+    $right = @(Sort-WReparseStable -Items $rightInput -Comparer $Comparer)
+
+    $merged = New-Object System.Collections.ArrayList
+    $i = 0
+    $j = 0
+    while ($i -lt $left.Count -and $j -lt $right.Count) {
+        # '-le 0' keeps equal elements in their original relative order.
+        if ([int](& $Comparer $left[$i] $right[$j]) -le 0) {
+            [void]$merged.Add($left[$i]); $i++
+        }
+        else {
+            [void]$merged.Add($right[$j]); $j++
+        }
+    }
+    while ($i -lt $left.Count) { [void]$merged.Add($left[$i]); $i++ }
+    while ($j -lt $right.Count) { [void]$merged.Add($right[$j]); $j++ }
+    return [object[]]@($merged.ToArray())
+}
+
+# Records order on RelativePath alone: ordinal-ignore-case, then ordinal.
+function Sort-WReparseRecord {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $false)][AllowEmptyCollection()][AllowNull()][object[]]$Records)
+    $comparer = {
+        param($a, $b)
+        Compare-WReparsePath -Left ([string]$a.RelativePath) -Right ([string]$b.RelativePath)
+    }
+    return [object[]]@(Sort-WReparseStable -Items $Records -Comparer $comparer)
+}
+
+# Errors order on RelativePath first, then Code, with the same ordinal rules.
+function Sort-WReparseErrorList {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $false)][AllowEmptyCollection()][AllowNull()][object[]]$Errors)
+    $comparer = {
+        param($a, $b)
+        $primary = Compare-WReparsePath -Left ([string]$a.RelativePath) -Right ([string]$b.RelativePath)
+        if ($primary -ne 0) { return $primary }
+        return Compare-WReparsePath -Left ([string]$a.Code) -Right ([string]$b.Code)
+    }
+    return [object[]]@(Sort-WReparseStable -Items $Errors -Comparer $comparer)
+}
+
+# The three category counts are mutually exclusive and must add up to the
+# record total: a reparse point is neither a Directory nor a File.
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $false)][AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        switch ([string]$record.Kind) {
+            'Directory' { $directories++ }
+            'File' { $files++ }
+            'ReparsePoint' { $reparse++ }
+        }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+    $followMode = if ($Follow) { 'Always' } else { 'Never' }
+    $walk = Invoke-WReparseWalk -Root $Root -FollowMode $followMode -MaxDepth $MaxDepth
+
+    $records = [object[]]@(Sort-WReparseRecord -Records $walk.Records)
+    $errors = [object[]]@(Sort-WReparseErrorList -Errors $walk.Errors)
+    $stats = Get-WReparseStats -Records $records -Skipped $walk.Skipped -ErrorCount $errors.Count
+
+    return New-WReparseReport -Root ([string]$walk.Root) -Records $records -Errors $errors -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$Report
+    )
+    return ($Report | ConvertTo-Json -Depth 12)
+}
