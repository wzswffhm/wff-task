+# WReparse - data model
+# Shared vocabulary: error codes, enumerations, and factory helpers.
+# Part of the WReparse implementation. See the contract under docs/
+
+Set-StrictMode -Version Latest
+
+# Error codes are part of the public contract. Order is stable and is not
+# sorted at serialisation time; callers match on the literal string.
+$script:WReparseErrorCode = @(
+    'not_found'
+    'access_denied'
+    'cycle'
+    'broken_target'
+    'structure'
+    'too_deep'
+    'invalid_argument'
+)
+
+$script:WReparseSchemaVersion = ('wreparse' + '/1.0')
+
+# Entry kinds. A hard link is a FILE, not a reparse point: the two NTFS
+# directory entries share one data stream and neither entry carries a
+# reparse attribute. Only entries whose file attributes contain
+# FILE_ATTRIBUTE_REPARSE_POINT are reported with Kind = 'ReparsePoint'.
+$script:WReparseKindDirectory = 'Directory'
+$script:WReparseKindFile = 'File'
+$script:WReparseKindReparse = 'ReparsePoint'
+
+function Get-WReparseErrorCode {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseErrorCode
+}
+
+function Get-WReparseSchemaVersion {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseSchemaVersion
+}
+
+function New-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    if ($script:WReparseErrorCode -notcontains $Code) {
+        throw "Unknown WReparse error code: $Code"
+    }
+    return [pscustomobject][ordered]@{
+        RelativePath = $RelativePath
+        Code         = $Code
+        Message      = $Message
+    }
+}
+
+# Normalises an optional string field: anything empty becomes $null so that
+# the serialised report carries JSON null rather than "".
+function ConvertTo-WReparseOptionalString {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $false)]$Value)
+    if ($null -eq $Value) { return $null }
+    # The provider may hand back a collection (string[]); the contract keeps a
+    # single target string, so take the first element and force the type.
+    if ($Value -isnot [string]) {
+        $first = $null
+        foreach ($candidate in @($Value)) {
+            if ($null -ne $candidate) { $first = $candidate; break }
+        }
+        if ($null -eq $first) { return $null }
+        $Value = [string]$first
+    }
+    $text = [string]$Value
+    if ([string]::IsNullOrEmpty($text)) { return $null }
+    return $text
+}
+
+function New-WReparseRecord {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Kind,
+        $ReparseKind = $null,
+        $Target = $null,
+        $ResolvedTarget = $null,
+        [bool]$InScope = $false,
+        [int]$Depth = 0,
+        [long]$Size = 0
+    )
+    $reparseKindValue = $null
+    $targetValue = $null
+    $resolvedValue = $null
+    $inScopeValue = $false
+
+    # Only reparse entries carry link metadata. For every other kind the three
+    # link fields are null and InScope is false, by contract.
+    if ($Kind -eq $script:WReparseKindReparse) {
+        $reparseKindValue = ConvertTo-WReparseOptionalString -Value $ReparseKind
+        if ($null -eq $reparseKindValue) { $reparseKindValue = 'Unknown' }
+        $targetValue = ConvertTo-WReparseOptionalString -Value $Target
+        $resolvedValue = ConvertTo-WReparseOptionalString -Value $ResolvedTarget
+        $inScopeValue = $InScope
+    }
+
+    return [pscustomobject][ordered]@{
+        RelativePath   = $RelativePath
+        Kind           = $Kind
+        ReparseKind    = $reparseKindValue
+        Target         = $targetValue
+        ResolvedTarget = $resolvedValue
+        InScope        = [bool]$inScopeValue
+        Depth          = [int]$Depth
+        Size           = [long]$Size
+    }
+}
+
+function New-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [int]$Directories = 0,
+        [int]$Files = 0,
+        [int]$ReparsePoints = 0,
+        [int]$Skipped = 0,
+        [int]$Errors = 0
+    )
+    return [pscustomobject][ordered]@{
+        Directories   = $Directories
+        Files         = $Files
+        ReparsePoints = $ReparsePoints
+        Skipped       = $Skipped
+        Errors        = $Errors
+    }
+}
+
+# The report carries exactly the five contract fields: no timestamp, no host
+# or process information, nothing else that would make two scans of the same
+# tree serialise differently.
+function New-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][object[]]$Records,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][object[]]$Errors,
+        [Parameter(Mandatory = $true)][object]$Stats
+    )
+    return [pscustomobject][ordered]@{
+        SchemaVersion = $script:WReparseSchemaVersion
+        Root          = $Root
+        Records       = [object[]]@($Records)
+        Errors        = [object[]]@($Errors)
+        Stats         = $Stats
+    }
+}
