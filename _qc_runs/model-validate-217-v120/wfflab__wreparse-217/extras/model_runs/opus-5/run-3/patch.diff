+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse reference implementation.
+
+# Stable merge sort so the report never depends on the enumerator order or on
+# the host culture. Sort-Object is deliberately not used: its default string
+# comparison is culture-aware and would order non-ASCII names differently on
+# different hosts ('Ä'/'ö' before ASCII 'Z'), while the contract requires the
+# ordinal order ('Z' before 'Ä' and 'ö').
+#
+# Every caller wraps the result in @(): an empty result unrolls to nothing on
+# the pipeline, and the wrapper turns it back into an empty array.
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][AllowNull()][object[]]$Items,
+        [Parameter(Mandatory = $true)][scriptblock]$Comparer
+    )
+    $array = @($Items)
+    if ($array.Count -le 1) { return @($array) }
+    $middle = [int]($array.Count / 2)
+    $left = @(Sort-WReparseStable -Items @($array[0..($middle - 1)]) -Comparer $Comparer)
+    $right = @(Sort-WReparseStable -Items @($array[$middle..($array.Count - 1)]) -Comparer $Comparer)
+    $merged = New-Object System.Collections.ArrayList
+    $i = 0
+    $j = 0
+    while ($i -lt $left.Count -and $j -lt $right.Count) {
+        # '-le 0' keeps equal keys in their original relative order.
+        if ([int](& $Comparer $left[$i] $right[$j]) -le 0) {
+            [void]$merged.Add($left[$i]); $i++
+        }
+        else {
+            [void]$merged.Add($right[$j]); $j++
+        }
+    }
+    while ($i -lt $left.Count) { [void]$merged.Add($left[$i]); $i++ }
+    while ($j -lt $right.Count) { [void]$merged.Add($right[$j]); $j++ }
+    return @($merged.ToArray())
+}
+
+# Records order: ordinal-ignore-case on RelativePath, ordinal tie-break.
+function Sort-WReparseRecord {
+    [CmdletBinding()]
+    param([AllowEmptyCollection()][AllowNull()][object[]]$Records)
+    $comparer = {
+        param($Left, $Right)
+        Compare-WReparsePath -Left ([string]$Left.RelativePath) -Right ([string]$Right.RelativePath)
+    }
+    return @(Sort-WReparseStable -Items @($Records) -Comparer $comparer)
+}
+
+# Errors order: RelativePath first, then Code; same ordinal comparison.
+function Sort-WReparseErrorEntry {
+    [CmdletBinding()]
+    param([AllowEmptyCollection()][AllowNull()][object[]]$Errors)
+    $comparer = {
+        param($Left, $Right)
+        $primary = Compare-WReparsePath -Left ([string]$Left.RelativePath) -Right ([string]$Right.RelativePath)
+        if ($primary -ne 0) { return $primary }
+        return Compare-WReparsePath -Left ([string]$Left.Code) -Right ([string]$Right.Code)
+    }
+    return @(Sort-WReparseStable -Items @($Errors) -Comparer $comparer)
+}
+
+# The three kind counters are mutually exclusive and their sum equals the
+# number of records.
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        switch ([string]$record.Kind) {
+            'Directory' { $directories++ }
+            'File' { $files++ }
+            'ReparsePoint' { $reparse++ }
+        }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+    $walk = Invoke-WReparseWalk -Root $Root -Follow:$Follow -MaxDepth $MaxDepth
+    $records = @(Sort-WReparseRecord -Records @($walk.Records))
+    $errors = @(Sort-WReparseErrorEntry -Errors @($walk.Errors))
+    $stats = Get-WReparseStats -Records $records -Skipped ([int]$walk.Skipped) -ErrorCount $errors.Count
+    return New-WReparseReport -Root ([string]$walk.Root) -Records $records -Errors $errors -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]$Report
+    )
+    process {
+        $json = ConvertTo-Json -InputObject $Report -Depth 12
+        # Windows PowerShell 5.1 pretty-prints an empty collection as
+        # "[\r\n\r\n]". The contract requires an empty array to serialise as
+        # []. The pattern is anchored on the two array-valued keys, so no
+        # string value inside the report can be rewritten.
+        return [System.Text.RegularExpressions.Regex]::Replace(
+            [string]$json,
+            '("(?:Records|Errors)"\s*:\s*)\[\s*\]',
+            '$1[]')
+    }
+}
