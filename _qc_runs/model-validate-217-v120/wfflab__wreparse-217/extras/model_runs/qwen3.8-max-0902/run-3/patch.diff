+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse reference implementation.
+# See docs/REPARSE-CONTRACT.md
+
+# Reads a comparison key off an item without ever throwing: a missing member
+# simply sorts as the empty string.
+function Get-WReparseSortKey {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$Item,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Name
+    )
+    if ($null -eq $Item) { return '' }
+    $property = $Item.PSObject.Properties[$Name]
+    if ($null -eq $property) { return '' }
+    if ($null -eq $property.Value) { return '' }
+    return [string]$property.Value
+}
+
+# Stable bottom-up merge sort driven by ordinal comparison keys.
+# Sort-Object is deliberately not used: its default string comparison is
+# culture aware and orders non-ASCII names differently on different hosts
+# (on this host a culture aware comparison puts accented letters before
+# ASCII Z; the ordinal rules required by the contract do the opposite).
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][object[]]$Items,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][string[]]$PrimaryKeys,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][string[]]$SecondaryKeys
+    )
+
+    $list = @($Items)
+    $count = $list.Count
+    if ($count -eq 0) { return @() }
+    if ($count -eq 1) { return @($list[0]) }
+
+    $primarySource = @($PrimaryKeys)
+    $secondarySource = @($SecondaryKeys)
+    $primary = New-Object 'string[]' $count
+    $secondary = New-Object 'string[]' $count
+    for ($i = 0; $i -lt $count; $i++) {
+        if ($i -lt $primarySource.Count -and $null -ne $primarySource[$i]) { $primary[$i] = [string]$primarySource[$i] }
+        else { $primary[$i] = '' }
+        if ($i -lt $secondarySource.Count -and $null -ne $secondarySource[$i]) { $secondary[$i] = [string]$secondarySource[$i] }
+        else { $secondary[$i] = '' }
+    }
+
+    $order = New-Object 'int[]' $count
+    for ($i = 0; $i -lt $count; $i++) { $order[$i] = $i }
+
+    $width = 1
+    while ($width -lt $count) {
+        $next = New-Object 'int[]' $count
+        $position = 0
+        for ($start = 0; $start -lt $count; $start += ($width * 2)) {
+            $leftEnd = [Math]::Min($start + $width, $count)
+            $rightEnd = [Math]::Min($start + ($width * 2), $count)
+            $left = $start
+            $right = $leftEnd
+            while ($left -lt $leftEnd -and $right -lt $rightEnd) {
+                $leftIndex = $order[$left]
+                $rightIndex = $order[$right]
+                $comparison = Compare-WReparsePath -Left $primary[$leftIndex] -Right $primary[$rightIndex]
+                if ($comparison -eq 0) {
+                    $comparison = Compare-WReparsePath -Left $secondary[$leftIndex] -Right $secondary[$rightIndex]
+                }
+                if ($comparison -le 0) {
+                    $next[$position] = $leftIndex
+                    $left++
+                }
+                else {
+                    $next[$position] = $rightIndex
+                    $right++
+                }
+                $position++
+            }
+            while ($left -lt $leftEnd) { $next[$position] = $order[$left]; $position++; $left++ }
+            while ($right -lt $rightEnd) { $next[$position] = $order[$right]; $position++; $right++ }
+        }
+        $order = $next
+        $width = $width * 2
+    }
+
+    $sorted = New-Object 'object[]' $count
+    for ($i = 0; $i -lt $count; $i++) { $sorted[$i] = $list[$order[$i]] }
+    return $sorted
+}
+
+# Records are ordered by RelativePath: ordinal, case-insensitive as the primary
+# key with an ordinal, case-sensitive tie-break (contract section 6.1).
+function Sort-WReparseRecords {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][object[]]$Items
+    )
+    $list = @($Items)
+    $count = $list.Count
+    if ($count -eq 0) { return @() }
+    $keys = New-Object 'string[]' $count
+    for ($i = 0; $i -lt $count; $i++) {
+        $keys[$i] = Get-WReparseSortKey -Item $list[$i] -Name 'RelativePath'
+    }
+    return @(Sort-WReparseStable -Items $list -PrimaryKeys $keys -SecondaryKeys $keys)
+}
+
+# Errors are ordered by RelativePath then Code, using the same comparison rules
+# (contract section 6.3).
+function Sort-WReparseErrors {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][object[]]$Items
+    )
+    $list = @($Items)
+    $count = $list.Count
+    if ($count -eq 0) { return @() }
+    $primary = New-Object 'string[]' $count
+    $secondary = New-Object 'string[]' $count
+    for ($i = 0; $i -lt $count; $i++) {
+        $primary[$i] = Get-WReparseSortKey -Item $list[$i] -Name 'RelativePath'
+        $secondary[$i] = Get-WReparseSortKey -Item $list[$i] -Name 'Code'
+    }
+    return @(Sort-WReparseStable -Items $list -PrimaryKeys $primary -SecondaryKeys $secondary)
+}
+
+# The three category counters are mutually exclusive and together account for
+# every record (contract section 3.3).
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        if ($null -eq $record) { continue }
+        $kind = Get-WReparseSortKey -Item $record -Name 'Kind'
+        if ($kind -ceq $script:WReparseKindFile) { $files++ }
+        elseif ($kind -ceq $script:WReparseKindReparse) { $reparse++ }
+        elseif ($kind -ceq $script:WReparseKindDirectory) { $directories++ }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+    $followMode = 'Never'
+    if ($Follow) { $followMode = 'Always' }
+
+    $walk = Invoke-WReparseWalk -Root $Root -FollowMode $followMode -MaxDepth $MaxDepth
+
+    $records = @(Sort-WReparseRecords -Items @($walk.Records))
+    $errors = @(Sort-WReparseErrors -Items @($walk.Errors))
+    $skipped = 0
+    if ($null -ne $walk.Skipped) { $skipped = [int]$walk.Skipped }
+    $stats = Get-WReparseStats -Records $records -Skipped $skipped -ErrorCount $errors.Count
+
+    $root = [string](Get-WReparseMemberValue -InputObject $walk -Name 'Root')
+    return New-WReparseReport -Root $root -Records $records -Errors $errors -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$Report
+    )
+    if ($null -eq $Report) {
+        throw 'Cannot serialise a null report.'
+    }
+    # -Depth 12 keeps every nested record field intact; $null members are
+    # emitted as JSON null.
+    [string]$json = ($Report | ConvertTo-Json -Depth 12)
+    if ([string]::IsNullOrEmpty($json)) { return $json }
+    # Windows PowerShell renders an empty collection as a bracket pair with
+    # layout whitespace in between. Records and Errors are always arrays, so
+    # collapse exactly those two properties to the canonical '[]' form. The
+    # expression is anchored on the property name, so no string value inside a
+    # record can be touched.
+    return [regex]::Replace($json, '("(?:Records|Errors)"\s*:\s*)\[\s*\]', '$1[]')
+}
