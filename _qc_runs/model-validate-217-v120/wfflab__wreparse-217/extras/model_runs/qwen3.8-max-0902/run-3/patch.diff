+# WReparse - data model
+# Shared vocabulary: error codes, enumerations, and factory helpers.
+# Part of the WReparse implementation. See docs/REPARSE-CONTRACT.md
+
+Set-StrictMode -Version Latest
+
+# Error codes are part of the public contract. Order is stable and is not
+# sorted at serialisation time; callers match on the literal string.
+$script:WReparseErrorCode = @(
+    'not_found'
+    'access_denied'
+    'cycle'
+    'broken_target'
+    'structure'
+    'too_deep'
+    'invalid_argument'
+)
+
+$script:WReparseSchemaVersion = ('wreparse' + '/1.0')
+
+# Entry kinds. A hard link is a FILE, not a reparse point: the two NTFS
+# directory entries share one data stream and neither entry carries a
+# reparse attribute. Only entries whose file attributes contain
+# FILE_ATTRIBUTE_REPARSE_POINT are reported with Kind = 'ReparsePoint'.
+$script:WReparseKindDirectory = 'Directory'
+$script:WReparseKindFile = 'File'
+$script:WReparseKindReparse = 'ReparsePoint'
+
+# FILE_ATTRIBUTE_REPARSE_POINT, used as a numeric fallback when a provider
+# hands out the attributes as a plain number instead of the enum.
+$script:WReparseAttributeReparsePoint = 1024
+
+function Get-WReparseErrorCode {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseErrorCode
+}
+
+function Get-WReparseSchemaVersion {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseSchemaVersion
+}
+
+function New-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    if ($script:WReparseErrorCode -cnotcontains $Code) {
+        throw "Unknown WReparse error code: $Code"
+    }
+    if ($RelativePath.Length -eq 0) { $RelativePath = '.' }
+    return [pscustomobject][ordered]@{
+        RelativePath = $RelativePath
+        Code         = $Code
+        Message      = $Message
+    }
+}
+
+# Field order and null handling are part of the contract (section 3.1):
+# ReparseKind / Target / ResolvedTarget stay $null (JSON null) for entries
+# that are not reparse points, they are never turned into empty strings.
+function New-WReparseRecord {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Kind,
+        $ReparseKind = $null,
+        $Target = $null,
+        $ResolvedTarget = $null,
+        [bool]$InScope = $false,
+        [int]$Depth = 0,
+        [long]$Size = 0
+    )
+    if ($null -eq $ReparseKind -and $Kind -cne $script:WReparseKindReparse) {
+        $ReparseKind = $null
+    }
+    return [pscustomobject][ordered]@{
+        RelativePath   = $RelativePath
+        Kind           = $Kind
+        ReparseKind    = $ReparseKind
+        Target         = $Target
+        ResolvedTarget = $ResolvedTarget
+        InScope        = [bool]$InScope
+        Depth          = [int]$Depth
+        Size           = [long]$Size
+    }
+}
+
+function New-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [int]$Directories = 0,
+        [int]$Files = 0,
+        [int]$ReparsePoints = 0,
+        [int]$Skipped = 0,
+        [int]$Errors = 0
+    )
+    return [pscustomobject][ordered]@{
+        Directories   = [int]$Directories
+        Files         = [int]$Files
+        ReparsePoints = [int]$ReparsePoints
+        Skipped       = [int]$Skipped
+        Errors        = [int]$Errors
+    }
+}
+
+# The report carries exactly the five fields listed in section 3 of the
+# contract, in that order. No generation timestamp, no machine or process
+# specific value: two runs over the same tree must serialise identically.
+function New-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][AllowNull()][object[]]$Errors,
+        [Parameter(Mandatory = $true)][AllowNull()][object]$Stats
+    )
+    return [pscustomobject][ordered]@{
+        SchemaVersion = $script:WReparseSchemaVersion
+        Root          = [string]$Root
+        Records       = [object[]]@($Records)
+        Errors        = [object[]]@($Errors)
+        Stats         = $Stats
+    }
+}
diff --git a/WReparse/PathSemantics.ps1 b/WReparse/PathSemantics.ps1
index babc53d..24129df 100644
--- a/WReparse/PathSemantics.ps1
+++ b/WReparse/PathSemantics.ps1
@@ -1,37 +1,180 @@
 # WReparse - path semantics
 # Canonicalisation, directory-boundary containment, and link-target resolution.
-# Part of the WReparse implementation. See the contract under docs/
+# Part of the WReparse implementation. See docs/REPARSE-CONTRACT.md
+
+# Root prefix of a Windows path that uses '\' separators:
+#   'C:\'              for a volume root
+#   '\\server\share'   for a UNC share root
+#   '\'                for a rooted path without a volume (' \a\b')
+#   ''                 for a relative path
+function Get-WReparsePathRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$FullPath
+    )
+    if ([string]::IsNullOrEmpty($FullPath)) { return '' }
+    if ($FullPath.Length -ge 2 -and $FullPath[0] -eq '\' -and $FullPath[1] -eq '\') {
+        # UNC: the root is \\server\share
+        $serverEnd = $FullPath.IndexOf('\', 2)
+        if ($serverEnd -lt 3) { return '' }
+        $shareEnd = $FullPath.IndexOf('\', $serverEnd + 1)
+        if ($shareEnd -lt 0) { return $FullPath }
+        if ($shareEnd -eq $serverEnd + 1) { return '' }
+        return $FullPath.Substring(0, $shareEnd)
+    }
+    if ($FullPath.Length -ge 3 -and $FullPath[1] -eq ':' -and $FullPath[2] -eq '\') {
+        return $FullPath.Substring(0, 3)
+    }
+    if ($FullPath[0] -eq '\') { return '\' }
+    return ''
+}
+
+# Anchors a path that is not yet volume rooted at the process working
+# directory, mirroring what the framework does - without asking the file
+# system, so 8.3 short names and the caller's casing survive untouched.
+function Expand-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path
+    )
+    if ($Path.Length -ge 3 -and $Path[1] -eq ':' -and $Path[2] -eq '\') { return $Path }
+    if ($Path.Length -ge 2 -and $Path[0] -eq '\' -and $Path[1] -eq '\') { return $Path }
+
+    $cwd = [System.IO.Directory]::GetCurrentDirectory()
+    if ($null -eq $cwd) { $cwd = '' }
+    $cwd = $cwd.Replace('/', '\')
+    $cwdRoot = Get-WReparsePathRoot -FullPath $cwd
+    if ([string]::IsNullOrEmpty($cwdRoot)) { $cwdRoot = '\' }
+
+    if ($Path.Length -ge 2 -and $Path[1] -eq ':') {
+        # drive qualified but drive relative ('C:foo', 'C:')
+        $drive = $Path.Substring(0, 2)
+        $tail = $Path.Substring(2)
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals($cwdRoot, $drive + '\')) {
+            return ($cwd + '\' + $tail)
+        }
+        return ($drive + '\' + $tail)
+    }
+    if ($Path.Length -ge 1 -and $Path[0] -eq '\') {
+        # rooted on the current volume
+        return ($cwdRoot.TrimEnd('\') + $Path)
+    }
+    return ($cwd + '\' + $Path)
+}
+
+# Collapses '.' and '..', drops the trailing separator and keeps the shape of
+# volume roots ('C:\') and UNC share roots ('\\server\share').
+function Format-WReparseCanonical {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$AbsolutePath
+    )
+    $path = $AbsolutePath.Replace('/', '\')
+    $root = Get-WReparsePathRoot -FullPath $path
+    if ([string]::IsNullOrEmpty($root)) { throw "Cannot canonicalise path: $AbsolutePath" }
+    if ($root.TrimEnd('\').Length -eq 0) { throw "Cannot canonicalise path: $AbsolutePath" }
+
+    $isUnc = ($root.Length -ge 2 -and $root[0] -eq '\' -and $root[1] -eq '\')
+    $remainder = $path.Substring($root.Length)
+
