+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse reference implementation.
+# See docs/REPARSE-CONTRACT.md
+
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$InputObject,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
+# Combines an already canonical parent path with a single leaf name. Deliberately
+# not Join-Path and not the provider's FullName: the parent may be a volume root
+# (which keeps its trailing separator), re-expanding every child through the
+# file system would be slow, would fail past MAX_PATH and would rewrite 8.3
+# short names, breaking the lexical consistency of the whole report.
+function Join-WReparsePathPart {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Parent,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Leaf
+    )
+    if ([string]::IsNullOrEmpty($Parent)) { return [string]$Leaf }
+    if ([string]::IsNullOrEmpty($Leaf)) { return [string]$Parent }
+    if ($Parent.EndsWith('\')) { return ($Parent + $Leaf) }
+    return ($Parent + '\' + $Leaf)
+}
+
+# Maps the provider link type to the contract vocabulary. Only entries whose
+# file attributes carry FILE_ATTRIBUTE_REPARSE_POINT reach this function, so a
+# hard link (which has a link type but no reparse attribute) is never mapped.
+# Junctions and symbolic links are distinct kinds and stay distinct here.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([AllowNull()][AllowEmptyString()][string]$LinkType)
+    if ([string]::IsNullOrWhiteSpace($LinkType)) { return 'Unknown' }
+    $value = $LinkType.Trim()
+    if ([string]::Equals($value, 'SymbolicLink', [System.StringComparison]::OrdinalIgnoreCase)) { return 'SymbolicLink' }
+    if ([string]::Equals($value, 'Junction', [System.StringComparison]::OrdinalIgnoreCase)) { return 'Junction' }
+    if ([string]::Equals($value, 'MountPoint', [System.StringComparison]::OrdinalIgnoreCase)) { return 'MountPoint' }
+    # 'HardLink' and anything else the provider may invent: not a reparse kind.
+    return 'Unknown'
+}
+
+# The ONLY reliable reparse marker is FILE_ATTRIBUTE_REPARSE_POINT in the file
+# attributes. A hard link reports LinkType 'HardLink' but carries no reparse
+# attribute, so it must not be treated as a reparse point.
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Item)
+    if ($null -eq $Item) { return $false }
+    $property = $Item.PSObject.Properties['Attributes']
+    if ($null -eq $property) { return $false }
+    $attributes = $property.Value
+    if ($null -eq $attributes) { return $false }
+
+    if ($attributes -is [System.IO.FileAttributes]) {
+        $flag = [System.IO.FileAttributes]::ReparsePoint
+        return ((($attributes -band $flag) -eq $flag))
+    }
+
+    $text = [string]$attributes
+    $numeric = [long]0
+    if ([long]::TryParse($text, [ref]$numeric)) {
+        return ((($numeric -band $script:WReparseAttributeReparsePoint) -eq $script:WReparseAttributeReparsePoint))
+    }
+    foreach ($token in $text.Split([char]',')) {
+        if ([string]::Equals($token.Trim(), 'ReparsePoint', [System.StringComparison]::OrdinalIgnoreCase)) {
+            return $true
+        }
+    }
+    return $false
+}
+
+# The provider exposes .Target as a collection of substitution names
+# (System.String[]). The contract defines Target as a single target string, so
+# the first entry is taken and explicitly converted to a string: the reported
+# type must not depend on how many substitutions the reparse point carries.
+# The property is read directly (not through a helper that returns it) so that
+# PowerShell's single element array unrolling cannot change the observed type.
+function Get-WReparseRawTarget {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Item)
+    if ($null -eq $Item) { return $null }
+    $property = $Item.PSObject.Properties['Target']
+    if ($null -eq $property) { return $null }
+    $value = $property.Value
+    if ($null -eq $value) { return $null }
+    if ($value -is [string]) { return [string]$value }
+    $collection = @($value)
+    if ($collection.Count -eq 0) { return $null }
+    $first = $collection[0]
+    if ($null -eq $first) { return $null }
+    return [string]$first
+}
+
+# Identity key used to compare two paths that may be spelled differently but
+# denote the same directory (an 8.3 short name and its long name, for example).
+# Purely a comparison aid: it never reaches the report.
+function Get-WReparseRealKey {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Path
+    )
+    if ([string]::IsNullOrEmpty($Path)) { return '' }
+    $cache = $null
+    if ($null -ne $State) { $cache = $State['RealKeys'] }
+    if ($null -ne $cache -and $cache.Contains($Path)) { return [string]$cache[$Path] }
+
+    $key = $Path
+    try {
+        $expanded = [System.IO.Path]::GetFullPath($Path)
+        if (-not [string]::IsNullOrEmpty($expanded)) { $key = $expanded }
+    }
+    catch {
+        $key = $Path
+    }
+    if ($null -ne $cache) { $cache[$Path] = $key }
+    return $key
+}
+
+# Ordinal, case-insensitive membership test over the ancestor chain of the
+# branch currently being walked. PowerShell's -contains is culture aware and
+# must not be used for path comparisons. Two spellings of the same directory
+# (short name / long name) are recognised as equal.
+function Test-WReparsePathInList {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][hashtable]$State,
+        [AllowNull()][AllowEmptyCollection()][string[]]$List,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Path
+    )
+    if ([string]::IsNullOrEmpty($Path)) { return $false }
+    $key = Get-WReparseRealKey -State $State -Path $Path
+    foreach ($entry in @($List)) {
+        if ($null -eq $entry) { continue }
+        if ([string]::IsNullOrEmpty($entry)) { continue }
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([string]$entry, $Path)) { return $true }
+        $entryKey = Get-WReparseRealKey -State $State -Path ([string]$entry)
+        if ([string]::IsNullOrEmpty($entryKey)) { continue }
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals($entryKey, $key)) { return $true }
+    }
+    return $false
+}
+
+# Containment of a reparse target in the scan root. The public predicate is
+# lexical; when the two sides are spelled differently (8.3 short name against
+# long name) the file system identity of both paths decides.
+function Test-WReparseTargetInScope {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Resolved,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root
+    )
+    if ([string]::IsNullOrEmpty($Resolved) -or [string]::IsNullOrEmpty($Root)) { return $false }
+    if (Test-WReparseWithinRoot -Path $Resolved -Root $Root) { return $true }
+    $resolvedKey = Get-WReparseRealKey -State $State -Path $Resolved
+    $rootKey = Get-WReparseRealKey -State $State -Path $Root
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($resolvedKey, $rootKey)) { return $true }
+    return (Test-WReparseWithinRoot -Path $resolvedKey -Root $rootKey)
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    $relative = $RelativePath
+    if ([string]::IsNullOrEmpty($relative)) { $relative = '.' }
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $relative -Code $Code -Message $Message))
+}
+
+# Walks one directory.
+#   RealDirectory : canonical real path that is enumerated
+#   VirtualPrefix : path of that directory relative to the scan root ('.' for
+#                   the root itself); entries below a followed link are named
+#                   after the LINK, so this is the link's relative path there
+#   Depth         : depth of RealDirectory itself; the scan root is 0 and its
+#                   direct children are 1
+#   Ancestry      : canonical real paths of this branch, used for cycle checks
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$VirtualPrefix,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+
+    $virtualPrefix = $VirtualPrefix
+    if ([string]::IsNullOrEmpty($virtualPrefix)) { $virtualPrefix = '.' }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch {
+        # A failing enumeration must not abort the scan: report it and carry on
+        # with the remaining branches.
+        $message = 'Directory enumeration failed.'
+        if ($null -ne $_.Exception -and -not [string]::IsNullOrEmpty($_.Exception.Message)) {
+            $message = $_.Exception.Message
+        }
+        Add-WReparseError -State $State -RelativePath $virtualPrefix -Code 'access_denied' -Message $message
+        return
+    }
+
+    $maxDepth = [int]$State.MaxDepth
+    $follow = [bool]$State.Follow
+    $scanRoot = [string]$State.Root
+
+    foreach ($child in $children) {
+        if ($null -eq $child) { continue }
+
+        $childDepth = $Depth + 1
+        $leaf = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        $providerPath = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        if ([string]::IsNullOrEmpty($leaf)) { $leaf = [System.IO.Path]::GetFileName($providerPath) }
+        if ([string]::IsNullOrEmpty($leaf)) { continue }
+
+        # The real path is derived from the directory actually enumerated, never
+        # from the provider, so that short names and casing stay exactly as the
+        # scan root spelled them.
+        $childReal = Join-WReparsePathPart -Parent $RealDirectory -Leaf $leaf
+        if ($virtualPrefix -eq '.') { $relative = $leaf }
+        else { $relative = $virtualPrefix + '\' + $leaf }
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = Get-WReparseRawTarget -Item $child
+
+            # Resolution is purely lexical and always performed: ResolvedTarget
+            # and InScope are part of every reparse record.
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $childReal -RawTarget $rawTarget
+            $inScope = Test-WReparseTargetInScope -State $State -Resolved $resolved -Root $scanRoot
+
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative `
+                -Kind $script:WReparseKindReparse `
+                -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                -Depth $childDepth -Size 0))
+
+            if (-not $follow) {
+                # Never enter a reparse target unless explicitly asked to. No
+                # cycle / broken_target diagnostics are produced in this mode.
+                $State.Skipped = [int]$State.Skipped + 1
+                continue
+            }
+
+            if ([string]::IsNullOrEmpty($resolved)) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target could not be resolved.'
+                continue
+            }
+
+            $targetExists = $false
+            $targetIsContainer = $false
+            try {
+                $targetExists = [bool](Test-Path -LiteralPath $resolved -ErrorAction Stop)
+                if ($targetExists) {
+                    $targetIsContainer = [bool](Test-Path -LiteralPath $resolved -PathType Container -ErrorAction Stop)
+                }
+            }
+            catch {
+                $targetExists = $false
+                $targetIsContainer = $false
+            }
+            if (-not $targetExists) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+            if (-not $targetIsContainer) {
+                # A link to a file only produces the link record itself.
+                continue
+            }
+            if (Test-WReparsePathInList -State $State -List $Ancestry -Path $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                    -Message 'The reparse target is an ancestor of the current branch.'
+                continue
+            }
+            if ($childDepth -ge $maxDepth) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'too_deep' `
+                    -Message "Depth limit of $maxDepth reached; not enumerating."
+                continue
+            }
+            Invoke-WReparseDirectoryWalk -RealDirectory $resolved -VirtualPrefix $relative `
+                -Depth $childDepth -Ancestry (@($Ancestry) + $resolved) -State $State
+            continue
+        }
+
+        $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) {
+                try { $size = [long]$length } catch { $size = [long]0 }
+            }
+        }
+
+        # InScope only carries meaning for reparse points; every other entry
+        # reports $false.
+        if ($isContainer) { $kind = $script:WReparseKindDirectory } else { $kind = $script:WReparseKindFile }
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+            -ReparseKind $null -Target $null -ResolvedTarget $null -InScope $false `
+            -Depth $childDepth -Size $size))
+
+        if (-not $isContainer) { continue }
+
+        if ($childDepth -ge $maxDepth) {
+            Add-WReparseError -State $State -RelativePath $relative -Code 'too_deep' `
+                -Message "Depth limit of $maxDepth reached; not enumerating."
+            continue
+        }
+
+        Invoke-WReparseDirectoryWalk -RealDirectory $childReal -VirtualPrefix $relative `
+            -Depth $childDepth -Ancestry (@($Ancestry) + $childReal) -State $State
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root,
+        [ValidateSet('Never', 'Always')][string]$FollowMode = 'Never',
+        [int]$MaxDepth = 32
+    )
+
+    # A negative limit behaves exactly like 0.
+    $effectiveMaxDepth = $MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $state = @{
+        Records  = (New-Object System.Collections.ArrayList)
+        Errors   = (New-Object System.Collections.ArrayList)
+        RealKeys = @{}
+        Skipped  = 0
+        Root     = [string]$Root
+        Follow   = ($FollowMode -eq 'Always')
+        MaxDepth = [int]$effectiveMaxDepth
+    }
+
+    $canonicalRoot = $null
+    try {
+        $canonicalRoot = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        $message = 'Scan root cannot be canonicalised.'
+        if ($null -ne $_.Exception -and -not [string]::IsNullOrEmpty($_.Exception.Message)) {
+            $message = $_.Exception.Message
+        }
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' -Message $message
+        return [pscustomobject]@{
+            Root    = [string]$Root
+            Records = @($state.Records.ToArray())
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+
+    $state.Root = $canonicalRoot
+    [void](Get-WReparseRealKey -State $state -Path $canonicalRoot)
+
+    $rootExists = $false
+    $rootIsContainer = $false
+    try {
+        $rootExists = [bool](Test-Path -LiteralPath $canonicalRoot -ErrorAction Stop)
+        if ($rootExists) {
+            $rootIsContainer = [bool](Test-Path -LiteralPath $canonicalRoot -PathType Container -ErrorAction Stop)
+        }
+    }
+    catch {
+        $rootExists = $false
+        $rootIsContainer = $false
+    }
+
+    if (-not $rootExists) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = @($state.Records.ToArray())
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+    if (-not $rootIsContainer) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = @($state.Records.ToArray())
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualPrefix '.' `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return [pscustomobject]@{
+        Root    = $canonicalRoot
+        Records = @($state.Records.ToArray())
+        Errors  = @($state.Errors.ToArray())
+        Skipped = [int]$state.Skipped
+    }
+}
