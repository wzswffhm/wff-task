+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse reference implementation.
+
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    try {
+        return $property.Value
+    }
+    catch {
+        return $null
+    }
+}
+
+# FILE_ATTRIBUTE_REPARSE_POINT (0x400) is the ONLY reliable marker for a
+# reparse point. A hard link carries a LinkType ('HardLink') but no reparse
+# attribute, so testing LinkType would misclassify it. The provider hands the
+# attributes back either as a System.IO.FileAttributes enum or as its string
+# form ('Directory, ReparsePoint'); both are reduced to the flag bits here.
+function Get-WReparseAttributeFlags {
+    [CmdletBinding()]
+    param($Item)
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return [long]0 }
+    if ($attributes -is [System.Enum]) { return [long]$attributes }
+    if ($attributes -is [System.ValueType]) { return [long]$attributes }
+    $text = ([string]$attributes).Trim()
+    if ($text.Length -eq 0) { return [long]0 }
+    try {
+        return [long][System.IO.FileAttributes]$text
+    }
+    catch {
+        $flags = [long]0
+        foreach ($part in $text.Split([char]',')) {
+            $name = $part.Trim()
+            if ($name.Length -eq 0) { continue }
+            try { $flags = $flags -bor [long][System.IO.FileAttributes]$name } catch { }
+        }
+        return $flags
+    }
+}
+
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)]$Item)
+    $marker = [long][System.IO.FileAttributes]::ReparsePoint
+    $flags = Get-WReparseAttributeFlags -Item $Item
+    return (($flags -band $marker) -eq $marker)
+}
+
+# Maps the provider link type to the contract vocabulary. Only entries whose
+# file attributes carry FILE_ATTRIBUTE_REPARSE_POINT reach this function, so a
+# hard link (which has a link type but no reparse attribute) is never mapped.
+# A junction and a symbolic link are DIFFERENT flavours and stay different.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([AllowNull()][string]$LinkType)
+    if ([string]::IsNullOrWhiteSpace($LinkType)) { return $script:WReparseReparseKindUnknown }
+    $text = $LinkType.Trim()
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($text, 'SymbolicLink')) {
+        return $script:WReparseReparseKindSymbolicLink
+    }
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($text, 'Junction')) {
+        return $script:WReparseReparseKindJunction
+    }
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($text, 'MountPoint')) {
+        return $script:WReparseReparseKindMountPoint
+    }
+    return $script:WReparseReparseKindUnknown
+}
+
+# The provider exposes .Target as a collection (System.String[] or a
+# List[string]) and PowerShell unrolls a single-element array when it is
+# forwarded out of a function, so the observed type is unstable. The contract
+# defines Target as ONE target string: normalise explicitly here.
+function Get-WReparseRawTarget {
+    [CmdletBinding()]
+    param($Item)
+    $value = Get-WReparseMemberValue -InputObject $Item -Name 'Target'
+    if ($null -eq $value) { return $null }
+    $all = @($value)
+    if ($all.Count -eq 0) { return $null }
+    $first = $all[0]
+    if ($null -eq $first) { return $null }
+    $text = [string]$first
+    if ($text.Length -eq 0) { return $null }
+    return $text
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+# Ancestor-chain membership, compared ordinally and case-insensitively so the
+# result never depends on the host culture.
+function Test-WReparseAncestorMatch {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path
+    )
+    foreach ($entry in @($Ancestry)) {
+        if ($null -eq $entry) { continue }
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([string]$entry, $Path)) { return $true }
+    }
+    return $false
+}
+
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][string]$VirtualDirectory,
+        [AllowEmptyString()][string]$RelativeDirectory = '',
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+
+    # A directory whose own Depth has reached -MaxDepth is registered with a
+    # single 'too_deep' error and its children are not enumerated (contract 4.3).
+    if ($Depth -ge $State.MaxDepth) {
+        Add-WReparseError -State $State `
+            -RelativePath (Get-WReparseDisplayRelative -RelativeDirectory $RelativeDirectory) `
+            -Code 'too_deep' `
+            -Message "Depth limit of $($State.MaxDepth) reached at '$VirtualDirectory'; children not enumerated."
+        return
+    }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch {
+        # Failure isolation: one unreadable directory must not abort the scan.
+        Add-WReparseError -State $State `
+            -RelativePath (Get-WReparseDisplayRelative -RelativeDirectory $RelativeDirectory) `
+            -Code 'access_denied' `
+            -Message "Enumeration of '$VirtualDirectory' failed: $($_.Exception.Message)"
+        return
+    }
+
+    foreach ($child in $children) {
+        $childDepth = $Depth + 1
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        if ([string]::IsNullOrEmpty($realChild)) { continue }
+
+        $leaf = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        if ([string]::IsNullOrEmpty($leaf)) { $leaf = [string](Split-Path -Leaf $realChild) }
+        if ([string]::IsNullOrEmpty($leaf)) { continue }
+
+        $virtualChild = Join-Path -Path $VirtualDirectory -ChildPath $leaf
+        if ([string]::IsNullOrEmpty($RelativeDirectory)) {
+            $relativeChild = $leaf
+        }
+        else {
+            $relativeChild = $RelativeDirectory + '\' + $leaf
+        }
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = Get-WReparseRawTarget -Item $child
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+
+            $inScope = $false
+            if ($null -ne $resolved) {
+                $inScope = [bool](Test-WReparseWithinRoot -Path $resolved -Root $State.Root)
+            }
+
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relativeChild `
+                    -Kind $script:WReparseKindReparse `
+                    -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                    -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                    -Depth $childDepth -Size 0))
+
+            if (-not $State.Follow) {
+                # Default mode: register the entry, never enter the target, and
+                # never emit 'cycle' / 'broken_target' (contract 4.1 and 7).
+                $State.Skipped = $State.Skipped + 1
+                continue
+            }
+
+            if ($null -eq $resolved) {
+                Add-WReparseError -State $State -RelativePath $relativeChild -Code 'broken_target' `
+                    -Message "The reparse target of '$relativeChild' could not be resolved."
+                continue
+            }
+
+            $targetExists = $false
+            try { $targetExists = [bool](Test-Path -LiteralPath $resolved) } catch { $targetExists = $false }
+            if (-not $targetExists) {
+                Add-WReparseError -State $State -RelativePath $relativeChild -Code 'broken_target' `
+                    -Message "The reparse target '$resolved' of '$relativeChild' does not exist."
+                continue
+            }
+
+            if (Test-WReparseAncestorMatch -Ancestry $Ancestry -Path $resolved) {
+                Add-WReparseError -State $State -RelativePath $relativeChild -Code 'cycle' `
+                    -Message "The reparse target '$resolved' of '$relativeChild' is an ancestor of this branch."
+                continue
+            }
+
+            $targetIsContainer = $false
+            try { $targetIsContainer = [bool](Test-Path -LiteralPath $resolved -PathType Container) } catch { $targetIsContainer = $false }
+            if ($targetIsContainer) {
+                # Enter the target, but keep naming the entries after the LINK
+                # path ('link-in\readme.txt'), never after the real target.
+                $null = Invoke-WReparseDirectoryWalk -RealDirectory $resolved `
+                    -VirtualDirectory $virtualChild -RelativeDirectory $relativeChild `
+                    -Depth $childDepth -Ancestry (@($Ancestry) + $resolved) -State $State
+            }
+            # A link whose target is a file yields the link record only.
+            continue
+        }
+
+        $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) {
+                try { $size = [long]$length } catch { $size = [long]0 }
+            }
+        }
+
+        if ($isContainer) { $kind = $script:WReparseKindDirectory } else { $kind = $script:WReparseKindFile }
+
+        # InScope only carries meaning for reparse points; every other entry
+        # reports $false (contract 3.1).
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relativeChild -Kind $kind `
+                -InScope $false -Depth $childDepth -Size $size))
+
+        if ($isContainer) {
+            $realChildCanonical = $realChild
+            try { $realChildCanonical = Get-WReparseCanonicalPath -Path $realChild } catch { $realChildCanonical = $realChild }
+            $null = Invoke-WReparseDirectoryWalk -RealDirectory $realChildCanonical `
+                -VirtualDirectory $virtualChild -RelativeDirectory $relativeChild `
+                -Depth $childDepth -Ancestry (@($Ancestry) + $realChildCanonical) -State $State
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [ValidateSet('Never', 'Always')][string]$FollowMode = 'Never',
+        [int]$MaxDepth = 32
+    )
+    if ($MaxDepth -lt 0) { $MaxDepth = 0 }
+
+    $state = @{
+        Records  = New-Object System.Collections.ArrayList
+        Errors   = New-Object System.Collections.ArrayList
+        Skipped  = 0
+        Root     = $null
+        Follow   = ($FollowMode -eq 'Always')
+        MaxDepth = $MaxDepth
+    }
+
+    $canonicalRoot = $null
+    try {
+        $canonicalRoot = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message "Scan root cannot be canonicalised: '$Root'. $($_.Exception.Message)"
+        return [pscustomobject][ordered]@{
+            Root    = [string]$Root
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+    if ([string]::IsNullOrWhiteSpace($canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message "Scan root cannot be canonicalised: '$Root'."
+        return [pscustomobject][ordered]@{
+            Root    = [string]$Root
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+
+    $rootExists = $false
+    $rootIsContainer = $false
+    try {
+        $rootExists = [bool](Test-Path -LiteralPath $canonicalRoot)
+        if ($rootExists) {
+            $rootIsContainer = [bool](Test-Path -LiteralPath $canonicalRoot -PathType Container)
+        }
+    }
+    catch {
+        $rootExists = $false
+        $rootIsContainer = $false
+    }
+
+    if (-not $rootExists) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return [pscustomobject][ordered]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+    if (-not $rootIsContainer) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return [pscustomobject][ordered]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+
+    $state.Root = $canonicalRoot
+    $null = Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualDirectory $canonicalRoot `
+        -RelativeDirectory '' -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return [pscustomobject][ordered]@{
+        Root    = $canonicalRoot
+        Records = @($state.Records.ToArray())
+        Errors  = @($state.Errors.ToArray())
+        Skipped = $state.Skipped
+    }
+}
