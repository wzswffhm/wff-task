diff --git a/_scratch/verify.ps1 b/_scratch/verify.ps1
new file mode 100644
index 0000000..bc5cdb7
--- /dev/null
+++ b/_scratch/verify.ps1
@@ -0,0 +1,236 @@
+$ErrorActionPreference = 'Stop'
+
+$workspace = Split-Path -Parent $PSScriptRoot
+$modulePath = Join-Path (Join-Path $workspace 'WReparse') 'WReparse.psd1'
+Import-Module $modulePath -Force
+
+$script:Pass = 0
+$script:Fail = 0
+function Check {
+    param([string]$Name, [bool]$Ok, [string]$Detail)
+    if ($Ok) { $script:Pass++; Write-Host "[PASS] $Name" }
+    else { $script:Fail++; Write-Host "[FAIL] $Name :: $Detail" }
+}
+function Canon([string]$p) { return (Get-WReparseCanonicalPath -Path $p) }
+
+# ---------------------------------------------------------------- fixture ---
+$base = Join-Path $env:TEMP ('wrep-verify-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
+$root = Join-Path $base 'scanroot'
+$sibling = Join-Path $base 'scanroot2'
+foreach ($d in @($root, $sibling, (Join-Path $root 'docs'), (Join-Path $root 'empty'),
+        (Join-Path $root 'sub\deeper'), (Join-Path $root 'Zebra'),
+        (Join-Path $root ([char]0x00C4 + 'ra')), (Join-Path $root ([char]0x00F6 + 'ko')))) {
+    New-Item -ItemType Directory -Path $d -Force | Out-Null
+}
+Set-Content -LiteralPath (Join-Path $root 'plain.txt') -Value 'hello' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root 'docs\readme.txt') -Value 'doc' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root 'sub\note.txt') -Value 'n' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root 'sub\deeper\deep.txt') -Value 'd' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root 'Zebra\z.txt') -Value 'z' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root ([char]0x00C4 + 'ra\a.txt')) -Value 'a' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root ([char]0x00F6 + 'ko\o.txt')) -Value 'o' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $sibling 'outside.txt') -Value 'out' -NoNewline -Encoding ASCII
+New-Item -ItemType HardLink -Path (Join-Path $root 'hardlink.txt') -Target (Join-Path $root 'plain.txt') | Out-Null
+New-Item -ItemType Junction -Path (Join-Path $root 'junction-docs') -Target (Join-Path $root 'docs') | Out-Null
+
+Push-Location -LiteralPath $root
+try {
+    & cmd.exe /c mklink /D 'link-in' 'docs' | Out-Null
+    & cmd.exe /c mklink 'link-file' 'plain.txt' | Out-Null
+    & cmd.exe /c mklink 'dangling' 'nope.txt' | Out-Null
+    & cmd.exe /c mklink /D 'twin-a' 'docs' | Out-Null
+    & cmd.exe /c mklink /D 'twin-b' 'docs' | Out-Null
+    & cmd.exe /c mklink /D 'link-sib' '..\scanroot2' | Out-Null
+}
+finally { Pop-Location }
+New-Item -ItemType SymbolicLink -Path (Join-Path $root 'link-out') -Target (Join-Path $sibling 'outside.txt') | Out-Null
+New-Item -ItemType SymbolicLink -Path (Join-Path $root 'loop') -Target $root | Out-Null
+New-Item -ItemType SymbolicLink -Path (Join-Path $sibling 'back-link') -Target (Join-Path $root 'docs') | Out-Null
+
+$emptyTree = Join-Path $base 'emptytree'
+New-Item -ItemType Directory -Path $emptyTree -Force | Out-Null
+
+$cRoot = Canon $root
+
+$before = @(Get-ChildItem -LiteralPath $base -Recurse -Force | ForEach-Object { "$($_.FullName)|$($_.LastWriteTimeUtc.Ticks)|$($_.Length)" }) -join "`n"
+
+# ------------------------------------------------------------------ checks ---
+$report = Get-WReparseReport -Root $root
+$json1 = ConvertTo-WReparseJson -Report $report
+$json2 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root)
+
+Check '1 schema version' ($report.SchemaVersion -eq 'wreparse/1.0') "got [$($report.SchemaVersion)]"
+Check '1 root canonical' ($report.Root -ceq $cRoot) "got [$($report.Root)] want [$cRoot]"
+Check '13 report fields exactly 5' ((@($report.PSObject.Properties.Name) -join ',') -eq 'SchemaVersion,Root,Records,Errors,Stats') (@($report.PSObject.Properties.Name) -join ',')
+Check '2 records is array' ($report.Records -is [System.Array]) 'not array'
+Check '2 errors is array' ($report.Errors -is [System.Array]) 'not array'
+
+$posSchema = $json1.IndexOf('"SchemaVersion"')
+$posRoot = $json1.IndexOf('"Root"')
+$posRecords = $json1.IndexOf('"Records"')
+$posErrors = $json1.IndexOf('"Errors"')
+$posStats = $json1.IndexOf('"Stats"')
+Check '8 json key order' (($posSchema -lt $posRoot) -and ($posRoot -lt $posRecords) -and ($posRecords -lt $posErrors) -and ($posErrors -lt $posStats)) "$posSchema,$posRoot,$posRecords,$posErrors,$posStats"
+Check '8 json has no timestamp' ($json1 -notmatch 'GeneratedAt') 'timestamp present'
+
+$byName = @{}
+foreach ($r in $report.Records) { $byName[$r.RelativePath] = $r }
+
+$reparseRecords = @($report.Records | Where-Object { $_.Kind -eq 'ReparsePoint' })
+Check '3 reparse count is 9' ($reparseRecords.Count -eq 9) "got $($reparseRecords.Count): $(($reparseRecords | ForEach-Object { $_.RelativePath }) -join ', ')"
+Check '5 hardlink is File' ($byName['hardlink.txt'].Kind -eq 'File') "got [$($byName['hardlink.txt'].Kind)]"
+Check '5 plain.txt is File' ($byName['plain.txt'].Kind -eq 'File') "got [$($byName['plain.txt'].Kind)]"
+Check '5 docs is Directory' ($byName['docs'].Kind -eq 'Directory') "got [$($byName['docs'].Kind)]"
+Check '5 junction ReparseKind' ($byName['junction-docs'].ReparseKind -eq 'Junction') "got [$($byName['junction-docs'].ReparseKind)]"
+Check '5 symlink ReparseKind' ($byName['link-in'].ReparseKind -eq 'SymbolicLink') "got [$($byName['link-in'].ReparseKind)]"
+Check '5 junction != symlink' ($byName['junction-docs'].ReparseKind -ne $byName['link-in'].ReparseKind) 'same kind'
+Check '17 target is string' ((@($reparseRecords | Where-Object { $_.Target -isnot [string] })).Count -eq 0) ((@($reparseRecords | Where-Object { $_.Target -isnot [string] }) | ForEach-Object { $_.RelativePath }) -join ',')
+Check '17 resolvedtarget is string' ((@($reparseRecords | Where-Object { ($null -ne $_.ResolvedTarget) -and ($_.ResolvedTarget -isnot [string]) })).Count -eq 0) 'not string'
+Check '17 relative raw target kept verbatim' ($byName['link-in'].Target -eq 'docs') "got [$($byName['link-in'].Target)]"
+
+Check '1 skipped equals reparse points' ($report.Stats.Skipped -eq $reparseRecords.Count) "skipped=$($report.Stats.Skipped) reparse=$($reparseRecords.Count)"
+Check '1 no followed entries' ($null -eq $byName['link-in\readme.txt']) 'link-in was followed'
+Check '4 depth of direct child' ($byName['plain.txt'].Depth -eq 1) "got $($byName['plain.txt'].Depth)"
+Check '4 depth of deep child' ($byName['sub\deeper\deep.txt'].Depth -eq 3) "got $($byName['sub\deeper\deep.txt'].Depth)"
+Check '15 no cycle without follow' (@($report.Errors | Where-Object { $_.Code -eq 'cycle' }).Count -eq 0) 'cycle emitted'
+Check '15 no broken_target without follow' (@($report.Errors | Where-Object { $_.Code -eq 'broken_target' }).Count -eq 0) 'broken_target emitted'
+Check '15 no errors at all without follow' (@($report.Errors).Count -eq 0) ((@($report.Errors | ForEach-Object { "$($_.RelativePath):$($_.Code)" })) -join ',')
+
+Check '4 deterministic json' ($json1 -ceq $json2) 'serialisations differ'
+$order = @($report.Records | ForEach-Object { $_.RelativePath })
+$idxZ = [Array]::IndexOf($order, 'Zebra\z.txt')
+$idxA = -1
+$idxO = -1
+for ($i = 0; $i -lt $order.Count; $i++) {
+    if ($order[$i].StartsWith([string][char]0x00C4)) { $idxA = $i }
+    if ($order[$i].StartsWith([string][char]0x00F6)) { $idxO = $i }
+}
+Check '14 ordinal sort ascii before non-ascii' (($idxZ -lt $idxA) -and ($idxA -lt $idxO)) "z=$idxZ a=$idxA o=$idxO"
+Check '6 record key order' ((@($report.Records[0].PSObject.Properties.Name) -join ',') -eq 'RelativePath,Kind,ReparseKind,Target,ResolvedTarget,InScope,Depth,Size') (@($report.Records[0].PSObject.Properties.Name) -join ',')
+$nfReport = Get-WReparseReport -Root (Join-Path $base 'nope')
+Check '6 error key order' ((@($nfReport.Errors[0].PSObject.Properties.Name) -join ',') -eq 'RelativePath,Code,Message') (@($nfReport.Errors[0].PSObject.Properties.Name) -join ',')
+Check '6 stats key order' ((@($report.Stats.PSObject.Properties.Name) -join ',') -eq 'Directories,Files,ReparsePoints,Skipped,Errors') (@($report.Stats.PSObject.Properties.Name) -join ',')
+
+Check '7 stats mutually exclusive' (($report.Stats.Directories + $report.Stats.Files + $report.Stats.ReparsePoints) -eq $report.Records.Count) "D=$($report.Stats.Directories) F=$($report.Stats.Files) R=$($report.Stats.ReparsePoints) N=$($report.Records.Count)"
+Check '7 stats directories' ($report.Stats.Directories -eq @($report.Records | Where-Object { $_.Kind -eq 'Directory' }).Count) 'mismatch'
+Check '7 stats files' ($report.Stats.Files -eq @($report.Records | Where-Object { $_.Kind -eq 'File' }).Count) 'mismatch'
+Check '7 stats reparse' ($report.Stats.ReparsePoints -eq $reparseRecords.Count) 'mismatch'
+Check '7 stats errors' ($report.Stats.Errors -eq $report.Errors.Count) "s=$($report.Stats.Errors) n=$($report.Errors.Count)"
+
+Check '6 not_found' ((@($nfReport.Errors).Count -eq 1) -and ($nfReport.Errors[0].Code -eq 'not_found') -and ($nfReport.Errors[0].RelativePath -eq '.')) ((@($nfReport.Errors | ForEach-Object { "$($_.RelativePath):$($_.Code)" })) -join ',')
+Check '6 not_found empty records' ($nfReport.Records.Count -eq 0) 'records present'
+$fileRoot = Get-WReparseReport -Root (Join-Path $root 'plain.txt')
+Check '6 structure' ((@($fileRoot.Errors).Count -eq 1) -and ($fileRoot.Errors[0].Code -eq 'structure')) ((@($fileRoot.Errors | ForEach-Object { $_.Code })) -join ',')
+$badRoot = Get-WReparseReport -Root 'C:\bad<>|path'
+Check '6 invalid_argument' ((@($badRoot.Errors).Count -eq 1) -and ($badRoot.Errors[0].Code -eq 'invalid_argument')) ((@($badRoot.Errors | ForEach-Object { $_.Code })) -join ',')
+Check '6 invalid_argument shape' (($badRoot.Records.Count -eq 0) -and ($badRoot.Errors[0].RelativePath -eq '.')) 'shape'
+
+$d0 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -MaxDepth 0)
+$dn = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -MaxDepth -7)
+Check '7 maxdepth 0 == negative' ($d0 -ceq $dn) 'differ'
+$d0r = Get-WReparseReport -Root $root -MaxDepth 0
+Check '7 maxdepth 0 reports too_deep at root' ((@($d0r.Errors).Count -eq 1) -and ($d0r.Errors[0].Code -eq 'too_deep') -and ($d0r.Errors[0].RelativePath -eq '.')) ((@($d0r.Errors | ForEach-Object { "$($_.RelativePath):$($_.Code)" })) -join ',')
+Check '7 maxdepth 0 has no records' ($d0r.Records.Count -eq 0) "records=$($d0r.Records.Count)"
+$d1 = Get-WReparseReport -Root $root -MaxDepth 1
+Check '7 maxdepth 1 no deeper records' (@($d1.Records | Where-Object { $_.Depth -gt 1 }).Count -eq 0) 'deeper records present'
+Check '7 maxdepth 1 too_deep per depth1 directory' (@($d1.Errors | Where-Object { $_.Code -eq 'too_deep' }).Count -eq @($d1.Records | Where-Object { $_.Kind -eq 'Directory' }).Count) "errors=$(@($d1.Errors | Where-Object { $_.Code -eq 'too_deep' }).Count) dirs=$(@($d1.Records | Where-Object { $_.Kind -eq 'Directory' }).Count)"
+$d2 = Get-WReparseReport -Root $root -MaxDepth 2
+Check '7 maxdepth 2 depth bound' (@($d2.Records | Where-Object { $_.Depth -gt 2 }).Count -eq 0) 'deeper records present'
+Check '7 maxdepth 2 too_deep on sub deeper' (@($d2.Errors | Where-Object { $_.RelativePath -eq 'sub\deeper' }).Count -eq 1) ((@($d2.Errors | ForEach-Object { $_.RelativePath })) -join ',')
+
+$follow = Get-WReparseReport -Root $root -Follow
+$followJson1 = ConvertTo-WReparseJson -Report $follow
+$followJson2 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -Follow)
+Check '4 follow deterministic' ($followJson1 -ceq $followJson2) 'differ'
+$fmap = @{}
+foreach ($r in $follow.Records) { $fmap[$r.RelativePath] = $r }
+Check '8 follow prefixes with link path' ($null -ne $fmap['link-in\readme.txt']) ((@($follow.Records | ForEach-Object { $_.RelativePath } | Where-Object { $_ -like 'link-in*' })) -join ',')
+Check '8 follow junction prefixed too' ($null -ne $fmap['junction-docs\readme.txt']) 'missing'
+Check '9 follow file link has no children' (($null -eq $fmap['link-file\plain.txt']) -and ($fmap['link-file'].Kind -eq 'ReparsePoint')) 'child produced'
+$twinErr = @($follow.Errors | Where-Object { ($_.Code -eq 'cycle') -and ($_.RelativePath -like 'twin-*') })
+Check '10 sibling twins not a cycle' ($twinErr.Count -eq 0) ((@($twinErr | ForEach-Object { $_.RelativePath })) -join ',')
+Check '10 both twins entered' (($null -ne $fmap['twin-a\readme.txt']) -and ($null -ne $fmap['twin-b\readme.txt'])) 'missing twin children'
+Check '10 followed child size' ($fmap['link-in\readme.txt'].Size -eq 3) "size=$($fmap['link-in\readme.txt'].Size)"
+Check '8 follow reports cycle for loop' (@($follow.Errors | Where-Object { ($_.Code -eq 'cycle') -and ($_.RelativePath -eq 'loop') }).Count -eq 1) ((@($follow.Errors | ForEach-Object { "$($_.RelativePath):$($_.Code)" })) -join ',')
+Check '8 follow reports broken_target' (@($follow.Errors | Where-Object { ($_.Code -eq 'broken_target') -and ($_.RelativePath -eq 'dangling') }).Count -eq 1) ((@($follow.Errors | ForEach-Object { "$($_.RelativePath):$($_.Code)" })) -join ',')
+Check '4 follow skipped is zero' ($follow.Stats.Skipped -eq 0) "skipped=$($follow.Stats.Skipped)"
+Check '7 follow stats exclusive' (($follow.Stats.Directories + $follow.Stats.Files + $follow.Stats.ReparsePoints) -eq $follow.Records.Count) "D=$($follow.Stats.Directories) F=$($follow.Stats.Files) R=$($follow.Stats.ReparsePoints) N=$($follow.Records.Count)"
+Check '8 follow errors sorted' ((@($follow.Errors | ForEach-Object { $_.RelativePath }) -join ',') -eq ((@(@($follow.Errors | ForEach-Object { $_.RelativePath }) | Sort-Object -Culture '') ) -join ',')) ((@($follow.Errors | ForEach-Object { $_.RelativePath })) -join ',')
+
+$emptyReport = Get-WReparseReport -Root $emptyTree
+$emptyJson = ConvertTo-WReparseJson -Report $emptyReport
+Check '11 empty tree records []' ($emptyJson -match '"Records":\s*\[\s*\]') $emptyJson
+Check '11 empty tree errors []' ($emptyJson -match '"Errors":\s*\[\s*\]') $emptyJson
+Check '11 empty tree counts zero' (($emptyReport.Records.Count -eq 0) -and ($emptyReport.Errors.Count -eq 0)) 'not empty'
+
+$names = @(@(Get-Command -Module WReparse) | ForEach-Object { $_.Name } | Sort-Object)
+$want = @('ConvertTo-WReparseJson', 'Get-WReparseCanonicalPath', 'Get-WReparseReport', 'Get-WReparseSchemaVersion', 'Resolve-WReparseLinkTarget', 'Test-WReparseWithinRoot')
+Check '12 exactly six exported' (($names -join ',') -eq ($want -join ',')) ($names -join ',')
+
+Check '16 inscope false for plain file' ($byName['plain.txt'].InScope -eq $false) 'true'
+Check '16 inscope false for directory' ($byName['docs'].InScope -eq $false) 'true'
+Check '16 inscope false for hardlink' ($byName['hardlink.txt'].InScope -eq $false) 'true'
+Check '2 inscope true for in-root link' ($byName['link-in'].InScope -eq $true) 'false'
+Check '2 inscope false for outside link' ($byName['link-out'].InScope -eq $false) 'true'
+Check '2 inscope false for prefix sibling link' ($byName['link-sib'].InScope -eq $false) 'true'
+Check '2 nulls serialise as null' ($json1 -match '"Target":\s*null') 'no null target'
+Check '3 non reparse have null reparse fields' (($byName['plain.txt'].ReparseKind -eq $null) -and ($byName['plain.txt'].Target -eq $null) -and ($byName['plain.txt'].ResolvedTarget -eq $null)) 'not null'
+Check '3 size for file' ($byName['plain.txt'].Size -eq 5) "got $($byName['plain.txt'].Size)"
+Check '3 size zero for reparse' ($byName['link-in'].Size -eq 0) "got $($byName['link-in'].Size)"
+Check '3 size zero for directory' ($byName['docs'].Size -eq 0) "got $($byName['docs'].Size)"
+
+Check '5 canonical preserves case' ((Get-WReparseCanonicalPath -Path 'C:\Some\MixedCase\Dir') -ceq 'C:\Some\MixedCase\Dir') (Get-WReparseCanonicalPath -Path 'C:\Some\MixedCase\Dir')
+Check '5 canonical collapses dots' ((Get-WReparseCanonicalPath -Path 'C:\Foo\Bar\..\Baz\.') -ceq 'C:\Foo\Baz') (Get-WReparseCanonicalPath -Path 'C:\Foo\Bar\..\Baz\.')
+Check '5 canonical volume root' ((Get-WReparseCanonicalPath -Path 'C:\') -ceq 'C:\') (Get-WReparseCanonicalPath -Path 'C:\')
+Check '5 canonical unc share root' ((Get-WReparseCanonicalPath -Path '\\srv\share\') -ceq '\\srv\share') (Get-WReparseCanonicalPath -Path '\\srv\share\')
+Check '5 canonical strips trailing sep' ((Get-WReparseCanonicalPath -Path 'C:\Foo\Bar\') -ceq 'C:\Foo\Bar') (Get-WReparseCanonicalPath -Path 'C:\Foo\Bar\')
+Check '5 canonical forward slashes' ((Get-WReparseCanonicalPath -Path 'C:\Foo/Bar') -ceq 'C:\Foo\Bar') (Get-WReparseCanonicalPath -Path 'C:\Foo/Bar')
+Check '5 canonical root idempotent' ((Canon (Canon 'C:\Foo\Bar\Baz\..')) -ceq 'C:\Foo\Bar') (Canon (Canon 'C:\Foo\Bar\Baz\..'))
+Check '5 within root boundary' (-not (Test-WReparseWithinRoot -Path 'C:\root2\x' -Root 'C:\root')) 'prefix sibling considered inside'
+Check '5 within root boundary exact' (-not (Test-WReparseWithinRoot -Path 'C:\root2' -Root 'C:\root')) 'prefix sibling considered inside'
+Check '5 within root self' (Test-WReparseWithinRoot -Path 'C:\root' -Root 'C:\root') 'root not inside itself'
+Check '5 within root child' (Test-WReparseWithinRoot -Path 'C:\root\a\b' -Root 'C:\root') 'child not inside'
+Check '5 within root case insensitive' (Test-WReparseWithinRoot -Path 'C:\ROOT\A' -Root 'c:\root') 'case sensitive'
+Check '5 within root volume' (Test-WReparseWithinRoot -Path 'C:\a\b' -Root 'C:\') 'volume root'
+Check '5 within root parent is outside' (-not (Test-WReparseWithinRoot -Path 'C:\' -Root 'C:\root')) 'parent considered inside'
+
+Check '5 resolve relative to link dir' ((Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'link-in') -RawTarget 'docs') -ceq (Canon (Join-Path $root 'docs'))) (Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'link-in') -RawTarget 'docs')
+Push-Location -LiteralPath 'C:\Windows'
+try {
+    $rel2 = Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'link-in') -RawTarget 'docs'
+    Check '5 resolve independent of cwd' ($rel2 -ceq (Canon (Join-Path $root 'docs'))) "got [$rel2]"
+}
+finally { Pop-Location }
+Check '5 resolve absolute kept' ((Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'x') -RawTarget 'C:\A\b') -ceq 'C:\A\b') (Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'x') -RawTarget 'C:\A\b')
+Check '5 resolve empty is null' ($null -eq (Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'x') -RawTarget '')) 'not null'
+Check '5 resolve null is null' ($null -eq (Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'x') -RawTarget $null)) 'not null'
+Check '5 resolve parent relative' ((Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'sub\l') -RawTarget '..\docs') -ceq (Canon (Join-Path $root 'docs'))) (Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'sub\l') -RawTarget '..\docs')
+Check '5 resolve nested relative' ((Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'l') -RawTarget 'sub\deeper') -ceq (Canon (Join-Path $root 'sub\deeper'))) (Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'l') -RawTarget 'sub\deeper')
+
+$sibReport = Get-WReparseReport -Root $sibling
+$sibMap = @{}
+foreach ($r in $sibReport.Records) { $sibMap[$r.RelativePath] = $r }
+Check '2 link out of root not in scope' ($sibMap['back-link'].InScope -eq $false) 'true'
+Check '2 link out of root resolved' ($sibMap['back-link'].ResolvedTarget -ceq (Canon (Join-Path $root 'docs'))) "got [$($sibMap['back-link'].ResolvedTarget)]"
+
+$after = @(Get-ChildItem -LiteralPath $base -Recurse -Force | ForEach-Object { "$($_.FullName)|$($_.LastWriteTimeUtc.Ticks)|$($_.Length)" }) -join "`n"
+Check '9 scan is read only' ($before -ceq $after) 'tree changed'
+
+Write-Host ''
+Write-Host 'records:'
+foreach ($r in $report.Records) {
+    '  {0,-28} {1,-13} {2,-13} depth={3} size={4} inscope={5} target=[{6}] resolved=[{7}]' -f $r.RelativePath, $r.Kind, [string]$r.ReparseKind, $r.Depth, $r.Size, $r.InScope, [string]$r.Target, [string]$r.ResolvedTarget
+}
+Write-Host 'follow records:'
+foreach ($r in $follow.Records) { '  {0,-34} {1,-13} depth={2}' -f $r.RelativePath, $r.Kind, $r.Depth }
+Write-Host 'follow errors:'
+foreach ($e in $follow.Errors) { '  {0,-28} {1}' -f $e.RelativePath, $e.Code }
+Write-Host ''
+Write-Host 'json head:'
+Write-Host (($json1 -split "`n" | Select-Object -First 24) -join "`n")
+Write-Host ''
+Write-Host "PASS=$($script:Pass) FAIL=$($script:Fail)"
+
+Remove-Item -LiteralPath $base -Recurse -Force -ErrorAction SilentlyContinue
+if ($script:Fail -gt 0) { exit 1 }
+exit 0
