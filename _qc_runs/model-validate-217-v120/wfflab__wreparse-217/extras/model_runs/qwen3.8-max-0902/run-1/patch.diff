+$ErrorActionPreference = 'Stop'
+$d = Join-Path $env:TEMP ('wrep-probe-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
+New-Item -ItemType Directory -Path (Join-Path $d 'docs') -Force | Out-Null
+Set-Content -LiteralPath (Join-Path $d 'plain.txt') -Value 'hello' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $d 'docs\readme.txt') -Value 'r' -NoNewline -Encoding ASCII
+Push-Location -LiteralPath $d
+try {
+    New-Item -ItemType SymbolicLink -Path 'symlink-file' -Target 'plain.txt' | Out-Null
+    New-Item -ItemType SymbolicLink -Path 'symlink-dir' -Target 'docs' | Out-Null
+    & cmd.exe /c mklink "dangling" "nope.txt" | Out-Null
+}
+finally { Pop-Location }
+New-Item -ItemType SymbolicLink -Path (Join-Path $d 'loop') -Target $d | Out-Null
+New-Item -ItemType Junction -Path (Join-Path $d 'junction') -Target (Join-Path $d 'docs') | Out-Null
+New-Item -ItemType HardLink -Path (Join-Path $d 'hardlink.txt') -Target (Join-Path $d 'plain.txt') | Out-Null
+
+Get-ChildItem -LiteralPath $d -Force | ForEach-Object {
+    $t = $_.Target
+    '{0,-14} | LinkType={1,-12} | Attrs={2,-30} | TargetType={3,-18} | Target=[{4}] | Container={5}' -f `
+        $_.Name, [string]$_.LinkType, [string]$_.Attributes, $(if ($null -eq $t) { 'null' } else { $t.GetType().Name }), ($t -join ' ; '), $_.PSIsContainer
+}
+Remove-Item -LiteralPath $d -Recurse -Force
