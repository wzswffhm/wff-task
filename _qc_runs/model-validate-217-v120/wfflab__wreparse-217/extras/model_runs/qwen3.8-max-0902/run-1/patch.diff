+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation. See the contract under docs/
+
+# Canonical form used for every comparison and for the report:
+#   * full (rooted) path with '.' and '..' collapsed
+#   * no trailing directory separator, except for a volume root ('C:\')
+#     or a UNC share root ('\\server\share'), which keep their shape
+#   * original casing preserved verbatim
+function Get-WReparseCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path
+    )
+
+    # GetFullPath expands to an absolute path and collapses '.' and '..'.
+    # It throws for strings that are not of a legal form; callers turn that
+    # into an 'invalid_argument' error. Casing is left untouched.
+    $full = [System.IO.Path]::GetFullPath($Path)
+    $trimmed = $full.TrimEnd([char]'\', [char]'/')
+
+    $root = [System.IO.Path]::GetPathRoot($full)
+    if (-not [string]::IsNullOrEmpty($root)) {
+        $rootTrimmed = $root.TrimEnd([char]'\', [char]'/')
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals($trimmed, $rootTrimmed)) {
+            # The path IS a root: a volume root keeps its trailing separator
+            # ('C:\'), a UNC share root keeps '\\server\share'.
+            if ($root.StartsWith('\\', [System.StringComparison]::Ordinal)) {
+                $trimmed = $rootTrimmed
+            }
+            else {
+                $trimmed = $root
+            }
+        }
+    }
+
+    if ([string]::IsNullOrEmpty($trimmed)) { $trimmed = $full }
+    return $trimmed
+}
+
+# Directory-boundary aware containment. 'C:\root2' is NOT inside 'C:\root'
+# even though 'C:\root2'.StartsWith('C:\root') is true. Windows path
+# comparison is case-insensitive, so the ordinal-ignore-case comparer is used.
+function Test-WReparseWithinRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root
+    )
+    if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) {
+        return $false
+    }
+
+    $p = $null
+    $r = $null
+    try {
+        $p = Get-WReparseCanonicalPath -Path $Path
+        $r = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        return $false
+    }
+    if ([string]::IsNullOrEmpty($p) -or [string]::IsNullOrEmpty($r)) { return $false }
+
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return $true }
+
+    # Compare on a directory boundary: the candidate must start with
+    # '<root>\' so that 'C:\root2' never matches 'C:\root'.
+    $prefix = $r
+    if (-not $prefix.EndsWith('\', [System.StringComparison]::Ordinal)) { $prefix = $prefix + '\' }
+    return $p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
+}
+
+# Relative path of a scanned entry with respect to the scan root, using the
+# Windows separator. The root itself yields '.'.
+function Get-WReparseRelativePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$FullPath,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root
+    )
+    $p = $FullPath
+    $r = $Root
+    try {
+        $p = Get-WReparseCanonicalPath -Path $FullPath
+        $r = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        # Fall back to the raw strings; the prefix test below still works for
+        # paths that were built from an already canonical root.
+    }
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return '.' }
+    $prefix = $r
+    if (-not $prefix.EndsWith('\', [System.StringComparison]::Ordinal)) { $prefix = $prefix + '\' }
+    if ($p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $p.Substring($prefix.Length)
+    }
+    return $p
+}
+
+# The relative-path cell of a report row. The scan root itself is reported as
+# '.' (contract 3.2); everything else keeps the '\' separated relative form.
+function Get-WReparseDisplayRelative {
+    [CmdletBinding()]
+    param([AllowNull()][string]$RelativeDirectory)
+    if ([string]::IsNullOrEmpty($RelativeDirectory)) { return '.' }
+    return $RelativeDirectory
+}
+
+# The reparse target stored on disk may be relative. A relative target is
+# resolved against the directory that CONTAINS the link, never against the
+# process working directory and never against the scan root.
+function Resolve-WReparseLinkTarget {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$LinkFullPath,
+        [AllowNull()][string]$RawTarget
+    )
+    if ([string]::IsNullOrWhiteSpace($RawTarget)) { return $null }
+
+    try {
+        $target = $RawTarget.Trim()
+        # Defensive: strip NT namespace prefixes a provider may surface.
+        if ($target.StartsWith('\??\', [System.StringComparison]::Ordinal)) {
+            $target = $target.Substring(4)
+        }
+        elseif ($target.StartsWith('\\?\UNC\', [System.StringComparison]::Ordinal)) {
+            $target = '\\' + $target.Substring(8)
+        }
+        elseif ($target.StartsWith('\\?\', [System.StringComparison]::Ordinal)) {
+            $target = $target.Substring(4)
+        }
+        if ([string]::IsNullOrWhiteSpace($target)) { return $null }
+
+        $linkDirectory = $null
+        try {
+            $linkDirectory = [System.IO.Path]::GetDirectoryName((Get-WReparseCanonicalPath -Path $LinkFullPath))
+        }
+        catch {
+            $linkDirectory = [System.IO.Path]::GetDirectoryName($LinkFullPath)
+        }
+
+        $candidate = $null
+        if ([System.IO.Path]::IsPathRooted($target)) {
+            if ($target.StartsWith('\', [System.StringComparison]::Ordinal) -and
+                -not $target.StartsWith('\\', [System.StringComparison]::Ordinal)) {
+                # Rooted but drive-relative ('\dir\x'): anchor on the link's volume.
+                $volume = [System.IO.Path]::GetPathRoot($linkDirectory)
+                if ([string]::IsNullOrEmpty($volume)) { return $null }
+                $candidate = $volume.TrimEnd([char]'\') + $target
+            }
+            else {
+                $candidate = $target
+            }
+        }
+        else {
+            if ([string]::IsNullOrEmpty($linkDirectory)) { return $null }
+            # Relative to the directory holding the link - NOT to the process
+            # working directory and NOT to the scan root.
+            $candidate = [System.IO.Path]::Combine($linkDirectory, $target)
+        }
+
+        if ([string]::IsNullOrWhiteSpace($candidate)) { return $null }
+        return Get-WReparseCanonicalPath -Path $candidate
+    }
+    catch {
+        return $null
+    }
+}
+
+# Stable ordering key: ordinal, case-insensitive first, with a case-sensitive
+# tie-break so that two entries whose names differ only by case keep a
+# deterministic position. Never culture-aware: the same tree must produce the
+# same report on every host (contract 6).
+function Compare-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Left,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Right
+    )
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($Left, $Right)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($Left, $Right)
+}
