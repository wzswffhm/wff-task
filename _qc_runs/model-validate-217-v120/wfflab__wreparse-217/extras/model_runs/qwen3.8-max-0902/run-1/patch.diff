+$ErrorActionPreference = 'Continue'
+function Probe([string]$label, [scriptblock]$sb) {
+    try {
+        $r = & $sb
+        if ($null -eq $r) { $r = '<null>' }
+        '{0,-42} => [{1}]' -f $label, ([string]$r)
+    }
+    catch {
+        '{0,-42} => THROW {1}: {2}' -f $label, $_.Exception.GetType().Name, $_.Exception.Message
+    }
+}
