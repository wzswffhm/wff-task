+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse reference implementation.
+
+# Compares two decorated rows: key by key with the ordinal path comparer, then
+# by the original position so the sort is total and stable.
+function Compare-WReparseSortItems {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$Left,
+        [Parameter(Mandatory = $true)]$Right
+    )
+    $leftKeys = @($Left.Keys)
+    $rightKeys = @($Right.Keys)
+    $shared = [Math]::Min($leftKeys.Count, $rightKeys.Count)
+    for ($i = 0; $i -lt $shared; $i++) {
+        $result = Compare-WReparsePath -Left ([string]$leftKeys[$i]) -Right ([string]$rightKeys[$i])
+        if ($result -ne 0) { return $result }
+    }
+    if ($leftKeys.Count -ne $rightKeys.Count) {
+        return ($leftKeys.Count - $rightKeys.Count)
+    }
+    return ([int]$Left.Order - [int]$Right.Order)
+}
+
+# Stable merge sort so the report never depends on the enumerator order or on
+# the host culture. Sort-Object is deliberately not used: its default string
+# comparison is culture-aware and would order non-ASCII names differently on
+# different hosts (e.g. 'A"' / 'o' before 'Z' instead of after it).
+# Keys are compared ordinally, case-insensitively, with a case-sensitive
+# tie-break (contract 6).
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][object[]]$Items,
+        [Parameter(Mandatory = $true)][string[]]$SortProperties
+    )
+
+    $array = @($Items)
+    $count = $array.Count
+    if ($count -eq 0) { return @() }
+    if ($count -eq 1) { return @($array) }
+
+    $properties = @($SortProperties)
+
+    # Decorate once so keys are not recomputed during the merge.
+    $source = New-Object 'object[]' $count
+    for ($i = 0; $i -lt $count; $i++) {
+        $keys = New-Object 'string[]' $properties.Count
+        for ($k = 0; $k -lt $properties.Count; $k++) {
+            $value = Get-WReparseMemberValue -InputObject $array[$i] -Name $properties[$k]
+            if ($null -eq $value) { $keys[$k] = '' } else { $keys[$k] = [string]$value }
+        }
+        $source[$i] = [pscustomobject]@{
+            Keys  = $keys
+            Order = $i
+            Item  = $array[$i]
+        }
+    }
+
+    $buffer = New-Object 'object[]' $count
+    $width = 1
+    while ($width -lt $count) {
+        $start = 0
+        while ($start -lt $count) {
+            $middle = $start + $width
+            if ($middle -gt $count) { $middle = $count }
+            $end = $start + (2 * $width)
+            if ($end -gt $count) { $end = $count }
+
+            $i = $start
+            $j = $middle
+            $k = $start
+            while ($i -lt $middle -and $j -lt $end) {
+                if ((Compare-WReparseSortItems -Left $source[$i] -Right $source[$j]) -le 0) {
+                    $buffer[$k] = $source[$i]
+                    $i++
+                }
+                else {
+                    $buffer[$k] = $source[$j]
+                    $j++
+                }
+                $k++
+            }
+            while ($i -lt $middle) { $buffer[$k] = $source[$i]; $i++; $k++ }
+            while ($j -lt $end) { $buffer[$k] = $source[$j]; $j++; $k++ }
+
+            $start = $start + (2 * $width)
+        }
+
+        $swap = $source
+        $source = $buffer
+        $buffer = $swap
+        $width = $width * 2
+    }
+
+    $result = New-Object 'object[]' $count
+    for ($i = 0; $i -lt $count; $i++) { $result[$i] = $source[$i].Item }
+    return $result
+}
+
+# The three category counters are mutually exclusive and must add up to the
+# number of records (contract 3.3).
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        if ($null -eq $record) { continue }
+        $kind = [string](Get-WReparseMemberValue -InputObject $record -Name 'Kind')
+        if ([string]::Equals($kind, $script:WReparseKindDirectory, [System.StringComparison]::Ordinal)) {
+            $directories++
+        }
+        elseif ([string]::Equals($kind, $script:WReparseKindFile, [System.StringComparison]::Ordinal)) {
+            $files++
+        }
+        elseif ([string]::Equals($kind, $script:WReparseKindReparse, [System.StringComparison]::Ordinal)) {
+            $reparse++
+        }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+    $followMode = 'Never'
+    if ($Follow) { $followMode = 'Always' }
+
+    $walk = Invoke-WReparseWalk -Root $Root -FollowMode $followMode -MaxDepth $MaxDepth
+
+    $records = @(Sort-WReparseStable -Items @($walk.Records) -SortProperties @('RelativePath'))
+    $errors = @(Sort-WReparseStable -Items @($walk.Errors) -SortProperties @('RelativePath', 'Code'))
+    $stats = Get-WReparseStats -Records $records -Skipped ([int]$walk.Skipped) -ErrorCount $errors.Count
+
+    $rootValue = [string](Get-WReparseMemberValue -InputObject $walk -Name 'Root')
+    if ([string]::IsNullOrEmpty($rootValue)) { $rootValue = [string]$Root }
+
+    return New-WReparseReport -Root $rootValue -Records $records -Errors $errors -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$Report
+    )
+    return ($Report | ConvertTo-Json -Depth 12)
+}
