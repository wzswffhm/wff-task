+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse reference implementation.
+#
+# Everything in this file is internal: the module publishes only the six
+# contract functions.
+
+# Reads a member without triggering provider side effects and without throwing
+# when the member is absent.
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$InputObject,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $psObject = $InputObject.PSObject
+    if ($null -eq $psObject) { return $null }
+    $property = $psObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    try { return $property.Value } catch { return $null }
+}
+
+# Maps the provider link type onto the contract vocabulary. Only entries whose
+# file attributes carry FILE_ATTRIBUTE_REPARSE_POINT reach this function, so a
+# hard link (which has a link type but no reparse attribute) is never mapped.
+# Junction and SymbolicLink stay distinct.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([AllowNull()][AllowEmptyString()][string]$LinkType)
+    if ([string]::IsNullOrWhiteSpace($LinkType)) { return $script:WReparseReparseKindUnknown }
+    switch ($LinkType) {
+        'SymbolicLink' { return $script:WReparseReparseKindSymbolicLink }
+        'Junction' { return $script:WReparseReparseKindJunction }
+        'MountPoint' { return $script:WReparseReparseKindMountPoint }
+        default { return $script:WReparseReparseKindUnknown }
+    }
+}
+
+# A reparse point is identified ONLY by FILE_ATTRIBUTE_REPARSE_POINT. A hard
+# link reports LinkType 'HardLink' but has no reparse attribute and therefore is
+# an ordinary file.
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Item)
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return $false }
+
+    $value = $null
+    if ($attributes -is [System.IO.FileAttributes]) {
+        $value = [int]$attributes
+    }
+    else {
+        $parsed = $attributes -as [System.IO.FileAttributes]
+        if ($null -eq $parsed) { return $false }
+        $value = [int]$parsed
+    }
+
+    $mask = [int][System.IO.FileAttributes]::ReparsePoint
+    return (($value -band $mask) -eq $mask)
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+# Ancestry test for cycle detection. Only the directories on the CURRENT branch
+# are consulted, so two sibling links that point at the same target are not a
+# cycle. Comparison is ordinal-ignore-case on canonical paths.
+function Test-WReparseIsAncestor {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][AllowEmptyCollection()][string[]]$Ancestry,
+        [AllowNull()][AllowEmptyString()][string]$Path
+    )
+    if ($null -eq $Ancestry) { return $false }
+    if ([string]::IsNullOrEmpty($Path)) { return $false }
+    foreach ($entry in @($Ancestry)) {
+        if ($null -eq $entry) { continue }
+        if ([string]::IsNullOrEmpty([string]$entry)) { continue }
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([string]$entry, $Path)) { return $true }
+    }
+    return $false
+}
+
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$VirtualDirectory,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+
+    $children = @()
+    if ([string]::IsNullOrEmpty($RealDirectory)) { return }
+
+    $enumerationErrors = $null
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction SilentlyContinue -ErrorVariable enumerationErrors)
+    }
+    catch {
+        $children = @()
+        $enumerationErrors = @($_)
+    }
+
+    # A failing directory never aborts the scan; it is reported and the rest of
+    # the tree keeps producing records. Whatever could be enumerated is still
+    # processed.
+    if ($null -ne $enumerationErrors) {
+        $errorList = @($enumerationErrors)
+        if ($errorList.Count -gt 0) {
+            $relative = Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root
+            $detail = [string]$errorList[0]
+            Add-WReparseError -State $State -RelativePath $relative -Code 'access_denied' `
+                -Message "Directory could not be enumerated: $detail"
+        }
+    }
+
+    foreach ($child in $children) {
+        if ($null -eq $child) { continue }
+
+        $childDepth = $Depth + 1
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        if ([string]::IsNullOrEmpty($realChild)) { continue }
+
+        $leaf = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        if ([string]::IsNullOrEmpty($leaf)) { $leaf = [string][System.IO.Path]::GetFileName($realChild) }
+        if ([string]::IsNullOrEmpty($leaf)) { continue }
+
+        $virtualChild = Join-Path -Path $VirtualDirectory -ChildPath $leaf
+        $relative = Get-WReparseRelativePath -FullPath $virtualChild -Root $State.Root
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = ConvertTo-WReparseTargetString -RawTarget (Get-WReparseMemberValue -InputObject $child -Name 'Target')
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+
+            $inScope = $false
+            if (-not [string]::IsNullOrEmpty($resolved)) {
+                $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+            }
+
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative `
+                -Kind $script:WReparseKindReparse `
+                -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                -Depth $childDepth -Size 0))
+
+            # Default: never enter a reparse target, only register the entry.
+            # Without -Follow no cycle and no broken_target error may appear,
+            # so the target is not even probed on disk.
+            if (-not $State.Follow) {
+                $State.Skipped = [int]$State.Skipped + 1
+                continue
+            }
+
+            if ([string]::IsNullOrEmpty($resolved)) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target could not be resolved.'
+                continue
+            }
+
+            $targetExists = $false
+            $targetIsContainer = $false
+            try {
+                $targetExists = [bool](Test-Path -LiteralPath $resolved -ErrorAction SilentlyContinue)
+                if ($targetExists) {
+                    $targetIsContainer = [bool](Test-Path -LiteralPath $resolved -PathType Container -ErrorAction SilentlyContinue)
+                }
+            }
+            catch {
+                $targetExists = $false
+                $targetIsContainer = $false
+            }
+
+            if (-not $targetExists) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+
+            # A link onto a file registers the link entry only: no children.
+            if (-not $targetIsContainer) { continue }
+
+            if (Test-WReparseIsAncestor -Ancestry $Ancestry -Path $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                    -Message 'The reparse target is an ancestor of this branch.'
+                continue
+            }
+
+            if ($childDepth -ge [int]$State.MaxDepth) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'too_deep' `
+                    -Message "Depth limit of $([int]$State.MaxDepth) reached; not enumerating."
+                continue
+            }
+
+            # Entries below the link are named after the LINK path, not after
+            # the real target path.
+            Invoke-WReparseDirectoryWalk -RealDirectory $resolved -VirtualDirectory $virtualChild `
+                -Depth $childDepth -Ancestry (@($Ancestry) + [string]$resolved) -State $State
+            continue
+        }
+
+        $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) {
+                try { $size = [long]$length } catch { $size = [long]0 }
+            }
+        }
+
+        $kind = $script:WReparseKindFile
+        if ($isContainer) { $kind = $script:WReparseKindDirectory }
+
+        # InScope only carries meaning for reparse entries; ordinary files and
+        # directories always report $false.
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+            -InScope $false -Depth $childDepth -Size $size))
+
+        if ($isContainer) {
+            if ($childDepth -ge [int]$State.MaxDepth) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'too_deep' `
+                    -Message "Depth limit of $([int]$State.MaxDepth) reached; not enumerating."
+                continue
+            }
+            $realChildCanonical = $realChild
+            try { $realChildCanonical = Get-WReparseCanonicalPath -Path $realChild } catch { $realChildCanonical = $realChild }
+            Invoke-WReparseDirectoryWalk -RealDirectory $realChildCanonical -VirtualDirectory $virtualChild `
+                -Depth $childDepth -Ancestry (@($Ancestry) + [string]$realChildCanonical) -State $State
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+
+    $effectiveMaxDepth = [int]$MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $state = @{
+        Records  = New-Object System.Collections.ArrayList
+        Errors   = New-Object System.Collections.ArrayList
+        Skipped  = 0
+        Root     = $null
+        Follow   = [bool]$Follow
+        MaxDepth = $effectiveMaxDepth
+    }
+
+    $canonicalRoot = $null
+    try {
+        $canonicalRoot = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        $state.Root = [string]$Root
+        Add-WReparseError -State $state -RelativePath $script:WReparseRootRelativePath -Code 'invalid_argument' `
+            -Message "Scan root could not be canonicalised: $([string]$Root)"
+        return [pscustomobject]@{
+            Root    = [string]$state.Root
+            Records = $state.Records.ToArray()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+
+    $state.Root = $canonicalRoot
+
+    $rootExists = $false
+    try { $rootExists = [bool](Test-Path -LiteralPath $canonicalRoot -ErrorAction SilentlyContinue) } catch { $rootExists = $false }
+    if (-not $rootExists) {
+        Add-WReparseError -State $state -RelativePath $script:WReparseRootRelativePath -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = [string]$canonicalRoot
+            Records = $state.Records.ToArray()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+
+    $rootIsContainer = $false
+    try { $rootIsContainer = [bool](Test-Path -LiteralPath $canonicalRoot -PathType Container -ErrorAction SilentlyContinue) } catch { $rootIsContainer = $false }
+    if (-not $rootIsContainer) {
+        Add-WReparseError -State $state -RelativePath $script:WReparseRootRelativePath -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = [string]$canonicalRoot
+            Records = $state.Records.ToArray()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualDirectory $canonicalRoot `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return [pscustomobject]@{
+        Root    = [string]$canonicalRoot
+        Records = $state.Records.ToArray()
+        Errors  = $state.Errors.ToArray()
+        Skipped = [int]$state.Skipped
+    }
+}
