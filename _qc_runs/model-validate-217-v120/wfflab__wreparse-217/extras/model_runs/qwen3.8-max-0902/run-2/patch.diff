+# TEMPORARY verification fixture builder (deleted before submit).
+$ErrorActionPreference = 'Stop'
+
+$base = Join-Path $env:TEMP 'wrx-fix'
+if (Test-Path -LiteralPath $base) {
+    cmd /c "rmdir /s /q `"$base`"" | Out-Null
+    if (Test-Path -LiteralPath $base) { Remove-Item -LiteralPath $base -Recurse -Force }
+}
+
+$root = Join-Path $base 'tree\scanroot'
+$sibling = Join-Path $base 'tree\scanroot2'
+$outside = Join-Path $base 'outside'
+
+New-Item -ItemType Directory -Path (Join-Path $root 'docs') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $root 'empty') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $root 'nested\a\b') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $root 'branch2') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $sibling 'data') -Force | Out-Null
+New-Item -ItemType Directory -Path $outside -Force | Out-Null
+
+# non-ASCII directory names built from code points to avoid file encoding issues
+$adir = [string][char]0x00C4 + 'dir'
+$odir = [string][char]0x00F6 + 'dir'
+New-Item -ItemType Directory -Path (Join-Path $root $adir) -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $root $odir) -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $root 'Zdir') -Force | Out-Null
+
+Set-Content -LiteralPath (Join-Path $root 'plain.txt') -Value 'plain' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root 'docs\readme.txt') -Value 'readme' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root 'nested\a\b\deep.txt') -Value 'deep' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $sibling 'data\note.txt') -Value 'note' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $outside 'secret.txt') -Value 'secret' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root "$adir\a.txt") -Value 'a' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root "$odir\o.txt") -Value 'o' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $root 'Zdir\z.txt') -Value 'z' -NoNewline -Encoding ASCII
+
+New-Item -ItemType HardLink -Path (Join-Path $root 'hardlink.txt') -Target (Join-Path $root 'plain.txt') | Out-Null
+
+# junction (absolute target)
+New-Item -ItemType Junction -Path (Join-Path $root 'junction') -Target (Join-Path $root 'docs') | Out-Null
+
+# absolute directory symlink
+New-Item -ItemType SymbolicLink -Path (Join-Path $root 'link-in') -Target (Join-Path $root 'docs') | Out-Null
+
+# relative links via mklink so the stored target stays relative
+Push-Location $root
+cmd /c 'mklink /D symdir-rel docs' | Out-Null
+cmd /c 'mklink symfile-rel plain.txt' | Out-Null
+cmd /c 'mklink /D link-out ..\scanroot2\data' | Out-Null
+cmd /c 'mklink /D link-outside ..\..\outside' | Out-Null
+cmd /c 'mklink broken C:\definitely-missing\file.txt' | Out-Null
+cmd /c 'mklink /D brokend C:\definitely-missing\dir' | Out-Null
+cmd /c 'mklink /D loop .' | Out-Null
+Pop-Location
+
+Push-Location (Join-Path $root 'nested\a')
+cmd /c 'mklink /D twin ..\..\docs' | Out-Null
+cmd /c 'mklink /D back-to-root ..\..' | Out-Null
+Pop-Location
+
+Push-Location (Join-Path $root 'branch2')
+cmd /c 'mklink /D twin ..\docs' | Out-Null
+Pop-Location
+
+Push-Location (Join-Path $root 'docs')
+cmd /c 'mklink /D up ..' | Out-Null
+Pop-Location
+
+Write-Host "fixture ready at $root"
+Get-ChildItem -LiteralPath $root -Force | ForEach-Object {
+    '{0,-16} LT={1,-13} ATTR={2,-26} TGT=[{3}]' -f $_.Name, $_.LinkType, $_.Attributes, ($_.Target -join '|')
+}
