+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation. See the contract under docs/
+#
+# Only Get-WReparseCanonicalPath, Test-WReparseWithinRoot and
+# Resolve-WReparseLinkTarget belong to the public surface; the remaining helpers
+# in this file are internal.
+
+$script:WReparseVolumeSeparator = [char]92   # '\'
+$script:WReparseAltSeparator = [char]47      # '/'
+
+# Canonical form used for every comparison and for the report (contract 5.1):
+#   * full (rooted) path with '.' and '..' collapsed
+#   * no trailing directory separator, except for a volume root ('C:\')
+#     or a UNC share root ('\\server\share'), which keep their shape
+#   * original casing preserved
+function Get-WReparseCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Path
+    )
+
+    if ($null -eq $Path) {
+        throw (New-Object System.ArgumentException('Path is null.', 'Path'))
+    }
+    $candidate = $Path
+    if ($candidate.Length -eq 0) {
+        throw (New-Object System.ArgumentException('Path is empty.', 'Path'))
+    }
+
+    # NT native / Win32 device forms are folded onto the plain Win32 form so
+    # that containment checks and comparisons stay consistent.
+    if ($candidate.StartsWith('\\?\') -or $candidate.StartsWith('\??\')) {
+        $candidate = $candidate.Substring(4)
+        if ($candidate.StartsWith('UNC\', [System.StringComparison]::OrdinalIgnoreCase)) {
+            $candidate = '\' + $candidate.Substring(4)
+        }
+    }
+    if ($candidate.Length -eq 0) {
+        throw (New-Object System.ArgumentException('Path is empty.', 'Path'))
+    }
+
+    # Throws for strings that are not a legal path; callers translate that into
+    # the contract's invalid_argument error code.
+    $full = [System.IO.Path]::GetFullPath($candidate)
+    if ([string]::IsNullOrEmpty($full)) {
+        throw (New-Object System.ArgumentException('Path could not be canonicalised.', 'Path'))
+    }
+
+    $trimmed = $full.TrimEnd($script:WReparseVolumeSeparator, $script:WReparseAltSeparator)
+    if ($trimmed.Length -eq 0) {
+        # Root of the current volume ('\' or '/'): keep the separator.
+        return $full
+    }
+    if ($trimmed.StartsWith('\\')) {
+        # UNC: '\\server\share' is the share root and keeps its shape.
+        return $trimmed
+    }
+    if (($trimmed.Length -eq 2) -and ($trimmed[1] -eq ':')) {
+        # Volume root: 'C:' is not the same location as 'C:\', keep 'C:\'.
+        return $trimmed + '\'
+    }
+    return $trimmed
+}
+
+# Directory-boundary aware containment (contract 5.2). 'C:\root2' is NOT inside
+# 'C:\root' even though 'C:\root2'.StartsWith('C:\root') is true. Windows path
+# comparison is case-insensitive, so the ordinal-ignore-case comparer is used.
+function Test-WReparseWithinRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root
+    )
+    if ($null -eq $Path -or $null -eq $Root) { return $false }
+    if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) { return $false }
+
+    $p = $null
+    $r = $null
+    try { $p = Get-WReparseCanonicalPath -Path $Path } catch { return $false }
+    try { $r = Get-WReparseCanonicalPath -Path $Root } catch { return $false }
+    if ([string]::IsNullOrEmpty($p) -or [string]::IsNullOrEmpty($r)) { return $false }
+
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return $true }
+
+    $prefix = $r
+    if (-not $prefix.EndsWith('\')) { $prefix = $prefix + '\' }
+    if ($p.Length -le $prefix.Length) { return $false }
+    return $p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
+}
+
+# Relative path of a scanned entry with respect to the scan root, using the
+# Windows separator. The root itself yields '.'.
+function Get-WReparseRelativePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$FullPath,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root
+    )
+    $p = [string]$FullPath
+    $r = [string]$Root
+    if ($null -eq $FullPath) { $p = '' }
+    if ($null -eq $Root) { $r = '' }
+    try { $p = Get-WReparseCanonicalPath -Path $p } catch { }
+    try { $r = Get-WReparseCanonicalPath -Path $r } catch { }
+
+    if ([string]::IsNullOrEmpty($p)) { return $script:WReparseRootRelativePath }
+    if ([string]::IsNullOrEmpty($r)) { return $p }
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return $script:WReparseRootRelativePath }
+
+    $prefix = $r
+    if (-not $prefix.EndsWith('\')) { $prefix = $prefix + '\' }
+    if (($p.Length -gt $prefix.Length) -and $p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $p.Substring($prefix.Length)
+    }
+    return $p
+}
+
+# The reparse target stored on disk may be relative (contract 5.3). A relative
+# target is resolved against the directory that CONTAINS the link, never against
+# the process working directory and never against the scan root.
+function Resolve-WReparseLinkTarget {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$LinkFullPath,
+        [AllowNull()][AllowEmptyCollection()]$RawTarget
+    )
+
+    $target = ConvertTo-WReparseTargetString -RawTarget $RawTarget
+    if ([string]::IsNullOrWhiteSpace($target)) { return $null }
+
+    try {
+        if ([System.IO.Path]::IsPathRooted($target)) {
+            return Get-WReparseCanonicalPath -Path $target
+        }
+
+        if ([string]::IsNullOrWhiteSpace($LinkFullPath)) { return $null }
+        $linkDirectory = [System.IO.Path]::GetDirectoryName($LinkFullPath)
+        if ([string]::IsNullOrWhiteSpace($linkDirectory)) { return $null }
+
+        $combined = [System.IO.Path]::Combine($linkDirectory, $target)
+        return Get-WReparseCanonicalPath -Path $combined
+    }
+    catch {
+        return $null
+    }
+}
+
+# Stable ordering key comparison (contract 6): ordinal, case-insensitive first,
+# with an ordinal case-sensitive tie-break so that two entries whose names
+# differ only by case keep a deterministic position. Host culture is never
+# consulted: 'Z' (U+005A) sorts before 'A' with a diaeresis (U+00C4) and before
+# 'o' with a diaeresis (U+00F6).
+function Compare-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Left,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Right
+    )
+    $left = [string]$Left
+    $right = [string]$Right
+    if ($null -eq $Left) { $left = '' }
+    if ($null -eq $Right) { $right = '' }
+
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($left, $right)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($left, $right)
+}
+
+# Compares two composite ordering keys element by element using the ordinal
+# rules above. A missing element sorts before a present one.
+function Compare-WReparseKeyList {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][AllowEmptyCollection()][string[]]$Left,
+        [AllowNull()][AllowEmptyCollection()][string[]]$Right
+    )
+    $left = @($Left)
+    $right = @($Right)
+    $count = [System.Math]::Max($left.Count, $right.Count)
+    for ($index = 0; $index -lt $count; $index++) {
+        $leftValue = $null
+        $rightValue = $null
+        if ($index -lt $left.Count) { $leftValue = [string]$left[$index] }
+        if ($index -lt $right.Count) { $rightValue = [string]$right[$index] }
+        $result = Compare-WReparsePath -Left $leftValue -Right $rightValue
+        if ($result -ne 0) { return $result }
+    }
+    return 0
+}
