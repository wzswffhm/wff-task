+# TEMPORARY extra edge checks (deleted before submit).
+$ErrorActionPreference = 'Stop'
+
+$workspace = Split-Path -Parent $PSScriptRoot
+Import-Module (Join-Path $workspace 'WReparse\WReparse.psd1') -Force
+
+$failed = 0
+function Check {
+    param([string]$Name, [scriptblock]$Test)
+    try {
+        $r = & $Test
+        if ($r -eq $true) { Write-Host "[PASS] $Name" } else { Write-Host "[FAIL] $Name -> $r"; $script:failed++ }
+    }
+    catch { Write-Host "[FAIL] $Name -> EXCEPTION: $($_.Exception.Message)"; $script:failed++ }
+}
+
+$base = [System.IO.Path]::GetFullPath((Join-Path $env:TEMP 'wrx-edge'))
+if (Test-Path -LiteralPath $base) { cmd /c "rmdir /s /q `"$base`"" | Out-Null }
+New-Item -ItemType Directory -Path (Join-Path $base 'locked\inner') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $base 'locked\sibling') -Force | Out-Null
+Set-Content -LiteralPath (Join-Path $base 'locked\sibling\ok.txt') -Value 'ok' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $base 'locked\inner\hidden.txt') -Value 'x' -NoNewline -Encoding ASCII
+
+# deny read/list on 'locked\inner'
+$denyPath = Join-Path $base 'locked\inner'
+cmd /c "icacls `"$denyPath`" /deny `"*S-1-5-32-544:(OI)(CI)(RX)`" /c" | Out-Null
+
+$report = Get-WReparseReport -Root $base
+Check 'X access_denied reported once' {
+    $e = @($report.Errors | Where-Object { $_.Code -eq 'access_denied' })
+    if ($e.Count -ne 1) { return "count=$($e.Count): $(($e | ForEach-Object { $_.RelativePath }) -join ',')" }
+    if ($e[0].RelativePath -cne 'locked\inner') { return $e[0].RelativePath }
+    $true
+}
+Check 'X rest of the tree still scanned' {
+    $paths = @($report.Records | ForEach-Object { $_.RelativePath })
+    if ($paths -notcontains 'locked\sibling\ok.txt') { return 'sibling missing' }
+    if ($paths -contains 'locked\inner\hidden.txt') { return 'leaked into locked dir' }
+    $true
+}
+Check 'X stats errors matches' { if ($report.Stats.Errors -ne $report.Errors.Count) { return 'mismatch' }; $true }
+
+# restore permissions before cleanup
+cmd /c "icacls `"$denyPath`" /remove:d `"*S-1-5-32-544`" /c" | Out-Null
+
+$tree = [System.IO.Path]::GetFullPath((Join-Path $env:TEMP 'wrx-fix\tree\scanroot'))
+Check 'X trailing separator root' {
+    $r = Get-WReparseReport -Root ($tree + '\')
+    if ($r.Root -cne $tree) { return $r.Root }
+    if (@($r.Records | Where-Object { $_.RelativePath -eq 'docs\readme.txt' }).Count -ne 1) { return 'child missing' }
+    if ($r.Errors.Count -ne 0) { return "errors=$($r.Errors.Count)" }
+    $true
+}
+Check 'X dot and dotdot in root' {
+    $r = Get-WReparseReport -Root (Join-Path $tree 'docs\..\docs\.')
+    if ($r.Root -cne (Join-Path $tree 'docs')) { return $r.Root }
+    $paths = @($r.Records | ForEach-Object { $_.RelativePath })
+    if ($paths -notcontains 'readme.txt') { return ($paths -join ',') }
+    $true
+}
+Check 'X mixed case root preserved' {
+    $mixed = $tree.Substring(0, $tree.Length - 8) + 'SCANROOT'
+    $r = Get-WReparseReport -Root $mixed
+    if ($r.Root -cne $mixed) { return "$($r.Root) vs $mixed" }
+    if (@($r.Records | Where-Object { $_.RelativePath -eq 'docs\readme.txt' }).Count -ne 1) { return 'child missing' }
+    $true
+}
+Check 'X scan root is a junction' {
+    $j = Join-Path $tree 'junction'
+    $r = Get-WReparseReport -Root $j
+    if ($r.Errors.Count -ne 0) { return "errors: $(($r.Errors | ForEach-Object { $_.Code }) -join ',')" }
+    if (@($r.Records | Where-Object { $_.RelativePath -eq 'readme.txt' }).Count -ne 1) { return 'child missing' }
+    $true
+}
+Check 'X empty tree json shape' {
+    $empty = Join-Path $env:TEMP 'wrx-empty-dir'
+    if (-not (Test-Path -LiteralPath $empty)) { New-Item -ItemType Directory -Path $empty | Out-Null }
+    $j = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $empty)
+    $p = $j | ConvertFrom-Json
+    if (@($p.Records).Count -ne 0) { return 'records not empty' }
+    if (@($p.Errors).Count -ne 0) { return 'errors not empty' }
+    if ($p.Stats.Directories -ne 0 -or $p.Stats.Files -ne 0 -or $p.Stats.ReparsePoints -ne 0 -or $p.Stats.Skipped -ne 0 -or $p.Stats.Errors -ne 0) { return 'stats not zero' }
+    Remove-Item -LiteralPath $empty -Force
+    $true
+}
+Check 'X report of tiny tree json text' {
+    $tiny = Join-Path $env:TEMP 'wrx-tiny'
+    if (Test-Path -LiteralPath $tiny) { Remove-Item -LiteralPath $tiny -Recurse -Force }
+    New-Item -ItemType Directory -Path $tiny | Out-Null
+    Set-Content -LiteralPath (Join-Path $tiny 'a.txt') -Value 'abc' -NoNewline -Encoding ASCII
+    $json = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $tiny)
+    Write-Host $json
+    Remove-Item -LiteralPath $tiny -Recurse -Force
+    $true
+}
+Check 'X follow into access denied target' {
+    $r = Get-WReparseReport -Root $base -Follow
+    if ($null -eq $r) { return 'null report' }
+    $true
+}
+
+cmd /c "rmdir /s /q `"$base`"" | Out-Null
+Write-Host ''
+if ($failed -gt 0) { Write-Host "FAILED: $failed"; exit 1 }
+Write-Host 'EDGE CHECKS PASSED'
+exit 0
