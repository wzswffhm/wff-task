diff --git a/.verify/check.ps1 b/.verify/check.ps1
new file mode 100644
index 0000000..8d17ee6
--- /dev/null
+++ b/.verify/check.ps1
@@ -0,0 +1,445 @@
+# TEMPORARY contract check (deleted before submit).
+$ErrorActionPreference = 'Stop'
+
+$workspace = Split-Path -Parent $PSScriptRoot
+Import-Module (Join-Path $workspace 'WReparse\WReparse.psd1') -Force
+
+$root = [System.IO.Path]::GetFullPath((Join-Path $env:TEMP 'wrx-fix\tree\scanroot'))
+$sibling = [System.IO.Path]::GetFullPath((Join-Path $env:TEMP 'wrx-fix\tree\scanroot2'))
+$base = [System.IO.Path]::GetFullPath((Join-Path $env:TEMP 'wrx-fix'))
+
+$failed = 0
+function Check {
+    param([string]$Name, [scriptblock]$Test)
+    try {
+        $r = & $Test
+        if ($r -eq $true) { Write-Host "[PASS] $Name" } else { Write-Host "[FAIL] $Name -> $r"; $script:failed++ }
+    }
+    catch { Write-Host "[FAIL] $Name -> EXCEPTION: $($_.Exception.Message)"; $script:failed++ }
+}
+
+# make sure the process working directory is unrelated to the tree
+Set-Location C:\Windows
+[Environment]::CurrentDirectory = 'C:\Windows'
+
+$report = Get-WReparseReport -Root $root
+$byPath = @{}
+foreach ($rec in $report.Records) { $byPath[$rec.RelativePath] = $rec }
+
+Check '1 report fields exactly five' {
+    $names = @($report.PSObject.Properties | ForEach-Object { $_.Name })
+    $expected = @('SchemaVersion', 'Root', 'Records', 'Errors', 'Stats')
+    if (($names -join ',') -ne ($expected -join ',')) { return "got: $($names -join ',')" }
+    return $true
+}
+Check '1 SchemaVersion' { if ($report.SchemaVersion -cne 'wreparse/1.0') { return $report.SchemaVersion }; $true }
+Check '1 Root canonical keeps case' { if ($report.Root -cne $root) { return "$($report.Root) vs $root" }; $true }
+Check '1 Records/Errors are arrays' {
+    if ($report.Records -isnot [System.Array]) { return 'records not array' }
+    if ($report.Errors -isnot [System.Array]) { return 'errors not array' }
+    $true
+}
+
+# ---- acceptance 1: every reparse point registered, none entered
+$reparse = @($report.Records | Where-Object { $_.Kind -eq 'ReparsePoint' })
+Check 'A1 all reparse points registered' {
+    $names = @($reparse | ForEach-Object { $_.RelativePath } | Sort-Object)
+    $want = @('broken', 'brokend', 'docs\up', 'junction', 'link-in', 'link-out', 'link-outside', 'loop', 'nested\a\back-to-root', 'nested\a\twin', 'branch2\twin', 'symdir-rel', 'symfile-rel') | Sort-Object
+    $missing = @($want | Where-Object { $names -notcontains $_ })
+    $extra = @($names | Where-Object { $want -notcontains $_ })
+    if ($missing.Count -or $extra.Count) { return "missing=$($missing -join ';') extra=$($extra -join ';')" }
+    $true
+}
+Check 'A1 Skipped equals reparse count' {
+    if ($report.Stats.Skipped -ne $reparse.Count) { return "skipped=$($report.Stats.Skipped) reparse=$($reparse.Count)" }
+    $true
+}
+Check 'A1 nothing below a link was entered' {
+    $leaked = @($report.Records | Where-Object { $_.RelativePath -like 'link-in\*' -or $_.RelativePath -like 'junction\*' -or $_.RelativePath -like 'symdir-rel\*' -or $_.RelativePath -like 'loop\*' -or $_.RelativePath -like 'nested\a\twin\*' })
+    if ($leaked.Count) { return ($leaked | ForEach-Object { $_.RelativePath }) -join ';' }
+    $true
+}
+
+# ---- acceptance 2: prefix-similar sibling is out of scope
+Check 'A2 link-out InScope false' { if ($byPath['link-out'].InScope -ne $false) { return 'true' }; $true }
+Check 'A2 link-out ResolvedTarget' { if ($byPath['link-out'].ResolvedTarget -cne (Join-Path $sibling 'data')) { return $byPath['link-out'].ResolvedTarget }; $true }
+Check 'A2 link-in InScope true' { if ($byPath['link-in'].InScope -ne $true) { return 'false' }; $true }
+Check 'A2 link-outside InScope false' { if ($byPath['link-outside'].InScope -ne $false) { return 'true' }; $true }
+Check 'A2 junction InScope true' { if ($byPath['junction'].InScope -ne $true) { return 'false' }; $true }
+Check 'A2 Test-WReparseWithinRoot boundary' {
+    if (Test-WReparseWithinRoot -Path $sibling -Root $root) { return 'sibling inside root' }
+    if (-not (Test-WReparseWithinRoot -Path $root -Root $root)) { return 'root not inside root' }
+    if (-not (Test-WReparseWithinRoot -Path (Join-Path $root 'docs\x.txt') -Root $root)) { return 'child not inside' }
+    if (Test-WReparseWithinRoot -Path 'C:\root2' -Root 'C:\root') { return 'C:\root2 inside C:\root' }
+    if (-not (Test-WReparseWithinRoot -Path 'C:\ROOT\Docs' -Root 'c:\root')) { return 'case insensitive failed' }
+    $true
+}
+
+# ---- acceptance 3: relative target resolved against the link directory
+Check 'A3 symdir-rel ResolvedTarget' {
+    $want = Join-Path $root 'docs'
+    if ($byPath['symdir-rel'].ResolvedTarget -cne $want) { return "got=$($byPath['symdir-rel'].ResolvedTarget) want=$want" }
+    if ($byPath['symdir-rel'].Target -cne 'docs') { return "raw=$($byPath['symdir-rel'].Target)" }
+    $true
+}
+Check 'A3 symfile-rel ResolvedTarget' {
+    $want = Join-Path $root 'plain.txt'
+    if ($byPath['symfile-rel'].ResolvedTarget -cne $want) { return $byPath['symfile-rel'].ResolvedTarget }
+    $true
+}
+Check 'A3 loop ResolvedTarget is root' { if ($byPath['loop'].ResolvedTarget -cne $root) { return "$($byPath['loop'].ResolvedTarget) vs $root" }; $true }
+Check 'A3 Resolve-WReparseLinkTarget api' {
+    $got = Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'symdir-rel') -RawTarget 'docs'
+    if ($got -cne (Join-Path $root 'docs')) { return "rel: $got" }
+    $got2 = Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'symdir-rel') -RawTarget 'C:\Temp\X'
+    if ($got2 -cne 'C:\Temp\X') { return "abs: $got2" }
+    $got3 = Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'symdir-rel') -RawTarget ''
+    if ($null -ne $got3) { return "empty: $got3" }
+    $got4 = Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'symdir-rel') -RawTarget @('docs')
+    if ($got4 -cne (Join-Path $root 'docs')) { return "array: $got4" }
+    $got5 = Resolve-WReparseLinkTarget -LinkFullPath (Join-Path $root 'nested\a\twin') -RawTarget '..\..\docs'
+    if ($got5 -cne (Join-Path $root 'docs')) { return "dotdot: $got5" }
+    $true
+}
+
+# ---- acceptance 4: byte identical serialisation
+Check 'A4 two serialisations identical' {
+    $j1 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root)
+    $j2 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root)
+    if ($j1 -cne $j2) { return 'different' }
+    if ($j1 -match 'GeneratedAt') { return 'timestamp present' }
+    $true
+}
+
+# ---- acceptance 5: hardlink is a file, junction vs symlink kinds differ
+Check 'A5 hardlink.txt is File' { if ($byPath['hardlink.txt'].Kind -cne 'File') { return $byPath['hardlink.txt'].Kind }; $true }
+Check 'A5 hardlink.txt has null link fields' {
+    $r = $byPath['hardlink.txt']
+    if ($null -ne $r.ReparseKind -or $null -ne $r.Target -or $null -ne $r.ResolvedTarget) { return 'not null' }
+    $true
+}
+Check 'A5 plain.txt is File with size' {
+    if ($byPath['plain.txt'].Kind -cne 'File') { return $byPath['plain.txt'].Kind }
+    if ($byPath['plain.txt'].Size -ne 5) { return "size=$($byPath['plain.txt'].Size)" }
+    $true
+}
+Check 'A5 docs is Directory size 0' {
+    if ($byPath['docs'].Kind -cne 'Directory') { return $byPath['docs'].Kind }
+    if ($byPath['docs'].Size -ne 0) { return "size=$($byPath['docs'].Size)" }
+    $true
+}
+Check 'A5 junction ReparseKind' { if ($byPath['junction'].ReparseKind -cne 'Junction') { return $byPath['junction'].ReparseKind }; $true }
+Check 'A5 symlink ReparseKind' { if ($byPath['symdir-rel'].ReparseKind -cne 'SymbolicLink') { return $byPath['symdir-rel'].ReparseKind }; $true }
+
+# ---- acceptance 6: error codes for bad roots
+Check 'A6 not_found' {
+    $r = Get-WReparseReport -Root (Join-Path $env:TEMP 'wrx-does-not-exist')
+    if ($r.Records.Count -ne 0) { return 'records not empty' }
+    if ($r.Errors.Count -ne 1) { return "errors=$($r.Errors.Count)" }
+    if ($r.Errors[0].Code -cne 'not_found') { return $r.Errors[0].Code }
+    if ($r.Errors[0].RelativePath -cne '.') { return $r.Errors[0].RelativePath }
+    $true
+}
+Check 'A6 structure' {
+    $r = Get-WReparseReport -Root (Join-Path $root 'plain.txt')
+    if ($r.Errors.Count -ne 1) { return "errors=$($r.Errors.Count)" }
+    if ($r.Errors[0].Code -cne 'structure') { return $r.Errors[0].Code }
+    if ($r.Errors[0].RelativePath -cne '.') { return $r.Errors[0].RelativePath }
+    $true
+}
+Check 'A6 invalid_argument' {
+    foreach ($bad in @('', 'C:\bad<>|path')) {
+        $r = Get-WReparseReport -Root $bad
+        if ($r.Errors.Count -ne 1) { return "errors=$($r.Errors.Count) for [$bad]" }
+        if ($r.Errors[0].Code -cne 'invalid_argument') { return "$($r.Errors[0].Code) for [$bad]" }
+        if ($r.Records.Count -ne 0) { return 'records not empty' }
+        if ($r.Stats.Errors -ne 1) { return 'stats errors' }
+    }
+    $true
+}
+
+# ---- acceptance 7: negative MaxDepth equals zero
+Check 'A7 MaxDepth -1 equals 0' {
+    $a = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -MaxDepth 0)
+    $b = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -MaxDepth -1)
+    $c = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -MaxDepth -7)
+    if ($a -cne $b -or $a -cne $c) { return 'json differs' }
+    $r = Get-WReparseReport -Root $root -MaxDepth 0
+    $deep = @($r.Errors | Where-Object { $_.Code -eq 'too_deep' })
+    if ($deep.Count -eq 0) { return 'no too_deep' }
+    foreach ($e in $deep) { if ($e.RelativePath -match '\\') { return "not a direct child: $($e.RelativePath)" } }
+    $expected = @($r.Records | Where-Object { $_.Kind -eq 'Directory' -and $_.Depth -eq 1 }).Count
+    if ($deep.Count -ne $expected) { return "too_deep=$($deep.Count) expected=$expected" }
+    if ($expected -lt 7) { return "only $expected depth-1 directories" }
+    $true
+}
+Check 'A7 MaxDepth 1 stops at grandchildren' {
+    $r = Get-WReparseReport -Root $root -MaxDepth 1
+    $deep = @($r.Errors | Where-Object { $_.Code -eq 'too_deep' })
+    $expected = @($r.Records | Where-Object { $_.Kind -eq 'Directory' -and $_.Depth -eq 1 }).Count
+    if ($deep.Count -ne $expected) { return "count=$($deep.Count) expected=$expected" }
+    if (@($r.Records | Where-Object { $_.RelativePath -eq 'docs\readme.txt' }).Count -ne 0) { return 'grandchild recorded' }
+    $true
+}
+Check 'A7 MaxDepth 2 enumerates grandchildren' {
+    $r = Get-WReparseReport -Root $root -MaxDepth 2
+    if (@($r.Records | Where-Object { $_.RelativePath -eq 'docs\readme.txt' }).Count -ne 1) { return 'grandchild missing' }
+    $deep = @($r.Errors | Where-Object { $_.Code -eq 'too_deep' })
+    if (@($deep | Where-Object { $_.RelativePath -eq 'nested\a' }).Count -ne 1) { return "too_deep=$($deep.Count): $(($deep | ForEach-Object { $_.RelativePath }) -join ',')" }
+    $true
+}
+Check 'A7 default MaxDepth has no too_deep' {
+    if ($report.Errors.Count -ne 0) { return "errors=$($report.Errors.Count)" }
+    $true
+}
+
+# ---- acceptance 15: no cycle/broken_target without -Follow
+Check 'A15 no cycle/broken_target without follow' {
+    $bad = @($report.Errors | Where-Object { $_.Code -eq 'cycle' -or $_.Code -eq 'broken_target' })
+    if ($bad.Count) { return ($bad | ForEach-Object { "$($_.RelativePath)=$($_.Code)" }) -join ';' }
+    $true
+}
+
+# ---- acceptance 16: InScope only meaningful for reparse entries
+Check 'A16 non reparse InScope false' {
+    $bad = @($report.Records | Where-Object { $_.Kind -ne 'ReparsePoint' -and $_.InScope -ne $false })
+    if ($bad.Count) { return ($bad | ForEach-Object { $_.RelativePath }) -join ';' }
+    if ($byPath['plain.txt'].InScope -ne $false) { return 'plain.txt' }
+    if ($byPath['docs'].InScope -ne $false) { return 'docs' }
+    if ($byPath['hardlink.txt'].InScope -ne $false) { return 'hardlink.txt' }
+    $true
+}
+
+# ---- acceptance 17: Target always a string
+Check 'A17 Target is string' {
+    foreach ($r in $reparse) { if ($r.Target -isnot [string]) { return "$($r.RelativePath): $($r.Target.GetType().Name)" } }
+    $true
+}
+Check 'A17 Target raw values' {
+    if ($byPath['link-out'].Target -cne '..\scanroot2\data') { return $byPath['link-out'].Target }
+    if ($byPath['broken'].Target -cne 'C:\definitely-missing\file.txt') { return $byPath['broken'].Target }
+    if ($byPath['loop'].Target -cne '.') { return $byPath['loop'].Target }
+    $true
+}
+
+# ---- stats consistency and depth
+Check 'S stats consistent' {
+    $d = @($report.Records | Where-Object { $_.Kind -eq 'Directory' }).Count
+    $f = @($report.Records | Where-Object { $_.Kind -eq 'File' }).Count
+    $p = @($report.Records | Where-Object { $_.Kind -eq 'ReparsePoint' }).Count
+    if ($report.Stats.Directories -ne $d) { return "dirs $($report.Stats.Directories) vs $d" }
+    if ($report.Stats.Files -ne $f) { return "files $($report.Stats.Files) vs $f" }
+    if ($report.Stats.ReparsePoints -ne $p) { return "reparse $($report.Stats.ReparsePoints) vs $p" }
+    if (($d + $f + $p) -ne $report.Records.Count) { return 'sum mismatch' }
+    if ($report.Stats.Errors -ne $report.Errors.Count) { return 'error count mismatch' }
+    $true
+}
+Check 'S depth from 1' {
+    if ($byPath['plain.txt'].Depth -ne 1) { return "plain.txt=$($byPath['plain.txt'].Depth)" }
+    if ($byPath['docs'].Depth -ne 1) { return "docs=$($byPath['docs'].Depth)" }
+    if ($byPath['docs\readme.txt'].Depth -ne 2) { return "readme=$($byPath['docs\readme.txt'].Depth)" }
+    if ($byPath['nested\a\b\deep.txt'].Depth -ne 4) { return "deep=$($byPath['nested\a\b\deep.txt'].Depth)" }
+    if ($byPath['empty'].Depth -ne 1) { return "empty=$($byPath['empty'].Depth)" }
+    if ($byPath['nested\a\back-to-root'].Depth -ne 3) { return "link depth=$($byPath['nested\a\back-to-root'].Depth)" }
+    $true
+}
+Check 'S record field order' {
+    $names = @($report.Records[0].PSObject.Properties | ForEach-Object { $_.Name })
+    $want = @('RelativePath', 'Kind', 'ReparseKind', 'Target', 'ResolvedTarget', 'InScope', 'Depth', 'Size')
+    if (($names -join ',') -ne ($want -join ',')) { return ($names -join ',') }
+    $true
+}
+Check 'S error field order' {
+    $e = (Get-WReparseReport -Root (Join-Path $root 'plain.txt')).Errors[0]
+    $names = @($e.PSObject.Properties | ForEach-Object { $_.Name })
+    if (($names -join ',') -ne 'RelativePath,Code,Message') { return ($names -join ',') }
+    $true
+}
+
+# ---- sorting: ordinal, culture independent
+Check 'O records sorted ordinal ignore case' {
+    $paths = @($report.Records | ForEach-Object { $_.RelativePath })
+    for ($i = 1; $i -lt $paths.Count; $i++) {
+        $c = [System.StringComparer]::OrdinalIgnoreCase.Compare($paths[$i - 1], $paths[$i])
+        if ($c -gt 0) { return "out of order: $($paths[$i-1]) > $($paths[$i])" }
+        if ($c -eq 0) {
+            $c2 = [System.StringComparer]::Ordinal.Compare($paths[$i - 1], $paths[$i])
+            if ($c2 -gt 0) { return "tie-break wrong: $($paths[$i-1]) / $($paths[$i])" }
+        }
+    }
+    $true
+}
+Check 'O Zdir before Adieresis before odieresis' {
+    $names = @($report.Records | Where-Object { $_.Depth -eq 1 } | ForEach-Object { $_.RelativePath })
+    $zi = [Array]::IndexOf($names, 'Zdir')
+    $ai = -1; $oi = -1
+    for ($i = 0; $i -lt $names.Count; $i++) {
+        if ($names[$i][0] -eq [char]0x00C4) { $ai = $i }
+        if ($names[$i][0] -eq [char]0x00F6) { $oi = $i }
+    }
+    if ($zi -lt 0 -or $ai -lt 0 -or $oi -lt 0) { return "zi=$zi ai=$ai oi=$oi" }
+    if (-not ($zi -lt $ai -and $ai -lt $oi)) { return "order zi=$zi ai=$ai oi=$oi" }
+    $true
+}
+Check 'O errors sorted by RelativePath then Code' {
+    $r = Get-WReparseReport -Root $root -Follow -MaxDepth 1
+    $errs = @($r.Errors)
+    for ($i = 1; $i -lt $errs.Count; $i++) {
+        $c = [System.StringComparer]::OrdinalIgnoreCase.Compare($errs[$i - 1].RelativePath, $errs[$i].RelativePath)
+        if ($c -gt 0) { return "order: $($errs[$i-1].RelativePath) > $($errs[$i].RelativePath)" }
+        if ($c -eq 0) {
+            $c2 = [System.StringComparer]::OrdinalIgnoreCase.Compare($errs[$i - 1].Code, $errs[$i].Code)
+            if ($c2 -gt 0) { return "code order: $($errs[$i-1].Code) > $($errs[$i].Code)" }
+        }
+    }
+    if ($errs.Count -lt 3) { return "only $($errs.Count) errors" }
+    $true
+}
+
+# ---- canonical path
+Check 'C canonical keeps case and trims separator' {
+    if ((Get-WReparseCanonicalPath -Path 'C:\Temp\X\') -cne 'C:\Temp\X') { return (Get-WReparseCanonicalPath -Path 'C:\Temp\X\') }
+    if ((Get-WReparseCanonicalPath -Path 'C:\Temp\MixedCase\..\Y') -cne 'C:\Temp\Y') { return (Get-WReparseCanonicalPath -Path 'C:\Temp\MixedCase\..\Y') }
+    if ((Get-WReparseCanonicalPath -Path 'C:\') -cne 'C:\') { return (Get-WReparseCanonicalPath -Path 'C:\') }
+    if ((Get-WReparseCanonicalPath -Path (Join-Path $root 'docs\.\readme.txt')) -cne (Join-Path $root 'docs\readme.txt')) { return 'dot collapse' }
+    if ((Get-WReparseCanonicalPath -Path (Join-Path $root 'docs\')) -cne (Join-Path $root 'docs')) { return 'trailing sep' }
+    $true
+}
+
+# ---- json shape
+Check 'J json nulls and empty arrays' {
+    $json = ConvertTo-WReparseJson -Report $report
+    $parsed = $json | ConvertFrom-Json
+    $hl = @($parsed.Records | Where-Object { $_.RelativePath -eq 'hardlink.txt' })[0]
+    if ($null -ne $hl.Target) { return 'target not null' }
+    if ($null -ne $hl.ReparseKind) { return 'reparsekind not null' }
+    if ($null -ne $hl.ResolvedTarget) { return 'resolvedtarget not null' }
+    if ($json -notmatch '"Target":\s+null') { return 'no json null for Target' }
+    if ($json -match '"Target":\s+""') { return 'empty string instead of null' }
+    $empty = Get-WReparseReport -Root (Join-Path $root 'empty')
+    $ej = ConvertTo-WReparseJson -Report $empty
+    $ep = $ej | ConvertFrom-Json
+    if (@($ep.Records).Count -ne 0) { return 'records not empty' }
+    if (@($ep.Errors).Count -ne 0) { return 'errors not empty' }
+    if ($ej -notmatch '"Records":\s+\[') { return 'records not an array in json' }
+    if ($ej -notmatch '"Errors":\s+\[') { return 'errors not an array in json' }
+    $true
+}
+Check 'J json parses back to same shape' {
+    $json = ConvertTo-WReparseJson -Report $report
+    $parsed = $json | ConvertFrom-Json
+    if (@($parsed.Records).Count -ne @($report.Records).Count) { return 'record count differs' }
+    if ($parsed.SchemaVersion -cne 'wreparse/1.0') { return 'schema' }
+    if (@($parsed.PSObject.Properties | ForEach-Object { $_.Name }).Count -ne 5) { return 'field count' }
+    $true
+}
+
+# ---- follow mode
+$follow = Get-WReparseReport -Root $root -Follow
+$fbyPath = @{}
+foreach ($rec in $follow.Records) { $fbyPath[$rec.RelativePath] = $rec }
+Check 'F8 link-in children use link prefix' {
+    if (-not $fbyPath.ContainsKey('link-in\readme.txt')) { return 'missing link-in\readme.txt' }
+    if ($fbyPath['link-in\readme.txt'].Depth -ne 2) { return "depth=$($fbyPath['link-in\readme.txt'].Depth)" }
+    if ($fbyPath['link-in\readme.txt'].Kind -cne 'File') { return 'kind' }
+    $true
+}
+Check 'F9 file target produces no children' {
+    if (-not $fbyPath.ContainsKey('symfile-rel')) { return 'link entry missing' }
+    $kids = @($follow.Records | Where-Object { $_.RelativePath -like 'symfile-rel\*' })
+    if ($kids.Count) { return ($kids | ForEach-Object { $_.RelativePath }) -join ';' }
+    $true
+}
+Check 'F10 sibling links to same target are not cycles' {
+    if (-not $fbyPath.ContainsKey('nested\a\twin\readme.txt')) { return 'nested\a\twin not entered' }
+    if (-not $fbyPath.ContainsKey('branch2\twin\readme.txt')) { return 'branch2\twin not entered' }
+    $cyc = @($follow.Errors | Where-Object { $_.Code -eq 'cycle' -and (($_.RelativePath -eq 'nested\a\twin') -or ($_.RelativePath -eq 'branch2\twin')) })
+    if ($cyc.Count) { return ($cyc | ForEach-Object { $_.RelativePath }) -join ';' }
+    $true
+}
+Check 'F cycle reported for real ancestors' {
+    $cyc = @($follow.Errors | Where-Object { $_.Code -eq 'cycle' })
+    $paths = @($cyc | ForEach-Object { $_.RelativePath })
+    foreach ($want in @('loop', 'docs\up', 'nested\a\back-to-root')) {
+        if ($paths -notcontains $want) { return "missing cycle for $want (got: $($paths -join ','))" }
+    }
+    $true
+}
+Check 'F broken_target reported under follow' {
+    $bt = @($follow.Errors | Where-Object { $_.Code -eq 'broken_target' } | ForEach-Object { $_.RelativePath })
+    foreach ($want in @('broken', 'brokend')) { if ($bt -notcontains $want) { return "missing $want (got $($bt -join ','))" } }
+    $true
+}
+Check 'F follow enters out of scope links' {
+    if (-not $fbyPath.ContainsKey('link-out\note.txt')) { return 'link-out not entered' }
+    if (-not $fbyPath.ContainsKey('link-outside\secret.txt')) { return 'link-outside not entered' }
+    $true
+}
+Check 'F follow stats skipped zero' { if ($follow.Stats.Skipped -ne 0) { return $follow.Stats.Skipped }; $true }
+Check 'F follow stats consistent' {
+    $d = @($follow.Records | Where-Object { $_.Kind -eq 'Directory' }).Count
+    $f = @($follow.Records | Where-Object { $_.Kind -eq 'File' }).Count
+    $p = @($follow.Records | Where-Object { $_.Kind -eq 'ReparsePoint' }).Count
+    if ($follow.Stats.Directories -ne $d -or $follow.Stats.Files -ne $f -or $follow.Stats.ReparsePoints -ne $p) { return 'mismatch' }
+    if (($d + $f + $p) -ne $follow.Records.Count) { return 'sum mismatch' }
+    $true
+}
+Check 'F follow deterministic' {
+    $a = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -Follow)
+    $b = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -Follow)
+    if ($a -cne $b) { return 'differs' }
+    $true
+}
+Check 'F follow maxdepth 0 equals negative' {
+    $a = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -Follow -MaxDepth 0)
+    $b = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -Follow -MaxDepth -3)
+    if ($a -cne $b) { return 'differs' }
+    $true
+}
+Check 'F follow records sorted' {
+    $paths = @($follow.Records | ForEach-Object { $_.RelativePath })
+    for ($i = 1; $i -lt $paths.Count; $i++) {
+        if ([System.StringComparer]::OrdinalIgnoreCase.Compare($paths[$i - 1], $paths[$i]) -gt 0) { return "$($paths[$i-1]) > $($paths[$i])" }
+    }
+    $true
+}
+
+# ---- acceptance 12: export surface
+Check 'E12 exported commands exactly six' {
+    $cmds = @(Get-Command -Module WReparse | ForEach-Object { $_.Name } | Sort-Object)
+    $want = @('ConvertTo-WReparseJson', 'Get-WReparseCanonicalPath', 'Get-WReparseReport', 'Get-WReparseSchemaVersion', 'Resolve-WReparseLinkTarget', 'Test-WReparseWithinRoot')
+    if (($cmds -join ',') -ne ($want -join ',')) { return ($cmds -join ',') }
+    $mod = Get-Module WReparse
+    $exp = @($mod.ExportedFunctions.Keys | Sort-Object)
+    if (($exp -join ',') -ne ($want -join ',')) { return "manifest: $($exp -join ',')" }
+    if (@($mod.ExportedAliases.Keys).Count -ne 0) { return 'aliases exported' }
+    $true
+}
+Check 'E12 internal helpers invisible' {
+    foreach ($n in @('Invoke-WReparseWalk', 'Invoke-WReparseDirectoryWalk', 'Sort-WReparseStable', 'New-WReparseRecord', 'New-WReparseReport', 'New-WReparseError', 'New-WReparseStats', 'Get-WReparseRelativePath', 'Compare-WReparsePath', 'Get-WReparseStats', 'Get-WReparseErrorCode', 'Test-WReparseIsReparsePoint', 'Get-WReparseKindFromLinkType', 'Add-WReparseError', 'ConvertTo-WReparseTargetString', 'Get-WReparseMemberValue', 'Test-WReparseIsAncestor', 'Compare-WReparseKeyList', 'Get-WReparseRecordSortKey', 'Get-WReparseErrorSortKey')) {
+        if (Get-Command -Name $n -ErrorAction SilentlyContinue) { return "$n is visible" }
+    }
+    $true
+}
+Check 'E12 parameter names' {
+    $p = (Get-Command Get-WReparseReport).Parameters
+    foreach ($n in @('Root', 'MaxDepth', 'Follow')) { if (-not $p.ContainsKey($n)) { return "missing $n" } }
+    if ($p['MaxDepth'].ParameterType -ne [int]) { return 'MaxDepth not int' }
+    if ($p['Follow'].ParameterType -ne [System.Management.Automation.SwitchParameter]) { return 'Follow not switch' }
+    $q = (Get-Command Resolve-WReparseLinkTarget).Parameters
+    foreach ($n in @('LinkFullPath', 'RawTarget')) { if (-not $q.ContainsKey($n)) { return "missing $n" } }
+    $w = (Get-Command Test-WReparseWithinRoot).Parameters
+    foreach ($n in @('Path', 'Root')) { if (-not $w.ContainsKey($n)) { return "missing $n" } }
+    $c = (Get-Command Get-WReparseCanonicalPath).Parameters
+    if (-not $c.ContainsKey('Path')) { return 'missing Path' }
+    $j = (Get-Command ConvertTo-WReparseJson).Parameters
+    if (-not $j.ContainsKey('Report')) { return 'missing Report' }
+    if ((Get-WReparseSchemaVersion) -cne 'wreparse/1.0') { return 'schema version' }
+    $true
+}
+
+Set-Location $workspace
+Write-Host ''
+if ($failed -gt 0) { Write-Host "FAILED: $failed"; exit 1 }
+Write-Host 'ALL CHECKS PASSED'
+exit 0
