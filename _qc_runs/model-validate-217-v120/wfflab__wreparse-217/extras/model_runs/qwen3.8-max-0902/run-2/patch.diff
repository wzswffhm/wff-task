+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse reference implementation.
+#
+# Only Get-WReparseReport and ConvertTo-WReparseJson belong to the public
+# surface; the sorting and statistics helpers are internal.
+
+# Ordering keys. Records are keyed by RelativePath; errors are keyed by
+# RelativePath then Code (then Message, purely to keep equal keys stable).
+function Get-WReparseRecordSortKey {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Item)
+    return [string[]]@([string](Get-WReparseMemberValue -InputObject $Item -Name 'RelativePath'))
+}
+
+function Get-WReparseErrorSortKey {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Item)
+    return [string[]]@(
+        [string](Get-WReparseMemberValue -InputObject $Item -Name 'RelativePath'),
+        [string](Get-WReparseMemberValue -InputObject $Item -Name 'Code'),
+        [string](Get-WReparseMemberValue -InputObject $Item -Name 'Message')
+    )
+}
+
+# Stable merge sort so the report never depends on the enumerator order or on
+# the host culture. Sort-Object is deliberately not used: its default string
+# comparison is culture-aware and would order non-ASCII names differently on
+# different hosts (for example it puts 'A' with a diaeresis before 'Z', while
+# the ordinal comparison required by the contract puts 'Z' first).
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][AllowEmptyCollection()][object[]]$Items,
+        [Parameter(Mandatory = $true)][scriptblock]$KeySelector
+    )
+
+    $items = @($Items)
+    $count = $items.Count
+    if ($count -eq 0) { return @() }
+    if ($count -eq 1) { return @($items[0]) }
+
+    # Decorate once: keys are computed a single time per item.
+    $keys = New-Object 'object[]' $count
+    for ($index = 0; $index -lt $count; $index++) {
+        $keys[$index] = [string[]]@(& $KeySelector $items[$index])
+    }
+
+    $source = New-Object 'int[]' $count
+    for ($index = 0; $index -lt $count; $index++) { $source[$index] = $index }
+    $buffer = New-Object 'int[]' $count
+
+    $width = 1
+    while ($width -lt $count) {
+        for ($start = 0; $start -lt $count; $start += (2 * $width)) {
+            $middle = $start + $width
+            if ($middle -gt $count) { $middle = $count }
+            $end = $start + (2 * $width)
+            if ($end -gt $count) { $end = $count }
+
+            $left = $start
+            $right = $middle
+            $write = $start
+            while (($left -lt $middle) -and ($right -lt $end)) {
+                $comparison = Compare-WReparseKeyList -Left ([string[]]$keys[$source[$left]]) -Right ([string[]]$keys[$source[$right]])
+                if ($comparison -le 0) {
+                    $buffer[$write] = $source[$left]
+                    $left++
+                }
+                else {
+                    $buffer[$write] = $source[$right]
+                    $right++
+                }
+                $write++
+            }
+            while ($left -lt $middle) { $buffer[$write] = $source[$left]; $left++; $write++ }
+            while ($right -lt $end) { $buffer[$write] = $source[$right]; $right++; $write++ }
+        }
+
+        $swap = $source
+        $source = $buffer
+        $buffer = $swap
+        $width = $width * 2
+    }
+
+    $sorted = New-Object 'object[]' $count
+    for ($index = 0; $index -lt $count; $index++) { $sorted[$index] = $items[$source[$index]] }
+    return $sorted
+}
+
+# The three category counters are mutually exclusive and mirror the records.
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][AllowEmptyCollection()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        if ($null -eq $record) { continue }
+        $kind = [string](Get-WReparseMemberValue -InputObject $record -Name 'Kind')
+        if ($kind -eq $script:WReparseKindReparse) { $reparse++ }
+        elseif ($kind -eq $script:WReparseKindDirectory) { $directories++ }
+        elseif ($kind -eq $script:WReparseKindFile) { $files++ }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+
+    $effectiveMaxDepth = [int]$MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $walk = Invoke-WReparseWalk -Root $Root -MaxDepth $effectiveMaxDepth -Follow:$Follow
+
+    $records = @(Sort-WReparseStable -Items @($walk.Records) -KeySelector { param($item) Get-WReparseRecordSortKey -Item $item })
+    $errors = @(Sort-WReparseStable -Items @($walk.Errors) -KeySelector { param($item) Get-WReparseErrorSortKey -Item $item })
+
+    $stats = Get-WReparseStats -Records $records -Skipped ([int]$walk.Skipped) -ErrorCount $errors.Count
+
+    $reportRoot = [string]$walk.Root
+    if ([string]::IsNullOrEmpty($reportRoot)) {
+        try { $reportRoot = Get-WReparseCanonicalPath -Path $Root } catch { $reportRoot = [string]$Root }
+    }
+
+    return New-WReparseReport -Root $reportRoot -Records $records -Errors $errors -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$Report
+    )
+    return (ConvertTo-Json -InputObject $Report -Depth 12)
+}
