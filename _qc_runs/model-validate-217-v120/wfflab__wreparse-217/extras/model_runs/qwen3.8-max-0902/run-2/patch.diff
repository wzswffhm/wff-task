+# WReparse - data model
+# Shared vocabulary: error codes, enumerations, and factory helpers.
+# Part of the WReparse implementation. See the contract under docs/
+#
+# Everything defined here is internal except Get-WReparseSchemaVersion; the
+# module manifest and the root module publish exactly the six contract
+# functions and nothing else.
+
+Set-StrictMode -Version Latest
+
+# Error codes are part of the public contract. Order is stable and is not
+# sorted at serialisation time; callers match on the literal string.
+$script:WReparseErrorCode = @(
+    'not_found'
+    'access_denied'
+    'cycle'
+    'broken_target'
+    'structure'
+    'too_deep'
+    'invalid_argument'
+)
+
+$script:WReparseSchemaVersion = ('wreparse' + '/1.0')
+
+# Entry kinds. A hard link is a FILE, not a reparse point: the two NTFS
+# directory entries share one data stream and neither entry carries a
+# reparse attribute. Only entries whose file attributes contain
+# FILE_ATTRIBUTE_REPARSE_POINT are reported with Kind = 'ReparsePoint'.
+$script:WReparseKindDirectory = 'Directory'
+$script:WReparseKindFile = 'File'
+$script:WReparseKindReparse = 'ReparsePoint'
+
+# Reparse kinds (contract 3.1). Junction and SymbolicLink are distinct: the
+# provider reports a different LinkType for each, so they must never be
+# collapsed onto the same value.
+$script:WReparseReparseKindSymbolicLink = 'SymbolicLink'
+$script:WReparseReparseKindJunction = 'Junction'
+$script:WReparseReparseKindMountPoint = 'MountPoint'
+$script:WReparseReparseKindUnknown = 'Unknown'
+
+# Relative path of the scan root itself inside Errors.
+$script:WReparseRootRelativePath = '.'
+
+function Get-WReparseErrorCode {
+    [CmdletBinding()]
+    param()
+    return @($script:WReparseErrorCode)
+}
+
+function Get-WReparseSchemaVersion {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseSchemaVersion
+}
+
+function New-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Message
+    )
+    if ($script:WReparseErrorCode -notcontains $Code) {
+        throw "Unknown WReparse error code: $Code"
+    }
+    $text = [string]$Message
+    if ($null -eq $Message) { $text = '' }
+    return [pscustomobject][ordered]@{
+        RelativePath = $RelativePath
+        Code         = $Code
+        Message      = $text
+    }
+}
+
+# Normalises the provider's target value into a single string (or $null).
+#
+# Get-ChildItem exposes .Target as a collection (System.String[]) because a
+# reparse point may carry several substitution names, and PowerShell unrolls a
+# single element array while forwarding it, so the observed type is not stable.
+# The contract defines Target as one target string, therefore the first element
+# is taken explicitly and converted to string.
+function ConvertTo-WReparseTargetString {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][AllowEmptyCollection()]$RawTarget
+    )
+    if ($null -eq $RawTarget) { return $null }
+
+    $first = $RawTarget
+    if (($RawTarget -isnot [string]) -and ($RawTarget -is [System.Collections.IEnumerable])) {
+        $all = @($RawTarget)
+        if ($all.Count -eq 0) { return $null }
+        $first = $all[0]
+        if ($null -eq $first) { return $null }
+    }
+
+    $text = [string]$first
+    if ($text.Length -eq 0) { return $null }
+    return $text
+}
+
+function New-WReparseRecord {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Kind,
+        [AllowNull()][AllowEmptyString()][string]$ReparseKind = $null,
+        [AllowNull()][AllowEmptyCollection()]$Target = $null,
+        [AllowNull()][AllowEmptyString()][string]$ResolvedTarget = $null,
+        [bool]$InScope = $false,
+        [int]$Depth = 0,
+        [long]$Size = 0
+    )
+
+    # Non reparse entries never carry link information, and reparse entries
+    # always carry a string target (or $null when the provider has none).
+    $reparseKindValue = $null
+    $targetValue = $null
+    $resolvedValue = $null
+    if ($Kind -eq $script:WReparseKindReparse) {
+        if (-not [string]::IsNullOrEmpty($ReparseKind)) { $reparseKindValue = [string]$ReparseKind }
+        $targetValue = ConvertTo-WReparseTargetString -RawTarget $Target
+        if (-not [string]::IsNullOrEmpty($ResolvedTarget)) { $resolvedValue = [string]$ResolvedTarget }
+    }
+
+    return [pscustomobject][ordered]@{
+        RelativePath   = [string]$RelativePath
+        Kind           = [string]$Kind
+        ReparseKind    = $reparseKindValue
+        Target         = $targetValue
+        ResolvedTarget = $resolvedValue
+        InScope        = [bool]$InScope
+        Depth          = [int]$Depth
+        Size           = [long]$Size
+    }
+}
+
+function New-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [int]$Directories = 0,
+        [int]$Files = 0,
+        [int]$ReparsePoints = 0,
+        [int]$Skipped = 0,
+        [int]$Errors = 0
+    )
+    return [pscustomobject][ordered]@{
+        Directories   = [int]$Directories
+        Files         = [int]$Files
+        ReparsePoints = [int]$ReparsePoints
+        Skipped       = [int]$Skipped
+        Errors        = [int]$Errors
+    }
+}
+
+# The report carries exactly the five contract fields (3): SchemaVersion, Root,
+# Records, Errors, Stats. No generation timestamp, no process id, no host
+# information: two runs over the same tree must serialise byte for byte the
+# same.
+function New-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][object[]]$Records,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyCollection()][object[]]$Errors,
+        [Parameter(Mandatory = $true)][AllowNull()][object]$Stats
+    )
+    $rootValue = [string]$Root
+    if ($null -eq $Root) { $rootValue = '' }
+    $statsValue = $Stats
+    if ($null -eq $Stats) { $statsValue = New-WReparseStats }
+    return [pscustomobject][ordered]@{
+        SchemaVersion = [string]$script:WReparseSchemaVersion
+        Root          = $rootValue
+        Records       = @($Records)
+        Errors        = @($Errors)
+        Stats         = $statsValue
+    }
+}
