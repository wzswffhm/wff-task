new file mode 100644
index 0000000..5189c45
--- /dev/null
+++ b/selftest.ps1
@@ -0,0 +1,658 @@
+# WReparse contract self-test (acceptance item 18).
+#
+# Builds an NTFS fixture containing: plain files, directories, junctions,
+# relative symbolic links, a hard link, non-ASCII names, an access-denied
+# subdirectory, a cycle, a dangling target, two sibling branches pointing at
+# one target, a link whose target is a file, an empty directory and a subtree
+# deeper than the default depth limit -- then asserts every documented
+# behaviour of the module's public API.
+#
+# Read-only with respect to the fixture (only the fixture itself is created
+# and removed), no network, no administrator rights and no external modules.
+#
+# Run with:
+#   powershell -NoProfile -ExecutionPolicy Bypass -File environment\workspace\selftest.ps1
+# Exit code 0 = every executed check passed.
+
+[CmdletBinding()]
+param()
+
+$ErrorActionPreference = 'Stop'
+$ProgressPreference = 'SilentlyContinue'
+
+$modulePath = Join-Path $PSScriptRoot 'WReparse\WReparse.psd1'
+
+# ---------------------------------------------------------------------------
+# tiny result harness
+# ---------------------------------------------------------------------------
+$script:PassCount = 0
+$script:FailCount = 0
+$script:SkipCount = 0
+
+function Write-TestResult {
+    param(
+        [Parameter(Mandatory = $true)][ValidateSet('PASS', 'FAIL', 'SKIP')][string]$Status,
+        [Parameter(Mandatory = $true)][string]$Label,
+        [string]$Detail = ''
+    )
+    switch ($Status) {
+        'PASS' { $script:PassCount++ }
+        'FAIL' { $script:FailCount++ }
+        'SKIP' { $script:SkipCount++ }
+    }
+    $line = '[' + $Status + '] ' + $Label
+    if ($Detail -ne '') { $line = $line + ' :: ' + $Detail }
+    Write-Host $line
+}
+
+function Test-Assert {
+    param(
+        [Parameter(Mandatory = $true)][string]$Label,
+        [Parameter(Mandatory = $true)][scriptblock]$Body
+    )
+    try {
+        $result = & $Body
+    }
+    catch {
+        Write-TestResult -Status 'FAIL' -Label $Label -Detail $_.Exception.Message
+        return
+    }
+    if ($result) { Write-TestResult -Status 'PASS' -Label $Label }
+    else { Write-TestResult -Status 'FAIL' -Label $Label -Detail 'condition evaluated to false' }
+}
+
+function Test-AssertWhen {
+    # Same as Test-Assert but reports SKIP when the fixture could not provide
+    # the precondition (symbolic links need a developer-mode or elevated host).
+    param(
+        [Parameter(Mandatory = $true)][string]$Label,
+        [Parameter(Mandatory = $true)][bool]$Condition,
+        [Parameter(Mandatory = $true)][scriptblock]$Body
+    )
+    if (-not $Condition) {
+        Write-TestResult -Status 'SKIP' -Label $Label -Detail 'symbolic links unavailable in this session'
+        return
+    }
+    Test-Assert -Label $Label -Body $Body
+}
+
+function Get-TestRecord {
+    param(
+        [Parameter(Mandatory = $true)]$Report,
+        [Parameter(Mandatory = $true)][string]$RelativePath
+    )
+    foreach ($record in @($Report.Records)) {
+        if ($record.RelativePath -ceq $RelativePath) { return $record }
+    }
+    return $null
+}
+
+function Get-TestCodes {
+    param([Parameter(Mandatory = $true)]$Report)
+    return @(@($Report.Errors) | ForEach-Object { $_.Code })
+}
+
+function Get-TestParameterAttribute {
+    param(
+        [Parameter(Mandatory = $true)]$Command,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    return @($Command.Parameters[$Name].Attributes |
+        Where-Object { $_ -is [System.Management.Automation.ParameterAttribute] })[0]
+}
+
+# Non-ASCII names built from code points so this file stays pure ASCII and the
+# fixture is independent of the host code page.
+$script:NameAe = [string][char]0x00C4   # capital A with diaeresis
+$script:NameOe = [string][char]0x00F6   # small o with diaeresis
+
+# ---------------------------------------------------------------------------
+# fixture helpers
+# ---------------------------------------------------------------------------
+$fixtureRoot = Join-Path ([System.IO.Path]::GetTempPath()) ('wreparse-selftest-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
+$scan = Join-Path $fixtureRoot 'scanroot'
+$extra = Join-Path $fixtureRoot 'scanroot-extra'
+$outside = Join-Path $fixtureRoot 'outside'
+$shared = Join-Path $fixtureRoot 'shared'
+$script:SymlinksAvailable = $false
+
+function New-TestDirectory {
+    param([Parameter(Mandatory = $true)][string]$Path)
+    if (-not (Test-Path -LiteralPath $Path)) { New-Item -ItemType Directory -Path $Path | Out-Null }
+}
+
+function New-TestFile {
+    param(
+        [Parameter(Mandatory = $true)][string]$Path,
+        [Parameter(Mandatory = $true)][string]$Content
+    )
+    Set-Content -LiteralPath $Path -Value $Content -NoNewline -Encoding Ascii
+}
+
+function New-TestSymlink {
+    # cmd's mklink stores the target string verbatim, which is how a relative
+    # substitution ends up on disk (New-Item would absolutise it).
+    param(
+        [Parameter(Mandatory = $true)][string]$LinkDirectory,
+        [Parameter(Mandatory = $true)][string]$LinkName,
+        [Parameter(Mandatory = $true)][string]$RawTarget,
+        [switch]$Directory
+    )
+    Push-Location -LiteralPath $LinkDirectory
+    try {
+        $arguments = '/c mklink'
+        if ($Directory.IsPresent) { $arguments = $arguments + ' /d' }
+        $arguments = $arguments + ' "' + $LinkName + '" "' + $RawTarget + '"'
+        $output = cmd $arguments 2>&1
+        if ($LASTEXITCODE -ne 0) { throw ("mklink failed: " + ($output -join ' ')) }
+    }
+    finally { Pop-Location }
+}
+
+function New-TestSymlinkOrFlag {
+    param(
+        [Parameter(Mandatory = $true)][string]$LinkDirectory,
+        [Parameter(Mandatory = $true)][string]$LinkName,
+        [Parameter(Mandatory = $true)][string]$RawTarget,
+        [switch]$Directory
+    )
+    try {
+        New-TestSymlink -LinkDirectory $LinkDirectory -LinkName $LinkName -RawTarget $RawTarget -Directory:$Directory.IsPresent
+        return $true
+    }
+    catch {
+        Write-Host ('NOTE symbolic links cannot be created in this session (' + $_.Exception.Message + '); symlink-only checks are skipped')
+        return $false
+    }
+}
+
+function Get-TestTreeSnapshot {
+    # Culture-free, reparse-free recursive snapshot used to prove the scan is
+    # read-only. [System.IO.Directory] never follows reparse points.
+    param([Parameter(Mandatory = $true)][string]$Root)
+    $entries = New-Object System.Collections.ArrayList
+    $stack = New-Object System.Collections.Stack
+    $stack.Push($Root)
+    while ($stack.Count -gt 0) {
+        $directory = [string]$stack.Pop()
+        $children = @()
+        try { $children = @([System.IO.Directory]::EnumerateFileSystemEntries($directory)) } catch { $children = @() }
+        foreach ($child in $children) {
+            $attributes = 0
+            try { $attributes = [int]([System.IO.File]::GetAttributes($child)) } catch { $attributes = -1 }
+            $relative = $child
+            if ($relative.Length -gt $Root.Length) { $relative = $relative.Substring($Root.Length) }
+            [void]$entries.Add(($relative + '|' + $attributes))
+            if ($attributes -ge 0) {
+                if ((($attributes -band 0x10) -ne 0) -and (($attributes -band 0x400) -eq 0)) { $stack.Push($child) }
+            }
+        }
+    }
+    return ($entries | Sort-Object)
+}
+
+function Remove-TestDenyAcl {
+    param([Parameter(Mandatory = $true)][string]$Path)
+    if (-not (Test-Path -LiteralPath $Path)) { return }
+    try {
+        $acl = Get-Acl -LiteralPath $Path
+        foreach ($rule in @($acl.Access)) {
+            if ($rule.AccessControlType -eq 'Deny') { [void]$acl.RemoveAccessRule($rule) }
+        }
+        Set-Acl -LiteralPath $Path -AclObject $acl
+    }
+    catch {
+        cmd /c ('icacls "' + $Path + '" /reset /t /c /q') | Out-Null
+    }
+}
+
+Import-Module -Name $modulePath -Force
+
+try {
+    # ---- build the fixture ------------------------------------------------
+    foreach ($directory in @($scan, $extra, $outside, $shared,
+            (Join-Path $scan 'beta'), (Join-Path $scan 'data'),
+            (Join-Path $scan 'docs\nested'), (Join-Path $scan 'emptydir'),
+            (Join-Path $scan 'nonascii'), (Join-Path $scan 'a'),
+            (Join-Path $scan 'b'), (Join-Path $scan 'relsub'),
+            (Join-Path $scan 'locked'), (Join-Path $scan 'deepchain'),
+            (Join-Path $outside 'nothing'), (Join-Path $extra 'nothing'))) {
+        New-TestDirectory -Path $directory
+    }
+
+    New-TestFile -Path (Join-Path $scan 'plain.txt') -Content 'abcd'    # 4 bytes
+    New-TestFile -Path (Join-Path $scan 'beta.txt') -Content 'beta'     # 4 bytes
+    New-TestFile -Path (Join-Path $scan 'beta\zeta.txt') -Content 'zeta!'
+    New-TestFile -Path (Join-Path $scan 'data\sample.bin') -Content 'bin'
+    New-TestFile -Path (Join-Path $scan 'docs\readme.txt') -Content 'readme'
+    New-TestFile -Path (Join-Path $scan 'docs\nested\deep.txt') -Content 'deep'
+    New-TestFile -Path (Join-Path $extra 'other.txt') -Content 'other'
+    New-TestFile -Path (Join-Path $extra 'CaseProbe.txt') -Content 'case'
+    New-TestFile -Path (Join-Path $outside 'secret.txt') -Content 'sneaky'
+    New-TestFile -Path (Join-Path $shared 'inner.txt') -Content 'inner'
+
+    foreach ($name in @('a.txt', 'B.txt', 'Z.txt', ($script:NameAe + '.txt'), ($script:NameOe + '.txt'))) {
+        New-TestFile -Path (Join-Path $scan ('nonascii\' + $name)) -Content '12345678'
+    }
+
+    # hard link: same data stream, no reparse attribute
+    New-Item -ItemType HardLink -Path (Join-Path $scan 'hardlink.txt') -Target (Join-Path $scan 'plain.txt') | Out-Null
+
+    # junctions
+    New-Item -ItemType Junction -Path (Join-Path $scan 'link-in') -Target (Join-Path $scan 'docs') | Out-Null
+    New-Item -ItemType Junction -Path (Join-Path $scan 'link-out') -Target $outside | Out-Null
+    New-Item -ItemType Junction -Path (Join-Path $scan 'link-prefix') -Target $extra | Out-Null
+    New-Item -ItemType Junction -Path (Join-Path $scan 'link-loop') -Target $scan | Out-Null
+    New-Item -ItemType Junction -Path (Join-Path $scan 'link-twin') -Target (Join-Path $scan 'docs') | Out-Null
+    New-Item -ItemType Junction -Path (Join-Path $scan 'a\l1') -Target $shared | Out-Null
+    New-Item -ItemType Junction -Path (Join-Path $scan 'b\l2') -Target $shared | Out-Null
+
+    # symbolic links with verbatim (relative) substitution strings
+    $script:SymlinksAvailable = (New-TestSymlinkOrFlag -LinkDirectory $scan -LinkName 'link-rel' -RawTarget 'docs' -Directory)
+    if ($script:SymlinksAvailable) {
+        [void](New-TestSymlinkOrFlag -LinkDirectory $scan -LinkName 'link-file' -RawTarget 'plain.txt')
+        [void](New-TestSymlinkOrFlag -LinkDirectory $scan -LinkName 'link-dangling' -RawTarget 'missing-target')
+        [void](New-TestSymlinkOrFlag -LinkDirectory (Join-Path $scan 'relsub') -LinkName 'up' -RawTarget '..\docs' -Directory)
+    }
+
+    # access-denied subdirectory (the owner keeps WRITE_DAC, so it can be undone)
+    New-TestFile -Path (Join-Path $scan 'locked\inside.txt') -Content 'nope'
+    $denyAcl = Get-Acl -LiteralPath (Join-Path $scan 'locked')
+    $denyRule = New-Object System.Security.AccessControl.FileSystemAccessRule(
+        'Everyone', 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Deny')
+    $denyAcl.AddAccessRule($denyRule) | Out-Null
+    Set-Acl -LiteralPath (Join-Path $scan 'locked') -AclObject $denyAcl
+
+    # subtree deeper than the default depth limit (40 levels below the root)
+    $deepPath = Join-Path $scan 'deepchain'
+    for ($level = 1; $level -le 40; $level++) { $deepPath = Join-Path $deepPath ('d' + $level) }
+    New-TestDirectory -Path $deepPath
+    New-TestFile -Path (Join-Path $deepPath 'leaf.txt') -Content 'leaf'
+
+    $snapshotBefore = Get-TestTreeSnapshot -Root $fixtureRoot
+
+    # ---- 12: public surface ------------------------------------------------
+    Test-Assert -Label '12: module exports exactly the six contract functions' -Body {
+        $actual = @(Get-Command -Module WReparse | ForEach-Object { $_.Name } | Sort-Object)
+        $expected = @('ConvertTo-WReparseJson', 'Get-WReparseCanonicalPath', 'Get-WReparseReport',
+            'Get-WReparseSchemaVersion', 'Resolve-WReparseLinkTarget', 'Test-WReparseWithinRoot')
+        ($actual.Count -eq 6) -and ($null -eq (Compare-Object -ReferenceObject $expected -DifferenceObject $actual))
+    }
+    Test-Assert -Label '12: internal helper functions are not visible' -Body {
+        $names = @(Get-Command -Module WReparse | ForEach-Object { $_.Name })
+        ($names -notcontains 'Invoke-WReparseWalk') -and ($names -notcontains 'New-WReparseRecord') -and
+        ($names -notcontains 'Sort-WReparseStable') -and ($names -notcontains 'Get-WReparseMemberValue')
+    }
+    Test-Assert -Label '12: Get-WReparseReport exposes Root/MaxDepth/Follow with the contract shape' -Body {
+        $command = Get-Command Get-WReparseReport
+        ($command.Parameters.ContainsKey('Root')) -and
+        ($command.Parameters.ContainsKey('MaxDepth')) -and
+        ($command.Parameters.ContainsKey('Follow')) -and
+        (Get-TestParameterAttribute -Command $command -Name 'Root').Mandatory -and
+        (-not (Get-TestParameterAttribute -Command $command -Name 'MaxDepth').Mandatory) -and
+        ($command.Parameters['MaxDepth'].ParameterType -eq [int]) -and
+        ($command.Parameters['Follow'].ParameterType -eq [System.Management.Automation.SwitchParameter])
+    }
+
+    # ---- 13: report data model --------------------------------------------
+    $plainReport = Get-WReparseReport -Root $scan
+    Test-Assert -Label '13: report fields are exactly SchemaVersion/Root/Records/Errors/Stats in order' -Body {
+        ((@($plainReport.PSObject.Properties.Name) -join ',') -ceq 'SchemaVersion,Root,Records,Errors,Stats')
+    }
+    Test-Assert -Label '13: record fields are exactly the eight contract fields in order' -Body {
+        $first = @($plainReport.Records)[0]
+        ((@($first.PSObject.Properties.Name) -join ',') -ceq 'RelativePath,Kind,ReparseKind,Target,ResolvedTarget,InScope,Depth,Size')
+    }
+    Test-Assert -Label '13: error entries carry exactly RelativePath/Code/Message' -Body {
+        if (@($plainReport.Errors).Count -lt 1) { return $false }
+        foreach ($errorEntry in @($plainReport.Errors)) {
+            if ((@($errorEntry.PSObject.Properties.Name) -join ',') -cne 'RelativePath,Code,Message') { return $false }
+        }
+        return $true
+    }
+    Test-Assert -Label '13: stats fields are exactly the five contract fields' -Body {
+        ((@($plainReport.Stats.PSObject.Properties.Name) -join ',') -ceq 'Directories,Files,ReparsePoints,Skipped,Errors')
+    }
+    Test-Assert -Label 'schema version is wreparse/1.0' -Body { (Get-WReparseSchemaVersion) -ceq 'wreparse/1.0' }
+    Test-Assert -Label 'schema: the default MaxDepth is 32' -Body {
+        $deepest = 0
+        foreach ($record in @($plainReport.Records)) { if ($record.Depth -gt $deepest) { $deepest = $record.Depth } }
+        ($deepest -eq 32) -and (@($plainReport.Errors | Where-Object { $_.Code -ceq 'too_deep' }).Count -gt 0)
+    }
+
+    # ---- 1: registration without traversal ---------------------------------
+    $allLinks = @('link-in', 'link-out', 'link-prefix', 'link-loop', 'link-twin', 'a\l1', 'b\l2')
+    if ($script:SymlinksAvailable) { $allLinks = $allLinks + @('link-rel', 'link-file', 'link-dangling', 'relsub\up') }
+    Test-Assert -Label '1: every reparse point is registered without -Follow' -Body {
+        foreach ($link in $allLinks) {
+            $record = Get-TestRecord -Report $plainReport -RelativePath $link
+            if ($null -eq $record) { return $false }
+            if ($record.Kind -cne 'ReparsePoint') { return $false }
+        }
+        return ($plainReport.Stats.ReparsePoints -ge $allLinks.Count)
+    }
+    Test-Assert -Label '1: no reparse point is entered without -Follow' -Body {
+        foreach ($link in $allLinks) {
+            $prefix = $link + '\'
+            foreach ($record in @($plainReport.Records)) {
+                if ($record.RelativePath.StartsWith($prefix, [System.StringComparison]::Ordinal)) { return $false }
+            }
+        }
+        return $true
+    }
+    Test-Assert -Label '1: Stats.Skipped equals the reparse point count without -Follow' -Body {
+        ($plainReport.Stats.Skipped -eq $plainReport.Stats.ReparsePoints) -and ($plainReport.Stats.Skipped -gt 0)
+    }
+    Test-Assert -Label '1: entries outside the scan root never appear (no escape)' -Body {
+        foreach ($record in @($plainReport.Records)) {
+            if ($record.RelativePath -ceq 'other.txt') { return $false }
+            if ($record.RelativePath -ceq 'secret.txt') { return $false }
+            if ($record.RelativePath -ceq 'CaseProbe.txt') { return $false }
+        }
+        return $true
+    }
+
+    # ---- 2 + 16: InScope semantics ----------------------------------------
+    Test-Assert -Label '2: link to an in-root directory reports InScope=true' -Body {
+        (Get-TestRecord -Report $plainReport -RelativePath 'link-in').InScope -eq $true
+    }
+    Test-Assert -Label '2: link to a mere name-prefix sibling reports InScope=false' -Body {
+        (Get-TestRecord -Report $plainReport -RelativePath 'link-prefix').InScope -eq $false
+    }
+    Test-Assert -Label '2: link outside the scan root reports InScope=false' -Body {
+        (Get-TestRecord -Report $plainReport -RelativePath 'link-out').InScope -eq $false
+    }
+    Test-Assert -Label '2: Test-WReparseWithinRoot honours the directory boundary' -Body {
+        (Test-WReparseWithinRoot -Path (Join-Path $scan 'docs') -Root $scan) -and
+        (Test-WReparseWithinRoot -Path $scan -Root $scan) -and
+        (-not (Test-WReparseWithinRoot -Path $extra -Root $scan))
+    }
+    Test-Assert -Label '16: plain files and directories always report InScope=false' -Body {
+        foreach ($record in @($plainReport.Records)) {
+            if ($record.Kind -cne 'ReparsePoint' -and $record.InScope) { return $false }
+        }
+        return ((Get-TestRecord -Report $plainReport -RelativePath 'plain.txt').InScope -eq $false) -and
+               ((Get-TestRecord -Report $plainReport -RelativePath 'beta').InScope -eq $false)
+    }
+
+    # ---- 3: relative resolution is CWD independent --------------------------
+    Test-AssertWhen -Condition $script:SymlinksAvailable `
+        -Label '3: relative target resolves against the link directory, not the CWD' -Body {
+        $linkRel = Join-Path $scan 'link-rel'
+        $linkUp = Join-Path $scan 'relsub\up'
+        $originalLocation = Get-Location
+        $originalCurrent = [Environment]::CurrentDirectory
+        try {
+            Set-Location -LiteralPath ([System.IO.Path]::GetTempPath())
+            [Environment]::CurrentDirectory = [System.IO.Path]::GetTempPath()
+            $fromTemp = Resolve-WReparseLinkTarget -LinkFullPath $linkRel -RawTarget 'docs'
+            $fromTempUp = Resolve-WReparseLinkTarget -LinkFullPath $linkUp -RawTarget '..\docs'
+            Set-Location -LiteralPath $shared
+            [Environment]::CurrentDirectory = $shared
+            $fromShared = Resolve-WReparseLinkTarget -LinkFullPath $linkRel -RawTarget 'docs'
+        }
+        finally {
+            Set-Location $originalLocation
+            [Environment]::CurrentDirectory = $originalCurrent
+        }
+        ($fromTemp -ceq (Join-Path $scan 'docs')) -and
+        ($fromShared -ceq (Join-Path $scan 'docs')) -and
+        ($fromTempUp -ceq (Join-Path $scan 'docs'))
+    }
+    Test-AssertWhen -Condition $script:SymlinksAvailable `
+        -Label '3: record ResolvedTarget for a relative link matches the link directory' -Body {
+        ((Get-TestRecord -Report $plainReport -RelativePath 'link-rel').ResolvedTarget -ceq (Join-Path $scan 'docs')) -and
+        ((Get-TestRecord -Report $plainReport -RelativePath 'relsub\up').ResolvedTarget -ceq (Join-Path $scan 'docs'))
+    }
+
+    # ---- 4 + 15 + 17: determinism, silent errors, types ---------------------
+    Test-Assert -Label '4: two consecutive scans serialise byte-identically' -Body {
+        $first = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $scan)
+        $second = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $scan)
+        ($first -ceq $second) -and ($first.Length -gt 0)
+    }
+    Test-Assert -Label '4: serialised report contains no timestamp or process artefact' -Body {
+        $json = ConvertTo-WReparseJson -Report $plainReport
+        ($json -notmatch 'GeneratedAt') -and ($json -notmatch 'Timestamp') -and
+        ($json -notmatch (Get-Date -Format 'yyyy')) -and ($json -notmatch ('\b' + $PID + '\b'))
+    }
+    Test-Assert -Label '15: without -Follow no cycle or broken_target errors are reported' -Body {
+        $codes = Get-TestCodes -Report $plainReport
+        ($codes -notcontains 'cycle') -and ($codes -notcontains 'broken_target')
+    }
+    Test-Assert -Label '17: every reparse point Target is a string' -Body {
+        foreach ($record in @($plainReport.Records)) {
+            if ($record.Kind -ceq 'ReparsePoint') {
+                if ($null -eq $record.Target) { return $false }
+                if (-not ($record.Target -is [string])) { return $false }
+            }
+        }
+        return $true
+    }
+    Test-Assert -Label 'canonicalisation preserves case and drops trailing separators' -Body {
+        $probe = Join-Path $extra 'CaseProbe.txt'
+        $upper = Join-Path $extra 'CASEPROBE.TXT'
+        ((Get-WReparseCanonicalPath -Path ($scan + '\')) -ceq (Get-WReparseCanonicalPath -Path $scan)) -and
+        ((Get-WReparseCanonicalPath -Path $upper) -ceq $upper) -and
+        ((Get-WReparseCanonicalPath -Path ($upper + '\')) -ceq $upper) -and
+        ((Get-WReparseCanonicalPath -Path $probe) -ceq $probe)
+    }
+
+    # ---- 5: classification -------------------------------------------------
+    Test-Assert -Label '5: hard link is a File, not a reparse point' -Body {
+        $record = Get-TestRecord -Report $plainReport -RelativePath 'hardlink.txt'
+        ($record.Kind -ceq 'File') -and ($null -eq $record.ReparseKind) -and ($record.Size -eq 4)
+    }
+    Test-Assert -Label '5: junction is registered as Junction' -Body {
+        ((Get-TestRecord -Report $plainReport -RelativePath 'link-in').ReparseKind -ceq 'Junction') -and
+        ((Get-TestRecord -Report $plainReport -RelativePath 'a\l1').ReparseKind -ceq 'Junction')
+    }
+    Test-AssertWhen -Condition $script:SymlinksAvailable `
+        -Label '5: symbolic link is registered as SymbolicLink and stays distinguishable' -Body {
+        $link = Get-TestRecord -Report $plainReport -RelativePath 'link-rel'
+        ($link.ReparseKind -ceq 'SymbolicLink') -and
+        ($link.ReparseKind -cne (Get-TestRecord -Report $plainReport -RelativePath 'link-in').ReparseKind)
+    }
+    Test-Assert -Label '5: sizes and depths of plain entries are reported' -Body {
+        ((Get-TestRecord -Report $plainReport -RelativePath 'plain.txt').Size -eq 4) -and
+        ((Get-TestRecord -Report $plainReport -RelativePath 'beta').Depth -eq 1) -and
+        ((Get-TestRecord -Report $plainReport -RelativePath 'beta\zeta.txt').Depth -eq 2) -and
+        ((Get-TestRecord -Report $plainReport -RelativePath 'link-in').Depth -eq 1)
+    }
+
+    # ---- 6: root error codes ----------------------------------------------
+    $notFoundReport = Get-WReparseReport -Root (Join-Path $fixtureRoot 'does-not-exist')
+    $structureReport = Get-WReparseReport -Root (Join-Path $scan 'plain.txt')
+    $invalidReport = Get-WReparseReport -Root ('C:\bad<path')
+    Test-Assert -Label '6: missing root reports not_found against "."' -Body {
+        (@($notFoundReport.Errors).Count -eq 1) -and ($notFoundReport.Errors[0].Code -ceq 'not_found') -and
+        ($notFoundReport.Errors[0].RelativePath -ceq '.') -and (@($notFoundReport.Records).Count -eq 0)
+    }
+    Test-Assert -Label '6: file root reports structure' -Body {
+        (@($structureReport.Errors).Count -eq 1) -and ($structureReport.Errors[0].Code -ceq 'structure') -and
+        ($structureReport.Errors[0].RelativePath -ceq '.')
+    }
+    Test-Assert -Label '6: uncanonicalisable root reports invalid_argument' -Body {
+        (@($invalidReport.Errors).Count -eq 1) -and ($invalidReport.Errors[0].Code -ceq 'invalid_argument') -and
+        ($invalidReport.Errors[0].RelativePath -ceq '.')
+    }
+    Test-Assert -Label '6: the three root failures produce three distinct codes' -Body {
+        $codes = @($notFoundReport.Errors[0].Code, $structureReport.Errors[0].Code, $invalidReport.Errors[0].Code)
+        (@($codes | Select-Object -Unique).Count -eq 3)
+    }
+
+    # ---- 7: MaxDepth -------------------------------------------------------
+    Test-Assert -Label '7: -MaxDepth -1 is byte-identical to -MaxDepth 0' -Body {
+        $zero = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $scan -MaxDepth 0)
+        $negative = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $scan -MaxDepth -1)
+        ($zero -ceq $negative) -and ($zero -match 'too_deep')
+    }
+    Test-Assert -Label '7: -MaxDepth 0 records nothing and blames the root' -Body {
+        $report = Get-WReparseReport -Root $scan -MaxDepth 0
+        (@($report.Records).Count -eq 0) -and (@($report.Errors).Count -eq 1) -and
+        ($report.Errors[0].RelativePath -ceq '.') -and ($report.Errors[0].Code -ceq 'too_deep') -and
+        ($report.Stats.Errors -eq 1)
+    }
+    Test-Assert -Label '7: -MaxDepth 1 records depth-1 entries and blames their directories' -Body {
+        $report = Get-WReparseReport -Root $scan -MaxDepth 1
+        (@($report.Records | Where-Object { $_.Depth -gt 1 }).Count -eq 0) -and
+        (@($report.Errors | Where-Object { $_.Code -ceq 'too_deep' }).Count -gt 0) -and
+        ($null -ne (Get-TestRecord -Report $report -RelativePath 'plain.txt'))
+    }
+
+    # ---- deep subtree vs. the default limit --------------------------------
+    Test-Assert -Label 'deep: default limit truncates a 40-level subtree with too_deep' -Body {
+        $tooDeep = @($plainReport.Errors | Where-Object { $_.Code -ceq 'too_deep' })
+        $deepest = 0
+        foreach ($record in @($plainReport.Records)) { if ($record.Depth -gt $deepest) { $deepest = $record.Depth } }
+        ($tooDeep.Count -gt 0) -and ($deepest -eq 32) -and
+        (@($plainReport.Records | Where-Object { $_.RelativePath -clike 'deepchain\d40*' }).Count -eq 0)
+    }
+
+    # ---- access denied ------------------------------------------------------
+    Test-Assert -Label 'denied: an inaccessible subdirectory reports access_denied, the rest still scans' -Body {
+        $denied = @($plainReport.Errors | Where-Object { $_.Code -ceq 'access_denied' })
+        ($denied.Count -eq 1) -and ($denied[0].RelativePath -ceq 'locked') -and
+        ($null -ne (Get-TestRecord -Report $plainReport -RelativePath 'locked')) -and
+        ($null -ne (Get-TestRecord -Report $plainReport -RelativePath 'plain.txt'))
+    }
+
+    # ---- 11: empty tree -----------------------------------------------------
+    Test-Assert -Label '11: an empty directory tree yields empty Records and Errors' -Body {
+        $report = Get-WReparseReport -Root (Join-Path $scan 'emptydir')
+        (@($report.Records).Count -eq 0) -and (@($report.Errors).Count -eq 0) -and
+        ($report.Stats.Directories -eq 0) -and ($report.Stats.Files -eq 0) -and ($report.Stats.Errors -eq 0)
+    }
+    Test-Assert -Label '11: empty tree serialises Records and Errors as []' -Body {
+        $json = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root (Join-Path $scan 'emptydir'))
+        ($json -match '"Records":\s*\[[\s\r\n]*\]') -and ($json -match '"Errors":\s*\[[\s\r\n]*\]')
+    }
+
+    # ---- 14: culture independent ordering -----------------------------------
+    Test-Assert -Label '14: non-ASCII names sort in the observed ordinal order' -Body {
+        $expected = @('a.txt', 'B.txt', 'Z.txt', ($script:NameAe + '.txt'), ($script:NameOe + '.txt'))
+        $actual = @(@($plainReport.Records) | Where-Object { $_.RelativePath -clike 'nonascii\*' } |
+            ForEach-Object { $_.RelativePath.Substring('nonascii\'.Length) })
+        ($actual.Count -eq 5) -and ($null -eq (Compare-Object -ReferenceObject $expected -DifferenceObject $actual -CaseSensitive))
+    }
+    Test-Assert -Label '14: Records ordering follows the ordinal path order' -Body {
+        $expected = @('beta', 'beta.txt', 'beta\zeta.txt', 'data', 'data\sample.bin', 'docs', 'docs\nested', 'docs\nested\deep.txt')
+        foreach ($path in $expected) {
+            if ($null -eq (Get-TestRecord -Report $plainReport -RelativePath $path)) { return $false }
+        }
+        $ordered = @(@($plainReport.Records) | ForEach-Object { $_.RelativePath })
+        $indices = @()
+        foreach ($path in $expected) { $indices += [array]::IndexOf($ordered, $path) }
+        for ($i = 1; $i -lt $indices.Count; $i++) { if ($indices[$i] -le $indices[$i - 1]) { return $false } }
+        return $true
+    }
+
+    # ---- 8/9/10 plus -Follow error semantics ---------------------------------
+    $followReport = Get-WReparseReport -Root $scan -Follow
+    Test-Assert -Label '8: entries reached through a link are named after the link' -Body {
+        ($null -ne (Get-TestRecord -Report $followReport -RelativePath 'link-in\readme.txt')) -and
+        ($null -ne (Get-TestRecord -Report $followReport -RelativePath 'link-in\nested\deep.txt')) -and
+        ($null -ne (Get-TestRecord -Report $followReport -RelativePath 'link-rel\readme.txt')) -and
+        ($null -ne (Get-TestRecord -Report $followReport -RelativePath 'link-twin\nested\deep.txt')) -and
+        ($null -ne (Get-TestRecord -Report $followReport -RelativePath 'link-out\secret.txt')) -and
+        ($null -ne (Get-TestRecord -Report $followReport -RelativePath 'link-prefix\other.txt'))
+    }
+    Test-Assert -Label '8: no entry is named after the real target of a link' -Body {
+        foreach ($record in @($followReport.Records)) {
+            if ($record.RelativePath -ceq 'secret.txt') { return $false }
+            if ($record.RelativePath -ceq 'other.txt') { return $false }
+            if ($record.RelativePath -ceq 'nothing\CaseProbe.txt') { return $false }
+        }
+        return $true
+    }
+    Test-Assert -Label '8: link children sit one level below the link' -Body {
+        ((Get-TestRecord -Report $followReport -RelativePath 'link-in\readme.txt').Depth -eq 2) -and
+        ((Get-TestRecord -Report $followReport -RelativePath 'link-in\nested\deep.txt').Depth -eq 3)
+    }
+    Test-AssertWhen -Condition $script:SymlinksAvailable `
+        -Label '9: a link whose target is a file contributes no children' -Body {
+        $record = Get-TestRecord -Report $followReport -RelativePath 'link-file'
+        ($null -ne $record) -and ($record.Kind -ceq 'ReparsePoint') -and
+        (@($followReport.Records | Where-Object { $_.RelativePath -clike 'link-file\*' }).Count -eq 0)
+    }
+    Test-Assert -Label '10: sibling branches pointing at one target are both entered' -Body {
+        ($null -ne (Get-TestRecord -Report $followReport -RelativePath 'a\l1\inner.txt')) -and
+        ($null -ne (Get-TestRecord -Report $followReport -RelativePath 'b\l2\inner.txt'))
+    }
+    Test-Assert -Label '10: sibling branches pointing at one target are not reported as cycles' -Body {
+        foreach ($cycle in @($followReport.Errors | Where-Object { $_.Code -ceq 'cycle' })) {
+            if ($cycle.RelativePath -clike 'a\l1*') { return $false }
+            if ($cycle.RelativePath -clike 'b\l2*') { return $false }
+        }
+        return $true
+    }
+    Test-Assert -Label 'follow: the ancestor loop is reported exactly once as cycle' -Body {
+        $cycles = @($followReport.Errors | Where-Object { $_.Code -ceq 'cycle' })
+        ($cycles.Count -eq 1) -and ($cycles[0].RelativePath -ceq 'link-loop') -and
+        (@($followReport.Records | Where-Object { $_.RelativePath -clike 'link-loop\*' }).Count -eq 0)
+    }
+    Test-AssertWhen -Condition $script:SymlinksAvailable `
+        -Label 'follow: the dangling link is reported as broken_target without children' -Body {
+        $broken = @($followReport.Errors | Where-Object { $_.Code -ceq 'broken_target' })
+        ($broken.Count -eq 1) -and ($broken[0].RelativePath -ceq 'link-dangling') -and
+        (@($followReport.Records | Where-Object { $_.RelativePath -clike 'link-dangling\*' }).Count -eq 0)
+    }
+    Test-Assert -Label 'follow: Stats.Skipped is zero once links are followed' -Body {
+        ($followReport.Stats.Skipped -eq 0) -and ($followReport.Stats.ReparsePoints -eq $plainReport.Stats.ReparsePoints)
+    }
+    Test-Assert -Label 'stats: kinds are counted in their own buckets' -Body {
+        ($followReport.Stats.ReparsePoints -eq @($followReport.Records | Where-Object { $_.Kind -ceq 'ReparsePoint' }).Count) -and
+        ($followReport.Stats.Directories -eq @($followReport.Records | Where-Object { $_.Kind -ceq 'Directory' }).Count) -and
+        ($followReport.Stats.Files -eq @($followReport.Records | Where-Object { $_.Kind -ceq 'File' }).Count) -and
+        ($plainReport.Stats.Directories -eq @($plainReport.Records | Where-Object { $_.Kind -ceq 'Directory' }).Count)
+    }
+
+    # ---- culture invariance across processes --------------------------------
+    $cultureOk = $true
+    $cultureDetail = ''
+    try {
+        $referenceJson = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root (Join-Path $scan 'nonascii'))
+        $hasher = [System.Security.Cryptography.SHA256]::Create()
+        $referenceHash = [BitConverter]::ToString($hasher.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($referenceJson))) -replace '-', ''
+        $psExe = (Get-Process -Id $PID).Path
+        foreach ($cultureName in @('en-US', 'de-DE', 'ja-JP')) {
+            $childScript = "`$ErrorActionPreference = 'Stop'; "
+            $childScript += "[Threading.Thread]::CurrentThread.CurrentCulture = [Globalization.CultureInfo]::GetCultureInfo('$cultureName'); "
+            $childScript += "[Threading.Thread]::CurrentThread.CurrentUICulture = [Globalization.CultureInfo]::GetCultureInfo('$cultureName'); "
+            $childScript += "Import-Module -Name '$modulePath' -Force; "
+            $childScript += "`$scanReport = Get-WReparseReport -Root '" + (Join-Path $scan 'nonascii') + "'; "
+            $childScript += "`$scanJson = ConvertTo-WReparseJson -Report `$scanReport; "
+            $childScript += "`$childHasher = [Security.Cryptography.SHA256]::Create(); "
+            $childScript += "([BitConverter]::ToString(`$childHasher.ComputeHash([Text.Encoding]::UTF8.GetBytes(`$scanJson))) -replace '-','')"
+            $childHash = (& $psExe -NoProfile -ExecutionPolicy Bypass -Command $childScript | Select-Object -Last 1)
+            if ("$childHash" -cne $referenceHash) {
+                $cultureOk = $false
+                $cultureDetail = "culture $cultureName produced a different digest ($childHash vs $referenceHash)"
+                break
+            }
+        }
+    }
+    catch {
+        $cultureOk = $false
+        $cultureDetail = $_.Exception.Message
+    }
+    if ($cultureOk) { Write-TestResult -Status 'PASS' -Label '14: report digest is identical under en-US/de-DE/ja-JP' }
+    else { Write-TestResult -Status 'FAIL' -Label '14: report digest is identical under en-US/de-DE/ja-JP' -Detail $cultureDetail }
+
+    # ---- read-only -----------------------------------------------------------
+    Test-Assert -Label 'readonly: the scans left the tree untouched' -Body {
+        $snapshotAfter = Get-TestTreeSnapshot -Root $fixtureRoot
+        ($null -eq (Compare-Object -ReferenceObject $snapshotBefore -DifferenceObject $snapshotAfter))
+    }
+}
+finally {
+    Remove-TestDenyAcl -Path (Join-Path $scan 'locked')
+    if (Test-Path -LiteralPath $fixtureRoot) {
+        Remove-Item -LiteralPath $fixtureRoot -Recurse -Force -ErrorAction SilentlyContinue
+    }
+}
+
+Write-Host ''
+Write-Host ('selftest: ' + $script:PassCount + ' passed, ' + $script:FailCount + ' failed, ' + $script:SkipCount + ' skipped')
+if ($script:FailCount -gt 0) { exit 1 }
+exit 0
