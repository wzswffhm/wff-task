+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation. See the contract under docs/
+#
+# Canonical form used for every comparison and for the report:
+#   * full (rooted) path with '.' and '..' collapsed
+#   * no trailing directory separator, except for a volume root ('C:\')
+#     or a UNC share root
+#   * original casing preserved (the observed samples keep 'PLAIN.TXT' as-is)
+#
+# Windows path comparison is case-insensitive, so containment and equality
+# checks use ordinal-ignore-case. Ordering keys use ordinal-ignore-case with an
+# ordinal tie-break -- never a culture-aware comparison.
+
+function Get-WReparseCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Path
+    )
+    if ([string]::IsNullOrWhiteSpace([string]$Path)) {
+        throw (New-Object System.ArgumentException('The path is null, empty or consists of whitespace only.', 'Path'))
+    }
+    $full = $null
+    try {
+        $full = [System.IO.Path]::GetFullPath($Path)
+    }
+    catch {
+        throw (New-Object System.ArgumentException("The path cannot be canonicalised: '$Path'", 'Path'))
+    }
+    if ([string]::IsNullOrEmpty($full)) {
+        throw (New-Object System.ArgumentException("The path cannot be canonicalised: '$Path'", 'Path'))
+    }
+
+    # Drive-letter paths: strip trailing separators but keep the volume root.
+    if ($full.Length -ge 2 -and $full[1] -eq ':') {
+        $trimmed = $full.TrimEnd([char]'\', [char]'/')
+        if ($trimmed.Length -le 2) { return ($trimmed.Substring(0, 2) + '\') }
+        return $trimmed
+    }
+
+    # Device / Win32 namespace prefixes are not part of the user-visible form.
+    if ($full.StartsWith('\\?\UNC\')) { $full = ('\' + $full.Substring(8)) }
+    elseif ($full.StartsWith('\\?\')) { $full = $full.Substring(4) }
+
+    if ($full.StartsWith('\\')) {
+        $trimmed = $full.TrimEnd([char]'\', [char]'/')
+        if ($trimmed.Length -le 2) { return ($trimmed + '\') }
+        return $trimmed
+    }
+
+    return $full.TrimEnd([char]'\', [char]'/')
+}
+
+# Directory-boundary aware containment. 'C:\root-extra' is NOT inside
+# 'C:\root' even though it shares the whole name prefix: the candidate must be
+# the root itself or live underneath a separator boundary.
+function Test-WReparseWithinRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root
+    )
+    if ([string]::IsNullOrWhiteSpace([string]$Path) -or [string]::IsNullOrWhiteSpace([string]$Root)) {
+        return $false
+    }
+    $candidate = $null
+    $base = $null
+    try {
+        $candidate = Get-WReparseCanonicalPath -Path $Path
+        $base = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        return $false
+    }
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($candidate, $base)) { return $true }
+    $prefix = $base
+    if (-not $prefix.EndsWith('\')) { $prefix = $prefix + '\' }
+    return $candidate.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
+}
+
+# Relative path of a scanned entry with respect to the scan root, using the
+# Windows separator. The root itself yields '.'. The returned string keeps the
+# spelling of the virtual path (link-relative naming), never the real target.
+function Get-WReparseRelativePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$FullPath,
+        [Parameter(Mandatory = $true)][string]$Root
+    )
+    $candidate = Get-WReparseCanonicalPath -Path $FullPath
+    $base = Get-WReparseCanonicalPath -Path $Root
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($candidate, $base)) { return '.' }
+    $prefix = $base
+    if (-not $prefix.EndsWith('\')) { $prefix = $prefix + '\' }
+    if ($candidate.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $candidate.Substring($prefix.Length)
+    }
+    return $candidate
+}
+
+# The reparse target stored on disk may be relative. A relative target is
+# resolved against the directory that CONTAINS the link -- never against the
+# process working directory and never against the scan root. The result is
+# independent of the caller's location.
+function Resolve-WReparseLinkTarget {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$LinkFullPath,
+        [AllowNull()][AllowEmptyString()][string]$RawTarget
+    )
+    if ([string]::IsNullOrWhiteSpace([string]$RawTarget)) { return $null }
+    $candidate = $RawTarget.Trim()
+    if ([string]::IsNullOrEmpty($candidate)) { return $null }
+
+    # NTFS substitution strings sometimes carry Win32Object namespace markers.
+    if ($candidate.StartsWith('\\?\UNC\')) { $candidate = ('\' + $candidate.Substring(8)) }
+    elseif ($candidate.StartsWith('\\?\')) { $candidate = $candidate.Substring(4) }
+    elseif ($candidate.StartsWith('\??\')) { $candidate = $candidate.Substring(4) }
+    if ([string]::IsNullOrEmpty($candidate)) { return $null }
+
+    if (-not [System.IO.Path]::IsPathRooted($candidate)) {
+        $linkDirectory = [System.IO.Path]::GetDirectoryName($LinkFullPath)
+        if ([string]::IsNullOrEmpty($linkDirectory)) {
+            # The link sits on a volume root; anchor there.
+            $candidate = ($LinkFullPath.TrimEnd('\') + '\' + $candidate)
+        }
+        else {
+            $candidate = [System.IO.Path]::Combine($linkDirectory, $candidate)
+        }
+    }
+    try {
+        return Get-WReparseCanonicalPath -Path $candidate
+    }
+    catch {
+        return $null
+    }
+}
+
+# Stable ordering key: ordinal, case-insensitive first, with a case-sensitive
+# (ordinal) tie-break so that two entries whose names differ only by case keep
+# a deterministic position regardless of the host culture.
+function Compare-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$Left,
+        [Parameter(Mandatory = $true)][string]$Right
+    )
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($Left, $Right)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($Left, $Right)
+}
