+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse implementation.
+#
+# Read-only: nothing here creates, modifies or deletes a scanned entry. The
+# walker never follows a reparse point unless -Follow was given; without it a
+# reparse point is only registered (and counted in Stats.Skipped).
+
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    if ($null -eq $InputObject.PSObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
+# Maps the provider link type to the contract vocabulary. Only entries whose
+# file attributes carry FILE_ATTRIBUTE_REPARSE_POINT reach this function, so a
+# hard link (LinkType 'HardLink' but no reparse attribute) is never mapped.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([AllowNull()][AllowEmptyString()][string]$LinkType)
+    if ([string]::IsNullOrWhiteSpace([string]$LinkType)) { return 'Unknown' }
+    switch ($LinkType) {
+        'SymbolicLink' { return 'SymbolicLink' }
+        'Junction'     { return 'Junction' }
+        'MountPoint'   { return 'MountPoint' }
+        default        { return 'Unknown' }
+    }
+}
+
+# A reparse point is an entry whose file attributes carry
+# FILE_ATTRIBUTE_REPARSE_POINT (0x400). The provider's LinkType alone is NOT a
+# discriminator: a hard link reports LinkType 'HardLink' without the attribute
+# bit, and must therefore be treated as a plain file.
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)]$Item)
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return $false }
+    return ((([int]$attributes) -band 0x400) -ne 0)
+}
+
+# The provider exposes .Target as a collection and PowerShell unrolls a
+# one-element array when it travels through a function boundary, so the value
+# arriving here may be a scalar string or an array. Normalise to the first
+# substitution as a single string.
+function Get-WReparseRawTarget {
+    [CmdletBinding()]
+    param($TargetValue)
+    if ($null -eq $TargetValue) { return $null }
+    $values = @($TargetValue)
+    if ($values.Count -lt 1) { return $null }
+    if ($null -eq $values[0]) { return $null }
+    $first = [string]$values[0]
+    if ([string]::IsNullOrEmpty($first)) { return $null }
+    return $first
+}
+
+function Test-WReparseAncestryContains {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path
+    )
+    if ([string]::IsNullOrEmpty($Path)) { return $false }
+    foreach ($entry in $Ancestry) {
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals($entry, $Path)) { return $true }
+    }
+    return $false
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+function Invoke-WReparseDirectoryWalk {
+    # RealDirectory  : the physical directory to enumerate (the resolved target
+    #                  when the parent descended through a link).
+    # VirtualDirectory : the reported path; children reached through a link are
+    #                  named after the LINK, not after the real target.
+    # Ancestry       : canonical real directories on the current branch; used to
+    #                  distinguish an ancestor loop from two sibling branches
+    #                  that merely point at the same target.
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][string]$VirtualDirectory,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+    if ($Depth -ge $State.MaxDepth) {
+        Add-WReparseError -State $State `
+            -RelativePath (Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root) `
+            -Code 'too_deep' `
+            -Message "Depth limit of $($State.MaxDepth) reached; not enumerating."
+        return
+    }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch [System.UnauthorizedAccessException] {
+        Add-WReparseError -State $State `
+            -RelativePath (Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root) `
+            -Code 'access_denied' `
+            -Message 'Access denied while enumerating the directory.'
+        return
+    }
+    catch {
+        Add-WReparseError -State $State `
+            -RelativePath (Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root) `
+            -Code 'access_denied' `
+            -Message 'Access denied while enumerating the directory.'
+        return
+    }
+
+    foreach ($child in $children) {
+        $childDepth = $Depth + 1
+        $childName = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        if ([string]::IsNullOrEmpty($childName)) {
+            $childName = [string](Split-Path -Leaf ([string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')))
+        }
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        $virtualChild = Join-Path -Path $VirtualDirectory -ChildPath $childName
+        $relative = Get-WReparseRelativePath -FullPath $virtualChild -Root $State.Root
+
+        $isContainer = $false
+        $containerValue = Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer'
+        if ($null -ne $containerValue) { $isContainer = [bool]$containerValue }
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = Get-WReparseRawTarget -TargetValue (Get-WReparseMemberValue -InputObject $child -Name 'Target')
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+            $inScope = $false
+            if ($null -ne $resolved) {
+                $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+            }
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind 'ReparsePoint' `
+                -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                -Depth $childDepth -Size 0))
+
+            if (-not $State.Follow) {
+                # Registered but never entered: no target is probed and no
+                # cycle / broken_target error is ever raised in this mode.
+                $State.Skipped++
+                continue
+            }
+
+            if ($null -eq $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+            $targetExists = $false
+            try { $targetExists = [bool](Test-Path -LiteralPath $resolved -ErrorAction SilentlyContinue) } catch { $targetExists = $false }
+            if (-not $targetExists) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+            if (Test-WReparseAncestryContains -Ancestry $Ancestry -Path $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                    -Message 'The reparse target is an ancestor already visited on this branch.'
+                continue
+            }
+            $targetIsContainer = $false
+            try { $targetIsContainer = [bool](Test-Path -LiteralPath $resolved -PathType Container -ErrorAction SilentlyContinue) } catch { $targetIsContainer = $false }
+            if ($targetIsContainer) {
+                Invoke-WReparseDirectoryWalk -RealDirectory $resolved -VirtualDirectory $virtualChild `
+                    -Depth $childDepth -Ancestry ($Ancestry + $resolved) -State $State
+            }
+            # A link whose target is a file contributes no child records.
+            continue
+        }
+
+        $size = 0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) { $size = [long]$length }
+        }
+        $kind = 'File'
+        if ($isContainer) { $kind = 'Directory' }
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+            -ReparseKind $null -Target $null -ResolvedTarget $null -InScope $false `
+            -Depth $childDepth -Size $size))
+
+        if ($isContainer) {
+            $realChildCanonical = Get-WReparseCanonicalPath -Path $realChild
+            Invoke-WReparseDirectoryWalk -RealDirectory $realChildCanonical -VirtualDirectory $virtualChild `
+                -Depth $childDepth -Ancestry ($Ancestry + $realChildCanonical) -State $State
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root,
+        [ValidateSet('Never', 'Always')][string]$FollowMode = 'Never',
+        [int]$MaxDepth = 32
+    )
+    $state = @{
+        Records  = New-Object System.Collections.ArrayList
+        Errors   = New-Object System.Collections.ArrayList
+        Skipped  = 0
+        Root     = $null
+        Follow   = ($FollowMode -eq 'Always')
+        MaxDepth = $MaxDepth
+    }
+    # A negative limit behaves exactly like 0 (byte-identical reports).
+    if ($state.MaxDepth -lt 0) { $state.MaxDepth = 0 }
+
+    $canonicalRoot = $null
+    $canonicalised = $true
+    try {
+        $canonicalRoot = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        $canonicalised = $false
+    }
+    if (-not $canonicalised) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message "Scan root cannot be canonicalised: $Root"
+        return [pscustomobject]@{
+            Root    = [string]$Root
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+    $state.Root = $canonicalRoot
+
+    $rootExists = $false
+    try { $rootExists = [bool](Test-Path -LiteralPath $canonicalRoot -ErrorAction SilentlyContinue) } catch { $rootExists = $false }
+    if (-not $rootExists) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+    $rootIsContainer = $false
+    try { $rootIsContainer = [bool](Test-Path -LiteralPath $canonicalRoot -PathType Container -ErrorAction SilentlyContinue) } catch { $rootIsContainer = $false }
+    if (-not $rootIsContainer) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = @($state.Errors.ToArray())
+            Skipped = 0
+        }
+    }
+
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualDirectory $canonicalRoot `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return [pscustomobject]@{
+        Root    = $canonicalRoot
+        Records = @($state.Records.ToArray())
+        Errors  = @($state.Errors.ToArray())
+        Skipped = $state.Skipped
+    }
+}
