+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+#
+# Records and errors are ordered with an ordinal, culture-independent
+# comparison. Sort-Object is deliberately not used: its default string
+# comparison is culture-aware and would order non-ASCII names differently on
+# different hosts (observed: en-US, de-DE and ja-JP disagree on 'Z' vs 'A'
+# with diaeresis).
+
+function Compare-WReparseKeyArray {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Left,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Right
+    )
+    $shared = [Math]::Min($Left.Count, $Right.Count)
+    for ($i = 0; $i -lt $shared; $i++) {
+        $comparison = Compare-WReparsePath -Left $Left[$i] -Right $Right[$i]
+        if ($comparison -ne 0) { return $comparison }
+    }
+    return ($Left.Count - $Right.Count)
+}
+
+# Bottom-up merge sort. Keys are computed once per item; the sort is stable and
+# never touches a culture-aware comparer, so the emitted order is identical on
+# every host and on every run.
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][object[]]$Items,
+        [Parameter(Mandatory = $true)][scriptblock]$KeySelector
+    )
+    $array = @($Items)
+    $count = $array.Count
+    if ($count -le 1) { return @($array) }
+
+    $keys = New-Object 'object[]' $count
+    for ($i = 0; $i -lt $count; $i++) {
+        $keys[$i] = [string[]](@(& $KeySelector $array[$i]))
+    }
+
+    $index = [int[]](0..($count - 1))
+    $scratch = [int[]](0..($count - 1))
+    $width = 1
+    while ($width -lt $count) {
+        $position = 0
+        while ($position -lt $count) {
+            $leftEnd = [Math]::Min($position + $width, $count)
+            $rightEnd = [Math]::Min($position + (2 * $width), $count)
+            $left = $position
+            $right = $leftEnd
+            $cursor = $position
+            while ($left -lt $leftEnd -and $right -lt $rightEnd) {
+                if ((Compare-WReparseKeyArray -Left $keys[$index[$left]] -Right $keys[$index[$right]]) -le 0) {
+                    $scratch[$cursor] = $index[$left]; $left++
+                }
+                else {
+                    $scratch[$cursor] = $index[$right]; $right++
+                }
+                $cursor++
+            }
+            while ($left -lt $leftEnd) { $scratch[$cursor] = $index[$left]; $left++; $cursor++ }
+            while ($right -lt $rightEnd) { $scratch[$cursor] = $index[$right]; $right++; $cursor++ }
+            $position = $position + (2 * $width)
+        }
+        $swap = $index
+        $index = $scratch
+        $scratch = $swap
+        $width = $width * 2
+    }
+
+    $ordered = New-Object System.Collections.ArrayList
+    for ($i = 0; $i -lt $count; $i++) { [void]$ordered.Add($array[$index[$i]]) }
+    return @($ordered.ToArray())
+}
+
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    # Each kind is counted in its own bucket: a reparse point is never also
+    # counted as a directory.
+    $directories = 0
+    $files = 0
+    $reparsePoints = 0
+    foreach ($record in @($Records)) {
+        switch ([string]$record.Kind) {
+            'File'         { $files++ }
+            'ReparsePoint' { $reparsePoints++ }
+            'Directory'    { $directories++ }
+            default        { }
+        }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparsePoints `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+    $followMode = 'Never'
+    if ($Follow.IsPresent) { $followMode = 'Always' }
+    $walk = Invoke-WReparseWalk -Root $Root -FollowMode $followMode -MaxDepth $MaxDepth
+
+    $records = @(Sort-WReparseStable -Items @($walk.Records) -KeySelector { param($record) @([string]$record.RelativePath) })
+    $errors = @(Sort-WReparseStable -Items @($walk.Errors) -KeySelector { param($errorEntry) @([string]$errorEntry.RelativePath, [string]$errorEntry.Code) })
+    $stats = Get-WReparseStats -Records $records -Skipped ([int]$walk.Skipped) -ErrorCount ($errors.Count)
+
+    return New-WReparseReport -Root ([string]$walk.Root) -Records $records -Errors $errors -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$Report
+    )
+    return ($Report | ConvertTo-Json -Depth 12)
+}
