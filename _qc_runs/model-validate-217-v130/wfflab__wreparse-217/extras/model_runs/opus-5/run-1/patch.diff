new file mode 100644
index 0000000..d2700e1
--- /dev/null
+++ b/selftest.ps1
@@ -0,0 +1,609 @@
+# WReparse - candidate side self test
+#
+# Builds an NTFS fixture (junction, relative symlink, hard link, non-ASCII
+# names, access-denied subdirectory, cycle, dangling target, sibling links
+# pointing at one target, link whose target is a file, empty directory, a
+# subtree deeper than the default depth limit), runs the six public functions
+# against it and asserts every user visible acceptance item.
+#
+# Read only with respect to the scanned tree, no network, no administrator
+# privileges and no external modules required.
+#
+# Usage:
+#   powershell -NoProfile -ExecutionPolicy Bypass -File environment\workspace\selftest.ps1
+#
+# Exit codes: 0 everything passed; 1 at least one check failed.
+
+[CmdletBinding()]
+param(
+    [string]$WorkspaceRoot = ''
+)
+
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+
+if ([string]::IsNullOrWhiteSpace($WorkspaceRoot)) {
+    $WorkspaceRoot = $PSScriptRoot
+}
+
+$script:Pass = 0
+$script:Fail = 0
+$script:Skip = 0
+$script:Lines = New-Object System.Collections.ArrayList
+
+function Write-Result {
+    param([string]$Status, [string]$Name, [string]$Detail = '')
+    $text = "[$Status] $Name"
+    if (-not [string]::IsNullOrWhiteSpace($Detail)) { $text = $text + " -- " + $Detail }
+    Write-Host $text
+    [void]$script:Lines.Add($text)
+}
+
+function Assert-That {
+    param([string]$Name, [bool]$Condition, [string]$Detail = '')
+    if ($Condition) {
+        $script:Pass++
+        Write-Result -Status 'PASS' -Name $Name
+    }
+    else {
+        $script:Fail++
+        Write-Result -Status 'FAIL' -Name $Name -Detail $Detail
+    }
+}
+
+function Assert-Equal {
+    param([string]$Name, $Expected, $Actual)
+    $e = if ($null -eq $Expected) { '<null>' } else { [string]$Expected }
+    $a = if ($null -eq $Actual) { '<null>' } else { [string]$Actual }
+    Assert-That -Name $Name -Condition ($e -ceq $a) -Detail "expected '$e', got '$a'"
+}
+
+function Write-Skip {
+    param([string]$Name, [string]$Reason)
+    $script:Skip++
+    Write-Result -Status 'SKIP' -Name $Name -Detail $Reason
+}
+
+function Get-RecordByPath {
+    param($Report, [string]$RelativePath)
+    foreach ($record in @($Report.Records)) {
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([string]$record.RelativePath, $RelativePath)) {
+            return $record
+        }
+    }
+    return $null
+}
+
+function Test-HasError {
+    param($Report, [string]$RelativePath, [string]$Code)
+    foreach ($item in @($Report.Errors)) {
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([string]$item.RelativePath, $RelativePath) -and
+            ([string]$item.Code -ceq $Code)) {
+            return $true
+        }
+    }
+    return $false
+}
+
+function Test-HasCode {
+    param($Report, [string]$Code)
+    foreach ($item in @($Report.Errors)) {
+        if ([string]$item.Code -ceq $Code) { return $true }
+    }
+    return $false
+}
+
+function New-TextFile {
+    param([string]$Path, [string]$Content)
+    Set-Content -LiteralPath $Path -Value $Content -NoNewline -Encoding ASCII
+}
+
+function New-Dir {
+    param([string]$Path)
+    [void](New-Item -ItemType Directory -Path $Path -Force)
+}
+
+# --------------------------------------------------------------------------
+# module
+# --------------------------------------------------------------------------
+$modulePath = Join-Path (Join-Path $WorkspaceRoot 'WReparse') ('WReparse' + '.psd1')
+if (-not (Test-Path -LiteralPath $modulePath)) {
+    Write-Host "selftest: module not found at $modulePath"
+    exit 1
+}
+Import-Module $modulePath -Force
+
+# --------------------------------------------------------------------------
+# fixture
+# --------------------------------------------------------------------------
+# $env:TEMP may be an 8.3 short path; the module canonicalises to the long
+# form, so the fixture root is canonicalised up front to keep the expected
+# values comparable.
+$fixture = [System.IO.Path]::GetFullPath((Join-Path $env:TEMP ('wreparse-selftest-' + [guid]::NewGuid().ToString('N').Substring(0, 10))))
+$root = Join-Path $fixture 'scanroot'
+$outside = Join-Path $fixture 'outside'
+$extra = Join-Path $fixture 'scanroot-extra'
+$shared = Join-Path $fixture 'shared'
+$emptyTree = Join-Path $fixture 'empty-dir'
+$deniedDir = Join-Path $root 'denied'
+$symlinkSupported = $true
+$deniedApplied = $false
+
+function New-Junction {
+    param([string]$Path, [string]$Target)
+    [void](New-Item -ItemType Junction -Path $Path -Target $Target -ErrorAction Stop)
+}
+
+# mklink keeps the raw (possibly relative) target string on disk, which is
+# what a relative symlink test needs.
+function New-SymbolicLinkRaw {
+    param([string]$Path, [string]$RawTarget, [switch]$Directory)
+    $flag = if ($Directory) { '/D ' } else { '' }
+    $command = 'mklink ' + $flag + '"' + $Path + '" "' + $RawTarget + '"'
+    $output = & cmd.exe /c $command 2>&1
+    if ($LASTEXITCODE -ne 0 -or -not (Test-Path -LiteralPath $Path)) {
+        throw ("mklink failed: " + ($output -join ' '))
+    }
+}
+
+try {
+    New-Dir $fixture
+    New-Dir $root
+    New-Dir $outside
+    New-Dir $extra
+    New-Dir $shared
+    New-Dir $emptyTree
+
+    New-Dir (Join-Path $root 'beta')
+    New-Dir (Join-Path $root 'data')
+    New-Dir (Join-Path $root 'docs')
+    New-Dir (Join-Path $root 'docs\nested')
+    New-Dir (Join-Path $root 'empty')
+    New-Dir (Join-Path $root 'branch-a')
+    New-Dir (Join-Path $root 'branch-b')
+    New-Dir $deniedDir
+
+    New-TextFile (Join-Path $root 'plain.txt') 'abcd'
+    New-TextFile (Join-Path $root 'beta.txt') 'beta'
+    New-TextFile (Join-Path $root 'beta\zeta.txt') 'zeta'
+    New-TextFile (Join-Path $root 'data\sample.bin') 'bin!'
+    New-TextFile (Join-Path $root 'docs\readme.txt') 'readme'
+    New-TextFile (Join-Path $root 'docs\nested\deep.txt') 'deep'
+    New-TextFile (Join-Path $root 'Z.txt') 'ZZZZZZZZ'
+    New-TextFile (Join-Path $root ([string][char]0x00C4 + '.txt')) 'AEAEAEAE'
+    New-TextFile (Join-Path $root ([string][char]0x00F6 + '.txt')) 'oeoeoeoe'
+    New-TextFile (Join-Path $outside 'secret.txt') 'secret'
+    New-TextFile (Join-Path $extra 'other.txt') 'other!'
+    New-TextFile (Join-Path $shared 'shared.txt') 'shrd'
+    New-TextFile (Join-Path $deniedDir 'hidden.txt') 'deny'
+
+    [void](New-Item -ItemType HardLink -Path (Join-Path $root 'hardlink.txt') `
+            -Target (Join-Path $root 'plain.txt') -ErrorAction Stop)
+
+    # junctions never need administrator rights
+    New-Junction -Path (Join-Path $root 'link-in') -Target (Join-Path $root 'docs')
+    New-Junction -Path (Join-Path $root 'link-twin') -Target (Join-Path $root 'docs')
+    New-Junction -Path (Join-Path $root 'link-out') -Target $outside
+    New-Junction -Path (Join-Path $root 'link-prefix') -Target $extra
+    New-Junction -Path (Join-Path $root 'link-loop') -Target $root
+    New-Junction -Path (Join-Path $root 'branch-a\l1') -Target $shared
+    New-Junction -Path (Join-Path $root 'branch-b\l2') -Target $shared
+
+    # symbolic links need SeCreateSymbolicLink (admin or Developer Mode)
+    try {
+        New-SymbolicLinkRaw -Path (Join-Path $root 'link-rel') -RawTarget 'docs' -Directory
+        New-SymbolicLinkRaw -Path (Join-Path $root 'link-file') -RawTarget 'plain.txt'
+        New-SymbolicLinkRaw -Path (Join-Path $root 'link-dangling') -RawTarget 'missing-target'
+    }
+    catch {
+        $symlinkSupported = $false
+    }
+
+    # subtree deeper than the default depth limit of 32
+    $deepPath = Join-Path $root 'deep'
+    New-Dir $deepPath
+    $cursor = $deepPath
+    for ($i = 1; $i -le 36; $i++) {
+        $cursor = Join-Path $cursor ('d' + $i)
+        New-Dir $cursor
+    }
+
+    # deny enumeration of one subdirectory for the current user (no admin
+    # rights needed: the user owns the directory)
+    $me = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
+    $icaclsOut = & icacls.exe $deniedDir /deny ("$me" + ':(OI)(CI)(RX)') 2>&1
+    if ($LASTEXITCODE -eq 0) { $deniedApplied = $true }
+
+    # ----------------------------------------------------------------------
+    # baseline scans
+    # ----------------------------------------------------------------------
+    $noFollow = Get-WReparseReport -Root $root
+    $follow = Get-WReparseReport -Root $root -Follow
+
+    # 1) every reparse point registered, none entered without -Follow
+    $expectedLinks = @('link-in', 'link-twin', 'link-out', 'link-prefix', 'link-loop',
+        'branch-a\l1', 'branch-b\l2')
+    if ($symlinkSupported) {
+        $expectedLinks += @('link-rel', 'link-file', 'link-dangling')
+    }
+    $missing = @()
+    foreach ($name in $expectedLinks) {
+        $record = Get-RecordByPath -Report $noFollow -RelativePath $name
+        if ($null -eq $record -or [string]$record.Kind -cne 'ReparsePoint') { $missing += $name }
+    }
+    Assert-That -Name '01a every reparse point is registered' -Condition ($missing.Count -eq 0) `
+        -Detail ("missing/misclassified: " + ($missing -join ', '))
+
+    $leaked = @()
+    foreach ($record in @($noFollow.Records)) {
+        foreach ($name in $expectedLinks) {
+            if (([string]$record.RelativePath).StartsWith($name + '\', [System.StringComparison]::OrdinalIgnoreCase)) {
+                $leaked += [string]$record.RelativePath
+            }
+        }
+    }
+    Assert-That -Name '01b no reparse point is entered without -Follow' -Condition ($leaked.Count -eq 0) `
+        -Detail ("leaked children: " + ($leaked -join ', '))
+    Assert-Equal -Name '01c Skipped counts every reparse point' -Expected $expectedLinks.Count `
+        -Actual $noFollow.Stats.Skipped
+
+    # the sibling directory sharing only a name prefix must not be reachable
+    $prefixLeak = @(@($noFollow.Records) | Where-Object { ([string]$_.RelativePath) -clike '*other.txt*' }).Count
+    Assert-Equal -Name '01d scanroot-extra content is not enumerated' -Expected 0 -Actual $prefixLeak
+
+    # 2) InScope distinguishes the prefix sibling from a real inner target
+    $linkIn = Get-RecordByPath -Report $noFollow -RelativePath 'link-in'
+    $linkPrefix = Get-RecordByPath -Report $noFollow -RelativePath 'link-prefix'
+    $linkOut = Get-RecordByPath -Report $noFollow -RelativePath 'link-out'
+    Assert-Equal -Name '02a link into the scan root has InScope=True' -Expected 'True' -Actual $linkIn.InScope
+    Assert-Equal -Name '02b link to the prefix sibling has InScope=False' -Expected 'False' -Actual $linkPrefix.InScope
+    Assert-Equal -Name '02c link outside the scan root has InScope=False' -Expected 'False' -Actual $linkOut.InScope
+    Assert-Equal -Name '02d Test-WReparseWithinRoot rejects the prefix sibling' -Expected 'False' `
+        -Actual (Test-WReparseWithinRoot -Path $extra -Root $root)
+    Assert-Equal -Name '02e Test-WReparseWithinRoot accepts an inner path' -Expected 'True' `
+        -Actual (Test-WReparseWithinRoot -Path (Join-Path $root 'docs') -Root $root)
+    Assert-Equal -Name '02f Test-WReparseWithinRoot accepts the root itself' -Expected 'True' `
+        -Actual (Test-WReparseWithinRoot -Path $root -Root $root)
+
+    # 3) relative target resolution is independent of the process CWD
+    $linkRelPath = Join-Path $root 'link-rel'
+    $expectedRel = Join-Path $root 'docs'
+    $resolvedHere = Resolve-WReparseLinkTarget -LinkFullPath $linkRelPath -RawTarget 'docs'
+    Push-Location $env:SystemRoot
+    try {
+        $resolvedElsewhere = Resolve-WReparseLinkTarget -LinkFullPath $linkRelPath -RawTarget 'docs'
+    }
+    finally {
+        Pop-Location
+    }
+    Assert-Equal -Name '03a relative target resolves against the link directory' -Expected $expectedRel -Actual $resolvedHere
+    Assert-Equal -Name '03b relative target resolution ignores the process CWD' -Expected $expectedRel -Actual $resolvedElsewhere
+
+    # 4) two consecutive runs serialise byte identically
+    $json1 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root)
+    $json2 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root)
+    Assert-That -Name '04a two runs serialise identically' -Condition ($json1 -ceq $json2) -Detail 'JSON differs between runs'
+    $followJson1 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -Follow)
+    $followJson2 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -Follow)
+    Assert-That -Name '04b two -Follow runs serialise identically' -Condition ($followJson1 -ceq $followJson2) `
+        -Detail 'JSON differs between -Follow runs'
+    Assert-That -Name '04c report carries no volatile field' `
+        -Condition (-not ($json1 -match 'GeneratedAt|Timestamp|ProcessId|MachineName')) `
+        -Detail 'a volatile field is present'
+
+    # 5) hard link vs junction vs symbolic link classification
+    $hard = Get-RecordByPath -Report $noFollow -RelativePath 'hardlink.txt'
+    Assert-Equal -Name '05a hard link is a File' -Expected 'File' -Actual $hard.Kind
+    Assert-Equal -Name '05b hard link has no ReparseKind' -Expected '<null>' `
+        -Actual $(if ($null -eq $hard.ReparseKind) { '<null>' } else { [string]$hard.ReparseKind })
+    Assert-Equal -Name '05c hard link reports its byte length' -Expected 4 -Actual $hard.Size
+    Assert-Equal -Name '05d junction has ReparseKind=Junction' -Expected 'Junction' -Actual $linkIn.ReparseKind
+    if ($symlinkSupported) {
+        $linkRel = Get-RecordByPath -Report $noFollow -RelativePath 'link-rel'
+        Assert-Equal -Name '05e symbolic link has ReparseKind=SymbolicLink' -Expected 'SymbolicLink' -Actual $linkRel.ReparseKind
+        Assert-That -Name '05f junction and symbolic link are distinguishable' `
+            -Condition ([string]$linkIn.ReparseKind -cne [string]$linkRel.ReparseKind) -Detail 'both map to the same ReparseKind'
+        Assert-Equal -Name '05g symbolic link keeps the raw relative target' -Expected 'docs' -Actual $linkRel.Target
+    }
+    else {
+        Write-Skip -Name '05e-g symbolic link classification' -Reason 'symlink creation not permitted on this host'
+    }
+
+    # 6) three distinct root failures
+    $gone = Get-WReparseReport -Root (Join-Path $fixture 'does-not-exist')
+    $asFile = Get-WReparseReport -Root (Join-Path $root 'plain.txt')
+    $bogus = Get-WReparseReport -Root ('C:\' + [string][char]0x0000 + 'bad|name')
+    Assert-Equal -Name '06a missing root reports not_found' -Expected 'not_found' -Actual $gone.Errors[0].Code
+    Assert-Equal -Name '06b root that is a file reports structure' -Expected 'structure' -Actual $asFile.Errors[0].Code
+    Assert-Equal -Name '06c unusable root string reports invalid_argument' -Expected 'invalid_argument' -Actual $bogus.Errors[0].Code
+    Assert-That -Name '06d the three root failures differ' `
+        -Condition (@([string]$gone.Errors[0].Code, [string]$asFile.Errors[0].Code, [string]$bogus.Errors[0].Code) |
+            Select-Object -Unique).Count -eq 3 -Detail 'codes are not distinct'
+    Assert-Equal -Name '06e root failure is reported against "."' -Expected '.' -Actual $gone.Errors[0].RelativePath
+    Assert-Equal -Name '06f root failure yields no record' -Expected 0 -Actual @($gone.Records).Count
+
+    # 7) -MaxDepth 0 and a negative -MaxDepth behave identically
+    $depthZero = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -MaxDepth 0)
+    $depthNeg = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -MaxDepth -1)
+    $depthNeg7 = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root -MaxDepth -7)
+    Assert-That -Name '07a -MaxDepth -1 equals -MaxDepth 0 byte for byte' -Condition ($depthZero -ceq $depthNeg) `
+        -Detail 'output differs'
+    Assert-That -Name '07b -MaxDepth -7 equals -MaxDepth 0 byte for byte' -Condition ($depthZero -ceq $depthNeg7) `
+        -Detail 'output differs'
+    $zeroReport = Get-WReparseReport -Root $root -MaxDepth 0
+    Assert-Equal -Name '07c -MaxDepth 0 emits no record' -Expected 0 -Actual @($zeroReport.Records).Count
+    Assert-That -Name '07d -MaxDepth 0 reports too_deep against "."' `
+        -Condition (Test-HasError -Report $zeroReport -RelativePath '.' -Code 'too_deep') -Detail 'missing too_deep'
+
+    # the deep subtree must hit the default limit, not blow up
+    Assert-That -Name '07e default -MaxDepth reports too_deep on the deep subtree' `
+        -Condition (Test-HasCode -Report $noFollow -Code 'too_deep') -Detail 'no too_deep reported'
+    $deepest = 0
+    foreach ($record in @($noFollow.Records)) {
+        if ([int]$record.Depth -gt $deepest) { $deepest = [int]$record.Depth }
+    }
+    Assert-That -Name '07f no record exceeds the depth limit' -Condition ($deepest -le 32) -Detail "deepest=$deepest"
+
+    # 8) followed children are named after the link path
+    $followedChild = Get-RecordByPath -Report $follow -RelativePath 'link-in\readme.txt'
+    Assert-That -Name '08a followed child is named after the link path' -Condition ($null -ne $followedChild) `
+        -Detail 'link-in\readme.txt missing'
+    if ($null -ne $followedChild) {
+        Assert-Equal -Name '08b followed child depth continues from the link' -Expected 2 -Actual $followedChild.Depth
+    }
+    $realNamed = @(@($follow.Records) | Where-Object {
+            ([string]$_.RelativePath).StartsWith('docs\', [System.StringComparison]::OrdinalIgnoreCase) -and
+            ([string]$_.RelativePath) -cne 'docs\readme.txt' -and ([string]$_.RelativePath) -cne 'docs\nested' -and
+            ([string]$_.RelativePath) -cne 'docs\nested\deep.txt'
+        }).Count
+    Assert-Equal -Name '08c no child is named after the real target path' -Expected 0 -Actual $realNamed
+    $outChild = Get-RecordByPath -Report $follow -RelativePath 'link-out\secret.txt'
+    Assert-That -Name '08d a link leaving the root is followed under its link name' -Condition ($null -ne $outChild) `
+        -Detail 'link-out\secret.txt missing'
+
+    # 9) a link whose target is a file produces no child
+    if ($symlinkSupported) {
+        $fileLink = Get-RecordByPath -Report $follow -RelativePath 'link-file'
+        Assert-Equal -Name '09a link to a file is a ReparsePoint record' -Expected 'ReparsePoint' -Actual $fileLink.Kind
+        $fileLinkChildren = @(@($follow.Records) | Where-Object {
+                ([string]$_.RelativePath).StartsWith('link-file\', [System.StringComparison]::OrdinalIgnoreCase)
+            }).Count
+        Assert-Equal -Name '09b link to a file produces no child' -Expected 0 -Actual $fileLinkChildren
+        Assert-Equal -Name '09c link to a file has Size=0' -Expected 0 -Actual $fileLink.Size
+    }
+    else {
+        Write-Skip -Name '09a-c link whose target is a file' -Reason 'symlink creation not permitted on this host'
+    }
+
+    # 10) sibling branches pointing at one target are not a cycle
+    $l1Child = Get-RecordByPath -Report $follow -RelativePath 'branch-a\l1\shared.txt'
+    $l2Child = Get-RecordByPath -Report $follow -RelativePath 'branch-b\l2\shared.txt'
+    Assert-That -Name '10a first sibling branch is entered' -Condition ($null -ne $l1Child) -Detail 'branch-a\l1\shared.txt missing'
+    Assert-That -Name '10b second sibling branch is entered' -Condition ($null -ne $l2Child) -Detail 'branch-b\l2\shared.txt missing'
+    Assert-That -Name '10c sibling co-pointing is not a cycle' `
+        -Condition (-not (Test-HasError -Report $follow -RelativePath 'branch-a\l1' -Code 'cycle') -and
+            -not (Test-HasError -Report $follow -RelativePath 'branch-b\l2' -Code 'cycle')) -Detail 'cycle reported'
+    $twinChild = Get-RecordByPath -Report $follow -RelativePath 'link-twin\readme.txt'
+    Assert-That -Name '10d twin link to an already visited target is entered' -Condition ($null -ne $twinChild) `
+        -Detail 'link-twin\readme.txt missing'
+    Assert-That -Name '10e an ancestor loop IS a cycle' `
+        -Condition (Test-HasError -Report $follow -RelativePath 'link-loop' -Code 'cycle') -Detail 'no cycle for link-loop'
+    if ($symlinkSupported) {
+        Assert-That -Name '10f a dangling target IS broken_target' `
+            -Condition (Test-HasError -Report $follow -RelativePath 'link-dangling' -Code 'broken_target') `
+            -Detail 'no broken_target for link-dangling'
+    }
+    else {
+        Write-Skip -Name '10f dangling target' -Reason 'symlink creation not permitted on this host'
+    }
+
+    # 11) an empty tree serialises with empty arrays
+    $emptyReport = Get-WReparseReport -Root $emptyTree
+    $emptyJson = ConvertTo-WReparseJson -Report $emptyReport
+    $emptyParsed = $emptyJson | ConvertFrom-Json
+    Assert-Equal -Name '11a empty tree has no record' -Expected 0 -Actual @($emptyReport.Records).Count
+    Assert-Equal -Name '11b empty tree has no error' -Expected 0 -Actual @($emptyReport.Errors).Count
+    Assert-That -Name '11c empty tree serialises Records as []' -Condition ($emptyJson -match '"Records"\s*:\s*\[\s*\]') `
+        -Detail 'Records is not an empty JSON array'
+    Assert-That -Name '11d empty tree serialises Errors as []' -Condition ($emptyJson -match '"Errors"\s*:\s*\[\s*\]') `
+        -Detail 'Errors is not an empty JSON array'
+    Assert-Equal -Name '11e empty tree stats are zero' -Expected '0/0/0/0/0' `
+        -Actual ("$($emptyParsed.Stats.Directories)/$($emptyParsed.Stats.Files)/$($emptyParsed.Stats.ReparsePoints)/" +
+            "$($emptyParsed.Stats.Skipped)/$($emptyParsed.Stats.Errors)")
+    # an empty directory INSIDE the tree is still one Directory record
+    $emptyInner = Get-RecordByPath -Report $noFollow -RelativePath 'empty'
+    Assert-Equal -Name '11f an empty inner directory is a Directory record' -Expected 'Directory' -Actual $emptyInner.Kind
+    Assert-Equal -Name '11g an empty inner directory has Size=0' -Expected 0 -Actual $emptyInner.Size
+
+    # 12) only the six contract functions are visible
+    $exported = @((Get-Module WReparse).ExportedFunctions.Keys) | Sort-Object
+    $expectedExports = @('ConvertTo-WReparseJson', 'Get-WReparseCanonicalPath', 'Get-WReparseReport',
+        'Get-WReparseSchemaVersion', 'Resolve-WReparseLinkTarget', 'Test-WReparseWithinRoot')
+    Assert-Equal -Name '12a exported surface is exactly the contract six' -Expected ($expectedExports -join ',') `
+        -Actual ($exported -join ',')
+    $internals = @('Invoke-WReparseWalk', 'Sort-WReparseStable', 'New-WReparseRecord', 'New-WReparseReport',
+        'Get-WReparseRelativePath', 'Compare-WReparsePath', 'Test-WReparseIsReparsePoint', 'Get-WReparseStats',
+        'New-WReparseError', 'New-WReparseStats', 'Get-WReparseErrorCode', 'Get-WReparseKindFromLinkType',
+        'Get-WReparseMemberValue', 'Get-WReparseRawTarget', 'Add-WReparseError', 'Invoke-WReparseDirectoryWalk')
+    $visibleInternals = @()
+    foreach ($name in $internals) {
+        if (Get-Command $name -ErrorAction SilentlyContinue) { $visibleInternals += $name }
+    }
+    Assert-That -Name '12b internal helpers stay invisible' -Condition ($visibleInternals.Count -eq 0) `
+        -Detail ("visible: " + ($visibleInternals -join ', '))
+    Assert-Equal -Name '12c schema version' -Expected 'wreparse/1.0' -Actual (Get-WReparseSchemaVersion)
+
+    # 13) exact field sets
+    $topFields = @($noFollow.PSObject.Properties | ForEach-Object { $_.Name })
+    Assert-Equal -Name '13a report field set and order' -Expected 'SchemaVersion,Root,Records,Errors,Stats' `
+        -Actual ($topFields -join ',')
+    $recordFields = @($linkIn.PSObject.Properties | ForEach-Object { $_.Name })
+    Assert-Equal -Name '13b record field set and order' `
+        -Expected 'RelativePath,Kind,ReparseKind,Target,ResolvedTarget,InScope,Depth,Size' `
+        -Actual ($recordFields -join ',')
+    $statsFields = @($noFollow.Stats.PSObject.Properties | ForEach-Object { $_.Name })
+    Assert-Equal -Name '13c stats field set and order' -Expected 'Directories,Files,ReparsePoints,Skipped,Errors' `
+        -Actual ($statsFields -join ',')
+    $errorFields = @($gone.Errors[0].PSObject.Properties | ForEach-Object { $_.Name })
+    Assert-Equal -Name '13d error field set and order' -Expected 'RelativePath,Code,Message' -Actual ($errorFields -join ',')
+    Assert-Equal -Name '13e Root is the canonical scan root' -Expected (Get-WReparseCanonicalPath -Path $root) `
+        -Actual $noFollow.Root
+
+    # 14) ordering is ordinal and therefore culture independent
+    $asciiOrder = @(@($noFollow.Records) |
+        Where-Object { ([string]$_.RelativePath) -cmatch ('^(Z|' + [string][char]0x00C4 + '|' + [string][char]0x00F6 + ')\.txt$') } |
+        ForEach-Object { [string]$_.RelativePath })
+    $expectedOrder = @('Z.txt', ([string][char]0x00C4 + '.txt'), ([string][char]0x00F6 + '.txt'))
+    Assert-Equal -Name '14a non-ASCII names follow ordinal order' -Expected ($expectedOrder -join '|') -Actual ($asciiOrder -join '|')
+
+    $originalCulture = [System.Threading.Thread]::CurrentThread.CurrentCulture
+    $originalUiCulture = [System.Threading.Thread]::CurrentThread.CurrentUICulture
+    $cultureJson = @{}
+    foreach ($culture in @('en-US', 'de-DE', 'ja-JP')) {
+        [System.Threading.Thread]::CurrentThread.CurrentCulture = [System.Globalization.CultureInfo]::GetCultureInfo($culture)
+        [System.Threading.Thread]::CurrentThread.CurrentUICulture = [System.Globalization.CultureInfo]::GetCultureInfo($culture)
+        $cultureJson[$culture] = ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root)
+    }
+    [System.Threading.Thread]::CurrentThread.CurrentCulture = $originalCulture
+    [System.Threading.Thread]::CurrentThread.CurrentUICulture = $originalUiCulture
+    Assert-That -Name '14b en-US and de-DE produce identical output' `
+        -Condition ($cultureJson['en-US'] -ceq $cultureJson['de-DE']) -Detail 'output differs'
+    Assert-That -Name '14c en-US and ja-JP produce identical output' `
+        -Condition ($cultureJson['en-US'] -ceq $cultureJson['ja-JP']) -Detail 'output differs'
+    Assert-That -Name '14d culture runs match the baseline run' `
+        -Condition ($cultureJson['en-US'] -ceq $json1) -Detail 'output differs from the baseline'
+
+    # 15) no cycle / broken_target without -Follow
+    Assert-That -Name '15a no cycle without -Follow' -Condition (-not (Test-HasCode -Report $noFollow -Code 'cycle')) `
+        -Detail 'cycle reported'
+    Assert-That -Name '15b no broken_target without -Follow' `
+        -Condition (-not (Test-HasCode -Report $noFollow -Code 'broken_target')) -Detail 'broken_target reported'
+    Assert-Equal -Name '15c -Follow does not skip anything' -Expected 0 -Actual $follow.Stats.Skipped
+
+    # 16) InScope is false for every plain entry
+    $wrongScope = @(@($noFollow.Records) | Where-Object {
+            ([string]$_.Kind -cne 'ReparsePoint') -and ([bool]$_.InScope)
+        }).Count
+    Assert-Equal -Name '16a plain files and directories have InScope=False' -Expected 0 -Actual $wrongScope
+    $plain = Get-RecordByPath -Report $noFollow -RelativePath 'beta.txt'
+    Assert-Equal -Name '16b plain file has ReparseKind=null' -Expected '<null>' `
+        -Actual $(if ($null -eq $plain.ReparseKind) { '<null>' } else { [string]$plain.ReparseKind })
+    Assert-Equal -Name '16c plain file has Target=null' -Expected '<null>' `
+        -Actual $(if ($null -eq $plain.Target) { '<null>' } else { [string]$plain.Target })
+    Assert-Equal -Name '16d plain file has ResolvedTarget=null' -Expected '<null>' `
+        -Actual $(if ($null -eq $plain.ResolvedTarget) { '<null>' } else { [string]$plain.ResolvedTarget })
+    Assert-Equal -Name '16e plain file reports its byte length' -Expected 4 -Actual $plain.Size
+    $betaDir = Get-RecordByPath -Report $noFollow -RelativePath 'beta'
+    Assert-Equal -Name '16f directory has Size=0' -Expected 0 -Actual $betaDir.Size
+    Assert-Equal -Name '16g direct child has Depth=1' -Expected 1 -Actual $betaDir.Depth
+    Assert-Equal -Name '16h grandchild has Depth=2' -Expected 2 `
+        -Actual (Get-RecordByPath -Report $noFollow -RelativePath 'beta\zeta.txt').Depth
+    Assert-Equal -Name '16i great-grandchild has Depth=3' -Expected 3 `
+        -Actual (Get-RecordByPath -Report $noFollow -RelativePath 'docs\nested\deep.txt').Depth
+    Assert-That -Name '16j the scan root itself produces no record' `
+        -Condition ($null -eq (Get-RecordByPath -Report $noFollow -RelativePath '.')) -Detail '"." is present in Records'
+
+    # 17) Target / ResolvedTarget are always strings on reparse records
+    $badType = @()
+    foreach ($record in @($noFollow.Records)) {
+        if ([string]$record.Kind -cne 'ReparsePoint') { continue }
+        if ($null -ne $record.Target -and -not ($record.Target -is [string])) {
+            $badType += ([string]$record.RelativePath + ':Target')
+        }
+        if ($null -ne $record.ResolvedTarget -and -not ($record.ResolvedTarget -is [string])) {
+            $badType += ([string]$record.RelativePath + ':ResolvedTarget')
+        }
+    }
+    Assert-That -Name '17a reparse Target is always a string' -Condition ($badType.Count -eq 0) `
+        -Detail ("non-string: " + ($badType -join ', '))
+    Assert-Equal -Name '17b junction ResolvedTarget is absolute' -Expected (Join-Path $root 'docs') -Actual $linkIn.ResolvedTarget
+    if ($symlinkSupported) {
+        Assert-Equal -Name '17c relative symlink resolves to an absolute path' -Expected (Join-Path $root 'docs') `
+            -Actual (Get-RecordByPath -Report $noFollow -RelativePath 'link-rel').ResolvedTarget
+        Assert-Equal -Name '17d dangling symlink still exposes a ResolvedTarget' -Expected (Join-Path $root 'missing-target') `
+            -Actual (Get-RecordByPath -Report $noFollow -RelativePath 'link-dangling').ResolvedTarget
+    }
+    else {
+        Write-Skip -Name '17c-d relative and dangling symlink targets' -Reason 'symlink creation not permitted on this host'
+    }
+
+    # access denied must not abort the scan
+    if ($deniedApplied) {
+        Assert-That -Name '18a a denied subdirectory yields access_denied' `
+            -Condition (Test-HasError -Report $noFollow -RelativePath 'denied' -Code 'access_denied') `
+            -Detail 'no access_denied reported'
+        Assert-That -Name '18b other branches still produce records' `
+            -Condition ($null -ne (Get-RecordByPath -Report $noFollow -RelativePath 'docs\nested\deep.txt')) `
+            -Detail 'sibling branches are missing'
+    }
+    else {
+        Write-Skip -Name '18a-b access denied subdirectory' -Reason 'the deny ACE could not be applied'
+    }
+
+    # canonicalisation samples
+    Assert-Equal -Name '19a canonical path drops a trailing separator' -Expected $outside `
+        -Actual (Get-WReparseCanonicalPath -Path ($outside + '\'))
+    Assert-Equal -Name '19b canonical path preserves inner casing' -Expected (Join-Path $outside 'PLAIN.TXT') `
+        -Actual (Get-WReparseCanonicalPath -Path (Join-Path $outside 'PLAIN.TXT'))
+    Assert-Equal -Name '19c canonical path collapses "." and ".."' -Expected $outside `
+        -Actual (Get-WReparseCanonicalPath -Path (Join-Path $root '..\outside\.'))
+    Assert-Equal -Name '19d canonical path keeps the volume root separator' -Expected 'C:\' `
+        -Actual (Get-WReparseCanonicalPath -Path 'C:\')
+
+    # error codes stay inside the allowed vocabulary
+    $allowed = @('not_found', 'access_denied', 'cycle', 'broken_target', 'structure', 'too_deep', 'invalid_argument')
+    $unknown = @()
+    foreach ($report in @($noFollow, $follow, $zeroReport, $gone, $asFile, $bogus)) {
+        foreach ($item in @($report.Errors)) {
+            if ($allowed -notcontains [string]$item.Code) { $unknown += [string]$item.Code }
+        }
+    }
+    Assert-That -Name '20a only contract error codes are emitted' -Condition ($unknown.Count -eq 0) `
+        -Detail ("unknown: " + ($unknown -join ', '))
+    Assert-Equal -Name '20b Stats.Errors matches the error count' -Expected @($noFollow.Errors).Count `
+        -Actual $noFollow.Stats.Errors
+
+    # Records are sorted; Errors are sorted
+    $sortedRecords = @(@($noFollow.Records) | ForEach-Object { [string]$_.RelativePath })
+    $isSorted = $true
+    for ($i = 1; $i -lt $sortedRecords.Count; $i++) {
+        if ([System.StringComparer]::OrdinalIgnoreCase.Compare($sortedRecords[$i - 1], $sortedRecords[$i]) -gt 0) {
+            $isSorted = $false
+            break
+        }
+    }
+    Assert-That -Name '21a Records are ordinally sorted by RelativePath' -Condition $isSorted -Detail 'order is not ordinal'
+    $sortedErrors = @(@($follow.Errors) | ForEach-Object { [string]$_.RelativePath })
+    $errSorted = $true
+    for ($i = 1; $i -lt $sortedErrors.Count; $i++) {
+        if ([System.StringComparer]::OrdinalIgnoreCase.Compare($sortedErrors[$i - 1], $sortedErrors[$i]) -gt 0) {
+            $errSorted = $false
+            break
+        }
+    }
+    Assert-That -Name '21b Errors are ordinally sorted by RelativePath' -Condition $errSorted -Detail 'order is not ordinal'
+
+    # the scan is read only: the fixture must be unchanged
+    $before = @(Get-ChildItem -LiteralPath $root -Force -Recurse -ErrorAction SilentlyContinue |
+        ForEach-Object { $_.FullName }) | Sort-Object
+    [void](Get-WReparseReport -Root $root -Follow)
+    $after = @(Get-ChildItem -LiteralPath $root -Force -Recurse -ErrorAction SilentlyContinue |
+        ForEach-Object { $_.FullName }) | Sort-Object
+    Assert-Equal -Name '22a the scan does not modify the tree' -Expected ($before -join '|') -Actual ($after -join '|')
+}
+finally {
+    if ($deniedApplied) {
+        $me2 = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
+        & icacls.exe $deniedDir /remove:d "$me2" 2>&1 | Out-Null
+    }
+    # junctions must be removed without recursing into their targets
+    Get-ChildItem -LiteralPath $fixture -Recurse -Force -ErrorAction SilentlyContinue |
+        Where-Object { $_.PSIsContainer -and (($_.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) } |
+        ForEach-Object { [System.IO.Directory]::Delete($_.FullName) }
+    Remove-Item -LiteralPath $fixture -Recurse -Force -ErrorAction SilentlyContinue
+}
+
+Write-Host ''
+Write-Host "selftest: $script:Pass passed, $script:Fail failed, $script:Skip skipped"
+if ($script:Fail -gt 0) { exit 1 }
+exit 0
