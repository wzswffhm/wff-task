+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation. See the contract under docs/
+
+Set-StrictMode -Version Latest
+
+# Canonical form used for every comparison and for the report:
+#   * full (rooted) path with '.' and '..' collapsed
+#   * no trailing directory separator, except for a volume root ('C:\')
+#     or a UNC share root
+#   * original casing preserved -- the contract reproduces the on-disk
+#     spelling of every component (see docs 5.1), so no case folding here.
+# Throws when the input cannot be turned into a canonical path; the caller
+# turns that into the 'invalid_argument' error code.
+function Get-WReparseCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Path
+    )
+    if ([string]::IsNullOrWhiteSpace($Path)) {
+        throw [System.ArgumentException]::new('The path is empty.')
+    }
+    $full = [System.IO.Path]::GetFullPath($Path)
+    $pathRoot = [System.IO.Path]::GetPathRoot($full)
+    $rootTrimmed = $pathRoot.TrimEnd([char]'\', [char]'/')
+    $trimmed = $full.TrimEnd([char]'\', [char]'/')
+    if ($trimmed.Length -le $rootTrimmed.Length) {
+        # The path IS the volume root or the UNC share root.
+        if ($rootTrimmed -match '^[A-Za-z]:$') { return ($rootTrimmed + '\') }
+        if ([string]::IsNullOrEmpty($rootTrimmed)) { return $full }
+        return $rootTrimmed
+    }
+    return $trimmed
+}
+
+# Directory-boundary aware containment. 'C:\root-extra' is NOT inside
+# 'C:\root' even though 'C:\root-extra'.StartsWith('C:\root') is true: the
+# comparison has to stop at a directory separator. Windows path comparison is
+# case-insensitive, so the ordinal-ignore-case comparer is used (ordinal, so
+# that the result never depends on the host culture).
+function Test-WReparseWithinRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root
+    )
+    if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) {
+        return $false
+    }
+    $p = $null
+    $r = $null
+    try {
+        $p = Get-WReparseCanonicalPath -Path $Path
+        $r = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        return $false
+    }
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return $true }
+    $prefix = $r
+    if (-not $prefix.EndsWith('\')) { $prefix = $prefix + '\' }
+    return $p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
+}
+
+# Relative path of a scanned entry with respect to the scan root, using the
+# Windows separator. The root itself yields '.'. The casing of the entry is
+# preserved exactly as it was observed on disk.
+function Get-WReparseRelativePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$FullPath,
+        [Parameter(Mandatory = $true)][string]$Root
+    )
+    $p = Get-WReparseCanonicalPath -Path $FullPath
+    $r = Get-WReparseCanonicalPath -Path $Root
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return '.' }
+    $prefix = $r
+    if (-not $prefix.EndsWith('\')) { $prefix = $prefix + '\' }
+    if ($p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $p.Substring($prefix.Length)
+    }
+    return $p
+}
+
+# The reparse target stored on disk may be relative. A relative target is
+# resolved against the directory that CONTAINS the link, never against the
+# process working directory and never against the scan root -- that is what
+# the kernel does, and it keeps the result independent of where the scan was
+# started from.
+function Resolve-WReparseLinkTarget {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$LinkFullPath,
+        [Parameter(Mandatory = $false)][AllowEmptyString()][AllowNull()][string]$RawTarget
+    )
+    if ([string]::IsNullOrWhiteSpace($RawTarget)) { return $null }
+    if ([string]::IsNullOrWhiteSpace($LinkFullPath)) { return $null }
+
+    try {
+        $candidate = $null
+        if ([System.IO.Path]::IsPathRooted($RawTarget)) {
+            $candidate = $RawTarget
+        }
+        else {
+            $linkDirectory = [System.IO.Path]::GetDirectoryName($LinkFullPath)
+            if ([string]::IsNullOrEmpty($linkDirectory)) {
+                $linkDirectory = [System.IO.Path]::GetPathRoot($LinkFullPath)
+            }
+            if ([string]::IsNullOrEmpty($linkDirectory)) { return $null }
+            $candidate = [System.IO.Path]::Combine($linkDirectory, $RawTarget)
+        }
+        return Get-WReparseCanonicalPath -Path $candidate
+    }
+    catch {
+        return $null
+    }
+}
+
+# Stable ordering key: ordinal, case-insensitive first, with a case-sensitive
+# ordinal tie-break so that two entries whose names differ only by case keep a
+# deterministic position. Ordinal comparison is the only one that gives the
+# same order under en-US, de-DE and ja-JP (see assets/observed-provider-facts).
+function Compare-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Left,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Right
+    )
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($Left, $Right)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($Left, $Right)
+}
