+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse reference implementation.
+
+Set-StrictMode -Version Latest
+
+# Stable bottom-up merge sort so the report never depends on the enumerator
+# order or on the host culture. Sort-Object is deliberately not used: its
+# default string comparison is culture-aware and would order non-ASCII names
+# differently under en-US, de-DE and ja-JP (see assets/observed-provider-facts
+# -> sort-object-under-three-cultures).
+#
+# The result is emitted unrolled (no unary comma): every caller re-wraps with
+# @(), which would otherwise produce a single element holding the whole array.
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $false)][AllowEmptyCollection()][AllowNull()][object[]]$Items,
+        [Parameter(Mandatory = $true)][scriptblock]$KeySelector
+    )
+    $array = @($Items)
+    $count = $array.Count
+    if ($count -le 1) { return $array }
+
+    # Decorate once: the key selector must not be re-evaluated per comparison.
+    $keys = New-Object 'string[]' $count
+    for ($k = 0; $k -lt $count; $k++) {
+        $keys[$k] = [string](& $KeySelector $array[$k])
+    }
+
+    $srcIndex = New-Object 'int[]' $count
+    for ($k = 0; $k -lt $count; $k++) { $srcIndex[$k] = $k }
+    $dstIndex = New-Object 'int[]' $count
+
+    $width = 1
+    while ($width -lt $count) {
+        $i = 0
+        while ($i -lt $count) {
+            $left = $i
+            $mid = [Math]::Min($i + $width, $count)
+            $right = [Math]::Min($i + (2 * $width), $count)
+            $a = $left
+            $b = $mid
+            $out = $left
+            while ($a -lt $mid -and $b -lt $right) {
+                $cmp = Compare-WReparsePath -Left $keys[$srcIndex[$a]] -Right $keys[$srcIndex[$b]]
+                if ($cmp -eq 0) {
+                    # Equal keys keep their original relative order.
+                    $cmp = $srcIndex[$a] - $srcIndex[$b]
+                }
+                if ($cmp -le 0) {
+                    $dstIndex[$out] = $srcIndex[$a]; $a++
+                }
+                else {
+                    $dstIndex[$out] = $srcIndex[$b]; $b++
+                }
+                $out++
+            }
+            while ($a -lt $mid) { $dstIndex[$out] = $srcIndex[$a]; $a++; $out++ }
+            while ($b -lt $right) { $dstIndex[$out] = $srcIndex[$b]; $b++; $out++ }
+            $i += (2 * $width)
+        }
+        $swap = $srcIndex
+        $srcIndex = $dstIndex
+        $dstIndex = $swap
+        $width = $width * 2
+    }
+
+    $result = New-Object 'object[]' $count
+    for ($k = 0; $k -lt $count; $k++) { $result[$k] = $array[$srcIndex[$k]] }
+    return $result
+}
+
+# Directories / Files / ReparsePoints are three disjoint buckets keyed on
+# Kind: a reparse point is never also counted as a directory.
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $false)][AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        switch ([string]$record.Kind) {
+            'Directory' { $directories++ }
+            'File' { $files++ }
+            'ReparsePoint' { $reparse++ }
+        }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+    $followMode = if ($Follow) { 'Always' } else { 'Never' }
+    $walk = Invoke-WReparseWalk -Root $Root -FollowMode $followMode -MaxDepth $MaxDepth
+    $records = @(Sort-WReparseStable -Items @($walk.Records) -KeySelector { param($item) $item.RelativePath })
+    $errors = @(Sort-WReparseStable -Items @($walk.Errors) -KeySelector { param($item) $item.RelativePath })
+    $stats = Get-WReparseStats -Records $records -Skipped $walk.Skipped -ErrorCount $errors.Count
+    return New-WReparseReport -Root ([string]$walk.Root) -Records $records -Errors $errors -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$Report
+    )
+    # The depth is generous enough that no -MaxDepth can make the payload be
+    # truncated: the report shape itself is flat (report -> array -> record).
+    return ($Report | ConvertTo-Json -Depth 64)
+}
