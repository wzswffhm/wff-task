+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse reference implementation.
+
+Set-StrictMode -Version Latest
+
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
+# Literal path join: no wildcard interpretation, no provider resolution.
+function Join-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$Parent,
+        [Parameter(Mandatory = $true)][string]$Child
+    )
+    if ($Parent.EndsWith('\') -or $Parent.EndsWith('/')) { return ($Parent + $Child) }
+    return ($Parent + '\' + $Child)
+}
+
+# Maps the provider link type to the contract vocabulary. A junction and a
+# symbolic link must stay distinguishable: they are different reparse tags
+# (0xA0000003 vs 0xA000000C) and downstream decides differently on them.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $false)][AllowNull()][AllowEmptyString()][string]$LinkType)
+    switch ($LinkType) {
+        'SymbolicLink' { return 'SymbolicLink' }
+        'Junction' { return 'Junction' }
+        'MountPoint' { return 'MountPoint' }
+        default { return 'Unknown' }
+    }
+}
+
+# Only FILE_ATTRIBUTE_REPARSE_POINT (0x400) identifies a reparse point.
+# LinkType must NOT be used for this: the provider also reports
+# LinkType = 'HardLink' for hard links, and a hard link is a plain file --
+# it shares a data stream, it carries no reparse attribute.
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)]$Item)
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return $false }
+    try {
+        $value = [System.IO.FileAttributes]$attributes
+    }
+    catch {
+        return $false
+    }
+    return (([int]$value -band [int][System.IO.FileAttributes]::ReparsePoint) -ne 0)
+}
+
+# The provider exposes Target as a System.String[] (a reparse point may carry
+# several substitutions). The report model is a flat string, so the first
+# element is taken and the value never changes runtime type with the number
+# of targets.
+function Get-WReparseRawTarget {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)]$Item)
+    $value = Get-WReparseMemberValue -InputObject $Item -Name 'Target'
+    if ($null -eq $value) { return $null }
+    if ($value -is [string]) {
+        if ([string]::IsNullOrWhiteSpace($value)) { return $null }
+        return [string]$value
+    }
+    $list = @($value)
+    if ($list.Count -eq 0) { return $null }
+    $first = $list[0]
+    if ($null -eq $first) { return $null }
+    $text = [string]$first
+    if ([string]::IsNullOrWhiteSpace($text)) { return $null }
+    return $text
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+function Test-WReparseAncestry {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][string]$Candidate
+    )
+    foreach ($entry in $Ancestry) {
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals($entry, $Candidate)) { return $true }
+    }
+    return $false
+}
+
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][string]$VirtualDirectory,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+    # The relative path of a followed entry is named after the LINK path
+    # (the virtual path), never after the real target it resolves to.
+    if ($Depth -ge $State.MaxDepth) {
+        $relative = Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root
+        Add-WReparseError -State $State -RelativePath $relative -Code 'too_deep' `
+            -Message "Depth limit of $($State.MaxDepth) reached; not enumerating."
+        return
+    }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch {
+        # The exception message is localised, so a fixed message is emitted:
+        # the report must be byte-identical under en-US / de-DE / ja-JP.
+        $relative = Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root
+        Add-WReparseError -State $State -RelativePath $relative -Code 'access_denied' `
+            -Message 'Access denied while enumerating the directory.'
+        return
+    }
+
+    foreach ($child in $children) {
+        $childDepth = $Depth + 1
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        $childName = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        $virtualChild = Join-WReparsePath -Parent $VirtualDirectory -Child $childName
+        $relative = Get-WReparseRelativePath -FullPath $virtualChild -Root $State.Root
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = Get-WReparseRawTarget -Item $child
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+            $inScope = $false
+            if ($null -ne $resolved) {
+                $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+            }
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind 'ReparsePoint' `
+                -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                -Depth $childDepth -Size 0))
+
+            if (-not $State.Follow) {
+                # Default mode is strictly read-only and stays inside the scan
+                # root: the reparse point is registered and never entered, and
+                # neither 'cycle' nor 'broken_target' is diagnosed because the
+                # target is never inspected.
+                $State.Skipped++
+                continue
+            }
+            if ($null -eq $resolved -or -not (Test-Path -LiteralPath $resolved)) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+            if (Test-WReparseAncestry -Ancestry $Ancestry -Candidate $resolved) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                    -Message 'The reparse target is an ancestor already visited on this branch.'
+                continue
+            }
+            if (Test-Path -LiteralPath $resolved -PathType Container) {
+                Invoke-WReparseDirectoryWalk -RealDirectory $resolved -VirtualDirectory $virtualChild `
+                    -Depth $childDepth -Ancestry ($Ancestry + $resolved) -State $State
+            }
+            # A link whose target is a file contributes the link record only.
+            continue
+        }
+
+        $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) { $size = [long]$length }
+        }
+        $kind = if ($isContainer) { 'Directory' } else { 'File' }
+        # InScope only carries meaning for reparse points; plain entries are
+        # always reported with $false.
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+            -InScope $false -Depth $childDepth -Size $size))
+
+        if ($isContainer) {
+            $realChildCanonical = $realChild
+            try { $realChildCanonical = Get-WReparseCanonicalPath -Path $realChild } catch { }
+            Invoke-WReparseDirectoryWalk -RealDirectory $realChildCanonical -VirtualDirectory $virtualChild `
+                -Depth $childDepth -Ancestry ($Ancestry + $realChildCanonical) -State $State
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root,
+        [ValidateSet('Never', 'Always')][string]$FollowMode = 'Never',
+        [int]$MaxDepth = 32
+    )
+    # A negative depth limit is clamped to 0: 'no enumeration at all' is the
+    # only sensible reading, and -1 must behave exactly like 0.
+    $effectiveMaxDepth = $MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $state = @{
+        Records  = New-Object System.Collections.ArrayList
+        Errors   = New-Object System.Collections.ArrayList
+        Skipped  = 0
+        Root     = $null
+        Follow   = ($FollowMode -eq 'Always')
+        MaxDepth = $effectiveMaxDepth
+    }
+
+    $canonicalRoot = $null
+    try { $canonicalRoot = Get-WReparseCanonicalPath -Path $Root }
+    catch {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message "Scan root cannot be canonicalised: $Root"
+        return [pscustomobject]@{
+            Root    = [string]$Root
+            Records = @()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+
+    $state.Root = $canonicalRoot
+
+    if (-not (Test-Path -LiteralPath $canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+    if (-not (Test-Path -LiteralPath $canonicalRoot -PathType Container)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = @()
+            Errors  = $state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualDirectory $canonicalRoot `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return [pscustomobject]@{
+        Root    = $canonicalRoot
+        Records = $state.Records.ToArray()
+        Errors  = $state.Errors.ToArray()
+        Skipped = $state.Skipped
+    }
+}
