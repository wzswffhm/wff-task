+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse reference implementation.
+
+# Stable, iterative bottom-up merge sort. Sort-Object is deliberately not used:
+# its default string comparison is culture aware and orders non-ASCII names
+# differently under en-US / de-DE / ja-JP. The ordering key is compared with
+# Compare-WReparsePath (ordinal, case-insensitive, ordinal tie-break) so the
+# result depends on the tree only, never on the host locale or on the order in
+# which the file system enumerator happened to return the entries.
+# Callers wrap the result in @(...) - a PowerShell function always unrolls the
+# array it returns.
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][AllowNull()][object[]]$Items,
+        [Parameter(Mandatory = $true)][scriptblock[]]$KeySelectors
+    )
+
+    $source = @()
+    if ($null -ne $Items) { $source = @($Items) }
+    $count = $source.Count
+    if ($count -eq 0) { return @() }
+    if ($count -eq 1) { return @($source[0]) }
+
+    $selectors = @($KeySelectors)
+    $selectorCount = $selectors.Count
+    $keys = New-Object 'System.Collections.Generic.List[string[]]'
+    foreach ($item in $source) {
+        $row = New-Object 'string[]' $selectorCount
+        for ($selectorIndex = 0; $selectorIndex -lt $selectorCount; $selectorIndex++) {
+            $row[$selectorIndex] = [string](& $selectors[$selectorIndex] $item)
+        }
+        $keys.Add($row)
+    }
+
+    $order = New-Object 'int[]' $count
+    $buffer = New-Object 'int[]' $count
+    for ($index = 0; $index -lt $count; $index++) { $order[$index] = $index }
+
+    $width = 1
+    while ($width -lt $count) {
+        for ($start = 0; $start -lt $count; $start += (2 * $width)) {
+            $middle = $start + $width
+            if ($middle -gt $count) { $middle = $count }
+            $end = $start + (2 * $width)
+            if ($end -gt $count) { $end = $count }
+            $left = $start
+            $right = $middle
+            $write = $start
+            while ($left -lt $middle -and $right -lt $end) {
+                $comparison = Compare-WReparseKeys -Left $keys[$order[$left]] -Right $keys[$order[$right]]
+                if ($comparison -le 0) {
+                    $buffer[$write] = $order[$left]
+                    $left++
+                }
+                else {
+                    $buffer[$write] = $order[$right]
+                    $right++
+                }
+                $write++
+            }
+            while ($left -lt $middle) { $buffer[$write] = $order[$left]; $left++; $write++ }
+            while ($right -lt $end) { $buffer[$write] = $order[$right]; $right++; $write++ }
+        }
+        [Array]::Copy($buffer, $order, $count)
+        $width = $width * 2
+    }
+
+    $sorted = New-Object 'object[]' $count
+    for ($index = 0; $index -lt $count; $index++) { $sorted[$index] = $source[$order[$index]] }
+    return $sorted
+}
+
+# Directories, files and reparse points are three disjoint buckets: a reparse
+# point is never counted as a directory, and a hard link is counted as a file.
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        if ($null -eq $record) { continue }
+        $kind = [string]$record.Kind
+        if ($kind -eq 'File') { $files++ }
+        elseif ($kind -eq 'ReparsePoint') { $reparse++ }
+        elseif ($kind -eq 'Directory') { $directories++ }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+    $followMode = 'Never'
+    if ($Follow) { $followMode = 'Always' }
+
+    $walk = $null
+    try {
+        $walk = Invoke-WReparseWalk -Root $Root -FollowMode $followMode -MaxDepth $MaxDepth
+    }
+    catch {
+        # Never leak an exception: a well formed report is always produced.
+        $fallbackError = New-WReparseError -RelativePath '.' -Code 'access_denied' `
+            -Message ("Scan failed: " + [string]$_.Exception.Message)
+        $walk = @{ Root = $Root; Records = @(); Errors = @($fallbackError); Skipped = 0 }
+    }
+
+    $recordKeys = @({ param($item) [string]$item.RelativePath })
+    $errorKeys = @(
+        { param($item) [string]$item.RelativePath },
+        { param($item) [string]$item.Code },
+        { param($item) [string]$item.Message }
+    )
+    $records = @(Sort-WReparseStable -Items $walk.Records -KeySelectors $recordKeys)
+    $errors = @(Sort-WReparseStable -Items $walk.Errors -KeySelectors $errorKeys)
+
+    $skipped = 0
+    if ($null -ne $walk.Skipped) { $skipped = [int]$walk.Skipped }
+    $stats = Get-WReparseStats -Records $records -Skipped $skipped -ErrorCount $errors.Count
+
+    $reportRoot = [string]$walk.Root
+    if ([string]::IsNullOrEmpty($reportRoot)) { $reportRoot = $Root }
+
+    return New-WReparseReport -Root $reportRoot -Records $records -Errors $errors -Stats $stats
+}
+
+# Serialisation is part of the determinism guarantee: fixed key order, JSON
+# null for absent values, [] for empty collections and a -Depth large enough
+# that no nesting level of the report can ever be truncated.
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$Report
+    )
+    return ($Report | ConvertTo-Json -Depth 12)
+}
