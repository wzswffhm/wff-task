+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse reference implementation.
+
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [AllowNull()]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $adapter = $InputObject.PSObject
+    if ($null -eq $adapter) { return $null }
+    $property = $adapter.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    try { return $property.Value }
+    catch { return $null }
+}
+
+# Maps the provider link type onto the contract vocabulary. Only entries whose
+# file attributes carry FILE_ATTRIBUTE_REPARSE_POINT reach this function, so a
+# hard link (LinkType = 'HardLink', no reparse attribute) is never mapped.
+# Junction and SymbolicLink stay distinct: they are different reparse tags
+# (0xA0000003 vs 0xA000000C) and the report has to tell them apart.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([AllowNull()][AllowEmptyString()][string]$LinkType)
+    if ([string]::IsNullOrWhiteSpace($LinkType)) { return 'Unknown' }
+    switch ($LinkType) {
+        'SymbolicLink' { return 'SymbolicLink' }
+        'Junction' { return 'Junction' }
+        'MountPoint' { return 'MountPoint' }
+        'HardLink' { return 'HardLink' }
+        default { return $LinkType }
+    }
+}
+
+# FILE_ATTRIBUTE_REPARSE_POINT (0x400) is the only trustworthy marker. The
+# measured provider facts list LinkType for hard links too, while Attributes
+# for hard links is ['Archive'] - so LinkType-based detection would misfile a
+# hard link as a reparse point.
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([AllowNull()]$Item)
+    if ($null -eq $Item) { return $false }
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -ne $attributes) {
+        if ($attributes -is [System.IO.FileAttributes]) {
+            return [bool](($attributes -band [System.IO.FileAttributes]::ReparsePoint) -eq [System.IO.FileAttributes]::ReparsePoint)
+        }
+        if ($attributes -is [int] -or $attributes -is [long]) {
+            return [bool](([Convert]::ToInt64($attributes) -band 0x400) -eq 0x400)
+        }
+        $text = [string]$attributes
+        if ($text.IndexOf('ReparsePoint', [System.StringComparison]::OrdinalIgnoreCase) -ge 0) { return $true }
+    }
+    return $false
+}
+
+# The provider hands Target back as System.String[] (a reparse point may carry
+# more than one substitution) and, for entries that are not links at all, as an
+# empty List[string]. PowerShell unrolls a single element array when it is
+# returned from a helper, so the value is always coerced here and the record
+# always stores a plain string.
+function Get-WReparseRawTarget {
+    [CmdletBinding()]
+    param([AllowNull()]$Item)
+    $value = Get-WReparseMemberValue -InputObject $Item -Name 'Target'
+    if ($null -eq $value) { return $null }
+    if ($value -is [string]) {
+        if ([string]::IsNullOrEmpty($value)) { return $null }
+        return $value
+    }
+    $elements = @($value)
+    foreach ($element in $elements) {
+        if ($null -eq $element) { continue }
+        $text = [string]$element
+        if (-not [string]::IsNullOrEmpty($text)) { return $text }
+    }
+    return $null
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+# True when the exception (or one of its inner exceptions) denotes a refused
+# access. Get-ChildItem -ErrorAction Stop surfaces the provider's
+# UnauthorizedAccessException directly, but wrapped forms are handled too.
+function Test-WReparseIsAccessDenied {
+    [CmdletBinding()]
+    param([AllowNull()]$ErrorRecord)
+    if ($null -eq $ErrorRecord) { return $false }
+    $exception = $ErrorRecord.Exception
+    $guard = 0
+    while ($null -ne $exception -and $guard -lt 12) {
+        if ($exception -is [System.UnauthorizedAccessException]) { return $true }
+        if ($exception -is [System.Security.SecurityException]) { return $true }
+        $exception = $exception.InnerException
+        $guard++
+    }
+    $identity = [string]$ErrorRecord.FullyQualifiedErrorId
+    if ($identity.IndexOf('UnauthorizedAccess', [System.StringComparison]::OrdinalIgnoreCase) -ge 0) { return $true }
+    $reason = [string](Get-WReparseMemberValue -InputObject $ErrorRecord.CategoryInfo -Name 'Reason')
+    if ($reason.IndexOf('UnauthorizedAccess', [System.StringComparison]::OrdinalIgnoreCase) -ge 0) { return $true }
+    return $false
+}
+
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        # Real on-disk directory that gets enumerated.
+        [Parameter(Mandatory = $true)][string]$RealDirectory,
+        # Path of the same directory relative to the scan root ('.' for the
+        # root). Entries reached through a followed link are named after the
+        # link, not after the real target.
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativeDirectory,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        # Canonical real paths of every directory on the current branch,
+        # including $RealDirectory itself.
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+
+    if ($Depth -ge $State.MaxDepth) {
+        Add-WReparseError -State $State -RelativePath $RelativeDirectory -Code 'too_deep' `
+            -Message "Depth limit of $($State.MaxDepth) reached; not enumerating."
+        return
+    }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch {
+        $message = 'Access denied while enumerating the directory.'
+        if (-not (Test-WReparseIsAccessDenied -ErrorRecord $_)) {
+            $message = [string]$_.Exception.Message
+        }
+        Add-WReparseError -State $State -RelativePath $RelativeDirectory -Code 'access_denied' -Message $message
+        return
+    }
+
+    foreach ($child in $children) {
+        if ($null -eq $child) { continue }
+        $childDepth = $Depth + 1
+
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        if ([string]::IsNullOrWhiteSpace($realChild)) { continue }
+        $leaf = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        if ([string]::IsNullOrWhiteSpace($leaf)) { $leaf = [string](Split-Path -Path $realChild -Leaf) }
+        if ($RelativeDirectory -eq '.' -or [string]::IsNullOrEmpty($RelativeDirectory)) {
+            $relative = $leaf
+        }
+        else {
+            $relative = $RelativeDirectory + '\' + $leaf
+        }
+
+        try {
+            if (Test-WReparseIsReparsePoint -Item $child) {
+                $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+                $rawTarget = Get-WReparseRawTarget -Item $child
+                $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+
+                $inScope = $false
+                if (-not [string]::IsNullOrWhiteSpace($resolved)) {
+                    $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+                }
+
+                [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative `
+                    -Kind 'ReparsePoint' -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                    -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                    -Depth $childDepth -Size 0))
+
+                if (-not $State.Follow) {
+                    # Registered, never entered: the default mode stays inside
+                    # the scan root no matter where a link points to.
+                    $State.Skipped = [int]$State.Skipped + 1
+                    continue
+                }
+
+                if ([string]::IsNullOrWhiteSpace($resolved) -or
+                    -not (Test-Path -LiteralPath $resolved)) {
+                    Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                        -Message 'The reparse target does not exist.'
+                    continue
+                }
+
+                $resolvedCanonical = Get-WReparseSafeCanonicalPath -Path $resolved
+                if ([string]::IsNullOrWhiteSpace($resolvedCanonical)) { $resolvedCanonical = $resolved }
+
+                $isAncestor = $false
+                foreach ($ancestor in @($Ancestry)) {
+                    if (Test-WReparseSamePath -Left $ancestor -Right $resolvedCanonical) { $isAncestor = $true; break }
+                }
+                if ($isAncestor) {
+                    # Only an ancestor of the current branch is a cycle. Two
+                    # sibling links that point at the same target are not.
+                    Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                        -Message 'The reparse target is an ancestor already visited on this branch.'
+                    continue
+                }
+
+                if (Test-Path -LiteralPath $resolvedCanonical -PathType Container) {
+                    Invoke-WReparseDirectoryWalk -RealDirectory $resolvedCanonical `
+                        -RelativeDirectory $relative -Depth $childDepth `
+                        -Ancestry (@($Ancestry) + $resolvedCanonical) -State $State
+                }
+                # A link whose target is a file is registered but yields no
+                # children.
+                continue
+            }
+
+            $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+            $size = [long]0
+            if (-not $isContainer) {
+                $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+                if ($null -ne $length) { $size = [long]$length }
+            }
+            $kind = 'File'
+            if ($isContainer) { $kind = 'Directory' }
+
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+                -InScope $false -Depth $childDepth -Size $size))
+
+            if ($isContainer) {
+                $realChildCanonical = Get-WReparseSafeCanonicalPath -Path $realChild
+                if ([string]::IsNullOrWhiteSpace($realChildCanonical)) { $realChildCanonical = $realChild }
+                Invoke-WReparseDirectoryWalk -RealDirectory $realChildCanonical `
+                    -RelativeDirectory $relative -Depth $childDepth `
+                    -Ancestry (@($Ancestry) + $realChildCanonical) -State $State
+            }
+        }
+        catch {
+            $message = 'Access denied while enumerating the directory.'
+            if (-not (Test-WReparseIsAccessDenied -ErrorRecord $_)) {
+                $message = [string]$_.Exception.Message
+            }
+            Add-WReparseError -State $State -RelativePath $relative -Code 'access_denied' -Message $message
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [ValidateSet('Never', 'Always')][string]$FollowMode = 'Never',
+        [int]$MaxDepth = 32
+    )
+
+    # A negative limit behaves exactly like 0: the root is not enumerated and
+    # the very same 'too_deep' error (wording included) is reported.
+    $effectiveMaxDepth = $MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $state = @{
+        Records  = (New-Object System.Collections.ArrayList)
+        Errors   = (New-Object System.Collections.ArrayList)
+        Skipped  = 0
+        Root     = $null
+        Follow   = ($FollowMode -eq 'Always')
+        MaxDepth = $effectiveMaxDepth
+    }
+
+    $canonicalRoot = Get-WReparseSafeCanonicalPath -Path $Root
+    if ([string]::IsNullOrWhiteSpace($canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message "Scan root cannot be canonicalised: $Root"
+        return @{ Root = $Root; Records = @(); Errors = $state.Errors.ToArray(); Skipped = 0 }
+    }
+
+    $exists = $false
+    try { $exists = [bool](Test-Path -LiteralPath $canonicalRoot) }
+    catch { $exists = $false }
+    if (-not $exists) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return @{ Root = $canonicalRoot; Records = @(); Errors = $state.Errors.ToArray(); Skipped = 0 }
+    }
+
+    $isContainer = $false
+    try { $isContainer = [bool](Test-Path -LiteralPath $canonicalRoot -PathType Container) }
+    catch { $isContainer = $false }
+    if (-not $isContainer) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return @{ Root = $canonicalRoot; Records = @(); Errors = $state.Errors.ToArray(); Skipped = 0 }
+    }
+
+    $state.Root = $canonicalRoot
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -RelativeDirectory '.' `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return @{
+        Root    = $canonicalRoot
+        Records = $state.Records.ToArray()
+        Errors  = $state.Errors.ToArray()
+        Skipped = [int]$state.Skipped
+    }
+}
