+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation. See the contract under docs/
+
+# Canonical form used for every comparison and for the report:
+#   * full (rooted) path with '.' and '..' collapsed
+#   * no trailing directory separator, except for a volume root ('C:\')
+#     or a UNC share root ('\\server\share')
+#   * the caller's casing is preserved verbatim (the report shows real paths,
+#     so lower-casing would corrupt 'Root' and 'ResolvedTarget')
+#   * Win32 device path prefixes ('\\?\' and '\??\') are removed so that the
+#     result can be compared with, and handed back to, the file system provider
+# Throws when the string cannot be canonicalised at all; callers turn that into
+# the 'invalid_argument' error code.
+function Get-WReparseCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path
+    )
+    if ([string]::IsNullOrWhiteSpace($Path)) {
+        throw ([System.ArgumentException]::new('The path is not of a legal form.', 'Path'))
+    }
+
+    $candidate = $Path
+    if ($candidate.StartsWith('\\?\UNC\', [System.StringComparison]::OrdinalIgnoreCase)) {
+        $candidate = '\' + $candidate.Substring(7)
+    }
+    elseif ($candidate.StartsWith('\??\UNC\', [System.StringComparison]::OrdinalIgnoreCase)) {
+        $candidate = '\' + $candidate.Substring(7)
+    }
+    elseif ($candidate.StartsWith('\\?\', [System.StringComparison]::Ordinal) -or
+            $candidate.StartsWith('\??\', [System.StringComparison]::Ordinal)) {
+        $candidate = $candidate.Substring(4)
+    }
+
+    $full = [System.IO.Path]::GetFullPath($candidate)
+    if ([string]::IsNullOrWhiteSpace($full)) {
+        throw ([System.ArgumentException]::new('The path is not of a legal form.', 'Path'))
+    }
+    $full = $full.Replace([char]'/', [char]'\')
+
+    $trimmed = $full.TrimEnd([char]'\')
+    if ($trimmed.Length -eq 0) { return $full }
+    # 'C:' alone would be "the current directory of volume C", so a volume root
+    # keeps its separator.
+    if ($trimmed.Length -eq 2 -and $trimmed[1] -eq ':') { return ($trimmed + '\') }
+    if ($trimmed.StartsWith('\\')) {
+        # UNC: never trim below '\\server\share'.
+        $serverEnd = $trimmed.IndexOf([char]'\', 2)
+        if ($serverEnd -lt 0) { return ($trimmed + '\') }
+        $shareEnd = $trimmed.IndexOf([char]'\', $serverEnd + 1)
+        if ($shareEnd -lt 0) { return $trimmed }
+        return $trimmed
+    }
+    return $trimmed
+}
+
+# Internal helper: canonicalise without ever throwing.
+function Get-WReparseSafeCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][AllowEmptyString()][string]$Path
+    )
+    if ([string]::IsNullOrWhiteSpace($Path)) { return $null }
+    try {
+        $value = Get-WReparseCanonicalPath -Path $Path
+        if ([string]::IsNullOrWhiteSpace($value)) { return $null }
+        return $value
+    }
+    catch {
+        return $null
+    }
+}
+
+# Directory-boundary aware containment. 'C:\root-extra' is NOT inside 'C:\root'
+# even though 'C:\root-extra'.StartsWith('C:\root') is true, so the prefix test
+# has to happen on a separator boundary. The root itself counts as within the
+# root. Windows path comparison is case-insensitive, hence OrdinalIgnoreCase -
+# an ordinal (never culture aware) comparison keeps the answer identical on
+# every host locale.
+function Test-WReparseWithinRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root
+    )
+    if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) {
+        return $false
+    }
+    $p = Get-WReparseSafeCanonicalPath -Path $Path
+    $r = Get-WReparseSafeCanonicalPath -Path $Root
+    if ([string]::IsNullOrWhiteSpace($p) -or [string]::IsNullOrWhiteSpace($r)) {
+        return $false
+    }
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return $true }
+    $prefix = $r
+    if (-not $prefix.EndsWith('\')) { $prefix = $prefix + '\' }
+    return [bool]($p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase))
+}
+
+# True when two path strings denote the same file system object. Ordinal,
+# case-insensitive, boundary-safe: never culture aware.
+function Test-WReparseSamePath {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][AllowEmptyString()][string]$Left,
+        [AllowNull()][AllowEmptyString()][string]$Right
+    )
+    if ([string]::IsNullOrWhiteSpace($Left) -or [string]::IsNullOrWhiteSpace($Right)) { return $false }
+    return [bool][System.StringComparer]::OrdinalIgnoreCase.Equals($Left, $Right)
+}
+
+# Relative path of a scanned entry with respect to the scan root, using the
+# Windows separator. The root itself yields '.'.
+function Get-WReparseRelativePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$FullPath,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root
+    )
+    $p = Get-WReparseSafeCanonicalPath -Path $FullPath
+    $r = Get-WReparseSafeCanonicalPath -Path $Root
+    if ([string]::IsNullOrWhiteSpace($p)) { return [string]$FullPath }
+    if ([string]::IsNullOrWhiteSpace($r)) { return $p }
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return '.' }
+    $prefix = $r
+    if (-not $prefix.EndsWith('\')) { $prefix = $prefix + '\' }
+    if ($p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $p.Substring($prefix.Length)
+    }
+    return $p
+}
+
+# The reparse target stored on disk may be relative. A relative target is
+# resolved against the directory that CONTAINS the link - never against the
+# process working directory and never against the scan root (measured:
+# 'link at C:\tree\links\rel' + '..\docs' => 'C:\tree\docs' whatever the CWD).
+# Returns $null when there is no target or when it cannot be resolved.
+function Resolve-WReparseLinkTarget {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$LinkFullPath,
+        [AllowNull()][AllowEmptyString()][string]$RawTarget
+    )
+    if ([string]::IsNullOrWhiteSpace($RawTarget)) { return $null }
+    $raw = $RawTarget
+
+    if ([System.IO.Path]::IsPathRooted($raw)) {
+        $resolved = Get-WReparseSafeCanonicalPath -Path $raw
+        if ([string]::IsNullOrWhiteSpace($resolved)) { return $null }
+        return $resolved
+    }
+
+    $linkDirectory = $null
+    $canonicalLink = Get-WReparseSafeCanonicalPath -Path $LinkFullPath
+    if (-not [string]::IsNullOrWhiteSpace($canonicalLink)) {
+        $linkDirectory = [System.IO.Path]::GetDirectoryName($canonicalLink)
+    }
+    if ([string]::IsNullOrWhiteSpace($linkDirectory)) {
+        try { $linkDirectory = [System.IO.Path]::GetDirectoryName($LinkFullPath) }
+        catch { $linkDirectory = $null }
+    }
+    if ([string]::IsNullOrWhiteSpace($linkDirectory)) { return $null }
+
+    $combined = $null
+    try { $combined = [System.IO.Path]::Combine($linkDirectory, $raw) }
+    catch { return $null }
+    if ([string]::IsNullOrWhiteSpace($combined)) { return $null }
+    return Get-WReparseSafeCanonicalPath -Path $combined
+}
+
+# Stable ordering key: ordinal, case-insensitive first, with a case-sensitive
+# tie-break so that two entries whose names differ only by case keep a
+# deterministic position. Ordinal (never culture aware) comparison is what
+# makes the report byte-identical under en-US, de-DE and ja-JP: it reproduces
+# the measured order 'a.txt, B.txt, Z.txt, A-umlaut.txt, o-umlaut.txt' on every
+# host, where culture aware Sort-Object reorders the same names per locale.
+function Compare-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][AllowEmptyString()][string]$Left,
+        [AllowNull()][AllowEmptyString()][string]$Right
+    )
+    $l = $Left
+    $r = $Right
+    if ($null -eq $l) { $l = [string]::Empty }
+    if ($null -eq $r) { $r = [string]::Empty }
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($l, $r)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($l, $r)
+}
+
+# Compares two key tuples (used to order Errors by RelativePath, then Code,
+# then Message so that the error list is total and therefore deterministic).
+function Compare-WReparseKeys {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][string[]]$Left,
+        [AllowNull()][string[]]$Right
+    )
+    $l = @($Left)
+    $r = @($Right)
+    $shared = [Math]::Min($l.Count, $r.Count)
+    for ($i = 0; $i -lt $shared; $i++) {
+        $comparison = Compare-WReparsePath -Left ([string]$l[$i]) -Right ([string]$r[$i])
+        if ($comparison -ne 0) { return $comparison }
+    }
+    return $l.Count.CompareTo($r.Count)
+}
