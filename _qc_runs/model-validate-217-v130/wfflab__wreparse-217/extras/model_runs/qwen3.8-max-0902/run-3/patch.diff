+$missing = Join-Path $base 'does-not-exist'
+$nf = Get-WReparseReport -Root $missing
+Check '7 not_found code' $nf.Errors[0].Code 'not_found'
+Check '7 not_found relative' $nf.Errors[0].RelativePath '.'
+Check '7 not_found message' $nf.Errors[0].Message ('Scan root does not exist: ' + $missing)
+Check '7 not_found stats' ($nf.Stats | ConvertTo-Json -Compress) '{"Directories":0,"Files":0,"ReparsePoints":0,"Skipped":0,"Errors":1}'
+Check '7 not_found root' $nf.Root $missing
+$st = Get-WReparseReport -Root (Join-Path $outside 'secret.txt')
+Check '7 structure code' $st.Errors[0].Code 'structure'
+Check '7 structure message' $st.Errors[0].Message ('Scan root is not a directory: ' + (Join-Path $outside 'secret.txt'))
+Check '7 structure records' (CountOf $st.Records) 0
+$ia = Get-WReparseReport -Root 'C:\bad<>|path'
+Check '7 invalid_argument' $ia.Errors[0].Code 'invalid_argument'
+Check '7 invalid_argument relative' $ia.Errors[0].RelativePath '.'
+Check '7 invalid_argument stats' ($ia.Stats | ConvertTo-Json -Compress) '{"Directories":0,"Files":0,"ReparsePoints":0,"Skipped":0,"Errors":1}'
+Check '7 three codes differ' (@($nf.Errors[0].Code, $st.Errors[0].Code, $ia.Errors[0].Code | Sort-Object -Unique) -join ',') 'invalid_argument,not_found,structure'
+Check '7 only known codes' (CountOf ($follow.Errors | Where-Object { @('not_found','access_denied','cycle','broken_target','structure','too_deep','invalid_argument') -notcontains $_.Code })) 0
+Check '15 no cycle/broken without follow' (CountOf ($report.Errors | Where-Object { $_.Code -eq 'cycle' -or $_.Code -eq 'broken_target' })) 0
+
+# ---- 3.6 empty tree ---------------------------------------------------------
+$emptyDir = [System.IO.Path]::GetFullPath((Join-Path $base 'empty-dir'))
+New-Item -ItemType Directory -Path $emptyDir -Force | Out-Null
+$emptyReport = Get-WReparseReport -Root $emptyDir
+$emptyJson = ConvertTo-WReparseJson -Report $emptyReport
+Write-Host '--- empty tree json ---'
+Write-Host $emptyJson
+Check '3.6 empty records' (CountOf $emptyReport.Records) 0
+Check '3.6 empty stats' ($emptyReport.Stats | ConvertTo-Json -Compress) '{"Directories":0,"Files":0,"ReparsePoints":0,"Skipped":0,"Errors":0}'
+Check '11 empty arrays in json' ([bool]($emptyJson -match '"Records":\s*\[\s*\]' -and $emptyJson -match '"Errors":\s*\[\s*\]')) $true
+Check '13 field set' (($emptyReport.PSObject.Properties | ForEach-Object { $_.Name }) -join '/') 'SchemaVersion/Root/Records/Errors/Stats'
+Check '13 record field set' (($report.Records[0].PSObject.Properties | ForEach-Object { $_.Name }) -join '/') 'RelativePath/Kind/ReparseKind/Target/ResolvedTarget/InScope/Depth/Size'
+Check '13 error field set' (($nf.Errors[0].PSObject.Properties | ForEach-Object { $_.Name }) -join '/') 'RelativePath/Code/Message'
+Check '13 stats field set' (($report.Stats.PSObject.Properties | ForEach-Object { $_.Name }) -join '/') 'Directories/Files/ReparsePoints/Skipped/Errors'
+Check '13 json key order' ([bool]($emptyJson.IndexOf('"SchemaVersion"') -lt $emptyJson.IndexOf('"Root"') -and $emptyJson.IndexOf('"Root"') -lt $emptyJson.IndexOf('"Records"') -and $emptyJson.IndexOf('"Records"') -lt $emptyJson.IndexOf('"Errors"') -and $emptyJson.IndexOf('"Errors"') -lt $emptyJson.IndexOf('"Stats"'))) $true
+Check '13 no GeneratedAt' ([bool]($emptyJson -match 'GeneratedAt')) $false
+Check '3.1 schema version' (Get-WReparseSchemaVersion) 'wreparse/1.0'
+Check '3.1 schema field' $emptyReport.SchemaVersion 'wreparse/1.0'
+Check '3.1 root field' $emptyReport.Root $emptyDir
+Check '3.1 root is string' ($emptyReport.Root -is [string]) $true
+Check '3.1 records is array' ($emptyReport.Records -is [System.Array]) $true
+
+# ---- exports ----------------------------------------------------------------
+$cmds = @(Get-Command -Module WReparse | ForEach-Object { $_.Name } | Sort-Object)
+Check '2 exports' ($cmds -join ',') 'ConvertTo-WReparseJson,Get-WReparseCanonicalPath,Get-WReparseReport,Get-WReparseSchemaVersion,Resolve-WReparseLinkTarget,Test-WReparseWithinRoot'
+$exported = @((Get-Module WReparse).ExportedFunctions.Keys | Sort-Object)
+Check '2 exported functions' ($exported -join ',') 'ConvertTo-WReparseJson,Get-WReparseCanonicalPath,Get-WReparseReport,Get-WReparseSchemaVersion,Resolve-WReparseLinkTarget,Test-WReparseWithinRoot'
+$common = @('Verbose','Debug','ErrorAction','WarningAction','InformationAction','ErrorVariable','WarningVariable','InformationVariable','OutVariable','OutBuffer','PipelineVariable')
+$params = @((Get-Command Get-WReparseReport).Parameters.Keys | Where-Object { $common -notcontains $_ } | Sort-Object)
+Check '2 parameter names' ($params -join ',') 'Follow,MaxDepth,Root'
+Check '2 maxdepth type' ((Get-Command Get-WReparseReport).Parameters['MaxDepth'].ParameterType.Name) 'Int32'
+Check '2 follow is switch' ((Get-Command Get-WReparseReport).Parameters['Follow'].ParameterType.Name) 'SwitchParameter'
+$params2 = @((Get-Command Resolve-WReparseLinkTarget).Parameters.Keys | Where-Object { $common -notcontains $_ } | Sort-Object)
+Check '2 resolve parameter names' ($params2 -join ',') 'LinkFullPath,RawTarget'
+$params3 = @((Get-Command Test-WReparseWithinRoot).Parameters.Keys | Where-Object { $common -notcontains $_ } | Sort-Object)
+Check '2 within parameter names' ($params3 -join ',') 'Path,Root'
+Check '2 schema version no params' (CountOf ((Get-Command Get-WReparseSchemaVersion).Parameters.Keys | Where-Object { $common -notcontains $_ })) 0
+
+# ---- deep tree --------------------------------------------------------------
+$deep = [System.IO.Path]::GetFullPath((Join-Path $base 'deep'))
+$p = $deep
+for ($i = 1; $i -le 40; $i++) { $p = Join-Path $p ('d' + $i) }
+New-Item -ItemType Directory -Path $p -Force | Out-Null
+Set-Content -LiteralPath (Join-Path $p 'leaf.txt') -Value 'x' -NoNewline -Encoding ASCII
+$deepReport = Get-WReparseReport -Root $deep
+Check 'deep default stops at 32' (($deepReport.Records | ForEach-Object { $_.Depth } | Measure-Object -Maximum).Maximum) 32
+Check 'deep too_deep count' (CountOf ($deepReport.Errors | Where-Object { $_.Code -eq 'too_deep' })) 1
+Check 'deep too_deep path' ($deepReport.Errors[0].RelativePath) ((1..32 | ForEach-Object { 'd' + $_ }) -join '\')
+Check 'deep record count' (CountOf $deepReport.Records) 32
+
+# ---- access denied ----------------------------------------------------------
+$locked = [System.IO.Path]::GetFullPath((Join-Path $base 'locked-tree'))
+New-Item -ItemType Directory -Path (Join-Path $locked 'denied') -Force | Out-Null
+Set-Content -LiteralPath (Join-Path $locked 'denied\inner.txt') -Value 'x' -NoNewline -Encoding ASCII
+Set-Content -LiteralPath (Join-Path $locked 'visible.txt') -Value 'x' -NoNewline -Encoding ASCII
+icacls (Join-Path $locked 'denied') /deny "$($env:USERNAME):(OI)(CI)(RX)" | Out-Null
+$deniedActually = $false
+try { @(Get-ChildItem -LiteralPath (Join-Path $locked 'denied') -Force -ErrorAction Stop) | Out-Null } catch { $deniedActually = $true }
+$lockedReport = Get-WReparseReport -Root $locked
+Write-Host ('locked errors: ' + (($lockedReport.Errors | ForEach-Object { "$($_.RelativePath)=$($_.Code)" }) -join ','))
+if ($deniedActually) {
+    Check 'ad access_denied reported' (($lockedReport.Errors | ForEach-Object { "$($_.RelativePath)=$($_.Code)" }) -join ',') 'denied=access_denied'
+    Check 'ad stats errors' $lockedReport.Stats.Errors 1
+} else {
+    Check 'ad (deny bypassed) inner visible' (CountOf ($lockedReport.Records | Where-Object { $_.RelativePath -eq 'denied\inner.txt' })) 1
+}
+Check 'ad denied dir still recorded' (CountOf ($lockedReport.Records | Where-Object { $_.RelativePath -eq 'denied' })) 1
+Check 'ad sibling recorded' (CountOf ($lockedReport.Records | Where-Object { $_.RelativePath -eq 'visible.txt' })) 1
+icacls (Join-Path $locked 'denied') /remove:d "$($env:USERNAME)" | Out-Null
+
+# ---- culture independence ---------------------------------------------------
+$cultures = @('en-US', 'de-DE', 'ja-JP')
+$old = [System.Threading.Thread]::CurrentThread.CurrentCulture
+$oldUi = [System.Threading.Thread]::CurrentThread.CurrentUICulture
+foreach ($c in $cultures) {
+    [System.Threading.Thread]::CurrentThread.CurrentCulture = [System.Globalization.CultureInfo]::GetCultureInfo($c)
+    [System.Threading.Thread]::CurrentThread.CurrentUICulture = [System.Globalization.CultureInfo]::GetCultureInfo($c)
+    Check "14 byte identical under $c" (ConvertTo-WReparseJson -Report (Get-WReparseReport -Root $root)) $jsonDefault
+}
+[System.Threading.Thread]::CurrentThread.CurrentCulture = $old
+[System.Threading.Thread]::CurrentThread.CurrentUICulture = $oldUi
+
+Write-Host ''
+if ($script:fail -eq 0) { Write-Host 'ALL CHECKS PASSED' } else { Write-Host "$script:fail CHECK(S) DIFFERED" }
+
+Remove-Item -LiteralPath $base -Recurse -Force -ErrorAction SilentlyContinue
+exit $script:fail
