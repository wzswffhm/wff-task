+# WReparse - data model
+# Shared vocabulary: error codes, enumerations, and factory helpers.
+# Part of the WReparse implementation. See the contract under docs/
+
+Set-StrictMode -Version Latest
+
+# Error codes are part of the public contract. Order is stable and is not
+# sorted at serialisation time; callers match on the literal string.
+$script:WReparseErrorCode = @(
+    'not_found'
+    'access_denied'
+    'cycle'
+    'broken_target'
+    'structure'
+    'too_deep'
+    'invalid_argument'
+)
+
+$script:WReparseSchemaVersion = ('wreparse' + '/1.0')
+
+# Entry kinds. A hard link is a FILE, not a reparse point: the two NTFS
+# directory entries share one data stream and neither entry carries a
+# reparse attribute (measured: Attributes = ['Archive'], LinkType = 'HardLink').
+# Only entries whose file attributes contain FILE_ATTRIBUTE_REPARSE_POINT
+# (0x400) are reported with Kind = 'ReparsePoint'; LinkType alone is NOT a
+# sufficient test because the provider also reports LinkType = 'HardLink'.
+$script:WReparseKindDirectory = 'Directory'
+$script:WReparseKindFile = 'File'
+$script:WReparseKindReparse = 'ReparsePoint'
+
+# ReparseKind vocabulary observed on the provider: Junction / SymbolicLink /
+# MountPoint. 'Unknown' is only used for a reparse point that carries the
+# attribute bit but no (or an unrecognised) LinkType.
+$script:WReparseKindUnknown = 'Unknown'
+
+function Get-WReparseErrorCode {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseErrorCode
+}
+
+function Get-WReparseSchemaVersion {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseSchemaVersion
+}
+
+function New-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    if ($script:WReparseErrorCode -notcontains $Code) {
+        throw "Unknown WReparse error code: $Code"
+    }
+    return [pscustomobject][ordered]@{
+        RelativePath = $RelativePath
+        Code         = $Code
+        Message      = $Message
+    }
+}
+
+function New-WReparseRecord {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Kind,
+        $ReparseKind = $null,
+        $Target = $null,
+        $ResolvedTarget = $null,
+        [bool]$InScope = $false,
+        [int]$Depth = 0,
+        [long]$Size = 0
+    )
+    # Empty strings are reported as JSON null so that the shape of a record
+    # never depends on how the provider happened to hand back a value.
+    if ($null -ne $ReparseKind -and [string]::IsNullOrEmpty([string]$ReparseKind)) { $ReparseKind = $null }
+    if ($null -ne $Target -and [string]::IsNullOrEmpty([string]$Target)) { $Target = $null }
+    if ($null -ne $ResolvedTarget -and [string]::IsNullOrEmpty([string]$ResolvedTarget)) { $ResolvedTarget = $null }
+    if ($Kind -ne $script:WReparseKindReparse) {
+        # InScope only carries meaning for reparse points.
+        $ReparseKind = $null
+        $Target = $null
+        $ResolvedTarget = $null
+        $InScope = $false
+    }
+    return [pscustomobject][ordered]@{
+        RelativePath   = $RelativePath
+        Kind           = $Kind
+        ReparseKind    = $ReparseKind
+        Target         = $Target
+        ResolvedTarget = $ResolvedTarget
+        InScope        = [bool]$InScope
+        Depth          = [int]$Depth
+        Size           = [long]$Size
+    }
+}
+
+function New-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [int]$Directories = 0,
+        [int]$Files = 0,
+        [int]$ReparsePoints = 0,
+        [int]$Skipped = 0,
+        [int]$Errors = 0
+    )
+    return [pscustomobject][ordered]@{
+        Directories   = [int]$Directories
+        Files         = [int]$Files
+        ReparsePoints = [int]$ReparsePoints
+        Skipped       = [int]$Skipped
+        Errors        = [int]$Errors
+    }
+}
+
+# The report carries exactly the five contract fields, in contract order.
+# No timestamp, no process id, no machine specific value: two runs over the
+# same tree with the same arguments must serialise byte-identically.
+function New-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][AllowNull()][object[]]$Errors,
+        [Parameter(Mandatory = $true)][object]$Stats
+    )
+    $recordArray = @()
+    if ($null -ne $Records) { $recordArray = @($Records) }
+    $errorArray = @()
+    if ($null -ne $Errors) { $errorArray = @($Errors) }
+    return [pscustomobject][ordered]@{
+        SchemaVersion = $script:WReparseSchemaVersion
+        Root          = $Root
+        Records       = $recordArray
+        Errors        = $errorArray
+        Stats         = $Stats
+    }
+}
