+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation.
+#
+# Canonical form used for every comparison and for the report:
+#   * full (rooted) path with '.' and '..' collapsed
+#   * separators normalised to '\'
+#   * no trailing directory separator, except for a volume root ('C:\')
+#   * the casing supplied by the caller / the file system is PRESERVED
+#     (canonicalisation never lower-cases: RelativePath, Root, Target and
+#     ResolvedTarget are reported exactly as observed on disk)
+
+# Canonicalises a path. Throws when the string cannot be canonicalised, which is
+# how the 'invalid_argument' error of the contract is detected.
+function Get-WReparseCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Path
+    )
+    if ([string]::IsNullOrWhiteSpace($Path)) {
+        throw (New-Object System.ArgumentException('The path is empty.', 'Path'))
+    }
+    $full = [System.IO.Path]::GetFullPath($Path)
+    if ([string]::IsNullOrWhiteSpace($full)) {
+        throw (New-Object System.ArgumentException('The path cannot be canonicalised.', 'Path'))
+    }
+    $trimmed = $full.TrimEnd([char]'\')
+    if ($trimmed.Length -eq 0) { return $full }
+    # A volume root keeps its separator: 'C:' is not a usable path.
+    if ($trimmed.Length -eq 2 -and $trimmed[1] -eq [char]':') {
+        $trimmed = $trimmed + [char]'\'
+    }
+    return $trimmed
+}
+
+# Canonicalisation that never throws - used inside the walker, where an odd
+# child path must not abort the whole scan.
+function Get-WReparseSafeCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Path
+    )
+    if ([string]::IsNullOrWhiteSpace($Path)) { return [string]$Path }
+    try {
+        return Get-WReparseCanonicalPath -Path $Path
+    }
+    catch {
+        return ([string]$Path).TrimEnd([char]'\')
+    }
+}
+
+# Directory-boundary aware containment. 'C:\root-extra' is NOT inside 'C:\root'
+# even though 'C:\root-extra'.StartsWith('C:\root') is true, so the comparison
+# is done against the root plus a separator. The root itself counts as within the
+# root. Windows path comparison is case-insensitive, hence OrdinalIgnoreCase -
+# an ordinal comparison, never a culture-aware one.
+function Test-WReparseWithinRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root
+    )
+    if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) {
+        return $false
+    }
+    $p = Get-WReparseCanonicalPath -Path $Path
+    $r = Get-WReparseCanonicalPath -Path $Root
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return $true }
+    $prefix = $r
+    if (-not $prefix.EndsWith([string][char]'\')) { $prefix = $prefix + [char]'\' }
+    return $p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
+}
+
+# Relative path of a scanned entry with respect to the scan root, using the
+# Windows separator. The root itself yields '.'.
+function Get-WReparseRelativePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$FullPath,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root
+    )
+    $p = [string]$FullPath
+    $r = [string]$Root
+    if ([System.StringComparer]::OrdinalIgnoreCase.Equals($p, $r)) { return '.' }
+    $prefix = $r
+    if (-not $prefix.EndsWith([string][char]'\')) { $prefix = $prefix + [char]'\' }
+    if ($p.Length -gt $prefix.Length -and
+        $p.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $p.Substring($prefix.Length)
+    }
+    # Fall back to canonicalisation for callers that pass an unrelated form.
+    try {
+        $cp = Get-WReparseCanonicalPath -Path $p
+        $cr = Get-WReparseCanonicalPath -Path $r
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals($cp, $cr)) { return '.' }
+        $cprefix = $cr
+        if (-not $cprefix.EndsWith([string][char]'\')) { $cprefix = $cprefix + [char]'\' }
+        if ($cp.StartsWith($cprefix, [System.StringComparison]::OrdinalIgnoreCase)) {
+            return $cp.Substring($cprefix.Length)
+        }
+        return $cp
+    }
+    catch {
+        return $p
+    }
+}
+
+# The reparse target stored on disk may be relative. A relative target is
+# resolved against the directory that CONTAINS the link - never against the
+# process working directory and never against the scan root - so the result does
+# not depend on where the caller happens to be. Returns $null when there is no
+# target or when the target string cannot be turned into a path.
+function Resolve-WReparseLinkTarget {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$LinkFullPath,
+        [AllowNull()][AllowEmptyString()][string]$RawTarget
+    )
+    if ([string]::IsNullOrWhiteSpace($RawTarget)) { return $null }
+    $raw = ([string]$RawTarget).Trim()
+    # NT namespace prefixes carry no meaning for containment checks.
+    if ($raw.StartsWith('\\?\UNC\')) {
+        $raw = '\\' + $raw.Substring(8)
+    }
+    elseif ($raw.StartsWith('\\?\') -or $raw.StartsWith('\\.\')) {
+        $raw = $raw.Substring(4)
+    }
+    if ($raw.Length -eq 0) { return $null }
+    try {
+        $linkDirectory = $null
+        if (-not [string]::IsNullOrWhiteSpace($LinkFullPath)) {
+            $linkDirectory = [System.IO.Path]::GetDirectoryName($LinkFullPath)
+        }
+        $candidate = $null
+        if ($raw.StartsWith('\\')) {
+            # UNC path: already fully rooted.
+            $candidate = $raw
+        }
+        elseif ($raw.StartsWith('\')) {
+            # Rooted on the link's own volume - anchor it there, not on the
+            # volume of the process working directory.
+            $volume = $null
+            if (-not [string]::IsNullOrWhiteSpace($linkDirectory)) {
+                $volume = [System.IO.Path]::GetPathRoot($linkDirectory)
+            }
+            if ([string]::IsNullOrWhiteSpace($volume)) {
+                $volume = [System.IO.Path]::GetPathRoot([System.IO.Path]::GetFullPath('.'))
+            }
+            $candidate = $volume.TrimEnd([char]'\') + '\' + $raw.TrimStart([char]'\')
+        }
+        elseif ([System.IO.Path]::IsPathRooted($raw)) {
+            $candidate = $raw
+        }
+        else {
+            if ([string]::IsNullOrWhiteSpace($linkDirectory)) {
+                $linkDirectory = [System.IO.Path]::GetFullPath('.')
+            }
+            $candidate = [System.IO.Path]::Combine($linkDirectory, $raw)
+        }
+        return Get-WReparseCanonicalPath -Path $candidate
+    }
+    catch {
+        return $null
+    }
+}
+
+# Stable ordering key: ordinal, case-insensitive first, with a case-sensitive
+# ordinal tie-break so that two entries whose names differ only by case keep a
+# deterministic position. This reproduces the measured order of the observed
+# provider facts on every host culture (en-US, de-DE, ja-JP alike) - Sort-Object
+# and any other culture-aware comparison must not be used here.
+function Compare-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Left,
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Right
+    )
+    $left = [string]$Left
+    $right = [string]$Right
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($left, $right)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($left, $right)
+}
+
+# Case-insensitive membership test over a list of canonical paths.
+function Test-WReparsePathInList {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path,
+        [AllowNull()][AllowEmptyCollection()][string[]]$List
+    )
+    if ($null -eq $List) { return $false }
+    foreach ($item in $List) {
+        if ($null -eq $item) { continue }
+        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([string]$item, [string]$Path)) {
+            return $true
+        }
+    }
+    return $false
+}
