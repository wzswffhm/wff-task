+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse implementation.
+#
+# Rules implemented here (docs/REPARSE-CONTRACT.md, calibrated against
+# assets/observed-provider-facts.json):
+#   * an entry is a reparse point if and only if its file attributes carry
+#     FILE_ATTRIBUTE_REPARSE_POINT (0x400). The provider also reports a non-empty
+#     LinkType for hard links, which are plain FILES - LinkType alone must not be
+#     used for the decision;
+#   * ReparseKind is the provider LinkType mapped one to one (Junction stays
+#     Junction, SymbolicLink stays SymbolicLink, MountPoint stays MountPoint);
+#   * Target is the raw string as stored on disk (never a collection),
+#     ResolvedTarget its canonical absolute form, InScope says whether the
+#     resolved target lives inside the scan root at a directory boundary;
+#   * InScope is only meaningful for reparse points; ordinary files and
+#     directories always report InScope = $false;
+#   * the scan root itself never produces a record, its children have Depth = 1;
+#   * without -Follow every reparse point is registered, counted as Skipped and
+#     never entered; no cycle and no broken_target error is produced;
+#   * with -Follow the target is entered under the VIRTUAL path of the link
+#     (never under the real target path). A target that is an ancestor of the
+#     current branch is a cycle, a target that cannot be resolved or does not
+#     exist is broken_target, a target that is a file yields no children, and two
+#     sibling links pointing at the same target are both entered;
+#   * a directory whose Depth reaches -MaxDepth is recorded but not enumerated
+#     and produces one too_deep error against its own relative path. A negative
+#     -MaxDepth behaves exactly like 0.
+
+# Reads a property without tripping over providers that do not expose it.
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
+# Maps the provider link type to the contract vocabulary. Only entries whose file
+# attributes carry FILE_ATTRIBUTE_REPARSE_POINT reach this function, so a hard
+# link (which has a link type but no reparse attribute) is never mapped.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([AllowNull()][AllowEmptyString()][string]$LinkType)
+    switch ([string]$LinkType) {
+        $script:WReparseLinkSymbolicLink { return $script:WReparseLinkSymbolicLink }
+        $script:WReparseLinkJunction     { return $script:WReparseLinkJunction }
+        $script:WReparseLinkMountPoint   { return $script:WReparseLinkMountPoint }
+        $script:WReparseLinkHardLink     { return $script:WReparseLinkHardLink }
+        default                           { return $script:WReparseLinkUnknown }
+    }
+}
+
+# A reparse point is defined by the FILE_ATTRIBUTE_REPARSE_POINT bit (0x400),
+# which the provider surfaces through .Attributes. Hard links do not carry it and
+# are therefore reported as ordinary files.
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowNull()]$Item)
+    if ($null -eq $Item) { return $false }
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return $false }
+    $numeric = -1
+    if ($attributes -is [int]) {
+        $numeric = [int]$attributes
+    }
+    elseif ($attributes -is [System.Enum]) {
+        $numeric = [int]$attributes
+    }
+    else {
+        try { $numeric = [int][System.IO.FileAttributes]([string]$attributes) }
+        catch { $numeric = -1 }
+    }
+    if ($numeric -lt 0) { return $false }
+    return (($numeric -band $script:WReparseAttributeReparsePoint) -ne 0)
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$VirtualDirectory,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][AllowNull()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+
+    $relativeSelf = Get-WReparseRelativePath -FullPath $VirtualDirectory -Root $State.Root
+
+    if ($Depth -ge $State.MaxDepth) {
+        Add-WReparseError -State $State -RelativePath $relativeSelf -Code 'too_deep' `
+            -Message ('Depth limit of ' + [string]$State.MaxDepth + ' reached; not enumerating.')
+        return
+    }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch [System.UnauthorizedAccessException] {
+        Add-WReparseError -State $State -RelativePath $relativeSelf -Code 'access_denied' `
+            -Message 'Access denied while enumerating the directory.'
+        return
+    }
+    catch [System.Security.SecurityException] {
+        Add-WReparseError -State $State -RelativePath $relativeSelf -Code 'access_denied' `
+            -Message 'Access denied while enumerating the directory.'
+        return
+    }
+    catch {
+        $message = [string](Get-WReparseMemberValue -InputObject $_.Exception -Name 'Message')
+        if ([string]::IsNullOrWhiteSpace($message)) {
+            $message = 'The directory could not be enumerated.'
+        }
+        Add-WReparseError -State $State -RelativePath $relativeSelf -Code 'access_denied' `
+            -Message $message
+        return
+    }
+
+    foreach ($child in $children) {
+        if ($null -eq $child) { continue }
+        $childDepth = $Depth + 1
+        $realChild = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        $name = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        if ([string]::IsNullOrEmpty($name)) { $name = [string](Split-Path -Leaf $realChild) }
+        $virtualChild = Join-Path $VirtualDirectory $name
+        $relative = Get-WReparseRelativePath -FullPath $virtualChild -Root $State.Root
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTargetValue = Get-WReparseMemberValue -InputObject $child -Name 'Target'
+            $rawTarget = ConvertTo-WReparseTargetString -Value $rawTargetValue
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $realChild -RawTarget $rawTarget
+
+            $inScope = $false
+            if (-not [string]::IsNullOrEmpty($resolved)) {
+                $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+            }
+
+            [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative `
+                -Kind $script:WReparseKindReparse `
+                -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                -Target $rawTarget -ResolvedTarget $resolved -InScope $inScope `
+                -Depth $childDepth -Size 0))
+
+            if (-not $State.Follow) {
+                # Register only. Nothing is entered, so no cycle and no
+                # broken_target can be reported in this mode.
+                $State.Skipped = $State.Skipped + 1
+                continue
+            }
+
+            if ([string]::IsNullOrEmpty($resolved)) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+            if (-not (Test-Path -LiteralPath $resolved)) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+
+            # Ancestor chain of this branch only: two sibling links that share a
+            # target are not a cycle. The link's own location is included so that
+            # a link that points at itself is caught as well.
+            $linkSelf = Get-WReparseSafeCanonicalPath -Path $realChild
+            $branch = @($Ancestry)
+            if (-not [string]::IsNullOrEmpty($linkSelf)) { $branch = @($branch + $linkSelf) }
+            if (Test-WReparsePathInList -Path $resolved -List $branch) {
+                Add-WReparseError -State $State -RelativePath $relative -Code 'cycle' `
+                    -Message 'The reparse target is an ancestor already visited on this branch.'
+                continue
+            }
+
+            if (Test-Path -LiteralPath $resolved -PathType Container) {
+                # Children of the target are named after the LINK, not after the
+                # real target directory.
+                Invoke-WReparseDirectoryWalk -RealDirectory $resolved -VirtualDirectory $virtualChild `
+                    -Depth $childDepth -Ancestry @($branch + $resolved) -State $State
+            }
+            # A target that is a file produces no children at all.
+            continue
+        }
+
+        $isContainer = [bool](Get-WReparseMemberValue -InputObject $child -Name 'PSIsContainer')
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) { $size = [long]$length }
+        }
+        $kind = $script:WReparseKindFile
+        if ($isContainer) { $kind = $script:WReparseKindDirectory }
+
+        [void]$State.Records.Add((New-WReparseRecord -RelativePath $relative -Kind $kind `
+            -ReparseKind $null -Target $null -ResolvedTarget $null -InScope $false `
+            -Depth $childDepth -Size $size))
+
+        if ($isContainer) {
+            $realChildCanonical = Get-WReparseSafeCanonicalPath -Path $realChild
+            Invoke-WReparseDirectoryWalk -RealDirectory $realChildCanonical -VirtualDirectory $virtualChild `
+                -Depth $childDepth -Ancestry @($Ancestry + $realChildCanonical) -State $State
+        }
+    }
+}
+
+function New-WReparseWalkResult {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][hashtable]$State)
+    return [pscustomobject]@{
+        Root     = [string]$State.Root
+        Records  = @($State.Records.ToArray())
+        Errors   = @($State.Errors.ToArray())
+        Skipped  = [int]$State.Skipped
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root,
+        [ValidateSet('Never', 'Always')][string]$FollowMode = 'Never',
+        [int]$MaxDepth = 32
+    )
+    # A negative limit behaves exactly like 0 - byte for byte, including the
+    # message, which names the effective (clamped) limit.
+    $effectiveMaxDepth = $MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $state = @{
+        Records  = (New-Object System.Collections.ArrayList)
+        Errors   = (New-Object System.Collections.ArrayList)
+        Skipped  = 0
+        Root     = [string]$Root
+        Follow   = ($FollowMode -eq 'Always')
+        MaxDepth = $effectiveMaxDepth
+    }
+
+    $canonicalRoot = $null
+    try {
+        $canonicalRoot = Get-WReparseCanonicalPath -Path $Root
+    }
+    catch {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message ('Scan root cannot be canonicalised: ' + [string]$Root)
+        return New-WReparseWalkResult -State $state
+    }
+    $state.Root = $canonicalRoot
+
+    if (-not (Test-Path -LiteralPath $canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message ('Scan root does not exist: ' + $canonicalRoot)
+        return New-WReparseWalkResult -State $state
+    }
+    if (-not (Test-Path -LiteralPath $canonicalRoot -PathType Container)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message ('Scan root is not a directory: ' + $canonicalRoot)
+        return New-WReparseWalkResult -State $state
+    }
+
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualDirectory $canonicalRoot `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return New-WReparseWalkResult -State $state
+}
