+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse implementation.
+#
+# Ordering must not depend on the enumerator order or on the host culture, so
+# Sort-Object is deliberately NOT used: its default string comparison is
+# culture-aware and orders non-ASCII names differently under en-US, de-DE and
+# ja-JP. The order used here is ordinal-ignore-case with an ordinal tie-break,
+# which reproduces the measured order of assets/observed-provider-facts.json on
+# every host culture.
+
+# Sort keys, in priority order.
+$script:WReparseRecordKeys = @(
+    { param($Item) [string](Get-WReparseMemberValue -InputObject $Item -Name 'RelativePath') }
+)
+
+$script:WReparseErrorKeys = @(
+    { param($Item) [string](Get-WReparseMemberValue -InputObject $Item -Name 'RelativePath') },
+    { param($Item) [string](Get-WReparseMemberValue -InputObject $Item -Name 'Code') },
+    { param($Item) [string](Get-WReparseMemberValue -InputObject $Item -Name 'Message') }
+)
+
+function Compare-WReparseItems {
+    [CmdletBinding()]
+    param(
+        [AllowNull()]$Left,
+        [AllowNull()]$Right,
+        [Parameter(Mandatory = $true)][scriptblock[]]$KeySelectors
+    )
+    foreach ($selector in $KeySelectors) {
+        $leftKey = [string](& $selector $Left)
+        $rightKey = [string](& $selector $Right)
+        $result = Compare-WReparsePath -Left $leftKey -Right $rightKey
+        if ($result -ne 0) { return $result }
+    }
+    return 0
+}
+
+# Stable merge sort, so equal keys keep their relative order and the result is a
+# pure function of the input.
+function Sort-WReparseStable {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][AllowNull()][object[]]$Items,
+        [Parameter(Mandatory = $true)][scriptblock[]]$KeySelectors
+    )
+    $array = @()
+    if ($null -ne $Items) { $array = @($Items) }
+    $count = $array.Count
+    if ($count -le 1) { return $array }
+    $middle = [int][System.Math]::Floor($count / 2)
+    $left = @(Sort-WReparseStable -Items @($array[0..($middle - 1)]) -KeySelectors $KeySelectors)
+    $right = @(Sort-WReparseStable -Items @($array[$middle..($count - 1)]) -KeySelectors $KeySelectors)
+    $merged = New-Object System.Collections.ArrayList
+    $i = 0
+    $j = 0
+    while ($i -lt $left.Count -and $j -lt $right.Count) {
+        if ((Compare-WReparseItems -Left $left[$i] -Right $right[$j] -KeySelectors $KeySelectors) -le 0) {
+            [void]$merged.Add($left[$i])
+            $i = $i + 1
+        }
+        else {
+            [void]$merged.Add($right[$j])
+            $j = $j + 1
+        }
+    }
+    while ($i -lt $left.Count) {
+        [void]$merged.Add($left[$i])
+        $i = $i + 1
+    }
+    while ($j -lt $right.Count) {
+        [void]$merged.Add($right[$j])
+        $j = $j + 1
+    }
+    return @($merged.ToArray())
+}
+
+# Statistics. A reparse point is counted once, in ReparsePoints; it is neither a
+# Directory nor a File. Hard links are files.
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        if ($null -eq $record) { continue }
+        $kind = [string](Get-WReparseMemberValue -InputObject $record -Name 'Kind')
+        switch ($kind) {
+            $script:WReparseKindDirectory { $directories = $directories + 1 }
+            $script:WReparseKindFile      { $files = $files + 1 }
+            $script:WReparseKindReparse   { $reparse = $reparse + 1 }
+        }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+    $followMode = 'Never'
+    if ($Follow) { $followMode = 'Always' }
+    $walk = Invoke-WReparseWalk -Root $Root -FollowMode $followMode -MaxDepth $MaxDepth
+    $records = @(Sort-WReparseStable -Items $walk.Records -KeySelectors $script:WReparseRecordKeys)
+    $errors = @(Sort-WReparseStable -Items $walk.Errors -KeySelectors $script:WReparseErrorKeys)
+    $stats = Get-WReparseStats -Records $records -Skipped $walk.Skipped -ErrorCount $errors.Count
+    return New-WReparseReport -Root $walk.Root -Records $records -Errors $errors -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowNull()]$Report
+    )
+    if ($null -eq $Report) { return ($null | ConvertTo-Json -Depth $script:WReparseJsonDepth) }
+    return ($Report | ConvertTo-Json -Depth $script:WReparseJsonDepth)
+}
