+# WReparse - directory walker
+# Safe directory enumeration: reparse classification, containment, cycle and
+# depth control. Part of the WReparse implementation.
+# See docs/REPARSE-CONTRACT.md and ../assets/observed-provider-facts.json
+#
+# Ground rules that the walk has to honour:
+#   * the scan root itself is never emitted as a record; its children are at
+#     depth 1, and depth grows by one per level;
+#   * a directory whose own depth already reached -MaxDepth is NOT enumerated;
+#     a single 'too_deep' error is recorded against it. -MaxDepth below zero is
+#     clamped to 0, which makes '-MaxDepth -1' byte-identical to '-MaxDepth 0';
+#   * without -Follow no reparse point is ever entered (each one is counted in
+#     Stats.Skipped) and no cycle/broken_target probing happens at all;
+#   * with -Follow a reparse point is entered under the NAME OF THE LINK, not
+#     under the real target path; only a target that is an ancestor of the
+#     current branch is a cycle - two sibling links pointing at the same
+#     directory are not;
+#   * entries are classified by the FILE_ATTRIBUTE_REPARSE_POINT bit, never by
+#     the provider's LinkType: a hard link has a LinkType but no reparse bit and
+#     is therefore an ordinary file.
+
+# FILE_ATTRIBUTE_REPARSE_POINT
+$script:WReparseAttributeReparsePoint = 0x400
+
+function Get-WReparseMemberValue {
+    [CmdletBinding()]
+    param(
+        [AllowNull()]$InputObject,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $psObject = $InputObject.PSObject
+    if ($null -eq $psObject) { return $null }
+    $property = $psObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    try { return $property.Value }
+    catch { return $null }
+}
+
+# The provider reports LinkType for hard links too ('HardLink'), but hard links
+# are not reparse points, so this mapping is only ever reached for entries that
+# do carry the reparse attribute. Junction and SymbolicLink stay distinct.
+function Get-WReparseKindFromLinkType {
+    [CmdletBinding()]
+    param([AllowNull()][string]$LinkType)
+    switch ([string]$LinkType) {
+        'SymbolicLink' { return 'SymbolicLink' }
+        'Junction' { return 'Junction' }
+        'MountPoint' { return 'MountPoint' }
+        'HardLink' { return 'HardLink' }
+        '' { return 'Unknown' }
+        default { return [string]$LinkType }
+    }
+}
+
+function Test-WReparseIsReparsePoint {
+    [CmdletBinding()]
+    param([AllowNull()]$Item)
+    $attributes = Get-WReparseMemberValue -InputObject $Item -Name 'Attributes'
+    if ($null -eq $attributes) { return $false }
+    return (([int]$attributes -band $script:WReparseAttributeReparsePoint) -ne 0)
+}
+
+function Test-WReparseIsContainer {
+    [CmdletBinding()]
+    param([AllowNull()]$Item)
+    $isContainer = Get-WReparseMemberValue -InputObject $Item -Name 'PSIsContainer'
+    if ($null -eq $isContainer) { return $false }
+    return [bool]$isContainer
+}
+
+# The provider hands out .Target as a collection (System.String[] for links, a
+# List[string] for hard links) and PowerShell unrolls a single-element array when
+# it is returned from a helper, so the runtime type of a forwarded .Target would
+# depend on the number of targets. The report always stores a string: one target
+# is stored verbatim, several targets are joined with ';'.
+function Get-WReparseRawTargetString {
+    [CmdletBinding()]
+    param([AllowNull()]$Target)
+    if ($null -eq $Target) { return $null }
+    if ($Target -is [string]) {
+        $single = [string]$Target
+        if ($single.Length -eq 0) { return $null }
+        return $single
+    }
+    $elements = @($Target)
+    if ($elements.Count -eq 0) { return $null }
+    $parts = New-Object System.Collections.ArrayList
+    foreach ($element in $elements) {
+        if ($null -ne $element) {
+            $text = [string]$element
+            if ($text.Length -gt 0) { [void]$parts.Add($text) }
+        }
+    }
+    if ($parts.Count -eq 0) { return $null }
+    return [string]::Join(';', [string[]]$parts.ToArray())
+}
+
+function Test-WReparseIsAncestor {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path
+    )
+    if ($null -eq $Ancestry) { return $false }
+    foreach ($ancestor in $Ancestry) {
+        if ($null -eq $ancestor) { continue }
+        if ([string]::Equals([string]$ancestor, $Path, [System.StringComparison]::OrdinalIgnoreCase)) {
+            return $true
+        }
+    }
+    return $false
+}
+
+function Add-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][hashtable]$State,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    [void]$State.Errors.Add((New-WReparseError -RelativePath $RelativePath -Code $Code -Message $Message))
+}
+
+# '.' is the contractual relative path of the scan root itself.
+function Get-WReparseDisplayRelativePath {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath)
+    if ([string]::IsNullOrEmpty($RelativePath)) { return '.' }
+    return $RelativePath
+}
+
+function Invoke-WReparseDirectoryWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][string]$RealDirectory,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$VirtualRelative,
+        [Parameter(Mandatory = $true)][int]$Depth,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][string[]]$Ancestry,
+        [Parameter(Mandatory = $true)][hashtable]$State
+    )
+
+    if ($Depth -ge $State.MaxDepth) {
+        Add-WReparseError -State $State `
+            -RelativePath (Get-WReparseDisplayRelativePath -RelativePath $VirtualRelative) `
+            -Code 'too_deep' `
+            -Message "Depth limit of $($State.MaxDepth) reached; not enumerating."
+        return
+    }
+
+    $children = @()
+    try {
+        $children = @(Get-ChildItem -LiteralPath $RealDirectory -Force -ErrorAction Stop)
+    }
+    catch {
+        Add-WReparseError -State $State `
+            -RelativePath (Get-WReparseDisplayRelativePath -RelativePath $VirtualRelative) `
+            -Code 'access_denied' `
+            -Message ('Directory could not be enumerated: ' + [string]$_.Exception.Message)
+        return
+    }
+
+    foreach ($child in $children) {
+        if ($null -eq $child) { continue }
+
+        $name = [string](Get-WReparseMemberValue -InputObject $child -Name 'Name')
+        $childFull = [string](Get-WReparseMemberValue -InputObject $child -Name 'FullName')
+        if ([string]::IsNullOrEmpty($name)) {
+            if ([string]::IsNullOrEmpty($childFull)) { continue }
+            $name = [string]$childFull
+        }
+        $childDepth = $Depth + 1
+        if ([string]::IsNullOrEmpty($VirtualRelative)) {
+            $childRelative = $name
+        }
+        else {
+            $childRelative = $VirtualRelative + '\' + $name
+        }
+
+        if (Test-WReparseIsReparsePoint -Item $child) {
+            $linkType = [string](Get-WReparseMemberValue -InputObject $child -Name 'LinkType')
+            $rawTarget = Get-WReparseRawTargetString -Target (Get-WReparseMemberValue -InputObject $child -Name 'Target')
+            $resolved = Resolve-WReparseLinkTarget -LinkFullPath $childFull -RawTarget $rawTarget
+
+            $inScope = $false
+            if ($null -ne $resolved) {
+                $inScope = Test-WReparseWithinRoot -Path $resolved -Root $State.Root
+            }
+
+            [void]$State.Records.Add((New-WReparseRecord `
+                -RelativePath $childRelative `
+                -Kind $script:WReparseKindReparse `
+                -ReparseKind (Get-WReparseKindFromLinkType -LinkType $linkType) `
+                -Target $rawTarget `
+                -ResolvedTarget $resolved `
+                -InScope $inScope `
+                -Depth $childDepth `
+                -Size 0))
+
+            if (-not $State.Follow) {
+                # Registered but never entered; no probing of the target either,
+                # so a dangling or looping target produces no error at all.
+                $State.Skipped = [int]$State.Skipped + 1
+                continue
+            }
+
+            if ($null -eq $resolved) {
+                Add-WReparseError -State $State -RelativePath $childRelative -Code 'broken_target' `
+                    -Message 'The reparse target could not be resolved.'
+                continue
+            }
+
+            $exists = $false
+            $isContainer = $false
+            try {
+                $exists = [bool](Test-Path -LiteralPath $resolved)
+                if ($exists) { $isContainer = [bool](Test-Path -LiteralPath $resolved -PathType Container) }
+            }
+            catch {
+                $exists = $false
+                $isContainer = $false
+            }
+
+            if (-not $exists) {
+                Add-WReparseError -State $State -RelativePath $childRelative -Code 'broken_target' `
+                    -Message 'The reparse target does not exist.'
+                continue
+            }
+            if (-not $isContainer) {
+                # A link onto a file is registered, but it has no children.
+                continue
+            }
+
+            $targetCanonical = Get-WReparseCanonicalPathOrNull -Path $resolved
+            if ($null -eq $targetCanonical) { $targetCanonical = $resolved }
+
+            if (Test-WReparseIsAncestor -Ancestry $Ancestry -Path $targetCanonical) {
+                Add-WReparseError -State $State -RelativePath $childRelative -Code 'cycle' `
+                    -Message 'The reparse target is an ancestor already visited on this branch.'
+                continue
+            }
+
+            # Entered under the link's own relative path, so every descendant is
+            # named after the link and not after the real target.
+            Invoke-WReparseDirectoryWalk -RealDirectory $targetCanonical -VirtualRelative $childRelative `
+                -Depth $childDepth -Ancestry (@($Ancestry) + $targetCanonical) -State $State
+            continue
+        }
+
+        $isContainer = Test-WReparseIsContainer -Item $child
+        $size = [long]0
+        if (-not $isContainer) {
+            $length = Get-WReparseMemberValue -InputObject $child -Name 'Length'
+            if ($null -ne $length) {
+                try { $size = [long]$length } catch { $size = [long]0 }
+            }
+        }
+
+        $kind = if ($isContainer) { $script:WReparseKindDirectory } else { $script:WReparseKindFile }
+
+        # InScope only means something for a reparse point (it says whether the
+        # resolved target stays inside the scan root). Plain files and
+        # directories are where they are, so they are always false.
+        [void]$State.Records.Add((New-WReparseRecord `
+            -RelativePath $childRelative `
+            -Kind $kind `
+            -ReparseKind $null `
+            -Target $null `
+            -ResolvedTarget $null `
+            -InScope $false `
+            -Depth $childDepth `
+            -Size $size))
+
+        if ($isContainer) {
+            $childCanonical = Get-WReparseCanonicalPathOrNull -Path $childFull
+            if ($null -eq $childCanonical) { $childCanonical = $childFull }
+            Invoke-WReparseDirectoryWalk -RealDirectory $childCanonical -VirtualRelative $childRelative `
+                -Depth $childDepth -Ancestry (@($Ancestry) + $childCanonical) -State $State
+        }
+    }
+}
+
+function Invoke-WReparseWalk {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [bool]$Follow = $false,
+        [int]$MaxDepth = 32
+    )
+
+    # '-MaxDepth -1' has to behave exactly like '-MaxDepth 0'.
+    $effectiveMaxDepth = $MaxDepth
+    if ($effectiveMaxDepth -lt 0) { $effectiveMaxDepth = 0 }
+
+    $state = @{
+        Records  = (New-Object System.Collections.ArrayList)
+        Errors   = (New-Object System.Collections.ArrayList)
+        Skipped  = 0
+        Root     = [string]$Root
+        Follow   = [bool]$Follow
+        MaxDepth = [int]$effectiveMaxDepth
+    }
+
+    $canonicalRoot = Get-WReparseCanonicalPathOrNull -Path $Root
+    if ($null -eq $canonicalRoot) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'invalid_argument' `
+            -Message "Scan root cannot be canonicalised: $Root"
+        return [pscustomobject]@{
+            Root    = [string]$Root
+            Records = [object[]]@()
+            Errors  = [object[]]$state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+    $state.Root = $canonicalRoot
+
+    if (-not (Test-Path -LiteralPath $canonicalRoot)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'not_found' `
+            -Message "Scan root does not exist: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = [object[]]@()
+            Errors  = [object[]]$state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+    if (-not (Test-Path -LiteralPath $canonicalRoot -PathType Container)) {
+        Add-WReparseError -State $state -RelativePath '.' -Code 'structure' `
+            -Message "Scan root is not a directory: $canonicalRoot"
+        return [pscustomobject]@{
+            Root    = $canonicalRoot
+            Records = [object[]]@()
+            Errors  = [object[]]$state.Errors.ToArray()
+            Skipped = 0
+        }
+    }
+
+    Invoke-WReparseDirectoryWalk -RealDirectory $canonicalRoot -VirtualRelative '' `
+        -Depth 0 -Ancestry @($canonicalRoot) -State $state
+
+    return [pscustomobject]@{
+        Root    = $canonicalRoot
+        Records = [object[]]$state.Records.ToArray()
+        Errors  = [object[]]$state.Errors.ToArray()
+        Skipped = [int]$state.Skipped
+    }
+}
