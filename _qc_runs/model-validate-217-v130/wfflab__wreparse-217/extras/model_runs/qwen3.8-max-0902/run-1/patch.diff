+# WReparse - data model
+# Shared vocabulary: error codes, enumerations, and factory helpers.
+# Part of the WReparse implementation. See docs/REPARSE-CONTRACT.md
+#
+# The report data model is fixed by the contract (section 3):
+#   SchemaVersion / Root / Records / Errors / Stats
+# No generation timestamp, no process id, no machine specific value may appear
+# anywhere in the report: two runs over the same tree with the same arguments
+# have to serialise byte-for-byte identically.
+
+Set-StrictMode -Version Latest
+
+# Error codes are part of the public contract. The set is closed: exactly these
+# seven codes may ever show up in Errors[].Code.
+$script:WReparseErrorCode = @(
+    'not_found'
+    'access_denied'
+    'cycle'
+    'broken_target'
+    'structure'
+    'too_deep'
+    'invalid_argument'
+)
+
+$script:WReparseSchemaVersion = 'wreparse/1.0'
+
+# Entry kinds. A hard link is a FILE, not a reparse point: the two NTFS
+# directory entries share one data stream and neither entry carries the
+# FILE_ATTRIBUTE_REPARSE_POINT (0x400) bit. Only entries whose file attributes
+# contain that bit are reported with Kind = 'ReparsePoint'.
+$script:WReparseKindDirectory = 'Directory'
+$script:WReparseKindFile = 'File'
+$script:WReparseKindReparse = 'ReparsePoint'
+
+# A [string] parameter declaration would coerce $null into '', and the contract
+# wants a real JSON null for the optional record fields. Values are therefore
+# normalised through this helper instead of being typed as [string].
+function Get-WReparseNullableString {
+    [CmdletBinding()]
+    param([AllowNull()]$Value)
+    if ($null -eq $Value) { return $null }
+    $text = [string]$Value
+    if ($text.Length -eq 0) { return $null }
+    return $text
+}
+
+function Get-WReparseErrorCode {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseErrorCode
+}
+
+function Get-WReparseSchemaVersion {
+    [CmdletBinding()]
+    param()
+    return $script:WReparseSchemaVersion
+}
+
+function New-WReparseError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Code,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Message
+    )
+    if ($script:WReparseErrorCode -notcontains $Code) {
+        throw "Unknown WReparse error code: $Code"
+    }
+    return [pscustomobject][ordered]@{
+        RelativePath = $RelativePath
+        Code         = $Code
+        Message      = $Message
+    }
+}
+
+function New-WReparseRecord {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$RelativePath,
+        [Parameter(Mandatory = $true)][string]$Kind,
+        [AllowNull()]$ReparseKind = $null,
+        [AllowNull()]$Target = $null,
+        [AllowNull()]$ResolvedTarget = $null,
+        [bool]$InScope = $false,
+        [int]$Depth = 0,
+        [long]$Size = 0
+    )
+    return [pscustomobject][ordered]@{
+        RelativePath   = $RelativePath
+        Kind           = $Kind
+        ReparseKind    = (Get-WReparseNullableString -Value $ReparseKind)
+        Target         = (Get-WReparseNullableString -Value $Target)
+        ResolvedTarget = (Get-WReparseNullableString -Value $ResolvedTarget)
+        InScope        = [bool]$InScope
+        Depth          = [int]$Depth
+        Size           = [long]$Size
+    }
+}
+
+function New-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [int]$Directories = 0,
+        [int]$Files = 0,
+        [int]$ReparsePoints = 0,
+        [int]$Skipped = 0,
+        [int]$Errors = 0
+    )
+    return [pscustomobject][ordered]@{
+        Directories   = $Directories
+        Files         = $Files
+        ReparsePoints = $ReparsePoints
+        Skipped       = $Skipped
+        Errors        = $Errors
+    }
+}
+
+function New-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [Parameter(Mandatory = $true)][AllowEmptyCollection()][AllowNull()][object[]]$Errors,
+        [Parameter(Mandatory = $true)][object]$Stats
+    )
+    # Field order is contractual (section 3.1) and there is no GeneratedAt:
+    # a timestamp would break byte-for-byte reproducibility.
+    return [pscustomobject][ordered]@{
+        SchemaVersion = $script:WReparseSchemaVersion
+        Root          = $Root
+        Records       = [object[]]@($Records)
+        Errors        = [object[]]@($Errors)
+        Stats         = $Stats
+    }
+}
