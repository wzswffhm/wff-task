+# WReparse - path semantics
+# Canonicalisation, directory-boundary containment, and link-target resolution.
+# Part of the WReparse implementation. See docs/REPARSE-CONTRACT.md
+#
+# Canonical form used for every comparison and for the report:
+#   * full (rooted) path with '.' and '..' collapsed
+#   * separators normalised to '\'
+#   * no trailing directory separator, except for a volume root ('C:\')
+#   * the caller's casing is preserved verbatim - canonicalisation is a lexical
+#     operation, so it never lower-cases a path and never asks the file system
+#     for the 'real' spelling of a name.
+
+# Current file-system location, used only to expand a relative argument. It is
+# never used to resolve a relative *link target*: those are resolved against the
+# directory that contains the link.
+function Get-WReparseCurrentLocation {
+    [CmdletBinding()]
+    param()
+    try {
+        $location = $ExecutionContext.SessionState.Path.CurrentFileSystemLocation
+        if ($null -ne $location) {
+            $providerPath = $location.ProviderPath
+            if (-not [string]::IsNullOrEmpty($providerPath)) { return [string]$providerPath }
+        }
+    }
+    catch { }
+    try {
+        $pwdPath = $PWD.ProviderPath
+        if (-not [string]::IsNullOrEmpty($pwdPath)) { return [string]$pwdPath }
+    }
+    catch { }
+    return [string][System.Environment]::CurrentDirectory
+}
+
+# Lexical canonicalisation. Returns $null when the string cannot be turned into a
+# rooted path at all (empty, whitespace only, illegal characters, malformed UNC,
+# ...). Callers decide how to report that; the scan reports 'invalid_argument'.
+function Get-WReparseCanonicalPathOrNull {
+    [CmdletBinding()]
+    param([AllowNull()][AllowEmptyString()][string]$Path)
+
+    if ([string]::IsNullOrWhiteSpace($Path)) { return $null }
+    $candidate = [string]$Path
+
+    # '\\?\' and '\??\' are NT namespace transport forms of the very same path.
+    if ($candidate.Length -ge 4) {
+        $head = $candidate.Substring(0, 4)
+        if ($head -eq '\\?\' -or $head -eq '\??\') {
+            $candidate = $candidate.Substring(4)
+            if ($candidate.StartsWith('UNC\', [System.StringComparison]::OrdinalIgnoreCase)) {
+                $candidate = '\' + $candidate.Substring(4)
+            }
+        }
+    }
+
+    $isRooted = $false
+    try { $isRooted = [System.IO.Path]::IsPathRooted($candidate) }
+    catch { return $null }
+
+    if (-not $isRooted) {
+        $base = Get-WReparseCurrentLocation
+        if (-not [string]::IsNullOrEmpty($base)) {
+            try { $candidate = [System.IO.Path]::Combine($base, $candidate) }
+            catch { return $null }
+        }
+    }
+
+    $full = $null
+    try { $full = [System.IO.Path]::GetFullPath($candidate) }
+    catch { return $null }
+    if ([string]::IsNullOrWhiteSpace($full)) { return $null }
+
+    $full = $full.Replace([char]'/', [char]'\')
+
+    # Strip trailing separators, but never mangle a volume root ('C:\').
+    $isVolumeRoot = ($full.Length -eq 3) -and ($full[1] -eq [char]':') -and ($full[2] -eq [char]'\')
+    if ((-not $isVolumeRoot) -and ($full.Length -gt 1)) {
+        $full = $full.TrimEnd([char]'\')
+    }
+    if ([string]::IsNullOrEmpty($full)) { return $null }
+    return $full
+}
+
+function Get-WReparseCanonicalPath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Path
+    )
+    $canonical = Get-WReparseCanonicalPathOrNull -Path $Path
+    if ($null -eq $canonical) {
+        throw (New-Object System.ArgumentException("Path cannot be canonicalised: '$Path'", 'Path'))
+    }
+    return $canonical
+}
+
+# Directory-boundary aware containment. 'C:\root2' is NOT inside 'C:\root' even
+# though 'C:\root2'.StartsWith('C:\root') is true, so the prefix has to be
+# terminated by a separator. Windows path comparison is case-insensitive; the
+# ordinal-ignore-case comparer is used so the answer never depends on the host
+# culture (a culture-aware compare would order non-ASCII names differently).
+function Test-WReparseWithinRoot {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Path,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Root
+    )
+    if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) {
+        return $false
+    }
+    $child = Get-WReparseCanonicalPathOrNull -Path $Path
+    $parent = Get-WReparseCanonicalPathOrNull -Path $Root
+    if ($null -eq $child -or $null -eq $parent) { return $false }
+    if ([string]::Equals($child, $parent, [System.StringComparison]::OrdinalIgnoreCase)) {
+        return $true
+    }
+    $prefix = $parent
+    if (-not $prefix.EndsWith([string][char]'\', [System.StringComparison]::Ordinal)) {
+        $prefix = $prefix + '\'
+    }
+    return [bool]$child.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
+}
+
+# The reparse target stored on disk may be relative. A relative target is
+# resolved against the directory that CONTAINS the link - never against the
+# process working directory and never against the scan root. The result is
+# purely lexical: a dangling link still resolves to the path it points at.
+function Resolve-WReparseLinkTarget {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$LinkFullPath,
+        [AllowNull()][AllowEmptyString()][string]$RawTarget
+    )
+    if ([string]::IsNullOrWhiteSpace($RawTarget)) { return $null }
+    $raw = ([string]$RawTarget).Trim()
+    if ($raw.Length -eq 0) { return $null }
+
+    # Volume GUID paths ('\\?\Volume{...}\') keep their namespace form.
+    if ($raw.StartsWith('\??\Volume{', [System.StringComparison]::OrdinalIgnoreCase) -or
+        $raw.StartsWith('\\?\Volume{', [System.StringComparison]::OrdinalIgnoreCase)) {
+        return [string]('\\?\' + $raw.Substring(4).TrimEnd([char]'\'))
+    }
+
+    $candidate = $raw
+    $isRooted = $false
+    try { $isRooted = [System.IO.Path]::IsPathRooted($candidate) }
+    catch { return $null }
+
+    if (-not $isRooted) {
+        $linkDirectory = $null
+        if (-not [string]::IsNullOrWhiteSpace($LinkFullPath)) {
+            $canonicalLink = Get-WReparseCanonicalPathOrNull -Path $LinkFullPath
+            if ($null -ne $canonicalLink) {
+                try { $linkDirectory = [System.IO.Path]::GetDirectoryName($canonicalLink) }
+                catch { $linkDirectory = $null }
+            }
+        }
+        if ([string]::IsNullOrEmpty($linkDirectory)) { $linkDirectory = Get-WReparseCurrentLocation }
+        try { $candidate = [System.IO.Path]::Combine($linkDirectory, $raw) }
+        catch { return $null }
+    }
+
+    return Get-WReparseCanonicalPathOrNull -Path $candidate
+}
+
+# Stable ordering key: ordinal, case-insensitive first, with a case-sensitive
+# tie-break so that two entries whose names differ only by case keep a
+# deterministic position. This is the order the observed provider facts require
+# and it is identical under en-US, de-DE and ja-JP because no culture-aware
+# collation is involved at all.
+function Compare-WReparsePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Left,
+        [Parameter(Mandatory = $true)][AllowEmptyString()][AllowNull()][string]$Right
+    )
+    $leftValue = [string]$Left
+    $rightValue = [string]$Right
+    $primary = [System.StringComparer]::OrdinalIgnoreCase.Compare($leftValue, $rightValue)
+    if ($primary -ne 0) { return $primary }
+    return [System.StringComparer]::Ordinal.Compare($leftValue, $rightValue)
+}
