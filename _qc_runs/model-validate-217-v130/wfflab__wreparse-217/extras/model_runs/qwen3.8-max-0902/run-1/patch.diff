+# WReparse - report assembly
+# Deterministic ordering, statistics and serialisation.
+# Part of the WReparse implementation. See docs/REPARSE-CONTRACT.md
+#
+# Ordering must not depend on the host culture: Sort-Object is deliberately NOT
+# used, because its default string comparison is culture-aware and would order
+# non-ASCII names differently on en-US, de-DE and ja-JP hosts. Records are
+# ordered by RelativePath with the ordinal-ignore-case comparer and an ordinal
+# tie-break, which is the order the observed provider facts require and which is
+# identical on every host.
+
+$script:WReparseJsonDepth = 16
+
+# OrderBy is a documented stable sort, so applying the lower priority key first
+# and the higher priority key afterwards yields exactly
+# "ordinal-ignore-case, then ordinal" without needing a custom comparer type.
+function Get-WReparseSortedRecords {
+    [CmdletBinding()]
+    param([AllowEmptyCollection()][AllowNull()][object[]]$Items)
+    $array = @($Items)
+    if ($array.Count -eq 0) { return [object[]]@() }
+    $keyPath = [Func[object, string]] { param($item) [string]$item.RelativePath }
+    $byOrdinal = [System.Linq.Enumerable]::OrderBy([object[]]$array, $keyPath, [System.StringComparer]::Ordinal)
+    $byPath = [System.Linq.Enumerable]::OrderBy($byOrdinal, $keyPath, [System.StringComparer]::OrdinalIgnoreCase)
+    return [object[]][System.Linq.Enumerable]::ToArray($byPath)
+}
+
+# Errors are ordered by RelativePath (same comparer as the records), then by Code
+# and Message, so that two runs over the same tree always emit them in the same
+# order even when several errors share one path.
+function Get-WReparseSortedErrors {
+    [CmdletBinding()]
+    param([AllowEmptyCollection()][AllowNull()][object[]]$Items)
+    $array = @($Items)
+    if ($array.Count -eq 0) { return [object[]]@() }
+    $keyMessage = [Func[object, string]] { param($item) [string]$item.Message }
+    $keyCode = [Func[object, string]] { param($item) [string]$item.Code }
+    $keyPath = [Func[object, string]] { param($item) [string]$item.RelativePath }
+    $byMessage = [System.Linq.Enumerable]::OrderBy([object[]]$array, $keyMessage, [System.StringComparer]::Ordinal)
+    $byCode = [System.Linq.Enumerable]::OrderBy($byMessage, $keyCode, [System.StringComparer]::Ordinal)
+    $byOrdinal = [System.Linq.Enumerable]::OrderBy($byCode, $keyPath, [System.StringComparer]::Ordinal)
+    $byPath = [System.Linq.Enumerable]::OrderBy($byOrdinal, $keyPath, [System.StringComparer]::OrdinalIgnoreCase)
+    return [object[]][System.Linq.Enumerable]::ToArray($byPath)
+}
+
+function Get-WReparseStats {
+    [CmdletBinding()]
+    param(
+        [AllowEmptyCollection()][AllowNull()][object[]]$Records,
+        [int]$Skipped = 0,
+        [int]$ErrorCount = 0
+    )
+    $directories = 0
+    $files = 0
+    $reparse = 0
+    foreach ($record in @($Records)) {
+        if ($null -eq $record) { continue }
+        switch ([string]$record.Kind) {
+            'File' { $files++ }
+            'Directory' { $directories++ }
+            'ReparsePoint' { $reparse++ }
+        }
+    }
+    return New-WReparseStats -Directories $directories -Files $files -ReparsePoints $reparse `
+        -Skipped $Skipped -Errors $ErrorCount
+}
+
+function Get-WReparseReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Root,
+        [int]$MaxDepth = 32,
+        [switch]$Follow
+    )
+
+    $walk = Invoke-WReparseWalk -Root $Root -Follow ([bool]$Follow) -MaxDepth $MaxDepth
+    $records = @(Get-WReparseSortedRecords -Items ([object[]]$walk.Records))
+    $errors = @(Get-WReparseSortedErrors -Items ([object[]]$walk.Errors))
+    $stats = Get-WReparseStats -Records $records -Skipped ([int]$walk.Skipped) -ErrorCount $errors.Count
+
+    return New-WReparseReport -Root ([string]$walk.Root) -Records ([object[]]$records) `
+        -Errors ([object[]]$errors) -Stats $stats
+}
+
+function ConvertTo-WReparseJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]$Report
+    )
+    $json = ConvertTo-Json -InputObject $Report -Depth $script:WReparseJsonDepth
+    $json = [string]$json
+    # Windows PowerShell renders an empty collection across several lines; the
+    # contract wants the compact '[]' form. A JSON string value can never
+    # contain a raw newline (it is escaped), so this only ever rewrites the
+    # structural whitespace of an empty array.
+    $json = [System.Text.RegularExpressions.Regex]::Replace($json, '\[\s*\n\s*\]', '[ ]')
+    return $json
+}
