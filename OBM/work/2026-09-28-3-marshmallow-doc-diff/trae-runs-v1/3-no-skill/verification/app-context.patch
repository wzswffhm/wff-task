+    ##### Document diff #####
+
+    def document_diff(
+        self,
+        left: typing.Any,
+        right: typing.Any,
+        *,
+        include_unknown: bool = False,
+        ignore_fields: types.StrSequenceOrSet = (),
+    ) -> list[dict[str, typing.Any]]:
+        """Compare two documents field by field following this schema's
+        declared fields and return an ordered list of change records.
+
+        Each record is a dictionary with the keys ``op``, ``path``, ``left``
+        and ``right``:
+
+        - ``"add"``: the field only exists in ``right`` (``left`` is ``None``)
+        - ``"remove"``: the field only exists in ``left`` (``right`` is ``None``)
+        - ``"change"``: the field exists in both documents but differs
+
+        Fields are visited in the order they are declared on the schema, not
+        in the insertion order of the input documents. ``Nested`` fields are
+        compared recursively with their nested schema (paths are joined with
+        dots, e.g. ``address.street``); ``Nested(many=True)`` and ``List``
+        fields are compared element by position (paths use bracketed indexes,
+        e.g. ``members[0].age`` or ``tags[1]``).
+
+        :param left: The first document. A mapping is compared as-is; any
+            other object is first serialized with :meth:`dump`.
+        :param right: The other document. A mapping is compared as-is; any
+            other object is first serialized with :meth:`dump`.
+        :param include_unknown: If `True`, keys that are not declared on the
+            schema are also compared. They are ignored by default.
+        :param ignore_fields: Field names to skip for the whole comparison,
+            at every nesting level.
+        :return: Ordered list of change records; an empty list if the
+            documents are equal.
+        """
+        if not isinstance(left, Mapping):
+            left = self.dump(left)
+        if not isinstance(right, Mapping):
+            right = self.dump(right)
+        return _diff_documents(
+            self,
+            left,
+            right,
+            path="",
+            include_unknown=include_unknown,
+            ignore_fields=set(ignore_fields),
+        )
+
