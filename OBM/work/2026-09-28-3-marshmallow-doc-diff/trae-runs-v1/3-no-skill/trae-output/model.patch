+
+def _diff_documents(
+    schema: Schema,
+    left: Mapping[str, typing.Any],
+    right: Mapping[str, typing.Any],
+    *,
+    path: str,
+    include_unknown: bool,
+    ignore_fields: set[str],
+) -> list[dict[str, typing.Any]]:
