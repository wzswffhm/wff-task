@@ -0,0 +1,25 @@
+import tempfile  
+import os  
+import stat  
+from pathlib import Path  
+from wsync import sync_tree  
+  
+tmpdir = tempfile.mkdtemp()  
+source = Path(tmpdir) / "source"  
+target = Path(tmpdir) / "target"  
+source.mkdir()  
+target.mkdir()  
+  
+(target / "file.txt").write_text("old", encoding="utf-8")  
+os.utime(target / "file.txt", (1600000000, 1600000000))  
+current_mode = os.stat(target / "file.txt").st_mode  
+os.chmod(target / "file.txt", current_mode and ~stat.S_IWRITE)  
+  
+(source / "file.txt").write_text("new", encoding="utf-8")  
+os.utime(source / "file.txt", (1700000000, 1700000000))  
+  
+result = sync_tree(str(source), str(target))  
+  
+print("OK:", result.ok)  
+print("Content:", (target / "file.txt").read_text(encoding="utf-8"))  
+print("Updated:", result.updated)  
