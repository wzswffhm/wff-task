index 0000000..c35d05e
--- /dev/null
+++ b/test_debug.py
@@ -0,0 +1,35 @@
+import os
+import stat
+from pathlib import Path
+import tempfile
+
+with tempfile.TemporaryDirectory() as tmpdir:
+    source = Path(tmpdir) / "source"
+    target = Path(tmpdir) / "target"
+    source.mkdir()
+    target.mkdir()
+    
+    (source / "file.txt").write_text("new")
+    
+    (target / "readonly_dir").mkdir()
+    nested = target / "readonly_dir" / "nested.txt"
+    nested.write_text("old")
+    os.chmod(nested, stat.S_IREAD)
+    os.chmod(target / "readonly_dir", stat.S_IREAD)
+    
+    print("Before sync:")
+    print(f"  nested exists: {nested.exists()}")
+    print(f"  nested mode: {oct(os.stat(nested).st_mode)}")
+    print(f"  parent mode: {oct(os.stat(target / "readonly_dir").st_mode)}")
+    
+    from wsync import sync_tree
+    try:
+        result = sync_tree(str(source), str(target))
+        print(f"\nResult: created={result.created}, updated={result.updated}, deleted={result.deleted}, failed={result.failed}")
+        print(f"After sync:")
+        print(f"  nested exists: {nested.exists()}")
+        print(f"  dir exists: {(target / "readonly_dir").exists()}")
+    except Exception as e:
+        print(f"\nException: {e}")
+        import traceback
+        traceback.print_exc()
diff --git a/test_debug2.py b/test_debug2.py
new file mode 100644
index 0000000..af01af8
--- /dev/null
+++ b/test_debug2.py
@@ -0,0 +1,34 @@
+import os
+import stat
+from pathlib import Path
+import tempfile
+
+tmpdir = tempfile.mkdtemp()
+print(f"Using temp dir: {tmpdir}")
+
+source = Path(tmpdir) / "source"
+target = Path(tmpdir) / "target"
+source.mkdir()
+target.mkdir()
+
+(source / "file.txt").write_text("new")
+
+(target / "readonly_dir").mkdir()
+nested = target / "readonly_dir" / "nested.txt"
+nested.write_text("old")
+
+print(f"Before setting readonly:")
+print(f"  nested mode: {oct(os.stat(nested).st_mode)}")
+
+os.chmod(nested, stat.S_IREAD)
+print(f"After setting readonly:")
+print(f"  nested mode: {oct(os.stat(nested).st_mode)}")
+
+from wsync import fsops
+fsops.clear_readonly(str(nested))
+
+print(f"After clear_readonly:")
+print(f"  nested mode: {oct(os.stat(nested).st_mode)}")
+
+os.remove(str(nested))
+print("Successfully removed!")
diff --git a/test_win_fixes.py b/test_win_fixes.py
new file mode 100644
index 0000000..09b13d4
--- /dev/null
+++ b/test_win_fixes.py
@@ -0,0 +1,33 @@
+import os
+import stat
+from pathlib import Path
+import tempfile
+
+print("测试 1: 只读文件和目录...")
+with tempfile.TemporaryDirectory() as tmpdir:
+    source = Path(tmpdir) / "source"
+    target = Path(tmpdir) / "target"
+    source.mkdir()
+    target.mkdir()
+    
+    (source / "file.txt").write_text("new content")
+    (target / "file.txt").write_text("old content")
+    os.chmod(target / "file.txt", stat.S_IREAD)
+    
+    (target / "readonly_dir").mkdir()
+    (target / "readonly_dir" / "nested.txt").write_text("old")
+    os.chmod(target / "readonly_dir" / "nested.txt", stat.S_IREAD)
+    os.chmod(target / "readonly_dir", stat.S_IREAD)
+    
+    from wsync import sync_tree
+    result = sync_tree(str(source), str(target))
+    
+    print(f"Created: {result.created}")
+    print(f"Updated: {result.updated}")
+    print(f"Deleted: {result.deleted}")
+    print(f"Failed: {result.failed}")
+    
+    assert (target / "file.txt").read_text() == "new content"
+    assert not (target / "readonly_dir").exists()
+    assert result.ok
+    print("✓ 只读文件和目录处理正确")
