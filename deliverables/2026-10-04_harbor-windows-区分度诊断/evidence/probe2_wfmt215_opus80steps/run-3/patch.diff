+from wfmt.varint import decode_uvarint  
+data = open("assets/sample.wfmt", "rb").read()  
+print("Total:", len(data))  
+pos = 9  
+records = []  
+while pos < len(data) - 4:  
+    rs = pos  
+    tag, pos = decode_uvarint(data, pos)  
+    length, pos = decode_uvarint(data, pos)  
+    payload = data[pos:pos+length]  
+    pos += length  
+    sz = pos - rs  
+    pad = (4 - sz %% 4) %% 4  
+    pos += pad  
+    records.append((tag, length, sz, pad))  
+for i, r in enumerate(records):  
+    print(f"R{i+1}: tag={r[0]} len={r[1]} size={r[2]} pad={r[3]}")  
+print(f"Final: {pos}, Expected: {len(data)-4}")  
