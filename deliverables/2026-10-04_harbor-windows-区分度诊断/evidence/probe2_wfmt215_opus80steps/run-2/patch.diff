--- /dev/null
+++ b/dv.py
@@ -0,0 +1,31 @@
+def decode_varint(data, pos):  
+    result = 0  
+    shift = 0  
+    while pos < len(data):  
+        byte = data[pos]  
+        pos += 1  
+        result |= (byte & 0x7F) << shift  
+        if not (byte & 0x80):  
+            return result, pos  
+        shift += 7  
+    raise ValueError('incomplete')  
+  
+data = open('assets/sample.wfmt', 'rb').read()  
+import struct  
+count = struct.unpack('<I', data[5:9])[0]  
+print(f'Count: {count}')  
+print()  
+  
+pos = 9  
+for i in range(count):  
+    tag, pos = decode_varint(data, pos)  
+    length, pos = decode_varint(data, pos)  
+    payload = data[pos:pos+length]  
+    print(f'Rec {i}: tag={tag}, len={length}')  
+    if length <= 20:  
+        print(f'  payload hex: {payload.hex()}')  
+    pos += length  
+    print(f'  end pos: {pos}')  
+    print()  
+  
+print(f'Final: {pos}, expected: {len(data)-4}, match: {pos == len(data)-4}')  
