+import sys  
+import struct  
+sys.path.insert(0, '.')  
+from wfmt.varint import decode_uvarint  
+from wfmt.header import parse_header, HEADER_SIZE  
+from wfmt.crc import CRC_SIZE  
+  
+data = open('assets/sample.wfmt', 'rb').read()  
+version, count = parse_header(data)  
+end = len(data) - CRC_SIZE  
+pos = HEADER_SIZE  
+  
+for i in range(count):  
+    tag, pos = decode_uvarint(data[:end], pos)  
+    length = struct.unpack_from('<I', data[:end], pos)[0]  
+    pos += 4  
+    print(f'Rec {i}: tag={tag}, len={length}, end={pos+length}')  
+    pos += length  
+  
+print(f'Final: {pos}, expected: {end}, match: {pos == end}') 
