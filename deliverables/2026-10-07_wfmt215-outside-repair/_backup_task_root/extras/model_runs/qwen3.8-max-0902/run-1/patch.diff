index 0000000..15aced9
--- /dev/null
+++ b/_selfcheck.py
@@ -0,0 +1,194 @@
+import io
+import struct
+import zlib
+
+import wfmt
+from wfmt import (WFormatError, compute_crc, iter_records, pack, read_all,
+                  unpack, verify, encode_record, decode_record, encode_uvarint,
+                  decode_uvarint, pack_header, parse_header)
+
+s = open('assets/sample.wfmt', 'rb').read()
+e = open('assets/sample_empty.wfmt', 'rb').read()
+
+# ---------- A ----------
+assert verify(s) is True
+assert verify(e) is True
+assert pack(unpack(s)) == s
+assert pack(unpack(e)) == e
+assert unpack(e) == []
+assert list(iter_records(io.BytesIO(s))) == unpack(s)
+assert read_all(io.BytesIO(e)) == []
+print('A ok')
+
+# ---------- C ----------
+assert compute_crc(b'123456789') == 0xCBF43926, hex(compute_crc(b'123456789'))
+assert compute_crc(b'') == 0
+assert compute_crc(b'The quick brown fox jumps over the lazy dog') == 0x414FA339
+for n in range(0, 300):
+    data = bytes((i * 7 + 3) % 256 for i in range(n))
+    assert compute_crc(data) == zlib.crc32(data) & 0xFFFFFFFF
+    assert compute_crc(bytearray(data)) == compute_crc(data)
+    assert compute_crc(memoryview(data)) == compute_crc(data)
+    assert wfmt.crc.crc_update(compute_crc(data[:n // 2]), data[n // 2:]) == compute_crc(data)
+print('C ok')
+
+
+def kind(fn, *a, **kw):
+    try:
+        fn(*a, **kw)
+    except WFormatError as ex:
+        return ex.kind
+    except Exception as ex:
+        return 'OTHER:' + type(ex).__name__ + ':' + str(ex)
+    return None
+
+
+# ---------- B ----------
+recs = [(0, b''), (1, b'a'), (127, b'x' * 127), (128, b''), (300, b'y' * 1000),
+        (70000, b'z'), (2 ** 35, b'big tag'), (2 ** 64 - 1, b'max tag'),
+        (5, 'text payload'), (9, bytes(range(256)))]
+expected = [(t, p.encode() if isinstance(p, str) else p) for t, p in recs]
+blob = pack(recs)
+assert unpack(blob) == expected, unpack(blob)
+assert verify(blob) is True
+assert list(iter_records(io.BytesIO(blob))) == expected
+assert read_all(io.BytesIO(blob)) == expected
+assert pack(iter(recs)) == blob
+assert pack([]) == e
+assert pack(expected) == blob
+assert encode_uvarint(300) == b'\xac\x02'
+assert encode_uvarint(70000) == b'\xf0\xa2\x04'
+assert decode_uvarint(b'\xac\x02', 0) == (300, 2)
+assert decode_uvarint(bytes([0xf0,0xa2,0x04]), 0) == (70000, 3)
+assert encode_record(1, b'alpha') == s[9:17]
+assert decode_record(s, 9) == (1, b'alpha', 17)
+assert unpack(bytearray(s)) == unpack(s)
+assert unpack(memoryview(s)) == unpack(s)
+assert all(isinstance(p, bytes) and isinstance(t, int) and t >= 0 for t, p in unpack(s))
+print('B ok')
+
+# ---------- D ----------
+cases = [
+    ('magic', b'XFLT' + s[4:]),
+    ('magic', b'wfmt' + s[4:]),
+    ('version', s[:4] + bytes([2]) + s[5:]),
+    ('version', s[:4] + bytes([0]) + s[5:]),
+    ('truncated', s[:8]),
+    ('truncated', s[:12]),
+    ('truncated', b'WFMT\x01'),
+    ('truncated', b''),
+]
+for i in range(1, len(s)):
+    cases.append(('cut', s[:i]))
+bad = bytearray(s)
+bad[100] ^= 0xFF
+cases.append(('checksum', bytes(bad)))
+cases.append(('checksum', s[:-4] + b'\x00\x00\x00\x00'))
+cases.append(('checksum', s[:-4] + bytes([s[-4] ^ 1]) + s[-3:]))
+for cnt in (4, 6, 0, 1, 99):
+    body = s[:5] + struct.pack('<I', cnt) + s[9:-4]
+    cases.append(('count', body + struct.pack('<I', compute_crc(body))))
+bad2 = bytearray(s)
+bad2[9:10] = b'\xff'
+cases.append('varint?' and ('varint?', bytes(bad2)))
+overlong = pack_header(1) + b'\x80' * 11 + b'\x00'
+cases.append(('varint?', overlong + struct.pack('<I', compute_crc(overlong))))
+huge = pack_header(1) + b'\xff' * 9 + b'\x7f\x00'
+cases.append(('varint?', huge + struct.pack('<I', compute_crc(huge))))
+cases.append(('magic', b'not a container at all'))
+cases.append(('truncated?', b'WFMT\x01\x00\x00\x00\x00'))
+
+for want, data in cases:
+    k = kind(unpack, data)
+    assert isinstance(k, str) and not k.startswith('OTHER'), (want, k, data[:20])
+    if want in ('cut', 'count', 'varint?', 'structure?', 'truncated?'):
+        assert k in ('truncated', 'structure', 'varint', 'checksum'), (want, k)
+    else:
+        assert k == want, (want, k)
+    assert verify(data) is False, (want, k)
+    ks = kind(list, iter_records(io.BytesIO(data)))
+    assert isinstance(ks, str) and not ks.startswith('OTHER'), (want, ks)
+    assert kind(read_all, io.BytesIO(data)) == ks
+for data in (b'', b'x', None, 3, 'a string', object(), s[:3], [1, 2, 3], 3.5):
+    assert verify(data) is False, data
+assert kind(pack, [(-1, b'x')]) == 'varint'
+assert kind(pack, [(1, 2, 3)]) == 'structure'
+assert kind(pack, [None]) == 'structure'
+print('D ok')
+
+# ---------- E ----------
+class Spy(object):
+    def __init__(self, data):
+        self._b = io.BytesIO(data)
+        self.calls = []
+        self.bytes_read = 0
+
+    def read(self, n=None):
+        self.calls.append(n)
+        if not isinstance(n, int) or n <= 0:
+            raise AssertionError('整体读取被禁止：read(%r)' % (n,))
+        out = self._b.read(n)
+        self.bytes_read += len(out)
+        return out
+
+
+payload0 = bytes([7]) * 5000
+big = pack([(i, payload0 if i == 0 else bytes([i % 256]) * 5000) for i in range(400)])
+spy = Spy(big)
+it = iter_records(spy)
+first = next(it)
+assert first == (0, payload0), (first[0], len(first[1]))
+assert max(spy.calls) <= wfmt.CHUNK_SIZE
+assert spy.bytes_read < len(big) // 4, (spy.bytes_read, len(big))
+rest = list(it)
+assert rest == [(i, bytes([i % 256]) * 5000) for i in range(1, 400)]
+assert max(spy.calls) <= wfmt.CHUNK_SIZE
+print('E lazy ok bytes_read=%d/%d reads=%d' % (spy.bytes_read, len(big), len(spy.calls)))
+
+badbig = bytearray(big)
+badbig[1000] ^= 0x5A
+assert kind(list, iter_records(Spy(bytes(badbig)))) == 'checksum'
+spy3 = Spy(bytes(badbig))
+it3 = iter_records(spy3)
+n = 0
+try:
+    while True:
+        next(it3)
+        n += 1
+except WFormatError as ex:
+    assert ex.kind == 'checksum', ex.kind
+    assert n == 400, n
+else:
+    raise AssertionError('should raise checksum')
+assert max(spy3.calls) <= wfmt.CHUNK_SIZE
+
+junk = s + b'\x00\x00\x00\x00'
+assert kind(unpack, junk) == 'structure'
+assert kind(list, iter_records(io.BytesIO(junk))) == 'structure'
+
+# 大文件流式：不能把整个容器读进内存
+huge_blob = pack([(i, b'p' * 100000) for i in range(50)])
+spy4 = Spy(huge_blob)
+it4 = iter_records(spy4)
+got = next(it4)
+assert got == (0, b'p' * 100000)
+assert spy4.bytes_read < 3 * wfmt.CHUNK_SIZE + 100000 + 64, spy4.bytes_read
+assert sum(1 for _ in it4) == 49
+print('E ok bytes_read_first=%d of %d' % (spy4.bytes_read, len(huge_blob)))
+
+# ---------- F ----------
+for name in ('pack', 'unpack', 'verify', 'iter_records', 'read_all',
+             'WFormatError', 'MAGIC', 'VERSION', 'HEADER_SIZE', 'CRC_SIZE',
+             'CHUNK_SIZE', 'ALIGN', 'encode_record', 'decode_record',
+             'encode_uvarint', 'decode_uvarint', 'compute_crc', 'pack_header',
+             'parse_header'):
+    assert hasattr(wfmt, name), name
+assert wfmt.MAGIC == b'WFMT' and wfmt.VERSION == 1
+assert (wfmt.HEADER_SIZE, wfmt.CRC_SIZE, wfmt.ALIGN) == (9, 4, 4)
+assert parse_header(s[:9]) == (1, 5)
+assert pack_header(5) == s[:9]
+assert issubclass(WFormatError, Exception)
+assert WFormatError('checksum').kind == 'checksum'
+assert WFormatError('x', 'msg', foo=1).details == {'foo': 1}
+print('F ok')
+print('ALL OK')
diff --git a/_selfcheck2.py b/_selfcheck2.py
new file mode 100644
index 0000000..e5797ca
--- /dev/null
+++ b/_selfcheck2.py
@@ -0,0 +1,58 @@
+import io
+
+import wfmt
+
+CH = wfmt.CHUNK_SIZE
+
+
+class Spy(object):
+    def __init__(self, data):
+        self._b = io.BytesIO(data)
+        self.calls = []
+        self.bytes_read = 0
+
+    def read(self, n=None):
+        self.calls.append(n)
+        assert isinstance(n, int) and n > 0, n
+        out = self._b.read(n)
+        self.bytes_read += len(out)
+        return out
+
+
+blob = wfmt.pack([(i, bytes([i % 251]) * 20000) for i in range(200)])
+print('container size', len(blob), 'chunk', CH)
+
+spy = Spy(blob)
+it = wfmt.iter_records(spy)
+first = next(it)
+print('after 1st record: reads=%s bytes_read=%d (%.2f%% of file)'
+      % (spy.calls, spy.bytes_read, 100.0 * spy.bytes_read / len(blob)))
+assert first == (0, bytes(20000))
+assert spy.bytes_read < len(blob) * 0.01
+
+second = next(it)
+print('after 2nd record: reads=%d bytes_read=%d' % (len(spy.calls), spy.bytes_read))
+assert second == (1, bytes([1]) * 20000)
+
+rest = list(it)
+assert len(rest) == 198
+print('total reads=%d max n=%d total bytes=%d' % (len(spy.calls), max(spy.calls), spy.bytes_read))
+assert max(spy.calls) <= CH
+
+# 只取前 3 条就放弃：不应读完整个文件
+spy2 = Spy(blob)
+count = 0
+for rec in wfmt.iter_records(spy2):
+    count += 1
+    if count == 3:
+        break
+print('aborted after 3: bytes_read=%d of %d' % (spy2.bytes_read, len(blob)))
+assert spy2.bytes_read < len(blob) * 0.02
+
+# 零记录 / 单记录容器的读取次数
+for recs in ([], [(1, b'a')], [(2, b'')]):
+    b = wfmt.pack(recs)
+    sp = Spy(b)
+    assert list(wfmt.iter_records(sp)) == recs
+    print('records=%d size=%d reads=%s' % (len(recs), len(b), sp.calls))
+print('LAZY OK')
diff --git a/_selfcheck3.py b/_selfcheck3.py
