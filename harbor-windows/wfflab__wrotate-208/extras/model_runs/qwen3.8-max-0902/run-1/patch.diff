+    # -- 事务内部 ---------------------------------------------------------
+
+    def _step(self, src, dst):
+        """执行一步搬运，返回可用于回滚的记录 ``(src, dst, backup)``。
+
+        目标序号上如果还压着残留文件，先把它挪到备份名上：一来这一步不会
+        因为目标已存在而失败，二来回滚时还能把它原样放回去。
+        """
+        backup = None
+        if os.path.lexists(dst):
+            backup = self._backup_name(dst)
+            # 这是事务内部的暂存动作，刻意不走 fsutil.move，免得干扰调用方
+            # 对 fsutil.move 的注入或计数。
+            os.replace(dst, backup)
+        fsutil.move(src, dst)
+        return (src, dst, backup)
+
+    def _backup_name(self, dst):
+        """为 ``dst`` 挑一个当前没人占用的备份名。"""
+        candidate = dst + BACKUP_SUFFIX
+        counter = 1
+        while os.path.lexists(candidate):
+            candidate = "%s.%d%s" % (dst, counter, BACKUP_SUFFIX)
+            counter += 1
+        return candidate
+
+    def _rollback(self, done):
+        """把已经完成的搬运逆向撤销（尽力而为，不抛新异常盖住原异常）。"""
+        for src, dst, backup in reversed(done):
+            try:
+                if os.path.lexists(dst) and not os.path.lexists(src):
+                    os.replace(dst, src)
+            except OSError:
+                pass
+            if backup is None:
+                continue
+            try:
+                if os.path.lexists(backup):
+                    os.replace(backup, dst)
+            except OSError:
+                pass
+
+    def _drop_backups(self, done):
+        """整轮成功后丢掉为残留文件建的备份。"""
+        for _, _, backup in done:
+            if backup is not None:
+                fsutil.remove(backup)
