+def _replace(src, dst):
+    """``os.replace`` 的最小封装：目标已存在时覆盖它。
+
+    Windows 上 ``os.rename`` 在目标已存在时会抛 ``FileExistsError``，而上一轮
+    异常退出留下的残留文件恰恰就占着目标序号，所以这里一律用 ``os.replace``：
+    覆盖已存在的目标是它的正常语义，并且仍然是同一目录内的原子操作。
+    """
+    os.replace(src, dst)
+    return dst
+
