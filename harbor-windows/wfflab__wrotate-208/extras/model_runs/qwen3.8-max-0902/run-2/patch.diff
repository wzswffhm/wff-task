+
+def restore(src, dst):
+    """撤销一次 :func:`move`：把 ``src`` 搬回 ``dst``。
+
+    回滚路径刻意不复用 :func:`move`：出错的往往就是搬运这一步（它可能被替换、
+    被打桩，或者正被目标机器上的权限问题卡住），回滚必须自己还能走通，
+    否则「失败即回到开始前的状态」就成了空话。
+    """
+    return _replace(src, dst)
 
 
