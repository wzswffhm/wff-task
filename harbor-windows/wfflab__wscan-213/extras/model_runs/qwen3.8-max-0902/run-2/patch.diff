+def _remove_quietly(path):
+    """尽力删除 ``path``（必要时先清只读），失败也不抛。"""
+    try:
+        os.unlink(path)
+    except OSError:
+        try:
+            _clear_readonly(path)
+            os.unlink(path)
+        except OSError:
+            pass
