+def _is_reparse(st):
+    """重解析点判定：junction / 目录符号链接 / 文件符号链接。"""
+    return bool(st.st_file_attributes & REPARSE_POINT)
+
+
+def iter_files(root):
+    """遍历 root，产出每个普通文件的绝对路径。
+
+    与 os.walk 不同：带重解析点的目录（junction / 目录符号链接）一律
+    不进入——os.path.islink 对 junction 返回 False，os.walk 即使
+    followlinks=False 也会进入，必须用 lstat 的
+    st_file_attributes & FILE_ATTRIBUTE_REPARSE_POINT 隔离。
+    带重解析点的文件同样不统计。
+    """
+    stack = [root]
+    while stack:
+        current = stack.pop()
+        subdirs = []
+        with os.scandir(current) as it:
+            for entry in it:
+                try:
+                    st = entry.stat(follow_symlinks=False)
+                except OSError:
+                    continue
+                if _is_reparse(st):
+                    continue
+                if stat.S_ISDIR(st.st_mode):
+                    subdirs.append(entry.path)
+                else:
+                    yield entry.path
+        stack.extend(subdirs)
+
+
+def _check_root(root):
+    if not os.path.isdir(root):
+        raise WScanError("root", root=root)
+
+
