   1| # WReparse - Audit.ps1
   2| # Deterministic ordering, statistics and serialisation.
   3| # Part of the WReparse reference implementation.
   4| 
   5| # Stable merge sort so the report never depends on the enumerator order or on
   6| # the host culture. Sort-Object is deliberately not used: its default string
   7| # comparison is culture-aware and would order non-ASCII names differently on
   8| # different hosts.
   9| function Sort-WReparseStable {
  10|     [CmdletBinding()]
  11|     param(
  12|         [AllowEmptyCollection()][object[]]$Items,
  13|         [Parameter(Mandatory = $true)][scriptblock]$KeySelector
  14|     )
  15|     $array = @($Items)
  16|     if ($array.Count -le 1) { return @($array) }
  17|     $middle = [int]($array.Count / 2)
  18|     $left = @(Sort-WReparseStable -Items @($array[0..($middle - 1)]) -KeySelector $KeySelector)
  19|     $right = @(Sort-WReparseStable -Items @($array[$middle..($array.Count - 1)]) -KeySelector $KeySelector)
  20|     $merged = New-Object System.Collections.ArrayList
  21|     $i = 0
  22|     $j = 0
  23|     while ($i -lt $left.Count -and $j -lt $right.Count) {
  24|         $leftKey = [string](& $KeySelector $left[$i])
  25|         $rightKey = [string](& $KeySelector $right[$j])
  26|         if ((Compare-WReparsePath -Left $leftKey -Right $rightKey) -le 0) {
  27|             [void]$merged.Add($left[$i]); $i++
  28|         }
  29|         else {
  30|             [void]$merged.Add($right[$j]); $j++
  31|         }
  32|     }
  33|     while ($i -lt $left.Count) { [void]$merged.Add($left[$i]); $i++ }
  34|     while ($j -lt $right.Count) { [void]$merged.Add($right[$j]); $j++ }
  35|     return @($merged.ToArray())
  36| }
