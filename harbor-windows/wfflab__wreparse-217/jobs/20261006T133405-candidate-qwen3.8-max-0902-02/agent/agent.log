   6| #   * full (rooted) path with '.' and '..' collapsed
   7| #   * no trailing directory separator, except for a volume root ('C:\')
   8| #     or a UNC share root ('\\server\share')
   9| #   * original casing preserved
  10| function Get-WReparseCanonicalPath {
  11|     [CmdletBinding()]
  12|     param(
  13|         [Parameter(Mandatory = $true)][string]$Path
  14|     )
  15|     $full = [System.IO.Path]::GetFullPath($Path)
  16|     $trimmed = $full.TrimEnd([char]'\', [char]'/')
  17|     return $trimmed.ToLowerInvariant()
  18| }
  19| 
  20| # Directory-boundary aware containment. 'C:\root2' is NOT inside 'C:\root'
  21| # even though 'C:\root2'.StartsWith('C:\root') is true. Windows path
  22| # comparison is case-insensitive, so the ordinal-ignore-case comparer is used.
  23| function Test-WReparseWithinRoot {
  24|     [CmdletBinding()]
  25|     param(
  26|         [Parameter(Mandatory = $true)][string]$Path,
  27|         [Parameter(Mandatory = $true)][string]$Root
  28|     )
  29|     if ([string]::IsNullOrWhiteSpace($Path) -or [string]::IsNullOrWhiteSpace($Root)) {
  30|         return $false
  31|     }
  32|     $p = Get-WReparseCanonicalPath $Path
  33|     $r = Get-WReparseCanonicalPath $Root
  34|     return $p.StartsWith($r, [System.StringComparison]::OrdinalIgnoreCase)
