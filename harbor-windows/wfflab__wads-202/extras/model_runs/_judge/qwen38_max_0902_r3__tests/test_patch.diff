+"""NTFS 备用数据流在归档与发布流程中的行为验证。
+
+覆盖三类只在 NTFS 上成立的语义：备用数据流不会被普通文件复制带走、
+备用流的大小与主数据大小是两回事、以及清除标记必须对未标记的文件幂等。
+"""
+
+import os
+
+import pytest
+
+from wdl import (
+    ZONE_STREAM,
+    archive_tree,
+    copy_file,
+    is_blocked,
+    read_stream,
+    stream_exists,
+    stream_size,
+    unblock,
+    write_stream,
+)
+
+ZONE_PAYLOAD = b"[ZoneTransfer]\r\nZoneId=3\r\nReferrerUrl=https://example.com\r\n"
+
+
+@pytest.fixture()
+def marked_file(tmp_path):
+    path = tmp_path / "report.pdf"
+    path.write_bytes(b"PDF-PAYLOAD")
+    write_stream(str(path), ZONE_STREAM, ZONE_PAYLOAD)
+    return path
+
+
+# --- 核心回归（base 上失败） ------------------------------------------------
+
+
+def test_copy_preserves_zone_identifier_stream(marked_file, tmp_path):
+    dst = tmp_path / "archived" / "report.pdf"
+    copy_file(str(marked_file), str(dst))
+    assert stream_exists(str(dst), ZONE_STREAM)
+    assert read_stream(str(dst), ZONE_STREAM) == ZONE_PAYLOAD
+
+
+def test_archive_tree_preserves_stream_on_nested_file(tmp_path):
+    src = tmp_path / "src"
+    (src / "inbox").mkdir(parents=True)
+    nested = src / "inbox" / "invoice.pdf"
+    nested.write_bytes(b"INVOICE")
+    write_stream(str(nested), ZONE_STREAM, ZONE_PAYLOAD)
+
+    archive_tree(str(src), str(tmp_path / "dst"))
+
+    dst = tmp_path / "dst" / "inbox" / "invoice.pdf"
+    assert stream_exists(str(dst), ZONE_STREAM)
+    assert read_stream(str(dst), ZONE_STREAM) == ZONE_PAYLOAD
+
+
+def test_stream_size_reports_stream_length(marked_file):
+    assert stream_size(str(marked_file), ZONE_STREAM) == len(ZONE_PAYLOAD)
+
+
+def test_unblock_on_unmarked_file_does_not_raise(tmp_path):
+    plain = tmp_path / "local.txt"
+    plain.write_bytes(b"local")
+    assert unblock(str(plain)) is False
+    assert plain.read_bytes() == b"local"
+
+
+def test_unblock_returns_false_when_no_stream(tmp_path):
+    plain = tmp_path / "local2.txt"
+    plain.write_bytes(b"local")
+    assert is_blocked(str(plain)) is False
+    assert unblock(str(plain)) is False
+
+
+def test_unblock_removes_stream_and_reports_change(marked_file):
+    assert is_blocked(str(marked_file)) is True
+    assert unblock(str(marked_file)) is True
+    assert is_blocked(str(marked_file)) is False
+    assert marked_file.read_bytes() == b"PDF-PAYLOAD"
+
+
+def test_copy_then_unblock_clears_inherited_marker(marked_file, tmp_path):
+    dst = tmp_path / "published" / "report.pdf"
+    copy_file(str(marked_file), str(dst))
+    assert is_blocked(str(dst)) is True
+    unblock(str(dst))
+    assert is_blocked(str(dst)) is False
+
+
+# --- 回归保护（base 与参考解上都必须通过） ----------------------------------
+
+
+def test_write_then_read_stream_roundtrip(tmp_path):
+    path = tmp_path / "a.bin"
+    path.write_bytes(b"x")
+    write_stream(str(path), ZONE_STREAM, b"payload")
+    assert read_stream(str(path), ZONE_STREAM) == b"payload"
+
+
+def test_stream_exists_false_for_missing(tmp_path):
+    path = tmp_path / "b.bin"
+    path.write_bytes(b"x")
+    assert stream_exists(str(path), ZONE_STREAM) is False
+
+
+def test_stream_size_zero_when_absent(tmp_path):
+    path = tmp_path / "c.bin"
+    path.write_bytes(b"x")
+    assert stream_size(str(path), ZONE_STREAM) == 0
+
+
+def test_copy_preserves_content_and_metadata(marked_file, tmp_path):
+    dst = tmp_path / "copy.pdf"
+    copy_file(str(marked_file), str(dst))
+    assert dst.read_bytes() == b"PDF-PAYLOAD"
+    assert os.path.getsize(str(dst)) == len(b"PDF-PAYLOAD")
+
+
+def test_copy_creates_missing_parent_directories(marked_file, tmp_path):
+    dst = tmp_path / "deep" / "nested" / "copy.pdf"
+    copy_file(str(marked_file), str(dst))
+    assert dst.is_file()
+
+
+def test_archive_tree_returns_sorted_relative_paths(tmp_path):
+    src = tmp_path / "src2"
+    src.mkdir()
+    for name in ("b.txt", "a.txt", "c.txt"):
+        (src / name).write_bytes(name.encode())
+    done = archive_tree(str(src), str(tmp_path / "dst2"))
+    assert done == ["a.txt", "b.txt", "c.txt"]
