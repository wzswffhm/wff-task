-"""把文件归档到目标目录。"""
+"""把文件归档到目标目录。
+
+``shutil.copy2`` 只搬运主数据，NTFS 备用数据流会被原地留在源文件上；
+归档必须自己把 :data:`PORTABLE_STREAMS` 里列出的流一并搬过去，否则副本
+不再带来源标记，内网发布流程会把下载来的文件当成本地产生的。
+"""
 
 import os
 import shutil
 
-from .streams import ZONE_STREAM, read_stream, stream_exists, write_stream
+from .streams import (
+    ZONE_STREAM,
+    read_stream,
+    remove_stream,
+    stream_exists,
+    write_stream,
+)
 
 #: 归档时需要一并带走的备用数据流。
 PORTABLE_STREAMS = (ZONE_STREAM,)
@@ -12,17 +23,21 @@ PORTABLE_STREAMS = (ZONE_STREAM,)
 def copy_file(src, dst):
     """把 ``src`` 复制到 ``dst``，返回 ``dst``。
 
-    目标目录不存在时会被创建。
+    目标目录不存在时会被创建。除主数据之外，:data:`PORTABLE_STREAMS`
+    中列出的备用数据流也会按字节搬到目标文件上；源文件没有的流不会在
+    目标上残留。
     """
     parent = os.path.dirname(os.path.abspath(dst))
     os.makedirs(parent, exist_ok=True)
     shutil.copy2(src, dst)
+    _copy_streams(src, _stream_target(src, dst))
     return dst
 
 
 def archive_tree(src_root, dst_root):
     """把 ``src_root`` 下的普通文件归档到 ``dst_root``。
 
+    备用数据流随文件一起搬运，嵌套子目录同样处理。
     返回已归档文件相对 ``src_root`` 的路径列表（升序）。
     """
     done = []
@@ -33,3 +48,27 @@ def archive_tree(src_root, dst_root):
             copy_file(src, os.path.join(dst_root, rel))
             done.append(rel)
     return sorted(done)
+
+
+def _stream_target(src, dst):
+    """``dst`` 是已存在的目录时，``shutil.copy2`` 会把文件放进目录里，
+    备用数据流也要落在真正的那个文件上。"""
+    if os.path.isdir(dst):
+        return os.path.join(dst, os.path.basename(src))
+    return dst
+
+
+def _copy_streams(src, dst, names=PORTABLE_STREAMS):
+    """把 ``names`` 里的备用数据流从 ``src`` 搬到 ``dst``。
+
+    返回真正复制过去的流名元组。源上没有、目标上却残留的流会被删掉，
+    保证目标文件的流集合与源一致。
+    """
+    copied = []
+    for name in names:
+        if stream_exists(src, name):
+            write_stream(dst, name, read_stream(src, name))
+            copied.append(name)
+        else:
+            remove_stream(dst, name)
+    return tuple(copied)
