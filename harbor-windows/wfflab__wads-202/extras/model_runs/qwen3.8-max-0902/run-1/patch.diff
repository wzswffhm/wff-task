diff --git a/wdl/archive.py b/wdl/archive.py
index 391d3ac..31f28ae 100644
--- a/wdl/archive.py
+++ b/wdl/archive.py
@@ -3,7 +3,13 @@
 import os
 import shutil
 
-from .streams import ZONE_STREAM, read_stream, stream_exists, write_stream
+from .streams import (
+    ZONE_STREAM,
+    read_stream,
+    remove_stream,
+    stream_exists,
+    write_stream,
+)
 
 #: 归档时需要一并带走的备用数据流。
 PORTABLE_STREAMS = (ZONE_STREAM,)
@@ -13,10 +19,21 @@ def copy_file(src, dst):
     """把 ``src`` 复制到 ``dst``，返回 ``dst``。
 
     目标目录不存在时会被创建。
+
+    除主数据外，``PORTABLE_STREAMS`` 中列出的备用数据流（如
+    ``Zone.Identifier``）也会一并搬运：``shutil`` 的复制只覆盖主数据，
+    来源标记必须显式地读出来再写到副本上，归档后的文件才能保持
+    与源一致的标记状态。
     """
     parent = os.path.dirname(os.path.abspath(dst))
     os.makedirs(parent, exist_ok=True)
     shutil.copy2(src, dst)
+    for name in PORTABLE_STREAMS:
+        if stream_exists(src, name):
+            write_stream(dst, name, read_stream(src, name))
+        else:
+            # 副本应与源保持一致：源上没有的标记不能残留在目标上。
+            remove_stream(dst, name)
     return dst
 
 
diff --git a/wdl/streams.py b/wdl/streams.py
index 4f0295d..208fd15 100644
--- a/wdl/streams.py
+++ b/wdl/streams.py
@@ -25,9 +25,11 @@ def stream_exists(path, name):
 
 def stream_size(path, name):
     """返回备用数据流的字节数；流不存在时返回 ``0``。"""
-    if not stream_exists(path, name):
+    target = stream_path(path, name)
+    if not os.path.isfile(target):
         return 0
-    return os.path.getsize(path)
+    # 大小必须取自流本身，而不是主数据。
+    return os.path.getsize(target)
 
 
 def read_stream(path, name):
@@ -50,5 +52,9 @@ def remove_stream(path, name):
     target = stream_path(path, name)
     if not os.path.isfile(target):
         return False
-    os.remove(target)
+    try:
+        os.remove(target)
+    except FileNotFoundError:
+        # 检查与删除之间流已被别处移除，同样视为「不存在」。
+        return False
     return True
