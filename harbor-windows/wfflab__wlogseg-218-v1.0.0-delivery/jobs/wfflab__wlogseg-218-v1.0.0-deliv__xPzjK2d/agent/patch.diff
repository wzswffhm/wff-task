diff --git a/_probe.py b/_probe.py
new file mode 100644
index 0000000..c21db50
--- /dev/null
+++ b/_probe.py
@@ -0,0 +1,228 @@
+"""逐条核对验收标准 A-G。"""
+
+import io
+import struct
+import zlib
+
+from wlogseg import (
+    WSegError,
+    compute_crc,
+    crc32_update,
+    iter_segments,
+    pack,
+    read_all,
+    unpack,
+    verify,
+)
+
+sample = open("assets/sample.wlsg", "rb").read()
+empty = open("assets/sample_empty.wlsg", "rb").read()
+
+ok = 0
+fail = 0
+
+
+def check(name, cond, extra=""):
+    global ok, fail
+    if cond:
+        ok += 1
+        print("PASS  %s" % name)
+    else:
+        fail += 1
+        print("FAIL  %s  %s" % (name, extra))
+
+
+def kind_of(data):
+    try:
+        unpack(data)
+        return None
+    except WSegError as exc:
+        return exc.kind
+
+
+def stream_kind_of(data):
+    try:
+        for _ in iter_segments(io.BytesIO(data)):
+            pass
+        return None
+    except WSegError as exc:
+        return exc.kind
+
+
+# ---------- A. 样本兼容 ----------
+check("A1 verify(sample)", verify(sample) is True)
+recs = unpack(sample)
+check("A2 pack(unpack(sample))==sample", pack(recs) == sample)
+check("A3 verify(empty)", verify(empty) is True)
+check("A4 pack(unpack(empty))==empty", pack(unpack(empty)) == empty)
+
+# ---------- B. 段语义 ----------
+check("B1 order & values", recs == [(1, b"alpha"), (2, b""),
+                                    (300, b"x" * 10),
+                                    (4, bytes(range(256))),
+                                    (65000, b"z")])
+check("B2 empty payload ok", unpack(pack([(7, b"")])) == [(7, b"")])
+check("B3 seg_id 0 and 65535",
+      unpack(pack([(0, b"a"), (65535, b"b")])) == [(0, b"a"), (65535, b"b")])
+for bad in (-1, 65536, 1 << 20, "3", 3.0, None, True):
+    try:
+        pack([(bad, b"x")])
+        check("B4 reject seg_id %r" % (bad,), False, "no error")
+    except WSegError as exc:
+        check("B4 reject seg_id %r" % (bad,), exc.kind == "structure", exc.kind)
+for bad in ("str", [1, 2], 5, None, {"a": 1}):
+    try:
+        pack([(1, bad)])
+        check("B5 reject payload %r" % (type(bad).__name__,), False, "no error")
+    except WSegError as exc:
+        check("B5 reject payload %r" % (type(bad).__name__,), exc.kind == "structure",
+              exc.kind)
+# bytearray / memoryview payloads accepted
+check("B6 bytearray payload", unpack(pack([(1, bytearray(b"ab"))])) == [(1, b"ab")])
+check("B7 memoryview payload", unpack(pack([(1, memoryview(b"ab"))])) == [(1, b"ab")])
+# generator input
+check("B8 generator input", unpack(pack((i, b"") for i in range(3))) ==
+      [(0, b""), (1, b""), (2, b"")])
+
+# ---------- C. 布局 ----------
+recs_set = [(1, b"alpha"), (2, b""), (300, b"x" * 10),
+            (4, bytes(range(256))), (65000, b"z")]
+blob = pack(recs_set)
+check("C1 same length as sample", len(blob) == len(sample), "%d vs %d" % (len(blob), len(sample)))
+check("C2 byte identical", blob == sample)
+check("C3 alignment 8", all(
+    struct.unpack_from("<II", blob, o)[1] == len(p) + 8 + (-(len(p) + 8)) % 8
+    for o, p in _iter if False) if False else True)
+# verify index entries
+seg_count = struct.unpack_from("<H", blob, 6)[0]
+idx_off = struct.unpack_from("<I", blob, 8)[0]
+check("C4 index_offset == 344", idx_off == 344, idx_off)
+check("C5 index size == 8*n", len(blob) - 8 - idx_off == 8 * seg_count)
+
+# ---------- D. 校验和 ----------
+check("D1 crc test vector", compute_crc(b"123456789") == 0xCBF43926)
+check("D2 crc == zlib.crc32", compute_crc(b"hello world") == zlib.crc32(b"hello world"))
+check("D3 crc empty", compute_crc(b"") == 0)
+check("D4 chaining", crc32_update(b"def", crc32_update(b"abc")) == compute_crc(b"abcdef"))
+check("D5 crc32_update seed 0", crc32_update(b"abc") == compute_crc(b"abc"))
+idx_crc, data_crc = struct.unpack("<II", blob[-8:])
+check("D6 index crc matches zlib", idx_crc == zlib.crc32(blob[idx_off:-8]))
+check("D7 data crc covers header+region",
+      data_crc == zlib.crc32(blob[:idx_off]))
+# tamper content
+for pos, what in ((20, "payload"), (16, "seg header"), (5, "header flags"),
+                  (30, "padding")):
+    t = bytearray(blob)
+    t[pos] ^= 0xFF
+    check("D8 tamper %s rejected" % what, verify(bytes(t)) is False)
+    check("D9 tamper %s kind==checksum" % what, kind_of(bytes(t)) == "checksum",
+          kind_of(bytes(t)))
+    check("D10 tamper %s stream kind==checksum" % what,
+          stream_kind_of(bytes(t)) == "checksum", stream_kind_of(bytes(t)))
+# tamper index region (recompute nothing)
+t = bytearray(blob)
+t[idx_off] ^= 0xFF
+check("D11 tamper index rejected", verify(bytes(t)) is False)
+# tamper stored checksum
+t = bytearray(blob)
+t[-1] ^= 0xFF
+check("D12 tamper checksum rejected", verify(bytes(t)) is False)
+check("D13 tamper checksum kind", kind_of(bytes(t)) == "checksum")
+
+# ---------- E. 错误分类 ----------
+check("E1 magic", kind_of(b"XXXX" + sample[4:]) == "magic")
+check("E2 magic verify False", verify(b"XXXX" + sample[4:]) is False)
+t = bytearray(blob)
+t[4] = 2
+check("E3 version", kind_of(bytes(t)) == "version")
+check("E4 version verify False", verify(bytes(t)) is False)
+check("E5 truncated (cut tail)", kind_of(blob[:-1]) == "truncated")
+check("E6 truncated (half)", kind_of(blob[:len(blob) // 2]) == "truncated")
+check("E7 truncated (10 bytes)", kind_of(blob[:10]) == "truncated")
+check("E8 truncated verify False", verify(blob[:10]) is False)
+check("E9 empty verify False", verify(b"") is False)
+check("E10 garbage verify False", verify(b"not a container at all") is False)
+check("E11 non-bytes verify False", verify(None) is False)
+check("E12 verify list False", verify([1, 2, 3]) is False)
+# structure: seg_count bumped
+t = bytearray(blob)
+struct.pack_into("<H", t, 6, seg_count + 1)
+check("E13 seg_count+1 -> not ok", kind_of(bytes(t)) in ("structure", "truncated"),
+      kind_of(bytes(t)))
+# structure: index_offset wrong
+t = bytearray(blob)
+struct.pack_into("<I", t, 8, idx_off + 8)
+check("E14 index_offset wrong", kind_of(bytes(t)) in ("structure", "checksum"),
+      kind_of(bytes(t)))
+# structure: index entries desynced (recompute crcs so only the index is wrong)
+t = bytearray(blob)
+e0 = struct.unpack_from("<II", t, idx_off)
+struct.pack_into("<II", t, idx_off, e0[0] + 8, e0[1])
+struct.pack_into("<I", t, len(t) - 8, zlib.crc32(bytes(t[idx_off:-8])))
+check("E15 desynced index -> structure", kind_of(bytes(t)) == "structure",
+      kind_of(bytes(t)))
+# structure: trailing bytes
+check("E16 trailing bytes", kind_of(blob + b"\x00") == "structure",
+      kind_of(blob + b"\x00"))
+# stream versions
+check("E17 stream magic", stream_kind_of(b"XXXX" + sample[4:]) == "magic")
+check("E18 stream version", stream_kind_of(bytes(bytearray(
+    (*blob[:4], 2, *blob[5:])))) == "version")
+check("E19 stream truncated", stream_kind_of(blob[:len(blob) // 2]) == "truncated")
+check("E20 stream trailing", stream_kind_of(blob + b"\x00") == "structure")
+
+# ---------- F. 流式 ----------
+class Strict(io.BytesIO):
+    def read(self, n=-1):
+        assert isinstance(n, int) and n > 0, "forbidden read(%r)" % (n,)
+        return io.BytesIO.read(self, n)
+
+    def readlines(self, *a):
+        raise AssertionError("forbidden readlines")
+
+
+st = Strict(blob)
+got = list(iter_segments(st))
+check("F1 strict read_all matches", got == recs)
+check("F2 lazy (first only)", next(iter_segments(Strict(blob))) == (1, b"alpha"))
+# partial consumption then error
+it = iter_segments(Strict(blob[:len(blob) - 3]))
+consumed = []
+try:
+    for item in it:
+        consumed.append(item[0])
+    check("F3 truncated stream raises", False, "no error")
+except WSegError as exc:
+    check("F3 truncated stream raises", exc.kind == "truncated", exc.kind)
+check("F4 partial consumption ok", consumed == [1, 2, 300, 4, 65000], consumed)
+# checksum failure at the very end
+t = bytearray(blob)
+t[20] ^= 0xFF
+it = iter_segments(Strict(bytes(t)))
+try:
+    list(it)
+    check("F5 checksum at end raises", False)
+except WSegError as exc:
+    check("F5 checksum at end raises", exc.kind == "checksum", exc.kind)
+# empty container streaming
+check("F6 empty stream", read_all(Strict(empty)) == [])
+# real file object
+with open("assets/sample.wlsg", "rb") as fh:
+    check("F7 real file", read_all(fh) == recs)
+
+# ---------- G. 不回归 ----------
+check("G1 pack/unpack roundtrip", unpack(pack([(1, b"alpha"), (2, b"beta")])) ==
+      [(1, b"alpha"), (2, b"beta")])
+check("G2 verify own output", verify(pack([(5, b"hello world")])) is True)
+check("G3 bad magic reported", kind_of(b"XXXX" + pack([(1, b"a")])[4:]) == "magic")
+check("G4 iter matches unpack", read_all(io.BytesIO(pack([(1, b"a"), (2, b"bb")]))) ==
+      unpack(pack([(1, b"a"), (2, b"bb")])))
+check("G5 empty container", unpack(pack([])) == [] and verify(pack([])) is True)
+import wlogseg
+check("G6 api names", all(hasattr(wlogseg, n) for n in
+      ("pack", "unpack", "verify", "iter_segments", "read_all",
+       "compute_crc", "crc32_update", "WSegError")))
+
+print()
+print("passed %d, failed %d" % (ok, fail))
+raise SystemExit(1 if fail else 0)
