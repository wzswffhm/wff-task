+import struct
+import zlib
+
+# Verify empty sample
+data = open('assets/sample_empty.wlsg','rb').read()
+header = data[:16]
+# No segments, no index entries
+# idx_crc should be CRC of empty bytes = 0
+# data_crc should be CRC of header only (since no segments)
+idx_crc = struct.unpack_from('<I', data, 16)[0]
+data_crc = struct.unpack_from('<I', data, 20)[0]
+
+print(f"Empty sample:")
+print(f"  idx_crc expected=0x{idx_crc:08x}, computed=0x{zlib.crc32(b'') & 0xFFFFFFFF:08x}")
+print(f"  data_crc expected=0x{data_crc:08x}, computed(header)=0x{zlib.crc32(header) & 0xFFFFFFFF:08x}")
+
+# Now let's understand what pack() should produce for the sample segments
+# Segments from sample:
+# (1, b'alpha'), (2, b''), (300, b'xxxxxxxxxx'), (4, bytes(range(256))), (65000, b'z')
+
+segments = [
+    (1, b'alpha'),
+    (2, b''),
+    (300, b'xxxxxxxxxx'),
+    (4, bytes(range(256))),
+    (65000, b'z'),
+]
+
+# Build container
+ALIGNMENT = 8
+SEG_HEADER_SIZE = 8
+
+def pad_len(body_len):
+    return (-(SEG_HEADER_SIZE + body_len)) % ALIGNMENT
+
+def seg_total(body_len):
+    return SEG_HEADER_SIZE + body_len + pad_len(body_len)
+
+# Encode segments
+seg_bytes = bytearray()
+offsets = []
+cursor = 16  # after header
+
+for seg_id, payload in segments:
+    offsets.append((cursor, seg_total(len(payload))))
+    
+    head = struct.pack('<HBBI', seg_id, 0, 0, len(payload))
+    body = payload
+    padding = b'\x00' * pad_len(len(payload))
+    seg_bytes += head + body + padding
+    cursor += seg_total(len(payload))
+
+index_offset = cursor
+print(f"\nRebuilt container:")
+print(f"  Segment region size: {len(seg_bytes)}")
+print(f"  Index offset: {index_offset}")
+print(f"  Expected index offset: 344")
+
+# Build index (8-byte entries)
+index_bytes = bytearray()
+for off, ln in offsets:
+    index_bytes += struct.pack('<II', off, ln)
+
+# Build header
+header = struct.pack('<4sBBHII', b'WLSG', 1, 0, len(segments), index_offset, 0)
+
+# Compute CRCs
+idx_crc_computed = zlib.crc32(bytes(index_bytes)) & 0xFFFFFFFF
+data_region = bytes(header) + bytes(seg_bytes)
+data_crc_computed = zlib.crc32(data_region) & 0xFFFFFFFF
+
+trailer = struct.pack('<II', idx_crc_computed, data_crc_computed)
+
+rebuilt = bytes(header) + bytes(seg_bytes) + bytes(index_bytes) + trailer
+
+print(f"  Rebuilt length: {len(rebuilt)}")
+print(f"  Original length: {len(open('assets/sample.wlsg','rb').read())}")
+print(f"  Match: {rebuilt == open('assets/sample.wlsg','rb').read()}")
+
+if rebuilt != open('assets/sample.wlsg','rb').read():
+    orig = open('assets/sample.wlsg','rb').read()
+    for i in range(min(len(rebuilt), len(orig))):
+        if rebuilt[i] != orig[i]:
+            print(f"  First diff at byte {i}: rebuilt=0x{rebuilt[i]:02x}, orig=0x{orig[i]:02x}")
+            break
