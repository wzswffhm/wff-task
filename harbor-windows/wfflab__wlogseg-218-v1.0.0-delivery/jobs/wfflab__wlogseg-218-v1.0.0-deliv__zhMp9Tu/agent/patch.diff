--- /dev/null
+++ b/_tmp_crc_test.py
@@ -0,0 +1,39 @@
+import zlib
+
+# Test crc32_update behavior
+data = b"Hello World"
+
+# Standard one-shot
+one_shot = zlib.crc32(data) & 0xFFFFFFFF
+print(f"One-shot CRC32: 0x{one_shot:08x}")
+
+# Incremental with crc32_update semantics
+# zlib.crc32(data, value) continues from value
+# But what's the correct initial value?
+
+# If we start with 0:
+v = zlib.crc32(b"Hello ", 0) & 0xFFFFFFFF
+v = zlib.crc32(b"World", v) & 0xFFFFFFFF
+print(f"Incremental (init=0): 0x{v:08x}")
+
+# The issue is that zlib.crc32 applies internal transformations
+# For incremental use, we should pass the raw return value (not masked)
+v = zlib.crc32(b"Hello ")
+v = zlib.crc32(b"World", v)
+print(f"Incremental (raw chain): 0x{v & 0xFFFFFFFF:08x}")
+
+# So crc32_update should probably just chain raw values
+# and only mask at the end
+
+# Let's verify our compute_crc matches expected values
+header_empty = bytes.fromhex('574c5347010000001000000000000000')
+expected = 0x2a9fad2c
+computed = zlib.crc32(header_empty) & 0xFFFFFFFF
+print(f"\nEmpty header CRC: expected=0x{expected:08x}, computed=0x{computed:08x}, match={expected==computed}")
+
+# Now test incremental on the same data
+v = 0
+for i in range(0, len(header_empty), 4):
+    chunk = header_empty[i:i+4]
+    v = zlib.crc32(chunk, v)
+print(f"Incremental empty header: 0x{v & 0xFFFFFFFF:08x}")
