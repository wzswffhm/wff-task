+import struct
+
+data = open('assets/sample.wlsg','rb').read()
+
+# Segment 2 at offset 40, index says length=24, so it should span [40, 64)
+print("Bytes at offset 40..64:")
+for i in range(40, 64):
+    print(f"  {i}: 0x{data[i]:02x} ({data[i]})")
+
+# Segment header at 40: 2c 01 00 00 0a 00 00 00
+# seg_id = 0x012c = 300
+# flags = 0, reserved = 0  
+# body_len = 10
+# payload at 48..58: 78 78 78 78 78 78 78 78 78 78 = "xxxxxxxxxx"
+# Then 58..64: 00 00 00 00 00 00 = 6 bytes of zeros
+
+# So the segment occupies 40..64 = 24 bytes
+# Header(8) + body(10) + padding(6) = 24
+# But padding to 4-byte alignment would be (-18)%4 = 2, not 6!
+
+# Unless alignment is to 8 bytes? (-18)%8 = 6. Yes!
+print("\nAlignment check:")
+print(f"  (8+10) % 4 = {(8+10) % 4}, pad4 = {(-(8+10)) % 4}")
+print(f"  (8+10) % 8 = {(8+10) % 8}, pad8 = {(-(8+10)) % 8}")
+
+# Let's verify all segments with 8-byte alignment
+print("\n=== Verify all segments with 8-byte alignment ===")
+entries = []
+idx_bytes = data[344:384]
+for i in range(5):
+    off = struct.unpack_from('<I', idx_bytes, i*8)[0]
+    ln = struct.unpack_from('<I', idx_bytes, i*8 + 4)[0]
+    entries.append((off, ln))
+
+for i, (off, ln) in enumerate(entries):
+    seg_id = struct.unpack_from('<H', data, off)[0]
+    body_len = struct.unpack_from('<I', data, off+4)[0]
+    raw_total = 8 + body_len
+    pad8 = (-raw_total) % 8
+    aligned_total = raw_total + pad8
+    
+    print(f"Seg {i} @ {off}: id={seg_id}, body_len={body_len}, raw={raw_total}, pad8={pad8}, aligned={aligned_total}, index_len={ln}, match={aligned_total == ln}")
+
+# Check segment 3 at offset 64
+print("\nSegment 3 details:")
+off = 64
+print(f"Header bytes: {data[off:off+8].hex()}")
+seg_id = struct.unpack_from('<H', data, off)[0]
+flags = data[off+2]
+res = data[off+3]
+body_len = struct.unpack_from('<I', data, off+4)[0]
+print(f"seg_id={seg_id}, flags={flags}, res={res}, body_len={body_len}")
+print(f"First 20 payload bytes: {data[off+8:off+8+20].hex()}")
+print(f"Last 10 bytes of segment (before next): {data[off+body_len+8-10:off+body_len+8].hex()}")
+
+# Segment 4 at offset 328
+print("\nSegment 4 details:")
+off = 328
+print(f"Header bytes: {data[off:off+8].hex()}")
+seg_id = struct.unpack_from('<H', data, off)[0]
+flags = data[off+2]
+res = data[off+3]
+body_len = struct.unpack_from('<I', data, off+4)[0]
+print(f"seg_id={seg_id}, flags={flags}, res={res}, body_len={body_len}")
+print(f"Payload: {data[off+8:off+8+body_len]}")
+print(f"After payload: {data[off+8+body_len:off+16].hex()}")
