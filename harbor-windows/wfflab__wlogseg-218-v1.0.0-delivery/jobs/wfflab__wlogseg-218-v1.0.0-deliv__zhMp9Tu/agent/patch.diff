+++ b/_tmp_analyze4.py
@@ -0,0 +1,67 @@
+import struct
+
+data = open('assets/sample.wlsg','rb').read()
+
+# What if the segment header is <HHI (seg_id:u16, flags:u16, body_len:u32)?
+# Or <HIH? Or something else entirely?
+
+# Let me try to figure out by working backwards from known index offsets.
+# Index says: [16, 16, 32, 8, 40]
+# These should be the file offsets of each segment.
+# But 16 appears twice, and 8 < 16, so these can't all be absolute offsets.
+
+# What if the index stores (offset, length) pairs? That would be 8 bytes per entry.
+# 5 entries * 8 = 40 bytes. Index region [344, 384). Trailer at [384, 392).
+print("=== Trying 8-byte index entries (offset, length) ===")
+for i in range(5):
+    off = struct.unpack_from('<I', data, 344 + i*8)[0]
+    ln = struct.unpack_from('<I', data, 344 + i*8 + 4)[0]
+    print(f"  [{i}] offset={off}, length={ln}")
+
+# Results were:
+# [0] offset=16, length=16
+# [1] offset=32, length=8
+# [2] offset=40, length=24  (wait, was it 8 or 24?)
+# Let me recheck
+
+print("\n=== Raw index bytes ===")
+idx_bytes = data[344:384]
+print(f"Index region (40 bytes): {idx_bytes.hex()}")
+# 10000000 10000000 20000000 08000000 28000000 18000000 40000000 00010000 48010000 10000000
+
+for i in range(5):
+    off = struct.unpack_from('<I', idx_bytes, i*8)[0]
+    ln = struct.unpack_from('<I', idx_bytes, i*8 + 4)[0]
+    print(f"  [{i}] offset={off}, length={ln}")
+    
+    # Try to read segment at that offset
+    if off + 8 <= len(data):
+        seg_id = struct.unpack_from('<H', data, off)[0]
+        flags = data[off+2]
+        res = data[off+3]
+        body_len = struct.unpack_from('<I', data, off+4)[0]
+        print(f"       -> seg_id={seg_id}, flags={flags}, res={res}, body_len={body_len}")
+        actual_payload = data[off+8:off+8+min(body_len, 20)]
+        print(f"       -> payload preview: {actual_payload}")
+
+# Hmm, let me also check: what if INDEX_ENTRY_SIZE is 8 and stores (offset, size)?
+# And the "size" includes header + body + padding?
+
+print("\n=== Check if offset+length matches next offset ===")
+entries = []
+for i in range(5):
+    off = struct.unpack_from('<I', idx_bytes, i*8)[0]
+    ln = struct.unpack_from('<I', idx_bytes, i*8 + 4)[0]
+    entries.append((off, ln))
+    
+for i, (off, ln) in enumerate(entries):
+    end = off + ln
+    print(f"  [{i}] {off}..{end}", end="")
+    if i + 1 < len(entries):
+        next_off = entries[i+1][0]
+        if end == next_off:
+            print(f" -> matches next offset {next_off} ✓")
+        else:
+            print(f" -> DOESN'T match next offset {next_off} (diff={next_off-end})")
+    else:
+        print(f" -> last entry, index_offset=344, diff={344-end}")
