+++ b/_tmp_analyze7.py
@@ -0,0 +1,59 @@
+import struct
+import zlib
+
+data = open('assets/sample.wlsg','rb').read()
+
+# Header
+seg_count = struct.unpack_from('<H', data, 6)[0]
+index_offset = struct.unpack_from('<I', data, 8)[0]
+
+# Index region: [344, 344 + 5*8 = 384)
+idx_start = index_offset
+idx_entry_size = 8  # 8 bytes per entry (offset + length)
+idx_end = idx_start + seg_count * idx_entry_size
+print(f"Index region: [{idx_start}, {idx_end})")
+
+idx_region = data[idx_start:idx_end]
+idx_crc_expected = struct.unpack_from('<I', data, len(data)-8)[0]
+data_crc_expected = struct.unpack_from('<I', data, len(data)-4)[0]
+
+print(f"Expected idx_crc  = 0x{idx_crc_expected:08x}")
+print(f"Expected data_crc = 0x{data_crc_expected:08x}")
+
+# Compute CRC of index region
+idx_crc_computed = zlib.crc32(idx_region) & 0xFFFFFFFF
+print(f"Computed idx_crc (index region) = 0x{idx_crc_computed:08x}, match={idx_crc_computed == idx_crc_expected}")
+
+# Now figure out what data_crc covers
+# Option 1: header + all segment data (without padding?)
+# Option 2: header + all segment data (with padding)
+# Option 3: just segments
+# Option 4: header only
+
+header = data[:16]
+
+# Segment data from index
+seg_data_with_pad = bytearray()
+seg_data_no_pad = bytearray()
+for i in range(seg_count):
+    off = struct.unpack_from('<I', idx_region, i*8)[0]
+    ln = struct.unpack_from('<I', idx_region, i*8+4)[0]
+    body_len = struct.unpack_from('<I', data, off+4)[0]
+    seg_data_with_pad += data[off:off+ln]
+    seg_data_no_pad += data[off:off+8+body_len]
+
+# Try different combinations
+tests = [
+    ("header only", header),
+    ("segments with pad", bytes(seg_data_with_pad)),
+    ("segments no pad", bytes(seg_data_no_pad)),
+    ("header + segments with pad", bytes(header) + bytes(seg_data_with_pad)),
+    ("header + segments no pad", bytes(header) + bytes(seg_data_no_pad)),
+    ("header + index", bytes(header) + bytes(idx_region)),
+    ("everything except trailer", data[:len(data)-8]),
+]
+
+for name, buf in tests:
+    crc = zlib.crc32(buf) & 0xFFFFFFFF
+    match = "MATCH" if crc == data_crc_expected else ""
+    print(f"  CRC({name}) = 0x{crc:08x} {match}")
