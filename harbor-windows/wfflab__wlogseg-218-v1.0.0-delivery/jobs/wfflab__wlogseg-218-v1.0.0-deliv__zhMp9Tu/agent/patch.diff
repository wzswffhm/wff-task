+import struct
+
+data = open('assets/sample_empty.wlsg','rb').read()
+print(f"Empty sample length: {len(data)}")
+print(f"Hex: {data.hex()}")
+
+# Header
+magic = data[0:4]
+version = data[4]
+flags = data[5]
+seg_count = struct.unpack_from('<H', data, 6)[0]
+index_offset = struct.unpack_from('<I', data, 8)[0]
+reserved = struct.unpack_from('<I', data, 12)[0]
+print(f"magic={magic}, ver={version}, flags={flags}, count={seg_count}, idx_off={index_offset}, res={reserved}")
+
+# With seg_count=0, index region is empty (0 bytes)
+# Trailer should be at [16, 24)
+if len(data) >= 24:
+    trailer = data[16:24]
+    idx_crc = struct.unpack_from('<I', trailer, 0)[0]
+    data_crc = struct.unpack_from('<I', trailer, 4)[0]
+    print(f"Trailer: idx_crc=0x{idx_crc:08x}, data_crc=0x{data_crc:08x}")
+
+# Now let's figure out the CRC algorithm
+# For the empty sample:
+# - index region is empty (0 bytes)
+# - data region is just the header (16 bytes)
+
+import zlib
+
+header = data[:16]
+print(f"\nHeader bytes: {header.hex()}")
+
+# Try various CRC32 variants
+print("\nCRC variants for header:")
+print(f"  zlib.crc32(header) = 0x{zlib.crc32(header) & 0xFFFFFFFF:08x}")
+print(f"  zlib.crc32(header) ^ 0xFFFFFFFF = 0x{(zlib.crc32(header) ^ 0xFFFFFFFF) & 0xFFFFFFFF:08x}")
+print(f"  zlib.crc32(header, 0) = 0x{zlib.crc32(header, 0) & 0xFFFFFFFF:08x}")
+
+# Current code does: crc32_update(data, 0) = (zlib.crc32(data, 0) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+current = (zlib.crc32(header, 0) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+print(f"  current compute_crc(header) = 0x{current:08x}")
+
+# Standard CRC32 (as used in PNG, Ethernet, etc.) typically uses init=0xFFFFFFFF and final XOR=0xFFFFFFFF
+# zlib.crc32 already does this internally when called with default args
+std = zlib.crc32(header) & 0xFFFFFFFF
+print(f"  standard zlib.crc32(header) = 0x{std:08x}")
+
+# What about CRC32 with no final XOR?
+no_final_xor = zlib.crc32(header, 0) & 0xFFFFFFFF  
+print(f"  zlib.crc32(header, 0) [no init XOR] = 0x{no_final_xor:08x}")
+
+# The expected data_crc from empty sample is 0x2a9fad2c
+print(f"\nExpected data_crc = 0x{struct.unpack_from('<I', data, 20)[0]:08x}")
+print(f"Expected idx_crc  = 0x{struct.unpack_from('<I', data, 16)[0]:08x}")
+
+# For empty index, what CRC gives 0x2a9fad2c?
+empty = b''
+print(f"\nCRC of empty bytes:")
+print(f"  zlib.crc32(b'') = 0x{zlib.crc32(b'') & 0xFFFFFFFF:08x}")
+print(f"  zlib.crc32(b'', 0) = 0x{zlib.crc32(b'', 0) & 0xFFFFFFFF:08x}")
+
+# Hmm, for empty sample the idx_crc covers empty index region
+# and data_crc covers... what exactly?
+
+# Let me check: maybe data_crc covers header only (since there are no segments)
+# Expected: 0x2a9fad2c
+# zlib.crc32(header) = ?
+print(f"\nzlib.crc32(header) & 0xFFFFFFFF = 0x{zlib.crc32(header) & 0xFFFFFFFF:08x}")
+
+# Maybe it's CRC32C (Castagnoli)?
+try:
+    import crcmod
+except ImportError:
+    pass
+
+# Let's try computing CRC32 with different initial values
+for init in [0, 0xFFFFFFFF]:
+    val = zlib.crc32(header, init) & 0xFFFFFFFF
+    print(f"  zlib.crc32(header, 0x{init:08x}) = 0x{val:08x}")
