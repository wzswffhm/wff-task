@@ -0,0 +1,70 @@
+import struct
+
+data = open('assets/sample.wlsg','rb').read()
+
+# Header says seg_count=5, index_offset=344
+# Let's manually walk segments from offset 16
+
+pos = 16
+seg_idx = 0
+while pos < 344:
+    if pos + 8 > 344:
+        print(f"  Incomplete header at {pos}")
+        break
+    seg_id = struct.unpack_from('<H', data, pos)[0]
+    flags = data[pos+2]
+    reserved = data[pos+3]
+    body_len = struct.unpack_from('<I', data, pos+4)[0]
+    
+    total = 8 + body_len
+    pad = (-total) % 4
+    aligned = total + pad
+    
+    payload_preview = data[pos+8:pos+8+min(body_len, 20)]
+    
+    print(f"Seg {seg_idx} @ {pos}: id={seg_id}, fl={flags}, res={reserved}, len={body_len}, aligned={aligned}")
+    if body_len <= 20:
+        print(f"  payload={data[pos+8:pos+8+body_len]}")
+    else:
+        print(f"  payload(first 20)={payload_preview}...")
+    
+    pos += aligned
+    seg_idx += 1
+
+print(f"\nWalked {seg_idx} segments, final pos={pos}, index_offset=344")
+print(f"Match: {pos == 344}")
+
+# Now check: what does the index actually contain?
+print("\n=== Index entries ===")
+for i in range(5):
+    val = struct.unpack_from('<I', data, 344 + i*4)[0]
+    print(f"  [{i}] = {val}")
+
+# The index values are [16, 16, 32, 8, 40]
+# These don't match our computed offsets [16, 32, 40, 60, 324]
+# So either the index format is different, or our segment parsing is wrong.
+
+# What if segments DON'T have padding? Let's try without padding.
+print("\n=== Without padding ===")
+pos = 16
+seg_idx = 0
+offsets_no_pad = []
+while pos < 344:
+    if pos + 8 > 344:
+        break
+    seg_id = struct.unpack_from('<H', data, pos)[0]
+    flags = data[pos+2]
+    reserved = data[pos+3]
+    body_len = struct.unpack_from('<I', data, pos+4)[0]
+    
+    offsets_no_pad.append(pos)
+    total = 8 + body_len
+    
+    print(f"Seg {seg_idx} @ {pos}: id={seg_id}, len={body_len}")
+    
+    pos += total
+    seg_idx += 1
+
+print(f"Walked {seg_idx} segments, final pos={pos}")
+print(f"Offsets: {offsets_no_pad}")
+print(f"Index:   {[struct.unpack_from('<I', data, 344+i*4)[0] for i in range(5)]}")
