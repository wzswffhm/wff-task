@@ -0,0 +1,86 @@
+import struct
+
+data = open('assets/sample.wlsg','rb').read()
+print(f'Total length: {len(data)}')
+print()
+
+# Let's look at the raw bytes from offset 16 onwards more carefully
+# Header says seg_count=5, index_offset=344
+# So segments are in [16, 344)
+# That's 344-16 = 328 bytes for 5 segments
+
+seg_region = data[16:344]
+print(f'Segment region length: {len(seg_region)}')
+print(f'Segment region hex:')
+for i in range(0, len(seg_region), 16):
+    chunk = seg_region[i:i+16]
+    hexstr = ' '.join(f'{b:02x}' for b in chunk)
+    print(f'  {16+i:4d}: {hexstr}')
+print()
+
+# Index region [344, 344+5*4=364)
+idx_region = data[344:364]
+print(f'Index region hex: {idx_region.hex()}')
+offsets = []
+for i in range(5):
+    off = struct.unpack_from('<I', idx_region, i*4)[0]
+    offsets.append(off)
+    print(f'  index[{i}] = {off}')
+print()
+
+# Trailer [384, 392)
+trailer = data[384:392]
+print(f'Trailer hex: {trailer.hex()}')
+idx_crc = struct.unpack_from('<I', trailer, 0)[0]
+data_crc = struct.unpack_from('<I', trailer, 4)[0]
+print(f'  index_crc=0x{idx_crc:08x}')
+print(f'  data_crc=0x{data_crc:08x}')
+
+# Now let's try to figure out actual segment boundaries using the index
+# The index says: [16, 16, 32, 8, 40]
+# Wait, that can't be right - offsets should be monotonically increasing...
+# Unless the index format is different!
+
+# Let me re-examine. Maybe index entries are not just offsets.
+# Or maybe I'm reading the header wrong.
+
+print()
+print("=== Re-examining header ===")
+print(f'Header hex: {data[:16].hex()}')
+# 574c5347 01 00 0500 58010000 00000000
+# WLSG     v=1 fl=0 cnt=5 idx_off=0x158=344 res=0
+
+# Hmm, wait. Let me re-read with different struct interpretation
+# What if seg_count is not at offset 6?
+# Let's try: magic(4) + version(1) + flags(1) + seg_count(2) + index_offset(4) + reserved(4) = 16
+# That matches _HEADER = struct.Struct("<4sBBHII")
+
+# But what about the possibility that the header layout is different?
+# Let me check: 574c5347 01 00 0500 58010000 00000000
+# If we read it as: magic=WLSG, ver=1, flags=0, count=5, idx_off=344, reserved=0
+# That seems right.
+
+# Now the index: 10000000 10000000 20000000 00000000 80000000 28000000 18000000 40000000 00801000 04801000 10000000
+# Wait that's too many bytes. Let me recount.
+# Index is at [344, 364), which is 20 bytes = 5 entries of 4 bytes each
+print()
+print(f"Index bytes at 344-364:")
+for i in range(5):
+    val = struct.unpack_from('<I', data, 344 + i*4)[0]
+    print(f"  [{i}] offset={344+i*4}: 0x{val:08x} = {val}")
+
+# OK so index = [16, 16, 32, 8, 40]
+# These are NOT monotonically increasing, so they can't all be file offsets.
+# Unless... the index stores something else? Like segment sizes? Or relative offsets?
+
+# Actually wait - let me look at this differently. 
+# What if the index entry size is not 4 bytes but 8 bytes?
+# Then we'd have 5 * 8 = 40 bytes for the index, ending at 344+40=384
+# And trailer would be at [384, 392) which is 8 bytes. That fits!
+
+print()
+print("=== Trying 8-byte index entries ===")
+for i in range(5):
+    lo = struct.unpack_from('<I', data, 344 + i*8)[0]
+    hi = struct.unpack_from('<I', data, 344 + i*8 + 4)[0]
+    print(f"  [{i}] lo=0x{lo:08x}={lo}, hi=0x{hi:08x}={hi}")
