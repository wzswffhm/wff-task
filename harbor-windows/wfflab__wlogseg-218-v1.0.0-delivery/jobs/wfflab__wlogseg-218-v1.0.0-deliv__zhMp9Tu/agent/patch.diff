@@ -0,0 +1,69 @@
+import struct
+
+data = open('assets/sample.wlsg','rb').read()
+print(f'Total length: {len(data)}')
+print()
+
+# Header (16 bytes)
+magic = data[0:4]
+version = data[4]
+flags = data[5]
+seg_count = struct.unpack_from('<H', data, 6)[0]
+index_offset = struct.unpack_from('<I', data, 8)[0]
+reserved = struct.unpack_from('<I', data, 12)[0]
+print(f'Header:')
+print(f'  magic={magic}')
+print(f'  version={version}')
+print(f'  flags={flags}')
+print(f'  seg_count={seg_count}')
+print(f'  index_offset={index_offset}')
+print(f'  reserved={reserved}')
+print()
+
+# Parse segments starting at offset 16
+pos = 16
+for i in range(seg_count):
+    if pos + 8 > len(data):
+        print(f'Segment {i}: truncated')
+        break
+    seg_id = struct.unpack_from('<H', data, pos)[0]
+    seg_flags = data[pos+2]
+    seg_reserved = data[pos+3]
+    body_len = struct.unpack_from('<I', data, pos+4)[0]
+    print(f'Segment {i} at offset {pos}:')
+    print(f'  seg_id={seg_id}, flags={seg_flags}, reserved={seg_reserved}, body_len={body_len}')
+    
+    # Check alignment padding
+    total = 8 + body_len
+    pad = (-total) % 4
+    print(f'  total_with_header={total}, padding={pad}, aligned_total={total+pad}')
+    
+    payload = data[pos+8:pos+8+body_len]
+    if len(payload) > 50:
+        print(f'  payload={payload[:50]}...')
+    else:
+        print(f'  payload={payload}')
+    
+    pos += total + pad
+    print()
+
+print(f'After all segments, pos={pos}')
+print(f'index_offset from header={index_offset}')
+print()
+
+# Index region
+idx_start = index_offset
+idx_end = idx_start + 4 * seg_count
+print(f'Index region: [{idx_start}, {idx_end})')
+for i in range(seg_count):
+    off = struct.unpack_from('<I', data, idx_start + i*4)[0]
+    print(f'  index[{i}] = {off}')
+print()
+
+# Trailer (last 8 bytes)
+trailer_start = len(data) - 8
+idx_crc = struct.unpack_from('<I', data, trailer_start)[0]
+data_crc = struct.unpack_from('<I', data, trailer_start+4)[0]
+print(f'Trailer at {trailer_start}:')
+print(f'  index_crc=0x{idx_crc:08x}')
+print(f'  data_crc=0x{data_crc:08x}')
diff --git a/_tmp_analyze2.py b/_tmp_analyze2.py
