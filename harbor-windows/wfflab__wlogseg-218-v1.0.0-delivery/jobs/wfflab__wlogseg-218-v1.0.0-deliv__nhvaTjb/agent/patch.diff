diff --git a/tmp/analyze.py b/tmp/analyze.py
new file mode 100644
index 0000000..b7c6beb
--- /dev/null
+++ b/tmp/analyze.py
@@ -0,0 +1,60 @@
+import struct
+
+data = open('assets/sample.wlsg', 'rb').read()
+print(f"Total length: {len(data)}")
+
+# Header
+magic = data[0:4]
+ver = data[4]
+flags = data[5]
+seg_count = struct.unpack_from('<H', data, 6)[0]
+index_offset = struct.unpack_from('<I', data, 8)[0]
+reserved = struct.unpack_from('<I', data, 12)[0]
+print(f"Header: magic={magic} ver={ver} flags={flags} seg_count={seg_count} index_offset={index_offset} reserved={reserved}")
+
+# Try parsing segments with current format <HBBI (8 bytes)
+seg_fmt = struct.Struct('<HBBI')
+pos = 16
+for i in range(seg_count):
+    if pos + 8 > len(data):
+        print(f"  Seg {i}: TRUNCATED at pos={pos}")
+        break
+    sid, fl, res, blen = seg_fmt.unpack_from(data, pos)
+    body = data[pos+8:pos+8+blen]
+    total = 8 + blen
+    pad = (-total) % 4
+    next_pos = pos + total + pad
+    print(f"Seg {i}: pos={pos} id={sid} flags={fl} res={res} body_len={blen} next_pos={next_pos}")
+    if len(body) <= 30:
+        print(f"  body={body!r}")
+    else:
+        print(f"  body={body[:20]!r}... ({len(body)} bytes)")
+    pos = next_pos
+
+print(f"\nAfter all segments, pos={pos}, index_offset={index_offset}")
+
+# Index region
+idx_data = data[index_offset:index_offset + seg_count * 4]
+print(f"\nIndex region as 4-byte entries ({len(idx_data)} bytes): {idx_data.hex()}")
+if seg_count > 0:
+    offsets = [struct.unpack_from('<I', idx_data, i*4)[0] for i in range(seg_count)]
+    print(f"Offsets (4-byte): {offsets}")
+
+# What if index entries are 8 bytes?
+idx_data8 = data[index_offset:index_offset + seg_count * 8]
+print(f"\nIndex region as 8-byte entries ({len(idx_data8)} bytes): {idx_data8.hex()}")
+if seg_count > 0:
+    offsets8 = [struct.unpack_from('<Q', idx_data8, i*8)[0] for i in range(seg_count)]
+    print(f"Offsets (8-byte): {offsets8}")
+
+# Trailer
+trailer_pos = len(data) - 8
+icrc = struct.unpack_from('<I', data, trailer_pos)[0]
+dcrc = struct.unpack_from('<I', data, trailer_pos + 4)[0]
+print(f"\nTrailer at {trailer_pos}: icrc=0x{icrc:08x} dcrc=0x{dcrc:08x}")
+
+# Also check: what's between end of segments and index_offset?
+print(f"\nGap between segments end ({pos}) and index_offset ({index_offset}): {index_offset - pos} bytes")
+if pos < index_offset:
+    gap = data[pos:index_offset]
+    print(f"Gap hex: {gap.hex()}")
