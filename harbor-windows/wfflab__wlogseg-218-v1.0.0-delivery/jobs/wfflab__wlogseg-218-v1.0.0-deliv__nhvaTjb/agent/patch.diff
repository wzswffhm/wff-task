+from wlogseg import verify, unpack, pack, WSegError, iter_segments, read_all, compute_crc, crc32_update
+import io
+
+# Test tampered content
+data = open('assets/sample.wlsg', 'rb').read()
+bad = bytearray(data)
+bad[20] = 0xFF
+print("tampered verify:", verify(bytes(bad)))
+try:
+    unpack(bytes(bad))
+except WSegError as e:
+    print("tampered error kind:", e.kind)
+
+# Test truncated
+trunc = data[:50]
+print("\ntruncated verify:", verify(trunc))
+try:
+    unpack(trunc)
+except WSegError as e:
+    print("truncated error kind:", e.kind)
+
+# Test bad magic
+bad_magic = bytearray(data)
+bad_magic[0:4] = b"XXXX"
+print("\nbad magic verify:", verify(bytes(bad_magic)))
+try:
+    unpack(bytes(bad_magic))
+except WSegError as e:
+    print("bad magic error kind:", e.kind)
+
+# Test bad version
+bad_ver = bytearray(data)
+bad_ver[4] = 99
+print("\nbad version verify:", verify(bytes(bad_ver)))
+try:
+    unpack(bytes(bad_ver))
+except WSegError as e:
+    print("bad version error kind:", e.kind)
+
+# Test invalid seg_id in pack
+try:
+    pack([(70000, b"x")])
+except WSegError as e:
+    print("\ninvalid seg_id error kind:", e.kind)
+
+# Test non-bytes payload in pack
+try:
+    pack([(1, "string")])
+except WSegError as e:
+    print("non-bytes payload error kind:", e.kind)
+
+# Test compute_crc against known values
+import zlib
+test_data = b"123456789"
+expected = zlib.crc32(test_data) & 0xFFFFFFFF
+got = compute_crc(test_data)
+print(f"\nCRC test: expected=0x{expected:08x} got=0x{got:08x} match={expected==got}")
+
+# Test empty container roundtrip
+empty_data = open('assets/sample_empty.wlsg', 'rb').read()
+segs = unpack(empty_data)
+repacked = pack(segs)
+print(f"\nEmpty roundtrip: {repacked == empty_data}")
+
+# Test iter_segments on empty
+empty_segs = list(iter_segments(io.BytesIO(empty_data)))
+print(f"Empty iter_segments: {empty_segs}")
+
+# Test read_all
+all_segs = read_all(io.BytesIO(data))
+print(f"\nread_all matches unpack: {all_segs == unpack(data)}")
