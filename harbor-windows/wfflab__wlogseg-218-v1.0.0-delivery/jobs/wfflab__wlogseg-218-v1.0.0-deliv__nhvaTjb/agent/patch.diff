+import struct
+import zlib
+
+data = open('assets/sample.wlsg', 'rb').read()
+
+# Header
+HEADER_SIZE = 16
+magic = data[0:4]
+ver = data[4]
+flags = data[5]
+seg_count = struct.unpack_from('<H', data, 6)[0]
+index_offset = struct.unpack_from('<I', data, 8)[0]
+reserved = struct.unpack_from('<I', data, 12)[0]
+print(f"Header: magic={magic} ver={ver} flags={flags} seg_count={seg_count} index_offset={index_offset}")
+
+# Index region: 5 entries starting at offset 344
+# We know index region is 40 bytes (344 to 384)
+# 40 / 5 = 8 bytes per entry
+idx_data = data[344:384]
+print(f"\nIndex region ({len(idx_data)} bytes): {idx_data.hex()}")
+
+# Try as pairs of (offset, length) each 4 bytes = 8 bytes per entry
+print("\n=== Index as (offset:4, length:4) pairs ===")
+for i in range(5):
+    off = struct.unpack_from('<I', idx_data, i*8)[0]
+    ln = struct.unpack_from('<I', idx_data, i*8+4)[0]
+    print(f"  Entry {i}: offset={off} length={ln}")
+
+# Verify these offsets match our segment positions
+# Seg positions: 16, 16+16=32? No... let me recalculate
+# With <II header and align=8:
+# Seg 0: pos=16, total=8+5=13, pad=(-13)%8=3, npos=16+16=32? No wait
+# 8+5=13, (-13)%8 = 3, so npos = 16+13+3 = 32. But we got npos=16 earlier!
+# Wait no, in the seg_area analysis pos was relative to seg_area start.
+# In absolute file coords: seg0 at 16, seg1 at 16+16=32, etc.
+
+# Actually from the analysis: seg positions relative to seg_area were 0,16,24,48,312
+# Absolute: 16, 32, 40, 64, 328
+
+print("\n=== Expected segment absolute positions ===")
+seg_positions = [16, 32, 40, 64, 328]
+seg_lengths = [16, 8, 24, 264, 16]  # npos differences
+for i in range(5):
+    print(f"  Seg {i}: abs_pos={seg_positions[i]}")
+
+# Check if index entries match
+print("\n=== Compare index entries with expected positions ===")
+for i in range(5):
+    off = struct.unpack_from('<I', idx_data, i*8)[0]
+    ln = struct.unpack_from('<I', idx_data, i*8+4)[0]
+    expected_pos = seg_positions[i]
+    print(f"  Entry {i}: offset={off} (expected {expected_pos}), length={ln}")
+
+# Now check CRC
+# Trailer
+trailer_pos = len(data) - 8
+icrc = struct.unpack_from('<I', data, trailer_pos)[0]
+dcrc = struct.unpack_from('<I', data, trailer_pos + 4)[0]
+print(f"\nTrailer: icrc=0x{icrc:08x} dcrc=0x{dcrc:08x}")
+
+# Standard CRC32 of index region
+std_crc_idx = zlib.crc32(idx_data) & 0xFFFFFFFF
+print(f"Standard CRC32 of index region: 0x{std_crc_idx:08x}")
+
+# Current code's CRC (xor with 0xFFFFFFFF)
+def current_crc(d):
+    return (zlib.crc32(bytes(d), 0) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+
+cur_crc_idx = current_crc(idx_data)
+print(f"Current code CRC of index region: 0x{cur_crc_idx:08x}")
+
+# Try CRC32 with initial value 0 (no final xor)
+crc_idx_0 = zlib.crc32(idx_data, 0) & 0xFFFFFFFF
+print(f"CRC32(init=0) of index region: 0x{crc_idx_0:08x}")
+
+# What about just zlib.crc32 default?
+crc_idx_default = zlib.crc32(idx_data) & 0xFFFFFFFF
+print(f"CRC32(default) of index region: 0x{crc_idx_default:08x}")
+
+# Check data CRC coverage
+# "文件头与整个段区"
+header_and_segs = data[:344]  # header (16) + segments (328)
+std_crc_data = zlib.crc32(header_and_segs) & 0xFFFFFFFF
+print(f"\nStandard CRC32 of header+segs: 0x{std_crc_data:08x}")
+cur_crc_data = current_crc(header_and_segs)
+print(f"Current code CRC of header+segs: 0x{cur_crc_data:08x}")
+
+# Maybe CRC covers just segments?
+just_segs = data[16:344]
+std_crc_segs = zlib.crc32(just_segs) & 0xFFFFFFFF
+print(f"Standard CRC32 of just segments: 0x{std_crc_segs:08x}")
+
+# Maybe CRC covers header only?
+just_header = data[:16]
+std_crc_hdr = zlib.crc32(just_header) & 0xFFFFFFFF
+print(f"Standard CRC32 of just header: 0x{std_crc_hdr:08x}")
+
+# Check empty sample too
+edata = open('assets/sample_empty.wlsg', 'rb').read()
+e_icrc = struct.unpack_from('<I', edata, 16)[0]
+e_dcrc = struct.unpack_from('<I', edata, 20)[0]
+print(f"\nEmpty sample: icrc=0x{e_icrc:08x} dcrc=0x{e_dcrc:08x}")
+e_header = edata[:16]
+e_std_crc = zlib.crc32(e_header) & 0xFFFFFFFF
+print(f"Standard CRC32 of empty header: 0x{e_std_crc:08x}")
+e_cur_crc = current_crc(e_header)
+print(f"Current code CRC of empty header: 0x{e_cur_crc:08x}")
