+import struct
+data=open("assets/sample.wlsg","rb").read()
+
+# Hypothesis: index entries are 8 bytes: (offset: u32, segment_total_size: u32)
+# entry[0]: offset=16, size=16 -> seg0 occupies [16, 32)
+# entry[1]: offset=32, size=8  -> seg1 occupies [32, 40)
+# entry[2]: offset=40, size=24 -> seg2 occupies [40, 64)  <-- NOT 20!
+# entry[3]: offset=64, size=264-> seg3 occupies [64, 328)
+# entry[4]: offset=328, size=16-> seg4 occupies [328, 344)
+
+# This means seg2 has total size 24, not 20.
+# seg2 at 40: header(8) + body_len(?) + padding
+# If total=24, then body_len+padding = 16
+# With <HBBI: data[40:48] = 2c 01 00 00 0a 00 00 00
+# seg_id=300, flags=0, res=0, body_len=10
+# body=10, pad=(-18)%4=2, total=20. But index says 24!
+
+# UNLESS the segment format has MORE than 8 bytes of header
+# What if segment header is 12 bytes? seg_id(2), flags(1), reserved(1), body_len(4), extra(4)?
+print("=== Try 12-byte segment header ===")
+pos=16
+for i in range(5):
+    if pos+12 > 344: break
+    seg_id,flags,res,body_len,extra = struct.unpack_from("<HBBI I", data, pos)
+    print(f"  pos={pos}: id={seg_id} flags={flags} res={res} body_len={body_len} extra={extra}")
+    total=12+body_len; pad=(-total)%4
+    print(f"    total={total} pad={pad} next={pos+total+pad}")
+    if body_len > 1000: break
+    pos+=total+pad
+
+# Or maybe the alignment is different - align to 8 instead of 4?
+print("\n=== Align to 8 ===")
+pos=16
+for i in range(5):
+    if pos+8 > 344: break
+    seg_id,flags,res,body_len = struct.unpack_from("<HBBI", data, pos)
+    print(f"  pos={pos}: id={seg_id} body_len={body_len}")
+    total=8+body_len; pad=(-total)%8
+    seg_size = total+pad
+    print(f"    total={total} pad={pad} seg_size={seg_size}")
+    if body_len > 1000: break
+    pos+=seg_size
