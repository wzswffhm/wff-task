@@ -0,0 +1,321 @@
+import os
+import sys
+import threading
+import time
+import traceback
+import uuid
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from winpipe import PipeClient, PipeServer, PipeBusyError, WPipeError  # noqa: E402
+from winpipe import native, protocol  # noqa: E402
+
+FAILS = []
+
+
+def check(label):
+    def deco(fn):
+        print("RUN   %s" % label.encode("ascii","replace").decode()); sys.stdout.flush()
+        try:
+            fn()
+            print("PASS  %s" % label.encode("ascii", "replace").decode())
+        except Exception:
+            FAILS.append(label)
+            print("FAIL  %s\n%s" % (label, traceback.format_exc()))
+        return fn
+    return deco
+
+
+def nm():
+    return "wv2_%s" % uuid.uuid4().hex[:8]
+
+
+@check("message_mode=True: raw + framed roundtrip")
+def _():
+    n = nm()
+    srv = PipeServer(n, instances=1, buffer_size=4096, message_mode=True)
+    srv.create_instance()
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    cli = PipeClient(n)
+    assert cli.connect() is True
+    t.join(3)
+    cli.send_bytes(b"raw")
+    assert srv.read_raw() == b"raw"
+    cli.send(b"framed")
+    assert srv.read_frame() == b"framed"
+    srv.write_frame(b"back")
+    assert cli.recv() == b"back"
+    big = b"Q" * 20000
+    tt = threading.Thread(target=cli.send, args=(big,), daemon=True)
+    tt.start()
+    assert srv.read_frame() == big
+    tt.join(10)
+    srv.close()
+    cli.close()
+
+
+@check("two server objects / two clients on same name (instances=2)")
+def _():
+    n = nm()
+    s1 = PipeServer(n, instances=2)
+    s2 = PipeServer(n, instances=2)
+    s1.create_instance()
+    s2.create_instance()
+    t1 = threading.Thread(target=s1.accept, daemon=True)
+    t2 = threading.Thread(target=s2.accept, daemon=True)
+    t1.start()
+    t2.start()
+    time.sleep(0.2)
+    c1 = PipeClient(n)
+    c2 = PipeClient(n)
+    assert c1.connect() is True
+    assert c2.connect() is True
+    t1.join(3)
+    t2.join(3)
+    c1.send(b"one")
+    c2.send(b"two")
+    got = sorted([s1.read_frame(), s2.read_frame()])
+    assert got == [b"one", b"two"], got
+    for x in (s1, s2, c1, c2):
+        x.close()
+
+
+@check("client-first accept then bidirectional traffic")
+def _():
+    n = nm()
+    srv = PipeServer(n)
+    srv.create_instance()
+    cli = PipeClient(n)
+    assert cli.connect() is True
+    assert srv.accept() is True
+    for i in range(10):
+        cli.send(b"c%d" % i)
+        assert srv.read_frame() == b"c%d" % i
+        srv.write_frame(b"s%d" % i)
+        assert cli.recv() == b"s%d" % i
+    srv.close()
+    cli.close()
+
+
+@check("tiny buffer_size (=8) still frames correctly")
+def _():
+    n = nm()
+    srv = PipeServer(n, buffer_size=8)
+    srv.create_instance()
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    cli = PipeClient(n, buffer_size=8)
+    assert cli.connect() is True
+    t.join(3)
+    payload = b"".join(b"%d" % (i % 10) for i in range(5000))
+    tt = threading.Thread(target=cli.send, args=(payload,), daemon=True)
+    tt.start()
+    assert srv.read_frame() == payload
+    tt.join(10)
+    srv.close()
+    cli.close()
+
+
+@check("buffer_size=0 falls back to a sane chunk")
+def _():
+    n = nm()
+    srv = PipeServer(n, buffer_size=0)
+    srv.create_instance()
+    assert srv._channel.buffer_size == protocol.DEFAULT_BUFFER_SIZE
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    cli = PipeClient(n)
+    cli.connect()
+    t.join(3)
+    cli.send(b"ok")
+    assert srv.read_frame() == b"ok"
+    srv.close()
+    cli.close()
+
+
+@check("first_instance=True: 新名字成功，已存在名字 -> connection")
+def _():
+    n = nm()
+    srv = PipeServer(n, instances=2)
+    srv.create_instance(first_instance=True)
+    srv2 = PipeServer(n, instances=2)
+    try:
+        srv2.create_instance(first_instance=True)
+    except WPipeError as e:
+        assert e.kind == "connection", e.kind
+        assert e.winerror is not None
+    else:
+        raise AssertionError("first_instance should fail on an existing name")
+    srv.close()
+    srv2.close()
+
+
+@check("busy: timeout_ms=0 立刻 PipeBusyError")
+def _():
+    n = nm()
+    srv = PipeServer(n, instances=1)
+    srv.create_instance()
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    c1 = PipeClient(n)
+    c1.connect()
+    t.join(3)
+    c2 = PipeClient(n, timeout_ms=0)
+    t0 = time.monotonic()
+    try:
+        c2.connect()
+    except PipeBusyError as e:
+        assert e.kind == "busy"
+        assert time.monotonic() - t0 < 1.0
+    else:
+        raise AssertionError("expected busy")
+    c1.close()
+    c2.close()
+    srv.close()
+
+
+@check("busy: 客户端 timeout_ms / name 记录在异常里")
+def _():
+    n = nm()
+    srv = PipeServer(n, instances=1)
+    srv.create_instance()
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    c1 = PipeClient(n)
+    c1.connect()
+    t.join(3)
+    c2 = PipeClient(n, timeout_ms=150)
+    try:
+        c2.connect()
+    except PipeBusyError as e:
+        assert e.kind == "busy"
+        assert e.name == n, e.name
+        assert e.timeout_ms == 150, e.timeout_ms
+    else:
+        raise AssertionError("expected busy")
+    c1.close()
+    c2.close()
+    srv.close()
+
+
+@check("frame: header 分两半 + payload 逐字节")
+def _():
+    n = nm()
+    srv = PipeServer(n, buffer_size=4096)
+    srv.create_instance()
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    cli = PipeClient(n)
+    cli.connect()
+    t.join(3)
+    payload = b"0123456789"
+    frame = protocol.encode_frame(payload)
+    for i in range(len(frame)):
+        cli.send_bytes(frame[i:i + 1])
+    assert srv.read_frame() == payload
+    cli.send(b"next")
+    assert srv.read_frame() == b"next"
+    srv.close()
+    cli.close()
+
+
+@check("client pending_bytes + recv 顺序")
+def _():
+    n = nm()
+    srv = PipeServer(n)
+    srv.create_instance()
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    cli = PipeClient(n)
+    cli.connect()
+    t.join(3)
+    srv.write_frame(b"abc")
+    srv.write_frame(b"de")
+    time.sleep(0.2)
+    assert cli.pending_bytes() == 13, cli.pending_bytes()
+    assert cli.recv() == b"abc"
+    assert cli.recv() == b"de"
+    assert cli.pending_bytes() == 0
+    srv.close()
+    cli.close()
+
+
+@check("str payload -> TypeError, bytes-like 都可以")
+def _():
+    n = nm()
+    srv = PipeServer(n)
+    srv.create_instance()
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    cli = PipeClient(n)
+    cli.connect()
+    t.join(3)
+    try:
+        cli.send("text")
+    except TypeError:
+        pass
+    else:
+        raise AssertionError("str payload should raise TypeError")
+    cli.send(bytearray(b"ba"))
+    assert srv.read_frame() == b"ba"
+    cli.send(memoryview(b"mv"))
+    assert srv.read_frame() == b"mv"
+    cli.send(None)
+    assert srv.read_frame() == b""
+    srv.close()
+    cli.close()
+
+
+@check("server.close() 之后客户端 recv() -> None")
+def _():
+    n = nm()
+    srv = PipeServer(n)
+    srv.create_instance()
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    cli = PipeClient(n)
+    cli.connect()
+    t.join(3)
+    srv.close()
+    time.sleep(0.2)
+    assert cli.recv() is None
+    assert cli.recv() is None
+    cli.close()
+    cli.close()
+
+
+@check("已关闭的 server/client 句柄不会误报可读")
+def _():
+    srv = PipeServer(nm())
+    srv.create_instance()
+    srv.close()
+    assert srv.read_frame() is None
+    assert srv.pending_bytes() == 0
+    cli = PipeClient(nm())
+    cli.close()
+    assert cli.recv() is None
+
+
+@check("protocol 常量/工具函数")
+def _():
+    assert protocol.HEADER_SIZE == 4
+    assert protocol.frame_header(5) == b"\x05\x00\x00\x00"
+    assert protocol.parse_header(b"\x05\x00\x00\x00") == 5
+    assert protocol.encode_frame(b"ab") == b"\x02\x00\x00\x00ab"
+    assert protocol.encode_frame(b"") == b"\x00\x00\x00\x00"
+    buf = protocol.FrameBuffer()
+    assert buf.pop_frame() is None
+    buf.feed(b"\x02\x00")
+    assert buf.pop_frame() is None
+    buf.feed(b"\x00\x00ab\x00\x00\x00\x00")
+    assert buf.pop_frame() == b"ab"
+    assert buf.pop_frame() == b""
+    assert buf.pop_frame() is None
+
+
+print()
+if FAILS:
+    print("FAILED %d: %s" % (len(FAILS), FAILS))
+    sys.exit(1)
+print("ALL OK (2)")
diff --git a/tmp_verify_wpipe.py b/tmp_verify_wpipe.py
new file mode 100644
index 0000000..821fbcc
--- /dev/null
+++ b/tmp_verify_wpipe.py
@@ -0,0 +1,390 @@
+import os
+import sys
+import threading
+import time
+import traceback
+import uuid
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from winpipe import PipeClient, PipeServer, PipeBusyError, WPipeError  # noqa: E402
+from winpipe import native, protocol  # noqa: E402
+
+FAILS = []
+
+
+def check(label):
+    def deco(fn):
+        try:
+            fn()
+            print("PASS  %s" % label)
+        except Exception:
+            FAILS.append(label)
+            print("FAIL  %s\n%s" % (label, traceback.format_exc()))
+        return fn
+    return deco
+
+
+def nm():
+    return "wv_%s" % uuid.uuid4().hex[:8]
+
+
+def handshake(name, instances=1, buffer_size=4096, client_first=False,
+              timeout_ms=5000, client_buffer=4096):
+    srv = PipeServer(name, instances=instances, buffer_size=buffer_size)
+    srv.create_instance()
+    if client_first:
+        cli = PipeClient(name, timeout_ms=timeout_ms, buffer_size=client_buffer)
+        assert cli.connect() is True
+        assert srv.accept() is True
+    else:
+        t = threading.Thread(target=srv.accept, daemon=True)
+        t.start()
+        time.sleep(0.15)
+        cli = PipeClient(name, timeout_ms=timeout_ms, buffer_size=client_buffer)
+        assert cli.connect() is True
+        t.join(3)
+    return srv, cli
+
+
+# ------------------------------------------------------------------ A / 名字
+@check("name: 规范化")
+def _():
+    assert protocol.resolve_name("foo") == "\\\\.\\pipe\\foo"
+    assert protocol.resolve_name("\\\\.\\pipe\\foo") == "\\\\.\\pipe\\foo"
+    assert protocol.resolve_name("\\\\.\\PIPE\\foo") == "\\\\.\\pipe\\foo"
+
+
+@check("name: 非法名字 -> kind=name")
+def _():
+    bad = ["", "\\\\.\\pipe\\", "foo/bar", "foo\\bar", "\\\\.\\pipe\\foo\\bar",
+           "\\\\.\\pipe\\a/b", "a\nb", "a\tb", "\\\\.\\pipe\\x\x01", None, 123, b"foo"]
+    for n in bad:
+        srv = PipeServer(n)
+        try:
+            srv.create_instance()
+        except WPipeError as e:
+            assert e.kind == "name", (n, e.kind)
+        else:
+            raise AssertionError("server should reject %r" % (n,))
+        cli = PipeClient(n)
+        try:
+            cli.connect()
+        except WPipeError as e:
+            assert e.kind == "name", (n, e.kind)
+        else:
+            raise AssertionError("client should reject %r" % (n,))
+
+
+@check("name: 两种写法指向同一管道")
+def _():
+    n = nm()
+    srv = PipeServer("\\\\.\\pipe\\" + n)
+    srv.create_instance()
+    assert srv.pipe_name == "\\\\.\\pipe\\" + n
+    t = threading.Thread(target=srv.accept, daemon=True)
+    t.start()
+    cli = PipeClient(n)
+    assert cli.connect() is True
+    t.join(3)
+    cli.send(b"hi")
+    assert srv.read_frame() == b"hi"
+    srv.close()
+    cli.close()
+
+
+# ------------------------------------------------------------------ B / 实例
+@check("instances: 创建后续实例成功（忽略 last_error=183）")
+def _():
+    n = nm()
+    srv = PipeServer(n, instances=3)
+    h1 = srv.create_instance()
+    h2 = srv.create_instance()
+    h3 = srv.create_instance()
+    assert native.is_valid(h1) and native.is_valid(h2) and native.is_valid(h3)
+    assert len({h1, h2, h3}) == 3
+    srv.close()
+    srv.close()
+    srv2 = PipeServer(n, instances=1)
+    srv2.create_instance()
+    srv2.close()
+
+
+@check("accept: 客户端先连接（ERROR_PIPE_CONNECTED）也必须成功")
+def _():
+    n = nm()
+    srv = PipeServer(n)
+    srv.create_instance()
+    cli = PipeClient(n)
+    assert cli.connect() is True
+    time.sleep(0.05)
+    assert srv.accept() is True
+    cli.send(b"x")
+    assert srv.read_frame() == b"x"
+    srv.close()
+    cli.close()
+
+
+@check("accept: 未创建实例 -> kind=connection")
+def _():
+    srv = PipeServer(nm())
+    try:
+        srv.accept()
+    except WPipeError as e:
+        assert e.kind == "connection", e.kind
+    else:
+        raise AssertionError("should raise")
+
+
+# ------------------------------------------------------------------ A / 分帧
+@check("frame: 多条小消息不粘连")
+def _():
+    srv, cli = handshake(nm())
+    for i in range(50):
+        cli.send(b"msg-%02d" % i)
+    for i in range(50):
+        got = srv.read_frame()
+        assert got == b"msg-%02d" % i, (i, got)
+    srv.close()
+    cli.close()
+
+
+@check("frame: 反向（server->client）多条小消息")
+def _():
+    srv, cli = handshake(nm())
+    for i in range(20):
+        srv.write_frame(b"r%02d" % i)
+    for i in range(20):
+        assert cli.recv() == b"r%02d" % i
+    srv.close()
+    cli.close()
+
+
+@check("frame: 一次底层读里粘包 -> 逐条拆开")
+def _():
+    srv, cli = handshake(nm(), buffer_size=65536, client_buffer=65536)
+    blob = b"".join(protocol.encode_frame(b"abcd%d" % i) for i in range(10))
+    cli.send_bytes(blob)          # 一次 WriteFile 写入 10 个帧
+    time.sleep(0.2)
+    assert srv.pending_bytes() == len(blob), (srv.pending_bytes(), len(blob))
+    for i in range(10):
+        assert srv.read_frame() == b"abcd%d" % i
+    assert srv.pending_bytes() == 0
+    srv.close()
+    cli.close()
+
+
+@check("frame: 半包（header/payload 分多次底层读）")
+def _():
+    srv, cli = handshake(nm())
+    payload = b"X" * 100
+    frame = protocol.encode_frame(payload)
+    cli.send_bytes(frame[:2])     # 半个 header
+    time.sleep(0.2)
+    cli.send_bytes(frame[2:6])    # 另半个 header + 一点 payload
+    time.sleep(0.2)
+    cli.send_bytes(frame[6:40])
+    time.sleep(0.2)
+    cli.send_bytes(frame[40:])
+    assert srv.read_frame() == payload
+    srv.close()
+    cli.close()
+
+
+@check("frame: 空 payload")
+def _():
+    srv, cli = handshake(nm())
+    cli.send(b"")
+    assert srv.read_frame() == b""
+    cli.send(b"")
+    cli.send(b"z")
+    assert srv.read_frame() == b""
+    assert srv.read_frame() == b"z"
+    srv.close()
+    cli.close()
+
+
+@check("frame: 超过 buffer_size 的大消息（线程写）")
+def _():
+    srv, cli = handshake(nm(), buffer_size=1024, client_buffer=1024)
+    payload = bytes(bytearray((i * 7 + 3) % 251 for i in range(300000)))
+    t = threading.Thread(target=cli.send, args=(payload,), daemon=True)
+    t.start()
+    got = srv.read_frame()
+    t.join(10)
+    assert got == payload, (len(got or b""), len(payload))
+    t = threading.Thread(target=srv.write_frame, args=(payload,), daemon=True)
+    t.start()
+    got = cli.recv()
+    t.join(10)
+    assert got == payload
+    srv.close()
+    cli.close()
+
+
+@check("frame: 大消息 + 后续小消息不串行")
+def _():
+    srv, cli = handshake(nm(), buffer_size=512, client_buffer=512)
+    big = b"\xab" * 5000
+
+    def writer():
+        cli.send(big)
+        cli.send(b"tail")
+
+    t = threading.Thread(target=writer, daemon=True)
+    t.start()
+    assert srv.read_frame() == big
+    assert srv.read_frame() == b"tail"
+    t.join(10)
+    srv.close()
+    cli.close()
+
+
+# ------------------------------------------------------------------ 关闭语义
+@check("close: 对端关闭后 read_frame/recv 返回 None")
+def _():
+    srv, cli = handshake(nm())
+    cli.send(b"bye")
+    assert srv.read_frame() == b"bye"
+    cli.close()
+    time.sleep(0.2)
+    assert srv.read_frame() is None
+    assert srv.read_frame() is None
+    srv.close()
+
+    srv, cli = handshake(nm())
+    srv.write_frame(b"hi")
+    assert cli.recv() == b"hi"
+    srv.close()
+    time.sleep(0.2)
+    assert cli.recv() is None
+    cli.close()
+
+
+@check("close: 幂等")
+def _():
+    srv = PipeServer(nm())
+    srv.create_instance()
+    srv.close()
+    srv.close()
+    srv.close()
+    cli = PipeClient(nm())
+    cli.close()
+    cli.close()
+    srv2, cli2 = handshake(nm())
+    cli2.close()
+    cli2.close()
+    srv2.close()
+    srv2.close()
+
+
+@check("close: 关闭后 pending_bytes 不炸")
+def _():
+    srv = PipeServer(nm())
+    srv.create_instance()
+    srv.close()
+    assert srv.pending_bytes() == 0
+
+
+# ------------------------------------------------------------------ 原始读写
+@check("raw: 往返不回归")
+def _():
+    srv, cli = handshake(nm())
+    assert cli.send_bytes(b"ping") == 4
+    assert srv.read_raw() == b"ping"
+    assert srv.write_raw(b"pong") == 4
+    assert cli.recv_raw() == b"pong"
+    srv.close()
+    cli.close()
+
+
+@check("raw: 与分帧混用顺序正确")
+def _():
+    srv, cli = handshake(nm())
+    cli.send(b"framed")
+    cli.send_bytes(b"rawbytes")
+    time.sleep(0.2)
+    assert srv.read_frame() == b"framed"
+    assert srv.read_raw() == b"rawbytes"
+    srv.close()
+    cli.close()
+
+
+# ------------------------------------------------------------------ C / busy
+@check("busy: 实例占满时等待预算后抛 PipeBusyError(kind=busy)")
+def _():
+    n = nm()
+    srv, cli = handshake(n, instances=1)
+    cli2 = PipeClient(n, timeout_ms=400)
+    t0 = time.monotonic()
+    try:
+        cli2.connect()
+    except PipeBusyError as e:
+        elapsed = time.monotonic() - t0
+        assert e.kind == "busy", e.kind
+        assert isinstance(e, WPipeError)
+        assert e.winerror == 231, e.winerror
+        assert elapsed >= 0.30, elapsed
+        assert elapsed < 3.0, elapsed
+    else:
+        raise AssertionError("should be busy")
+    cli2.close()
+    cli.close()
+    srv.close()
+
+
+@check("busy: 实例释放后在预算内重试成功")
+def _():
+    n = nm()
+    srv = PipeServer(n, instances=2)
+    srv.create_instance()                 # 第 1 个实例（监听中）
+    cli = PipeClient(n, timeout_ms=3000)
+    assert cli.connect() is True          # 占满现有实例
+
+    def add_instance():
+        time.sleep(0.4)
+        srv.create_instance()             # 第 2 个实例出现
+
+    threading.Thread(target=add_instance, daemon=True).start()
+    t0 = time.monotonic()
+    cli2 = PipeClient(n, timeout_ms=3000)
+    assert cli2.connect() is True
+    elapsed = time.monotonic() - t0
+    assert elapsed >= 0.2, elapsed
+    cli2.close()
+    cli.close()
+    srv.close()
+
+
+@check("connection: 管道不存在 -> kind=connection")
+def _():
+    cli = PipeClient(nm(), timeout_ms=200)
+    try:
+        cli.connect()
+    except WPipeError as e:
+        assert e.kind == "connection", (e.kind, e.winerror)
+        assert not isinstance(e, PipeBusyError)
+    else:
+        raise AssertionError("should raise")
+
+
+# ------------------------------------------------------------------ pending
+@check("pending_bytes: 不消费数据")
+def _():
+    srv, cli = handshake(nm())
+    assert srv.pending_bytes() == 0
+    cli.send(b"12345")
+    time.sleep(0.2)
+    assert srv.pending_bytes() == 9, srv.pending_bytes()
+    assert srv.pending_bytes() == 9
+    assert srv.read_frame() == b"12345"
+    assert srv.pending_bytes() == 0
+    srv.close()
+    cli.close()
+
+
+print()
+if FAILS:
+    print("FAILED: %d -> %s" % (len(FAILS), FAILS))
+    sys.exit(1)
+print("ALL OK")
