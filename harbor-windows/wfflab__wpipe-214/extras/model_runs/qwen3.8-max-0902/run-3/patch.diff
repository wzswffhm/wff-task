+import ctypes
+from ctypes import wintypes
+import os
+import sys
+import threading
+import time
+import uuid
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from winpipe import native  # noqa: E402
+
+
+def watchdog(sec):
+    def killer():
+        time.sleep(sec)
+        print("!!! WATCHDOG TIMEOUT")
+        sys.stdout.flush()
+        os._exit(2)
+    threading.Thread(target=killer, daemon=True).start()
+
+
+watchdog(12)
+name = "\\\\.\\pipe\\wmm2_%s" % uuid.uuid4().hex[:8]
+h = native.create_pipe(name, instances=1, buffer_size=4096, message_mode=True)
+print("server handle", h, "err", native.last_error())
+acc = {}
+t = threading.Thread(target=lambda: acc.update(ok=native.connect(h), err=native.last_error()), daemon=True)
+t.start()
+time.sleep(0.2)
+c = native.open_pipe(name)
+print("client handle", c, "valid", native.is_valid(c), "err", native.last_error())
+t.join(3)
+print("accept", acc)
+
+res = {}
+
+
+def writer():
+    res["n"] = native.write(c, b"Z" * 20000)
+
+
+tw = threading.Thread(target=writer, daemon=True)
+tw.start()
+time.sleep(0.4)
+print("peek before:", native.peek(h))
+sys.stdout.flush()
+
+buf = ctypes.create_string_buffer(4096)
+nn = wintypes.DWORD(0)
+ok = native._k32.ReadFile(ctypes.c_void_p(h), buf, 4096, ctypes.byref(nn), None)
+print("ReadFile ok:", bool(ok), "n:", nn.value, "lasterr:", native.last_error())
+print("peek after :", native.peek(h))
+print("prefix match:", buf.raw[:nn.value] == b"Z" * nn.value)
+sys.stdout.flush()
+
+nn2 = wintypes.DWORD(0)
+buf2 = ctypes.create_string_buffer(native.peek(h) or 4096)
+ok2 = native._k32.ReadFile(ctypes.c_void_p(h), buf2, len(buf2), ctypes.byref(nn2), None)
+print("second ReadFile ok:", bool(ok2), "n:", nn2.value, "lasterr:", native.last_error())
+tw.join(5)
+print("writer wrote", res.get("n"))
+os._exit(0)
diff --git a/tmp_verify2.py b/tmp_verify2.py
