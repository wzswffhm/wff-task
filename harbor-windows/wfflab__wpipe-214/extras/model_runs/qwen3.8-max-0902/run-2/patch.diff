@@ -0,0 +1,87 @@
+import threading, time, uuid, ctypes
+from winpipe import PipeServer, PipeClient, WPipeError
+from winpipe import native
+
+def nm():
+    return "exp_%s" % uuid.uuid4().hex[:8]
+
+# --- 1. client connects before server accept()
+name = nm()
+s = PipeServer(name, instances=1)
+h = s.create_instance()
+c = PipeClient(name, timeout_ms=1000)
+print("client connect ->", c.connect())
+time.sleep(0.2)
+ctypes.set_last_error(0)
+ok = native.connect(h)
+print("ConnectNamedPipe ok=", ok, "last_error=", native.last_error())
+print("is_valid(h)=", native.is_valid(h), "h=", h)
+s.close()
+c.close()
+
+# --- 2. second instance with same name, instances=2
+name2 = nm()
+s2 = PipeServer(name2, instances=2)
+h1 = s2.create_instance(first_instance=True)
+print("h1 valid:", native.is_valid(h1), "err:", native.last_error())
+h2 = s2.create_instance()
+print("h2 valid:", native.is_valid(h2), "err after:", native.last_error())
+s2.close()
+
+# --- 3. busy client
+name3 = nm()
+s3 = PipeServer(name3, instances=1)
+s3.create_instance()
+c1 = PipeClient(name3, timeout_ms=1000)
+c1.connect()
+time.sleep(0.1)
+ctypes.set_last_error(0)
+hbusy = native.open_pipe(native.PIPE_PREFIX + name3)
+print("busy open valid:", native.is_valid(hbusy), "err:", native.last_error())
+t0 = time.time()
+wok = native.wait_pipe(native.PIPE_PREFIX + name3, 300)
+print("wait_pipe:", wok, "err:", native.last_error(), "elapsed", round(time.time()-t0, 3))
+t0 = time.time()
+c2 = PipeClient(name3, timeout_ms=400)
+try:
+    c2.connect()
+    print("c2 connected (unexpected)")
+except WPipeError as e:
+    print("c2 raised", type(e).__name__, "kind=", e.kind, "winerror=", e.winerror, "elapsed", round(time.time()-t0,3))
+s3.close(); c1.close(); c2.close()
+
+# --- 4. nonexistent pipe
+name4 = nm()
+t0 = time.time()
+ctypes.set_last_error(0)
+h4 = native.open_pipe(native.PIPE_PREFIX + name4)
+print("nonexistent open valid:", native.is_valid(h4), "err:", native.last_error(), "elapsed", round(time.time()-t0,3))
+
+# --- 5. invalid name create
+for bad in ["", "a/b", "a\\b", "a\x01b", "\\\\.\\pipe\\", "\\\\localhost\\pipe\\x"]:
+    try:
+        hh = native.create_pipe(bad if bad.startswith("\\\\") else native.PIPE_PREFIX + bad)
+        print("create %r -> valid=%s err=%s" % (bad, native.is_valid(hh), native.last_error()))
+        native.close(hh)
+    except Exception as e:
+        print("create %r -> EXC %r" % (bad, e))
+
+# --- 6. read after peer close
+name6 = nm()
+s6 = PipeServer(name6, instances=1)
+s6.create_instance()
+th = threading.Thread(target=s6.accept, daemon=True); th.start()
+c6 = PipeClient(name6); c6.connect(); th.join(3)
+c6.send_bytes(b"hello")
+time.sleep(0.1)
+print("peek:", s6.pending_bytes())
+print("read_raw:", s6.read_raw())
+c6.close()
+time.sleep(0.1)
+try:
+    print("read after close:", s6.read_raw())
+except OSError as e:
+    print("read after close raised OSError winerror=", e.winerror)
+s6.close()
+s6.close()
+print("double close ok")
