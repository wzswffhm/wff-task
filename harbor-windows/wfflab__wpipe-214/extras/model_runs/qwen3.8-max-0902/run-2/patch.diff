@@ -0,0 +1,41 @@
+import ctypes, time, uuid, threading
+from ctypes import wintypes
+from winpipe import PipeServer, PipeClient
+from winpipe import native
+
+name = "exp_peek_%s" % uuid.uuid4().hex[:8]
+s = PipeServer(name)
+s.create_instance()
+th = threading.Thread(target=s.accept, daemon=True); th.start()
+c = PipeClient(name); c.connect(); th.join(3)
+c.send_bytes(b"hello world")
+time.sleep(0.2)
+
+avail = wintypes.DWORD(0)
+read = wintypes.DWORD(0)
+left = wintypes.DWORD(0)
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.PeekNamedPipe.argtypes = [wintypes.HANDLE, ctypes.c_char_p, wintypes.DWORD,
+                              ctypes.POINTER(wintypes.DWORD), ctypes.POINTER(wintypes.DWORD),
+                              ctypes.POINTER(wintypes.DWORD)]
+ok = k32.PeekNamedPipe(ctypes.c_void_p(s._handle), None, 0,
+                       ctypes.byref(read), ctypes.byref(avail), ctypes.byref(left))
+print("PeekNamedPipe ok=", ok, "read=", read.value, "avail=", avail.value, "left=", left.value)
+print("current native.peek ->", s.pending_bytes())
+print("read_raw ->", s.read_raw())
+
+# client-side error code after server closes
+name2 = "exp_close_%s" % uuid.uuid4().hex[:8]
+s2 = PipeServer(name2); s2.create_instance()
+th2 = threading.Thread(target=s2.accept, daemon=True); th2.start()
+c2 = PipeClient(name2); c2.connect(); th2.join(3)
+s2.write_raw(b"abc")
+time.sleep(0.1)
+print("client recv_raw:", c2.recv_raw())
+s2.close()
+time.sleep(0.2)
+try:
+    print("client read after server close:", c2.recv_raw())
+except OSError as e:
+    print("client read after server close -> OSError winerror=", e.winerror)
+c2.close()
