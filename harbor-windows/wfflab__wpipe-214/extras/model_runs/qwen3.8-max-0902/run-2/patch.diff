index 0000000..3f012fa
--- /dev/null
+++ b/exp3.py
@@ -0,0 +1,75 @@
+import time, uuid, threading
+from winpipe import PipeServer, PipeClient
+from winpipe import native
+
+def handshake(name, instances=1):
+    s = PipeServer(name, instances=instances)
+    s.create_instance()
+    th = threading.Thread(target=s.accept, daemon=True); th.start()
+    c = PipeClient(name, timeout_ms=2000); c.connect(); th.join(3)
+    return s, c
+
+def try_read(fn, label):
+    try:
+        print(label, "->", fn())
+    except OSError as e:
+        print(label, "-> OSError winerror=", e.winerror)
+
+# A: server close() (disconnect + closehandle), client reads
+n = "expA_%s" % uuid.uuid4().hex[:6]
+s, c = handshake(n)
+s.close(); time.sleep(0.2)
+try_read(lambda: c.recv_raw(), "A client read")
+try_read(lambda: c.recv_raw(), "A client read again")
+c.close()
+
+# B: server closes handle only (no disconnect), client reads
+n = "expB_%s" % uuid.uuid4().hex[:6]
+s, c = handshake(n)
+native.close(s._handle); s._handle = None
+time.sleep(0.2)
+try_read(lambda: c.recv_raw(), "B client read")
+c.close()
+
+# C: client close(), server reads
+n = "expC_%s" % uuid.uuid4().hex[:6]
+s, c = handshake(n)
+c.close(); time.sleep(0.2)
+try_read(lambda: s.read_raw(), "C server read")
+try_read(lambda: s.read_raw(), "C server read again")
+try_read(lambda: s.pending_bytes(), "C server peek")
+s.close()
+
+# D: data pending then peer closes -> data must come first
+n = "expD_%s" % uuid.uuid4().hex[:6]
+s, c = handshake(n)
+c.send_bytes(b"tail-data")
+time.sleep(0.1)
+c.close(); time.sleep(0.2)
+try_read(lambda: s.read_raw(), "D server read (expect data)")
+try_read(lambda: s.read_raw(), "D server read again (expect EOF err)")
+s.close()
+
+# E: WaitNamedPipe on a nonexistent pipe
+n = "expE_%s" % uuid.uuid4().hex[:6]
+t0 = time.time()
+print("E wait_pipe nonexistent ->", native.wait_pipe(native.PIPE_PREFIX + n, 300),
+      "err=", native.last_error(), "elapsed", round(time.time() - t0, 3))
+
+# F: large write needs a concurrent reader (blocking pipe!)
+n = "expF_%s" % uuid.uuid4().hex[:6]
+s, c = handshake(n)
+big = b"x" * 200000
+res = {}
+def writer():
+    t0 = time.time()
+    res["n"] = native.write(s._handle, big)
+    res["dt"] = round(time.time() - t0, 3)
+th = threading.Thread(target=writer, daemon=True); th.start()
+got = b""
+while len(got) < len(big):
+    got += native.read(c._handle, 4096)
+th.join(10)
+print("F big transfer ok:", got == big, "written:", res.get("n"), "elapsed", res.get("dt"))
+s.close(); c.close()
+print("DONE")
