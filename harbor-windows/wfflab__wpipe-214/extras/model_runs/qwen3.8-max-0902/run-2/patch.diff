+++ b/exp5.py
@@ -0,0 +1,181 @@
+import os, sys, threading, time, uuid
+
+from winpipe import PipeClient, PipeServer, WPipeError, PipeBusyError
+from winpipe import native
+
+FAILS = []
+
+def check(label, cond, extra=""):
+    if cond:
+        print("PASS", label)
+    else:
+        print("FAIL", label, extra)
+        FAILS.append(label)
+
+def eq(label, got, want):
+    check(label, got == want, "got=%r want=%r" % (got, want))
+
+def nm(tag="t"):
+    return "wff_%s_%s" % (tag, uuid.uuid4().hex[:8])
+
+def handshake(name, instances=1, server_first=True):
+    s = PipeServer(name, instances=instances)
+    s.create_instance()
+    if server_first:
+        th = threading.Thread(target=s.accept, daemon=True)
+        th.start()
+        time.sleep(0.15)
+        c = PipeClient(name, timeout_ms=3000)
+        c.connect()
+        th.join(3)
+    else:
+        c = PipeClient(name, timeout_ms=3000)
+        c.connect()
+        eq("accept() when client connected first", s.accept(), True)
+    return s, c
+
+# ------------------------------------------------ C7: 服务端断开后实例重新可用
+relname = nm("release")
+srv = PipeServer(relname, instances=1)
+srv.create_instance()
+th = threading.Thread(target=srv.accept, daemon=True); th.start()
+cA = PipeClient(relname, timeout_ms=5000); cA.connect(); th.join(3)
+cB = PipeClient(relname, timeout_ms=5000)
+result = {}
+def late_connect():
+    try:
+        result["ok"] = cB.connect()
+    except Exception as e:
+        result["err"] = repr(e)
+th2 = threading.Thread(target=late_connect, daemon=True); th2.start()
+time.sleep(0.6)
+native.disconnect(srv._handle)     # 服务端断开 -> 该实例重新进入「等待连接」
+th2.join(8)
+eq("C7 connect succeeds after server disconnects", result.get("ok", result.get("err")), True)
+cA.close(); cB.close(); srv.close()
+
+# ------------------------------------- C7b: 等待期间管道整体消失 -> connection
+gone = nm("gone")
+srv = PipeServer(gone, instances=1)
+srv.create_instance()
+th = threading.Thread(target=srv.accept, daemon=True); th.start()
+cA = PipeClient(gone, timeout_ms=5000); cA.connect(); th.join(3)
+cB = PipeClient(gone, timeout_ms=3000)
+res2 = {}
+def late2():
+    try:
+        res2["ok"] = cB.connect()
+    except Exception as e:
+        res2["err"] = e
+th3 = threading.Thread(target=late2, daemon=True); th3.start()
+time.sleep(0.4)
+srv.close()          # 最后一个实例被关掉
+th3.join(8)
+err = res2.get("err")
+check("C7b vanished pipe -> WPipeError", isinstance(err, WPipeError), repr(res2))
+if isinstance(err, WPipeError):
+    check("C7b vanished pipe kind=connection", err.kind == "connection", "kind=%s" % err.kind)
+    print("     winerror=%r elapsed-ok" % (err.winerror,))
+cA.close(); cB.close()
+
+# ------------------------------------------------ C13: 客户端侧分帧
+s, c = handshake(nm("cframe"))
+try:
+    def writer():
+        s.write_frame(b"a" * 5000)
+        s.write_frame(b"")
+        s.write_frame(b"tail")
+    th = threading.Thread(target=writer, daemon=True); th.start()
+    eq("C13 client frame 1", c.recv(), b"a" * 5000)
+    eq("C14 client empty frame", c.recv(), b"")
+    eq("C15 client frame 3", c.recv(), b"tail")
+    th.join(10)
+finally:
+    s.close(); c.close()
+
+# ------------------------------------------------ D. 不回归
+s, c = handshake(nm("raw"))
+try:
+    c.send_bytes(b"ping")
+    eq("D1 raw client->server", s.read_raw(), b"ping")
+    s.write_raw(b"pong")
+    eq("D2 raw server->client", c.recv_raw(), b"pong")
+    big = os.urandom(50000)
+    th = threading.Thread(target=c.send_bytes, args=(big,), daemon=True); th.start()
+    got = b""
+    while len(got) < len(big):
+        got += s.read_raw()
+    th.join(20)
+    eq("D3 big raw roundtrip", got, big)
+    eq("D4 write_raw return value", s.write_raw(b"12345"), 5)
+    eq("D5 send_bytes return value", c.send_bytes(b"12345"), 5)
+finally:
+    s.close(); c.close()
+
+# client-first handshake (issue #214 场景)
+s, c = handshake(nm("race"), server_first=False)
+try:
+    c.send(b"early")
+    eq("D6 client-first roundtrip", s.read_frame(), b"early")
+    s.write_frame(b"late")
+    eq("D7 client-first reverse", c.recv(), b"late")
+finally:
+    s.close(); c.close()
+
+# 压测：客户端连发 200 条随机长度消息
+s, c = handshake(nm("stress"), server_first=False)
+try:
+    msgs = [os.urandom(i % 5000) for i in range(200)]
+    def blast():
+        for m in msgs:
+            c.send(m)
+    th = threading.Thread(target=blast, daemon=True); th.start()
+    out = [s.read_frame() for _ in msgs]
+    th.join(30)
+    eq("D8 stress 200 random frames", out, msgs)
+finally:
+    s.close(); c.close()
+
+# 压测：双向同时
+s, c = handshake(nm("duplex"), server_first=False)
+try:
+    up = [os.urandom(1000) for _ in range(50)]
+    down = [os.urandom(1000) for _ in range(50)]
+    def w_up():
+        for m in up:
+            c.send(m)
+    def w_down():
+        for m in down:
+            s.write_frame(m)
+    t1 = threading.Thread(target=w_up, daemon=True); t1.start()
+    t2 = threading.Thread(target=w_down, daemon=True); t2.start()
+    got_up = [s.read_frame() for _ in up]
+    got_down = [c.recv() for _ in down]
+    t1.join(20); t2.join(20)
+    eq("D9 duplex up", got_up, up)
+    eq("D10 duplex down", got_down, down)
+finally:
+    s.close(); c.close()
+
+# message_mode=True 的管道也能用长度前缀分帧
+s = PipeServer(nm("msgmode"), instances=1, buffer_size=4096, message_mode=True)
+s.create_instance()
+th = threading.Thread(target=s.accept, daemon=True); th.start()
+c = PipeClient(s.name, timeout_ms=3000); c.connect(); th.join(3)
+try:
+    def w():
+        c.send(b"mm-1"); c.send(b"mm-2")
+    t = threading.Thread(target=w, daemon=True); t.start()
+    eq("D11 message_mode frame 1", s.read_frame(), b"mm-1")
+    eq("D12 message_mode frame 2", s.read_frame(), b"mm-2")
+    t.join(10)
+finally:
+    s.close(); c.close()
+
+print()
+if FAILS:
+    print("%d FAILURES:" % len(FAILS))
+    for f in FAILS:
+        print("  -", f)
+    sys.exit(1)
+print("ALL CHECKS PASSED")
