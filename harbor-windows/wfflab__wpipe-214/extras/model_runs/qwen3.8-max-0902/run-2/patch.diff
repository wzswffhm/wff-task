index 0000000..8544349
--- /dev/null
+++ b/exp4.py
@@ -0,0 +1,249 @@
+import os, struct, sys, threading, time, uuid
+
+from winpipe import PipeClient, PipeServer, WPipeError, PipeBusyError
+from winpipe import native
+from winpipe.naming import resolve_name
+
+FAILS = []
+
+def check(label, cond, extra=""):
+    if cond:
+        print("PASS", label)
+    else:
+        print("FAIL", label, extra)
+        FAILS.append(label)
+
+def eq(label, got, want):
+    check(label, got == want, "got=%r want=%r" % (got, want))
+
+def nm(tag="t"):
+    return "wff_%s_%s" % (tag, uuid.uuid4().hex[:8])
+
+def handshake(name, instances=1, server_first=True):
+    s = PipeServer(name, instances=instances)
+    s.create_instance()
+    if server_first:
+        th = threading.Thread(target=s.accept, daemon=True)
+        th.start()
+        time.sleep(0.15)
+        c = PipeClient(name, timeout_ms=3000)
+        c.connect()
+        th.join(3)
+    else:
+        c = PipeClient(name, timeout_ms=3000)
+        c.connect()
+        eq("accept() when client connected first", s.accept(), True)
+    return s, c
+
+# ---------------------------------------------------------- A. wire format
+def enc(p):
+    return struct.pack("<I", len(p)) + p
+
+s, c = handshake(nm("frame"))
+try:
+    c.send(b"hello")
+    eq("A1 single frame", s.read_frame(), b"hello")
+    s.write_frame(b"world")
+    eq("A2 server->client frame", c.recv(), b"world")
+
+    c.send(b"")
+    eq("A3 empty payload", s.read_frame(), b"")
+
+    for m in (b"one", b"two", b"three", b"\x00\xff binary"):
+        c.send(m)
+    got = [s.read_frame() for _ in range(4)]
+    eq("A4 boundaries preserved", got, [b"one", b"two", b"three", b"\x00\xff binary"])
+
+    # 多帧一次写入（粘包）
+    c.send_bytes(enc(b"ab") + enc(b"cde") + enc(b""))
+    time.sleep(0.2)
+    eq("A5 sticky frames 1", s.read_frame(), b"ab")
+    eq("A5 sticky frames 2", s.read_frame(), b"cde")
+    eq("A5 sticky frames 3", s.read_frame(), b"")
+
+    # 一帧拆成多次写入（半包）
+    c.send_bytes(struct.pack("<I", 5) + b"he")
+    time.sleep(0.2)
+    c.send_bytes(b"ll")
+    time.sleep(0.2)
+    c.send_bytes(b"o")
+    time.sleep(0.2)
+    eq("A6 split frame", s.read_frame(), b"hello")
+
+    # 半包 + 粘包混合
+    c.send_bytes(enc(b"xyz")[:3])
+    time.sleep(0.15)
+    c.send_bytes(enc(b"xyz")[3:] + enc(b"q"))
+    time.sleep(0.15)
+    eq("A7 mixed 1", s.read_frame(), b"xyz")
+    eq("A7 mixed 2", s.read_frame(), b"q")
+
+    # pending_bytes 不消费
+    c.send(b"abc")
+    time.sleep(0.2)
+    eq("A8 pending_bytes (one frame)", s.pending_bytes(), 4 + 3)
+    eq("A9 read_frame after peek", s.read_frame(), b"abc")
+    eq("A10 pending_bytes drained", s.pending_bytes(), 0)
+
+    c.send(b"one")
+    c.send(b"two")
+    time.sleep(0.2)
+    eq("A11 pending two frames", s.pending_bytes(), 7 + 7)
+    eq("A12 first frame", s.read_frame(), b"one")
+    eq("A13 pending only second frame", s.pending_bytes(), 7)
+    eq("A14 second frame", s.read_frame(), b"two")
+    eq("A15 pending zero", s.pending_bytes(), 0)
+finally:
+    s.close()
+    c.close()
+
+# 大消息（超过 buffer_size）
+for size in (4095, 4096, 4097, 100000, 300000):
+    s, c = handshake(nm("big"), instances=1)
+    try:
+        payload = os.urandom(size)
+        th = threading.Thread(target=c.send, args=(payload,), daemon=True)
+        th.start()
+        got = s.read_frame()
+        th.join(20)
+        eq("A16 large frame %d bytes" % size, got, payload)
+        # 反向
+        reply = b"r" * (size + 7)
+        th = threading.Thread(target=s.write_frame, args=(reply,), daemon=True)
+        th.start()
+        got2 = c.recv()
+        th.join(20)
+        eq("A17 large frame back %d bytes" % size, got2, reply)
+    finally:
+        s.close()
+        c.close()
+
+# 大量小消息连发
+s, c = handshake(nm("many"))
+try:
+    msgs = [("msg-%05d" % i).encode() for i in range(500)]
+    def blast():
+        for m in msgs:
+            c.send(m)
+    th = threading.Thread(target=blast, daemon=True)
+    th.start()
+    out = [s.read_frame() for _ in msgs]
+    th.join(30)
+    eq("A18 500 sequential frames", out, msgs)
+finally:
+    s.close()
+    c.close()
+
+# ---------------------------------------------------------- B. name handling
+eq("B1 bare name", resolve_name("foo"), "\\\\.\\pipe\\foo")
+eq("B2 canonical name", resolve_name("\\\\.\\pipe\\foo"), "\\\\.\\pipe\\foo")
+eq("B3 canonical uppercase name part", resolve_name("\\\\.\\pipe\\FOO"), "\\\\.\\pipe\\FOO")
+for bad in ["", "\\\\.\\pipe\\", "a/b", "a\\b", "\\\\.\\pipe\\a/b", "a\x01b", "a\nb", "a\x1fb", None]:
+    try:
+        resolve_name(bad)
+        check("B4 invalid name %r" % (bad,), False, "no exception")
+    except WPipeError as e:
+        eq("B4 invalid name %r -> kind" % (bad,), e.kind, "name")
+    except Exception as e:
+        check("B4 invalid name %r" % (bad,), False, "wrong exc %r" % (e,))
+
+# PipeServer 构造不校验，create_instance 才校验
+for bad in ["", "a/b", "a\\b", "a\x01b"]:
+    srv = PipeServer(bad)
+    try:
+        srv.create_instance()
+        check("B5 create_instance(%r)" % (bad,), False, "no exception")
+        srv.close()
+    except WPipeError as e:
+        eq("B5 create_instance(%r) kind" % (bad,), e.kind, "name")
+
+# 规范化：裸名与规范名指向同一个管道
+bare = nm("norm")
+srv = PipeServer(bare)
+srv.create_instance()
+eq("B6 resolved_name", srv.resolved_name, "\\\\.\\pipe\\" + bare)
+th = threading.Thread(target=srv.accept, daemon=True); th.start()
+cli = PipeClient("\\\\.\\pipe\\" + bare, timeout_ms=3000)
+check("B7 client with canonical name connects", cli.connect())
+th.join(3)
+cli.send(b"x"); eq("B8 canonical roundtrip", srv.read_frame(), b"x")
+srv.close(); cli.close()
+
+# 大小写不敏感
+up = nm("case").upper()
+srv = PipeServer(up)
+srv.create_instance()
+th = threading.Thread(target=srv.accept, daemon=True); th.start()
+cli = PipeClient(up.lower(), timeout_ms=3000)
+check("B9 case-insensitive connect", cli.connect())
+th.join(3)
+cli.send(b"y"); eq("B10 case-insensitive roundtrip", srv.read_frame(), b"y")
+srv.close(); cli.close()
+
+# 后续实例：不得因 183 报错
+multi = nm("multi")
+srv = PipeServer(multi, instances=3)
+h1 = srv.create_instance(first_instance=True)
+check("B11 first instance valid", native.is_valid(h1))
+h2 = srv.create_instance()
+check("B12 second instance valid (183 tolerated)", native.is_valid(h2))
+eq("B13 last_error was 183", native.last_error(), 183)
+h3 = srv.create_instance()
+check("B14 third instance valid", native.is_valid(h3))
+# 三个客户端都能连上
+clients = []
+ths = []
+srv2_handles = [h1, h2, h3]
+def acc(h):
+    native.connect(h)
+for h in srv2_handles:
+    t = threading.Thread(target=acc, args=(h,), daemon=True); t.start(); ths.append(t)
+time.sleep(0.2)
+for i in range(3):
+    cc = PipeClient(multi, timeout_ms=3000)
+    check("B15 client %d connects to instance %d" % (i, i), cc.connect())
+    clients.append(cc)
+for t in ths:
+    t.join(3)
+for cc in clients:
+    cc.close()
+for h in srv2_handles:
+    native.close(h)
+srv._handle = None
+srv.close()
+
+# accept() 失败分类：未创建实例
+srv = PipeServer(nm("noacc"))
+try:
+    srv.accept()
+    check("B16 accept without instance", False, "no exception")
+except WPipeError as e:
+    eq("B16 accept without instance kind", e.kind, "connection")
+
+# read_frame 对端关闭 -> None
+s, c = handshake(nm("eof"))
+c.close()
+time.sleep(0.2)
+eq("B17 read_frame after client close", s.read_frame(), None)
+eq("B18 read_frame again", s.read_frame(), None)
+s.close()
+s.close()
+check("B19 server close idempotent", True)
+
+# 已有完整帧时，对端关闭仍先取帧
+s, c = handshake(nm("eof2"))
+c.send(b"last")
+time.sleep(0.2)
+c.close()
+time.sleep(0.2)
+eq("B20 buffered frame before EOF", s.read_frame(), b"last")
+eq("B21 EOF after that", s.read_frame(), None)
+s.close()
+
+print()
+if FAILS:
+    print('%d FAILURES:' % len(FAILS))
+    for f in FAILS:
+        print('  -', f)
+    sys.exit(1)
+print('ALL A/B CHECKS PASSED')
