@@ -0,0 +1,92 @@
+"""阻塞 I/O 的线程跟踪与取消（``close()`` 时的解阻塞保险）。
+
+Windows 上，如果有线程正阻塞在本对象句柄的**同步** ``ReadFile`` /
+``WriteFile`` 上，那么 ``DisconnectNamedPipe`` 与 ``CloseHandle`` 都会一直等
+到那次 I/O 完成才返回——于是「关闭方」与「被阻塞的读方」互相等待，进程卡死。
+
+这里记录「哪些线程正在本对象的句柄上做阻塞 I/O」，``close()`` 时先用
+``CancelSynchronousIo`` 把它们唤醒（对应的那次读会返回
+``ERROR_OPERATION_ABORTED``，分帧层把它当作「对端已关闭」处理），然后再断开
+并关闭句柄。没有线程阻塞时，这一切都是空操作。
+"""
+
+from __future__ import annotations
+
+import contextlib
+import ctypes
+import threading
+from ctypes import wintypes
+
+__all__ = ["IoTracker", "cancel_thread_io", "current_thread_id"]
+
+_k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+_k32.OpenThread.restype = wintypes.HANDLE
+_k32.OpenThread.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
+_k32.CancelSynchronousIo.restype = wintypes.BOOL
+_k32.CancelSynchronousIo.argtypes = [wintypes.HANDLE]
+_k32.CloseHandle.restype = wintypes.BOOL
+_k32.CloseHandle.argtypes = [wintypes.HANDLE]
+
+THREAD_ALL_ACCESS = 0x001F03FF
+
+
+def current_thread_id():
+    """当前线程的 Win32 线程号（CPython 的 ``threading.get_ident()``）。"""
+    return threading.get_ident()
+
+
+def cancel_thread_io(thread_id):
+    """尽力取消 ``thread_id`` 上正在进行的同步 I/O，返回是否取消成功。"""
+    if not thread_id:
+        return False
+    try:
+        thread_id = int(thread_id)
+    except (TypeError, ValueError):
+        return False
+    handle = _k32.OpenThread(THREAD_ALL_ACCESS, False, wintypes.DWORD(thread_id))
+    if not handle:
+        return False
+    try:
+        return bool(_k32.CancelSynchronousIo(wintypes.HANDLE(handle)))
+    except OSError:  # pragma: no cover - 防御性
+        return False
+    finally:
+        _k32.CloseHandle(wintypes.HANDLE(handle))
+
+
+class IoTracker:
+    """记录当前正在做阻塞 I/O 的线程集合。"""
+
+    def __init__(self):
+        self._lock = threading.Lock()
+        self._tids = set()
+
+    @contextlib.contextmanager
+    def blocking_call(self):
+        """包住一次可能阻塞的 Win32 调用。"""
+        tid = threading.get_ident()
+        with self._lock:
+            self._tids.add(tid)
+        try:
+            yield
+        finally:
+            with self._lock:
+                self._tids.discard(tid)
+
+    def cancel_all(self, exclude=None):
+        """唤醒所有仍在阻塞的线程（``exclude`` 指定的线程除外）。"""
+        with self._lock:
+            tids = [tid for tid in self._tids if tid != exclude]
+        cancelled = 0
+        for tid in tids:
+            try:
+                if cancel_thread_io(tid):
+                    cancelled += 1
+            except Exception:  # pragma: no cover - 解阻塞只是尽力而为
+                pass
+        return cancelled
+
+    def pending(self):
+        """当前有多少个线程正阻塞在本对象的句柄上。"""
+        with self._lock:
+            return len(self._tids)
