+++ b/_scratch/test_selfcheck.py
@@ -0,0 +1,367 @@
+"""验收标准的自检脚本（临时，提交前删除）。"""
+import os
+import struct
+import threading
+import time
+import uuid
+
+import pytest
+
+import winpipe
+from winpipe import PipeClient, PipeServer, PipeBusyError, WPipeError
+from winpipe import native
+from winpipe.framing import FrameBuffer, pack_frame
+
+
+def _name():
+    return "wff_selfcheck_%s" % uuid.uuid4().hex[:8]
+
+
+def _handshake(name, instances=1):
+    server = PipeServer(name, instances=instances)
+    server.create_instance()
+    t = threading.Thread(target=server.accept, daemon=True)
+    t.start()
+    client = PipeClient(name)
+    client.connect()
+    t.join(3)
+    return server, client
+
+
+# ------------------------------------------------------------------ A. 分帧
+def test_wire_format_on_the_wire():
+    server, client = _handshake(_name())
+    try:
+        client.send(b"hello")
+        time.sleep(0.1)
+        assert server.read_raw() == struct.pack("<I", 5) + b"hello"
+    finally:
+        client.close()
+        server.close()
+
+
+def test_empty_payload_frame():
+    server, client = _handshake(_name())
+    try:
+        client.send(b"")
+        assert server.read_frame() == b""
+        server.write_frame(b"")
+        assert client.recv() == b""
+    finally:
+        client.close()
+        server.close()
+
+
+def test_many_frames_coalesced():
+    server, client = _handshake(_name())
+    try:
+        msgs = [b"m%d" % i for i in range(50)]
+        for m in msgs:
+            client.send(m)
+        for m in msgs:
+            assert server.read_frame() == m
+        for m in msgs:
+            server.write_frame(m)
+        for m in msgs:
+            assert client.recv() == m
+    finally:
+        client.close()
+        server.close()
+
+
+def test_frame_split_across_reads(monkeypatch):
+    """一次只喂 1 个字节，帧必须被正确拼装。"""
+    server, client = _handshake(_name())
+    try:
+        client.send_bytes(pack_frame(b"hello") + pack_frame(b"") + pack_frame(b"world!"))
+        real_read = native.read
+        state = {"buf": bytearray(), "primed": False}
+
+        def slow_read(handle, size):
+            if not state["primed"]:
+                while True:
+                    try:
+                        chunk = real_read(handle, 4096)
+                    except OSError:
+                        raise
+                    if not chunk:
+                        break
+                    state["buf"].extend(chunk)
+                    if native.peek(handle) == 0:
+                        break
+                state["primed"] = True
+            assert size >= 1
+            if not state["buf"]:
+                return real_read(handle, size)
+            one = bytes(state["buf"][:1])
+            del state["buf"][:1]
+            return one
+
+        monkeypatch.setattr(native, "read", slow_read)
+        assert server.read_frame() == b"hello"
+        assert server.read_frame() == b""
+        assert server.read_frame() == b"world!"
+    finally:
+        monkeypatch.undo()
+        client.close()
+        server.close()
+
+
+def test_broken_pipe_returns_none_from_read_frame(monkeypatch):
+    buf = FrameBuffer(4096)
+    chunks = iter([b"\x05\x00\x00\x00he", b"llo\x03\x00\x00\x00", b"abc", None])
+    assert buf.read_frame(lambda n: next(chunks)) == b"hello"
+    assert buf.read_frame(lambda n: next(chunks)) == b"abc"
+    assert buf.read_frame(lambda n: next(chunks)) is None
+
+
+def test_read_frame_none_after_peer_close():
+    server, client = _handshake(_name())
+    try:
+        client.send(b"last")
+        client.close()
+        assert server.read_frame() == b"last"
+        assert server.read_frame() is None
+        assert server.read_frame() is None
+    finally:
+        server.close()
+
+
+def test_recv_none_after_server_close():
+    server, client = _handshake(_name())
+    try:
+        server.write_frame(b"bye")
+        server.close()
+        assert client.recv() == b"bye"
+        assert client.recv() is None
+    finally:
+        client.close()
+
+
+def test_large_message_roundtrip():
+    server, client = _handshake(_name())
+    try:
+        payload = os.urandom(200000)
+        t = threading.Thread(target=client.send, args=(payload,), daemon=True)
+        t.start()
+        got = server.read_frame()
+        t.join(5)
+        assert got == payload
+        back = os.urandom(300000)
+        t2 = threading.Thread(target=server.write_frame, args=(back,), daemon=True)
+        t2.start()
+        assert client.recv() == back
+        t2.join(5)
+    finally:
+        client.close()
+        server.close()
+
+
+# ------------------------------------------------------------------ B. 服务端
+def test_name_normalization():
+    name = _name()
+    server = PipeServer(name)
+    assert server.name == name          # 规范化发生在 create_instance
+    handle = server.create_instance()
+    assert native.is_valid(handle)
+    assert server.name == "\\\\.\\pipe\\" + name
+    server.close()
+
+    server2 = PipeServer("\\\\.\\pipe\\" + _name())
+    expected = server2.name
+    server2.create_instance()
+    assert server2.name == expected
+    server2.close()
+
+
+@pytest.mark.parametrize("bad", ["", "\\\\.\\pipe\\", "bad/name", "bad\\name",
+                                 "\\\\.\\pipe\\bad/name", "foo\nbar", "foo\x01bar",
+                                 "foo\x1fbar", "\t"])
+def test_invalid_names(bad):
+    server = PipeServer(bad)          # __init__ 不该抛
+    with pytest.raises(WPipeError) as ei:
+        server.create_instance()
+    assert ei.value.kind == "name"
+
+
+def test_multiple_instances_and_183():
+    name = _name()
+    s1 = PipeServer(name, instances=2)
+    h1 = s1.create_instance(first_instance=True)
+    s2 = PipeServer(name, instances=2)
+    h2 = s2.create_instance()
+    assert native.is_valid(h1) and native.is_valid(h2) and h1 != h2
+    s3 = PipeServer(name, instances=2)
+    h3 = s3.create_instance()
+    assert native.is_valid(h3)
+    s1.close()
+    s2.close()
+    s3.close()
+
+
+def test_accept_when_client_connects_first():
+    name = _name()
+    server = PipeServer(name)
+    server.create_instance()
+    client = PipeClient(name)
+    client.connect()               # 客户端先连
+    time.sleep(0.1)
+    assert server.accept() is True
+    client.send(b"early")
+    assert server.read_frame() == b"early"
+    server.close()
+    client.close()
+
+
+def test_accept_when_server_waits_first():
+    server, client = _handshake(_name())
+    try:
+        client.send(b"normal")
+        assert server.read_frame() == b"normal"
+    finally:
+        client.close()
+        server.close()
+
+
+def test_pending_bytes():
+    server, client = _handshake(_name())
+    try:
+        client.send_bytes(pack_frame(b"aa") + pack_frame(b"bb"))
+        time.sleep(0.15)
+        assert server.pending_bytes() == 12
+        assert server.read_frame() == b"aa"
+        assert server.pending_bytes() == 6
+        assert server.read_frame() == b"bb"
+        assert server.pending_bytes() == 0
+    finally:
+        client.close()
+        server.close()
+
+
+def test_server_close_idempotent():
+    server = PipeServer(_name())
+    server.create_instance()
+    server.close()
+    server.close()
+    server.close()
+
+
+# ------------------------------------------------------------------ C. 客户端
+def test_busy_raises_pipe_busy_error():
+    name = _name()
+    server = PipeServer(name, instances=1)
+    server.create_instance()
+    c1 = PipeClient(name, timeout_ms=1000)
+    c1.connect()
+    c2 = PipeClient(name, timeout_ms=250)
+    t0 = time.time()
+    with pytest.raises(PipeBusyError) as ei:
+        c2.connect()
+    elapsed = time.time() - t0
+    assert ei.value.kind == "busy"
+    assert isinstance(ei.value, WPipeError)
+    assert elapsed >= 0.2, elapsed
+    assert elapsed < 2.0, elapsed
+    c1.close()
+    server.close()
+    c2.close()
+
+
+def test_busy_then_instance_released():
+    name = _name()
+    server = PipeServer(name, instances=1)
+    server.create_instance()
+    server.accept() if False else None
+    c1 = PipeClient(name, timeout_ms=2000)
+    c1.connect()
+
+    def release():
+        time.sleep(0.4)
+        c1.close()
+        server.close()
+        server.create_instance()
+        threading.Thread(target=server.accept, daemon=True).start()
+
+    threading.Thread(target=release, daemon=True).start()
+    c2 = PipeClient(name, timeout_ms=4000)
+    t0 = time.time()
+    assert c2.connect() is True
+    assert time.time() - t0 < 3.5
+    c2.send(b"after-busy")
+    assert server.read_frame() == b"after-busy"
+    c2.close()
+    server.close()
+
+
+def test_connect_missing_pipe_is_connection_error():
+    client = PipeClient(_name(), timeout_ms=500)
+    t0 = time.time()
+    with pytest.raises(WPipeError) as ei:
+        client.connect()
+    assert ei.value.kind == "connection"
+    assert not isinstance(ei.value, PipeBusyError)
+    assert time.time() - t0 < 1.0
+    client.close()
+
+
+def test_client_close_idempotent():
+    client = PipeClient(_name())
+    client.close()
+    client.close()
+    server, client = _handshake(_name())
+    client.close()
+    client.close()
+    server.close()
+
+
+# ------------------------------------------------------------------ D. 不回归
+def test_raw_roundtrips():
+    server, client = _handshake(_name())
+    try:
+        client.send_bytes(b"ping")
+        assert server.read_raw() == b"ping"
+        server.write_raw(b"pong")
+        assert client.recv_raw() == b"pong"
+        big = b"z" * 100000
+        t = threading.Thread(target=client.send_bytes, args=(big,), daemon=True)
+        t.start()
+        got = bytearray()
+        while len(got) < len(big):
+            chunk = server.read_raw()
+            if not chunk:
+                break
+            got.extend(chunk)
+        t.join(5)
+        assert bytes(got) == big
+    finally:
+        client.close()
+        server.close()
+
+
+def test_close_while_reader_blocked_does_not_hang():
+    """close() 必须能唤醒阻塞在本对象上的读线程，且自己不能卡死。"""
+    server, client = _handshake(_name())
+    out = []
+
+    def loop():
+        try:
+            out.append(server.read_frame())
+        except BaseException as exc:      # noqa: BLE001
+            out.append(exc)
+
+    t = threading.Thread(target=loop, daemon=True)
+    t.start()
+    time.sleep(0.3)
+    t0 = time.time()
+    server.close()
+    assert time.time() - t0 < 3
+    t.join(3)
+    assert not t.is_alive()
+    assert out == [None], out
+    client.close()
+
+
+def test_public_exports():
+    assert winpipe.PipeServer is PipeServer
+    assert winpipe.PipeClient is PipeClient
+    assert issubclass(PipeBusyError, WPipeError)
