+"""Experiment 3: WaitNamedPipe release wake-up + single-thread write threshold."""
+import os
+import sys
+import threading
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from winpipe import native as N
+
+P = N.PIPE_PREFIX
+CODES = {2: 'FILE_NOT_FOUND', 109: 'BROKEN_PIPE', 121: 'SEM_TIMEOUT',
+         183: 'ALREADY_EXISTS', 230: 'BAD_PIPE', 231: 'PIPE_BUSY',
+         232: 'NO_DATA', 233: 'PIPE_NOT_CONNECTED', 535: 'PIPE_CONNECTED'}
+
+
+def en(c):
+    return CODES.get(c, str(c))
+
+
+print('== WaitNamedPipe wakes when instance is released ==')
+bname = P + 'wp_wait_%d_%d' % (os.getpid(), int(time.time()))
+hb = N.create_pipe(bname, instances=1)
+cb1 = N.open_pipe(bname)
+print('  ConnectNamedPipe ok=%s err=%s' % (N.connect(hb), en(N.last_error())))
+cb2 = N.open_pipe(bname)
+print('  second client valid=%s err=%s' % (N.is_valid(cb2), en(N.last_error())))
+
+
+def release():
+    time.sleep(0.4)
+    N.close(cb1)
+    N.disconnect(hb)
+
+
+threading.Thread(target=release, daemon=True).start()
+t0 = time.time()
+wok = N.wait_pipe(bname, 3000)
+we = N.last_error()
+print('  wait_pipe(3000) ok=%s err=%s elapsed=%.3f' % (wok, en(we), time.time() - t0))
+cb3 = N.open_pipe(bname)
+print('  client3 valid=%s err=%s' % (N.is_valid(cb3), en(N.last_error())))
+N.close(cb3)
+N.close(hb)
+
+print('== WaitNamedPipe when pipe does not exist ==')
+t0 = time.time()
+wok = N.wait_pipe(P + 'wp_nope_zzz', 1000)
+print('  ok=%s err=%s elapsed=%.3f' % (wok, en(N.last_error()), time.time() - t0))
+
+print('== single-thread write threshold with buffer_size=4096 ==')
+wname = P + 'wp_thr_%d_%d' % (os.getpid(), int(time.time()))
+hw = N.create_pipe(wname, instances=1, buffer_size=4096)
+cw = N.open_pipe(wname)
+N.connect(hw)
+for size in (1000, 4000, 4096, 4200, 8192, 16384, 65536, 70000):
+    done = []
+    th = threading.Thread(target=lambda s=size: done.append(N.write(cw, b'B' * s)), daemon=True)
+    th.start()
+    th.join(0.4)
+    blocked = th.is_alive()
+    got = bytearray()
+    deadline = time.time() + 2
+    while len(got) < size and time.time() < deadline:
+        try:
+            avail = N.peek(hw)
+        except OSError:
+            avail = 0
+        if avail:
+            got.extend(N.read(hw, avail))
+        else:
+            time.sleep(0.01)
+    th.join(2)
+    print('  size=%6d blocked=%s drained=%d' % (size, blocked, len(got)))
+N.close(cw)
+N.close(hw)
+print('done')
