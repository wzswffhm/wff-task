@@ -0,0 +1,83 @@
+import os
+import sys
+import threading
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from winpipe import native as N
+
+P = N.PIPE_PREFIX
+CODES = {2: 'FILE_NOT_FOUND', 109: 'BROKEN_PIPE', 121: 'SEM_TIMEOUT',
+         230: 'BAD_PIPE', 231: 'PIPE_BUSY', 232: 'NO_DATA',
+         233: 'PIPE_NOT_CONNECTED', 995: 'OPERATION_ABORTED', 535: 'PIPE_CONNECTED'}
+
+
+def en(c):
+    return CODES.get(c, str(c))
+
+
+def attempt(label, fn):
+    try:
+        print('  %s -> %r' % (label, fn()), flush=True)
+    except OSError as ex:
+        print('  %s -> OSError %s(%s)' % (label, ex.winerror, en(ex.winerror)), flush=True)
+
+
+print('== does written data survive an immediate client close? ==', flush=True)
+for trial in range(3):
+    name = P + 'wp_surv_%d_%d' % (os.getpid(), trial)
+    h = N.create_pipe(name, instances=1)
+    c = N.open_pipe(name)
+    N.connect(h)
+    N.write(c, b'\x05\x00\x00\x00hello')
+    N.close(c)          # 立刻关闭，不做 FlushFileBuffers
+    attempt('read#1', lambda hh=h: N.read(hh, 4096))
+    attempt('read#2', lambda hh=h: N.read(hh, 4096))
+    N.close(h)
+
+print('== large payload written then client closed immediately ==', flush=True)
+name = P + 'wp_surv_big_%d' % os.getpid()
+h = N.create_pipe(name, instances=1)
+c = N.open_pipe(name)
+N.connect(h)
+payload = b'X' * 100000
+th = threading.Thread(target=lambda: (N.write(c, payload), N.close(c)), daemon=True)
+th.start()
+got = bytearray()
+while len(got) < len(payload):
+    try:
+        chunk = N.read(h, 65536)
+    except OSError as ex:
+        print('  read error %s(%s) after %d bytes' % (ex.winerror, en(ex.winerror), len(got)), flush=True)
+        break
+    if not chunk:
+        break
+    got.extend(chunk)
+print('  drained=%d / %d' % (len(got), len(payload)), flush=True)
+attempt('final read', lambda: N.read(h, 4096))
+N.close(h)
+
+print('== blocked reader when handle closed by another thread ==', flush=True)
+name = P + 'wp_abort_%d' % os.getpid()
+h = N.create_pipe(name, instances=1)
+c = N.open_pipe(name)
+N.connect(h)
+out = []
+
+
+def reader():
+    try:
+        out.append(N.read(h, 4096))
+    except OSError as ex:
+        out.append('OSError %s(%s)' % (ex.winerror, en(ex.winerror)))
+
+
+t = threading.Thread(target=reader, daemon=True)
+t.start()
+time.sleep(0.3)
+N.disconnect(h)
+N.close(h)
