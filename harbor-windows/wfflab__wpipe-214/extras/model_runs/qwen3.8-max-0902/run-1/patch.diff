+import ctypes
+import os
+import sys
+import threading
+import time
+from ctypes import wintypes
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from winpipe import native as N
+
+P = N.PIPE_PREFIX
+k32 = ctypes.WinDLL('kernel32', use_last_error=True)
+k32.FlushFileBuffers.restype = wintypes.BOOL
+k32.FlushFileBuffers.argtypes = [wintypes.HANDLE]
+
+
+def watchdog(seconds, tag):
+    def boom():
+        time.sleep(seconds)
+        print('  !! WATCHDOG %s hung > %ss' % (tag, seconds), flush=True)
+        os._exit(2)
+    threading.Thread(target=boom, daemon=True).start()
+
+
+def scenario(tag, closer, client_reads=True, client_sleep=0.0):
+    print('== %s ==' % tag, flush=True)
+    name = P + 'wp_s_%s_%d' % (tag, int(time.time() * 1000) % 100000)
+    h = N.create_pipe(name, instances=1)
+    c = N.open_pipe(name)
+    N.connect(h)
+    N.write(h, b'\x05\x00\x00\x00hello')
+
+    def do_close():
+        time.sleep(0.2)
+        closer(h)
+        print('   closer finished', flush=True)
+
+    t = threading.Thread(target=do_close, daemon=True)
+    t.start()
+    if client_reads:
+        time.sleep(client_sleep)
+        try:
+            print('   client read -> %r' % N.read(c, 4096), flush=True)
+        except OSError as ex:
+            print('   client read -> OSError %s' % ex.winerror, flush=True)
+        try:
+            print('   client read2 -> %r' % N.read(c, 4096), flush=True)
+        except OSError as ex:
+            print('   client read2 -> OSError %s' % ex.winerror, flush=True)
+    t.join(8)
+    print('   closer alive=%s' % t.is_alive(), flush=True)
+    N.close(c)
+    if t.is_alive():
+        print('   !! closer still blocked', flush=True)
+
+
+def close_plain(h):
+    N.close(h)
+
+
+def close_disconnect(h):
+    N.disconnect(h)
+    N.close(h)
+
+
+def close_flush_disconnect(h):
+    ok = k32.FlushFileBuffers(wintypes.HANDLE(h))
+    print('   FlushFileBuffers -> %s err=%s' % (ok, ctypes.get_last_error()), flush=True)
+    N.disconnect(h)
+    N.close(h)
+
+
+watchdog(60, 'all')
+scenario('A_closehandle_only', close_plain)
+scenario('B_disconnect_close', close_disconnect)
+scenario('C_flush_disconnect', close_flush_disconnect)
+print('== D: flush with a client that never reads (hang check) ==', flush=True)
+scenario('D_flush_noread', close_flush_disconnect, client_reads=False)
+print('done', flush=True)
+os._exit(0)
