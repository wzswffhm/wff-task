+++ b/winpipe/_endpoint.py
@@ -0,0 +1,116 @@
+"""``PipeServer`` / ``PipeClient`` 共用的句柄与分帧 I/O 逻辑。"""
+
+from __future__ import annotations
+
+import time
+
+from . import native
+from ._io import IoTracker, current_thread_id
+from .errors import WPipeError
+from .framing import EOF_ERRORS, FrameBuffer, pack_frame, winerror_of
+
+__all__ = ["Endpoint"]
+
+#: close() 取消掉阻塞 I/O 之后，留给那个线程一点点时间从 ReadFile 里退出来，
+#: 再去 DisconnectNamedPipe / CloseHandle（否则内核可能仍认为有未完成的 I/O）。
+_CANCEL_GRACE_SECONDS = 0.01
+
+
+class Endpoint:
+    """「一个管道句柄 + 一个分帧接收缓冲」的最小公共实现。"""
+
+    def __init__(self, name, buffer_size=4096):
+        self.name = name
+        self.buffer_size = buffer_size
+        self._handle = None
+        self._frames = FrameBuffer(buffer_size)
+        self._io = IoTracker()
+
+    # ------------------------------------------------------------ 内部工具
+    def _require_handle(self):
+        handle = self._handle
+        if not native.is_valid(handle):
+            raise WPipeError("connection", "pipe %r is not open" % (self.name,))
+        return handle
+
+    def _read_some(self, size):
+        """底层读一次。
+
+        成功返回 ``bytes``；对端已经关闭返回 ``None``；其它错误抛
+        ``WPipeError(kind="connection")``。
+        """
+        handle = self._handle
+        try:
+            with self._io.blocking_call():
+                return native.read(handle, size)
+        except OSError as exc:
+            code = winerror_of(exc)
+            if code in EOF_ERRORS:
+                return None
+            raise WPipeError("connection", "read on %r failed" % (self.name,),
+                             winerror=code) from exc
+
+    def _read_raw(self):
+        """不分帧的原始读（保持既有行为：失败原样抛 ``OSError``）。"""
+        handle = self._require_handle()
+        with self._io.blocking_call():
+            return native.read(handle, self.buffer_size)
+
+    def _write_raw(self, data):
+        """不分帧的原始写（保持既有行为：失败原样抛 ``OSError``）。"""
+        handle = self._require_handle()
+        with self._io.blocking_call():
+            return native.write(handle, data)
+
+    def _read_frame(self):
+        """读取恰好一条完整帧，返回 payload；对端关闭返回 ``None``。"""
+        self._require_handle()
+        return self._frames.read_frame(self._read_some)
+
+    def _write_frame(self, payload):
+        """按长度前缀写出一整帧，返回写出的字节数（含 4 字节头）。"""
+        data = pack_frame(payload)
+        handle = self._require_handle()
+        total = 0
+        while total < len(data):
+            try:
+                with self._io.blocking_call():
+                    written = native.write(handle, data[total:])
+            except OSError as exc:
+                code = winerror_of(exc)
+                raise WPipeError("connection", "write on %r failed" % (self.name,),
+                                 winerror=code) from exc
+            if not written:
+                raise WPipeError("connection", "write on %r made no progress" % (self.name,))
+            total += written
+        return total
+
+    def _pending_bytes(self):
+        """当前可读字节数 = 已缓冲但没取走的 + 管道里还没读的（都不消费）。"""
+        buffered = self._frames.buffered_bytes
+        handle = self._handle
+        if not native.is_valid(handle):
+            return buffered
+        try:
+            return buffered + native.peek(handle)
+        except OSError as exc:
+            if winerror_of(exc) in EOF_ERRORS:
+                return buffered
+            raise
+
+    def _shutdown(self, disconnect):
+        """断开（可选）并关闭句柄，幂等。"""
+        handle = self._handle
+        self._handle = None
+        self._frames.discard()
+        cancelled = self._io.cancel_all(exclude=current_thread_id())
+        if cancelled and _CANCEL_GRACE_SECONDS > 0:
+            time.sleep(_CANCEL_GRACE_SECONDS)
+        if not native.is_valid(handle):
+            return
+        if disconnect:
+            try:
+                native.disconnect(handle)
+            except OSError:  # pragma: no cover - 断开失败不影响关闭
+                pass
+        native.close(handle)
