+++ b/_scratch/exp1.py
@@ -0,0 +1,132 @@
+"""Experiment 1: Win32 named pipe semantics on this machine."""
+import ctypes
+import os
+import sys
+import threading
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from winpipe import native as N
+
+P = N.PIPE_PREFIX
+CODES = {2: 'FILE_NOT_FOUND', 3: 'PATH_NOT_FOUND', 5: 'ACCESS_DENIED',
+         109: 'BROKEN_PIPE', 121: 'SEM_TIMEOUT', 123: 'INVALID_NAME',
+         183: 'ALREADY_EXISTS', 231: 'PIPE_BUSY', 232: 'NO_DATA',
+         535: 'PIPE_CONNECTED'}
+
+
+def en(c):
+    return CODES.get(c, str(c))
+
+
+print('== CreateFileW with odd names ==')
+for nm in ['', 'bad/name', 'bad\\name', 'foo\nbar', 'foo\x01bar',
+           P + 'definitely_missing_zzz', '\\\\localhost\\pipe\\definitely_missing_zzz']:
+    h = N.open_pipe(nm)
+    e = N.last_error()
+    print('  open_pipe(%r) valid=%s err=%d(%s)' % (nm, N.is_valid(h), e, en(e)))
+    if N.is_valid(h):
+        N.close(h)
+
+print('== CreateNamedPipeW with odd names ==')
+for nm in ['', 'bad/name', 'bad\\name', 'foo\nbar']:
+    h = N.create_pipe(nm, instances=1)
+    e = N.last_error()
+    print('  create_pipe(%r) valid=%s err=%d(%s)' % (nm, N.is_valid(h), e, en(e)))
+    if N.is_valid(h):
+        N.close(h)
+
+print('== second instance last_error ==')
+name = P + 'wp_exp_%d' % os.getpid()
+h1 = N.create_pipe(name, instances=2, first_instance=True)
+print('  h1 valid=%s err=%d(%s)' % (N.is_valid(h1), N.last_error(), en(N.last_error())))
+h2 = N.create_pipe(name, instances=2)
+print('  h2 valid=%s err=%d(%s)' % (N.is_valid(h2), N.last_error(), en(N.last_error())))
+
+print('== client connects first -> ConnectNamedPipe ==')
+c = N.open_pipe(name)
+print('  client valid=%s err=%d' % (N.is_valid(c), N.last_error()))
+time.sleep(0.1)
+ok = N.connect(h1)
+e = N.last_error()
+print('  ConnectNamedPipe ok=%s err=%d(%s)' % (ok, e, en(e)))
+
+print('== big write from client while server not reading (threaded) ==')
+big = b'A' * 200000
+th = threading.Thread(target=lambda: N.write(c, big), daemon=True)
+t0 = time.time()
+th.start()
+th.join(1.0)
+print('  writer done within 1s=%s elapsed=%.3f' % (not th.is_alive(), time.time() - t0))
+buf = bytearray()
+while len(buf) < len(big):
+    chunk = N.read(h1, 65536)
+    if not chunk:
+        break
+    buf.extend(chunk)
+print('  server drained %d bytes; writer alive=%s' % (len(buf), th.is_alive()))
+
+print('== big write server->client, single thread, no reader ==')
+th2 = threading.Thread(target=lambda: N.write(h1, big), daemon=True)
+th2.start()
+th2.join(1.5)
+print('  write blocked=%s' % th2.is_alive())
+got = bytearray()
+while len(got) < len(big):
+    chunk = N.read(c, 65536)
+    if not chunk:
+        break
+    got.extend(chunk)
+print('  client drained %d bytes' % len(got))
+
+print('== busy behaviour (instances=1) ==')
+bname = P + 'wp_busy_%d' % os.getpid()
+hb = N.create_pipe(bname, instances=1)
+cb1 = N.open_pipe(bname)
+print('  first client valid=%s' % N.is_valid(cb1))
+cb2 = N.open_pipe(bname)
+e2 = N.last_error()
+print('  second client valid=%s err=%d(%s)' % (N.is_valid(cb2), e2, en(e2)))
+t0 = time.time()
+wok = N.wait_pipe(bname, 300)
+we = N.last_error()
+print('  wait_pipe(300) ok=%s err=%d(%s) elapsed=%.3f' % (wok, we, en(we), time.time() - t0))
+t0 = time.time()
+wok = N.wait_pipe(bname, 0)
+we = N.last_error()
+print('  wait_pipe(0) ok=%s err=%d(%s) elapsed=%.3f' % (wok, we, en(we), time.time() - t0))
+t0 = time.time()
+wok = N.wait_pipe(P + 'wp_missing_zzz', 200)
+we = N.last_error()
+print('  wait_pipe(missing,200) ok=%s err=%d(%s) elapsed=%.3f' % (wok, we, en(we), time.time() - t0))
+
+# release the instance and see whether a waiting client succeeds
+def releaser():
+    time.sleep(0.3)
+    N.close(cb1)
+    N.disconnect(hb)
+
+threading.Thread(target=releaser, daemon=True).start()
+t0 = time.time()
+wok = N.wait_pipe(bname, 2000)
+we = N.last_error()
+print('  wait_pipe(2000) after release ok=%s err=%d(%s) elapsed=%.3f' % (wok, we, en(we), time.time() - t0))
+cb3 = N.open_pipe(bname)
+print('  client after release valid=%s err=%d(%s)' % (N.is_valid(cb3), N.last_error(), en(N.last_error())))
+
+print('== peek / read after peer close ==')
+N.close(cb3)
+time.sleep(0.2)
+try:
+    print('  peek=%d' % N.peek(hb))
+except OSError as ex:
+    print('  peek raised winerror=%s(%s)' % (ex.winerror, en(ex.winerror)))
+try:
+    d = N.read(hb, 100)
+    print('  read=%r' % d)
+except OSError as ex:
+    print('  read raised winerror=%s(%s)' % (ex.winerror, en(ex.winerror)))
+
+for h in (h1, h2, c, hb):
+    N.close(h)
+print('done')
diff --git a/_scratch/exp10.py b/_scratch/exp10.py
new file mode 100644
index 0000000..8bd1a76
--- /dev/null
+++ b/_scratch/exp10.py
@@ -0,0 +1,77 @@
+import os
+import sys
+import threading
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from winpipe import native as N
+
+P = N.PIPE_PREFIX
+
+
+def watchdog(seconds, tag):
+    def boom():
+        time.sleep(seconds)
+        print('  !! WATCHDOG %s hung > %ss' % (tag, seconds), flush=True)
+        os._exit(2)
+    threading.Thread(target=boom, daemon=True).start()
+
+
+def scenario(tag, closer):
+    """服务端先写数据并关闭，客户端在关闭之后才读。"""
+    print('== %s (client reads AFTER server close) ==' % tag, flush=True)
+    name = P + 'wp_q_%s_%d' % (tag, int(time.time() * 1000) % 100000)
+    h = N.create_pipe(name, instances=1)
+    c = N.open_pipe(name)
+    N.connect(h)
+    N.write(h, b'\x05\x00\x00\x00hello')
+    N.write(h, b'\x03\x00\x00\x00abc')
+    closer(h)
+    print('   closed', flush=True)
+    for i in (1, 2):
+        try:
+            print('   client read#%d -> %r' % (i, N.read(c, 4096)), flush=True)
+        except OSError as ex:
+            print('   client read#%d -> OSError %s' % (i, ex.winerror), flush=True)
+    N.close(c)
+
+
+def close_plain(h):
+    N.close(h)
+
+
+def close_disconnect(h):
+    N.disconnect(h)
+    N.close(h)
+
+
+watchdog(40, 'all')
+scenario('A_closehandle_only', close_plain)
+scenario('B_disconnect_close', close_disconnect)
+
+print('== C: does the pipe name get released by CloseHandle only? ==', flush=True)
+name = P + 'wp_rel_%d' % (int(time.time() * 1000) % 100000)
+h = N.create_pipe(name, instances=1, first_instance=True)
+c = N.open_pipe(name)
+N.connect(h)
+N.close(c)
+N.close(h)
+h2 = N.create_pipe(name, instances=1, first_instance=True)
+print('   recreate with FIRST_PIPE_INSTANCE valid=%s err=%s' % (N.is_valid(h2), N.last_error()), flush=True)
+N.close(h2)
+
+print('== D: client-side close, unread client->server data ==', flush=True)
+name = P + 'wp_d2_%d' % (int(time.time() * 1000) % 100000)
+h = N.create_pipe(name, instances=1)
+c = N.open_pipe(name)
+N.connect(h)
+N.write(c, b'\x05\x00\x00\x00hello')
+N.close(c)
+time.sleep(0.3)
+try:
+    print('   server read -> %r' % N.read(h, 4096), flush=True)
+except OSError as ex:
+    print('   server read -> OSError %s' % ex.winerror, flush=True)
+N.close(h)
+print('done', flush=True)
+os._exit(0)
