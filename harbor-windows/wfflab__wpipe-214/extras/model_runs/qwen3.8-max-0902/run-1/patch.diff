+import os
+import sys
+import threading
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from winpipe import native as N
+
+P = N.PIPE_PREFIX
+CODES = {109: 'BROKEN_PIPE', 230: 'BAD_PIPE', 232: 'NO_DATA',
+         233: 'PIPE_NOT_CONNECTED', 995: 'OPERATION_ABORTED', 535: 'PIPE_CONNECTED'}
+
+
+def en(c):
+    return CODES.get(c, str(c))
+
+
+def watchdog(seconds, tag):
+    def boom():
+        time.sleep(seconds)
+        print('  !! WATCHDOG: %s hung > %ss' % (tag, seconds), flush=True)
+        os._exit(2)
+    t = threading.Thread(target=boom, daemon=True)
+    t.start()
+    return t
+
+
+print('== A: blocked server read, client closes ==', flush=True)
+watchdog(10, 'A')
+name = P + 'wp_a_%d' % os.getpid()
+h = N.create_pipe(name, instances=1)
+c = N.open_pipe(name)
+N.connect(h)
+out = []
+
+
+def reader(hh, out):
+    t0 = time.time()
+    try:
+        out.append(('data', N.read(hh, 4096), time.time() - t0))
+    except OSError as ex:
+        out.append(('err', ex.winerror, en(ex.winerror), time.time() - t0))
+
+
+t = threading.Thread(target=reader, args=(h, out), daemon=True)
+t.start()
+time.sleep(0.3)
+N.close(c)
+t.join(5)
+print('  reader=%r alive=%s' % (out, t.is_alive()), flush=True)
+N.close(h)
+
+print('== B: blocked server read, server disconnect+close ==', flush=True)
+watchdog(10, 'B')
+name = P + 'wp_b_%d' % os.getpid()
+h = N.create_pipe(name, instances=1)
+c = N.open_pipe(name)
+N.connect(h)
+out2 = []
+t2 = threading.Thread(target=reader, args=(h, out2), daemon=True)
+t2.start()
+time.sleep(0.3)
+print('  calling disconnect...', flush=True)
+N.disconnect(h)
+print('  disconnect returned err=%s' % en(N.last_error()), flush=True)
+print('  calling close...', flush=True)
+N.close(h)
+print('  close returned', flush=True)
+t2.join(5)
+print('  reader=%r alive=%s' % (out2, t2.is_alive()), flush=True)
+N.close(c)
+
+print('== C: blocked server read, only client-side handle closed (no server close) ==', flush=True)
+watchdog(10, 'C')
+name = P + 'wp_c_%d' % os.getpid()
+h = N.create_pipe(name, instances=1)
+c = N.open_pipe(name)
+N.connect(h)
+out3 = []
+t3 = threading.Thread(target=reader, args=(h, out3), daemon=True)
+t3.start()
+time.sleep(0.3)
+N.disconnect(h)
+t3.join(5)
+print('  reader=%r alive=%s' % (out3, t3.is_alive()), flush=True)
+N.close(h)
+N.close(c)
+print('done', flush=True)
