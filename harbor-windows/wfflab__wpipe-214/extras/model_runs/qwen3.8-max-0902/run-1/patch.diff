+"""管道名的规范化与校验。
+
+管道名的**规范形式**是 ``\\\\.\\pipe\\<name>``：
+
+- ``foo`` 与 ``\\\\.\\pipe\\foo`` 指同一个管道，前者会被补全成后者；
+- 管道名大小写不敏感，但前缀统一规范化为小写的 ``\\\\.\\pipe\\``；
+- 名字为空、在规范前缀之外还含有 ``/`` 或 ``\\``、或含有码位小于 ``0x20``
+  的控制字符时，都是非法名字（``WPipeError(kind="name")``）。
+
+本模块不碰任何 Win32 句柄，只做纯字符串处理。
+"""
+
+from __future__ import annotations
+
+from . import native
+from .errors import WPipeError
+
+__all__ = ["PIPE_PREFIX", "normalize_name", "resolve_name"]
+
+PIPE_PREFIX = native.PIPE_PREFIX
+_PREFIX_UPPER = PIPE_PREFIX.upper()
+
+
+def _as_text(name):
+    if isinstance(name, str):
+        return name
+    if name is None:
+        return ""
+    if isinstance(name, (bytes, bytearray)):
+        try:
+            return bytes(name).decode("utf-8")
+        except UnicodeDecodeError:
+            return repr(bytes(name))
+    return str(name)
+
+
+def _strip_prefix(name):
+    """去掉已经写好的 ``\\\\.\\pipe\\`` 前缀（大小写不敏感）。"""
+    if len(name) >= len(PIPE_PREFIX) and name[: len(PIPE_PREFIX)].upper() == _PREFIX_UPPER:
+        return name[len(PIPE_PREFIX):]
+    return None
+
+
+def resolve_name(name):
+    """把 ``foo`` 形态补全为 ``\\\\.\\pipe\\foo``（**不做**合法性校验）。
+
+    客户端用它即可：真正的校验交给 ``CreateFile``，失败按 ``kind="connection"``
+    分类。
+    """
+    text = _as_text(name)
+    bare = _strip_prefix(text)
+    if bare is None:
+        bare = text
+    return PIPE_PREFIX + bare
+
+
+def normalize_name(name):
+    """校验并规范化管道名，返回 ``\\\\.\\pipe\\<name>`` 形式。
+
+    非法名字抛 ``WPipeError(kind="name")``。
+    """
+    if not isinstance(name, (str, bytes, bytearray)):
+        raise WPipeError("name", "pipe name must be a str, got %s" % type(name).__name__)
+    text = _as_text(name)
+    bare = _strip_prefix(text)
+    if bare is None:
+        bare = text
+    if not bare:
+        raise WPipeError("name", "empty pipe name: %r" % (name,))
+    for ch in bare:
+        if ch == "/" or ch == "\\":
+            raise WPipeError("name",
+                             "illegal separator %r in pipe name %r" % (ch, name))
+        if ord(ch) < 0x20:
+            raise WPipeError("name",
+                             "control character U+%04X in pipe name %r" % (ord(ch), name))
+    return PIPE_PREFIX + bare
