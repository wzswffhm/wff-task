@@ -0,0 +1,118 @@
+"""Experiment 2: EOF error codes, instance reuse, wait/release, write blocking threshold."""
+import os
+import sys
+import threading
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from winpipe import native as N
+
+P = N.PIPE_PREFIX
+CODES = {2: 'FILE_NOT_FOUND', 3: 'PATH_NOT_FOUND', 5: 'ACCESS_DENIED',
+         109: 'BROKEN_PIPE', 121: 'SEM_TIMEOUT', 123: 'INVALID_NAME',
+         183: 'ALREADY_EXISTS', 230: 'BAD_PIPE', 231: 'PIPE_BUSY',
+         232: 'NO_DATA', 233: 'PIPE_NOT_CONNECTED', 535: 'PIPE_CONNECTED'}
+
+
+def en(c):
+    return CODES.get(c, str(c))
+
+
+def show(label, fn):
+    try:
+        print('  %s -> %r' % (label, fn()))
+    except OSError as ex:
+        print('  %s -> OSError winerror=%s(%s) errno=%s' % (label, ex.winerror, en(ex.winerror), ex.errno))
+
+
+print('== EOF codes after client close (server never disconnected) ==')
+name = P + 'wp_eof_%d' % os.getpid()
+h = N.create_pipe(name, instances=1)
+c = N.open_pipe(name)
+print('  accept ok=%s err=%s' % (N.connect(h), en(N.last_error())))
+N.write(c, b'hello')
+print('  server read=%r' % N.read(h, 4096))
+print('  peek=%d' % N.peek(h))
+N.close(c)
+time.sleep(0.2)
+show('read after client close', lambda: N.read(h, 4096))
+show('peek after client close', lambda: N.peek(h))
+show('read again', lambda: N.read(h, 4096))
+
+print('== instance reuse: disconnect then accept a new client ==')
+N.disconnect(h)
+print('  disconnect err=%s' % en(N.last_error()))
+res = {}
+
+
+def newclient():
+    time.sleep(0.3)
+    res['h'] = N.open_pipe(name)
+    res['err'] = N.last_error()
+
+
+t = threading.Thread(target=newclient, daemon=True)
+t.start()
+ok = N.connect(h)
+print('  accept#2 ok=%s err=%s' % (ok, en(N.last_error())))
+t.join(2)
+print('  new client valid=%s err=%s' % (N.is_valid(res.get('h')), en(res.get('err', 0))))
+if N.is_valid(res.get('h')):
+    N.write(res['h'], b'again')
+    print('  server read=%r' % N.read(h, 4096))
+
+print('== WaitNamedPipe wakes when instance is released ==')
+bname = P + 'wp_wait_%d' % os.getpid()
+hb = N.create_pipe(bname, instances=1)
+cb1 = N.open_pipe(bname)
+print('  ConnectNamedPipe ok=%s err=%s' % (N.connect(hb), en(N.last_error())))
+cb2 = N.open_pipe(bname)
+print('  second client valid=%s err=%s' % (N.is_valid(cb2), en(N.last_error())))
+
+
+def release():
+    time.sleep(0.4)
+    N.close(cb1)
+    N.disconnect(hb)
+
+
+threading.Thread(target=release, daemon=True).start()
+t0 = time.time()
+wok = N.wait_pipe(bname, 3000)
+we = N.last_error()
+print('  wait_pipe(3000) ok=%s err=%s elapsed=%.3f' % (wok, we, en(we), time.time() - t0))
+cb3 = N.open_pipe(bname)
+print('  client3 valid=%s err=%s' % (N.is_valid(cb3), en(N.last_error())))
+N.close(cb3)
+N.close(hb)
+N.close(h)
+if N.is_valid(res.get('h')):
+    N.close(res['h'])
+
+print('== single-thread write threshold with buffer_size=4096 ==')
+wname = P + 'wp_thr_%d' % os.getpid()
+hw = N.create_pipe(wname, instances=1, buffer_size=4096)
+cw = N.open_pipe(wname)
+N.connect(hw)
+for size in (1000, 4000, 4096, 4200, 8192, 16384, 65536, 70000):
+    done = []
+    th = threading.Thread(target=lambda s=size: done.append(N.write(cw, b'B' * s)), daemon=True)
+    th.start()
+    th.join(0.4)
+    blocked = th.is_alive()
+    got = bytearray()
+    while True:
+        try:
+            avail = N.peek(hw)
+        except OSError:
+            avail = 0
+        if not avail:
+            break
+        got.extend(N.read(hw, min(avail, 1 << 20)))
+        if len(got) >= size:
+            break
+    th.join(2)
+    print('  size=%6d blocked=%s drained=%d' % (size, blocked, len(got)))
+N.close(cw)
+N.close(hw)
+print('done')
