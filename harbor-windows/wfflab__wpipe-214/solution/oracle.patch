diff --git a/winpipe/framing.py b/winpipe/framing.py
new file mode 100644
index 0000000..67b5756
--- /dev/null
+++ b/winpipe/framing.py
@@ -0,0 +1,54 @@
+"""长度前缀分帧（4 字节小端长度 + payload）。"""
+
+from __future__ import annotations
+
+import struct
+
+__all__ = ["HEADER_SIZE", "FrameDecoder", "pack_frame"]
+
+HEADER_SIZE = 4
+_MAX_PAYLOAD = 0xFFFFFFFF
+
+
+def pack_frame(payload):
+    """把 payload 打包成一帧（4 字节小端长度 + payload）。"""
+    if isinstance(payload, str):
+        payload = payload.encode("utf-8")
+    if len(payload) > _MAX_PAYLOAD:
+        raise ValueError("payload too large to frame")
+    return struct.pack("<I", len(payload)) + payload
+
+
+class FrameDecoder:
+    """累积字节流，并按长度前缀切出完整帧。
+
+    字节模式下管道不保留写入边界：一个帧可能跨多次读到达，多个帧也可能
+    在一次读里一起到达。因此接收端必须自己缓冲并切分。
+    """
+
+    def __init__(self, max_payload=_MAX_PAYLOAD):
+        self._buffer = bytearray()
+        self._max_payload = max_payload
+
+    def feed(self, chunk):
+        """把一段新到达的字节追加进缓冲区。"""
+        if chunk:
+            self._buffer.extend(chunk)
+
+    def pop(self):
+        """取出一个完整帧；不足一帧时返回 ``None``。"""
+        if len(self._buffer) < HEADER_SIZE:
+            return None
+        (length,) = struct.unpack_from("<I", self._buffer, 0)
+        if length > self._max_payload:
+            raise ValueError("declared frame length %d exceeds limit" % length)
+        if len(self._buffer) < HEADER_SIZE + length:
+            return None
+        end = HEADER_SIZE + length
+        payload = bytes(self._buffer[HEADER_SIZE:end])
+        del self._buffer[:end]
+        return payload
+
+    def pending(self):
+        """缓冲区中尚未构成完整帧的字节数。"""
+        return len(self._buffer)
