+_EOL_BROKEN = (native.ERROR_BROKEN_PIPE, native.ERROR_NO_DATA)
+
+
+def _validate_name(name):
+    """校验并规范化管道名，返回 ``\\\\.\\pipe\\<name>`` 形式。"""
+    if not isinstance(name, str) or not name:
+        raise WPipeError("name", "pipe name must be a non-empty string")
+    probe = name
+    if probe.startswith(native.PIPE_PREFIX):
+        probe = probe[len(native.PIPE_PREFIX):]
+    if not probe:
+        raise WPipeError("name", "pipe name must not be empty")
+    for ch in probe:
+        if ch in ("/", "\\") or ord(ch) < 0x20:
+            raise WPipeError("name", "illegal character in pipe name: %r" % (name,))
+    return native.PIPE_PREFIX + probe
+
 
