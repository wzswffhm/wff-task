+def _well_known_powershell():
+    """返回 Windows PowerShell 的默认安装路径，找不到时返回 ``None``。"""
+    root = os.environ.get("SystemRoot") or os.environ.get("windir")
+    if not root:
+        return None
+    candidate = os.path.join(
+        root, "System32", "WindowsPowerShell", "v1.0", POWERSHELL
+    )
+    if os.path.isfile(candidate):
+        return candidate
+    return None
+
