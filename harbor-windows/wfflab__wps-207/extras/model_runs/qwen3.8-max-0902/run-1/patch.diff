+        "    $__wjobExitCode = [int]$__wjobLastExit",
+        "} elseif (($Error.Count - $__wjobErrorBase) -gt 0) {",
+        "    $__wjobExitCode = %d" % ERROR_EXIT_CODE,
+        "}",
+        "exit $__wjobExitCode",
