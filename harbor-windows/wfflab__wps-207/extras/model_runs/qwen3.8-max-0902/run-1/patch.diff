+def _wrap(body):
+    """把 ``body`` 包进一段能如实汇报退出码的脚本。"""
+    text = ("" if body is None else str(body)).strip("\n")
+    return "\n".join((_PRELUDE, "& {", text, "}", _EPILOGUE)) + "\n"
