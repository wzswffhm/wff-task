+"""Temporary verification #2 (deleted before submit)."""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import wjob.psrun as psrun
+from wjob import run_script
+
+PS51 = r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
+
+CASES = [
+    ("warning", "Write-Warning 'careful'", 0),
+    ("verbose", "Write-Verbose 'vv' -Verbose", 0),
+    ("information", "Write-Information 'ii' -InformationAction Continue", 0),
+    ("host", "Write-Host 'hh'", 0),
+    ("silentlycontinue", "Get-Process __nosuch__ -ErrorAction SilentlyContinue", 0),
+    ("test-path", "Write-Output (Test-Path 'C:\\__nope__')", 0),
+    ("handled", "try { Get-Item 'C:\\__nope__' -ErrorAction Stop } catch { Write-Output 'handled' }", None),
+    ("native-ok-then-err", "cmd /c exit 0\nWrite-Error 'late'", 1),
+    ("err-then-native-ok", "Write-Error 'early'\ncmd /c exit 0", 1),
+    ("progress", "$p = 1..3 | ForEach-Object { $_ }; Write-Output ($p -join ',')", 0),
+    ("pipeline-objects", "Get-ChildItem Env: | Select-Object -First 1 | ForEach-Object Name", 0),
+    ("dollar-question", "Write-Output $?", 0),
+    ("out-null", "Get-Item 'C:\\__nope__' | Out-Null", None),
+    ("select-string-none", "Write-Output ('abc' | Select-String 'zzz')", 0),
+]
+
+for exe in [None, PS51]:
+    if exe:
+        if not os.path.exists(exe):
+            continue
+        psrun.find_powershell = lambda: exe
+    psrun._encoding_cache = None
+    print("=" * 20, psrun.find_powershell())
+    for name, script, expected in CASES:
+        r = run_script(script)
+        flag = "?" if expected is None else ("OK" if r.exit_code == expected else "FAIL")
+        print("%-4s %-20s rc=%-4s out=%-24r err=%r"
+              % (flag, name, r.exit_code, r.stdout.strip()[:24], r.stderr.strip()[:70]))
