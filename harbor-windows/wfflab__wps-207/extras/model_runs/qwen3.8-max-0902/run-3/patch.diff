+"""Temporary experiment script (deleted before submit)."""
+import base64
+import subprocess
+
+PS51 = r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
+PS7 = r"C:\Users\Administrator\.cache\codex-runtimes\codex-primary-runtime\dependencies\native\powershell\pwsh.exe"
+
+BASE = ["-NoLogo", "-NoProfile", "-NonInteractive"]
+
+
+def run(exe, args, label):
+    p = subprocess.run([exe] + BASE + args, capture_output=True)
+    print("---", label, exe.split("\\")[-1])
+    print("rc=", p.returncode)
+    print("out=", p.stdout.decode("utf-8", "replace")[:400])
+    print("err=", p.stderr.decode("utf-8", "replace")[:400])
+
+
+for exe in (PS51, PS7):
+    run(exe, ["-Command", "cmd /c exit 3"], "native exit 3")
+    run(exe, ["-Command", "Write-Error 'boom'"], "write-error")
+    run(exe, ["-Command", "Get-Item C:\\nope\\missing.txt"], "missing path")
+    run(exe, ["-Command", "throw 'kaboom'"], "throw")
+    run(exe, ["-Command", "& { exit 7 }"], "scriptblock exit 7")
+    run(exe, ["-Command", "exit 300"], "exit 300")
+    run(exe, ["-Command", "Write-Output 'hello'"], "hello")
+    run(exe, ["-Command", "[Console]::Error.WriteLine('oops')"], "console err")
+    b64 = base64.b64encode("Write-Output 'from-b64'; cmd /c exit 4".encode("utf-8")).decode()
+    wrapper = (
+        "$t=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('%s'));"
+        "$sb=[scriptblock]::Create($t);"
+        "$code=0;try{ & $sb }catch{ $code=1; Write-Error $_.Exception.Message };"
+        "if($LASTEXITCODE){ $code=$LASTEXITCODE } elseif($Error.Count -gt 0 -and $code -eq 0){ $code=1 };"
+        "exit $code" % b64
+    )
+    run(exe, ["-Command", wrapper], "b64 wrapper native exit 4")
+    b64b = base64.b64encode("Write-Error 'b64boom'; Write-Output 'still-here'".encode("utf-8")).decode()
+    wrapper2 = wrapper.replace(b64, b64b)
+    run(exe, ["-Command", wrapper2], "b64 wrapper write-error")
+    b64c = base64.b64encode("Write-Output 'ok-only'".encode("utf-8")).decode()
+    wrapper3 = wrapper.replace(b64, b64c)
+    run(exe, ["-Command", wrapper3], "b64 wrapper success")
