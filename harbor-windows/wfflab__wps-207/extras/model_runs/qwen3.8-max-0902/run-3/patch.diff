+"""Temporary pytest-style verification (deleted before submit)."""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wjob import run_file, run_script
+
+
+def test_native_exit_code():
+    assert run_script("cmd /c exit 3").exit_code == 3
+
+
+def test_non_terminating_error():
+    r = run_script("Write-Error 'boom'")
+    assert r.exit_code != 0
+    assert not r.ok
+    assert "boom" in (r.stderr + r.stdout)
+
+
+def test_missing_path():
+    r = run_script("Get-Item 'C:\\__nope__\\x.txt'")
+    assert r.exit_code != 0
+    assert r.stderr.strip()
+
+
+def test_success():
+    r = run_script("Write-Output 'hello'")
+    assert r.exit_code == 0
+    assert r.ok is True
+    assert r.stdout.strip() == "hello"
+
+
+def test_run_file(tmp_path):
+    p = tmp_path / "step.ps1"
+    p.write_text("cmd /c exit 5\n", encoding="utf-8")
+    assert run_file(str(p)).exit_code == 5
+
+
+def test_run_file_ok(tmp_path):
+    p = tmp_path / "step.ps1"
+    p.write_text("Write-Output 'file-ok'\n", encoding="utf-8")
+    r = run_file(str(p))
+    assert r.exit_code == 0
+    assert r.stdout.strip() == "file-ok"
+
+
+def test_stdin_capture_does_not_hang():
+    r = run_script("Write-Output ($null -eq $input)")
+    assert r.exit_code == 0
