@@ -0,0 +1,235 @@
+"""Temporary verification script (deleted before submit)."""
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import wjob.psrun as psrun
+from wjob import PSJob, PSResult, environment_info, find_powershell, run_file, run_script
+from wjob.psrun import _decode
+
+PS51 = r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
+DEFAULT = find_powershell()
+
+failures = []
+
+
+def check(label, cond, detail=""):
+    print("%-4s %-46s %s" % ("OK" if cond else "FAIL", label, detail))
+    if not cond:
+        failures.append("%s [%s]" % (label, psrun.find_powershell()))
+
+
+def run_all():
+    # 1. native exit code
+    r = run_script("cmd /c exit 3")
+    check("native exit 3", r.exit_code == 3, "rc=%s ok=%s" % (r.exit_code, r.ok))
+    check("native exit 3 -> not ok", r.ok is False)
+
+    r = run_script("cmd /c exit 3\nWrite-Output 'done'")
+    check("native exit 3 then output", r.exit_code == 3 and r.stdout.strip() == "done",
+          "rc=%s out=%r" % (r.exit_code, r.stdout))
+
+    r = run_script("cmd /c exit 0")
+    check("native exit 0", r.exit_code == 0 and r.ok)
+
+    r = run_script("cmd /c exit 12")
+    check("native exit 12", r.exit_code == 12, "rc=%s" % r.exit_code)
+
+    # 2. non terminating errors
+    r = run_script("Write-Error 'boom'")
+    check("Write-Error nonzero", r.exit_code != 0, "rc=%s" % r.exit_code)
+    check("Write-Error message captured", "boom" in (r.stderr + r.stdout),
+          "stderr=%r" % r.stderr[:120])
+    check("Write-Error stderr non-empty", r.stderr.strip() != "")
+
+    r = run_script("Get-Item 'C:\\__wjob_missing__\\nope.txt'")
+    check("missing path nonzero", r.exit_code != 0, "rc=%s" % r.exit_code)
+    check("missing path stderr", r.stderr.strip() != "", "stderr=%r" % r.stderr[:120])
+    check("missing path mentions path", "nope.txt" in r.stderr)
+
+    r = run_script("Get-ChildItem 'C:\\__wjob_missing__'")
+    check("missing dir nonzero", r.exit_code != 0, "rc=%s" % r.exit_code)
+
+    r = run_script("$ErrorActionPreference='Stop'; Get-Item 'C:\\__wjob_missing__\\nope.txt'")
+    check("ErrorActionPreference=Stop nonzero", r.exit_code != 0, "rc=%s" % r.exit_code)
+
+    r = run_script("Write-Error 'e-one'\nWrite-Error 'e-two'")
+    check("multiple errors", r.exit_code != 0 and "e-one" in r.stderr and "e-two" in r.stderr,
+          "rc=%s stderr=%r" % (r.exit_code, r.stderr[:200]))
+
+    # terminating error
+    r = run_script("throw 'kaboom'")
+    check("throw nonzero", r.exit_code != 0, "rc=%s" % r.exit_code)
+    check("throw message captured", "kaboom" in (r.stderr + r.stdout), "stderr=%r" % r.stderr[:120])
+
+    r = run_script("Write-Output 'before'\nthrow 'mid'\nWrite-Output 'after'")
+    check("throw mid-script", r.exit_code != 0 and "before" in r.stdout and "mid" in r.stderr,
+          "rc=%s out=%r err=%r" % (r.exit_code, r.stdout[:40], r.stderr[:60]))
+
+    r = run_script("$null = [int]::Parse('not-a-number')")
+    check("method exception", r.exit_code != 0, "rc=%s" % r.exit_code)
+
+    r = run_script("Write-Output 'a'\nif ( { }")
+    check("syntax error", r.exit_code != 0, "rc=%s stderr=%r" % (r.exit_code, r.stderr[:80]))
+
+    # explicit exit
+    r = run_script("exit 2")
+    check("exit 2", r.exit_code == 2, "rc=%s" % r.exit_code)
+
+    # 3. success stays successful
+    r = run_script("Write-Output 'hello'")
+    check("hello exit 0", r.exit_code == 0 and r.ok is True)
+    check("hello stdout", r.stdout.strip() == "hello", "out=%r" % r.stdout)
+    check("hello output prop", r.output == "hello")
+    check("hello stderr empty", r.stderr == "", "stderr=%r" % r.stderr)
+    check("repr mentions exit_code", "exit_code" in repr(r), repr(r))
+
+    r = run_script("Write-Output 'a'\nWrite-Output 'b'")
+    check("multiline stdout", r.stdout == "a\nb\n", "out=%r" % r.stdout)
+
+    r = run_script("$x = 21 * 2\nWrite-Output $x")
+    check("variables work", r.stdout.strip() == "42", "out=%r" % r.stdout)
+
+    r = run_script("function Get-Double { param($v) $v * 2 }\nWrite-Output (Get-Double 4)")
+    check("function works", r.stdout.strip() == "8", "out=%r" % r.stdout)
+
+    r = run_script("param([int]$n = 5)\nWrite-Output $n")
+    check("param block works", r.stdout.strip() == "5", "out=%r" % r.stdout)
+
+    r = run_script("Write-Output \"it's quoted\"")
+    check("quotes survive", r.stdout.strip() == "it's quoted", "out=%r" % r.stdout)
+
+    r = run_script("Write-Output '\u4f60\u597d\u4e16\u754c'")
+    check("unicode stdout", r.stdout.strip() == "\u4f60\u597d\u4e16\u754c",
+          "out=%r" % r.stdout.encode("unicode_escape")[:60])
+
+    r = run_script("Write-Error '\u5931\u8d25 boom'")
+    check("unicode stderr", "boom" in r.stderr, "stderr=%r" % r.stderr.encode("unicode_escape")[:160])
+
+    r = run_script("Write-Host 'to-host'")
+    check("write-host to stdout", r.stdout.strip() == "to-host", "out=%r" % r.stdout)
+
+    r = run_script("cmd /c 'echo warning 1>&2'")
+    check("native stderr captured", "warning" in r.stderr, "stderr=%r" % r.stderr[:80])
+
+    r = run_script("cmd /c 'echo failed 1>&2 & exit 6'")
+    check("native stderr + code", r.exit_code == 6 and "failed" in r.stderr,
+          "rc=%s stderr=%r" % (r.exit_code, r.stderr[:80]))
+
+    r = run_script("")
+    check("empty script", r.exit_code == 0 and r.stdout == "", "rc=%s out=%r" % (r.exit_code, r.stdout))
+
+    r = run_script("\ufeffWrite-Output 'bom-ok'")
+    check("BOM stripped", r.exit_code == 0 and r.stdout.strip() == "bom-ok",
+          "rc=%s out=%r" % (r.exit_code, r.stdout))
+
+    r = run_script("Get-ChildItem Env: | Select-Object -First 2 | Format-Table -AutoSize")
+    check("formatted objects", r.exit_code == 0 and "Name" in r.stdout, "out=%r" % r.stdout[:60])
+
+    big = "Write-Output 'long-ok'\n" + "# padding line to make this script huge\n" * 8000
+    r = run_script(big)
+    check("very long script", r.exit_code == 0 and r.stdout.strip() == "long-ok",
+          "rc=%s out=%r len=%d" % (r.exit_code, r.stdout[:20], len(big)))
+
+    # 4. run_file
+    tmpdir = tempfile.mkdtemp()
+    paths = {}
+    for name, body in [
+        ("ok.ps1", "Write-Output 'from-file'\n"),
+        ("native.ps1", "cmd /c exit 5\n"),
+        ("err.ps1", "Write-Error 'fileboom'\n"),
+        ("exit.ps1", "exit 9\n"),
+        ("throw.ps1", "throw 'filethrow'\n"),
+        ("mixed.ps1", "$v = 6 * 7\nWrite-Output $v\nWrite-Error 'late'\n"),
+        ("spaced file.ps1", "Write-Output 'spaced ok'\n"),
+        ("uni.ps1", "Write-Output '\u4f60\u597d'\n"),
+        ("quote's.ps1", "Write-Output 'quoted ok'\n"),
+    ]:
+        p = os.path.join(tmpdir, name)
+        with open(p, "w", encoding="utf-8") as fh:
+            fh.write(body)
+        paths[name] = p
+
+    r = run_file(paths["ok.ps1"])
+    check("run_file ok", r.exit_code == 0 and r.stdout.strip() == "from-file",
+          "rc=%s out=%r" % (r.exit_code, r.stdout))
+
+    r = run_file(paths["native.ps1"])
+    check("run_file native exit", r.exit_code == 5, "rc=%s" % r.exit_code)
+
+    r = run_file(paths["err.ps1"])
+    check("run_file write-error", r.exit_code != 0 and "fileboom" in (r.stderr + r.stdout),
+          "rc=%s stderr=%r" % (r.exit_code, r.stderr[:120]))
+
+    r = run_file(paths["exit.ps1"])
+    check("run_file exit 9", r.exit_code == 9, "rc=%s" % r.exit_code)
+
+    r = run_file(paths["throw.ps1"])
+    check("run_file throw", r.exit_code != 0 and "filethrow" in (r.stderr + r.stdout),
+          "rc=%s stderr=%r" % (r.exit_code, r.stderr[:120]))
+
+    r = run_file(paths["mixed.ps1"])
+    check("run_file mixed", r.exit_code != 0 and r.stdout.strip() == "42",
+          "rc=%s out=%r stderr=%r" % (r.exit_code, r.stdout, r.stderr[:80]))
+
+    r = run_file(paths["spaced file.ps1"])
+    check("run_file path with space", r.exit_code == 0 and r.stdout.strip() == "spaced ok",
+          "rc=%s out=%r" % (r.exit_code, r.stdout))
+
+    r = run_file(paths["quote's.ps1"])
+    check("run_file path with quote", r.exit_code == 0 and r.stdout.strip() == "quoted ok",
+          "rc=%s out=%r" % (r.exit_code, r.stdout))
+
+    r = run_file(paths["uni.ps1"])
+    check("run_file unicode", r.stdout.strip() == "\u4f60\u597d",
+          "out=%r" % r.stdout.encode("unicode_escape")[:40])
+
+    r = run_file(os.path.join(tmpdir, "does-not-exist.ps1"))
+    check("run_file missing file", r.exit_code != 0, "rc=%s" % r.exit_code)
+
+    import pathlib
+    r = run_file(pathlib.Path(paths["ok.ps1"]))
+    check("run_file pathlib", r.exit_code == 0 and r.stdout.strip() == "from-file",
+          "rc=%s" % r.exit_code)
+
+    # PSJob / PSResult
+    job = PSJob("cmd /c exit 3", name="publish")
+    r = job.run(run_script)
+    check("PSJob run", r.exit_code == 3 and not r.ok, "rc=%s" % r.exit_code)
+
+    res = PSResult(0, "x\n", "")
+    check("PSResult ok", res.ok is True and res.exit_code == 0 and res.output == "x")
+    res = PSResult(3, "", "bad")
+    check("PSResult failed", res.ok is False and res.stderr == "bad")
+
+    check("environment_info", bool(environment_info()["powershell"]))
+
+    # timeout still surfaces
+    t0 = time.time()
+    try:
+        run_script("Start-Sleep -Seconds 10", timeout=2)
+        check("timeout raises", False)
+    except subprocess.TimeoutExpired:
+        check("timeout raises", True, "elapsed=%.1fs" % (time.time() - t0))
+
+
+print("=" * 70)
+print("default powershell:", DEFAULT)
+run_all()
+
+if os.path.exists(PS51) and os.path.normcase(PS51) != os.path.normcase(DEFAULT):
+    print("=" * 70)
+    print("forcing Windows PowerShell 5.1:", PS51)
+    psrun.find_powershell = lambda: PS51
+    psrun._encoding_cache = None
+    run_all()
+
+print()
+print("decode helpers:", repr(_decode(b"")), repr(_decode("abc\r\nd".encode("utf-8"))),
+      repr(_decode("\u4f60\u597d".encode("cp936"))), repr(_decode("\u4f60\u597d".encode("utf-8"))))
+print("failures:", failures)
+sys.exit(1 if failures else 0)
