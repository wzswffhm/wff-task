+    ("func-exit", "function f { exit 4 }\nf\nWrite-Output 'after'"),
+    ("exit0-after-err", "Write-Error 'x'\nexit 0"),
+    ("host-write", "Write-Host 'to-host'"),
+    ("big-obj", "Get-ChildItem Env: | Select-Object -First 2 | Format-Table -AutoSize"),
+    ("stderr-native", "cmd /c 'echo warn 1>&2'"),
+    ("console-err", "[Console]::Error.WriteLine('oops')"),
+    ("nested", "$sb = { Write-Output 'inner' }\n& $sb"),
+    ("long", "Write-Output 'x'\n" + "# comment line padding\n" * 3000),
+]
+
+for exe in (PS51, PS7):
+    print("=" * 25, exe.rsplit("\\", 1)[-1])
+    for name, text in CASES:
+        cmd = build(text)
+        p = subprocess.run([exe] + BASE + ["-Command", cmd], capture_output=True)
+        out = p.stdout.decode("utf-8", "replace").replace("\r\n", "\n")
