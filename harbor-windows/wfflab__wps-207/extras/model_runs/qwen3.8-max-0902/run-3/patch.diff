+"""Temporary experiment script #3 (deleted before submit)."""
+import base64
+import os
+import subprocess
+import tempfile
+
+PS51 = r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
+PS7 = r"C:\Users\Administrator\.cache\codex-runtimes\codex-primary-runtime\dependencies\native\powershell\pwsh.exe"
+BASE = ["-NoLogo", "-NoProfile", "-NonInteractive"]
+
+WRAPPER = (
+    "$wjobCode = 0;"
+    "if ($PSVersionTable.PSVersion.Major -ge 7 -and (Test-Path Variable:PSStyle)) {"
+    " try { $PSStyle.OutputRendering = 'PlainText' } catch {} };"
+    "try {"
+    " $wjobText = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String('__B64__'));"
+    " $wjobBlock = [System.Management.Automation.ScriptBlock]::Create($wjobText);"
+    " & $wjobBlock"
+    "} catch {"
+    " $wjobCode = 1;"
+    " $ErrorActionPreference = 'Continue';"
+    " [Console]::Error.WriteLine((($_ | Out-String) -replace \"`r`n\", \"`n\").TrimEnd());"
+    "};"
+    "if ($LASTEXITCODE -ne $null -and $LASTEXITCODE -ne 0) { $wjobCode = [int]$LASTEXITCODE }"
+    " elseif ($wjobCode -eq 0 -and $Error.Count -gt 0) { $wjobCode = 1 };"
+    "exit $wjobCode"
+)
+
+
+def build(text):
+    b64 = base64.b64encode(text.encode("utf-8")).decode("ascii")
+    return WRAPPER.replace("__B64__", b64)
+
+
+CASES = [
+    ("hello", "Write-Output 'hello'"),
+    ("native3", "cmd /c exit 3"),
+    ("native3-then-output", "cmd /c exit 3\nWrite-Output 'done'"),
+    ("native0", "cmd /c exit 0"),
+    ("write-error", "Write-Error 'boom'"),
+    ("missing-path", "Get-Item C:\\nope\\missing.txt"),
+    ("throw", "throw 'kaboom'"),
+    ("exit2", "exit 2"),
+    ("exit-1", "exit -1"),
+    ("multiline-ok", "$a = 21 * 2\nWrite-Output $a\nWrite-Output 'second'"),
+    ("handled", "try { Get-Item C:\\nope -ErrorAction Stop } catch { Write-Output 'handled' }"),
+    ("quotes", "Write-Output \"it's a 'test' with `\"quotes`\"\""),
+    ("param-block", "param([int]$n = 5)\nWrite-Output $n"),
+    ("return-early", "Write-Output 'before'\nreturn\nWrite-Output 'after'"),
+    ("func", "function f { param($x) $x * 2 }\nWrite-Output (f 4)"),
+    ("empty", ""),
+    ("native-stderr", "cmd /c 'echo oops 1>&2 & exit 7'"),
+    ("error-then-native", "Write-Error 'e1'\ncmd /c exit 9"),
+    ("syntax-error", "Write-Output 'a' +"),
+]
+
+for exe in (PS51, PS7):
+    print("=" * 30, os.path.basename(exe))
+    for name, text in CASES:
+        p = subprocess.run([exe] + BASE + ["-Command", build(text)], capture_output=True)
+        out = p.stdout.decode("utf-8", "replace").replace("\r\n", "\n")
+        err = p.stderr.decode("utf-8", "replace").replace("\r\n", "\n")
+        print("%-20s rc=%-6s out=%-24r err=%r" % (name, p.returncode, out[:24], err[:120]))
+
+# run_file style: & '<path>'
+tmpdir = tempfile.mkdtemp()
+good = os.path.join(tmpdir, "good.ps1")
+bad = os.path.join(tmpdir, "bad.ps1")
+nat = os.path.join(tmpdir, "nat.ps1")
+spaced = os.path.join(tmpdir, "with space.ps1")
+open(good, "w", encoding="utf-8").write("Write-Output 'from-file'\n")
+open(bad, "w", encoding="utf-8").write("Write-Error 'fileboom'\n")
+open(nat, "w", encoding="utf-8").write("cmd /c exit 5\n")
+open(spaced, "w", encoding="utf-8").write("Write-Output 'spaced ok'\n")
+
+for exe in (PS51, PS7):
+    print("=" * 30, "run_file", os.path.basename(exe))
+    for path in (good, bad, nat, spaced, os.path.join(tmpdir, "nope.ps1")):
+        text = "& '%s'" % path.replace("'", "''")
+        p = subprocess.run([exe] + BASE + ["-Command", build(text)], capture_output=True)
+        out = p.stdout.decode("utf-8", "replace").replace("\r\n", "\n")
+        err = p.stderr.decode("utf-8", "replace").replace("\r\n", "\n")
+        print("%-22s rc=%-6s out=%-20r err=%r" % (os.path.basename(path), p.returncode, out[:20], err[:100]))
+        pf = subprocess.run([exe] + BASE + ["-File", path], capture_output=True)
+        print("    (-File baseline) rc=%s out=%r err=%r" % (
+            pf.returncode, pf.stdout.decode("utf-8", "replace")[:60], pf.stderr.decode("utf-8", "replace")[:60]))
