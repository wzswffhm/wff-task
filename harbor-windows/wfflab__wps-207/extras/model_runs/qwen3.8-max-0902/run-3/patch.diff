+"""Temporary experiment #6 (deleted before submit)."""
+import subprocess
+
+PS7 = r"C:\Users\Administrator\.cache\codex-runtimes\codex-primary-runtime\dependencies\native\powershell\pwsh.exe"
+PS51 = r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
+BASE = ["-NoLogo", "-NoProfile", "-NonInteractive"]
+
+CASES = {
+    "one-line": "Write-Output 'a'; Write-Output 'b'; exit 4",
+    "two-lines": "Write-Output 'a'\nWrite-Output 'b'",
+    "two-lines-exit": "Write-Output 'a'\nexit 4",
+    "block": "$x = 1\nif ($x -eq 1) {\n  Write-Output 'in-block'\n}\nexit 5",
+    "semicolon-first": "$x = 0; $x = 1\nWrite-Output $x\nexit 6",
+}
+
+for exe in (PS51, PS7):
+    print("=" * 20, exe.rsplit("\\", 1)[-1])
+    for name, text in CASES.items():
+        p = subprocess.run([exe] + BASE + ["-Command", "-"], input=text.encode("ascii"),
+                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        print("%-16s rc=%-4s out=%-24r err=%r" % (name, p.returncode, p.stdout[:24], p.stderr[:60]))
+    # same content via argv with embedded newlines
+    for name, text in CASES.items():
+        p = subprocess.run([exe] + BASE + ["-Command", text],
+                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        print("%-16s (argv) rc=%-4s out=%-24r err=%r" % (name, p.returncode, p.stdout[:24], p.stderr[:60]))
