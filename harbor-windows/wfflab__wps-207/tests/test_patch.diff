+"""PowerShell 退出码与错误流语义的行为验证。
+
+覆盖三类只在 Windows PowerShell 上成立的语义：非终止错误不改变退出码、
+原生命令的退出码留在 ``$LASTEXITCODE`` 而不自动上传、错误信息默认走 stderr。
+"""
+
+import pytest
+
+from wjob import run_file, run_script
+
+
+# --- 核心回归（base 上失败） ------------------------------------------------
+
+
+def test_native_exit_code_is_propagated():
+    assert run_script("cmd /c exit 3").exit_code == 3
+
+
+def test_last_native_command_decides_the_step_result():
+    result = run_script("cmd /c exit 0\ncmd /c exit 7")
+    assert result.exit_code == 7
+
+
+def test_write_error_marks_the_step_as_failed():
+    result = run_script("Write-Error 'boom'")
+    assert result.exit_code != 0
+
+
+def test_terminating_error_propagates():
+    result = run_script("throw 'fatal'")
+    assert result.exit_code != 0
+
+
+def test_missing_item_error_marks_failure():
+    result = run_script("Get-Item 'C:\\definitely-missing-path-xyz'")
+    assert result.exit_code != 0
+
+
+def test_stderr_is_captured_for_error():
+    result = run_script("Write-Error 'boom'")
+    assert "boom" in (result.stderr + result.stdout)
+
+
+def test_stderr_is_captured_for_native_command():
+    result = run_script("cmd /c \"echo oops 1>&2\"")
+    assert "oops" in result.stderr
+
+
+# --- 回归保护（base 与参考解上都必须通过） ----------------------------------
+
+
+def test_successful_script_exits_zero():
+    assert run_script("Write-Output 'ok'").exit_code == 0
+
+
+def test_output_is_available():
+    assert run_script("Write-Output 'payload'").stdout.strip() == "payload"
+
+
+def test_ok_property_matches_exit_code():
+    assert run_script("Write-Output 'ok'").ok is True
+
+
+def test_multiline_output():
+    result = run_script("1..3 | ForEach-Object { Write-Output $_ }")
+    assert [line.strip() for line in result.stdout.splitlines() if line.strip()] == ["1", "2", "3"]
+
+
+def test_run_file_missing_script_reports_failure(tmp_path):
+    missing = tmp_path / "nope.ps1"
+    assert run_file(str(missing)).exit_code != 0
+
+
+def test_run_file_executes_script(tmp_path):
+    script = tmp_path / "hello.ps1"
+    script.write_text("Write-Output 'from-file'\n", encoding="ascii")
+    result = run_file(str(script))
+    assert result.exit_code == 0
+    assert "from-file" in result.stdout
