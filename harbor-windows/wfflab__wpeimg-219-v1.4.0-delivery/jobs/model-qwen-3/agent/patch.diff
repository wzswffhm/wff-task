diff --git a/_tmp_cert.py b/_tmp_cert.py
new file mode 100644
index 0000000..2a76c6b
--- /dev/null
+++ b/_tmp_cert.py
@@ -0,0 +1,31 @@
+import struct
+
+with open('assets/amd64-module.bin', 'rb') as f:
+    data = f.read()
+
+e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+coff = e_lfanew + 4
+opt = coff + 20
+
+# PE32+ directories start at opt + 112
+dir_start = opt + 112
+# Certificate table is index 4
+cert_va, cert_sz = struct.unpack_from('<II', data, dir_start + 4*8)
+print(f"Certificate dir: VA(offset)={hex(cert_va)}, Size={hex(cert_sz)}")
+print(f"File size: {len(data)}")
+if cert_va and cert_sz:
+    print(f"End: {hex(cert_va + cert_sz)}")
+    if cert_va + cert_sz <= len(data):
+        print("Certificate data is within file bounds")
+        # Read WIN_CERTIFICATE header
+        dwLength = struct.unpack_from('<I', data, cert_va)[0]
+        wRevision = struct.unpack_from('<H', data, cert_va + 4)[0]
+        wCertType = struct.unpack_from('<H', data, cert_va + 6)[0]
+        print(f"WIN_CERTIFICATE: dwLength={hex(dwLength)}, wRevision={hex(wRevision)}, wCertType={hex(wCertType)}")
+        
+        # The body starts at cert_va + 8
+        body = data[cert_va + 8 : cert_va + dwLength]
+        print(f"Body length: {len(body)} bytes")
+        print(f"First 20 bytes of body: {body[:20].hex()}")
+    else:
+        print("Certificate data extends beyond file!")
diff --git a/_tmp_checksum.py b/_tmp_checksum.py
new file mode 100644
index 0000000..f4b6589
--- /dev/null
+++ b/_tmp_checksum.py
@@ -0,0 +1,59 @@
+import struct
+
+def pe_checksum(data, checksum_offset):
+    """Compute the Windows PE image checksum.
+    
+    This is a ones-complement sum of all 16-bit words in the file,
+    skipping the 4-byte CheckSum field at checksum_offset,
+    then adding the file length.
+    """
+    total = 0
+    length = len(data)
+    
+    # Process 16-bit words
+    i = 0
+    while i + 1 < length:
+        # Skip the checksum field (4 bytes = 2 words)
+        if i == checksum_offset or i == checksum_offset + 2:
+            i += 2
+            continue
+        word = struct.unpack_from('<H', data, i)[0]
+        total += word
+        # Fold carry
+        if total > 0xFFFF:
+            total = (total & 0xFFFF) + (total >> 16)
+        i += 2
+    
+    # Handle odd trailing byte
+    if length % 2 == 1:
+        total += data[-1]
+        if total > 0xFFFF:
+            total = (total & 0xFFFF) + (total >> 16)
+    
+    # Final fold
+    total = (total & 0xFFFF) + (total >> 16)
+    
+    # Add file length
+    total += length
+    
+    return total & 0xFFFFFFFF
+
+# Test on both samples
+for path in ['assets/i386-module.bin', 'assets/amd64-module.bin']:
+    with open(path, 'rb') as f:
+        data = f.read()
+    
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    coff = e_lfanew + 4
+    opt = coff + 20 + 20  # after NT sig + COFF header
+    
+    # The CheckSum field is at optional header offset + 64
+    checksum_offset = opt + 64
+    stored = struct.unpack_from('<I', data, checksum_offset)[0]
+    
+    computed = pe_checksum(data, checksum_offset)
+    print(f"{path}:")
+    print(f"  stored checksum:   {hex(stored)}")
+    print(f"  computed checksum: {hex(computed)}")
+    print(f"  match: {stored == computed}")
+    print()
diff --git a/_tmp_checksum2.py b/_tmp_checksum2.py
new file mode 100644
index 0000000..1cad04d
--- /dev/null
+++ b/_tmp_checksum2.py
@@ -0,0 +1,47 @@
+import struct
+
+def pe_checksum(data, checksum_field_offset):
+    """Compute the Windows PE image checksum."""
+    total = 0
+    length = len(data)
+    
+    i = 0
+    while i + 1 < length:
+        if i == checksum_field_offset or i == checksum_field_offset + 2:
+            i += 2
+            continue
+        word = data[i] | (data[i+1] << 8)
+        total += word
+        total = (total & 0xFFFF) + (total >> 16)
+        i += 2
+    
+    if length % 2 == 1:
+        total += data[-1]
+        total = (total & 0xFFFF) + (total >> 16)
+    
+    total = (total & 0xFFFF) + (total >> 16)
+    total += length
+    return total
+
+for path in ['assets/i386-module.bin', 'assets/amd64-module.bin']:
+    with open(path, 'rb') as f:
+        data = f.read()
+    
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    print(f"{path}:")
+    print(f"  e_lfanew: {hex(e_lfanew)}")
+    coff = e_lfanew + 4
+    opt = coff + 20  # optional header start
+    print(f"  optional header at: {hex(opt)}")
+    
+    magic = struct.unpack_from('<H', data, opt)[0]
+    print(f"  magic: {hex(magic)}")
+    
+    checksum_field = opt + 64
+    stored = struct.unpack_from('<I', data, checksum_field)[0]
+    print(f"  checksum field at: {hex(checksum_field)}, stored: {hex(stored)}")
+    
+    computed = pe_checksum(data, checksum_field)
+    print(f"  computed: {hex(computed)}")
+    print(f"  match: {stored == computed}")
+    print()
diff --git a/_tmp_checksum_mod.py b/_tmp_checksum_mod.py
new file mode 100644
index 0000000..87b8f90
--- /dev/null
+++ b/_tmp_checksum_mod.py
@@ -0,0 +1,61 @@
+import sys, os, struct
+sys.path.insert(0, '.')
+from wpeimg import compute_checksum
+
+# Load i386 sample and modify some bytes
+with open('assets/i386-module.bin', 'rb') as f:
+    data = bytearray(f.read())
+
+original_cs = compute_checksum(bytes(data))
+print(f"Original checksum: {hex(original_cs)}")
+
+# Modify a byte in .text section (at raw offset 0x400)
+data[0x400] ^= 0xFF
+modified_cs = compute_checksum(bytes(data))
+print(f"After modifying 0x400: {hex(modified_cs)}")
+print(f"Different: {original_cs != modified_cs}")
+
+# Restore and modify another byte
+data[0x400] ^= 0xFF
+data[0x500] ^= 0x01
+modified_cs2 = compute_checksum(bytes(data))
+print(f"After modifying 0x500: {hex(modified_cs2)}")
+print(f"Different from original: {original_cs != modified_cs2}")
+
+# Test accumulator consistency with chunked vs one-shot
+from wpeimg import ChecksumAccumulator
+data2 = bytes(range(256)) * 7
+
+one_shot = compute_checksum(data2)
+acc = ChecksumAccumulator()
+for i in range(0, len(data2), 100):
+    acc.update(data2[i:i+100])
+chunked = acc.value(len(data2))
+print(f"\nOne-shot: {hex(one_shot)}, Chunked: {hex(chunked)}, Match: {one_shot == chunked}")
+
+# Also test with odd-length data
+data3 = b"hello world!"  # 12 bytes
+cs3 = compute_checksum(data3)
+acc3 = ChecksumAccumulator()
+acc3.update(b"hello ")
+acc3.update(b"world!")
+cs3_chunked = acc3.value(len(data3))
+print(f"Odd test - One-shot: {hex(cs3)}, Chunked: {hex(cs3_chunked)}, Match: {cs3 == cs3_chunked}")
+
+# Test with truly odd length
+data4 = b"hello world!!!"  # 14 bytes  
+cs4 = compute_checksum(data4)
+acc4 = ChecksumAccumulator()
+acc4.update(b"hello wo")
+acc4.update(b"rld!!!")
+cs4_chunked = acc4.value(len(data4))
+print(f"Even test - One-shot: {hex(cs4)}, Chunked: {hex(cs4_chunked)}, Match: {cs4 == cs4_chunked}")
+
+# Test single byte chunks
+data5 = bytes(range(50))
+cs5 = compute_checksum(data5)
+acc5 = ChecksumAccumulator()
+for b in data5:
+    acc5.update(bytes([b]))
+cs5_chunked = acc5.value(len(data5))
+print(f"Single-byte chunks - One-shot: {hex(cs5)}, Chunked: {hex(cs5_chunked)}, Match: {cs5 == cs5_chunked}")
diff --git a/_tmp_der.py b/_tmp_der.py
new file mode 100644
index 0000000..ba00499
--- /dev/null
+++ b/_tmp_der.py
@@ -0,0 +1,145 @@
+import struct
+
+with open('assets/amd64-module.bin', 'rb') as f:
+    data = f.read()
+
+e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+coff = e_lfanew + 4
+opt = coff + 20
+dir_start = opt + 112
+cert_off, cert_sz = struct.unpack_from('<II', data, dir_start + 4*8)
+
+dwLength = struct.unpack_from('<I', data, cert_off)[0]
+body = data[cert_off + 8 : cert_off + dwLength]
+
+def parse_tag(data, offset):
+    """Parse a DER tag at offset, return (tag_class, constructed, tag_number, new_offset)"""
+    b = data[offset]
+    tag_class = (b >> 6) & 3
+    constructed = bool(b & 0x20)
+    tag_num = b & 0x1F
+    offset += 1
+    if tag_num == 0x1F:
+        tag_num = 0
+        while True:
+            b = data[offset]
+            offset += 1
+            tag_num = (tag_num << 7) | (b & 0x7F)
+            if not (b & 0x80):
+                break
+    return tag_class, constructed, tag_num, offset
+
+def parse_length(data, offset):
+    """Parse a DER length at offset, return (length, new_offset)"""
+    b = data[offset]
+    offset += 1
+    if b < 0x80:
+        return b, offset
+    elif b == 0x80:
+        raise ValueError("Indefinite length not supported")
+    else:
+        num_bytes = b & 0x7F
+        length = 0
+        for _ in range(num_bytes):
+            length = (length << 8) | data[offset]
+            offset += 1
+        return length, offset
+
+def parse_tlv(data, offset):
+    """Parse tag+length+value, return (tag_class, constructed, tag_num, value_bytes, next_offset)"""
+    tc, con, tn, off = parse_tag(data, offset)
+    ln, off = parse_length(data, off)
+    val = data[off:off+ln]
+    return tc, con, tn, val, off+ln
+
+def parse_oid(data):
+    """Parse OID bytes to dotted string"""
+    if len(data) < 1:
+        return ""
+    first = data[0]
+    parts = [first // 40, first % 40]
+    val = 0
+    for b in data[1:]:
+        val = (val << 7) | (b & 0x7F)
+        if not (b & 0x80):
+            parts.append(val)
+            val = 0
+    return '.'.join(str(p) for p in parts)
+
+# Parse ContentInfo SEQUENCE
+tc, con, tn, content_info_val, _ = parse_tlv(body, 0)
+print(f"ContentInfo: class={tc}, constructed={con}, tag={tn}")
+
+# Inside ContentInfo: contentType OID, then [0] EXPLICIT content
+offset = 0
+tc, con, tn, oid_bytes, next_off = parse_tlv(content_info_val, 0)
+oid_str = parse_oid(oid_bytes)
+print(f"contentType OID: {oid_str}")
+
+# Next should be [0] EXPLICIT containing SignedData
+tc, con, tn, explicit_val, _ = parse_tlv(content_info_val, next_off)
+print(f"Explicit wrapper: class={tc}, tag={tn}")
+
+# Inside [0]: SignedData SEQUENCE
+tc, con, tn, signed_data_val, _ = parse_tlv(explicit_val, 0)
+print(f"SignedData: class={tc}, tag={tn}")
+
+# SignedData fields:
+# version INTEGER
+# digestAlgorithms SET OF AlgorithmIdentifier
+# contentInfo ContentInfo
+# certificates [0] IMPLICIT (optional)
+# crls [1] IMPLICIT (optional)  
+# signerInfos SET OF SignerInfo
+
+sd_offset = 0
+# version
+tc, con, tn, ver_bytes, sd_offset = parse_tlv(signed_data_val, sd_offset)
+version = int.from_bytes(ver_bytes, 'big')
+print(f"Version: {version}")
+
+# digestAlgorithms SET
+tc, con, tn, da_val, sd_offset = parse_tlv(signed_data_val, sd_offset)
+print(f"digestAlgorithms: tag={tn}, len={len(da_val)}")
+
+# Parse each AlgorithmIdentifier in the SET
+da_offset = 0
+alg_names = []
+while da_offset < len(da_val):
+    tc2, con2, tn2, ai_val, da_offset = parse_tlv(da_val, da_offset)
+    # First element is OID
+    tc3, con3, tn3, alg_oid_bytes, ai_next = parse_tlv(ai_val, 0)
+    alg_oid = parse_oid(alg_oid_bytes)
+    print(f"  Algorithm OID: {alg_oid}")
+    alg_names.append(alg_oid)
+
+# contentInfo
+tc, con, tn, ci_val, sd_offset = parse_tlv(signed_data_val, sd_offset)
+ci_offset = 0
+tc2, con2, tn2, ci_oid_bytes, _ = parse_tlv(ci_val, 0)
+ci_oid = parse_oid(ci_oid_bytes)
+print(f"contentInfo OID: {ci_oid}")
+
+# Look for certificates [0] and signerInfos SET
+cert_count = 0
+signer_count = 0
+while sd_offset < len(signed_data_val):
+    tc, con, tn, field_val, sd_offset = parse_tlv(signed_data_val, sd_offset)
+    if tc == 2 and tn == 0:  # context-specific [0] = certificates
+        # Count certificates in the SET/SEQUENCE
+        c_off = 0
+        while c_off < len(field_val):
+            _, _, _, _, c_off = parse_tlv(field_val, c_off)
+            cert_count += 1
+        print(f"Certificates count: {cert_count}")
+    elif tc == 0 and tn == 17:  # SET (tag 17 = 0x11)
+        # This could be signerInfos
+        s_off = 0
+        while s_off < len(field_val):
+            _, _, _, _, s_off = parse_tlv(field_val, s_off)
+            signer_count += 1
+        print(f"SignerInfos count: {signer_count}")
+    else:
+        print(f"Other field: class={tc}, tag={tn}, len={len(field_val)}")
+
+print(f"\nSummary: cert_count={cert_count}, signer_count={signer_count}")
