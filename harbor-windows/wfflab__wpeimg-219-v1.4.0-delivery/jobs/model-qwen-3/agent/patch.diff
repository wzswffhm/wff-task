diff --git a/_tmp_inspect.py b/_tmp_inspect.py
new file mode 100644
index 0000000..502e009
--- /dev/null
+++ b/_tmp_inspect.py
@@ -0,0 +1,61 @@
+import struct, sys
+
+def inspect_pe(path):
+    with open(path, 'rb') as f:
+        data = f.read()
+    print(f"=== {path} ({len(data)} bytes) ===")
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    print(f"e_lfanew: {hex(e_lfanew)}")
+    sig = data[e_lfanew:e_lfanew+4]
+    print(f"PE sig: {sig}")
+    coff = e_lfanew + 4
+    machine, nsec, _ts, _symtab, _nsym, size_opt, chars = struct.unpack_from('<HHIIIHH', data, coff)
+    print(f"Machine: {hex(machine)}, Sections: {nsec}, SizeOfOptionalHeader: {size_opt}, Chars: {hex(chars)}")
+    opt = coff + 20
+    magic = struct.unpack_from('<H', data, opt)[0]
+    print(f"Optional magic: {hex(magic)}")
+    
+    if magic == 0x10B:
+        entry = struct.unpack_from('<I', data, opt + 16)[0]
+        image_base = struct.unpack_from('<I', data, opt + 28)[0]
+        section_align, file_align = struct.unpack_from('<II', data, opt + 32)
+        size_of_image = struct.unpack_from('<I', data, opt + 56)[0]
+        size_of_headers = struct.unpack_from('<I', data, opt + 60)[0]
+        checksum = struct.unpack_from('<I', data, opt + 64)[0]
+        num_rva_sizes = struct.unpack_from('<I', data, opt + 92)[0]
+        dir_start = opt + 96
+    elif magic == 0x20B:
+        entry = struct.unpack_from('<I', data, opt + 16)[0]
+        image_base = struct.unpack_from('<Q', data, opt + 24)[0]
+        section_align, file_align = struct.unpack_from('<II', data, opt + 32)
+        size_of_image = struct.unpack_from('<I', data, opt + 56)[0]
+        size_of_headers = struct.unpack_from('<I', data, opt + 60)[0]
+        checksum = struct.unpack_from('<I', data, opt + 64)[0]
+        num_rva_sizes = struct.unpack_from('<I', data, opt + 108)[0]
+        dir_start = opt + 112
+    else:
+        print("Unknown magic!")
+        return
+    
+    print(f"Entry RVA: {hex(entry)}, ImageBase: {hex(image_base)}")
+    print(f"SectionAlign: {hex(section_align)}, FileAlign: {hex(file_align)}")
+    print(f"SizeOfImage: {hex(size_of_image)}, SizeOfHeaders: {hex(size_of_headers)}")
+    print(f"Checksum: {hex(checksum)}, NumberOfRvaAndSizes: {num_rva_sizes}")
+    
+    for i in range(min(num_rva_sizes, 16)):
+        va, sz = struct.unpack_from('<II', data, dir_start + i*8)
+        if va or sz:
+            print(f"  Dir[{i}]: VA={hex(va)}, Size={hex(sz)}")
+    
+    sect_off = opt + size_opt
+    print(f"Section table at: {hex(sect_off)}")
+    for i in range(nsec):
+        s = sect_off + i * 40
+        name = data[s:s+8].rstrip(b'\x00').decode('latin-1')
+        vsz, vaddr, raw_sz, raw_ptr = struct.unpack_from('<IIII', data, s+8)
+        ch = struct.unpack_from('<I', data, s+36)[0]
+        print(f"  Sec[{i}]: name={name!r} VSize={hex(vsz)} VAddr={hex(vaddr)} RawPtr={hex(raw_ptr)} RawSz={hex(raw_sz)} Chars={hex(ch)}")
+
+inspect_pe('assets/i386-module.bin')
+print()
+inspect_pe('assets/amd64-module.bin')
diff --git a/_tmp_validate.py b/_tmp_validate.py
new file mode 100644
index 0000000..badebd2
--- /dev/null
+++ b/_tmp_validate.py
@@ -0,0 +1,101 @@
+import struct
+
+def validate_pe(path):
+    with open(path, 'rb') as f:
+        data = f.read()
+    
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    coff = e_lfanew + 4
+    machine, nsec, _, _, _, size_opt, _ = struct.unpack_from('<HHIIIHH', data, coff)
+    opt = coff + 20
+    magic = struct.unpack_from('<H', data, opt)[0]
+    
+    if magic == 0x10B:
+        sa, fa = struct.unpack_from('<II', data, opt + 32)
+        soi = struct.unpack_from('<I', data, opt + 56)[0]
+        soh = struct.unpack_from('<I', data, opt + 60)[0]
+    else:
+        sa, fa = struct.unpack_from('<II', data, opt + 32)
+        soi = struct.unpack_from('<I', data, opt + 56)[0]
+        soh = struct.unpack_from('<I', data, opt + 60)[0]
+    
+    sect_off = opt + size_opt
+    
+    print(f"\n=== {path} ===")
+    print(f"SectionAlign={hex(sa)}, FileAlign={hex(fa)}")
+    print(f"SizeOfImage={hex(soi)}, SizeOfHeaders={hex(soh)}")
+    print(f"Section table at {hex(sect_off)}, end at {hex(sect_off + nsec * 40)}")
+    
+    # Check SizeOfHeaders alignment
+    if soh % fa != 0:
+        print(f"  ERROR: SizeOfHeaders not aligned to FileAlign")
+    else:
+        print(f"  OK: SizeOfHeaders aligned")
+    
+    # Check SizeOfHeaders >= section table end
+    sect_end = sect_off + nsec * 40
+    if soh < sect_end:
+        print(f"  ERROR: SizeOfHeaders ({hex(soh)}) < section table end ({hex(sect_end)})")
+    else:
+        print(f"  OK: SizeOfHeaders covers section table")
+    
+    max_va_end = 0
+    sections = []
+    for i in range(nsec):
+        s = sect_off + i * 40
+        name = data[s:s+8].rstrip(b'\x00').decode('latin-1')
+        vsz, vaddr, raw_sz, raw_ptr = struct.unpack_from('<IIII', data, s+8)
+        
+        sections.append((name, vaddr, vsz, raw_ptr, raw_sz))
+        
+        # VA alignment
+        if vaddr % sa != 0:
+            print(f"  ERROR: Section {name} VAddr {hex(vaddr)} not aligned to SectionAlign {hex(sa)}")
+        
+        # Raw pointer alignment
+        if raw_ptr % fa != 0:
+            print(f"  ERROR: Section {name} RawPtr {hex(raw_ptr)} not aligned to FileAlign {hex(fa)}")
+        
+        # Raw range within file
+        if raw_ptr + raw_sz > len(data):
+            print(f"  ERROR: Section {name} raw range [{hex(raw_ptr)}, {hex(raw_ptr+raw_sz)}) exceeds file size {len(data)}")
+        
+        # Raw pointer in headers
+        if raw_sz > 0 and raw_ptr < soh:
+            print(f"  ERROR: Section {name} RawPtr {hex(raw_ptr)} overlaps headers (SizeOfHeaders={hex(soh)})")
+        
+        va_end = vaddr + vsz
+        if va_end > max_va_end:
+            max_va_end = va_end
+        
+        print(f"  Section {name}: VA=[{hex(vaddr)}, {hex(vaddr+vsz)}), Raw=[{hex(raw_ptr)}, {hex(raw_ptr+raw_sz)})")
+    
+    # Check virtual overlaps
+    for i in range(len(sections)):
+        for j in range(i+1, len(sections)):
+            n1, va1, vs1, _, _ = sections[i]
+            n2, va2, vs2, _, _ = sections[j]
+            if va1 < va2 + vs2 and va2 < va1 + vs1:
+                print(f"  ERROR: Virtual overlap between {n1} and {n2}")
+    
+    # Check raw overlaps
+    for i in range(len(sections)):
+        for j in range(i+1, len(sections)):
+            n1, _, _, rp1, rs1 = sections[i]
+            n2, _, _, rp2, rs2 = sections[j]
+            if rs1 > 0 and rs2 > 0:
+                if rp1 < rp2 + rs2 and rp2 < rp1 + rs1:
+                    print(f"  ERROR: Raw overlap between {n1} and {n2}")
+    
+    # Check SizeOfImage
+    def align_up(val, align):
+        return (val + align - 1) & ~(align - 1)
+    
+    required_soi = align_up(max_va_end, sa)
+    if soi < required_soi:
+        print(f"  ERROR: SizeOfImage ({hex(soi)}) < required ({hex(required_soi)})")
+    else:
+        print(f"  OK: SizeOfImage sufficient")
+
+validate_pe('assets/i386-module.bin')
+validate_pe('assets/amd64-module.bin')
diff --git a/_tmp_verify.py b/_tmp_verify.py
new file mode 100644
index 0000000..3a453ee
--- /dev/null
+++ b/_tmp_verify.py
@@ -0,0 +1,128 @@
+import sys, os
+sys.path.insert(0, '.')
+from wpeimg import inspect, verify, rva_to_offset, compute_checksum, iter_sections, signature_info
+import io
+
+def load(name):
+    with open(os.path.join('assets', name), 'rb') as f:
+        return f.read()
+
+# Test 1: verify both samples
+print("=== Test 1: verify ===")
+for name in ['i386-module.bin', 'amd64-module.bin']:
+    data = load(name)
+    result = verify(data)
+    print(f"  verify({name}): {result}")
+
+# Test 2: inspect i386
+print("\n=== Test 2: inspect i386 ===")
+data = load('i386-module.bin')
+info = inspect(data)
+print(f"  machine: {hex(info['machine'])}")
+print(f"  is_pe32_plus: {info['is_pe32_plus']}")
+print(f"  number_of_sections: {info['number_of_sections']}")
+print(f"  entry_point_rva: {hex(info['entry_point_rva'])}")
+print(f"  image_base: {hex(info['image_base'])}")
+print(f"  section_alignment: {hex(info['section_alignment'])}")
+print(f"  file_alignment: {hex(info['file_alignment'])}")
+print(f"  size_of_image: {hex(info['size_of_image'])}")
+print(f"  size_of_headers: {hex(info['size_of_headers'])}")
+print(f"  checksum: {hex(info['checksum'])}")
+print(f"  has_authenticode_signature: {info['has_authenticode_signature']}")
+print(f"  sections: {[s['name'] for s in info['sections']]}")
+print(f"  data_directories count: {len(info['data_directories'])}")
+for d in info['data_directories']:
+    if d['virtual_address'] or d['size']:
+        print(f"    {d['name']}: VA={hex(d['virtual_address'])}, Size={hex(d['size'])}")
+
+# Test 3: inspect amd64
+print("\n=== Test 3: inspect amd64 ===")
+data = load('amd64-module.bin')
+info = inspect(data)
+print(f"  machine: {hex(info['machine'])}")
+print(f"  is_pe32_plus: {info['is_pe32_plus']}")
+print(f"  number_of_sections: {info['number_of_sections']}")
+print(f"  entry_point_rva: {hex(info['entry_point_rva'])}")
+print(f"  image_base: {hex(info['image_base'])}")
+print(f"  checksum: {hex(info['checksum'])}")
+print(f"  has_authenticode_signature: {info['has_authenticode_signature']}")
+print(f"  sections: {[s['name'] for s in info['sections']]}")
+print(f"  data_directories count: {len(info['data_directories'])}")
+for d in info['data_directories']:
+    if d['virtual_address'] or d['size']:
+        print(f"    {d['name']}: VA={hex(d['virtual_address'])}, Size={hex(d['size'])}")
+
+# Test 4: RVA mapping
+print("\n=== Test 4: RVA mapping ===")
+data = load('i386-module.bin')
+# .text starts at RVA 0x1000, raw pointer 0x400
+r = rva_to_offset(data, 0x1000)
+print(f"  i386 rva_to_offset(0x1000) = {hex(r) if r is not None else None} (expected 0x400)")
+r = rva_to_offset(data, 0x1050)
+print(f"  i386 rva_to_offset(0x1050) = {hex(r) if r is not None else None} (expected 0x450)")
+# Header RVA
+r = rva_to_offset(data, 0x100)
+print(f"  i386 rva_to_offset(0x100) = {hex(r) if r is not None else None} (expected 0x100)")
+# Negative
+r = rva_to_offset(data, -1)
+print(f"  i386 rva_to_offset(-1) = {r} (expected None)")
+
+data = load('amd64-module.bin')
+r = rva_to_offset(data, 0x1000)
+print(f"  amd64 rva_to_offset(0x1000) = {hex(r) if r is not None else None} (expected 0x400)")
+
+# Test 5: Checksum
+print("\n=== Test 5: Checksum ===")
+for name in ['i386-module.bin', 'amd64-module.bin']:
+    data = load(name)
+    cs = compute_checksum(data)
+    print(f"  compute_checksum({name}) = {hex(cs)}")
+
+# Test 6: Stream
+print("\n=== Test 6: Stream ===")
+data = load('i386-module.bin')
+sections = list(iter_sections(io.BytesIO(data)))
+print(f"  i386 sections: {[s['name'] for s in sections]}")
+
+data = load('amd64-module.bin')
+sections = list(iter_sections(io.BytesIO(data)))
+print(f"  amd64 sections: {[s['name'] for s in sections]}")
+
+# Test 7: Signature info
+print("\n=== Test 7: Signature info ===")
+data = load('i386-module.bin')
+si = signature_info(data)
+print(f"  i386 present: {si['present']}")
+
+data = load('amd64-module.bin')
+si = signature_info(data)
+print(f"  amd64 present: {si['present']}")
+print(f"  amd64 offset: {hex(si['offset'])}")
+print(f"  amd64 size: {hex(si['size'])}")
+print(f"  amd64 declared_length: {hex(si['declared_length'])}")
+print(f"  amd64 revision: {hex(si['revision'])}")
+print(f"  amd64 certificate_type: {hex(si['certificate_type'])}")
+print(f"  amd64 content_type: {si['content_type']}")
+print(f"  amd64 digest_algorithms: {si['digest_algorithms']}")
+print(f"  amd64 certificate_count: {si['certificate_count']}")
+print(f"  amd64 signer_count: {si['signer_count']}")
+
+# Test 8: Error handling
+print("\n=== Test 8: Error handling ===")
+from wpeimg import WImgError, KIND_DOS, KIND_SIGNATURE, KIND_OPTIONAL, KIND_TRUNCATED, KIND_STRUCTURE, KIND_CHECKSUM
+try:
+    inspect(b"XX" + b"\0" * 120)
+except WImgError as e:
+    print(f"  Bad MZ: kind={e.kind} (expected dos)")
+
+try:
+    inspect(b"MZ" + b"\0" * 58 + b"\x00\x01\x00\x00" + b"\0" * 100)
+except WImgError as e:
+    print(f"  Bad PE sig: kind={e.kind}")
+
+# Empty / short inputs to verify
+print(f"  verify(b''): {verify(b'')}")
+print(f"  verify(b'MZ'): {verify(b'MZ')}")
+print(f"  verify(bytes(256)): {verify(bytes(256))}")
+
+print("\n=== All tests done ===")
