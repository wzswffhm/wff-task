diff --git a/wpeimg/_test_bounded.py b/wpeimg/_test_bounded.py
new file mode 100644
index 0000000..0bc9e22
--- /dev/null
+++ b/wpeimg/_test_bounded.py
@@ -0,0 +1,25 @@
+import io
+import sys
+sys.path.insert(0, '..')
+import wpeimg
+
+d = open('../assets/amd64-module.bin', 'rb').read()
+
+class CountingBytesIO(io.BytesIO):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.bytes_read = 0
+    
+    def read(self, size=-1):
+        if size is None or size < 0:
+            raise AssertionError("bare read() not allowed")
+        data = super().read(size)
+        self.bytes_read += len(data)
+        return data
+
+for multiplier in (1, 8):
+    padded = d + b'\0' * (len(d) * (multiplier - 1))
+    f = CountingBytesIO(padded)
+    it = wpeimg.iter_sections(f)
+    first = next(it)
+    print(f'mult={multiplier} bytes_before_first={f.bytes_read} first_name={first["name"]}')
