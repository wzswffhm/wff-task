new file mode 100644
index 0000000..8b613ba
--- /dev/null
+++ b/_probe.py
@@ -0,0 +1,69 @@
+import struct
+import sys
+
+
+def align_up(v, a):
+    return (v + a - 1) // a * a if a else v
+
+
+def dump(path):
+    data = open(path, "rb").read()
+    print("=" * 60)
+    print(path, "len", len(data), hex(len(data)))
+    nt = struct.unpack_from("<I", data, 0x3C)[0]
+    print("e_lfanew", nt, hex(nt), "sig", data[nt:nt + 4])
+    coff = nt + 4
+    machine, nsec, stamp, symtab, nsym, size_opt, chars = struct.unpack_from(
+        "<HHIIIHH", data, coff)
+    print("machine %#x nsec %d size_opt %d chars %#x" % (machine, nsec, size_opt, chars))
+    opt = coff + 20
+    magic = struct.unpack_from("<H", data, opt)[0]
+    print("opt offset", opt, "magic", hex(magic))
+    plus = magic == 0x20B
+    ep = struct.unpack_from("<I", data, opt + 16)[0]
+    if plus:
+        ib = struct.unpack_from("<Q", data, opt + 24)[0]
+    else:
+        ib = struct.unpack_from("<I", data, opt + 28)[0]
+    sa, fa = struct.unpack_from("<II", data, opt + 32)
+    soi, soh = struct.unpack_from("<II", data, opt + 56)
+    cks = struct.unpack_from("<I", data, opt + 64)[0]
+    subsys = struct.unpack_from("<H", data, opt + 68)[0]
+    dir_off = opt + (112 if plus else 96)
+    nrva = struct.unpack_from("<I", data, dir_off - 4)[0]
+    print("ep %#x image_base %#x sa %#x fa %#x soi %#x soh %#x cks %#x subsys %d nrva %d"
+          % (ep, ib, sa, fa, soi, soh, cks, subsys, nrva))
+    names = ("export import resource exception certificate relocation debug architecture "
+             "global_ptr tls load_config bound_import iat delay_import clr_runtime reserved").split()
+    for i in range(min(nrva, 16)):
+        va, sz = struct.unpack_from("<II", data, dir_off + i * 8)
+        if va or sz:
+            print("   dir[%2d] %-13s va %#010x size %#x" % (i, names[i], va, sz))
+    sect_off = opt + size_opt
+    print("section table at", sect_off, hex(sect_off))
+    secs = []
+    for i in range(nsec):
+        b = sect_off + i * 40
+        raw = data[b:b + 40]
+        name = raw[0:8].rstrip(b"\0").decode("latin-1")
+        vs, va, rs, rp = struct.unpack_from("<IIII", raw, 8)
+        ch = struct.unpack_from("<I", raw, 36)[0]
+        secs.append((vs, va, rs, rp))
+        print("   sec %-9s vs %#010x va %#010x rs %#010x rp %#010x ch %#010x"
+              % (name, vs, va, rs, rp, ch))
+    end_sect = sect_off + nsec * 40
+    print("section table end", end_sect, "soh", soh, "soh aligned ok",
+          soh % fa == 0 if fa else None)
+    maxva = max((va + vs for vs, va, rs, rp in secs), default=0)
+    print("maxva aligned", hex(align_up(maxva, sa)), "soi", hex(soi))
+    if nrva > 4:
+        va, sz = struct.unpack_from("<II", data, dir_off + 4 * 8)
+        print("cert table offset %#x size %#x filelen %#x" % (va, sz, len(data)))
+        if va and sz and va + sz <= len(data):
+            dl, rev, ctype = struct.unpack_from("<IHH", data, va)
+            print("   WIN_CERT dwLength %#x rev %#x type %#x" % (dl, rev, ctype))
+            print("   body head", data[va + 8:va + 8 + 64].hex())
+
+
+for p in sys.argv[1:]:
+    dump(p)
diff --git a/_probe2.py b/_probe2.py
new file mode 100644
index 0000000..d974a73
--- /dev/null
+++ b/_probe2.py
@@ -0,0 +1,23 @@
+import struct
+
+
+def checksum(data):
+    nt = struct.unpack_from("<I", data, 0x3C)[0]
+    cks_off = nt + 4 + 20 + 64
+    buf = bytearray(data)
+    buf[cks_off:cks_off + 4] = b"\0\0\0\0"
+    if len(buf) % 2:
+        buf.append(0)
+    total = 0
+    for i in range(0, len(buf), 2):
+        total += buf[i] | (buf[i + 1] << 8)
+        total = (total & 0xFFFF) + (total >> 16)
+    total = (total & 0xFFFF) + (total >> 16)
+    return (total & 0xFFFF) + len(data)
+
+
+for p in ("assets/amd64-module.bin", "assets/i386-module.bin"):
+    data = open(p, "rb").read()
+    nt = struct.unpack_from("<I", data, 0x3C)[0]
+    stored = struct.unpack_from("<I", data, nt + 4 + 20 + 64)[0]
+    print(p, "stored %#x computed %#x" % (stored, checksum(data)))
