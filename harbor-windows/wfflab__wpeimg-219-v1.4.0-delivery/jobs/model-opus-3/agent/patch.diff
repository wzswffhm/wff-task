diff --git a/wpeimg/asn1.py b/wpeimg/asn1.py
new file mode 100644
index 0000000..4359409
--- /dev/null
+++ b/wpeimg/asn1.py
@@ -0,0 +1,93 @@
+"""A very small DER reader.
+
+Just enough of ASN.1 to walk the PKCS#7 ``SignedData`` blob carried by an
+Authenticode record: definite-length tag/length/value triples, membership
+iteration and object identifiers.  Implemented here on purpose, so the package
+keeps depending only on the platform independent part of the standard library.
+"""
+
+TAG_INTEGER = 0x02
+TAG_OID = 0x06
+TAG_SEQUENCE = 0x30
+TAG_SET = 0x31
+TAG_CONTEXT_0 = 0xA0
+TAG_CONTEXT_1 = 0xA1
+
+_MAX_LENGTH_BYTES = 8
+
+
+class DERError(ValueError):
+    """Raised when a blob is not well formed DER."""
+
+
+def read_tlv(data, offset):
+    """Return ``(tag, content_start, content_end, next_offset)`` at ``offset``."""
+    if offset < 0 or offset + 2 > len(data):
+        raise DERError("the blob ends inside a tag header")
+    tag = data[offset]
+    if tag & 0x1F == 0x1F:
+        raise DERError("multi-byte tags are not supported")
+    first = data[offset + 1]
+    cursor = offset + 2
+    if first < 0x80:
+        length = first
+    elif first == 0x80:
+        raise DERError("indefinite lengths are not valid DER")
+    else:
+        count = first & 0x7F
+        if count > _MAX_LENGTH_BYTES or cursor + count > len(data):
+            raise DERError("the blob ends inside a length field")
+        length = int.from_bytes(data[cursor:cursor + count], "big")
+        cursor += count
+    end = cursor + length
+    if end > len(data):
+        raise DERError("the blob ends inside a value")
+    return tag, cursor, end, end
+
+
+def children(data, start, end):
+    """Yield ``(tag, content_start, content_end)`` for each member in a span."""
+    cursor = start
+    while cursor < end:
+        tag, content_start, content_end, nxt = read_tlv(data, cursor)
+        yield tag, content_start, content_end
+        if nxt <= cursor:
+            raise DERError("the blob does not advance")
+        cursor = nxt
+
+
+def count_children(data, start, end):
+    """Return how many members a constructed span holds."""
+    return sum(1 for _ in children(data, start, end))
+
+
+def decode_oid(data, start, end):
+    """Return the dotted string form of an object identifier's value bytes."""
+    if end <= start:
+        raise DERError("an object identifier cannot be empty")
+    first = data[start]
+    if first < 80:
+        parts = [first // 40, first % 40]
+    else:
+        parts = [2, first - 80]
+    value = 0
+    seen = False
+    for index in range(start + 1, end):
+        byte = data[index]
+        value = (value << 7) | (byte & 0x7F)
+        seen = True
+        if not byte & 0x80:
+            parts.append(value)
+            value = 0
+            seen = False
+    if seen:
+        raise DERError("an object identifier ends mid-component")
+    return ".".join(str(part) for part in parts)
+
+
+def read_oid(data, start, end):
+    """Read the identifier at ``start``, which must be an OID, as a string."""
+    tag, content_start, content_end, _next = read_tlv(data, start)
+    if tag != TAG_OID or content_end > end:
+        raise DERError("expected an object identifier")
+    return decode_oid(data, content_start, content_end)
diff --git a/wpeimg/checksum.py b/wpeimg/checksum.py
index d6884b5..d052882 100644
--- a/wpeimg/checksum.py
+++ b/wpeimg/checksum.py
@@ -1,39 +1,102 @@
 """The image checksum recorded in the optional header.
 
-The value is exposed through a one-shot helper and through an incremental
+The value is the one Windows itself computes (the number
+``imagehlp!MapFileAndCheckSumW`` reports): a sixteen-bit ones-complement style
+running sum of the whole file with the ``CheckSum`` field read as zero, folded
+down to sixteen bits and finally added to the length of the file.  It is not a
+CRC and not a plain byte sum.
+
+The algorithm is exposed through a one-shot helper and through an incremental
 accumulator, so a caller that already walks the file once can reuse the pass.
 """
 
 import struct
-import zlib
+
+from .headers import (
+    CHECKSUM_OFFSET,
+    DOS_HEADER_SIZE,
+    DOS_MAGIC,
+    FILE_HEADER_SIZE,
+    NT_SIGNATURE,
+)
+
+_CHECKSUM_FIELD_SIZE = 4
 
 
 class ChecksumAccumulator(object):
-    """Incremental helper for the checksum of a byte stream."""
+    """Incremental helper for the image checksum of a byte stream.
+
+    The accumulator only accounts for the bytes it is handed; blanking the
+    ``CheckSum`` field is the caller's job (:func:`compute_checksum` does it).
+    Feeding the same bytes in any chunking yields the same result.
+    """
 
     def __init__(self):
-        self._state = 0
+        self._sum = 0
+        self._pending = None
 
     def update(self, chunk):
         """Fold ``chunk`` into the running state and return ``self``."""
-        self._state = zlib.crc32(bytes(chunk), self._state)
+        data = bytes(chunk)
+        if not data:
+            return self
+        if self._pending is not None:
+            self._sum += self._pending | (data[0] << 8)
+            data = data[1:]
+            self._pending = None
+        words = len(data) // 2
+        if words:
+            self._sum += sum(struct.unpack_from("<%dH" % words, data, 0))
+        if len(data) % 2:
+            self._pending = data[-1]
         return self
 
     def value(self, total_length):
         """Return the checksum of everything fed so far.
 
-        ``total_length`` is the number of bytes the image occupies.
+        ``total_length`` is the number of bytes the whole file occupies; a
+        trailing odd byte is folded in as the low half of a zero-padded word,
+        which is how Windows reads the tail of a mapped image.
         """
-        return self._state & 0xFFFFFFFF
+        total = self._sum
+        if self._pending is not None:
+            total += self._pending
+        while total >> 16:
+            total = (total & 0xFFFF) + (total >> 16)
+        return (total + int(total_length)) & 0xFFFFFFFF
+
+
+def checksum_field_offset(data):
+    """Return where the ``CheckSum`` field sits, or ``None``.
+
+    Only a well formed enough header chain has such a field; for anything else
+    there is nothing to blank out.
+    """
+    if len(data) < DOS_HEADER_SIZE or data[:2] != DOS_MAGIC:
+        return None
+    nt_offset = struct.unpack_from("<I", data, 0x3C)[0]
+    if nt_offset + 4 > len(data) or data[nt_offset:nt_offset + 4] != NT_SIGNATURE:
+        return None
+    offset = nt_offset + 4 + FILE_HEADER_SIZE + CHECKSUM_OFFSET
+    if offset + _CHECKSUM_FIELD_SIZE > len(data):
+        return None
+    return offset
 
 
 def compute_checksum(data):
-    """Return the checksum of ``data``."""
+    """Return the image checksum Windows would record for ``data``."""
+    data = bytes(data)
     accumulator = ChecksumAccumulator()
-    accumulator.update(data)
+    field = checksum_field_offset(data)
+    if field is None:
+        accumulator.update(data)
+    else:
+        accumulator.update(data[:field])
+        accumulator.update(b"\0" * _CHECKSUM_FIELD_SIZE)
+        accumulator.update(data[field + _CHECKSUM_FIELD_SIZE:])
     return accumulator.value(len(data))
 
 
 def stored_checksum(data, optional_offset):
     """Return the checksum currently recorded in the optional header."""
-    return struct.unpack_from("<I", data, optional_offset + 64)[0]
+    return struct.unpack_from("<I", data, optional_offset + CHECKSUM_OFFSET)[0]
