+import io
+import struct
+
+from wpeimg import (
+    ChecksumAccumulator,
+    KINDS,
+    WImgError,
+    compute_checksum,
+    inspect,
+    iter_sections,
+    rva_to_offset,
+    signature_info,
+    verify,
+)
+import wpeimg
+
+
+def load(name):
+    with open("assets/" + name, "rb") as handle:
+        return handle.read()
+
+
+AMD64 = load("amd64-module.bin")
+I386 = load("i386-module.bin")
+
+print("__all__ count", len(wpeimg.__all__), sorted(wpeimg.__all__) == sorted([
+    "ChecksumAccumulator", "KIND_CHECKSUM", "KIND_DOS", "KIND_OPTIONAL",
+    "KIND_SIGNATURE", "KIND_STRUCTURE", "KIND_TRUNCATED", "KINDS", "WImgError",
+    "compute_checksum", "inspect", "iter_sections", "rva_to_offset",
+    "signature_info", "verify"]))
+print("KINDS", KINDS)
+
+for name, data in (("amd64", AMD64), ("i386", I386)):
+    print("=" * 50, name)
+    print("verify", verify(data))
+    info = inspect(data)
+    for key in ("machine", "is_pe32_plus", "number_of_sections", "entry_point_rva",
+                "image_base", "section_alignment", "file_alignment", "size_of_image",
+                "size_of_headers", "checksum", "has_authenticode_signature"):
+        value = info[key]
+        print("  %-28s %s" % (key, hex(value) if isinstance(value, int) else value))
+    print("  sections", [s["name"] for s in info["sections"]])
+    print("  dirs len", len(info["data_directories"]))
+    print("  dir names ok", [d["name"] for d in info["data_directories"]][:5])
+    nonzero = [(d["name"], hex(d["virtual_address"]), hex(d["size"]))
+               for d in info["data_directories"] if d["virtual_address"] or d["size"]]
+    print("  nonzero dirs", nonzero)
+    print("  computed cks", hex(compute_checksum(data)), "stored", hex(info["checksum"]))
+    # rva mapping
+    first = info["sections"][0]
+    rva = first["virtual_address"] + 0x10
+    print("  rva %#x ->" % rva, rva_to_offset(data, rva),
+          "expect", first["raw_pointer"] + 0x10)
+    print("  header rva 0x40 ->", rva_to_offset(data, 0x40))
+    print("  rva -1 ->", rva_to_offset(data, -1))
+    print("  huge rva ->", rva_to_offset(data, 0x7FFFFFF))
+    print("  stream", [s["name"] for s in iter_sections(io.BytesIO(data))])
+    print("  sig", signature_info(data))
diff --git a/_probe4.py b/_probe4.py
new file mode 100644
index 0000000..4ca2946
--- /dev/null
+++ b/_probe4.py
@@ -0,0 +1,205 @@
+import io
+import struct
+
+from wpeimg import (
+    ChecksumAccumulator,
+    WImgError,
+    compute_checksum,
+    inspect,
+    iter_sections,
+    signature_info,
+    verify,
+)
+
+
+def load(name):
+    with open("assets/" + name, "rb") as handle:
+        return handle.read()
+
+
+AMD64 = load("amd64-module.bin")
+I386 = load("i386-module.bin")
+
+
+def opt_offset(data):
+    nt = struct.unpack_from("<I", data, 0x3C)[0]
+    return nt + 4 + 20
+
+
+def sect_offset(data):
+    nt = struct.unpack_from("<I", data, 0x3C)[0]
+    size_opt = struct.unpack_from("<H", data, nt + 4 + 16)[0]
+    return nt + 4 + 20 + size_opt
+
+
+def rechecksum(buf):
+    """Rewrite CheckSum so only the targeted fault remains."""
+    o = opt_offset(buf) + 64
+    struct.pack_into("<I", buf, o, 0)
+    struct.pack_into("<I", buf, o, compute_checksum(bytes(buf)))
+    return bytes(buf)
+
+
+def kind_of(data):
+    try:
+        inspect(data)
+    except WImgError as err:
+        return err.kind
+    except Exception as err:  # noqa: BLE001
+        return "NOT-WIMGERROR:%r" % (err,)
+    return "ok"
+
+
+print("-- taxonomy")
+print("  no MZ            ", kind_of(b"XX" + b"\0" * 200))
+print("  empty            ", kind_of(b""))
+print("  MZ only          ", kind_of(b"MZ"))
+print("  truncated DOS    ", kind_of(b"MZ" + b"\0" * 20))
+bad_sig = bytearray(I386)
+nt = struct.unpack_from("<I", bad_sig, 0x3C)[0]
+bad_sig[nt:nt + 4] = b"XX\0\0"
+print("  bad PE sig       ", kind_of(bytes(bad_sig)))
+bad_magic = bytearray(I386)
+struct.pack_into("<H", bad_magic, opt_offset(bad_magic), 0x999)
+print("  bad opt magic    ", kind_of(bytes(bad_magic)))
+small_opt = bytearray(I386)
+struct.pack_into("<H", small_opt, nt + 4 + 16, 40)
+print("  tiny size_opt    ", kind_of(bytes(small_opt)))
+print("  half section tbl ", kind_of(I386[:sect_offset(I386) + 60]))
+print("  cut in optional  ", kind_of(I386[:opt_offset(I386) + 40]))
+bad_cks = bytearray(I386)
+struct.pack_into("<I", bad_cks, opt_offset(bad_cks) + 64, 0x1234)
+print("  wrong checksum   ", kind_of(bytes(bad_cks)))
+zero_cks = bytearray(I386)
+struct.pack_into("<I", zero_cks, opt_offset(zero_cks) + 64, 0)
+print("  zero checksum ok ", kind_of(bytes(zero_cks)))
+
+print("-- structure faults (checksum rewritten each time)")
+so = sect_offset(I386)
+
+
+def mutate(patches):
+    buf = bytearray(I386)
+    for off, fmt, val in patches:
+        struct.pack_into(fmt, buf, off, val)
+    return rechecksum(buf)
+
+
+print("  raw beyond eof   ", kind_of(mutate([(so + 16, "<I", 0x10000)])))
+print("  raw in headers   ", kind_of(mutate([(so + 20, "<I", 0x200)])))
+print("  va overlap       ", kind_of(mutate([(so + 40 + 12, "<I", 0x1000)])))
+print("  file overlap     ", kind_of(mutate([(so + 40 + 20, "<I", 0x400)])))
+print("  va misaligned    ", kind_of(mutate([(so + 12, "<I", 0x1100)])))
+print("  rawptr misaligned", kind_of(mutate([(so + 20, "<I", 0x401)])))
+print("  soh misaligned   ", kind_of(mutate([(opt_offset(I386) + 60, "<I", 0x401)])))
+print("  soh too small    ", kind_of(mutate([(opt_offset(I386) + 60, "<I", 0x200)])))
+print("  soi too small    ", kind_of(mutate([(opt_offset(I386) + 56, "<I", 0x1000)])))
+print("  structure beats checksum",
+      kind_of(bytes(bytearray(mutate([(so + 16, "<I", 0x10000)]))[:-0] )))
+broken = bytearray(mutate([(so + 16, "<I", 0x10000)]))
+struct.pack_into("<I", broken, opt_offset(broken) + 64, 0xDEAD)
+print("  broken+bad cks   ", kind_of(bytes(broken)))
+
+print("-- trailing bytes are fine")
+tail = bytearray(I386) + b"\xAB" * 5000
+print("  verify w/ tail   ", verify(rechecksum(tail)))
+
+print("-- checksum determinism")
+for name, data in (("amd64", AMD64), ("i386", I386)):
+    acc = ChecksumAccumulator()
+    for i in range(0, len(data), 7):
+        acc.update(data[i:i + 7])
+    print("  %s chunked==oneshot" % name,
+          acc.value(len(data)) == ChecksumAccumulator().update(data).value(len(data)))
+odd = bytes(range(256)) * 3 + b"\x5A"
+acc = ChecksumAccumulator()
+for i in range(0, len(odd), 5):
+    acc.update(odd[i:i + 5])
+print("  odd length chunked", acc.value(len(odd)) == compute_checksum(odd),
+      hex(compute_checksum(odd)))
+print("  cks independent of stored field:")
+a = bytearray(I386)
+struct.pack_into("<I", a, opt_offset(a) + 64, 0)
+b = bytearray(I386)
+struct.pack_into("<I", b, opt_offset(b) + 64, 0xFFFFFFFF)
+print("   ", hex(compute_checksum(bytes(a))), hex(compute_checksum(bytes(b))),
+      compute_checksum(bytes(a)) == compute_checksum(bytes(b)))
+
+print("-- stream bounded reads")
+
+
+class Counting(io.RawIOBase):
+    def __init__(self, data):
+        self._data = data
+        self._pos = 0
+        self.read_bytes = 0
+        self.calls = []
+
+    def read(self, n=-1):
+        assert isinstance(n, int) and n > 0, "bad read size %r" % (n,)
+        chunk = self._data[self._pos:self._pos + n]
+        self._pos += len(chunk)
+        self.read_bytes += len(chunk)
+        self.calls.append(n)
+        return chunk
+
+    def readable(self):
+        return True
+
+
+for name, data in (("amd64", AMD64), ("i386", I386)):
+    s1 = Counting(data)
+    it = iter_sections(s1)
+    print("  %s before first next: %d bytes" % (name, s1.read_bytes))
+    first = next(it)
+    n1 = s1.read_bytes
+    s2 = Counting(data + b"\x00" * (len(data) * 8))
+    it2 = iter_sections(s2)
+    next(it2)
+    n2 = s2.read_bytes
+    print("  %s first=%s reads %d vs amplified %d equal=%s"
+          % (name, first["name"], n1, n2, n1 == n2))
+    print("  %s all names %s" % (name, [x["name"] for x in iter_sections(Counting(data))]))
+
+print("-- signature edge cases")
+no_cert = bytearray(AMD64)
+oo = opt_offset(no_cert)
+struct.pack_into("<II", no_cert, oo + 112 + 4 * 8, 0, 0)
+print("  cert zeroed", signature_info(rechecksum(no_cert))["present"],
+      inspect(rechecksum(no_cert))["has_authenticode_signature"])
+out = bytearray(AMD64)
+struct.pack_into("<II", out, oo + 112 + 4 * 8, 0x900000, 0x100)
+print("  cert out of file", signature_info(rechecksum(out))["present"],
+      inspect(rechecksum(out))["has_authenticode_signature"])
+bad_len = bytearray(AMD64)
+struct.pack_into("<I", bad_len, 0x3600, 0xFFFF00)
+try:
+    signature_info(rechecksum(bad_len))
+    print("  bad dwLength -> no raise (WRONG)")
+except WImgError as err:
+    print("  bad dwLength ->", err.kind)
+small_len = bytearray(AMD64)
+struct.pack_into("<I", small_len, 0x3600, 4)
+try:
+    signature_info(rechecksum(small_len))
+    print("  dwLength<8 -> no raise (WRONG)")
+except WImgError as err:
+    print("  dwLength<8 ->", err.kind)
+other_type = bytearray(AMD64)
+struct.pack_into("<H", other_type, 0x3600 + 6, 1)
+sig = signature_info(rechecksum(other_type))
+print("  other cert type", sig["present"], sig["content_type"],
+      sig["certificate_count"], sig["signer_count"], sig["certificate_type"])
+print("  garbage input", signature_info(b"garbage")["present"],
+      signature_info(b"")["present"])
+
+print("-- nrva variants")
+few = bytearray(AMD64)
+struct.pack_into("<I", few, oo + 108, 3)
+info = inspect(rechecksum(few))
+print("  nrva=3 len", len(info["data_directories"]),
+      [(d["name"], d["virtual_address"]) for d in info["data_directories"][2:6]])
+many = bytearray(AMD64)
+struct.pack_into("<I", many, oo + 108, 99)
+info = inspect(rechecksum(many))
+print("  nrva=99 len", len(info["data_directories"]))
diff --git a/_probe5.py b/_probe5.py
new file mode 100644
index 0000000..0c26099
--- /dev/null
+++ b/_probe5.py
@@ -0,0 +1,117 @@
+import struct
+
+from wpeimg import WImgError, compute_checksum, inspect, rva_to_offset
+
+
+def load(name):
+    with open("assets/" + name, "rb") as handle:
+        return handle.read()
+
+
+I386 = load("i386-module.bin")
+AMD64 = load("amd64-module.bin")
+
+
+def opt_offset(data):
+    nt = struct.unpack_from("<I", data, 0x3C)[0]
+    return nt + 4 + 20
+
+
+def rechecksum(buf):
+    o = opt_offset(buf) + 64
+    struct.pack_into("<I", buf, o, 0)
+    struct.pack_into("<I", buf, o, compute_checksum(bytes(buf)))
+    return bytes(buf)
+
+
+def kind_of(data):
+    try:
+        inspect(data)
+    except WImgError as err:
+        return err.kind
+    except Exception as err:  # noqa: BLE001
+        return "NOT-WIMGERROR:%r" % (err,)
+    return "ok"
+
+
+buf = bytearray(I386)
+struct.pack_into("<I", buf, opt_offset(buf) + 60, 0)
+print("soh=0 (below table end) ->", kind_of(rechecksum(buf)))
+
+# structure fault + wrong checksum must report structure
+buf = bytearray(I386)
+nt = struct.unpack_from("<I", buf, 0x3C)[0]
+so = nt + 4 + 20 + struct.unpack_from("<H", buf, nt + 4 + 16)[0]
+struct.pack_into("<I", buf, so + 16, 0x10000)
+struct.pack_into("<I", buf, opt_offset(buf) + 64, 0xDEADBEEF)
+print("structure + bad checksum ->", kind_of(bytes(buf)))
+
+# rva edge cases
+info = inspect(I386)
+text = info["sections"][0]
+print("sections", [(s["name"], hex(s["virtual_address"]), hex(s["virtual_size"]),
+                    hex(s["raw_pointer"]), hex(s["raw_size"])) for s in info["sections"]])
+print("rva at section start ->", rva_to_offset(I386, text["virtual_address"]),
+      "expect", text["raw_pointer"])
+print("rva last byte of vsize ->",
+      rva_to_offset(I386, text["virtual_address"] + text["virtual_size"] - 1))
+print("rva just past vsize ->",
+      rva_to_offset(I386, text["virtual_address"] + text["virtual_size"]))
+print("rva soh-1 ->", rva_to_offset(I386, info["size_of_headers"] - 1))
+print("rva soh ->", rva_to_offset(I386, info["size_of_headers"]))
+print("rva 0 ->", rva_to_offset(I386, 0))
+
+# virtual-only tail: shrink raw_size so part of vsize has no file backing
+buf = bytearray(I386)
+struct.pack_into("<I", buf, so + 12, 0x1000)   # va
+struct.pack_into("<I", buf, so + 8, 0x180)     # vsize
+struct.pack_into("<I", buf, so + 16, 0x200)    # raw size
+data = rechecksum(buf)
+print("backed rva ->", rva_to_offset(data, 0x1100))
+
+# raw_size 0 section -> None inside it
+buf = bytearray(I386)
+struct.pack_into("<I", buf, so + 16, 0)  # .text raw_size = 0
+struct.pack_into("<I", buf, so + 20, 0)  # .text raw_pointer = 0
+data = rechecksum(buf)
+print("raw_size 0 section rva ->", rva_to_offset(data, 0x1010),
+      "verify", kind_of(data))
+
+# rva_to_offset on broken data should raise WImgError, not struct.error
+for bad in (b"", b"MZ", b"XX" + b"\0" * 200, I386[:200]):
+    try:
+        rva_to_offset(bad, 0x1000)
+        print("rva on %r -> no raise" % bad[:4])
+    except WImgError as err:
+        print("rva on %r -> %s" % (bad[:4], err.kind))
+    except Exception as err:  # noqa: BLE001
+        print("rva on %r -> WRONG %r" % (bad[:4], err))
+
+# nrva declared beyond the optional header / file
+buf = bytearray(AMD64)
+oo = opt_offset(buf)
+struct.pack_into("<H", buf, struct.unpack_from("<I", buf, 0x3C)[0] + 4 + 16, 112 + 3 * 8)
+print("size_opt trimmed ->", kind_of(bytes(buf)))
+info = None
+try:
+    info = inspect(rechecksum(bytearray(buf)))
+except WImgError as err:
+    print("  trimmed opt kind", err.kind)
+if info:
+    print("  dirs", len(info["data_directories"]),
+          [(d["name"], d["virtual_address"]) for d in info["data_directories"][3:6]])
+
+# truncated file where nrva claims entries past EOF
+short = bytearray(AMD64[:opt_offset(AMD64) + 112 + 2 * 8])
+try:
+    inspect(bytes(short))
+except WImgError as err:
+    print("short file ->", err.kind)
+except Exception as err:  # noqa: BLE001
+    print("short file -> WRONG", repr(err))
+
+print("str(WImgError)", str(WImgError("dos", "boom")), "| kind", WImgError("dos").kind)
+try:
+    WImgError("nope")
+except ValueError as err:
+    print("unknown kind ->", type(err).__name__)
diff --git a/_probe6.py b/_probe6.py
new file mode 100644
index 0000000..48a27db
--- /dev/null
+++ b/_probe6.py
@@ -0,0 +1,49 @@
+import struct
+
+from wpeimg.headers import read_optional_header
+
+with open("assets/amd64-module.bin", "rb") as handle:
+    AMD64 = handle.read()
+with open("assets/i386-module.bin", "rb") as handle:
+    I386 = handle.read()
+
+nt = struct.unpack_from("<I", AMD64, 0x3C)[0]
+oo = nt + 4 + 20
+
+# nrva = 16 but SizeOfOptionalHeader only holds 3 entries
+opt = read_optional_header(AMD64, oo, 112 + 3 * 8)
+dirs = opt["data_directories"]
+print("size_opt holds 3:", len(dirs),
+      [(d["name"], d["virtual_address"], d["size"]) for d in dirs[:5]])
+
+# data ends mid array
+short = AMD64[:oo + 112 + 2 * 8 + 3]
+opt = read_optional_header(short, oo, 240)
+dirs = opt["data_directories"]
+print("data ends mid-array:", len(dirs),
+      [(d["name"], d["virtual_address"]) for d in dirs[:4]])
+
+# declared count 0
+buf = bytearray(AMD64)
+struct.pack_into("<I", buf, oo + 108, 0)
+opt = read_optional_header(bytes(buf), oo, 240)
+print("nrva=0:", len(opt["data_directories"]),
+      all(d["virtual_address"] == 0 and d["size"] == 0
+          for d in opt["data_directories"]))
+
+# declared count 0xFFFFFFFF must not explode
+buf = bytearray(AMD64)
+struct.pack_into("<I", buf, oo + 108, 0xFFFFFFFF)
+opt = read_optional_header(bytes(buf), oo, 240)
+print("nrva=max:", len(opt["data_directories"]),
+      opt["data_directories"][4]["virtual_address"] == 0x3600)
+
+# PE32 directory base is 96, not 112
+nt32 = struct.unpack_from("<I", I386, 0x3C)[0]
+oo32 = nt32 + 4 + 20
+opt = read_optional_header(I386, oo32, 224)
+print("pe32 nrva", opt["number_of_rva_and_sizes"],
+      "resource", hex(opt["data_directories"][2]["virtual_address"]),
+      "reloc", hex(opt["data_directories"][5]["virtual_address"]),
+      "is_pe32_plus", opt["is_pe32_plus"],
+      "image_base", hex(opt["image_base"]))
diff --git a/_probe7.py b/_probe7.py
new file mode 100644
index 0000000..7eed4d7
--- /dev/null
+++ b/_probe7.py
@@ -0,0 +1,80 @@
+import io
+import struct
+
+from wpeimg import (
+    WImgError,
+    compute_checksum,
+    inspect,
+    iter_sections,
+    signature_info,
+)
+
+
+def load(name):
+    with open("assets/" + name, "rb") as handle:
+        return handle.read()
+
+
+AMD64 = load("amd64-module.bin")
+I386 = load("i386-module.bin")
+
+
+class Dribble(io.RawIOBase):
+    """Returns at most ``cap`` bytes per read, like a real pipe can."""
+
+    def __init__(self, data, cap=1):
+        self._data = data
+        self._pos = 0
+        self.cap = cap
+        self.read_bytes = 0
+
+    def read(self, n=-1):
+        assert isinstance(n, int) and n > 0, "bad read size %r" % (n,)
+        take = min(n, self.cap)
+        chunk = self._data[self._pos:self._pos + take]
+        self._pos += len(chunk)
+        self.read_bytes += len(chunk)
+        return chunk
+
+    def readable(self):
+        return True
+
+
+for cap in (1, 3, 64, 10 ** 6):
+    names = [s["name"] for s in iter_sections(Dribble(AMD64, cap))]
+    assert names == [".text", ".rdata", ".data", ".pdata", ".rsrc", ".reloc"], names
+print("dribbled streams ok")
+
+# laziness: creating the generator must not read anything
+stream = Dribble(AMD64, 4096)
+gen = iter_sections(stream)
+print("lazy before iteration:", stream.read_bytes == 0)
+
+# truncated stream -> WImgError(truncated)
+for cut in (0, 2, 10, 0x3F, 0x110, 0x120, 0x200, 0x219):
+    try:
+        list(iter_sections(io.BytesIO(AMD64[:cut])))
+        print("  cut %#x -> no raise" % cut)
+    except WImgError as err:
+        print("  cut %#x -> %s" % (cut, err.kind))
+    except Exception as err:  # noqa: BLE001
+        print("  cut %#x -> WRONG %r" % (cut, err))
+
+# certificate table ending exactly at EOF
+print("cert ends at EOF:", 0x3600 + 0x33F8 == len(AMD64),
+      inspect(AMD64)["has_authenticode_signature"])
+
+# certificate table one byte past EOF
+buf = bytearray(AMD64)
+nt = struct.unpack_from("<I", buf, 0x3C)[0]
+oo = nt + 4 + 20
+struct.pack_into("<I", buf, oo + 112 + 4 * 8 + 4, 0x33F9)
+struct.pack_into("<I", buf, oo + 64, 0)
+struct.pack_into("<I", buf, oo + 64, compute_checksum(bytes(buf)))
+data = bytes(buf)
+print("cert one past EOF:", inspect(data)["has_authenticode_signature"],
+      signature_info(data)["present"])
+
+# signature_info on the i386 image (no certificate table)
+print("i386 sig:", signature_info(I386))
+print("amd64 sig:", signature_info(AMD64))
diff --git a/_probe8.py b/_probe8.py
new file mode 100644
index 0000000..ca8a0f8
--- /dev/null
+++ b/_probe8.py
@@ -0,0 +1,45 @@
+"""Independent hand-walk of the Authenticode DER, to cross-check the counts."""
+
+import struct
+
+from wpeimg.asn1 import children, decode_oid, read_tlv
+
+with open("assets/amd64-module.bin", "rb") as handle:
+    DATA = handle.read()
+
+OFF, SIZE = 0x3600, 0x33F8
+dwlen, rev, ctype = struct.unpack_from("<IHH", DATA, OFF)
+blob = DATA[OFF + 8:OFF + dwlen]
+print("WIN_CERT len %#x rev %#x type %#x blob %d bytes" % (dwlen, rev, ctype, len(blob)))
+
+tag, start, end, _ = read_tlv(blob, 0)
+print("ContentInfo tag %#x span %d..%d" % (tag, start, end))
+members = list(children(blob, start, end))
+print("ContentInfo members", [hex(m[0]) for m in members])
+print("contentType", decode_oid(blob, members[0][1], members[0][2]))
+
+_t, cs, ce = members[1]
+inner = list(children(blob, cs, ce))
+print("[0] holds", [hex(m[0]) for m in inner])
+_t, ss, se = inner[0]
+fields = list(children(blob, ss, se))
+print("SignedData fields", [(hex(t), e - s) for t, s, e in fields])
+
+# version
+t, s, e = fields[0]
+print("version", int.from_bytes(blob[s:e], "big"))
+
+# digestAlgorithms
+t, s, e = fields[1]
+algs = []
+for mt, ms, me in children(blob, s, e):
+    ot, os_, oe, _ = read_tlv(blob, ms)
+    algs.append(decode_oid(blob, os_, oe))
+print("digestAlgorithms", algs)
+
+# remaining members
+for t, s, e in fields[2:]:
+    kids = None
+    if t in (0xA0, 0xA1, 0x31):
+        kids = sum(1 for _ in children(blob, s, e))
+    print("field tag %#x length %d children %s" % (t, e - s, kids))
