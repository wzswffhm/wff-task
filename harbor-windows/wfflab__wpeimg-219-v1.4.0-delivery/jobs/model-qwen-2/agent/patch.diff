+import struct
+blob = bytes(range(256)) * 3
+print(f"len={len(blob)}")
+# offset 0x3C = 60
+e_lfanew = struct.unpack_from('<I', blob, 0x3C)[0]
+print(f"e_lfanew = {e_lfanew} (0x{e_lfanew:X})")
+opt_offset = e_lfanew + 4 + 20
+checksum_field_offset = opt_offset + 64
+print(f"checksum_field_offset = {checksum_field_offset}")
+print(f"len(blob) - 4 = {len(blob) - 4}")
+print(f"In range? {0 <= checksum_field_offset <= len(blob) - 4}")
diff --git a/_debug3.py b/_debug3.py
new file mode 100644
index 0000000..feacfd3
--- /dev/null
+++ b/_debug3.py
@@ -0,0 +1,40 @@
+import struct, sys
+sys.path.insert(0, '.')
+from wpeimg.checksum import ChecksumAccumulator, compute_checksum
+
+blob = bytes(range(256)) * 3
+expected = compute_checksum(blob)
+print(f"Expected: 0x{expected:X}")
+
+# All at once
+acc = ChecksumAccumulator()
+acc.update(blob)
+v = acc.value(len(blob))
+print(f"All at once: 0x{v:X}, match={v==expected}")
+
+# Byte by byte
+acc = ChecksumAccumulator()
+for b in blob:
+    acc.update(bytes([b]))
+v = acc.value(len(blob))
+print(f"Byte by byte: 0x{v:X}, match={v==expected}")
+
+# Manual computation
+s = 0
+for i in range(0, len(blob), 2):
+    if i + 1 < len(blob):
+        word = blob[i] | (blob[i+1] << 8)
+    else:
+        word = blob[i]
+    s += word
+s = (s & 0xFFFF) + (s >> 16)
+s = (s & 0xFFFF) + (s >> 16)
+s += len(blob)
+print(f"Manual: 0x{s:X}")
+
+# Trace first few bytes byte-by-byte
+print("\nTracing byte-by-byte for first 8 bytes:")
+acc = ChecksumAccumulator()
+for i in range(8):
+    acc.update(bytes([blob[i]]))
+    print(f"  After byte {i} (0x{blob[i]:02X}): sum=0x{acc._sum:X}, pending={acc._pending_byte}")
