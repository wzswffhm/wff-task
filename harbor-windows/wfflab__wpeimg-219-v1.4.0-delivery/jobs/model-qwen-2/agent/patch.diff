new file mode 100644
index 0000000..f872d57
--- /dev/null
+++ b/_debug4.py
@@ -0,0 +1,47 @@
+import struct, sys
+sys.path.insert(0, '.')
+from wpeimg.checksum import ChecksumAccumulator, compute_checksum
+
+with open('assets/amd64-module.bin', 'rb') as f:
+    data = f.read()
+
+expected = compute_checksum(data)
+print(f"Expected (compute_checksum): 0x{expected:X}")
+
+# All at once via accumulator
+acc = ChecksumAccumulator()
+acc.update(data)
+v = acc.value(len(data))
+print(f"All at once accumulator: 0x{v:X}, match={v==expected}")
+
+# Byte by byte
+acc = ChecksumAccumulator()
+for i in range(0, len(data)):
+    acc.update(data[i:i+1])
+v = acc.value(len(data))
+print(f"Byte by byte accumulator: 0x{v:X}, match={v==expected}")
+
+# The difference is that compute_checksum zeros the checksum field!
+# The accumulator gets raw data with non-zero checksum field
+# So they SHOULD differ for real PE files
+
+# Let's verify: zero out checksum field and compare
+e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+opt_off = e_lfanew + 4 + 20
+cs_off = opt_off + 64
+print(f"\nChecksum field at offset 0x{cs_off:X}")
+print(f"Stored value: 0x{struct.unpack_from('<I', data, cs_off)[0]:X}")
+
+zeroed = bytearray(data)
+zeroed[cs_off:cs_off+4] = b'\x00\x00\x00\x00'
+
+acc = ChecksumAccumulator()
+acc.update(bytes(zeroed))
+v = acc.value(len(data))
+print(f"Zeroed all-at-once: 0x{v:X}, match_compute={v==expected}")
+
+acc = ChecksumAccumulator()
+for i in range(0, len(zeroed), 1):
+    acc.update(zeroed[i:i+1])
+v = acc.value(len(data))
+print(f"Zeroed byte-by-byte: 0x{v:X}, match_compute={v==expected}")
diff --git a/_debug_acc.py b/_debug_acc.py
new file mode 100644
index 0000000..cbb9756
--- /dev/null
+++ b/_debug_acc.py
@@ -0,0 +1,80 @@
+import struct, sys
+sys.path.insert(0, '.')
+from wpeimg.checksum import ChecksumAccumulator, compute_checksum
+
+# Simple test
+data = b'\x01\x02\x03\x04'
+
+# One-shot
+cs1 = compute_checksum(data)
+print(f"One-shot: 0x{cs1:X}")
+
+# Manual: words are 0x0201 and 0x0403
+# Sum = 0x0201 + 0x0403 = 0x0604
+# Fold: 0x0604
+# Add length: 0x0604 + 4 = 0x0608
+print(f"Expected (no checksum field skip): 0x{0x0604 + 4:X}")
+
+# Byte by byte
+acc = ChecksumAccumulator()
+for b in data:
+    acc.update(bytes([b]))
+cs2 = acc.value(len(data))
+print(f"Byte-by-byte: 0x{cs2:X}")
+
+# Two-byte chunks
+acc = ChecksumAccumulator()
+acc.update(data[:2])
+acc.update(data[2:])
+cs3 = acc.value(len(data))
+print(f"Two-byte chunks: 0x{cs3:X}")
+
+# All at once
+acc = ChecksumAccumulator()
+acc.update(data)
+cs4 = acc.value(len(data))
+print(f"All at once: 0x{cs4:X}")
+
+# Now test with real data but small
+with open('assets/i386-module.bin', 'rb') as f:
+    real_data = f.read()
+
+expected = compute_checksum(real_data)
+print(f"\nReal expected: 0x{expected:X}")
+
+acc = ChecksumAccumulator()
+acc.update(real_data)
+print(f"All at once: 0x{acc.value(len(real_data)):X}")
+
+acc = ChecksumAccumulator()
+for i in range(0, len(real_data), 2):
+    acc.update(real_data[i:i+2])
+print(f"2-byte chunks: 0x{acc.value(len(real_data)):X}")
+
+acc = ChecksumAccumulator()
+for i in range(0, len(real_data), 1):
+    acc.update(real_data[i:i+1])
+print(f"1-byte chunks: 0x{acc.value(len(real_data)):X}")
+
+# Trace the first few bytes
+print("\nFirst 8 bytes:", real_data[:8].hex())
+# Words: 5A4D 0090 0003 0000
+w0 = struct.unpack_from('<H', real_data, 0)[0]
+w1 = struct.unpack_from('<H', real_data, 2)[0]
+w2 = struct.unpack_from('<H', real_data, 4)[0]
+w3 = struct.unpack_from('<H', real_data, 6)[0]
+print(f"Words: {w0:04X} {w1:04X} {w2:04X} {w3:04X}")
+
+# Simulate byte-by-byte accumulation for first 8 bytes
+s = 0
+pending = None
+for i in range(8):
+    b = real_data[i]
+    if pending is not None:
+        word = pending | (b << 8)
+        s += word
+        print(f"  Combined: pending=0x{pending:02X}, b=0x{b:02X} -> word=0x{word:04X}, sum=0x{s:X}")
+        pending = None
+    else:
+        pending = b
+        print(f"  Pending: 0x{b:02X}")
diff --git a/_edge_test.py b/_edge_test.py
new file mode 100644
index 0000000..dd5e8b8
--- /dev/null
+++ b/_edge_test.py
@@ -0,0 +1,215 @@
+import struct, sys, io
+sys.path.insert(0, '.')
+from wpeimg import (
+    inspect, verify, compute_checksum, rva_to_offset, iter_sections,
+    signature_info, ChecksumAccumulator, WImgError,
+)
+
+def load(name):
+    with open('assets/' + name, 'rb') as f:
+        return f.read()
+
+# Test 1: Accumulator consistency across chunk sizes (on non-PE data where no field is zeroed)
+blob = bytes(range(256)) * 3
+expected_acc = None
+for chunk_size in [1, 2, 3, 7, 13, 64, 100, 256, 512, 1024]:
+    acc = ChecksumAccumulator()
+    for i in range(0, len(blob), chunk_size):
+        acc.update(blob[i:i+chunk_size])
+    got = acc.value(len(blob))
+    if expected_acc is None:
+        expected_acc = got
+    if got != expected_acc:
+        print(f"FAIL: chunk_size={chunk_size}, got=0x{got:X}, expected=0x{expected_acc:X}")
+        sys.exit(1)
+# Also verify accumulator matches compute_checksum for non-PE data
+assert expected_acc == compute_checksum(blob), "Accumulator != compute_checksum for non-PE data"
+print("Accumulator chunk test: OK")
+
+# Test 1b: Accumulator consistency on PE data (with checksum field zeroed manually)
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    d = load(name)
+    e_lfanew = struct.unpack_from('<I', d, 0x3C)[0]
+    opt_off = e_lfanew + 4 + 20
+    cs_off = opt_off + 64
+    zeroed = bytearray(d)
+    zeroed[cs_off:cs_off+4] = b'\x00\x00\x00\x00'
+    
+    expected_val = None
+    for chunk_size in [1, 2, 3, 7, 64, 256, 1024]:
+        acc = ChecksumAccumulator()
+        for i in range(0, len(zeroed), chunk_size):
+            acc.update(zeroed[i:i+chunk_size])
+        got = acc.value(len(zeroed))
+        if expected_val is None:
+            expected_val = got
+        if got != expected_val:
+            print(f"FAIL {name}: chunk_size={chunk_size}, got=0x{got:X}, expected=0x{expected_val:X}")
+            sys.exit(1)
+    # And this should match compute_checksum
+    assert expected_val == compute_checksum(d), f"{name}: accumulator != compute_checksum"
+    print(f"{name} accumulator consistency: OK")
+
+# Test 2: Verify checksum matches for both samples
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    d = load(name)
+    cs = compute_checksum(d)
+    e_lfanew = struct.unpack_from('<I', d, 0x3C)[0]
+    opt_off = e_lfanew + 4 + 20
+    stored = struct.unpack_from('<I', d, opt_off + 64)[0]
+    if cs != stored:
+        print(f"FAIL: {name} checksum mismatch: computed=0x{cs:X}, stored=0x{stored:X}")
+        sys.exit(1)
+    print(f"{name} checksum: 0x{cs:X} == stored 0x{stored:X}: OK")
+
+# Test 3: Verify that modifying data changes checksum
+d = bytearray(load('amd64-module.bin'))
+orig_cs = compute_checksum(bytes(d))
+d[0x500] ^= 0xFF
+new_cs = compute_checksum(bytes(d))
+if orig_cs == new_cs:
+    print("FAIL: checksum didn't change after modification")
+    sys.exit(1)
+print("Checksum sensitivity: OK")
+
+# Test 4: RVA mapping edge cases
+data64 = load('amd64-module.bin')
+assert rva_to_offset(data64, 0) == 0
+assert rva_to_offset(data64, 0x100) == 0x100
+assert rva_to_offset(data64, 0x3FF) == 0x3FF
+assert rva_to_offset(data64, 0x1000) == 0x400
+assert rva_to_offset(data64, 0x1410) == 0x400 + 0x410
+assert rva_to_offset(data64, -1) is None
+assert rva_to_offset(data64, 0xFFFF) is None
+print("RVA mapping: OK")
+
+# Test 5: Structure validation - raw_pointer + raw_size exceeds file
+d = bytearray(load('i386-module.bin'))
+sec_table_off = 0x178
+struct.pack_into('<I', d, sec_table_off + 16, 0x10000)
+try:
+    inspect(bytes(d))
+    print("FAIL: should detect raw data exceeding file")
+    sys.exit(1)
+except WImgError as e:
+    assert e.kind == 'structure', f"Expected structure, got {e.kind}"
+    print("Raw overflow detection: OK")
+
+# Test 6: Structure validation - section overlaps headers
+d = bytearray(load('i386-module.bin'))
+sec_table_off = 0x178
+struct.pack_into('<I', d, sec_table_off + 20, 0x200)
+try:
+    inspect(bytes(d))
+    print("FAIL: should detect section overlapping headers")
+    sys.exit(1)
+except WImgError as e:
+    assert e.kind == 'structure', f"Expected structure, got {e.kind}"
+    print("Header overlap detection: OK")
+
+# Test 7: Truncated input handling
+try:
+    inspect(b"MZ")
+except WImgError as e:
+    assert e.kind == 'truncated', f"Expected truncated, got {e.kind}"
+    print("Truncated DOS header: OK")
+
+# Test 8: Signature info on i386 (no signature)
+sig = signature_info(load('i386-module.bin'))
+assert sig['present'] == False
+assert sig['offset'] == 0
+assert sig['certificate_count'] == 0
+assert sig['signer_count'] == 0
+assert sig['content_type'] is None
+print("No-signature info: OK")
+
+# Test 9: Signature info on amd64 (has signature)
+sig = signature_info(load('amd64-module.bin'))
+assert sig['present'] == True
+assert sig['certificate_type'] == 0x0002
+assert sig['content_type'] == '1.2.840.113549.1.7.2'
+assert 'sha256' in sig['digest_algorithms']
+assert sig['certificate_count'] == 4
+assert sig['signer_count'] == 1
+print("Signature info: OK")
+
+# Test 10: Data directories length is always 16
+info64 = inspect(load('amd64-module.bin'))
+assert len(info64['data_directories']) == 16
+info32 = inspect(load('i386-module.bin'))
+assert len(info32['data_directories']) == 16
+print("Directory count: OK")
+
+# Test 11: iter_sections doesn't read entire file
+class TrackingIO(io.BytesIO):
+    def __init__(self, data):
+        super().__init__(data)
+        self.max_single_read = 0
+        self.total_reads = 0
+    def read(self, n=-1):
+        if n == -1 or n is None:
+            raise RuntimeError("Unbounded read!")
+        self.total_reads += 1
+        self.max_single_read = max(self.max_single_read, n)
+        return super().read(n)
+
+t = TrackingIO(load('i386-module.bin'))
+secs = list(iter_sections(t))
+assert len(secs) == 2
+print(f"iter_sections: {t.total_reads} reads, max single read={t.max_single_read} bytes: OK")
+
+# Test 12: has_authenticode_signature
+assert inspect(load('amd64-module.bin'))['has_authenticode_signature'] == True
+assert inspect(load('i386-module.bin'))['has_authenticode_signature'] == False
+print("Authenticode detection: OK")
+
+# Test 13: Overlapping virtual ranges
+d = bytearray(load('i386-module.bin'))
+sec_table_off = 0x178
+struct.pack_into("<I", d, sec_table_off + 40 + 12, 0x1000)
+try:
+    inspect(bytes(d))
+    print("FAIL: should have raised for overlapping virtual ranges")
+    sys.exit(1)
+except WImgError as e:
+    assert e.kind == 'structure'
+    print("Virtual overlap detection: OK")
+
+# Test 14: Overlapping file ranges
+d = bytearray(load('amd64-module.bin'))
+# Section table at 0x218, each section 40 bytes
+# Section 0: raw_pointer=0x400, raw_size=0x1200
+# Section 1: raw_pointer=0x1600, raw_size=0x1000
+# Change section 1 raw_pointer to 0x400 (overlap with section 0)
+sec_table_off = 0x218
+struct.pack_into("<I", d, sec_table_off + 40 + 20, 0x400)
+try:
+    inspect(bytes(d))
+    print("FAIL: should have raised for overlapping file ranges")
+    sys.exit(1)
+except WImgError as e:
+    assert e.kind == 'structure'
+    print("File overlap detection: OK")
+
+# Test 15: Checksum=0 skips verification
+d = bytearray(load('amd64-module.bin'))
+e_lfanew = struct.unpack_from('<I', d, 0x3C)[0]
+opt_off = e_lfanew + 4 + 20
+cs_off = opt_off + 64
+struct.pack_into('<I', d, cs_off, 0)  # Set checksum to 0
+d[0x500] ^= 0xFF  # Corrupt data
+result = verify(bytes(d))
+assert result == True, "Should pass when checksum is 0"
+print("Zero checksum skip: OK")
+
+# Test 16: Wrong checksum fails verify
+d = bytearray(load('amd64-module.bin'))
+e_lfanew = struct.unpack_from('<I', d, 0x3C)[0]
+opt_off = e_lfanew + 4 + 20
+cs_off = opt_off + 64
+struct.pack_into('<I', d, cs_off, 0xDEADBEEF)
+result = verify(bytes(d))
+assert result == False, "Should fail with wrong checksum"
+print("Wrong checksum fails: OK")
+
+print("\n=== ALL EDGE CASE TESTS PASSED ===")
