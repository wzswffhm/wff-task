diff --git a/tmp/analyze.py b/tmp/analyze.py
new file mode 100644
index 0000000..ae9b432
--- /dev/null
+++ b/tmp/analyze.py
@@ -0,0 +1,56 @@
+import struct, sys
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    with open('assets/' + name, 'rb') as f:
+        data = f.read()
+    print('=== %s (%d bytes) ===' % (name, len(data)))
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    print('  e_lfanew = 0x%X' % e_lfanew)
+    sig = data[e_lfanew:e_lfanew+4]
+    print('  NT sig = %r' % sig)
+    coff_off = e_lfanew + 4
+    machine, nsec, stamp, symtab, nsym, size_opt, chars = struct.unpack_from('<HHIIIHH', data, coff_off)
+    print('  Machine=0x%X, NumSections=%d, SizeOfOptionalHeader=%d' % (machine, nsec, size_opt))
+    opt_off = coff_off + 20
+    magic = struct.unpack_from('<H', data, opt_off)[0]
+    print('  Optional Magic=0x%X' % magic)
+    if magic == 0x10B:
+        entry = struct.unpack_from('<I', data, opt_off + 16)[0]
+        image_base = struct.unpack_from('<I', data, opt_off + 28)[0]
+        section_align = struct.unpack_from('<I', data, opt_off + 32)[0]
+        file_align = struct.unpack_from('<I', data, opt_off + 36)[0]
+        size_of_image = struct.unpack_from('<I', data, opt_off + 56)[0]
+        size_of_headers = struct.unpack_from('<I', data, opt_off + 60)[0]
+        checksum = struct.unpack_from('<I', data, opt_off + 64)[0]
+        num_rva = struct.unpack_from('<I', data, opt_off + 92)[0]
+        dir_offset = opt_off + 96
+    elif magic == 0x20B:
+        entry = struct.unpack_from('<I', data, opt_off + 16)[0]
+        image_base = struct.unpack_from('<Q', data, opt_off + 24)[0]
+        section_align = struct.unpack_from('<I', data, opt_off + 32)[0]
+        file_align = struct.unpack_from('<I', data, opt_off + 36)[0]
+        size_of_image = struct.unpack_from('<I', data, opt_off + 56)[0]
+        size_of_headers = struct.unpack_from('<I', data, opt_off + 60)[0]
+        checksum = struct.unpack_from('<I', data, opt_off + 64)[0]
+        num_rva = struct.unpack_from('<I', data, opt_off + 108)[0]
+        dir_offset = opt_off + 112
+    else:
+        print('Unknown magic'); continue
+    print('  EntryPoint=0x%X, ImageBase=0x%X' % (entry, image_base))
+    print('  SectionAlign=0x%X, FileAlign=0x%X' % (section_align, file_align))
+    print('  SizeOfImage=0x%X, SizeOfHeaders=0x%X' % (size_of_image, size_of_headers))
+    print('  CheckSum=0x%X, NumberOfRvaAndSizes=%d' % (checksum, num_rva))
+    print('  Data directories start at offset 0x%X' % dir_offset)
+    sec_table_off = opt_off + size_opt
+    print('  Section table starts at 0x%X' % sec_table_off)
+    for i in range(nsec):
+        off = sec_table_off + i * 40
+        name_bytes = data[off:off+8]
+        vs, va, rs, rp = struct.unpack_from('<IIII', data, off + 8)
+        ch = struct.unpack_from('<I', data, off + 36)[0]
+        print('  [%d] name=%r VA=0x%X VSize=0x%X RawPtr=0x%X RawSize=0x%X Chars=0x%X' % (i, name_bytes, va, vs, rp, rs, ch))
+    print('  Data directories:')
+    dir_names = ['export','import','resource','exception','certificate','relocation','debug','architecture','global_ptr','tls','load_config','bound_import','iat','delay_import','clr_runtime','reserved']
+    for i in range(min(num_rva, 16)):
+        va, sz = struct.unpack_from('<II', data, dir_offset + i*8)
+        print('    [%d] %s: VA=0x%X Size=0x%X' % (i, dir_names[i], va, sz))
+    print()
