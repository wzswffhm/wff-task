index 0000000..908c30b
--- /dev/null
+++ b/_tmp_test_checksum.py
@@ -0,0 +1,34 @@
+import struct
+import sys
+sys.path.insert(0, '.')
+
+from wpeimg.checksum import compute_checksum, ChecksumAccumulator
+
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    with open('assets/' + name, 'rb') as f:
+        data = f.read()
+    
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    opt_off = e_lfanew + 4 + 20
+    stored = struct.unpack_from('<I', data, opt_off + 64)[0]
+    
+    computed = compute_checksum(data)
+    print('%s: stored=%#x computed=%#x match=%s' % (name, stored, computed, stored == computed))
+
+# Test incremental vs one-shot
+blob = bytes(range(256)) * 3
+acc = ChecksumAccumulator()
+for start in range(0, len(blob), 100):
+    acc.update(blob[start:start+100])
+print('Incremental matches one-shot:', acc.value(len(blob)) == compute_checksum(blob))
+
+# Test that changing CheckSum field doesn't affect result
+with open('assets/amd64-module.bin', 'rb') as f:
+    data = bytearray(f.read())
+e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+opt_off = e_lfanew + 4 + 20
+orig_checksum = compute_checksum(bytes(data))
+# Modify the CheckSum field
+struct.pack_into('<I', data, opt_off + 64, 0xDEADBEEF)
+new_checksum = compute_checksum(bytes(data))
+print('Checksum stable after modifying field:', orig_checksum == new_checksum)
diff --git a/_tmp_verify.py b/_tmp_verify.py
new file mode 100644
index 0000000..6fe5e81
--- /dev/null
+++ b/_tmp_verify.py
@@ -0,0 +1,115 @@
+import sys
+sys.path.insert(0, '.')
+
+from wpeimg import (
+    inspect, verify, rva_to_offset, compute_checksum, 
+    iter_sections, signature_info, WImgError, KINDS,
+    ChecksumAccumulator,
+)
+import io
+import struct
+
+def load(name):
+    with open('assets/' + name, 'rb') as f:
+        return f.read()
+
+print("=== A. Image Description ===")
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    data = load(name)
+    info = inspect(data)
+    print(f"\n{name}:")
+    print(f"  machine={info['machine']:#x}")
+    print(f"  is_pe32_plus={info['is_pe32_plus']}")
+    print(f"  number_of_sections={info['number_of_sections']}")
+    print(f"  entry_point_rva={info['entry_point_rva']:#x}")
+    print(f"  image_base={info['image_base']:#x}")
+    print(f"  section_alignment={info['section_alignment']:#x}")
+    print(f"  file_alignment={info['file_alignment']:#x}")
+    print(f"  size_of_image={info['size_of_image']:#x}")
+    print(f"  size_of_headers={info['size_of_headers']:#x}")
+    print(f"  checksum={info['checksum']:#x}")
+    print(f"  has_authenticode_signature={info['has_authenticode_signature']}")
+    print(f"  sections:")
+    for s in info['sections']:
+        print(f"    {s['name']}: VA={s['virtual_address']:#x} VSize={s['virtual_size']:#x} RawPtr={s['raw_pointer']:#x} RawSize={s['raw_size']:#x}")
+    print(f"  data_directories ({len(info['data_directories'])} entries):")
+    for d in info['data_directories']:
+        if d['virtual_address'] or d['size']:
+            print(f"    {d['name']}: VA={d['virtual_address']:#x} Size={d['size']:#x}")
+
+print("\n=== B. Checksum ===")
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    data = load(name)
+    cs = compute_checksum(data)
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    stored = struct.unpack_from('<I', data, e_lfanew + 4 + 20 + 64)[0]
+    print(f"{name}: computed={cs:#x} stored={stored:#x} match={cs == stored}")
+
+print("\n=== C. RVA Mapping ===")
+data = load('i386-module.bin')
+# .text starts at VA=0x1000, raw_pointer=0x400
+rva = 0x1000
+off = rva_to_offset(data, rva)
+print(f"i386 RVA={rva:#x} -> offset={off:#x} (expected 0x400)")
+# Header RVA
+off = rva_to_offset(data, 0x100)
+print(f"i386 RVA=0x100 -> offset={off:#x} (expected 0x100)")
+# Negative
+off = rva_to_offset(data, -1)
+print(f"i386 RVA=-1 -> {off} (expected None)")
+
+data = load('amd64-module.bin')
+off = rva_to_offset(data, 0x1000)
+print(f"amd64 RVA=0x1000 -> offset={off:#x} (expected 0x400)")
+
+print("\n=== D. Structure Validation ===")
+# Test that verify returns True for good images
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    data = load(name)
+    print(f"{name}: verify={verify(data)}")
+
+print("\n=== E. Error Classification ===")
+# DOS error
+try:
+    inspect(b"XX" + b"\0" * 120)
+except WImgError as e:
+    print(f"No MZ: kind={e.kind} (expected 'dos')")
+
+# Signature error
+data = bytearray(load('i386-module.bin'))
+struct.pack_into('<I', data, 0x3C, 0x80)  # valid e_lfanew
+data[0x80:0x84] = b"XX\x00\x00"  # bad PE sig
+try:
+    inspect(bytes(data))
+except WImgError as e:
+    print(f"Bad PE sig: kind={e.kind} (expected 'signature')")
+
+# Truncated
+try:
+    inspect(b"MZ" + b"\0" * 10)
+except WImgError as e:
+    print(f"Truncated: kind={e.kind} (expected 'truncated')")
+
+print("\n=== F. Streaming ===")
+data = load('i386-module.bin')
+sections = list(iter_sections(io.BytesIO(data)))
+print(f"Streamed sections: {[s['name'] for s in sections]}")
+
+print("\n=== F2. Signature Info ===")
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    data = load(name)
+    si = signature_info(data)
+    print(f"\n{name}:")
+    for k, v in si.items():
+        print(f"  {k}: {v}")
+
+print("\n=== G. __all__ check ===")
+import wpeimg
+expected = [
+    "ChecksumAccumulator", "KIND_CHECKSUM", "KIND_DOS", "KIND_OPTIONAL",
+    "KIND_SIGNATURE", "KIND_STRUCTURE", "KIND_TRUNCATED", "KINDS", "WImgError",
+    "compute_checksum", "inspect", "iter_sections", "rva_to_offset", "signature_info",
+    "verify",
+]
+print(f"__all__ matches: {sorted(wpeimg.__all__) == sorted(expected)}")
+print(f"KINDS: {wpeimg.KINDS}")
