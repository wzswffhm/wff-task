--- /dev/null
+++ b/_tmp_analyze.py
@@ -0,0 +1,54 @@
+import struct
+
+def analyze(name):
+    with open('assets/'+name,'rb') as f:
+        data = f.read()
+    print('=== %s === size=%d' % (name, len(data)))
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    coff = e_lfanew + 4
+    machine, nsec, _s, _st, _ns, size_opt, chars = struct.unpack_from('<HHIIIHH', data, coff)
+    opt_off = coff + 20
+    magic = struct.unpack_from('<H', data, opt_off)[0]
+    
+    if magic == 0x10B:
+        entry = struct.unpack_from('<I', data, opt_off + 16)[0]
+        image_base = struct.unpack_from('<I', data, opt_off + 28)[0]
+        section_align = struct.unpack_from('<I', data, opt_off + 32)[0]
+        file_align = struct.unpack_from('<I', data, opt_off + 36)[0]
+        size_of_image = struct.unpack_from('<I', data, opt_off + 56)[0]
+        size_of_headers = struct.unpack_from('<I', data, opt_off + 60)[0]
+        checksum = struct.unpack_from('<I', data, opt_off + 64)[0]
+        num_rva = struct.unpack_from('<I', data, opt_off + 92)[0]
+        dir_start = opt_off + 96
+    else:
+        entry = struct.unpack_from('<I', data, opt_off + 16)[0]
+        image_base = struct.unpack_from('<Q', data, opt_off + 24)[0]
+        section_align = struct.unpack_from('<I', data, opt_off + 32)[0]
+        file_align = struct.unpack_from('<I', data, opt_off + 36)[0]
+        size_of_image = struct.unpack_from('<I', data, opt_off + 56)[0]
+        size_of_headers = struct.unpack_from('<I', data, opt_off + 60)[0]
+        checksum = struct.unpack_from('<I', data, opt_off + 64)[0]
+        num_rva = struct.unpack_from('<I', data, opt_off + 108)[0]
+        dir_start = opt_off + 112
+    
+    print('ImageBase=%#x Entry=%#x SecAlign=%#x FileAlign=%#x' % (image_base, entry, section_align, file_align))
+    print('SizeOfImage=%#x SizeOfHeaders=%#x CheckSum=%#x NumRvaAndSizes=%d' % (size_of_image, size_of_headers, checksum, num_rva))
+    
+    names = ['export','import','resource','exception','certificate','relocation','debug','architecture','global_ptr','tls','load_config','bound_import','iat','delay_import','clr_runtime','reserved']
+    print('Directories:')
+    for i in range(min(num_rva, 16)):
+        va, sz = struct.unpack_from('<II', data, dir_start + i * 8)
+        print('  [%d] %s: VA=%#x Size=%#x' % (i, names[i], va, sz))
+    
+    sec_table_off = opt_off + size_opt
+    print('Section table at %#x:' % sec_table_off)
+    for i in range(nsec):
+        off = sec_table_off + i * 40
+        name_raw = data[off:off+8]
+        vs, va, rs, rp = struct.unpack_from('<IIII', data, off+8)
+        ch = struct.unpack_from('<I', data, off+36)[0]
+        print('  [%d] %r VA=%#x VSize=%#x RawPtr=%#x RawSize=%#x Chars=%#x' % (i, name_raw, va, vs, rp, rs, ch))
+    print()
+
+analyze('amd64-module.bin')
+analyze('i386-module.bin')
diff --git a/_tmp_cert.py b/_tmp_cert.py
new file mode 100644
index 0000000..66e6869
--- /dev/null
+++ b/_tmp_cert.py
@@ -0,0 +1,113 @@
+import struct
+
+with open('assets/amd64-module.bin', 'rb') as f:
+    data = f.read()
+
+# Certificate table at offset 0x3600, size 0x33f8
+cert_off = 0x3600
+cert_size = 0x33f8
+
+print('File size:', len(data))
+print('Cert table: offset=%#x size=%#x' % (cert_off, cert_size))
+print('Cert table end:', cert_off + cert_size)
+
+# WIN_CERTIFICATE structure
+dwLength = struct.unpack_from('<I', data, cert_off)[0]
+wRevision = struct.unpack_from('<H', data, cert_off + 4)[0]
+wCertificateType = struct.unpack_from('<H', data, cert_off + 6)[0]
+
+print('WIN_CERTIFICATE:')
+print('  dwLength=%#x' % dwLength)
+print('  wRevision=%#x' % wRevision)
+print('  wCertificateType=%#x' % wCertificateType)
+
+# The body is PKCS#7 SignedData DER
+der_start = cert_off + 8
+der_data = data[der_start:der_start + dwLength - 8]
+print('DER body length:', len(der_data))
+print('First 100 bytes of DER:', der_data[:100].hex())
+
+# Parse ASN.1 DER to find content type
+# ContentInfo ::= SEQUENCE { contentType OID, content [0] EXPLICIT ... }
+def parse_tag_length(data, offset):
+    tag = data[offset]
+    offset += 1
+    length = data[offset]
+    offset += 1
+    if length & 0x80:
+        num_bytes = length & 0x7F
+        length = 0
+        for i in range(num_bytes):
+            length = (length << 8) | data[offset]
+            offset += 1
+    return tag, length, offset
+
+def parse_oid(data, offset, length):
+    """Parse an OID and return dot-notation string."""
+    end = offset + length
+    components = []
+    first = data[offset]
+    components.append(first // 40)
+    components.append(first % 40)
+    offset += 1
+    value = 0
+    while offset < end:
+        byte = data[offset]
+        value = (value << 7) | (byte & 0x7F)
+        offset += 1
+        if not (byte & 0x80):
+            components.append(value)
+            value = 0
+    return '.'.join(str(c) for c in components)
+
+tag, length, next_off = parse_tag_length(der_data, 0)
+print('\nOuter SEQUENCE: tag=%#x length=%d' % (tag, length))
+
+# Inside ContentInfo SEQUENCE: first element is OID (contentType)
+tag2, length2, next_off2 = parse_tag_length(der_data, next_off)
+print('ContentType: tag=%#x length=%d' % (tag2, length2))
+if tag2 == 0x06:  # OID
+    oid_str = parse_oid(der_data, next_off2, length2)
+    print('ContentType OID:', oid_str)
+
+# Now let's look at the SignedData content
+# ContentInfo.content is [0] EXPLICIT
+tag3, length3, next_off3 = parse_tag_length(der_data, next_off2 + length2)
+print('Content wrapper: tag=%#x length=%d' % (tag3, length3))
+
+# Inside the explicit tag, there's a SEQUENCE (SignedData)
+tag4, length4, next_off4 = parse_tag_length(der_data, next_off3)
+print('SignedData SEQUENCE: tag=%#x length=%d' % (tag4, length4))
+
+# SignedData ::= SEQUENCE {
+#   version INTEGER,
+#   digestAlgorithms SET OF AlgorithmIdentifier,
+#   contentInfo ContentInfo,
+#   certificates [0] IMPLICIT OPTIONAL,
+#   crls [1] IMPLICIT OPTIONAL,
+#   signerInfos SET OF SignerInfo
+# }
+
+# Version
+tag_v, len_v, off_v = parse_tag_length(der_data, next_off4)
+print('Version: tag=%#x length=%d value=%d' % (tag_v, len_v, der_data[off_v] if len_v == 1 else -1))
+off_after_version = off_v + len_v
+
+# DigestAlgorithms SET
+tag_da, len_da, off_da = parse_tag_length(der_data, off_after_version)
+print('DigestAlgorithms SET: tag=%#x length=%d' % (tag_da, len_da))
+
+# Parse algorithm identifiers inside the SET
+pos = off_da
+alg_end = off_da + len_da
+algorithms = []
+while pos < alg_end:
+    tag_ai, len_ai, off_ai = parse_tag_length(der_data, pos)
+    # AlgorithmIdentifier ::= SEQUENCE { algorithm OID, parameters ANY OPTIONAL }
+    tag_oid, len_oid, off_oid = parse_tag_length(der_data, off_ai)
+    if tag_oid == 0x06:
+        alg_oid = parse_oid(der_data, off_oid, len_oid)
+        algorithms.append(alg_oid)
+    pos = off_ai + len_ai
+
+print('Digest algorithms:', algorithms)
diff --git a/_tmp_cert2.py b/_tmp_cert2.py
new file mode 100644
index 0000000..d8dbe3b
--- /dev/null
+++ b/_tmp_cert2.py
@@ -0,0 +1,107 @@
+import struct
+
+with open('assets/amd64-module.bin', 'rb') as f:
+    data = f.read()
+
+cert_off = 0x3600
+dwLength = struct.unpack_from('<I', data, cert_off)[0]
+der_start = cert_off + 8
+der_data = data[der_start:der_start + dwLength - 8]
+
+def parse_tag_length(data, offset):
+    tag = data[offset]
+    offset += 1
+    length = data[offset]
+    offset += 1
+    if length & 0x80:
+        num_bytes = length & 0x7F
+        length = 0
+        for i in range(num_bytes):
+            length = (length << 8) | data[offset]
+            offset += 1
+    return tag, length, offset
+
+def parse_oid(data, offset, length):
+    end = offset + length
+    components = []
+    first = data[offset]
+    components.append(first // 40)
+    components.append(first % 40)
+    offset += 1
+    value = 0
+    while offset < end:
+        byte = data[offset]
+        value = (value << 7) | (byte & 0x7F)
+        offset += 1
+        if not (byte & 0x80):
+            components.append(value)
+            value = 0
+    return '.'.join(str(c) for c in components)
+
+def skip_element(data, offset):
+    """Skip one TLV element, return offset after it."""
+    tag, length, content_off = parse_tag_length(data, offset)
+    return content_off + length
+
+# Navigate to SignedData SEQUENCE content
+tag, length, off = parse_tag_length(der_data, 0)  # ContentInfo SEQUENCE
+tag, length, off = parse_tag_length(der_data, off)  # contentType OID
+oid_end = off + length
+tag, length, off = parse_tag_length(der_data, oid_end)  # [0] EXPLICIT wrapper
+tag, length, off = parse_tag_length(der_data, off)  # SignedData SEQUENCE
+
+sd_content_start = off
+sd_content_end = off + length
+
+pos = sd_content_start
+
+# Version INTEGER
+tag, length, pos = parse_tag_length(der_data, pos)
+pos = pos + length
+
+# DigestAlgorithms SET
+tag, length, da_start = parse_tag_length(der_data, pos)
+da_end = da_start + length
+pos = da_end
+
+# ContentInfo SEQUENCE
+tag, length, ci_start = parse_tag_length(der_data, pos)
+ci_end = ci_start + length
+pos = ci_end
+
+# Now we might have:
+# certificates [0] IMPLICIT OPTIONAL
+# crls [1] IMPLICIT OPTIONAL  
+# signerInfos SET OF SignerInfo
+
+cert_count = 0
+signer_count = 0
+
+while pos < sd_content_end:
+    tag, length, content_off = parse_tag_length(der_data, pos)
+    
+    if tag == 0xA0:  # [0] certificates
+        # This is a SET OF Certificate
+        cert_set_start = content_off
+        cert_set_end = content_off + length
+        cpos = cert_set_start
+        while cpos < cert_set_end:
+            cpos = skip_element(der_data, cpos)
+            cert_count += 1
+        print('Found certificates [0], count=%d' % cert_count)
+    elif tag == 0xA1:  # [1] crls
+        print('Found CRLs [1]')
+    elif tag == 0x31:  # SET (signerInfos)
+        si_start = content_off
+        si_end = content_off + length
+        spos = si_start
+        while spos < si_end:
+            spos = skip_element(der_data, spos)
+            signer_count += 1
+        print('Found signerInfos SET, count=%d' % signer_count)
+    else:
+        print('Unknown tag %#x at pos %d' % (tag, pos))
+    
+    pos = content_off + length
+
+print('Total: cert_count=%d signer_count=%d' % (cert_count, signer_count))
diff --git a/_tmp_checksum.py b/_tmp_checksum.py
new file mode 100644
index 0000000..3ad976f
--- /dev/null
+++ b/_tmp_checksum.py
@@ -0,0 +1,47 @@
+import struct
+
+def pe_checksum(data, checksum_offset):
+    """Compute Windows PE image checksum."""
+    # Sum all 16-bit words, skipping the 4-byte CheckSum field
+    total = 0
+    length = len(data)
+    
+    # Process as 16-bit words
+    i = 0
+    while i < length:
+        # Skip the CheckSum field (4 bytes at checksum_offset)
+        if i == checksum_offset:
+            i += 4
+            continue
+        
+        if i + 1 < length:
+            word = struct.unpack_from('<H', data, i)[0]
+        else:
+            # Odd byte at end
+            word = data[i]
+        
+        total += word
+        # Fold carries
+        total = (total & 0xFFFF) + (total >> 16)
+        i += 2
+    
+    # Final fold
+    total = (total & 0xFFFF) + (total >> 16)
+    # Add file length
+    total += length
+    return total & 0xFFFFFFFF
+
+for name in ['amd64-module.bin', 'i386-module.bin']:
+    with open('assets/' + name, 'rb') as f:
+        data = f.read()
+    
+    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+    coff = e_lfanew + 4
+    opt_off = coff + 20
+    magic = struct.unpack_from('<H', data, opt_off)[0]
+    
+    stored = struct.unpack_from('<I', data, opt_off + 64)[0]
+    checksum_field_offset = opt_off + 64
+    
+    computed = pe_checksum(data, checksum_field_offset)
+    print('%s: stored=%#x computed=%#x match=%s' % (name, stored, computed, stored == computed))
diff --git a/_tmp_debug_acc.py b/_tmp_debug_acc.py
new file mode 100644
index 0000000..baf2ac7
--- /dev/null
+++ b/_tmp_debug_acc.py
@@ -0,0 +1,44 @@
+import sys, struct
+sys.path.insert(0, '.')
+from wpeimg.checksum import ChecksumAccumulator, compute_checksum
+
+# Simple test: bytes [0, 1, 2, 3]
+data = bytes([0, 1, 2, 3])
+
+# One-shot
+acc1 = ChecksumAccumulator()
+acc1.update(data)
+print("One-shot:", hex(acc1.value(len(data))))
+
+# Two chunks of 2
+acc2 = ChecksumAccumulator()
+acc2.update(data[:2])
+acc2.update(data[2:])
+print("Two chunks:", hex(acc2.value(len(data))))
+
+# Four chunks of 1
+acc3 = ChecksumAccumulator()
+for b in data:
+    acc3.update(bytes([b]))
+print("Four chunks:", hex(acc3.value(len(data))))
+
+# Manual calculation: words are (0x0100), (0x0302) -> sum = 0x0402
+# Plus length 4 -> 0x0406
+print("Expected: 0x406")
+
+# Now test with actual PE file but without skipping checksum field
+with open('assets/amd64-module.bin', 'rb') as f:
+    data = f.read()
+
+# Full checksum including the CheckSum field
+acc_full = ChecksumAccumulator()
+acc_full.update(data)
+print("\nFull file one-shot:", hex(acc_full.value(len(data))))
+
+acc_full2 = ChecksumAccumulator()
+for i in range(0, len(data), 100):
+    acc_full2.update(data[i:i+100])
+print("Full file chunked:", hex(acc_full2.value(len(data))))
+
+# They should match
+print("Match:", acc_full.value(len(data)) == acc_full2.value(len(data)))
diff --git a/_tmp_edge_cases.py b/_tmp_edge_cases.py
new file mode 100644
index 0000000..df6832c
--- /dev/null
+++ b/_tmp_edge_cases.py
@@ -0,0 +1,173 @@
+import sys, struct, io
+sys.path.insert(0, '.')
+
+from wpeimg import (
+    inspect, verify, rva_to_offset, compute_checksum, 
+    iter_sections, signature_info, WImgError,
+    ChecksumAccumulator, KIND_STRUCTURE, KIND_CHECKSUM,
+)
+
+def load(name):
+    with open('assets/' + name, 'rb') as f:
+        return f.read()
+
+print("=== Structure validation edge cases ===")
+
+# 1. Section raw data extends past file end
+data = bytearray(load('i386-module.bin'))
+e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
+opt_off = e_lfanew + 4 + 20
+size_opt = struct.unpack_from('<H', data, e_lfanew + 4 + 16)[0]
+sec_table = opt_off + size_opt
+# Modify first section's raw_size to be huge
+struct.pack_into('<I', data, sec_table + 8 + 8, 999999)  # raw_size
+try:
+    inspect(bytes(data))
+    print("FAIL: should have raised for oversized section")
+except WImgError as e:
+    print(f"OK: oversized section -> kind={e.kind}")
+
+# 2. Overlapping virtual ranges
+data = bytearray(load('i386-module.bin'))
+sec_table = opt_off + size_opt
+# Make second section start at same VA as first
+struct.pack_into('<I', data, sec_table + 40 + 8 + 4, 0x1000)  # virtual_address of section 2
+try:
+    inspect(bytes(data))
+    print("FAIL: should have raised for overlapping virtual ranges")
+except WImgError as e:
+    print(f"OK: overlapping VA -> kind={e.kind}")
+
+# 3. Overlapping file ranges
+data = bytearray(load('i386-module.bin'))
+sec_table = opt_off + size_opt
+# Make second section's raw_pointer overlap with first
+struct.pack_into('<I', data, sec_table + 40 + 8 + 8, 0x400)  # raw_pointer of section 2
+try:
+    inspect(bytes(data))
+    print("FAIL: should have raised for overlapping file ranges")
+except WImgError as e:
+    print(f"OK: overlapping file -> kind={e.kind}")
+
+# 4. Section raw data in headers
+data = bytearray(load('i386-module.bin'))
+sec_table = opt_off + size_opt
+# Set raw_pointer to 0 (within headers)
+struct.pack_into('<I', data, sec_table + 8 + 12, 0x0)  # raw_pointer of section 1
+try:
+    inspect(bytes(data))
+    print("FAIL: should have raised for section in headers")
+except WImgError as e:
+    print(f"OK: section in headers -> kind={e.kind}")
+
+# 5. VA not aligned
+data = bytearray(load('i386-module.bin'))
+sec_table = opt_off + size_opt
+# Set virtual_address to non-aligned value
+struct.pack_into('<I', data, sec_table + 8 + 4, 0x1001)  # virtual_address
+try:
+    inspect(bytes(data))
+    print("FAIL: should have raised for unaligned VA")
+except WImgError as e:
+    print(f"OK: unaligned VA -> kind={e.kind}")
+
+# 6. Raw pointer not aligned
+data = bytearray(load('i386-module.bin'))
+sec_table = opt_off + size_opt
+# Set raw_pointer to non-aligned value
+struct.pack_into('<I', data, sec_table + 8 + 12, 0x401)  # raw_pointer
+try:
+    inspect(bytes(data))
+    print("FAIL: should have raised for unaligned raw_pointer")
+except WImgError as e:
+    print(f"OK: unaligned raw_pointer -> kind={e.kind}")
+
+# 7. Checksum mismatch
+data = bytearray(load('i386-module.bin'))
+struct.pack_into('<I', data, opt_off + 64, 0xDEADBEEF)  # wrong checksum
+try:
+    inspect(bytes(data))
+    print("FAIL: should have raised for bad checksum")
+except WImgError as e:
+    print(f"OK: bad checksum -> kind={e.kind}")
+
+# 8. Zero checksum should skip check
+data = bytearray(load('i386-module.bin'))
+struct.pack_into('<I', data, opt_off + 64, 0)  # zero checksum
+result = verify(bytes(data))
+print(f"Zero checksum: verify={result} (expected True)")
+
+print("\n=== Streaming is lazy ===")
+class CountingBytesIO(io.BytesIO):
+    def __init__(self, data):
+        super().__init__(data)
+        self.total_read = 0
+    def read(self, n=-1):
+        if n == -1 or n is None:
+            raise RuntimeError("should not do full read")
+        chunk = super().read(n)
+        self.total_read += len(chunk)
+        return chunk
+
+data = load('i386-module.bin')
+f = CountingBytesIO(data)
+gen = iter_sections(f)
+first = next(gen)
+bytes_before_second = f.total_read
+second = next(gen)
+print(f"First section: {first['name']}")
+print(f"Bytes read before getting first section: {bytes_before_second}")
+print(f"Total bytes read after both sections: {f.total_read}")
+print(f"File size: {len(data)}")
+print(f"Lazy: {f.total_read < len(data)}")
+
+# Verify that reading bytes before first section is bounded
+# and doesn't change when file is extended
+data2 = data + b'\x00' * (len(data) * 8)  # extend file by 8x
+f2 = CountingBytesIO(data2)
+gen2 = iter_sections(f2)
+first2 = next(gen2)
+bytes_before_second2 = f2.total_read
+print(f"Extended file: bytes before first section = {bytes_before_second2}")
+print(f"Same as original: {bytes_before_second == bytes_before_second2}")
+
+print("\n=== RVA mapping edge cases ===")
+data = load('amd64-module.bin')
+# RVA in header region
+off = rva_to_offset(data, 0)
+print(f"RVA 0 -> {off} (expected 0)")
+off = rva_to_offset(data, 0x3FF)
+print(f"RVA 0x3FF -> {off} (expected 0x3FF)")
+
+# RVA beyond all sections
+off = rva_to_offset(data, 0xFFFF)
+print(f"RVA 0xFFFF -> {off} (expected None)")
+
+# RVA in a section but beyond raw_size
+# .text has VSize=0x1068, RawSize=0x1200
+# Try RVA at .text VA + raw_size (should be None since offset_in_section >= raw_size)
+off = rva_to_offset(data, 0x1000 + 0x1200)
+print(f"RVA 0x2200 (.text+raw_size) -> {off} (expected None)")
+
+# RVA within .text raw data
+off = rva_to_offset(data, 0x1000 + 0x100)
+print(f"RVA 0x1100 (.text+0x100) -> {off:#x} (expected 0x500)")
+
+print("\n=== Accumulator incremental consistency ===")
+import os
+data = load('amd64-module.bin')
+# One-shot
+cs1 = compute_checksum(data)
+# Various chunk sizes
+for chunk_size in [1, 2, 3, 7, 100, 512, 1024, 4096]:
+    acc = ChecksumAccumulator()
+    for i in range(0, len(data), chunk_size):
+        acc.update(data[i:i+chunk_size])
+    cs2 = acc.value(len(data))
+    if cs1 != cs2:
+        print(f"MISMATCH at chunk_size={chunk_size}: {cs1:#x} vs {cs2:#x}")
+    else:
+        pass  # OK
+print(f"All chunk sizes match one-shot: True")
+
+print("\nDone!")
