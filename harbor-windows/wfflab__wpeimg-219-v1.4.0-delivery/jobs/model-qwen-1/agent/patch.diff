diff --git a/_tmp_acc_test.py b/_tmp_acc_test.py
new file mode 100644
index 0000000..7dd0d00
--- /dev/null
+++ b/_tmp_acc_test.py
@@ -0,0 +1,48 @@
+import sys, struct
+sys.path.insert(0, '.')
+from wpeimg.checksum import ChecksumAccumulator, compute_checksum
+
+with open('assets/amd64-module.bin', 'rb') as f:
+    data = f.read()
+
+# Test that accumulator gives same result regardless of chunk size
+# when feeding the SAME bytes (without skipping checksum field)
+ref_acc = ChecksumAccumulator()
+ref_acc.update(data)
+ref_val = ref_acc.value(len(data))
+
+print(f"Reference (one-shot full file): {ref_val:#x}")
+
+for chunk_size in [1, 2, 3, 7, 100, 512, 1024, 4096]:
+    acc = ChecksumAccumulator()
+    for i in range(0, len(data), chunk_size):
+        acc.update(data[i:i+chunk_size])
+    val = acc.value(len(data))
+    match = val == ref_val
+    if not match:
+        print(f"MISMATCH at chunk_size={chunk_size}: {val:#x} vs {ref_val:#x}")
+    
+print("All chunk sizes consistent:", all(
+    ChecksumAccumulator().update(data[:i]).update(data[i:]).value(len(data)) == ref_val
+    for i in [0, 1, 2, 100, 500, 1000]
+))
+
+# Also verify compute_checksum is stable
+cs = compute_checksum(data)
+print(f"\ncompute_checksum: {cs:#x}")
+
+# Verify it doesn't change when CheckSum field is modified
+data2 = bytearray(data)
+e_lfanew = struct.unpack_from('<I', data2, 0x3C)[0]
+opt_off = e_lfanew + 4 + 20
+struct.pack_into('<I', data2, opt_off + 64, 0xDEADBEEF)
+cs2 = compute_checksum(bytes(data2))
+print(f"After modifying CheckSum field: {cs2:#x}")
+print(f"Stable: {cs == cs2}")
+
+# Test accumulator agreement with compute_checksum per the smoke test
+blob = bytes(range(256)) * 3
+accumulator = ChecksumAccumulator()
+for start in range(0, len(blob), 100):
+    accumulator.update(blob[start:start + 100])
+print(f"\nSmoke test: accumulator.value == compute_checksum: {accumulator.value(len(blob)) == compute_checksum(blob)}")
diff --git a/_tmp_analyze.py b/_tmp_analyze.py
new file mode 100644
