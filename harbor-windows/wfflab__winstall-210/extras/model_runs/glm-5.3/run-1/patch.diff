diff --git a/winstall/planner.py b/winstall/planner.py
index 15e5502..bcea4b0 100644
--- a/winstall/planner.py
+++ b/winstall/planner.py
@@ -2,6 +2,9 @@
 
 规划阶段**只读**：不允许创建目录、写文件或改清单。调用方可以先用
 :func:`plan_transaction` 拿到计划并检查，再决定是否 :func:`transaction.apply_transaction`。
+
+被拒绝的计划（:class:`~winstall.errors.PlanRejected`）同样不留任何痕迹：
+既不创建目录，也不写文件、不改清单。
 """
 
 import os
@@ -30,8 +33,17 @@ def _check_name(value, what):
 
 def _check_relpath(rel):
     key = layout.relative_key(rel)
-    if not key or key.startswith("../") or "/../" in key:
+    if not key:
+        raise ValueError("payload path escapes the payload directory: %r" % (rel,))
+    parts = key.split("/")
+    if ".." in parts:
         raise ValueError("payload path escapes the payload directory: %r" % (rel,))
+    if os.path.isabs(key):
+        raise ValueError("payload path must not be absolute: %r" % (rel,))
+    head = parts[0]
+    if len(head) >= 2 and head[1] == ":" and head[0].isalpha():
+        # ``C:...`` 这样的盘符路径会把整个目标前缀替换掉
+        raise ValueError("payload path must not be absolute: %r" % (rel,))
     return key
 
 
@@ -39,6 +51,9 @@ def plan_transaction(operation, product, version=None, files=None, scope="machin
     """规划一次安装或卸载。
 
