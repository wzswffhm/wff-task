-            _delete_file(target)
-        else:
-            raise ValueError("unknown action: %r" % (action.kind,))
-        applied.append(action.relpath)
-
+    deferred = []
+    backups = {}  # {target_path: backup_path}
+    created = []  # 本次新建的文件
+    deferred_backups = {}  # 被推迟的文件的备份，用于恢复旧内容
+    
+    # 读取当前清单，获取待处理的 pending_replace
     data = manifest.read_manifest(plan.root)
-    if plan.operation == planner.INSTALL:
-        manifest.set_product(data, plan.product, plan.version, plan.files, [])
-    else:
-        manifest.drop_product(data, plan.product)
-    manifest.write_manifest(plan.root, data)
-
-    return ApplyResult(plan.operation, plan.product, plan.version,
-                       tuple(applied), ())
+    current = manifest.get_product(data, plan.product)
+    pending = set((current or {}).get("pending_replace") or [])
+    
+    try:
+        for action in plan.actions:
+            target = planner.destination(plan, action)
+            
+            if action.kind == "write":
+                _ensure_parent(target)
+                
+                # 如果文件已存在，先备份
+                if os.path.exists(target):
+                    if os.path.isdir(target):
+                        # 目标位置是目录，这是不可延迟的失败
+                        raise ApplyFailed(
+                            action.relpath,
+                            "target is a directory: %s" % target
+                        )
+                    backup = _backup_file(target)
+                    if backup:
+                        backups[target] = backup
+                else:
+                    # 新建文件
+                    created.append(target)
+                
+                # 尝试写入
+                success = _put_file(action.source, target)
+                if success:
+                    applied.append(action.relpath)
+                    # 从待处理列表中移除
+                    pending.discard(action.relpath)
+                    # 从新建列表中移除（因为实际写入成功了）
+                    if target in created:
+                        created.remove(target)
+                else:
+                    # 被占用，推迟
+                    deferred.append(action.relpath)
+                    pending.add(action.relpath)
+                    # 将备份转移到 deferred_backups，以便后续清理，但不恢复
+                    # （因为被占用的文件保持不动，不需要恢复）
+                    if target in backups:
+                        deferred_backups[target] = backups.pop(target)
+                    # 从新建列表中移除（因为实际没写入）
+                    if target in created:
+                        created.remove(target)
+                        
+            elif action.kind == "remove":
+                if os.path.exists(target):
+                    if os.path.isdir(target):
+                        raise ApplyFailed(
+                            action.relpath,
+                            "target is a directory: %s" % target
+                        )
+                    backup = _backup_file(target)
+                    if backup:
+                        backups[target] = backup
+                    _delete_file(target)
+                    applied.append(action.relpath)
+            else:
+                raise ValueError("unknown action: %r" % (action.kind,))
+        
+        # 所有动作执行完成（或推迟），更新清单
+        if plan.operation == planner.INSTALL:
+            manifest.set_product(
+                data, 
+                plan.product, 
+                plan.version, 
+                plan.files,
+                list(pending)
+            )
+        else:
+            manifest.drop_product(data, plan.product)
+        manifest.write_manifest(plan.root, data)
+        
+        # 成功：清理所有备份
+        for backup in backups.values():
+            _cleanup_backup(backup)
+        for backup in deferred_backups.values():
+            _cleanup_backup(backup)
+        
+        # 清理所有临时文件
+        _cleanup_temp_files(plan.root, plan.product)
+        
+        return ApplyResult(
+            plan.operation, 
+            plan.product, 
+            plan.version,
+            tuple(applied), 
+            tuple(deferred)
+        )
+        
+    except Exception as e:
+        # 回滚：恢复所有备份（包括已应用的和被推迟的）
+        for target, backup in backups.items():
+            try:
+                _restore_file(backup, target)
+            except:
+                pass
+        
+        # 被推迟的文件其实没被改动，但为了安全也恢复一下
+        for target, backup in deferred_backups.items():
+            try:
+                _restore_file(backup, target)
+            except:
+                pass
+        
+        # 删除所有新建的文件
+        for target in created:
+            try:
+                if os.path.isfile(target):
+                    os.remove(target)
+            except:
+                pass
+        
+        # 清理临时文件
+        _cleanup_temp_files(plan.root, plan.product)
+        
+        # 清单保持原样（不需要恢复，因为还没写入）
+        
+        # 如果是我们自己抛的 ApplyFailed，直接传播
+        if isinstance(e, ApplyFailed):
+            raise
+        
+        # 其它异常包装成 ApplyFailed
+        raise ApplyFailed(None, str(e))
