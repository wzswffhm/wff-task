 def _delete_file(path):
@@ -33,26 +49,184 @@ def _delete_file(path):
         os.remove(path)
 
 
+def _backup_file(path):
+    """备份文件内容，返回备份路径。文件不存在时返回 None。"""
+    if not os.path.isfile(path):
+        return None
+    backup = path + ".winstall-backup"
+    shutil.copyfile(path, backup)
+    return backup
+
+
+def _restore_file(backup_path, target_path):
+    """从备份恢复文件。"""
+    if backup_path and os.path.isfile(backup_path):
+        shutil.copyfile(backup_path, target_path)
+        os.remove(backup_path)
+
+
+def _cleanup_backup(backup_path):
+    """清理备份文件。"""
+    if backup_path and os.path.isfile(backup_path):
+        try:
+            os.remove(backup_path)
+        except:
+            pass
+
+
+def _cleanup_temp_files(root, product):
+    """清理载荷目录下的所有临时文件。"""
+    payload = planner.destination(
+        type('obj', (), {'root': root, 'product': product, 'relpath': ''})(), 
+        type('obj', (), {'relpath': ''})()
+    )
+    if not os.path.isdir(payload):
+        return
+    for dirpath, dirnames, filenames in os.walk(payload):
+        for fname in filenames:
+            if fname.endswith(TMP_SUFFIX) or fname.endswith(".winstall-backup"):
+                try:
+                    os.remove(os.path.join(dirpath, fname))
+                except:
+                    pass
+
