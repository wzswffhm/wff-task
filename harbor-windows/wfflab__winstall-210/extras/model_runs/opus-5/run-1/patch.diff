+def _rollback(backups, created, payload_root):
+    """回滚所有已执行的操作。"""
+    # 恢复所有备份的文件
+    for target, backup_path in backups:
+        try:
+            if os.path.isfile(backup_path):
+                shutil.copyfile(backup_path, target)
+        except OSError:
+            pass
+    
+    # 删除所有新创建的文件
+    for path in created:
+        try:
+            if os.path.isfile(path):
+                os.remove(path)
+        except OSError:
+            pass
+    
+    # 清理所有临时文件和备份文件
+    _cleanup_temp_files(payload_root)
