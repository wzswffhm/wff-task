+def _rollback(plan, backups, created, original_manifest):
+    """回滚所有已更改的文件和清单。"""
+    # 恢复所有备份的文件
+    for target, backup in backups.items():
+        try:
+            _restore_file(backup, target)
+        except OSError:
+            pass
+        # 清理备份文件
+        if backup:
+            try:
+                os.remove(backup)
+            except OSError:
+                pass
+    
+    # 删除本次新建的文件
+    for target in created:
+        try:
+            _delete_file(target)
+        except OSError:
+            pass
+    
+    # 恢复清单
+    try:
+        manifest.write_manifest(plan.root, original_manifest)
+    except OSError:
+        pass
+    
+    # 清理临时文件
+    _cleanup_tmp_files(plan.root, plan.product)
