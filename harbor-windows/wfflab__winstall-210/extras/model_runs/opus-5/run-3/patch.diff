+def _backup_file(path):
+    """备份文件内容，返回临时文件路径；文件不存在返回 None。"""
+    if not os.path.isfile(path):
+        return None
+    import tempfile
+    fd, tmp = tempfile.mkstemp(prefix="winstall-backup-", suffix=".tmp")
+    try:
+        with os.fdopen(fd, 'wb') as out:
+            with open(path, 'rb') as inp:
+                shutil.copyfileobj(inp, out)
+        return tmp
+    except:
+        try:
+            os.remove(tmp)
+        except OSError:
+            pass
+        raise
+
+
+def _restore_file(backup_path, destination):
+    """从备份恢复文件。"""
+    if backup_path is None:
+        # 文件原本不存在，删除它
+        _delete_file(destination)
+    else:
+        # 恢复旧内容
+        _put_file(backup_path, destination)
