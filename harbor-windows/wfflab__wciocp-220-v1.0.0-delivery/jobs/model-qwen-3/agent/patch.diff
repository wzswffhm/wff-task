+    get_file_type.restype = _winapi.wintypes.DWORD
+    
+    FILE_TYPE_UNKNOWN = 0x0000
+    file_type = get_file_type(_winapi.wintypes.HANDLE(number))
+    
+    if file_type == FILE_TYPE_UNKNOWN:
+        error = _winapi.last_error()
+        if error != _winapi.ERROR_SUCCESS:
+            raise WCIOCPError("invalid handle %r" % (handle,),
+                              kind="badarg", handle=number)
+    
+    # For the purposes of this module, we assume that valid handles are
+    # opened for overlapped use. The collector opens all its objects with
+    # FILE_FLAG_OVERLAPPED. If a handle doesn't actually support overlapped
+    # I/O, the ReadFile call will fail with an appropriate error.
+    #
+    # However, to satisfy requirement E (detect unsupported objects), we could
+    # try a different approach: check if the handle supports IOCP association
+    # without actually permanently associating it. Unfortunately, Windows
+    # doesn't provide a direct way to do this.
+    #
+    # The safest approach is to return True for valid handles and let the
+    # actual I/O operations determine if overlapped I/O is supported.
