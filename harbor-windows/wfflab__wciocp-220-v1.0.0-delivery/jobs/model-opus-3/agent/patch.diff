+def create_port(concurrency=0):
+    """Create an I/O completion port and return its handle number.
+
+    ``concurrency`` is how many threads the port may keep runnable at once;
+    zero lets the system use one per processor.
+    """
+    create = _entry("CreateIoCompletionPort",
+                    [wintypes.HANDLE, wintypes.HANDLE, ULONG_PTR, wintypes.DWORD],
+                    wintypes.HANDLE)
+    port = create(wintypes.HANDLE(INVALID_HANDLE_VALUE), None, ULONG_PTR(0),
+                  wintypes.DWORD(int(concurrency)))
+    if not port:
+        error = last_error()
+        raise WCIOCPError(
+            "the completion port could not be created (%s)" % describe(error),
+            kind=error_kind(error),
+        )
+    return int(port)
+
+
+def associate(handle, port, key):
+    """Attach ``handle`` to ``port`` under the completion key ``key``.
+
+    Returns ``(ok, error)``.  From here on every overlapping operation that
+    finishes on ``handle`` queues a packet carrying ``key`` to ``port``.
+    """
+    create = _entry("CreateIoCompletionPort",
+                    [wintypes.HANDLE, wintypes.HANDLE, ULONG_PTR, wintypes.DWORD],
+                    wintypes.HANDLE)
+    result = create(wintypes.HANDLE(int(handle)), wintypes.HANDLE(int(port)),
+                    ULONG_PTR(int(key) & _KEY_MASK), wintypes.DWORD(0))
+    if not result:
+        return False, last_error()
+    return True, ERROR_SUCCESS
+
+
+def dequeue(port, timeout_ms):
+    """Take one completion packet off ``port``.
+
+    Returns ``(ok, error, bytes_transferred, key, overlapped_address)``.  The
+    kernel hands a given packet to exactly one caller, so a packet that comes
+    back here has not been and will not be given to anyone else.  A call that
+    returns no packet (``overlapped_address`` is zero and ``ok`` is false)
+    leaves the port exactly as it was: packets that had already arrived stay
+    queued.
+    """
+    take_one = _entry("GetQueuedCompletionStatus",
+                      [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD),
+                       ctypes.POINTER(ULONG_PTR),
+                       ctypes.POINTER(ctypes.c_void_p), wintypes.DWORD],
+                      wintypes.BOOL)
+    count = wintypes.DWORD(0)
+    key = ULONG_PTR(0)
+    overlapped = ctypes.c_void_p()
+    ok = take_one(wintypes.HANDLE(int(port)), ctypes.byref(count),
+                  ctypes.byref(key), ctypes.byref(overlapped),
+                  wintypes.DWORD(int(timeout_ms)))
+    address = int(overlapped.value or 0)
+    if ok:
+        return True, ERROR_SUCCESS, int(count.value), int(key.value), address
+    return False, last_error(), int(count.value), int(key.value), address
