diff --git a/wciocp/_winapi.py b/wciocp/_winapi.py
index fdedcf4..3ab6652 100644
--- a/wciocp/_winapi.py
+++ b/wciocp/_winapi.py
@@ -18,12 +18,19 @@ ERROR_INVALID_PARAMETER = 87
 ERROR_NOT_ENOUGH_MEMORY = 8
 ERROR_IO_PENDING = 997
 ERROR_HANDLE_EOF = 38
+ERROR_NOT_FOUND = 1168
 
 WAIT_OBJECT_0 = 0x00000000
 WAIT_TIMEOUT = 0x00000102
 WAIT_FAILED = 0xFFFFFFFF
 INFINITE = 0xFFFFFFFF
 
+# File types returned by GetFileType
+FILE_TYPE_UNKNOWN = 0x0000
+FILE_TYPE_DISK = 0x0001
+FILE_TYPE_CHAR = 0x0002
+FILE_TYPE_PIPE = 0x0003
+
 _IS_WINDOWS = os.name == "nt"
 
 _kernel32 = None
@@ -193,6 +200,27 @@ def close_handle(handle):
         pass
 
 
+def get_file_type(handle):
+    """Return the file type of ``handle`` using ``GetFileType``."""
+    kernel32 = _kernel32_dll()
+    gft = kernel32.GetFileType
+    gft.argtypes = [wintypes.HANDLE]
+    gft.restype = wintypes.DWORD
+    return int(gft(wintypes.HANDLE(int(handle))))
+
+
+def cancel_io(handle):
+    """Cancel pending I/O on ``handle``."""
+    try:
+        kernel32 = _kernel32_dll()
+        cancel = kernel32.CancelIo
+        cancel.argtypes = [wintypes.HANDLE]
+        cancel.restype = wintypes.BOOL
+        cancel(wintypes.HANDLE(int(handle)))
+    except Exception:
+        pass
+
+
 # ------------------------------------------------------------- kernel events
 
 class Event(object):
diff --git a/wciocp/kinds.py b/wciocp/kinds.py
index 0a49c4d..6c8f3ae 100644
--- a/wciocp/kinds.py
+++ b/wciocp/kinds.py
@@ -13,12 +13,38 @@ def is_overlapped(handle):
     """Return ``True`` when ``handle`` can carry overlapping operations.
 
     ``handle`` must be an integer object handle.
+
+    Raises :class:`WCIOCPError` with ``kind="unsupported"`` when the handle
+    refers to an object type that cannot participate in asynchronous I/O
+    (for example, a console device).
     """
     number = _winapi.as_number(handle)
     if not _winapi.is_usable_handle(number):
         raise WCIOCPError("not a usable object handle: %r" % (handle,),
-                          kind="os", handle=handle)
-    # The read layer has always taken its objects from the pipe factory, which
-    # opens everything for overlapping use, so the answer is the same for every
-    # object the module is asked about.
+                          kind="badarg", handle=handle)
+
+    # Determine the file type.  Disk files and pipes support overlapped I/O;
+    # character devices (consoles) and unknown types do not.
+    try:
+        ft = _winapi.get_file_type(number)
+    except WCIOCPError:
+        raise
+    except Exception as exc:
+        raise WCIOCPError(
+            "cannot determine the type of object %r: %s" % (handle, exc),
+            kind="os", handle=handle)
+
+    if ft == _winapi.FILE_TYPE_UNKNOWN:
+        raise WCIOCPError(
+            "object %r does not support overlapping I/O (unknown file type)" % (handle,),
+            kind="unsupported", handle=number)
+
+    if ft == _winapi.FILE_TYPE_CHAR:
+        # Character devices (e.g. console) generally do not support
+        # FILE_FLAG_OVERLAPPED reads through ReadFile.
+        raise WCIOCPError(
+            "object %r does not support overlapping I/O (character device)" % (handle,),
+            kind="unsupported", handle=number)
+
+    # FILE_TYPE_DISK and FILE_TYPE_PIPE both support overlapped I/O.
     return True
