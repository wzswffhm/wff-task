@@ -5,6 +5,9 @@ between the collector and a worker, or a file on disk.  The helper here answers
 the question the registration layer asks about such an object.
 """
 
+import ctypes
+from ctypes import wintypes
+
 from . import _winapi
 from .errors import WCIOCPError
 
@@ -12,13 +15,79 @@ from .errors import WCIOCPError
 def is_overlapped(handle):
     """Return ``True`` when ``handle`` can carry overlapping operations.
 
-    ``handle`` must be an integer object handle.
+    ``handle`` must be an integer object handle.  The check probes the handle
+    with a zero-byte overlapped read: a handle that was not opened with
+    ``FILE_FLAG_OVERLAPPED`` rejects the operation outright, while a true
+    overlapped handle either completes immediately or pends.
     """
     number = _winapi.as_number(handle)
     if not _winapi.is_usable_handle(number):
         raise WCIOCPError("not a usable object handle: %r" % (handle,),
-                          kind="os", handle=handle)
-    # The read layer has always taken its objects from the pipe factory, which
-    # opens everything for overlapping use, so the answer is the same for every
-    # object the module is asked about.
-    return True
+                          kind="badarg", handle=handle)
+    return _probe_overlapped(number)
+
+
+def _probe_overlapped(handle):
+    """Probe whether *handle* accepts overlapped I/O.
+
+    Issues a zero-byte ``ReadFile`` with a fresh manual-reset event.  A handle
+    that was opened without ``FILE_FLAG_OVERLAPPED`` fails the call with an
+    error other than ``ERROR_IO_PENDING``; an overlapped handle either returns
+    success or ``ERROR_IO_PENDING``.  Either way the probe cleans up after
+    itself before returning.
+    """
+    kernel32 = _winapi._kernel32_dll()
+
+    # Create a temporary manual-reset event for the probe.
+    create_event = kernel32.CreateEventW
+    create_event.argtypes = [wintypes.LPVOID, wintypes.BOOL, wintypes.BOOL,
+                             wintypes.LPCWSTR]
+    create_event.restype = wintypes.HANDLE
+    event_handle = create_event(None, True, False, None)
+    if not event_handle:
+        # If we cannot even create an event, treat the handle as non-overlapped
+        # so that register() raises unsupported rather than crashing later.
+        return False
+
+    try:
+        overlapped = _winapi.OVERLAPPED()
+        overlapped.hEvent = event_handle
+        overlapped.Offset = 0
+        overlapped.OffsetHigh = 0
+
+        read_file = kernel32.ReadFile
+        read_file.argtypes = [wintypes.HANDLE, wintypes.LPVOID, wintypes.DWORD,
+                              ctypes.POINTER(wintypes.DWORD),
+                              ctypes.POINTER(_winapi.OVERLAPPED)]
+        read_file.restype = wintypes.BOOL
+
+        buf = ctypes.c_char()
+        transferred = wintypes.DWORD(0)
+        ok = read_file(wintypes.HANDLE(int(handle)),
+                       ctypes.byref(buf), 0,
+                       ctypes.byref(transferred),
+                       ctypes.byref(overlapped))
+        if ok:
+            # Immediate completion – handle supports overlapped I/O.
+            return True
+
+        err = _winapi.last_error()
+        if err == _winapi.ERROR_IO_PENDING:
+            # The read pended – handle supports overlapped I/O.  Cancel it so
+            # the probe does not leave work behind.
+            cancel = kernel32.CancelIo
+            cancel.argtypes = [wintypes.HANDLE]
+            cancel.restype = wintypes.BOOL
+            cancel(wintypes.HANDLE(int(handle)))
+            # Wait briefly for the cancellation to complete so the OVERLAPPED
+            # and event are no longer in use by the kernel.
+            wait = kernel32.WaitForSingleObject
+            wait.argtypes = [wintypes.HANDLE, wintypes.DWORD]
+            wait.restype = wintypes.DWORD
+            wait(wintypes.HANDLE(event_handle), 50)
+            return True
+
+        # Any other error means the handle does not accept overlapped reads.
+        return False
+    finally:
+        _winapi.close_handle(int(event_handle))
