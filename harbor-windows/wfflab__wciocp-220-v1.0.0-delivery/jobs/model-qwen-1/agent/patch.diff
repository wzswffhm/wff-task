@@ -0,0 +1,69 @@
+import ctypes, os
+from ctypes import wintypes
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+IHV = ctypes.c_void_p(-1).value
+_ULONG_PTR = ctypes.c_size_t
+
+ci = k.CreateIoCompletionPort
+ci.argtypes = [wintypes.HANDLE, wintypes.HANDLE, ctypes.POINTER(_ULONG_PTR), wintypes.DWORD]
+ci.restype = wintypes.HANDLE
+
+class OV(ctypes.Structure):
+    _fields_ = [("Internal", ctypes.c_void_p), ("InternalHigh", ctypes.c_void_p),
+                ("Offset", wintypes.DWORD), ("OffsetHigh", wintypes.DWORD), ("hEvent", wintypes.HANDLE)]
+
+# Create port
+port = ci(wintypes.HANDLE(IHV), wintypes.HANDLE(0), ctypes.byref(_ULONG_PTR(0)), wintypes.DWORD(0))
+print("Port:", int(port))
+
+# Create pipe
+PAD = 0x00000003; FFO = 0x40000000
+name = "\\\\.\\pipe\\test-key-direct"
+server = int(k.CreateNamedPipeW(name, PAD | FFO, 0, 1, 65536, 65536, 0, None))
+GR = 0x80000000; GW = 0x40000000; OE = 3
+client = int(k.CreateFileW(name, GR | GW, 0, None, OE, FFO, None))
+
+# Associate with key 0xAA
+r = ci(wintypes.HANDLE(server), wintypes.HANDLE(int(port)), ctypes.byref(_ULONG_PTR(0xAA)), wintypes.DWORD(0))
+print("Associate result:", int(r) if r else None, "err:", ctypes.get_last_error())
+
+# Submit a read
+rf = k.ReadFile
+rf.argtypes = [wintypes.HANDLE, wintypes.LPVOID, wintypes.DWORD, ctypes.POINTER(wintypes.DWORD), ctypes.POINTER(OV)]
+rf.restype = wintypes.BOOL
+
+buf = ctypes.create_string_buffer(64)
+ov = OV()
+ov.hEvent = None  # Use IOCP notification
+tr = wintypes.DWORD(0)
+ok = rf(wintypes.HANDLE(server), buf, 64, ctypes.byref(tr), ctypes.byref(ov))
+print("ReadFile: ok=%s err=%d" % (bool(ok), ctypes.get_last_error()))
+
+# Write data to trigger completion
+wf = k.WriteFile
+wf.argtypes = [wintypes.HANDLE, wintypes.LPVOID, wintypes.DWORD, ctypes.POINTER(wintypes.DWORD), wintypes.LPVOID]
+wf.restype = wintypes.BOOL
+wr = wintypes.DWORD(0)
+blob = b"hello"
+wok = wf(wintypes.HANDLE(client), blob, len(blob), ctypes.byref(wr), None)
+print("WriteFile: ok=%s written=%d err=%d" % (bool(wok), wr.value, ctypes.get_last_error()))
+
+import time
+time.sleep(0.5)
+
+# GetQueuedCompletionStatus
+gqcs = k.GetQueuedCompletionStatus
+gqcs.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD), ctypes.POINTER(_ULONG_PTR), ctypes.POINTER(ctypes.POINTER(OV)), wintypes.DWORD]
+gqcs.restype = wintypes.BOOL
+
+bt = wintypes.DWORD(0)
+ck = _ULONG_PTR(0)
+op = ctypes.POINTER(OV)()
+gok = gqcs(wintypes.HANDLE(int(port)), ctypes.byref(bt), ctypes.byref(ck), ctypes.byref(op), wintypes.DWORD(3000))
+err = ctypes.get_last_error()
+print("GQCS: ok=%s key=0x%x bytes=%d overlapped=%s err=%d" % (bool(gok), ck.value, bt.value, bool(op), err))
+
+k.CloseHandle(wintypes.HANDLE(client))
+k.CloseHandle(wintypes.HANDLE(server))
+k.CloseHandle(wintypes.HANDLE(int(port)))
