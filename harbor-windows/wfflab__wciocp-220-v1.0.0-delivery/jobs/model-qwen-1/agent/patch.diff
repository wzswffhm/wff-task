+import ctypes, os
+from ctypes import wintypes
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+IHV = ctypes.c_void_p(-1).value
+
+# Check pointer size
+print("pointer size:", ctypes.sizeof(ctypes.c_void_p))
+print("c_ulong size:", ctypes.sizeof(ctypes.c_ulong))
+print("c_size_t size:", ctypes.sizeof(ctypes.c_size_t))
+
+# The CompletionKey parameter is ULONG_PTR which is pointer-sized
+# On 64-bit Windows, this should be c_size_t or c_void_p, NOT c_ulong
+
+ci = k.CreateIoCompletionPort
+# Wrong: using c_ulong for the key (32-bit on 64-bit system)
+ci.argtypes = [wintypes.HANDLE, wintypes.HANDLE, ctypes.POINTER(ctypes.c_ulong), wintypes.DWORD]
+ci.restype = wintypes.HANDLE
+
+port = ci(wintypes.HANDLE(IHV), wintypes.HANDLE(0), ctypes.byref(ctypes.c_ulong(0)), wintypes.DWORD(0))
+print("Port:", int(port))
+
+PAD = 0x00000003; FFO = 0x40000000
+name = "\\\\.\\pipe\\test-key-size"
+server = int(k.CreateNamedPipeW(name, PAD | FFO, 0, 1, 65536, 65536, 0, None))
+GR = 0x80000000; GW = 0x40000000; OE = 3
+client = int(k.CreateFileW(name, GR | GW, 0, None, OE, FFO, None))
+
+# Try with c_ulong (wrong on 64-bit)
+r = ci(wintypes.HANDLE(server), wintypes.HANDLE(int(port)), ctypes.byref(ctypes.c_ulong(0xAA)), wintypes.DWORD(0))
+print("Associate with c_ulong(0xAA):", int(r) if r else None, "err:", ctypes.get_last_error())
+
+k.CloseHandle(wintypes.HANDLE(client))
+k.CloseHandle(wintypes.HANDLE(server))
+k.CloseHandle(wintypes.HANDLE(int(port)))
+
+# Now try with c_size_t (correct on 64-bit)
+port2 = ci(wintypes.HANDLE(IHV), wintypes.HANDLE(0), ctypes.byref(ctypes.c_size_t(0)), wintypes.DWORD(0))
+print("\nPort2:", int(port2))
+
+name2 = "\\\\.\\pipe\\test-key-size2"
+server2 = int(k.CreateNamedPipeW(name2, PAD | FFO, 0, 1, 65536, 65536, 0, None))
+client2 = int(k.CreateFileW(name2, GR | GW, 0, None, OE, FFO, None))
+
+ci.argtypes = [wintypes.HANDLE, wintypes.HANDLE, ctypes.POINTER(ctypes.c_size_t), wintypes.DWORD]
+r2 = ci(wintypes.HANDLE(server2), wintypes.HANDLE(int(port2)), ctypes.byref(ctypes.c_size_t(0xAA)), wintypes.DWORD(0))
+print("Associate with c_size_t(0xAA):", int(r2) if r2 else None, "err:", ctypes.get_last_error())
+
+# Now test GQCS
+class OV(ctypes.Structure):
+    _fields_ = [("Internal", ctypes.c_void_p), ("InternalHigh", ctypes.c_void_p),
+                ("Offset", wintypes.DWORD), ("OffsetHigh", wintypes.DWORD), ("hEvent", wintypes.HANDLE)]
+
+gqcs = k.GetQueuedCompletionStatus
+# Use c_size_t for the key
+gqcs.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD), ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(ctypes.POINTER(OV)), wintypes.DWORD]
+gqcs.restype = wintypes.BOOL
+
+bt = wintypes.DWORD(0)
+ck = ctypes.c_size_t(0)
+op = ctypes.POINTER(OV)()
+ok = gqcs(wintypes.HANDLE(int(port2)), ctypes.byref(bt), ctypes.byref(ck), ctypes.byref(op), wintypes.DWORD(100))
+print("GQCS timeout test: ok=%s err=%d" % (bool(ok), ctypes.get_last_error()))
+
+k.CloseHandle(wintypes.HANDLE(client2))
+k.CloseHandle(wintypes.HANDLE(server2))
+k.CloseHandle(wintypes.HANDLE(int(port2)))
