--- /dev/null
+++ b/_debug.py
@@ -0,0 +1,65 @@
+import ctypes, os, sys, time
+from ctypes import wintypes
+sys.path.insert(0, os.path.dirname(__file__))
+import wciocp
+from wciocp import WCIOCPError, create_pool
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+GR = 0x80000000; GW = 0x40000000; OE = 3; FFO = 0x40000000; PAD = 0x00000003
+EIP = 997; WO0 = 0; IHV = ctypes.c_void_p(-1).value
+
+class OV(ctypes.Structure):
+    _fields_ = [("Internal", ctypes.c_void_p), ("InternalHigh", ctypes.c_void_p),
+                ("Offset", wintypes.DWORD), ("OffsetHigh", wintypes.DWORD), ("hEvent", wintypes.HANDLE)]
+
+k.CreateNamedPipeW.restype = wintypes.HANDLE
+k.CreateNamedPipeW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, wintypes.LPVOID]
+k.CreateFileW.restype = wintypes.HANDLE
+k.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, wintypes.LPVOID, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+k.WriteFile.argtypes = [wintypes.HANDLE, wintypes.LPVOID, wintypes.DWORD, ctypes.POINTER(wintypes.DWORD), wintypes.LPVOID]
+k.WriteFile.restype = wintypes.BOOL
+k.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
+k.WaitForSingleObject.restype = wintypes.DWORD
+k.GetOverlappedResult.argtypes = [wintypes.HANDLE, wintypes.LPVOID, ctypes.POINTER(wintypes.DWORD), wintypes.BOOL]
+k.GetOverlappedResult.restype = wintypes.BOOL
+k.CreateEventW.restype = wintypes.HANDLE
+k.CreateEventW.argtypes = [wintypes.LPVOID, wintypes.BOOL, wintypes.BOOL, wintypes.LPCWSTR]
+k.CloseHandle.argtypes = [wintypes.HANDLE]; k.CloseHandle.restype = wintypes.BOOL
+
+name = "\\\\.\\pipe\\wciocp-dbg-%d" % os.getpid()
+server = int(k.CreateNamedPipeW(name, PAD | FFO, 0, 1, 65536, 65536, 0, None))
+client = int(k.CreateFileW(name, GR | GW, 0, None, OE, FFO, None))
+print("server=%d client=%d" % (server, client))
+
+pool = create_pool(threads=2)
+pool.register(server, 0xAA)
+print("registered server with key 0xAA")
+
+req = pool.submit(server, 64)
+print("submitted read, request state:", req._state)
+
+# Write data
+ev = int(k.CreateEventW(None, True, False, None))
+ov = OV(); ov.hEvent = ev
+wr = wintypes.DWORD(0)
+blob = b"hello-key-test"
+ok = k.WriteFile(wintypes.HANDLE(client), blob, len(blob), ctypes.byref(wr), ctypes.byref(ov))
+if not ok:
+    if ctypes.get_last_error() == EIP:
+        k.WaitForSingleObject(wintypes.HANDLE(ev), 5000)
+        r = wintypes.DWORD(0)
+        k.GetOverlappedResult(wintypes.HANDLE(client), ctypes.byref(ov), ctypes.byref(r), False)
+k.CloseHandle(wintypes.HANDLE(ev))
+print("wrote %d bytes" % len(blob))
+
+time.sleep(0.5)
+print("waiting for take...")
+try:
+    evt = pool.take(timeout=3.0)
+    print("GOT EVENT: key=0x%x bytes_read=%d status=%s" % (evt.key, evt.bytes_read, evt.status))
+except WCIOCPError as e:
+    print("ERROR: kind=%s msg=%s" % (e.kind, e))
+
+pool.close()
+k.CloseHandle(wintypes.HANDLE(client))
+k.CloseHandle(wintypes.HANDLE(server))
diff --git a/_debug2.py b/_debug2.py
