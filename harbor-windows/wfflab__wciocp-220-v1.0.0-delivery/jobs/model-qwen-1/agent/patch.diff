diff --git a/_verify.py b/_verify.py
new file mode 100644
index 0000000..c9f146b
--- /dev/null
+++ b/_verify.py
@@ -0,0 +1,254 @@
+"""Verification script for wciocp acceptance criteria."""
+import ctypes
+import os
+import sys
+import threading
+import time
+from ctypes import wintypes
+
+# Only run on Windows
+if os.name != "nt":
+    print("SKIP: not Windows")
+    sys.exit(0)
+
+sys.path.insert(0, os.path.dirname(__file__))
+import wciocp
+from wciocp import WCIOCPError, create_pool
+
+_kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+OPEN_EXISTING = 3
+FILE_FLAG_OVERLAPPED = 0x40000000
+PIPE_ACCESS_DUPLEX = 0x00000003
+ERROR_IO_PENDING = 997
+WAIT_OBJECT_0 = 0x00000000
+INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
+
+class _Overlapped(ctypes.Structure):
+    _fields_ = [
+        ("Internal", ctypes.c_void_p),
+        ("InternalHigh", ctypes.c_void_p),
+        ("Offset", wintypes.DWORD),
+        ("OffsetHigh", wintypes.DWORD),
+        ("hEvent", wintypes.HANDLE),
+    ]
+
+_kernel32.CreateNamedPipeW.restype = wintypes.HANDLE
+_kernel32.CreateNamedPipeW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, wintypes.LPVOID]
+_kernel32.CreateFileW.restype = wintypes.HANDLE
+_kernel32.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, wintypes.LPVOID, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+_kernel32.CreateEventW.restype = wintypes.HANDLE
+_kernel32.CreateEventW.argtypes = [wintypes.LPVOID, wintypes.BOOL, wintypes.BOOL, wintypes.LPCWSTR]
+_kernel32.WriteFile.argtypes = [wintypes.HANDLE, wintypes.LPVOID, wintypes.DWORD, ctypes.POINTER(wintypes.DWORD), wintypes.LPVOID]
+_kernel32.WriteFile.restype = wintypes.BOOL
+_kernel32.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
+_kernel32.WaitForSingleObject.restype = wintypes.DWORD
+_kernel32.GetOverlappedResult.argtypes = [wintypes.HANDLE, wintypes.LPVOID, ctypes.POINTER(wintypes.DWORD), wintypes.BOOL]
+_kernel32.GetOverlappedResult.restype = wintypes.BOOL
+_kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
+_kernel32.CloseHandle.restype = wintypes.BOOL
+
+_pipe_serial = [0]
+
+def _open_pipe():
+    _pipe_serial[0] += 1
+    name = "\\\\.\\pipe\\wciocp-verify-%d-%d" % (os.getpid(), _pipe_serial[0])
+    server = _kernel32.CreateNamedPipeW(name, PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED, 0, 1, 65536, 65536, 0, None)
+    if server == INVALID_HANDLE_VALUE:
+        raise OSError(ctypes.get_last_error(), "CreateNamedPipeW failed")
+    client = _kernel32.CreateFileW(name, GENERIC_READ | GENERIC_WRITE, 0, None, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, None)
+    if client == INVALID_HANDLE_VALUE:
+        _kernel32.CloseHandle(wintypes.HANDLE(server))
+        raise OSError(ctypes.get_last_error(), "CreateFileW failed")
+    return int(server), int(client)
+
+def _close(number):
+    _kernel32.CloseHandle(wintypes.HANDLE(int(number)))
+
+def _write(handle, blob):
+    event = _kernel32.CreateEventW(None, True, False, None)
+    overlapped = _Overlapped()
+    overlapped.hEvent = event
+    written = wintypes.DWORD(0)
+    ok = _kernel32.WriteFile(wintypes.HANDLE(int(handle)), blob, len(blob), ctypes.byref(written), ctypes.byref(overlapped))
+    if not ok:
+        if ctypes.get_last_error() != ERROR_IO_PENDING:
+            _kernel32.CloseHandle(wintypes.HANDLE(event))
+            raise OSError(ctypes.get_last_error(), "WriteFile failed")
+        if _kernel32.WaitForSingleObject(event, 5000) != WAIT_OBJECT_0:
+            _kernel32.CloseHandle(wintypes.HANDLE(event))
+            raise OSError("the write never finished")
+        result = wintypes.DWORD(0)
+        _kernel32.GetOverlappedResult(wintypes.HANDLE(int(handle)), ctypes.byref(overlapped), ctypes.byref(result), False)
+        written = result
+    _kernel32.CloseHandle(wintypes.HANDLE(event))
+    return int(written.value)
+
+passed = 0
+failed = 0
+
+def check(name, condition):
+    global passed, failed
+    if condition:
+        print("  PASS:", name)
+        passed += 1
+    else:
+        print("  FAIL:", name)
+        failed += 1
+
+# ---- Test A: Completion key comes from the mechanism ----
+print("\n=== Test A: Completion key ===")
+pool = create_pool(threads=2)
+server, client = _open_pipe()
+pool.register(server, 0xAA)
+req = pool.submit(server, 64)
+_write(client, b"hello-key-test")
+evt = pool.take(timeout=2.0)
+check("key matches registered value", evt.key == 0xAA)
+pool.close()
+_close(client)
+_close(server)
+
+# ---- Test B: Each notification delivered exactly once ----
+print("\n=== Test B: Exactly-once delivery ===")
+pool = create_pool(threads=4)
+server, client = _open_pipe()
+pool.register(server, 0xBB)
+N = 20
+for i in range(N):
+    pool.submit(server, 64)
+    _write(client, b"x" * 10)
+
+events = []
+errors = []
+def worker():
+    try:
+        while True:
+            try:
+                e = pool.take(timeout=1.0)
+                events.append(e)
+            except WCIOCPError as exc:
+                if exc.kind == "timeout":
+                    break
+                errors.append(exc)
+    except Exception as ex:
+        errors.append(ex)
+
+threads = [threading.Thread(target=worker) for _ in range(4)]
+for t in threads:
+    t.start()
+for t in threads:
+    t.join(timeout=10)
+
+check("got exactly N events", len(events) == N)
+check("no errors during concurrent take", len(errors) == 0)
+check("no duplicate request objects", len(set(id(e.request) for e in events)) == N)
+pool.close()
+_close(client)
+_close(server)
+
+# ---- Test C: Different handles, different keys ----
+print("\n=== Test C: Multiple handles with different keys ===")
+pool = create_pool(threads=2)
+s1, c1 = _open_pipe()
+s2, c2 = _open_pipe()
+pool.register(s1, 0x11)
+pool.register(s2, 0x22)
+pool.submit(s1, 64)
+pool.submit(s2, 64)
+_write(c1, b"data-for-s1")
+_write(c2, b"data-for-s2")
+e1 = pool.take(timeout=2.0)
+e2 = pool.take(timeout=2.0)
+keys = sorted([e1.key, e2.key])
+check("both keys present", keys == [0x11, 0x22])
+pool.close()
+_close(c1); _close(s1); _close(c2); _close(s2)
+
+# ---- Test D: Timeout does not discard arrived notifications ----
+print("\n=== Test D: Timeout preserves notifications ===")
+pool = create_pool(threads=2)
+server, client = _open_pipe()
+pool.register(server, 0xDD)
+pool.submit(server, 64)
+_write(client, b"before-timeout")
+time.sleep(0.2)  # Let the completion arrive
+
+# Now timeout (should not discard the already-arrived notification)
+try:
+    pool.take(timeout=0.001)
+except WCIOCPError as exc:
+    pass  # May or may not timeout depending on timing
+
+# The notification should still be retrievable
+try:
+    evt = pool.take(timeout=2.0)
+    check("notification survives timeout", evt.key == 0xDD and evt.bytes_read > 0)
+except WCIOCPError:
+    check("notification survives timeout", False)
+
+# Also verify new notifications work after timeout
+pool.submit(server, 64)
+_write(client, b"after-timeout")
+try:
+    evt2 = pool.take(timeout=2.0)
+    check("new notifications work after timeout", evt2.key == 0xDD)
+except WCIOCPError:
+    check("new notifications work after timeout", False)
+
+pool.close()
+_close(client)
+_close(server)
+
+# ---- Test E: Unsupported objects rejected ----
+print("\n=== Test E: Unsupported objects ===")
+pool = create_pool(threads=2)
+try:
+    # Console stdout handle typically doesn't support overlapped I/O
+    import msvcrt
+    console_handle = msvcrt.get_osfhandle(sys.stdout.fileno())
+    try:
+        pool.register(console_handle, 0xEE)
+        check("unsupported handle rejected", False)
+    except WCIOCPError as exc:
+        check("unsupported handle rejected", exc.kind == "unsupported")
+except Exception:
+    # If we can't get a console handle, skip this test
+    print("  SKIP: cannot get console handle")
+pool.close()
+
+# ---- Test F: Close semantics ----
+print("\n=== Test F: Close semantics ===")
+pool = create_pool(threads=2)
+server, client = _open_pipe()
+pool.register(server, 0xFF)
+pool.submit(server, 64)
+pool.close()
+
+# close() is idempotent
+pool.close()
+check("close is idempotent", True)
+
+# take after close raises closed
+try:
+    pool.take(timeout=0.1)
+    check("take after close raises closed", False)
+except WCIOCPError as exc:
+    check("take after close raises closed", exc.kind == "closed")
+
+# submit after close raises closed
+try:
+    pool.submit(server, 64)
+    check("submit after close raises closed", False)
+except WCIOCPError as exc:
+    check("submit after close raises closed", exc.kind == "closed")
+
+_close(client)
+_close(server)
+
+# ---- Summary ----
+print("\n=== Summary: %d passed, %d failed ===" % (passed, failed))
+if failed > 0:
+    sys.exit(1)
