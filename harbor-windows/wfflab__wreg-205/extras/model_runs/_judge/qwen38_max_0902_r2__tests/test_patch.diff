+"""注册表视图（WOW64 重定向）的行为验证。
+
+覆盖三类只在 64 位 Windows 上成立的语义：``HKLM\\SOFTWARE`` 按视图分开存放、
+32 位程序写的配置落在 Wow6432Node 之下、以及删除配置节必须连同子键一起删。
+"""
+
+import uuid
+import winreg
+
+import pytest
+
+from wregconfig import ConfigStore
+
+HKLM = winreg.HKEY_LOCAL_MACHINE
+BASE = r"SOFTWARE\WFFlabBench\wregconfig-views"
+
+
+def write_32bit(path, name, value):
+    """绕过被测代码，直接用 32 位视图写一个值。"""
+    with winreg.CreateKeyEx(
+        HKLM, path, 0, winreg.KEY_WRITE | winreg.KEY_WOW64_32KEY
+    ) as key:
+        winreg.SetValueEx(key, name, 0, winreg.REG_SZ, value)
+
+
+def write_64bit(path, name, value):
+    """绕过被测代码，直接用 64 位视图写一个值。"""
+    with winreg.CreateKeyEx(
+        HKLM, path, 0, winreg.KEY_WRITE | winreg.KEY_WOW64_64KEY
+    ) as key:
+        winreg.SetValueEx(key, name, 0, winreg.REG_SZ, value)
+
+
+def read_32bit(path, name):
+    with winreg.OpenKey(
+        HKLM, path, 0, winreg.KEY_READ | winreg.KEY_WOW64_32KEY
+    ) as key:
+        return winreg.QueryValueEx(key, name)[0]
+
+
+def force_delete(path):
+    """尽力删除测试用键，忽略失败。"""
+    for view in (winreg.KEY_WOW64_32KEY, winreg.KEY_WOW64_64KEY):
+        node = ConfigStore(HKLM, path)
+        node.view = "32" if view == winreg.KEY_WOW64_32KEY else "64"
+        try:
+            node.delete_tree()
+        except OSError:
+            pass
+
+
+@pytest.fixture()
+def path():
+    node_path = "%s\\%s" % (BASE, uuid.uuid4().hex)
+    yield node_path
+    force_delete(node_path)
+
+
+# --- 核心回归（base 上失败） ------------------------------------------------
+
+
+def test_reads_value_written_in_32bit_view(path):
+    write_32bit(path, "Legacy", "yes")
+    assert ConfigStore(HKLM, path, view="32").read("Legacy") == "yes"
+
+
+def test_exists_respects_view(path):
+    write_32bit(path, "Legacy", "yes")
+    assert ConfigStore(HKLM, path, view="32").exists() is True
+    assert ConfigStore(HKLM, path, view="64").exists() is False
+
+
+def test_write_lands_in_requested_32bit_view(path):
+    ConfigStore(HKLM, path, view="32").write("Mode", "legacy")
+    assert read_32bit(path, "Mode") == "legacy"
+
+
+def test_write_in_32bit_view_is_invisible_to_64bit_view(path):
+    ConfigStore(HKLM, path, view="32").write("Mode", "legacy")
+    assert ConfigStore(HKLM, path, view="64").exists() is False
+
+
+def test_delete_tree_removes_key_with_subkeys(path):
+    node = ConfigStore(HKLM, path)
+    node.write("Mode", "fast")
+    child = node.child("Nested")
+    child.write("Inner", "value")
+
+    node.delete_tree()
+
+    assert node.exists() is False
+    assert child.exists() is False
+
+
+def test_delete_tree_returns_true_for_existing_key(path):
+    node = ConfigStore(HKLM, path)
+    node.write("Mode", "fast")
+    assert node.delete_tree() is True
+
+
+# --- 回归保护（base 与参考解上都必须通过） ----------------------------------
+
+
+def test_write_then_read_in_default_view(path):
+    node = ConfigStore(HKLM, path)
+    node.write("Mode", "fast")
+    assert node.read("Mode") == "fast"
+
+
+def test_read_missing_value_raises(path):
+    from wregconfig import ConfigError
+
+    node = ConfigStore(HKLM, path)
+    node.write("Mode", "fast")
+    with pytest.raises(ConfigError):
+        node.read("Absent")
+
+
+def test_read_missing_returns_default(path):
+    assert ConfigStore(HKLM, path).read("Absent", default="fallback") == "fallback"
+
+
+def test_delete_existing_value(path):
+    node = ConfigStore(HKLM, path)
+    node.write("Mode", "fast")
+    assert node.delete("Mode") is True
+    assert node.delete("Mode") is False
+
+
+def test_delete_tree_missing_key_returns_false(path):
+    assert ConfigStore(HKLM, path).delete_tree() is False
+
+
+def test_unknown_view_is_rejected(path):
+    with pytest.raises(ValueError):
+        ConfigStore(HKLM, path, view="128")
