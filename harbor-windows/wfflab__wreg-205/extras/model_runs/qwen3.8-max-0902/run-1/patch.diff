diff --git a/wregconfig/store.py b/wregconfig/store.py
index 4506a14..defabbe 100644
--- a/wregconfig/store.py
+++ b/wregconfig/store.py
@@ -7,11 +7,18 @@ from .views import VIEWS, view_flags
 
 _MISSING = object()
 
+#: ``DELETE`` 访问权限（``winnt.h`` 里的 ``DELETE``，即 0x10000）。
+#: 删除一个键需要它的父键带上这个权限，而 ``winreg`` 并没有导出该常量。
+_DELETE_ACCESS = getattr(winreg, "DELETE", 0x10000)
+
 
 class ConfigStore(object):
     """某个注册表路径下的配置节。
 
     ``view`` 取 ``"default"`` / ``"64"`` / ``"32"``，决定访问哪一个注册表视图。
+
+    本节的所有操作（存在性判定、读、写、删值、删节）都在同一个视图内进行，
+    因此 32 位程序写下的配置只会出现在 ``view="32"`` 的 ``ConfigStore`` 里。
     """
 
     def __init__(self, hive, path, view="default"):
@@ -25,6 +32,7 @@ class ConfigStore(object):
 
     @property
     def flags(self):
+        """本视图对应的 WOW64 标志，附加在每一次注册表访问上。"""
         return view_flags(self.view)
 
     def _open(self, access):
@@ -57,7 +65,11 @@ class ConfigStore(object):
             return []
 
     def read(self, name, default=_MISSING):
-        """读取一个值；缺失时返回 ``default`` 或抛 :class:`ConfigError`。"""
+        """读取一个值；缺失时返回 ``default`` 或抛 :class:`ConfigError`。
+
+        与 :meth:`exists` 一样，读取也在所选视图内进行：只有当前视图里确实
+        存在该值时才返回它，否则按缺失处理。
+        """
         try:
             with self._open(winreg.KEY_READ) as key:
                 value, _kind = winreg.QueryValueEx(key, name)
@@ -84,5 +96,39 @@ class ConfigStore(object):
             return False
 
     def delete_tree(self):
-        """删除整个配置节。"""
-        winreg.DeleteKey(self.hive, self.path)
+        """删除整个配置节，连同它下面的所有子键。
+
+        删除在所选视图内进行，所以卸载时另一个视图里的残留配置也能被清掉。
+
+        返回该配置节此前是否存在：存在并已删除返回 ``True``，
+        本来就不存在返回 ``False``。
+        """
+        try:
+            with self._open(winreg.KEY_READ | _DELETE_ACCESS) as key:
+                self._delete_children(key)
+        except FileNotFoundError:
+            return False
+        try:
+            winreg.DeleteKeyEx(self.hive, self.path, self.flags, 0)
+        except FileNotFoundError:
+            return False
+        return True
+
+    def _delete_children(self, key):
+        """递归删除已打开的 ``key`` 下面的全部子键。
+
+        ``winreg.DeleteKey`` / ``DeleteKeyEx`` 都不接受带子键的键（Windows 会
+        返回 ``ERROR_ACCESS_DENIED``），因此必须先自底向上把子键删干净。
+        子键始终相对父句柄打开，并附加本视图的 WOW64 标志，保证不会跨视图误删。
+        """
+        while True:
+            try:
+                name = winreg.EnumKey(key, 0)
+            except OSError:
+                # ERROR_NO_MORE_ITEMS：子键已经删完。
+                return
+            with winreg.OpenKey(
+                key, name, 0, winreg.KEY_READ | _DELETE_ACCESS | self.flags
+            ) as child:
+                self._delete_children(child)
+            winreg.DeleteKeyEx(key, name, self.flags, 0)
diff --git a/wregconfig/views.py b/wregconfig/views.py
index 4641de7..fb4c826 100644
--- a/wregconfig/views.py
+++ b/wregconfig/views.py
@@ -4,6 +4,10 @@
 32 位视图（后者物理上落在 ``Wow6432Node`` 之下）。32 位程序看到的
 ``HKLM\\SOFTWARE\\Vendor`` 与 64 位程序看到的同名键，其实是两个不同的键。
 访问时可以显式要求某一个视图，也可以使用进程默认视图。
+
+WOW64 标志必须在每一次打开、创建、删除注册表键时都显式附加：少给一次，
+那一次访问就会静默退回进程默认视图，于是 32 位视图里的配置读不到，
+存在性判定与删除也可能落到另一个视图上。
 """
 
 import winreg
@@ -15,11 +19,20 @@ VIEWS = ("default", "64", "32")
 def view_flags(view):
     """返回访问注册表时应当附加的 WOW64 标志。
 
-    64 位进程中，``"64"`` 与 ``"default"`` 指向同一个视图，
-    因此只有前者需要显式标志。
+    ``"64"`` 返回 :data:`winreg.KEY_WOW64_64KEY`，``"32"`` 返回
+    :data:`winreg.KEY_WOW64_32KEY`，``"default"`` 返回 ``0``（进程默认视图）。
+
+    即便在 64 位进程里 ``"64"`` 与 ``"default"`` 指向同一个视图，``"32"``
+    也必须给出自己的标志，否则访问会静默落到进程默认视图（也就是 64 位视图），
+    读不到 32 位程序写下的配置。
+
+    调用方需要把这些标志与所需的访问权限（例如 :data:`winreg.KEY_READ`）
+    按位或之后一起传给 ``winreg``。
     """
     if view == "64":
         return winreg.KEY_WOW64_64KEY
+    if view == "32":
+        return winreg.KEY_WOW64_32KEY
     return 0
 
 
