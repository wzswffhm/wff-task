diff --git a/wregconfig/store.py b/wregconfig/store.py
index 4506a14..7c0d00c 100644
--- a/wregconfig/store.py
+++ b/wregconfig/store.py
@@ -12,6 +12,8 @@ class ConfigStore(object):
     """某个注册表路径下的配置节。
 
     ``view`` 取 ``"default"`` / ``"64"`` / ``"32"``，决定访问哪一个注册表视图。
+    本节下的所有操作（存在性判定、读、写、删值、删节）都在同一个视图内进行，
+    子节也会继承本节的视图。
     """
 
     def __init__(self, hive, path, view="default"):
@@ -33,6 +35,21 @@ class ConfigStore(object):
     def _create(self, access):
         return winreg.CreateKeyEx(self.hive, self.path, 0, access | self.flags)
 
+    @staticmethod
+    def _subkey_names(key):
+        """列出某个已打开键下的子键名。"""
+        count = winreg.QueryInfoKey(key)[0]
+        return [winreg.EnumKey(key, i) for i in range(count)]
+
+    def _delete_key(self):
+        """删除本节的键本身（不含子键），在当前视图内进行。"""
+        flags = self.flags
+        if flags:
+            # 需要指定视图时必须用 DeleteKeyEx，它只接受 WOW64 标志。
+            winreg.DeleteKeyEx(self.hive, self.path, flags, 0)
+        else:
+            winreg.DeleteKey(self.hive, self.path)
+
     def child(self, name):
         """返回本节的子节。"""
         return ConfigStore(self.hive, "%s\\%s" % (self.path, name), self.view)
@@ -57,7 +74,10 @@ class ConfigStore(object):
             return []
 
     def read(self, name, default=_MISSING):
-        """读取一个值；缺失时返回 ``default`` 或抛 :class:`ConfigError`。"""
+        """读取一个值；缺失时返回 ``default`` 或抛 :class:`ConfigError`。
+
+        读取始终在 :attr:`view` 指定的视图内进行，与 :meth:`exists` 一致。
+        """
         try:
             with self._open(winreg.KEY_READ) as key:
                 value, _kind = winreg.QueryValueEx(key, name)
@@ -84,5 +104,18 @@ class ConfigStore(object):
             return False
 
     def delete_tree(self):
-        """删除整个配置节。"""
-        winreg.DeleteKey(self.hive, self.path)
+        """删除整个配置节，连同其下的所有子键。
+
+        在当前视图内进行；返回该配置节此前是否存在，不存在时返回 ``False``
+        而不报错。
+        """
+        try:
+            with self._open(winreg.KEY_READ) as key:
+                subkeys = self._subkey_names(key)
+        except FileNotFoundError:
+            return False
+        # 注册表不允许删除仍带子键的键，必须先自底向上清空。
+        for name in subkeys:
+            self.child(name).delete_tree()
+        self._delete_key()
+        return True
diff --git a/wregconfig/views.py b/wregconfig/views.py
index 4641de7..0f5be6c 100644
--- a/wregconfig/views.py
+++ b/wregconfig/views.py
@@ -15,11 +15,14 @@ VIEWS = ("default", "64", "32")
 def view_flags(view):
     """返回访问注册表时应当附加的 WOW64 标志。
 
-    64 位进程中，``"64"`` 与 ``"default"`` 指向同一个视图，
-    因此只有前者需要显式标志。
+    ``"64"`` 与 ``"32"`` 分别显式选中 64 位视图与 32 位视图
+    （``Wow6432Node``），二者互不可见；``"default"`` 不附加标志，
+    沿用进程自身的默认视图。
     """
     if view == "64":
         return winreg.KEY_WOW64_64KEY
+    if view == "32":
+        return winreg.KEY_WOW64_32KEY
     return 0
 
 
