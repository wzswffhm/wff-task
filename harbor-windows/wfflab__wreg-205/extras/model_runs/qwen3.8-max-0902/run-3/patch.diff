--- a/wregconfig/store.py
+++ b/wregconfig/store.py
@@ -12,6 +12,9 @@ class ConfigStore(object):
     """某个注册表路径下的配置节。
 
     ``view`` 取 ``"default"`` / ``"64"`` / ``"32"``，决定访问哪一个注册表视图。
+    所有操作（打开、创建、枚举、删除）都在同一个视图内进行：64 位视图里的
+    ``SOFTWARE\\Vendor\\App`` 与 32 位视图（``Wow6432Node``）里的同名节是两个
+    互不可见的键。
     """
 
     def __init__(self, hive, path, view="default"):
@@ -25,8 +28,19 @@ class ConfigStore(object):
 
     @property
     def flags(self):
+        """访问本节时必须附加的 WOW64 标志。"""
         return view_flags(self.view)
 
+    @property
+    def _delete_flags(self):
+        """``RegDeleteKeyEx`` 能接受的视图掩码。
+
+        ``RegDeleteKeyEx`` 只接受 ``KEY_WOW64_64KEY`` / ``KEY_WOW64_32KEY``，
+        不接受 ``0``，也不接受两者同时置位；``"default"`` 视图因此改用不带
+        掩码参数的 ``RegDeleteKey``，以沿用进程默认视图。
+        """
+        return self.flags or winreg.KEY_WOW64_64KEY
+
     def _open(self, access):
         return winreg.OpenKey(self.hive, self.path, 0, access | self.flags)
 
@@ -37,6 +51,30 @@ class ConfigStore(object):
         """返回本节的子节。"""
         return ConfigStore(self.hive, "%s\\%s" % (self.path, name), self.view)
 
+    def _delete_key(self, path):
+        """在所选视图内删除一个已经没有子键的键。"""
+        if self.view == "default":
+            winreg.DeleteKey(self.hive, path)
+        else:
+            winreg.DeleteKeyEx(self.hive, path, self._delete_flags, 0)
+
+    def _delete_subtree(self, path):
+        """递归删除 ``path`` 及其全部子键；``path`` 不存在时安静返回。"""
+        try:
+            with winreg.OpenKey(
+                self.hive, path, 0, winreg.KEY_READ | self.flags
+            ) as key:
+                while True:
+                    try:
+                        sub = winreg.EnumKey(key, 0)
+                    except OSError:
+                        # 子键枚举完毕（ERROR_NO_MORE_ITEMS）。
+                        break
+                    self._delete_subtree("%s\\%s" % (path, sub))
+        except FileNotFoundError:
+            return
+        self._delete_key(path)
+
     # -- 查询 ---------------------------------------------------------------
 
     def exists(self):
@@ -57,7 +95,11 @@ class ConfigStore(object):
             return []
 
     def read(self, name, default=_MISSING):
-        """读取一个值；缺失时返回 ``default`` 或抛 :class:`ConfigError`。"""
+        """读取一个值；缺失时返回 ``default`` 或抛 :class:`ConfigError`。
+
+        读取与 :meth:`exists` 使用同一个视图，因此 32 位视图里的值不会被
+        64 位视图的读取意外看到（反之亦然）。
+        """
         try:
             with self._open(winreg.KEY_READ) as key:
                 value, _kind = winreg.QueryValueEx(key, name)
@@ -84,5 +126,13 @@ class ConfigStore(object):
             return False
 
     def delete_tree(self):
-        """删除整个配置节。"""
-        winreg.DeleteKey(self.hive, self.path)
+        """删除整个配置节，连同它下面的子键与值。
+
+        返回该配置节在删除之前是否存在：已经不存在时返回 ``False`` 且不报错，
+        删除成功时返回 ``True``。删除动作发生在所选视图内，因此卸载程序可以
+        分别清掉 64 位视图与 32 位视图里的残留配置。
+        """
+        existed = self.exists()
+        if existed:
+            self._delete_subtree(self.path)
+        return existed
diff --git a/wregconfig/views.py b/wregconfig/views.py
index 4641de7..c8a9906 100644
--- a/wregconfig/views.py
+++ b/wregconfig/views.py
@@ -4,6 +4,16 @@
 32 位视图（后者物理上落在 ``Wow6432Node`` 之下）。32 位程序看到的
 ``HKLM\\SOFTWARE\\Vendor`` 与 64 位程序看到的同名键，其实是两个不同的键。
 访问时可以显式要求某一个视图，也可以使用进程默认视图。
+
+要访问指定的视图，必须在打开键时附加对应的 WOW64 标志：
+
+* ``"64"`` —— :data:`winreg.KEY_WOW64_64KEY`
+* ``"32"`` —— :data:`winreg.KEY_WOW64_32KEY`
+* ``"default"`` —— 不附加标志，由操作系统按进程位数决定视图
+
+少了标志就等于悄悄退回进程默认视图：64 位工具会读不到 32 位程序写下的
+配置，反之亦然。因此这里对 ``"32"`` 必须返回
+:data:`winreg.KEY_WOW64_32KEY`，而不是 ``0``。
 """
 
 import winreg
@@ -15,11 +25,14 @@ VIEWS = ("default", "64", "32")
 def view_flags(view):
     """返回访问注册表时应当附加的 WOW64 标志。
 
-    64 位进程中，``"64"`` 与 ``"default"`` 指向同一个视图，
-    因此只有前者需要显式标志。
+    ``"64"`` 与 ``"32"`` 分别返回显式的 64 / 32 位视图标志，这样无论宿主
+    进程是几位，访问的都是调用方要求的那个视图；``"default"`` 返回 ``0``，
+    表示沿用进程默认视图。
     """
     if view == "64":
         return winreg.KEY_WOW64_64KEY
+    if view == "32":
+        return winreg.KEY_WOW64_32KEY
     return 0
 
 
