diff --git a/wregconfig/store.py b/wregconfig/store.py
index 4506a14..f89d853 100644
--- a/wregconfig/store.py
+++ b/wregconfig/store.py
@@ -37,6 +37,15 @@ class ConfigStore(object):
         """返回本节的子节。"""
         return ConfigStore(self.hive, "%s\\%s" % (self.path, name), self.view)
 
+    def child_names(self):
+        """返回本节的子节名列表。"""
+        try:
+            with self._open(winreg.KEY_READ) as key:
+                count = winreg.QueryInfoKey(key)[0]
+                return [winreg.EnumKey(key, i) for i in range(count)]
+        except FileNotFoundError:
+            return []
+
     # -- 查询 ---------------------------------------------------------------
 
     def exists(self):
@@ -84,5 +93,19 @@ class ConfigStore(object):
             return False
 
     def delete_tree(self):
-        """删除整个配置节。"""
-        winreg.DeleteKey(self.hive, self.path)
+        """删除整个配置节，包括它的全部子键。
+
+        返回该配置节此前是否存在。注册表的 ``DeleteKey`` 只接受空键，
+        所以必须先自底向上把子键清掉，否则整个删除会失败。
+        """
+        if not self.exists():
+            return False
+
+        for name in self.child_names():
+            self.child(name).delete_tree()
+
+        try:
+            winreg.DeleteKey(self.hive, self.path)
+        except FileNotFoundError:
+            return False
+        return True
diff --git a/wregconfig/views.py b/wregconfig/views.py
