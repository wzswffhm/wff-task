@@ -16,8 +16,11 @@ def view_flags(view):
     """返回访问注册表时应当附加的 WOW64 标志。
 
     64 位进程中，``"64"`` 与 ``"default"`` 指向同一个视图，
-    因此只有前者需要显式标志。
+    因此只有前者需要显式标志；``"32"`` 则必须显式要求 32 位视图，
