diff --git a/test_sparse_debug.py b/test_sparse_debug.py
new file mode 100644
index 0000000..030a773
--- /dev/null
+++ b/test_sparse_debug.py
@@ -0,0 +1,55 @@
+"""Debug test for write semantics."""
+import os
+import tempfile
+import sys
+
+sys.path.insert(0, '/testbed')
+
+from wsparse import preallocate, disk_usage, allocated_ranges
+
+with tempfile.TemporaryDirectory() as tmpdir:
+    path = os.path.join(tmpdir, "write_test.bin")
+    
+    # Preallocate 64 MiB
+    size = 64 * 1024 * 1024
+    preallocate(path, size)
+    
+    print(f"After preallocate:")
+    print(f"  Logical size: {os.path.getsize(path)}")
+    print(f"  Disk usage:   {disk_usage(path)}")
+    print(f"  Ranges:       {allocated_ranges(path)}")
+    
+    # Write some data at specific offsets
+    payload1 = b"Hello World!"
+    payload2 = b"Another payload here"
+    
+    with open(path, "r+b") as f:
+        f.seek(1024)
+        f.write(payload1)
+        f.flush()
+        os.fsync(f.fileno())
+        
+        f.seek(1024 * 1024)  # 1 MiB offset
+        f.write(payload2)
+        f.flush()
+        os.fsync(f.fileno())
+    
+    print(f"\nAfter writes:")
+    print(f"  Logical size: {os.path.getsize(path)}")
+    print(f"  Disk usage:   {disk_usage(path)}")
+    print(f"  Ranges:       {allocated_ranges(path)}")
+    
+    # Read back and verify
+    with open(path, "rb") as f:
+        f.seek(1024)
+        read1 = f.read(len(payload1))
+        print(f"\nRead at 1024: {read1}")
+        
+        f.seek(1024 * 1024)
+        read2 = f.read(len(payload2))
+        print(f"Read at 1MiB: {read2}")
+        
+        # Check that unwritten areas are zeros
+        f.seek(0)
+        zeros = f.read(1024)
+        print(f"First 1024 bytes all zero: {zeros == b'\\x00' * 1024}")
