index 0000000..429e368
--- /dev/null
+++ b/wpublish/principal.py
@@ -0,0 +1,98 @@
+"""安全主体（账户）名称的归一化。
+
+``icacls`` 既接受账户名（``BUILTIN\\Users``）也接受 SID 形式
+（``*S-1-5-32-546``，前导星号表示「按 SID 解释」），但**列出来**时它总是
+尽量把 SID 翻译成本机账户名。判定有效权限时两边必须能对上，否则查询用的
+SID 一条 ACE 都匹配不到，「显式拒绝优先」也就形同虚设。
+
+这里只做本机（同一账户数据库）内的 SID→名称解析；跨域、跨林的主体解析不
+在范围内。解析不出来时原样返回，调用方仍然可以按字符串比较。
+"""
+
+import re
+import sys
+
+#: SID 字符串（可带 icacls 的 ``*`` 前缀）。
+_SID_RE = re.compile(r"^\*?(S-\d+(?:-\d+)*)$", re.IGNORECASE)
+
+#: 解析结果缓存，避免同一个主体被反复翻译。
+_CACHE = {}
+
+
+def normalize_principal(principal):
+    """返回用于比较的规范形式（大写、SID 尽量翻译成本机账户名）。"""
+    if principal is None:
+        return ""
+    text = str(principal).strip()
+    key = text.upper()
+    cached = _CACHE.get(key)
+    if cached is None:
+        cached = key
+        match = _SID_RE.match(text)
+        if match:
+            name = _sid_to_account_name(match.group(1))
+            if name:
+                cached = name.upper()
+        _CACHE[key] = cached
+    return cached
+
+
+def same_principal(left, right):
+    """两个主体写法是否指向同一个账户。"""
+    return normalize_principal(left) == normalize_principal(right)
+
+
+def _sid_to_account_name(sid_text):
+    """把 SID 字符串翻译成本机账户名；失败返回 ``None``。"""
+    if sys.platform != "win32":
+        return None
+    try:
+        import ctypes
+        from ctypes import wintypes
+    except Exception:  # pragma: no cover - 平台不支持时退回字符串比较
+        return None
+    try:
+        advapi32 = ctypes.WinDLL("advapi32")
+        kernel32 = ctypes.WinDLL("kernel32")
+
+        psid = ctypes.c_void_p()
+        if not advapi32.ConvertStringSidToSidW(sid_text, ctypes.byref(psid)):
+            return None
+        try:
+            name_len = wintypes.DWORD(0)
+            domain_len = wintypes.DWORD(0)
+            use = wintypes.DWORD(0)
+            # 第一次调用只为取回所需的缓冲区长度。
+            advapi32.LookupAccountSidW(
+                None,
+                psid,
+                None,
+                ctypes.byref(name_len),
+                None,
+                ctypes.byref(domain_len),
+                ctypes.byref(use),
+            )
+            if not name_len.value:
+                return None
+            name = ctypes.create_unicode_buffer(name_len.value)
+            domain = ctypes.create_unicode_buffer(max(domain_len.value, 1))
+            if not advapi32.LookupAccountSidW(
+                None,
+                psid,
+                name,
+                ctypes.byref(name_len),
+                domain,
+                ctypes.byref(domain_len),
+                ctypes.byref(use),
+            ):
+                return None
+            account = name.value
+            if not account:
+                return None
+            if domain.value:
+                return "%s\\%s" % (domain.value, account)
+            return account
+        finally:
+            kernel32.LocalFree(psid)
+    except Exception:  # pragma: no cover - 解析失败时退回字符串比较
+        return None
