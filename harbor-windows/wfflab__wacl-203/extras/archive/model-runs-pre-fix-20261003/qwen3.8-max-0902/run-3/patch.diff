new file mode 100644
index 0000000..cb4c158
--- /dev/null
+++ b/_probe_tmp.py
@@ -0,0 +1,279 @@
+"""验收标准的场景验证（临时脚本，验证完删除）。"""
+
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wpublish import (
+    all_principals,
+    audit,
+    can_read,
+    can_write,
+    deny,
+    effective_rights,
+    explicit_grants,
+    grant,
+    list_aces,
+    list_explicit_aces,
+    parse_aces,
+    publish,
+    run,
+)
+
+TEST_SID = "*S-1-5-32-546"
+NAME = "BUILTIN\\Guests"
+
+failures = []
+
+
+def check(label, cond, extra=""):
+    print("%-52s %s %s" % (label, "OK " if cond else "FAIL", extra))
+    if not cond:
+        failures.append(label)
+
+
+def make_src():
+    src = tempfile.mkdtemp()
+    os.mkdir(os.path.join(src, "sub"))
+    os.mkdir(os.path.join(src, "sub", "deep"))
+    for rel, data in (
+        (("sub", "a.txt"), b"payload"),
+        (("sub", "deep", "b.txt"), b"more"),
+        (("top.txt",), b"top"),
+    ):
+        with open(os.path.join(src, *rel), "wb") as fh:
+            fh.write(data)
+    return src
+
+
+def walk_paths(root):
+    out = [root]
+    for dirpath, dirnames, filenames in os.walk(root):
+        for name in list(dirnames) + list(filenames):
+            out.append(os.path.join(dirpath, name))
+    return sorted(out)
+
+
+print("=== [1][2] publish covers the whole subtree ===")
+src = make_src()
+dst = os.path.join(tempfile.mkdtemp(), "dst")
+check("publish returns dst", publish(src, dst, TEST_SID) == dst)
+paths = walk_paths(dst)
+missing = [p for p in paths if not any(a.deny for a in list_aces(p))]
+check("existing entries all carry a deny ACE", not missing, missing)
+missing_sid = [
+    p for p in paths
+    if not any(a.deny and a.principal == NAME for a in list_aces(p))
+]
+check("deny ACE belongs to the principal", not missing_sid, missing_sid)
+check("content copied",
+      open(os.path.join(dst, "sub", "deep", "b.txt"), "rb").read() == b"more")
+
+newfile = os.path.join(dst, "sub", "new.txt")
+with open(newfile, "wb") as fh:
+    fh.write(b"new")
+newdir = os.path.join(dst, "newdir")
+os.mkdir(newdir)
+newdeep = os.path.join(newdir, "c.txt")
+with open(newdeep, "wb") as fh:
+    fh.write(b"deep")
+check("file created after publish is denied",
+      any(a.deny for a in list_aces(newfile)))
+check("dir created after publish is denied",
+      any(a.deny for a in list_aces(newdir)))
+check("file under new dir is denied",
+      any(a.deny for a in list_aces(newdeep)))
+root_explicit = list_explicit_aces(dst)
+check("root has an explicit inheritable deny",
+      any(a.deny and not a.inherited for a in root_explicit), root_explicit)
+print("   root explicit:", root_explicit)
+print("   file aces    :", list_aces(os.path.join(dst, "sub", "a.txt"))[:2])
+
+print()
+print("=== [5] audit ===")
+check("audit after publish == []", audit(dst, TEST_SID) == [], audit(dst, TEST_SID))
+check("audit by account name == []", audit(dst, NAME) == [], audit(dst, NAME))
+check("audit incl. new entries == []", audit(dst, TEST_SID) == [])
+
+print()
+print("=== read-only semantics ===")
+check("can_write(dst) is False", can_write(dst, TEST_SID) is False)
+check("can_read(dst) is True", can_read(dst, TEST_SID) is True)
+check("can_read(child file) is True",
+      can_read(os.path.join(dst, "sub", "a.txt"), TEST_SID) is True)
+check("can_write(child file) is False",
+      can_write(os.path.join(dst, "sub", "a.txt"), TEST_SID) is False)
+check("can_write(new file) is False", can_write(newfile, TEST_SID) is False)
+check("can_write by account name is False", can_write(dst, NAME) is False)
+check("effective_rights via SID",
+      effective_rights(dst, TEST_SID) == ({"RX"}, {"W", "D"}),
+      effective_rights(dst, TEST_SID))
+check("effective_rights via name",
+      effective_rights(dst, NAME) == effective_rights(dst, TEST_SID))
+check("effective_rights of unrelated principal",
+      effective_rights(dst, "*S-1-5-32-545") == (set(), set()),
+      effective_rights(dst, "*S-1-5-32-545"))
+
+print()
+print("=== republish / existing destination ===")
+check("second publish ok", publish(src, dst, TEST_SID) == dst)
+check("audit still empty", audit(dst, TEST_SID) == [], audit(dst, TEST_SID))
+dst2 = os.path.join(tempfile.mkdtemp(), "dst2")
+publish(src, dst2, NAME)
+check("publish by account name", audit(dst2, TEST_SID) == [], audit(dst2, TEST_SID))
+check("publish by name readable", can_read(dst2, NAME) is True)
+check("publish by name not writable", can_write(dst2, NAME) is False)
+
+print()
+print("=== [3] explicit deny wins ===")
+for allow_spec, deny_spec in (
+    ("(M)", "(W)"),
+    ("(M)", "(RX)"),
+    ("(F)", "(W)"),
+    ("(F)", "(RX)"),
+    ("(W)", "(W)"),
+    ("(M)", "(OI)(CI)(W,D)"),
+    ("(OI)(CI)(M)", "(OI)(CI)(W)"),
+    ("(M)", "(D)"),
+):
+    d = tempfile.mkdtemp()
+    grant(d, TEST_SID, allow_spec)
+    deny(d, TEST_SID, deny_spec)
+    aces = list_aces(d)
+    allow, denied = effective_rights(d, TEST_SID)
+    both = any(a.deny for a in aces) and any(not a.deny for a in aces)
+    check("grant %-11s deny %-13s" % (allow_spec, deny_spec),
+          can_write(d, TEST_SID) is False and both,
+          "allow=%s deny=%s" % (sorted(allow), sorted(denied)))
+
+print()
+print("=== allow-only still writable ===")
+d = tempfile.mkdtemp()
+grant(d, TEST_SID, "(M)")
+check("grant (M) -> can_write True", can_write(d, TEST_SID) is True,
+      effective_rights(d, TEST_SID))
+check("grant (M) -> can_read True", can_read(d, TEST_SID) is True)
+d2 = tempfile.mkdtemp()
+grant(d2, TEST_SID, "(RX)")
+check("grant (RX) -> can_write False", can_write(d2, TEST_SID) is False,
+      effective_rights(d2, TEST_SID))
+check("grant (RX) -> can_read True", can_read(d2, TEST_SID) is True)
+d3 = tempfile.mkdtemp()
+check("nothing granted -> can_write False", can_write(d3, TEST_SID) is False)
+check("nothing granted -> can_read False", can_read(d3, TEST_SID) is False)
+d4 = tempfile.mkdtemp()
+grant(d4, TEST_SID, "(RX)")
+deny(d4, TEST_SID, "(RX)")
+check("grant (RX) + deny (RX) -> can_read False", can_read(d4, TEST_SID) is False,
+      effective_rights(d4, TEST_SID))
+d5 = tempfile.mkdtemp()
+grant(d5, TEST_SID, "(RX)")
+deny(d5, TEST_SID, "(W)")
+check("grant (RX) + deny (W) -> can_read True", can_read(d5, TEST_SID) is True,
+      effective_rights(d5, TEST_SID))
+
+print()
+print("=== [4] explicit vs inherited ===")
+parent = tempfile.mkdtemp()
+child = os.path.join(parent, "child")
+os.mkdir(child)
+grandchild = os.path.join(child, "g.txt")
+with open(grandchild, "wb") as fh:
+    fh.write(b"x")
+grant(parent, TEST_SID, "(OI)(CI)(RX)")
+inherited = list_aces(child)
+explicit = list_explicit_aces(child)
+check("child sees inherited ACEs", any(a.inherited for a in inherited))
+check("list_explicit_aces has no inherited",
+      all(not a.inherited for a in explicit), explicit)
+check("list_aces keeps inherited",
+      len(inherited) > len(explicit), (len(inherited), len(explicit)))
+check("child explicit_grants empty", explicit_grants(child) == [], explicit_grants(child))
+check("child all_principals non-empty", bool(all_principals(child)))
+check("parent explicit_grants has principal", NAME in explicit_grants(parent),
+      explicit_grants(parent))
+check("grandchild explicit_grants empty", explicit_grants(grandchild) == [])
+
+print()
+print("=== parse_aces on real output ===")
+raw = run(parent)
+parsed = parse_aces(raw)
+check("no path pollution in principals",
+      all(not a.principal.endswith(":") and parent not in a.principal
+          for a in parsed),
+      [a.principal for a in parsed])
+check("parse_aces(output) single arg agrees",
+      [repr(a) for a in parse_aces(raw)] == [repr(a) for a in parse_aces(raw, parent)])
+check("first ACE principal is the account",
+      parsed[0].principal == NAME, parsed[0])
+comma = parse_aces(
+    "C:\\dir BUILTIN\\Guests:(OI)(CI)(DENY)(W,D)\n"
+    "       BUILTIN\\Guests:(I)(S,RD,WD)\n"
+    "       NT AUTHORITY\\SYSTEM:(I)(OI)(CI)(F)\n"
+)
+check("comma separated rights are split",
+      comma[0].rights == frozenset({"W", "D"})
+      and comma[1].rights == frozenset({"S", "RD", "WD"}), comma)
+check("comma ACE flags", comma[0].deny and not comma[0].inherited
+      and comma[1].inherited and not comma[1].deny)
+check("comma ACE principals",
+      [a.principal for a in comma]
+      == ["BUILTIN\\Guests", "BUILTIN\\Guests", "NT AUTHORITY\\SYSTEM"],
+      [a.principal for a in comma])
+check("path arg strips single ACE prefix",
+      [a.principal for a in parse_aces(
+          "C:\\dir BUILTIN\\Guests:(RX)\n", "C:\\dir")] == ["BUILTIN\\Guests"],
+      parse_aces("C:\\dir BUILTIN\\Guests:(RX)\n", "C:\\dir"))
+check("multi word principal kept intact",
+      [a.principal for a in parse_aces(
+          "C:\\a b NT AUTHORITY\\NETWORK SERVICE:(F)\n"
+          "        BUILTIN\\Guests:(RX)\n", "C:\\a b")]
+      == ["NT AUTHORITY\\NETWORK SERVICE", "BUILTIN\\Guests"])
+
+SAMPLE = """
+ACL for C:\\data
+                 BUILTIN\\Administrators:(F)
+                 BUILTIN\\Users:(RX)
+                 NT AUTHORITY\\SYSTEM:(OI)(CI)(F)
+                 BUILTIN\\Guests:(DENY)(W)
+"""
+check("repo sample still yields 4 aces", len(parse_aces(SAMPLE)) == 4)
+check("repo sample principals intact",
+      {a.principal for a in parse_aces(SAMPLE)} == {
+          "BUILTIN\\Administrators", "BUILTIN\\Users",
+          "NT AUTHORITY\\SYSTEM", "BUILTIN\\Guests"})
+check("repo sample deny intact",
+      [a for a in parse_aces(SAMPLE) if a.deny][0].principal == "BUILTIN\\Guests")
+check("empty output", parse_aces("") == [])
+check("trailer line ignored",
+      len(parse_aces(raw + "\nSuccessfully processed 1 files\n")) == len(parsed))
+
+print()
+print("=== audit spots a loosened entry ===")
+loose = os.path.join(dst, "sub", "a.txt")
+run(loose, "/inheritance:r")
+run(loose, "/remove:g", NAME)
+grant(loose, TEST_SID, "(M)")
+offenders = audit(dst, TEST_SID)
+check("audit reports the loosened file", offenders == [loose], offenders)
+check("can_write on the loosened file", can_write(loose, TEST_SID) is True)
+
+for p in (dst, dst2, src, parent):
+    run(p, "/remove:g", NAME)
+for p in walk_paths(dst) + walk_paths(dst2):
+    if os.path.exists(p):
+        os.chmod(p, 0o700)
+shutil.rmtree(dst, ignore_errors=True)
+shutil.rmtree(dst2, ignore_errors=True)
+shutil.rmtree(src, ignore_errors=True)
+
+print()
+if failures:
+    print("FAILED: %d" % len(failures))
+    for f in failures:
+        print("  - %s" % f)
+    sys.exit(1)
+print("ALL SCENARIOS PASSED")
