index 94e733c..5c25953 100644
--- a/wpublish/publish.py
+++ b/wpublish/publish.py
@@ -3,21 +3,36 @@
 import os
 import shutil
 
-from .icacls import deny, list_aces, list_explicit_aces
+from .icacls import deny, grant, list_aces, list_explicit_aces
 from .rights import can_write
 
 #: 只读发布时授给访问者的权限（对象继承 + 容器继承 + 读取执行）。
 READONLY_SPEC = "(OI)(CI)(RX)"
 
+#: 只读发布时拒绝访问者的权限（对象继承 + 容器继承 + 写入 + 删除）。
+#:
+#: ``(OI)(CI)`` 是继承标记：拒绝项因此可以被子文件与子目录继承，发布之后
+#: 才新建的条目同样落在拒绝项之下，而不只是发布当时已经存在的那些。
+WRITE_DENY_SPEC = "(OI)(CI)(W,D)"
+
 
 def publish(src_dir, dst_dir, principal):
     """把 ``src_dir`` 发布到 ``dst_dir``。
 
     目标目录会被创建；``principal`` 在整个子树内只读。
     返回已发布的根目录。
+
+    权限按「先放开读、再拒绝写」的顺序下发，两步都带 ``/T``：
+
+    * ``/T`` 让权限落到发布当时已经存在的每一个子目录与文件上，而不只是
+      根目录；
+    * 权限说明里的 ``(OI)(CI)`` 继承标记让之后新建的条目自动继承同一套
+      权限；
+    * 拒绝项优先于任何允许项，因此子树内不会留下可写的位置。
     """
     shutil.copytree(src_dir, dst_dir, dirs_exist_ok=True)
-    deny(dst_dir, principal, READONLY_SPEC)
