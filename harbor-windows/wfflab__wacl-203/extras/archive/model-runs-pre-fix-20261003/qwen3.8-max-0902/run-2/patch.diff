+def _looks_like_principal(text):
+    """``text`` 是否像一个安全主体名（而不是路径残留）。"""
+    if not text or ":" in text or text.startswith("\\"):
+        return False
+    if _SID_RE.match(text):
+        return True
+    match = _DOMAIN_QUALIFIED_RE.match(text)
+    if match:
+        domain = match.group(1).strip()
+        return " " not in domain or domain.upper() in _MULTIWORD_DOMAINS
+    return " " not in text
