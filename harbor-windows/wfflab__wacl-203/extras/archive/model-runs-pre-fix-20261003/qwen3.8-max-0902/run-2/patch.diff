+def _path_prefixes(path):
+    """``path`` 可能的几种写法，用于剥掉 icacls 回显的前缀。"""
+    candidates = []
+    seen = set()
+    for raw in (path, os.path.normpath(path), os.path.abspath(path)):
+        for variant in (raw, raw.rstrip("\\/")):
+            if variant and variant.lower() not in seen:
+                seen.add(variant.lower())
+                candidates.append(variant)
+    return candidates
+
+
+def _strip_path_prefix(principal, path=None):
+    """去掉 ``principal`` 前面被 icacls 一起打印出来的对象路径。"""
+    text = principal.strip()
+    lowered = text.lower()
+    if path is not None:
+        try:
+            path = os.fspath(path)
+        except TypeError:
+            path = str(path)
+        for prefix in _path_prefixes(path):
+            low = prefix.lower()
+            if not lowered.startswith(low):
+                continue
+            # 前缀必须完整占到一个词边界，否则短路径会吃掉主体名的一部分。
+            if len(low) < len(lowered) and lowered[len(low)] not in " \t":
+                continue
+            rest = text[len(prefix) :].strip()
+            if rest:
