         if not m:
             continue
         principal = m.group(1).strip()
+        
+        # icacls 的第一行 ACE 可能包含路径，格式为 "PATH PRINCIPAL:(ACE)"
+        # 需要去掉路径部分，只保留主体名称
+        if " " in principal:
+            parts = principal.split()
+            # 如果第一部分看起来像路径（包含 : 或 \ ），则去掉它
+            if len(parts) > 1 and (":" in parts[0] or "\\" in parts[0]):
+                principal = " ".join(parts[1:])
+        
         tokens = [t.strip().upper() for t in _TOKEN_RE.findall(m.group(2))]
         deny = "DENY" in tokens
         inherited = "I" in tokens
@@ -82,7 +91,7 @@ def list_explicit_aces(path):
 
