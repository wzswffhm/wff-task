--- a/wpublish/icacls.py
+++ b/wpublish/icacls.py
@@ -56,6 +56,19 @@ def parse_aces(output):
     """把 icacls 的输出解析成 :class:`Ace` 列表。"""
     aces = []
     for line in output.splitlines():
+        # 跳过第一行（包含路径的标题行）
+        # icacls 输出格式：第一行是 "路径 主体:(权限)"，后续行是 "            主体:(权限)"
+        # 如果行以盘符开头（如 C:\），需要提取路径后的部分
+        if line and len(line) > 3 and line[1:3] == ':\\':
+            # 第一行包含路径，提取路径后的第一个 ACE
+            # 格式：C:\path\to\dir principal:(permissions)
+            # 找到第一个空格后的内容
+            space_idx = line.find(' ')
+            if space_idx > 0:
+                line = line[space_idx + 1:]
+            else:
+                continue
+        
         m = _ACE_RE.match(line)
         if not m:
             continue
