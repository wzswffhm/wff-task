+"""NTFS 访问控制的继承与拒绝优先语义验证。
+
+覆盖三类只在 Windows 访问控制模型下成立的语义：ACL 沿目录树继承、
+显式拒绝优先于允许、以及显式项与继承项必须区分。
+"""
+
+import os
+
+import pytest
+
+from wpublish import (
+    audit,
+    can_write,
+    deny,
+    grant,
+    list_aces,
+    list_explicit_aces,
+    publish,
+)
+
+#: 内置 Guests 组：不匹配运行测试的任何账户，改它的 ACL 不会把自己锁在外面。
+TEST_SID = "*S-1-5-32-546"
+
+
+def principal_for(path, letter):
+    """返回在 ``path`` 上持有权限 ``letter`` 的主体名。"""
+    for ace in list_aces(path):
+        if letter in ace.rights:
+            return ace.principal
+    return None
+
+
+def deny_entries(path):
+    return [a for a in list_aces(path) if a.deny]
+
+
+@pytest.fixture()
+def tree(tmp_path):
+    src = tmp_path / "src"
+    (src / "sub").mkdir(parents=True)
+    (src / "sub" / "a.txt").write_bytes(b"A")
+    (src / "top.txt").write_bytes(b"T")
+    return src, tmp_path / "dst"
+
+
+# --- 核心回归（base 上失败） ------------------------------------------------
+
+
+def test_publish_propagates_deny_to_existing_subtree(tree):
+    src, dst = tree
+    publish(str(src), str(dst), TEST_SID)
+    for path in (dst / "sub", dst / "sub" / "a.txt", dst / "top.txt"):
+        assert deny_entries(str(path)), "no deny entry on %s" % path
+
+
+def test_publish_deny_is_inheritable_for_new_files(tree):
+    src, dst = tree
+    publish(str(src), str(dst), TEST_SID)
+    fresh = dst / "sub" / "later.txt"
+    fresh.write_bytes(b"L")
+    assert deny_entries(str(fresh))
+
+
+def test_audit_reports_no_writable_paths_after_publish(tree):
+    src, dst = tree
+    publish(str(src), str(dst), TEST_SID)
+    principal = principal_for(str(dst / "sub"), "W") or principal_for(str(dst / "sub"), "RX")
+    if principal is None:
+        raise AssertionError("no ACE carrying W/RX on the published tree")
+    assert audit(str(dst), principal) == []
+
+
+def test_explicit_aces_exclude_inherited(tmp_path):
+    parent = tmp_path / "parent"
+    parent.mkdir()
+    grant(str(parent), TEST_SID, "(OI)(CI)(RX)")
+    child = parent / "kid"
+    child.mkdir()
+    assert list_aces(str(child))
+    inherited_names = {a.principal for a in list_aces(str(child)) if a.inherited}
+    assert inherited_names
+    explicit_names = {a.principal for a in list_explicit_aces(str(child))}
+    assert not (inherited_names & explicit_names)
+    parent_names = {a.principal for a in list_explicit_aces(str(parent))}
+    assert any("GUESTS" in n.upper() for n in parent_names)
+
+
+def test_can_write_is_false_when_denied(tmp_path):
+    deny(str(tmp_path), TEST_SID, "(W)")
+    principal = principal_for(str(tmp_path), "W")
+    assert principal is not None
+    assert can_write(str(tmp_path), principal) is False
+
+
+def test_can_write_is_false_when_deny_conflicts_with_allow(tmp_path):
+    grant(str(tmp_path), TEST_SID, "(W)")
+    deny(str(tmp_path), TEST_SID, "(W)")
+    principal = principal_for(str(tmp_path), "W")
+    assert principal is not None
+    assert can_write(str(tmp_path), principal) is False
+
+
+def test_deny_applies_to_nested_directory(tree):
+    src, dst = tree
+    publish(str(src), str(dst), TEST_SID)
+    assert deny_entries(str(dst / "sub"))
+
+
+# --- 回归保护（base 与参考解上都必须通过） ----------------------------------
+
+
+def test_publish_copies_all_files(tree):
+    src, dst = tree
+    publish(str(src), str(dst), TEST_SID)
+    assert (dst / "top.txt").read_bytes() == b"T"
+    assert (dst / "sub" / "a.txt").read_bytes() == b"A"
+
+
+def test_list_aces_has_entries_on_fresh_directory(tmp_path):
+    assert list_aces(str(tmp_path))
+
+
+def test_grant_creates_an_entry(tmp_path):
+    before = len(list_aces(str(tmp_path)))
+    grant(str(tmp_path), TEST_SID, "(R)")
+    assert len(list_aces(str(tmp_path))) >= before
+
+
+def test_deny_entry_is_flagged_as_deny(tmp_path):
+    deny(str(tmp_path), TEST_SID, "(R)")
+    assert deny_entries(str(tmp_path))
+
+
+def test_audit_on_untouched_tree_is_not_empty(tmp_path):
+    (tmp_path / "loose.txt").write_bytes(b"x")
+    grant(str(tmp_path), TEST_SID, "(W)", recursive=True)
+    principal = principal_for(str(tmp_path / "loose.txt"), "W")
+    assert principal is not None
+    offenders = audit(str(tmp_path), principal)
+    assert offenders and str(tmp_path / "loose.txt") in offenders
+
+
+def test_publish_creates_missing_destination(tmp_path):
+    src = tmp_path / "src2"
+    src.mkdir()
+    (src / "only.txt").write_bytes(b"1")
+    dst = tmp_path / "deep" / "nested" / "dst"
+    publish(str(src), str(dst), TEST_SID)
+    assert (dst / "only.txt").is_file()
