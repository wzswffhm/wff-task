--- a/wpublish/publish.py
+++ b/wpublish/publish.py
@@ -15,9 +15,13 @@ def publish(src_dir, dst_dir, principal):
 
     目标目录会被创建；``principal`` 在整个子树内只读。
     返回已发布的根目录。
+
+    只读限制通过一条带继承标记的拒绝项下发：``/T`` 让它覆盖发布时
+    已存在的全部目录与文件，``(OI)(CI)`` 让它继续传播到发布之后
+    新建的条目。
     """
     shutil.copytree(src_dir, dst_dir, dirs_exist_ok=True)
-    deny(dst_dir, principal, READONLY_SPEC)
+    deny(dst_dir, principal, READONLY_SPEC, recursive=True)
     return dst_dir
 
 
