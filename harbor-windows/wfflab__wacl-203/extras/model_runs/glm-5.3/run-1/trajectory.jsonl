{"step": 39, "kind": "assistant", "stop_reason": "tool_use", "text": "Now I'll write the fixed implementation. First, the new principals module:", "tool_uses": [{"id": "call_476e0387c24c4f2b8c644fbb", "name": "write_file", "input": {"content": "\"\"\"安全主体的归一化比较。\n\nicacls 回显访问控制项时把主体显示成 ``BUILTIN\\\\Guests`` 这样的账户名，而\n调用方（以及 :func:`wpublish.publish` 的参数）常用 ``*S-1-5-32-546`` 这样\n的 SID 字面量指同一个主体。两者指向同一个账户，字符串却并不相等。\n\n这里把两种写法都归一化成 SID 字符串再做比较；解析不到 SID 时退化为大小写\n不敏感的名字比较，保证在拿不到账户信息的环境里依然可用。\n\"\"\"\n\nimport os\nimport re\n\n#: SID 字面量的样子（icacls 用 ``*`` 前缀表示「按 SID 解释」）。\n_SID_RE = re.compile(r\"^S-1-\\d+(?:-\\d+)*$\", re.IGNORECASE)\n\n#: 尚未尝试创建解析器。\n_UNBUILT = object()\n\n#: ``LookupAccountNameW`` 的封装；``None`` 表示本环境不可用。\n_resolver = _UNBUILT\n\n#: 名字 -> 归一化结果 的缓存，避免对同一个主体反复做系统调用。\n_cache = {}\n\n\ndef canonical(principal):\n    \"\"\"返回 ``principal`` 的归一化形式。\n\n    能解析出 SID 时返回 SID 字符串（统一大写），否则返回大写的名字。\n    ``*S-1-5-32-546`` 与 ``BUILTIN\\\\Guests`` 会得到同一个结果。\n    \"\"\"\n    if principal is None:\n        return \"\"\n    text = principal.strip()\n    if not text:\n        return \"\"\n    if text.startswith(\"*\"):\n        # icacls 的 SID 字面量写法：去掉前缀就是 SID 本身。\n        return text[1:].upper()\n    if _SID_RE.match(text):\n        # icacls 回显解析不到账户的主体时打印的就是裸 SID。\n        return text.upper()\n    try:\n        return _cache[text]\n    except KeyError:\n        pass\n    sid = _resolve(text)\n    value = sid.upper() if sid else text.upper()\n    _cache[text] = value\n    return value\n\n\ndef same_principal(left, right):\n    \"\"\"两个主体写法是否指向同一个账户。\"\"\"\n    return canonical(left) == canonical(right)\n\n\ndef _resolve(name):\n    \"\"\"把账户名解析成 SID 字符串；解析不到返回 ``None``。\"\"\"\n    global _resolver\n    if _resolver is _UNBUILT:\n        _resolver = _build_resolver()\n    if _resolver is None:\n        return None\n    try:\n        return _resolver(name)\n    except Exception:\n        # 账户查询失败不该影响权限判定，退化为名字比较。\n        return None\n\n\ndef _build_resolver():\n    \"\"\"创建 ``名字 -> SID`` 的解析器；拿不到 Windows API 时返回 ``None``。\"\"\"\n    if os.name != \"nt\":\n        return None\n    try:\n        import ctypes\n        from ctypes import wintypes\n    except Exception:  # pragma: no cover - 标准库缺失时退化为名字比较\n        return None\n    try:\n        advapi32 = ctypes.WinDLL(\"advapi32\")\n        kernel32 = ctypes.WinDLL(\"kernel32\")\n    except Exception:  # pragma: no cover - 无 Windows API 可用时退化\n        return None\n\n    lookup = advapi32.LookupAccountNameW\n    lookup.restype = wintypes.BOOL\n    lookup.argtypes = [\n        wintypes.LPCWSTR,                   # lpSystemName\n        wintypes.LPCWSTR,                   # lpAccountName\n        wintypes.LPVOID,                    # Sid\n        ctypes.POINTER(wintypes.DWORD),     # cbSid\n        wintypes.LPWSTR,                    # lpReferencedDomainName\n        ctypes.POINTER(wintypes.DWORD),     # cchReferencedDomainName\n        ctypes.POINTER(wintypes.DWORD),     # peUse\n    ]\n    to_string = advapi32.ConvertSidToStringSidW\n    to_string.restype = wintypes.BOOL\n    to_string.argtypes = [wintypes.LPVOID, ctypes.POINTER(wintypes.LPWSTR)]\n    local_free = kernel32.LocalFree\n    local_free.restype = wintypes.HLOCAL\n    local_free.argtypes = [wintypes.HLOCAL]\n\n    def resolve(name):\n        cb_sid = wintypes.DWORD(0)\n        cch_domain = wintypes.DWORD(0)\n        pe_use = wintypes.DWORD(0)\n        # 第一次调用只取所需缓冲区大小，返回失败是预期内的。\n        lookup(None, name, None, ctypes.byref(cb_sid), None,\n               ctypes.byref(cch_domain), ctypes.byref(pe_use))\n        if not cb_sid.value:\n            return None\n        sid = ctypes.create_string_buffer(cb_sid.value)\n        domain = ctypes.create_unicode_buffer(cch_domain.value or 1)\n        if not lookup(None, name, sid, ctypes.byref(cb_sid), domain,\n                      ctypes.byref(cch_domain), ctypes.byref(pe_use)):\n            return None\n        text = wintypes.LPWSTR()\n        if not to_string(sid, ctypes.byref(text)):\n            return None\n        try:\n            return text.value\n        finally:\n            local_free(text)\n\n    return resolve\n", "path": "wpublish/principals.py"}}], "output_tokens": 7749, "ts": "2026-10-02T21:42:37.973108+00:00"}
