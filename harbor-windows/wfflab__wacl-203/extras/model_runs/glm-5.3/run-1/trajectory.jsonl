{"step": 40, "kind": "assistant", "stop_reason": "tool_use", "text": "", "tool_uses": [{"id": "call_8b3fe1a5586c4113ba1fd6c5", "name": "write_file", "input": {"content": "\"\"\"icacls 的薄封装。\n\nNTFS 的访问控制列表（ACL）由若干访问控制项（ACE）组成，每项描述\n「某个主体在该对象上被允许或拒绝哪些权限」。系统管理员在命令行上通过\n``icacls`` 读写它们；这里把它包成可测试的接口。\n\"\"\"\n\nimport os\nimport re\nimport subprocess\n\nfrom .errors import ICaclsError\n\n#: icacls 可执行文件名。\nICACLS = \"icacls\"\n\n#: 只在目录上有意义的继承标志，不参与权限集合。\n_INHERITANCE_FLAGS = frozenset({\"OI\", \"CI\", \"IO\", \"NP\"})\n\n#: 标记「该访问控制项是从父目录继承来的」。\n_INHERITED_FLAG = \"I\"\n\n#: 标记「该访问控制项是拒绝项」。\n_DENY_FLAG = \"DENY\"\n\n#: 一条访问控制项所在的行：``<对象路径><主体>:<(标志)(权限)...>``。\n#:\n#: icacls 把第一条访问控制项与对象路径印在同一行，其余各条按列对齐缩进。\n#: 主体名里不会出现冒号，因此用**最后一个**冒号把权限说明切出来，剩下的\n#: 部分再拆成「路径前缀 + 主体名」。\n_ACE_RE = re.compile(r\"^(?P<head>.+):(?P<groups>(?:\\([^)]*\\))+)\\s*$\")\n\n#: 括号里的内容，例如 ``(I)(OI)(CI)(DENY)(W)`` 中的 ``I``、``W``。\n_TOKEN_RE = re.compile(r\"\\(([^)]*)\\)\")\n\n#: icacls 回显解析不到账户的主体时打印裸 SID。\n_SID_RE = re.compile(r\"^S-1-\\d+(?:-\\d+)*$\", re.IGNORECASE)\n\n\nclass Ace(object):\n    \"\"\"一条访问控制项。\"\"\"\n\n    __slots__ = (\"principal\", \"rights\", \"deny\", \"inherited\")\n\n    def __init__(self, principal, rights, deny=False, inherited=False):\n        self.principal = principal\n        self.rights = frozenset(rights)\n        self.deny = deny\n        self.inherited = inherited\n\n    def __repr__(self):\n        return \"Ace(%r, %r, deny=%r, inherited=%r)\" % (\n            self.principal,\n            sorted(self.rights),\n            self.deny,\n            self.inherited,\n        )\n\n\ndef run(path, *args):\n    \"\"\"对 ``path`` 执行 icacls，返回标准输出。\"\"\"\n    cmd = [ICACLS, str(path)] + [str(a) for a in args]\n    # errors=\"replace\"：icacls 用系统代码页输出本地化说明文字，在 UTF-8\n    # 模式下解码会失败；访问控制项本身全是 ASCII，替换掉坏字节不影响解析。\n    proc = subprocess.run(cmd, capture_output=True, text=True, errors=\"replace\")\n    if proc.returncode != 0:\n        raise ICaclsError(\n            \"icacls %s failed with %d: %s\"\n            % (path, proc.returncode, (proc.stdout or \"\").strip())\n        )\n    return proc.stdout\n\n\ndef parse_aces(output, path=None):\n    \"\"\"把 icacls 的输出解析成 :class:`Ace` 列表。\n\n    ``path`` 是查询该对象时传给 icacls 的路径；icacls 会把它原样回显在\n    第一行行首，并与第一条访问控制项共用一行。给出 ``path`` 可以把这段\n    回显剥掉，即使整份输出只有一条访问控制项也能解析出正确的主体名。\n    \"\"\"\n    lines = output.splitlines()\n    # 续行上的主体名从哪一列开始；icacls 把它与首行的访问控制项对齐。\n    column = _ace_column(lines)\n    aces = []\n    for line in lines:\n        matched = _ACE_RE.match(line)\n        if not matched:\n            continue\n        principal = _principal(matched.group(\"head\"), line, column, path)\n        if not principal:\n            continue\n        tokens = _tokens(matched.group(\"groups\"))\n        deny = _DENY_FLAG in tokens\n        inherited = _INHERITED_FLAG in tokens\n        rights = {\n            token\n            for token in tokens\n            if token\n            and token not in _INHERITANCE_FLAGS\n            and token not in (_DENY_FLAG, _INHERITED_FLAG)\n        }\n        if not rights:\n            continue\n        aces.append(Ace(principal, rights, deny=deny, inherited=inherited))\n    return aces\n\n\ndef list_aces(path):\n    \"\"\"返回 ``path`` 上的全部访问控制项。\"\"\"\n    return parse_aces(run(path), path)\n\n\ndef list_explicit_aces(path):\n    \"\"\"返回 ``path`` 上**显式设置**的访问控制项。\n\n    从父目录继承来的项不算显式设置。\n    \"\"\"\n    return [ace for ace in list_aces(path) if not ace.inherited]\n\n\ndef deny(path, principal, spec, recursive=False):\n    \"\"\"在 ``path`` 上为主体添加一条拒绝项。\n\n    ``spec`` 是 icacls 的权限说明，例如 ``\"(OI)(CI)(RX)\"``。带 ``(OI)`` 和\n    ``(CI)`` 时拒绝项会顺着子树继续继承；``recursive=True`` 则把它下发到\n    ``path`` 下已经存在的目录与文件上。\n    \"\"\"\n    args = [\"/deny\", \"%s:%s\" % (principal, spec)]\n    if recursive:\n        args.append(\"/T\")\n    return run(path, *args)\n\n\ndef grant(path, principal, spec, recursive=False):\n    \"\"\"在 ``path`` 上为主体添加一条允许项。\"\"\"\n    args = [\"/grant\", \"%s:%s\" % (principal, spec)]\n    if recursive:\n        args.append(\"/T\")\n    return run(path, *args)\n\n\ndef disable_inheritance(path):\n    \"\"\"移除 ``path`` 上从父目录继承来的项。\"\"\"\n    return run(path, \"/inheritance:r\")\n\n\ndef _ace_column(lines):\n    \"\"\"返回续行上主体名的起始列，找不到返回 ``None``。\"\"\"\n    for line in lines[1:]:\n        if not _ACE_RE.match(line):\n            continue\n        stripped = line.lstrip()\n        if stripped and len(stripped) != len(line):\n            return len(line) - len(stripped)\n    return None\n\n\ndef _tokens(groups):\n    \"\"\"把权限说明拆成大写的标志/权限字母列表。\n\n    icacls 既会写 ``(RX)`` 这样的通用权限，也会在拆开通用权限后写\n    ``(RX,D,WDAC,WO,DC)`` 这样的具体权限列表，两种都要拆成独立字母。\n    \"\"\"\n    tokens = []\n    for chunk in _TOKEN_RE.findall(groups):\n        for part in chunk.split(\",\"):\n            part = part.strip().upper()\n            if part:\n                tokens.append(part)\n    return tokens\n\n\ndef _principal(head, line, column, path):\n    \"\"\"从 ``<路径前缀><主体名>`` 里取出主体名。\"\"\"\n    if line[:1].isspace():\n        # 续行：缩进之后直接就是主体名。\n        return head.strip()\n    if path:\n        lowered = os.path.normcase(head)\n        for prefix in _echo_prefixes(path):\n            if lowered.startswith(prefix):\n                rest = head[len(prefix):]\n                if rest[:1].isspace():\n                    return rest.strip()\n    if column is not None and column > 0 and len(head) > column and head[column - 1].isspace():\n        # 首行：主体名与续行对齐，从对齐列切开。\n        return head[column:].strip()\n    return _principal_guess(head)\n\n\ndef _echo_prefixes(path):\n    \"\"\"icacls 会原样回显的路径前缀候选（Windows 路径不区分大小写）。\"\"\"\n    text = str(path)\n    prefixes = [text]\n    trimmed = text.rstrip(\"\\\\/\")\n    if trimmed:\n        prefixes.append(trimmed)\n    return [os.path.normcase(prefix) for prefix in prefixes]\n\n\ndef _principal_guess(head):\n    \"\"\"既没有回显路径也没有对齐信息时，从行尾猜出主体名。\"\"\"\n    tokens = head.split()\n    if not tokens:\n        return None\n    principal = tokens[-1]\n    if len(tokens) > 1:\n        previous = tokens[-2]\n        # 形如 \"NT AUTHORITY\\SYSTEM\" 的主体名自带空格。\n        if (\"\\\\\" in principal and \":\" not in previous\n                and \"\\\\\" not in previous and \"/\" not in previous):\n            principal = previous + \" \" + principal\n    return principal or None\n", "path": "wpublish/icacls.py"}}], "output_tokens": 1885, "ts": "2026-10-02T21:42:56.006600+00:00"}
