+"""安全主体的归一化比较。
+
+icacls 回显访问控制项时把主体显示成 ``BUILTIN\\Guests`` 这样的账户名，而
+调用方（以及 :func:`wpublish.publish` 的参数）常用 ``*S-1-5-32-546`` 这样
+的 SID 字面量指同一个主体。两者指向同一个账户，字符串却并不相等。
+
+这里把两种写法都归一化成 SID 字符串再做比较；解析不到 SID 时退化为大小写
+不敏感的名字比较，保证在拿不到账户信息的环境里依然可用。
+"""
+
+import os
+import re
+
+#: SID 字面量的样子（icacls 用 ``*`` 前缀表示「按 SID 解释」）。
+_SID_RE = re.compile(r"^S-1-\d+(?:-\d+)*$", re.IGNORECASE)
+
+#: 尚未尝试创建解析器。
+_UNBUILT = object()
+
+#: ``LookupAccountNameW`` 的封装；``None`` 表示本环境不可用。
+_resolver = _UNBUILT
+
+#: 名字 -> 归一化结果 的缓存，避免对同一个主体反复做系统调用。
+_cache = {}
+
+
+def canonical(principal):
+    """返回 ``principal`` 的归一化形式。
+
+    能解析出 SID 时返回 SID 字符串（统一大写），否则返回大写的名字。
+    ``*S-1-5-32-546`` 与 ``BUILTIN\\Guests`` 会得到同一个结果。
+    """
+    if principal is None:
+        return ""
+    text = principal.strip()
+    if not text:
+        return ""
+    if text.startswith("*"):
+        # icacls 的 SID 字面量写法：去掉前缀就是 SID 本身。
+        return text[1:].upper()
+    if _SID_RE.match(text):
+        # icacls 回显解析不到账户的主体时打印的就是裸 SID。
+        return text.upper()
+    try:
+        return _cache[text]
+    except KeyError:
+        pass
+    sid = _resolve(text)
+    value = sid.upper() if sid else text.upper()
+    _cache[text] = value
+    return value
+
+
+def same_principal(left, right):
+    """两个主体写法是否指向同一个账户。"""
+    return canonical(left) == canonical(right)
+
+
+def _resolve(name):
+    """把账户名解析成 SID 字符串；解析不到返回 ``None``。"""
+    global _resolver
+    if _resolver is _UNBUILT:
+        _resolver = _build_resolver()
+    if _resolver is None:
+        return None
+    try:
+        return _resolver(name)
+    except Exception:
+        # 账户查询失败不该影响权限判定，退化为名字比较。
+        return None
+
+
+def _build_resolver():
+    """创建 ``名字 -> SID`` 的解析器；拿不到 Windows API 时返回 ``None``。"""
+    if os.name != "nt":
+        return None
+    try:
+        import ctypes
+        from ctypes import wintypes
+    except Exception:  # pragma: no cover - 标准库缺失时退化为名字比较
+        return None
+    try:
+        advapi32 = ctypes.WinDLL("advapi32")
+        kernel32 = ctypes.WinDLL("kernel32")
+    except Exception:  # pragma: no cover - 无 Windows API 可用时退化
+        return None
+
+    lookup = advapi32.LookupAccountNameW
+    lookup.restype = wintypes.BOOL
+    lookup.argtypes = [
+        wintypes.LPCWSTR,                   # lpSystemName
+        wintypes.LPCWSTR,                   # lpAccountName
+        wintypes.LPVOID,                    # Sid
+        ctypes.POINTER(wintypes.DWORD),     # cbSid
+        wintypes.LPWSTR,                    # lpReferencedDomainName
+        ctypes.POINTER(wintypes.DWORD),     # cchReferencedDomainName
+        ctypes.POINTER(wintypes.DWORD),     # peUse
