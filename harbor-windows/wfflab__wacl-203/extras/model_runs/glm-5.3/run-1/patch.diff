diff --git a/wpublish/icacls.py b/wpublish/icacls.py
index ed65e1f..d093d08 100644
--- a/wpublish/icacls.py
+++ b/wpublish/icacls.py
@@ -5,6 +5,7 @@ NTFS 的访问控制列表（ACL）由若干访问控制项（ACE）组成，每
 ``icacls`` 读写它们；这里把它包成可测试的接口。
 """
 
+import os
 import re
 import subprocess
 
@@ -16,9 +17,25 @@ ICACLS = "icacls"
 #: 只在目录上有意义的继承标志，不参与权限集合。
 _INHERITANCE_FLAGS = frozenset({"OI", "CI", "IO", "NP"})
 
-_ACE_RE = re.compile(r"^\s*(.+?):((?:\([^)]*\))+)\s*$")
+#: 标记「该访问控制项是从父目录继承来的」。
+_INHERITED_FLAG = "I"
+
+#: 标记「该访问控制项是拒绝项」。
+_DENY_FLAG = "DENY"
+
+#: 一条访问控制项所在的行：``<对象路径><主体>:<(标志)(权限)...>``。
