diff --git a/_probe.py b/_probe.py
new file mode 100644
index 0000000..3ed268d
--- /dev/null
+++ b/_probe.py
@@ -0,0 +1,69 @@
+import ctypes
+import os
+from ctypes import wintypes
+
+_SID_RE = __import__("re").compile(r"^S-1-\d+(?:-\d+)*$", __import__("re").IGNORECASE)
+
+
+def _advapi32():
+    try:
+        return ctypes.WinDLL("advapi32")
+    except Exception:
+        return None
+
+
+def _kernel32():
+    try:
+        return ctypes.WinDLL("kernel32")
+    except Exception:
+        return None
+
+
+def _sid_to_string(sid_buf):
+    adv = _advapi32()
+    ker = _kernel32()
+    if adv is None or ker is None:
+        return None
+    text = ctypes.c_wchar_p()
+    if not adv.ConvertSidToStringSidW(ctypes.c_void_p(ctypes.addressof(sid_buf)), ctypes.byref(text)):
+        return None
+    try:
+        return text.value
+    finally:
+        ker.LocalFree(ctypes.cast(text, ctypes.c_void_p))
+
+
+def resolve(name):
+    adv = _advapi32()
+    if adv is None or os.name != "nt":
+        return None
+    adv.LookupAccountNameW.restype = wintypes.BOOL
+    adv.LookupAccountNameW.argtypes = [
+        wintypes.LPCWSTR,
+        wintypes.LPCWSTR,
+        wintypes.LPVOID,
+        ctypes.POINTER(wintypes.DWORD),
+        wintypes.LPWSTR,
+        ctypes.POINTER(wintypes.DWORD),
+        ctypes.POINTER(wintypes.DWORD),
+    ]
+    cb_sid = wintypes.DWORD(0)
+    cch_domain = wintypes.DWORD(0)
+    use = wintypes.DWORD(0)
+    ok = adv.LookupAccountNameW(None, name, None, ctypes.byref(cb_sid),
+                                None, ctypes.byref(cch_domain), ctypes.byref(use))
+    if ok or cb_sid.value == 0:
+        return None
+    sid_buf = ctypes.create_string_buffer(cb_sid.value)
+    domain = ctypes.create_unicode_buffer(cch_domain.value or 1)
+    if not adv.LookupAccountNameW(None, name, sid_buf, ctypes.byref(cb_sid),
+                                  domain, ctypes.byref(cch_domain), ctypes.byref(use)):
+        return None
+    return _sid_to_string(sid_buf)
+
+
+for name in ["BUILTIN\\Guests", "BUILTIN\\Administrators", "NT AUTHORITY\\SYSTEM",
+             "Everyone", "CHINAMI-IB8SDOI\\Administrator", "Guests",
+             "S-1-5-21-206965065-2734981178-3897594509-3139391984",
+             "no such account at all", "BUILTIN\\Users", "NT AUTHORITY\\Authenticated Users"]:
+    print("%-50r -> %r" % (name, resolve(name)))
