diff --git a/wpublish/icacls.py b/wpublish/icacls.py
index ed65e1f..1f90b38 100644
--- a/wpublish/icacls.py
+++ b/wpublish/icacls.py
@@ -60,6 +60,22 @@ def parse_aces(output):
         if not m:
             continue
         principal = m.group(1).strip()
+        
+        # icacls 有时会在 ACE 行前面加上路径，格式为 "<path> <principal>:(rights)"
+        # 需要把路径部分去掉，只保留主体名称
+        # 路径通常包含 ":" (如 C:\...) 或以空格分隔，且主体名称紧跟在最后一个空格之后
+        if ' ' in principal:
+            # 如果包含空格，取最后一个连续的非空白段作为主体
+            # 例如 "C:\path\to\file BUILTIN\Guests" -> "BUILTIN\Guests"
+            parts = principal.split()
+            # 从右往左找第一个看起来像主体的部分（包含 \ 或不含路径特征）
+            for i in range(len(parts) - 1, -1, -1):
+                candidate = ' '.join(parts[i:])
+                # 如果这个候选项不是以盘符开头的路径，就认为是主体
+                if not (len(parts[i]) >= 2 and parts[i][1] == ':'):
+                    principal = candidate
+                    break
+        
         tokens = [t.strip().upper() for t in _TOKEN_RE.findall(m.group(2))]
         deny = "DENY" in tokens
         inherited = "I" in tokens
@@ -82,7 +98,7 @@ def list_explicit_aces(path):
 
     从父目录继承来的项不算显式设置。
     """
-    return list_aces(path)
+    return [ace for ace in list_aces(path) if not ace.inherited]
 
 
 def deny(path, principal, spec, recursive=False):
