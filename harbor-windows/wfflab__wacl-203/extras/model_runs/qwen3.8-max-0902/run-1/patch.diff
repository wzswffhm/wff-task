+def _detail(proc):
+    """把 icacls 的报错内容拼成一行，便于排错。"""
+    parts = [(proc.stdout or "").strip(), (proc.stderr or "").strip()]
+    return " / ".join(part for part in parts if part)
+
+
+def _indent_of(line):
+    return len(line) - len(line.lstrip())
+
+
+def _ace_column(lines):
+    """返回续行 ACE 的对齐列，也就是首行里目标路径占掉的宽度。
+
+    ``icacls`` 把首条 ACE 与路径打印在同一行，其余 ACE 一律缩进到路径之后
+    的同一列，因此这一列正好是首行里需要跳过的前缀长度。
+    """
+    columns = [_indent_of(line) for line in lines if _indent_of(line) and _ACE_RE.match(line)]
+    return min(columns) if columns else 0
+
+
+def _drop_path_prefix(line, column):
+    """去掉首行里 icacls 回显的目标路径，只留下 ``principal:(...)``。
+
+    路径里可以有空格，主体名里也可能有空格（例如 ``NT AUTHORITY\\SYSTEM``），
+    所以优先按续行的对齐列切；只有一条 ACE、无从对齐时才退化为「取冒号前
+    最后一个词」。
+    """
+    if not _PATH_RE.match(line):
+        return line
+    if column and len(line) > column:
+        head = line[:column]
+        if head.strip() and head[-1] in " \t":
+            return line[column:]
+    matched = _ACE_RE.match(line)
+    if matched and " " in matched.group(1):
+        tail = matched.group(1).rsplit(" ", 1)[1]
+        return line[len(matched.group(1)) - len(tail):]
+    return line
+
