+def _canonical(principal):
+    """把主体名规整成可比较的形式。
+
+    icacls 既接受 ``*S-1-5-32-546`` 这样的字面 SID，也接受 ``BUILTIN\\Guests``
+    这样的名字，回显时却只保留其中一种；比较前去掉字面 SID 的星号前缀并统一
+    大小写，免得同一个主体被判成两个。
+    """
+    name = (principal or "").strip()
+    if name.startswith("*"):
+        name = name[1:]
+    return name.upper()
+
+
+def _same_principal(left, right):
+    return _canonical(left) == _canonical(right)
+
