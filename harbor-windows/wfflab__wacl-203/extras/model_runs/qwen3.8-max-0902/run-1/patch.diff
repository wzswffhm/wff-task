+    # 根目录连同已经存在的各级子目录一起下发：/T 让子目录拿到显式拒绝项，
+    # (OI)(CI) 让此后新建的文件与目录继承同一条拒绝项。
+    deny(dst_dir, principal, READONLY_SPEC, recursive=True)
+    # icacls 的 /T 只会让文件继承父目录上的项，文件自身拿不到显式拒绝项；
+    # 这里逐个补齐，保证发布时已存在的文件也明确带着只读限制。
+    for dirpath, _dirnames, filenames in os.walk(dst_dir):
+        for name in filenames:
+            deny(os.path.join(dirpath, name), principal, READONLY_FILE_SPEC)
