+import tempfile, os
+from wsparse import preallocate, disk_usage
+
+td = tempfile.mkdtemp()
+path = os.path.join(td, 'test.bin')
+preallocate(path, 64 * 1024 * 1024)
+
+# Write using Python open with explicit flush and fsync
+f = open(path, "r+b")
+f.seek(1024 * 1024)
+f.write(b'X' * 65536)
+f.flush()
+os.fsync(f.fileno())
+f.close()
+
+print(f"After Python write+flush+fsync+close:")
+print(f"  disk_usage: {disk_usage(path)}")
+
+# Now try without fsync
+path2 = os.path.join(td, 'test2.bin')
+preallocate(path2, 64 * 1024 * 1024)
+
+with open(path2, "r+b") as f:
+    f.seek(1024 * 1024)
+    f.write(b'Y' * 65536)
+# context manager closes the file
+
+print(f"\nAfter Python write via context manager (no explicit fsync):")
+print(f"  disk_usage: {disk_usage(path2)}")
+
+# Try with just flush, no fsync
+path3 = os.path.join(td, 'test3.bin')
+preallocate(path3, 64 * 1024 * 1024)
+
+f3 = open(path3, "r+b")
+f3.seek(1024 * 1024)
+f3.write(b'Z' * 65536)
+f3.flush()
+f3.close()
+
+print(f"\nAfter Python write+flush+close (no fsync):")
+print(f"  disk_usage: {disk_usage(path3)}")
diff --git a/_verify_wsparse.py b/_verify_wsparse.py
new file mode 100644
index 0000000..7e5606b
--- /dev/null
+++ b/_verify_wsparse.py
@@ -0,0 +1,128 @@
+import tempfile, os, sys
+from wsparse import preallocate, disk_usage, allocated_ranges, sparse_state, WSParseError
+
+print("=== Test 1: Sparse preallocation (1 GiB) ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'sparse_1g.bin')
+    size = 1 << 30  # 1 GiB
+    result = preallocate(path, size)
+    print(f'Preallocate returned: {result}')
+    print(f'File logical size: {os.path.getsize(path)}')
+    usage = disk_usage(path)
+    print(f'Disk usage: {usage} bytes ({usage / (1024*1024):.2f} MiB)')
+    print(f'Sparse state: {sparse_state(path)}')
+    ranges = allocated_ranges(path)
+    print(f'Allocated ranges count: {len(ranges)}')
+    
+    if usage < 8 * 1024 * 1024:
+        print('PASS: Disk usage is small (< 8 MiB)')
+    else:
+        print(f'FAIL: Disk usage too large: {usage}')
+
+print()
+print("=== Test 2: Write to sparse file and verify ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'sparse_write.bin')
+    size = 64 * 1024 * 1024  # 64 MiB
+    preallocate(path, size)
+    
+    payload = b"collector-payload-data"
+    with open(path, "r+b") as f:
+        f.seek(1024)
+        f.write(payload)
+    
+    with open(path, "rb") as f:
+        f.seek(1024)
+        readback = f.read(len(payload))
+    
+    if readback == payload:
+        print("PASS: Data read back correctly")
+    else:
+        print(f"FAIL: Data mismatch")
+    
+    usage = disk_usage(path)
+    print(f'Disk usage after write: {usage} bytes ({usage / 1024:.2f} KiB)')
+    
+    if usage < 1024 * 1024:
+        print("PASS: Disk usage still small after partial write")
+    else:
+        print(f"FAIL: Disk usage too large: {usage}")
+    
+    ranges = allocated_ranges(path)
+    print(f'Allocated ranges: {ranges}')
+
+print()
+print("=== Test 3: Dense file disk_usage ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'dense.bin')
+    data = b"x" * 65536
+    with open(path, "wb") as f:
+        f.write(data)
+    
+    usage = disk_usage(path)
+    print(f'Logical size: {len(data)}')
+    print(f'Disk usage: {usage}')
+    
+    if usage >= len(data):
+        print("PASS: Dense file disk_usage >= logical size")
+    else:
+        print(f"FAIL: Disk usage {usage} < logical size {len(data)}")
+
+print()
+print("=== Test 4: Idempotent preallocate ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'idem.bin')
+    preallocate(path, 1 << 20)
+    usage1 = disk_usage(path)
+    preallocate(path, 1 << 20)
+    usage2 = disk_usage(path)
+    print(f'Usage after first: {usage1}, after second: {usage2}')
+    if usage1 == usage2:
+        print("PASS: Idempotent")
+    else:
+        print("INFO: Usage changed (may be OK due to metadata)")
+
+print()
+print("=== Test 5: Non-sparse file allocated_ranges ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'dense_ranges.bin')
+    with open(path, "wb") as f:
+        f.write(b"y" * 8192)
+    ranges = allocated_ranges(path)
+    print(f'Ranges for dense 8KiB file: {ranges}')
+    total = sum(l for _, l in ranges)
+    if total >= 8192:
+        print("PASS: Dense file fully covered by ranges")
+    else:
+        print(f"FAIL: Total range coverage {total} < 8192")
+
+print()
+print("=== Test 6: Error on directory ===")
+with tempfile.TemporaryDirectory() as td:
+    try:
+        disk_usage(td)
+        print("FAIL: Should have raised WSParseError")
+    except WSParseError as e:
+        print(f"Got WSParseError: {e}")
+        print(f"Kind: {e.kind}")
+        if e.kind == "unsupported":
+            print("PASS: Correct error kind")
+        else:
+            print(f"FAIL: Expected 'unsupported', got '{e.kind}'")
+    except Exception as e:
+        print(f"FAIL: Got unexpected exception: {type(e).__name__}: {e}")
+
+print()
+print("=== Test 7: Hollow file has empty ranges ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'hollow.bin')
+    preallocate(path, 1 << 20)  # 1 MiB sparse
+    ranges = allocated_ranges(path)
+    print(f'Ranges for hollow sparse file: {ranges}')
+    if len(ranges) == 0:
+        print("PASS: Empty ranges for hollow file")
+    else:
+        print(f"INFO: Got {len(ranges)} ranges (might include metadata allocation)")
+
+print()
+print("=== All tests complete ===")
