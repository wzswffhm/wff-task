index d16a526..f2fc76f 100644
--- a/wsparse/_winapi.py
+++ b/wsparse/_winapi.py
@@ -6,10 +6,31 @@ the DLL is loaded lazily, on first use.
 """
 
 import os
+import sys
 
 # FILE_ATTRIBUTE_SPARSE_FILE
 SPARSE_ATTRIBUTE = 0x00000200
 
+# GENERIC_READ | GENERIC_WRITE
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+
+# OPEN_EXISTING, CREATE_ALWAYS, OPEN_ALWAYS
+OPEN_EXISTING = 3
+CREATE_ALWAYS = 2
+OPEN_ALWAYS = 4
+
+# FILE_SHARE_READ | FILE_SHARE_WRITE
+FILE_SHARE_READ = 0x00000001
+FILE_SHARE_WRITE = 0x00000002
+
+# INVALID_HANDLE_VALUE
+INVALID_HANDLE_VALUE = -1
+
+# FSCTL codes
+FSCTL_SET_SPARSE = 0x000900C4
+FSCTL_QUERY_ALLOCATED_RANGES = 0x000940CF
+
 _IS_WINDOWS = os.name == "nt"
 
 
@@ -20,5 +41,250 @@ def is_windows():
 
 def _kernel32():
     import ctypes
-
     return ctypes.WinDLL("kernel32", use_last_error=True)
+
+
+def _get_last_error_message():
+    """Format the last Win32 error into a readable string."""
+    if not _IS_WINDOWS:
+        return "unknown error"
+    import ctypes
+    err = ctypes.get_last_error()
+    if err is None or err == 0:
+        return "unknown error"
+    buf = ctypes.c_void_p()
+    FORMAT_MESSAGE_ALLOCATE_BUFFER = 0x00000100
+    FORMAT_MESSAGE_FROM_SYSTEM = 0x00001000
+    try:
+        ctypes.windll.kernel32.FormatMessageW(
+            FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM,
+            None, err, 0, ctypes.byref(buf), 0, None
+        )
+        msg = ctypes.wstring_at(buf.value).strip()
+        ctypes.windll.kernel32.LocalFree(buf)
+        return msg
+    except Exception:
+        return f"Win32 error {err}"
+
+
+class WinAPI:
+    """Lazy-loaded Win32 API wrapper."""
+
+    def __init__(self):
+        self._k32 = None
+        self._setup_done = False
+
+    def _ensure_setup(self):
+        if self._setup_done:
+            return
+        if not _IS_WINDOWS:
+            raise RuntimeError("WinAPI requires Windows")
+        import ctypes
+        k32 = _kernel32()
+
+        # CreateFileW
+        k32.CreateFileW.restype = ctypes.c_void_p
+        k32.CreateFileW.argtypes = [
+            ctypes.c_wchar_p,  # lpFileName
+            ctypes.c_uint32,   # dwDesiredAccess
+            ctypes.c_uint32,   # dwShareMode
+            ctypes.c_void_p,   # lpSecurityAttributes
+            ctypes.c_uint32,   # dwCreationDisposition
+            ctypes.c_uint32,   # dwFlagsAndAttributes
+            ctypes.c_void_p,   # hTemplateFile
+        ]
+
+        # CloseHandle
+        k32.CloseHandle.restype = ctypes.c_int
+        k32.CloseHandle.argtypes = [ctypes.c_void_p]
+
+        # DeviceIoControl
+        k32.DeviceIoControl.restype = ctypes.c_int
+        k32.DeviceIoControl.argtypes = [
+            ctypes.c_void_p,   # hDevice
+            ctypes.c_uint32,   # dwIoControlCode
+            ctypes.c_void_p,   # lpInBuffer
+            ctypes.c_uint32,   # nInBufferSize
+            ctypes.c_void_p,   # lpOutBuffer
+            ctypes.c_uint32,   # nOutBufferSize
+            ctypes.POINTER(ctypes.c_uint32),  # lpBytesReturned
+            ctypes.c_void_p,   # lpOverlapped
+        ]
+
+        # SetFilePointerEx
+        k32.SetFilePointerEx.restype = ctypes.c_int
+        k32.SetFilePointerEx.argtypes = [
+            ctypes.c_void_p,           # hFile
+            ctypes.c_int64,            # liDistanceToMove
+            ctypes.POINTER(ctypes.c_int64),  # lpNewFilePointer
+            ctypes.c_uint32,           # dwMoveMethod
+        ]
+
+        # SetEndOfFile
+        k32.SetEndOfFile.restype = ctypes.c_int
+        k32.SetEndOfFile.argtypes = [ctypes.c_void_p]
+
+        # GetCompressedFileSizeW
+        k32.GetCompressedFileSizeW.restype = ctypes.c_uint32
+        k32.GetCompressedFileSizeW.argtypes = [
+            ctypes.c_wchar_p,              # lpFileName
+            ctypes.POINTER(ctypes.c_uint32),  # lpFileSizeHigh
+        ]
+
+        # GetLastError
+        k32.GetLastError.restype = ctypes.c_uint32
+        k32.GetLastError.argtypes = []
+
+        self._k32 = k32
+        self._setup_done = True
+
+    @property
+    def k32(self):
+        self._ensure_setup()
+        return self._k32
+
+
+_winapi = WinAPI()
+
+
+def create_file(path, access=GENERIC_READ | GENERIC_WRITE,
+                share=FILE_SHARE_READ | FILE_SHARE_WRITE,
+                disposition=OPEN_ALWAYS):
+    """Open a file handle via CreateFileW. Returns handle as int."""
+    import ctypes
+    api = _winapi
+    handle = api.k32.CreateFileW(
+        str(path), access, share, None, disposition, 0, None
+    )
+    if handle is None or handle == ctypes.c_void_p(INVALID_HANDLE_VALUE).value:
+        err = ctypes.get_last_error()
+        raise OSError(err, _get_last_error_message(), str(path))
+    return handle
+
+
+def close_handle(handle):
+    """Close a Win32 handle."""
+    _winapi.k32.CloseHandle(handle)
+
+
+def device_io_control(handle, code, in_buf=None, out_buf_size=0):
+    """Call DeviceIoControl. Returns bytes returned in output buffer."""
+    import ctypes
+    api = _winapi
+
+    if in_buf is not None:
+        in_ptr = ctypes.cast(in_buf, ctypes.c_void_p)
+        in_size = len(in_buf) if isinstance(in_buf, (bytes, bytearray)) else ctypes.sizeof(in_buf)
+    else:
+        in_ptr = None
+        in_size = 0
+
+    if out_buf_size > 0:
+        out_buf = ctypes.create_string_buffer(out_buf_size)
+        out_ptr = ctypes.cast(out_buf, ctypes.c_void_p)
+    else:
+        out_buf = None
+        out_ptr = None
+
+    bytes_returned = ctypes.c_uint32(0)
+    ret = api.k32.DeviceIoControl(
+        handle, code, in_ptr, in_size,
+        out_ptr, out_buf_size,
+        ctypes.byref(bytes_returned), None
+    )
+    if not ret:
+        err = ctypes.get_last_error()
+        raise OSError(err, _get_last_error_message())
+    if out_buf is not None:
+        return out_buf.raw[:bytes_returned.value]
+    return b""
+
+
+def set_sparse(handle):
+    """Mark a file as sparse via FSCTL_SET_SPARSE."""
+    device_io_control(handle, FSCTL_SET_SPARSE)
+
+
+def set_file_pointer_ex(handle, distance, move_method=0):
+    """Set file pointer. move_method: 0=FILE_BEGIN, 1=FILE_CURRENT, 2=FILE_END."""
+    import ctypes
+    api = _winapi
+    new_pos = ctypes.c_int64(0)
+    ret = api.k32.SetFilePointerEx(
+        handle, ctypes.c_int64(distance),
+        ctypes.byref(new_pos), move_method
+    )
+    if not ret:
+        err = ctypes.get_last_error()
+        raise OSError(err, _get_last_error_message())
+    return new_pos.value
+
+
+def set_end_of_file(handle):
+    """Set end of file to current position."""
+    import ctypes
+    api = _winapi
+    ret = api.k32.SetEndOfFile(handle)
+    if not ret:
+        err = ctypes.get_last_error()
+        raise OSError(err, _get_last_error_message())
+
+
+def get_compressed_file_size(path):
+    """Return the compressed (on-disk) size of a file."""
+    import ctypes
+    api = _winapi
+    high = ctypes.c_uint32(0)
+    low = api.k32.GetCompressedFileSizeW(str(path), ctypes.byref(high))
+    if low == 0xFFFFFFFF:
+        err = ctypes.get_last_error()
+        if err != 0:
+            raise OSError(err, _get_last_error_message(), str(path))
+    return (high.value << 32) | low
+
+
+def query_allocated_ranges(handle, file_size):
+    """Query allocated ranges for a file. Returns list of (offset, length)."""
+    import ctypes
+    import struct
+
+    if file_size == 0:
+        return []
+
+    # Input: FILE_ALLOCATED_RANGE_BUFFER { LargeInteger StartingVcn; LargeInteger Length; }
+    # We request from offset 0 to file_size
+    # Actually the input structure is:
+    #   typedef struct _FILE_ALLOCATED_RANGE_BUFFER {
+    #       LARGE_INTEGER FileOffset;
+    #       LARGE_INTEGER Length;
+    #   } FILE_ALLOCATED_RANGE_BUFFER;
+    in_struct = struct.pack("<qq", 0, file_size)
+
+    # Output can contain multiple FILE_ALLOCATED_RANGE_BUFFER entries
+    # Each entry is 16 bytes (two LARGE_INTEGERs)
+    max_entries = max(256, file_size // 4096 + 16)
+    out_buf_size = max_entries * 16
+
+    try:
+        data = device_io_control(
+            handle, FSCTL_QUERY_ALLOCATED_RANGES,
+            in_buf=in_struct, out_buf_size=out_buf_size
+        )
+    except OSError:
+        # If the file is not sparse, this may fail; treat entire file as allocated
+        return [(0, file_size)]
+
+    ranges = []
+    entry_size = 16
+    num_entries = len(data) // entry_size
+    for i in range(num_entries):
+        offset, length = struct.unpack_from("<qq", data, i * entry_size)
+        if length > 0:
+            # Clamp to file size
+            if offset < file_size:
+                end = min(offset + length, file_size)
+                actual_length = end - offset
+                if actual_length > 0:
+                    ranges.append((offset, actual_length))
+
+    return ranges
