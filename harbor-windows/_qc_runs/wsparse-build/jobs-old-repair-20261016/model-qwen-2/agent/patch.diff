diff --git a/_debug_alloc.py b/_debug_alloc.py
new file mode 100644
index 0000000..141ebf6
--- /dev/null
+++ b/_debug_alloc.py
@@ -0,0 +1,53 @@
+import tempfile, os, ctypes, msvcrt
+from wsparse import preallocate
+
+td = tempfile.mkdtemp()
+path = os.path.join(td, 'test.bin')
+preallocate(path, 64 * 1024 * 1024)
+
+f = open(path, 'r+b')
+f.seek(1024)
+f.write(b'hello world test data here padding to make it bigger')
+f.flush()
+
+# Get Win32 handle from Python file descriptor
+win_handle = msvcrt.get_osfhandle(f.fileno())
+print("Win32 handle:", win_handle)
+
+k32 = ctypes.windll.kernel32
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [
+        ('AllocationSize', ctypes.c_int64),
+        ('EndOfFile', ctypes.c_int64),
+        ('NumberOfLinks', ctypes.c_uint32),
+        ('DeletePending', ctypes.c_byte),
+        ('Directory', ctypes.c_byte),
+    ]
+
+info = FILE_STANDARD_INFO()
+FileStandardInfo = 1  # FILE_INFO_BY_HANDLE_CLASS enum value
+ret = k32.GetFileInformationByHandleEx(
+    ctypes.c_void_p(win_handle),
+    FileStandardInfo,
+    ctypes.byref(info),
+    ctypes.sizeof(info)
+)
+err = ctypes.get_last_error()
+print(f"GetFileInformationByHandleEx ret={ret}, err={err}")
+print(f"AllocationSize: {info.AllocationSize}")
+print(f"EndOfFile: {info.EndOfFile}")
+
+# Also try GetCompressedFileSizeW
+high = ctypes.c_uint32(0)
+low = k32.GetCompressedFileSizeW(str(path), ctypes.byref(high))
+err2 = ctypes.get_last_error()
+compressed = (high.value << 32) | low
+print(f"GetCompressedFileSizeW: low={low}, high={high.value}, combined={compressed}, err={err2}")
+
+f.close()
+
+# Also check via os.stat
+st = os.stat(path)
+print(f"os.stat st_size: {st.st_size}")
+print(f"os.stat st_file_attributes: {getattr(st, 'st_file_attributes', 'N/A')}")
