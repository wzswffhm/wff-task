+import tempfile, os
+from wsparse import preallocate, disk_usage, allocated_ranges, sparse_state, WSParseError
+
+print("=== Test 1: Sparse preallocation (1 GiB) ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'sparse_1g.bin')
+    size = 1 << 30
+    result = preallocate(path, size)
+    print(f'Preallocate returned: {result}')
+    print(f'File logical size: {os.path.getsize(path)}')
+    usage = disk_usage(path)
+    print(f'Disk usage: {usage} bytes ({usage / (1024*1024):.2f} MiB)')
+    print(f'Sparse state: {sparse_state(path)}')
+    ranges = allocated_ranges(path)
+    print(f'Allocated ranges count: {len(ranges)}')
+    assert usage < 8 * 1024 * 1024, f"FAIL: Disk usage too large: {usage}"
+    print('PASS')
+
+print()
+print("=== Test 2: Write to sparse file, close, then verify ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'sparse_write.bin')
+    size = 64 * 1024 * 1024
+    preallocate(path, size)
+    
+    payload = b"collector-payload-data"
+    with open(path, "r+b") as f:
+        f.seek(1024)
+        f.write(payload)
+    # File is now closed
+    
+    with open(path, "rb") as f:
+        f.seek(1024)
+        readback = f.read(len(payload))
+    assert readback == payload, "FAIL: Data mismatch"
+    print("Data read back correctly")
+    
+    usage = disk_usage(path)
+    print(f'Disk usage after write+close: {usage} bytes ({usage / 1024:.2f} KiB)')
+    assert usage < 1024 * 1024, f"FAIL: Disk usage too large: {usage}"
+    print("Disk usage still small after partial write")
+    
+    ranges = allocated_ranges(path)
+    print(f'Allocated ranges: {ranges}')
+    print('PASS')
+
+print()
+print("=== Test 3: Dense file disk_usage ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'dense.bin')
+    data = b"x" * 65536
+    with open(path, "wb") as f:
+        f.write(data)
+    usage = disk_usage(path)
+    print(f'Logical size: {len(data)}, Disk usage: {usage}')
+    assert usage >= len(data), f"FAIL: {usage} < {len(data)}"
+    print("PASS")
+
+print()
+print("=== Test 4: Hollow file has empty ranges ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'hollow.bin')
+    preallocate(path, 1 << 20)
+    ranges = allocated_ranges(path)
+    print(f'Ranges for hollow sparse file: {ranges}')
+    assert len(ranges) == 0, f"Expected empty, got {ranges}"
+    print("PASS")
+
+print()
+print("=== Test 5: Non-sparse dense file ranges ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'dense_ranges.bin')
+    with open(path, "wb") as f:
+        f.write(b"y" * 8192)
+    ranges = allocated_ranges(path)
+    print(f'Ranges: {ranges}')
+    total = sum(l for _, l in ranges)
+    assert total >= 8192, f"FAIL: coverage {total} < 8192"
+    print("PASS")
+
+print()
+print("=== Test 6: Error on directory ===")
+with tempfile.TemporaryDirectory() as td:
+    try:
+        disk_usage(td)
+        print("FAIL: Should have raised WSParseError")
+    except WSParseError as e:
+        assert e.kind == "unsupported", f"Expected 'unsupported', got '{e.kind}'"
+        print(f"PASS: Got WSParseError(kind='unsupported')")
+
+print()
+print("=== Test 7: Two writes at different offsets ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'two_writes.bin')
+    preallocate(path, 64 * 1024 * 1024)
+    
+    with open(path, "r+b") as f:
+        f.seek(0)
+        f.write(b'A' * 4096)
+        f.seek(32 * 1024 * 1024)
+        f.write(b'B' * 4096)
+    # Closed
+    
+    usage = disk_usage(path)
+    print(f'Disk usage: {usage} bytes ({usage / 1024:.2f} KiB)')
+    assert usage < 1024 * 1024, f"FAIL: {usage}"
+    
+    ranges = allocated_ranges(path)
+    print(f'Ranges: {ranges}')
+    # Should have at least 2 ranges (one near 0, one near 32MB)
+    if len(ranges) >= 2:
+        print("PASS: Multiple ranges detected")
+    else:
+        print(f"INFO: Got {len(ranges)} range(s)")
+
+print()
+print("=== Test 8: Verify holes read as zeros ===")
+with tempfile.TemporaryDirectory() as td:
+    path = os.path.join(td, 'zeros.bin')
+    preallocate(path, 1 << 20)
+    
+    with open(path, "r+b") as f:
+        f.seek(4096)
+        f.write(b"DATA")
+    
+    with open(path, "rb") as f:
+        hole = f.read(4096)
+        f.seek(4096)
+        data = f.read(4)
+        f.seek(4100)
+        hole2 = f.read(100)
+    
+    assert hole == b'\x00' * 4096, "Hole before data should be zeros"
+    assert data == b"DATA", "Written data should be readable"
+    assert hole2 == b'\x00' * 100, "Hole after data should be zeros"
+    print("PASS: Holes read as zeros")
+
+print()
+print("=== All tests PASSED ===")
