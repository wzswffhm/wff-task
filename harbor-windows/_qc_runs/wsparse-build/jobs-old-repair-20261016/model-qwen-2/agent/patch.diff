+import tempfile, os, ctypes, msvcrt
+from wsparse import preallocate
+
+td = tempfile.mkdtemp()
+path = os.path.join(td, 'test.bin')
+preallocate(path, 64 * 1024 * 1024)
+
+f = open(path, 'r+b')
+# Write a larger chunk - 8KB at offset 1MB
+f.seek(1024 * 1024)
+f.write(b'X' * 8192)
+f.flush()
+
+win_handle = msvcrt.get_osfhandle(f.fileno())
+
+k32 = ctypes.windll.kernel32
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [
+        ('AllocationSize', ctypes.c_int64),
+        ('EndOfFile', ctypes.c_int64),
+        ('NumberOfLinks', ctypes.c_uint32),
+        ('DeletePending', ctypes.c_byte),
+        ('Directory', ctypes.c_byte),
+    ]
+
+info = FILE_STANDARD_INFO()
+ret = k32.GetFileInformationByHandleEx(
+    ctypes.c_void_p(win_handle),
+    1,  # FileStandardInfo
+    ctypes.byref(info),
+    ctypes.sizeof(info)
+)
+print(f"After writing 8KB at 1MB offset:")
+print(f"  AllocationSize: {info.AllocationSize}")
+print(f"  EndOfFile: {info.EndOfFile}")
+
+high = ctypes.c_uint32(0)
+low = k32.GetCompressedFileSizeW(str(path), ctypes.byref(high))
+compressed = (high.value << 32) | low
+print(f"  GetCompressedFileSizeW: {compressed}")
+
+f.close()
+
+# Now try with even more data
+path2 = os.path.join(td, 'test2.bin')
+preallocate(path2, 64 * 1024 * 1024)
+f2 = open(path2, 'r+b')
+# Write 64KB at two different locations
+f2.seek(0)
+f2.write(b'A' * 32768)
+f2.seek(32 * 1024 * 1024)
+f2.write(b'B' * 32768)
+f2.flush()
+
+win_handle2 = msvcrt.get_osfhandle(f2.fileno())
+info2 = FILE_STANDARD_INFO()
+ret2 = k32.GetFileInformationByHandleEx(
+    ctypes.c_void_p(win_handle2),
+    1,
+    ctypes.byref(info2),
+    ctypes.sizeof(info2)
+)
+print(f"\nAfter writing 32KB at offset 0 and 32KB at offset 32MB:")
+print(f"  AllocationSize: {info2.AllocationSize}")
+print(f"  EndOfFile: {info2.EndOfFile}")
+
+high2 = ctypes.c_uint32(0)
+low2 = k32.GetCompressedFileSizeW(str(path2), ctypes.byref(high2))
+compressed2 = (high2.value << 32) | low2
+print(f"  GetCompressedFileSizeW: {compressed2}")
+
+f2.close()
diff --git a/_debug_alloc3.py b/_debug_alloc3.py
new file mode 100644
index 0000000..6d3d011
--- /dev/null
+++ b/_debug_alloc3.py
@@ -0,0 +1,60 @@
+import tempfile, os, ctypes, msvcrt
+from wsparse import preallocate
+
+td = tempfile.mkdtemp()
+path = os.path.join(td, 'test.bin')
+preallocate(path, 64 * 1024 * 1024)
+
+# Use Win32 WriteFile directly
+k32 = ctypes.windll.kernel32
+
+handle = k32.CreateFileW(
+    str(path),
+    0x80000000 | 0x40000000,  # GENERIC_READ | GENERIC_WRITE
+    0x00000001 | 0x00000002,  # FILE_SHARE_READ | FILE_SHARE_WRITE
+    None,
+    3,  # OPEN_EXISTING
+    0,
+    None
+)
+print(f"Handle: {handle}")
+
+# Seek to 1MB and write 64KB
+li = ctypes.c_int64(1024 * 1024)
+new_pos = ctypes.c_int64(0)
+ret = k32.SetFilePointerEx(handle, li, ctypes.byref(new_pos), 0)
+print(f"Seek ret={ret}, new_pos={new_pos.value}")
+
+data = b'X' * 65536
+written = ctypes.c_uint32(0)
+ret = k32.WriteFile(handle, data, len(data), ctypes.byref(written), None)
+print(f"Write ret={ret}, written={written.value}")
+
+# Flush
+ret = k32.FlushFileBuffers(handle)
+print(f"Flush ret={ret}")
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [
+        ('AllocationSize', ctypes.c_int64),
+        ('EndOfFile', ctypes.c_int64),
+        ('NumberOfLinks', ctypes.c_uint32),
+        ('DeletePending', ctypes.c_byte),
+        ('Directory', ctypes.c_byte),
+    ]
+
+info = FILE_STANDARD_INFO()
+ret = k32.GetFileInformationByHandleEx(handle, 1, ctypes.byref(info), ctypes.sizeof(info))
+print(f"AllocationSize: {info.AllocationSize}")
+print(f"EndOfFile: {info.EndOfFile}")
+
+high = ctypes.c_uint32(0)
+low = k32.GetCompressedFileSizeW(str(path), ctypes.byref(high))
+compressed = (high.value << 32) | low
+print(f"GetCompressedFileSizeW: {compressed}")
+
+k32.CloseHandle(handle)
+
+# Also check via fresh open
+st = os.stat(path)
+print(f"os.stat st_size: {st.st_size}")
