+import tempfile, os, ctypes, msvcrt
+from wsparse import preallocate, disk_usage
+
+td = tempfile.mkdtemp()
+path = os.path.join(td, 'test.bin')
+preallocate(path, 64 * 1024 * 1024)
+
+# Write using Python open, then close completely
+f = open(path, 'r+b')
+f.seek(1024 * 1024)
+f.write(b'X' * 65536)
+f.flush()
+os.fsync(f.fileno())
+f.close()
+
+# Now check with a fresh stat
+print("After Python write + fsync + close:")
+print(f"  os.stat st_size: {os.path.getsize(path)}")
+print(f"  disk_usage: {disk_usage(path)}")
+
+# Check with fresh Win32 handle
+k32 = ctypes.windll.kernel32
+handle = k32.CreateFileW(
+    str(path),
+    0x80000000,  # GENERIC_READ
+    0x00000001 | 0x00000002,
+    None, 3, 0, None
+)
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [
+        ('AllocationSize', ctypes.c_int64),
+        ('EndOfFile', ctypes.c_int64),
+        ('NumberOfLinks', ctypes.c_uint32),
+        ('DeletePending', ctypes.c_byte),
+        ('Directory', ctypes.c_byte),
+    ]
+
+info = FILE_STANDARD_INFO()
+ret = k32.GetFileInformationByHandleEx(handle, 1, ctypes.byref(info), ctypes.sizeof(info))
+print(f"  Fresh handle AllocationSize: {info.AllocationSize}")
+
+high = ctypes.c_uint32(0)
+low = k32.GetCompressedFileSizeW(str(path), ctypes.byref(high))
+compressed = (high.value << 32) | low
+print(f"  Fresh GetCompressedFileSizeW: {compressed}")
+
+k32.CloseHandle(handle)
