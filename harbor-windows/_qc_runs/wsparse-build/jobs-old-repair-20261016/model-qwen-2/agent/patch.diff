+import tempfile, os, ctypes
+from wsparse import preallocate
+from wsparse._winapi import create_file, close_handle, GENERIC_READ, OPEN_EXISTING, FILE_SHARE_READ, FILE_SHARE_WRITE
+
+td = tempfile.mkdtemp()
+path = os.path.join(td, 'test.bin')
+preallocate(path, 64 * 1024 * 1024)
+
+# Write 64KB at offset 1MB using Win32 API
+handle = create_file(path)
+k32 = ctypes.windll.kernel32
+
+li = ctypes.c_int64(1024 * 1024)
+new_pos = ctypes.c_int64(0)
+k32.SetFilePointerEx(handle, li, ctypes.byref(new_pos), 0)
+data = b'X' * 65536
+written = ctypes.c_uint32(0)
+k32.WriteFile(handle, data, len(data), ctypes.byref(written), None)
+k32.FlushFileBuffers(handle)
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [
+        ('AllocationSize', ctypes.c_int64),
+        ('EndOfFile', ctypes.c_int64),
+        ('NumberOfLinks', ctypes.c_uint32),
+        ('DeletePending', ctypes.c_byte),
+        ('Directory', ctypes.c_byte),
+    ]
+
+info = FILE_STANDARD_INFO()
+ret = k32.GetFileInformationByHandleEx(handle, 1, ctypes.byref(info), ctypes.sizeof(info))
+print(f"Win32 write - AllocationSize: {info.AllocationSize}, EndOfFile: {info.EndOfFile}")
+
+close_handle(handle)
+
+# Now check with a fresh handle
+handle2 = create_file(path, access=GENERIC_READ, share=FILE_SHARE_READ | FILE_SHARE_WRITE, disposition=OPEN_EXISTING)
+info2 = FILE_STANDARD_INFO()
+ret2 = k32.GetFileInformationByHandleEx(handle2, 1, ctypes.byref(info2), ctypes.sizeof(info2))
+print(f"Fresh handle - AllocationSize: {info2.AllocationSize}, EndOfFile: {info2.EndOfFile}")
+
+high = ctypes.c_uint32(0)
+low = k32.GetCompressedFileSizeW(str(path), ctypes.byref(high))
+compressed = (high.value << 32) | low
+print(f"GetCompressedFileSizeW: {compressed}")
+
+close_handle(handle2)
+
+# Also try via Python open + close
+with open(path, "r+b") as f:
+    f.seek(32 * 1024 * 1024)
+    f.write(b'Y' * 65536)
+
+# After Python close, check again
+handle3 = create_file(path, access=GENERIC_READ, share=FILE_SHARE_READ | FILE_SHARE_WRITE, disposition=OPEN_EXISTING)
+info3 = FILE_STANDARD_INFO()
+ret3 = k32.GetFileInformationByHandleEx(handle3, 1, ctypes.byref(info3), ctypes.sizeof(info3))
+print(f"\nAfter Python write+close - AllocationSize: {info3.AllocationSize}")
+
+high3 = ctypes.c_uint32(0)
+low3 = k32.GetCompressedFileSizeW(str(path), ctypes.byref(high3))
+compressed3 = (high3.value << 32) | low3
+print(f"GetCompressedFileSizeW: {compressed3}")
+
+close_handle(handle3)
