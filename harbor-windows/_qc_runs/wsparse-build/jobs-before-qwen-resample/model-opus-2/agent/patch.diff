diff --git a/wsparse/_support.py b/wsparse/_support.py
new file mode 100644
index 0000000..dced1d3
--- /dev/null
+++ b/wsparse/_support.py
@@ -0,0 +1,90 @@
+"""Shared plumbing: path checking and Win32 -> :class:`WSParseError` mapping.
+
+The public modules all have to answer the same two questions before they can
+touch the file system:
+
+* is this path something NTFS will do sparse-file work on at all, and
+* when a Win32 call fails, is that failure an "this will never work"
+  (``kind == "unsupported"``) or an ordinary operating-system error
+  (``kind == "os"``)?
+
+Keeping both in one place is what keeps the error taxonomy consistent across
+:func:`wsparse.preallocate`, :func:`wsparse.disk_usage`,
+:func:`wsparse.allocated_ranges`, :func:`wsparse.sparse_flag` and
+:func:`wsparse.sparse_state`.
+"""
+
+import os
+import stat
+
+from . import _winapi
+from .errors import WSParseError
+
+
+def as_path(path):
+    """Normalise ``path`` to ``str``, reporting a bad argument as ``badarg``."""
+    try:
+        path = os.fspath(path)
+    except TypeError as exc:
+        raise WSParseError(
+            "path must be a string or os.PathLike, got %r" % (path,), kind="badarg"
+        ) from exc
+    if isinstance(path, bytes):
+        path = os.fsdecode(path)
+    return path
+
+
+def require_windows(path):
+    """Sparse files are an NTFS concept; off Windows nothing here applies."""
+    if not _winapi.is_windows():
+        raise WSParseError(
+            "sparse-file support requires Windows and NTFS",
+            kind="unsupported",
+            path=path,
+        )
+
+
+def stat_target(path, must_exist=True):
+    """``os.stat`` ``path``, classifying what came back.
+
+    A missing path is an ordinary ``os`` error.  A path that exists but is not
+    a regular file -- a directory, a device, a volume -- can never carry the
+    sparse attribute, so it is reported as ``unsupported`` rather than being
+    allowed to fail later with an unclassified error.
+    """
+    try:
+        info = os.stat(path)
+    except FileNotFoundError as exc:
+        if must_exist:
+            raise WSParseError(str(exc), kind="os", path=path) from exc
+        return None
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+
+    if stat.S_ISDIR(info.st_mode):
+        raise WSParseError(
+            "a directory cannot carry the sparse attribute",
