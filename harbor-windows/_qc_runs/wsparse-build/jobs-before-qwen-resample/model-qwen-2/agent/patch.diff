diff --git a/_verify_acceptance.py b/_verify_acceptance.py
new file mode 100644
index 0000000..d3345f4
--- /dev/null
+++ b/_verify_acceptance.py
@@ -0,0 +1,199 @@
+"""Verification script for wsparse acceptance criteria."""
+import os, sys, tempfile, shutil
+
+# Add workspace to path
+sys.path.insert(0, r'C:\testbed')
+
+from wsparse import preallocate, disk_usage, allocated_ranges, sparse_flag, sparse_state, WSParseError
+
+tmpdir = tempfile.mkdtemp()
+print(f"Working in: {tmpdir}")
+
+errors = []
+
+def check(name, condition, detail=""):
+    if condition:
+        print(f"  PASS: {name}")
+    else:
+        msg = f"  FAIL: {name}" + (f" -- {detail}" if detail else "")
+        print(msg)
+        errors.append(msg)
+
+# === A. Sparse Pre-allocation ===
+print("\n=== A. Sparse Pre-allocation ===")
+sink_a = os.path.join(tmpdir, "sparse_1g.bin")
+length = preallocate(sink_a, 1 << 30)
+check("A1: length == 1GiB", length == 1 << 30, f"got {length}")
+st = os.stat(sink_a)
+check("A2: st_size == 1GiB", st.st_size == 1 << 30, f"got {st.st_size}")
+used = disk_usage(sink_a)
+check("A3: disk_usage < 8MiB for 1GiB sparse", used < 8 * 1024 * 1024, f"got {used}")
+is_sparse = sparse_state(sink_a)
+check("A4: file is marked sparse", is_sparse, f"sparse_state={is_sparse}")
+
+# Idempotent
+length2 = preallocate(sink_a, 1 << 30)
+check("A5: idempotent length", length2 == 1 << 30, f"got {length2}")
+used2 = disk_usage(sink_a)
+check("A6: idempotent disk_usage unchanged", used2 == used, f"was {used}, now {used2}")
+
+# === B. Write semantics after preallocate ===
+print("\n=== B. Write semantics ===")
+sink_b = os.path.join(tmpdir, "write_test.bin")
+preallocate(sink_b, 64 * 1024 * 1024)  # 64 MiB
+
+payload = b"collector-payload-data"
+with open(sink_b, "r+b") as f:
+    f.seek(1024)
+    f.write(payload)
+
+with open(sink_b, "rb") as f:
+    f.seek(1024)
+    readback = f.read(len(payload))
+check("B1: data reads back correctly", readback == payload, f"got {readback!r}")
+
+used_b = disk_usage(sink_b)
+check("B2: disk_usage < 1MiB after small write in 64MiB sparse", used_b < 1024 * 1024, f"got {used_b}")
+
+# Read holes - should be zeros
+with open(sink_b, "rb") as f:
+    f.seek(0)
+    hole_data = f.read(1024)
+check("B3: hole reads as zeros", hole_data == b'\x00' * 1024, f"first bytes: {hole_data[:16]!r}")
+
+# === C. Disk usage ===
+print("\n=== C. Disk usage ===")
+# Sparse file with two small writes
+sink_c = os.path.join(tmpdir, "sparse_usage.bin")
+preallocate(sink_c, 64 * 1024 * 1024)
+with open(sink_c, "r+b") as f:
+    f.seek(0)
+    f.write(b"A" * 4096)
+    f.seek(32 * 1024 * 1024)
+    f.write(b"B" * 4096)
+used_c = disk_usage(sink_c)
+check("C1: sparse 64MiB with 2 writes < 1MiB", used_c < 1024 * 1024, f"got {used_c}")
+
+# Dense file
+sink_dense = os.path.join(tmpdir, "dense_usage.bin")
+with open(sink_dense, "wb") as f:
+    f.write(b"X" * 65536)
+used_dense = disk_usage(sink_dense)
+check("C2: dense 64KiB ~= 64KiB", used_dense >= 65536, f"got {used_dense}")
+check("C3: dense returns int", isinstance(used_dense, int), f"type={type(used_dense)}")
+
+# === D. Allocated ranges ===
+print("\n=== D. Allocated ranges ===")
+# Empty file
+sink_empty = os.path.join(tmpdir, "empty.bin")
+with open(sink_empty, "wb") as f:
+    pass
+ranges_empty = allocated_ranges(sink_empty)
+check("D1: empty file -> empty list", ranges_empty == [], f"got {ranges_empty}")
+
+# All-hole sparse file
+sink_hole = os.path.join(tmpdir, "all_hole.bin")
+preallocate(sink_hole, 1024 * 1024)
+ranges_hole = allocated_ranges(sink_hole)
+check("D2: all-hole sparse -> empty list", ranges_hole == [], f"got {ranges_hole}")
+
+# Sparse with data
+ranges_c = allocated_ranges(sink_c)
+check("D3: sparse with writes has ranges", len(ranges_c) > 0, f"got {ranges_c}")
+size_c = os.path.getsize(sink_c)
+for off, ln in ranges_c:
+    check(f"D4: range ({off},{ln}) inside file", off >= 0 and ln > 0 and off + ln <= size_c)
+
+# Ordered and disjoint
+prev_end = -1
+ordered = True
+for off, ln in ranges_c:
+    if off < prev_end:
+        ordered = False
+        break
+    prev_end = off + ln
+check("D5: ranges are ordered and disjoint", ordered, f"ranges={ranges_c}")
+
+# Dense file ranges
+ranges_dense = allocated_ranges(sink_dense)
+check("D6: dense file has at least one range", len(ranges_dense) > 0, f"got {ranges_dense}")
+if ranges_dense:
+    total_covered = sum(ln for _, ln in ranges_dense)
+    check("D7: dense ranges cover entire file", total_covered >= 65536, f"covered={total_covered}")
+
+# === E. Sequential semantics (sparse flag on dense file) ===
+print("\n=== E. Sequential semantics ===")
+sink_e = os.path.join(tmpdir, "dense_then_sparse.bin")
+with open(sink_e, "wb") as f:
+    f.write(b"D" * 65536)
+used_before = disk_usage(sink_e)
+try:
+    result = sparse_flag(sink_e, True)
+    used_after = disk_usage(sink_e)
+    check("E1: disk_usage still reflects dense after sparse_flag on dense", 
+          used_after >= 65536, f"before={used_before}, after={used_after}")
+except WSParseError as e:
+    # It's also acceptable if it raises an error about unsupported operation
+    print(f"  INFO: sparse_flag on dense raised WSParseError(kind={e.kind})")
+    check("E1-alt: raised appropriate error", True)
+
+# === F. Error classification ===
+print("\n=== F. Error classification ===")
+# Directory path
+dir_path = tmpdir
+try:
+    preallocate(dir_path, 1024)
+    check("F1: preallocate on dir raises WSParseError", False, "no exception raised")
+except WSParseError as e:
+    check("F1: preallocate on dir raises WSParseError", True)
+    check("F1b: kind is 'unsupported' or 'os'", e.kind in ("unsupported", "os"), f"kind={e.kind}")
+except Exception as e:
+    check("F1: preallocate on dir raises WSParseError", False, f"got {type(e).__name__}: {e}")
+
+try:
+    disk_usage(dir_path)
+    # GetCompressedFileSizeW on a directory might succeed or fail
+    print(f"  INFO: disk_usage on dir returned {disk_usage(dir_path)}")
+except WSParseError as e:
+    check("F2: disk_usage on dir raises WSParseError", True)
+except Exception as e:
+    check("F2: disk_usage on dir raises WSParseError", False, f"got {type(e).__name__}: {e}")
+
+try:
+    allocated_ranges(dir_path)
+    check("F3: allocated_ranges on dir raises WSParseError", False, "no exception")
+except WSParseError as e:
+    check("F3: allocated_ranges on dir raises WSParseError", True)
+    check("F3b: kind is 'unsupported' or 'os'", e.kind in ("unsupported", "os"), f"kind={e.kind}")
+except Exception as e:
+    check("F3: allocated_ranges on dir raises WSParseError", False, f"got {type(e).__name__}: {e}")
+
+# Missing file
+try:
+    disk_usage(os.path.join(tmpdir, "nonexistent.bin"))
+    check("F4: disk_usage on missing file raises WSParseError", False, "no exception")
+except WSParseError as e:
+    check("F4: disk_usage on missing raises WSParseError", True)
+    check("F4b: kind is 'os'", e.kind == "os", f"kind={e.kind}")
+
+# === G. No regression ===
+print("\n=== G. API surface ===")
+import wsparse
+check("G1: preallocate exists", hasattr(wsparse, 'preallocate'))
+check("G2: disk_usage exists", hasattr(wsparse, 'disk_usage'))
+check("G3: allocated_ranges exists", hasattr(wsparse, 'allocated_ranges'))
+check("G4: sparse_flag exists", hasattr(wsparse, 'sparse_flag'))
+check("G5: sparse_state exists", hasattr(wsparse, 'sparse_state'))
+check("G6: WSParseError exists", hasattr(wsparse, 'WSParseError'))
+
+# Summary
+print(f"\n{'='*60}")
+if errors:
+    print(f"FAILURES: {len(errors)}")
+    for e in errors:
+        print(e)
+else:
+    print("ALL CHECKS PASSED!")
+
+# Cleanup
+shutil.rmtree(tmpdir)
