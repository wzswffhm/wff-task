+
+GetCompressedFileSizeW = kernel32.GetCompressedFileSizeW
+GetCompressedFileSizeW.restype = ctypes.c_uint32
+GetCompressedFileSizeW.argtypes = [ctypes.c_wchar_p, ctypes.POINTER(ctypes.c_uint32)]
+
+tmpdir = tempfile.mkdtemp()
+path = os.path.join(tmpdir, 'test_sparse.bin')
+
+h = CreateFileW(path, GENERIC_READ | GENERIC_WRITE, 0, None, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, None)
+print(f'Handle: {h}, INVALID: {INVALID_HANDLE_VALUE}')
+
+bytes_returned = ctypes.c_uint32(0)
+ret = DeviceIoControl(h, FSCTL_SET_SPARSE, None, 0, None, 0, ctypes.byref(bytes_returned), None)
+print(f'Set sparse result: {ret}, last error: {ctypes.get_last_error()}')
+
+FILE_BEGIN = 0
+new_pos = ctypes.c_longlong(0)
+size = 1 << 30
+ret = SetFilePointerEx(h, size, ctypes.byref(new_pos), FILE_BEGIN)
+print(f'SetFilePointerEx result: {ret}, new_pos: {new_pos.value}')
+ret = SetEndOfFile(h)
+print(f'SetEndOfFile result: {ret}')
+
+CloseHandle(h)
+
+st = os.stat(path)
+print(f'Logical size: {st.st_size}')
+
+high = ctypes.c_uint32(0)
+low = GetCompressedFileSizeW(path, ctypes.byref(high))
+compressed = (high.value << 32) | low
+print(f'Compressed size: {compressed}')
+
+# Now write some data at offset 1024
+h = CreateFileW(path, GENERIC_READ | GENERIC_WRITE, 0, None, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, None)
+SetFilePointerEx(h, 1024, ctypes.byref(new_pos), FILE_BEGIN)
+data = b'HELLO WORLD'
+written = ctypes.c_uint32(0)
+kernel32.WriteFile(h, data, len(data), ctypes.byref(written), None)
+print(f'Written: {written.value}')
+CloseHandle(h)
+
+high = ctypes.c_uint32(0)
+low = GetCompressedFileSizeW(path, ctypes.byref(high))
+compressed = (high.value << 32) | low
+print(f'Compressed size after write: {compressed}')
+
+# Query allocated ranges
+class FILE_ALLOCATED_RANGE_BUFFER(ctypes.Structure):
+    _fields_ = [("FileOffset", ctypes.c_longlong), ("Length", ctypes.c_longlong)]
+
+h = CreateFileW(path, GENERIC_READ, 0, None, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, None)
+buf = (FILE_ALLOCATED_RANGE_BUFFER * 256)()
+input_buf = FILE_ALLOCATED_RANGE_BUFFER()
+input_buf.FileOffset = 0
+input_buf.Length = size
+bytes_ret = ctypes.c_uint32(0)
+ret = DeviceIoControl(h, FSCTL_QUERY_ALLOCATED_RANGES, ctypes.byref(input_buf), ctypes.sizeof(input_buf), ctypes.byref(buf), ctypes.sizeof(buf), ctypes.byref(bytes_ret), None)
+print(f'Query ranges result: {ret}, bytes returned: {bytes_ret.value}')
+if ret:
+    n = bytes_ret.value // ctypes.sizeof(FILE_ALLOCATED_RANGE_BUFFER)
+    for i in range(n):
+        print(f'  Range {i}: offset={buf[i].FileOffset}, length={buf[i].Length}')
+else:
+    print(f'  Error: {ctypes.get_last_error()}')
+
+CloseHandle(h)
+
+os.unlink(path)
+os.rmdir(tmpdir)
+print("Done!")
