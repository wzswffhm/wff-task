+def query_allocated_ranges(handle, file_size):
+    """Query allocated ranges for a file handle.
+
+    Returns list of (offset, length) tuples.
+    """
+    if file_size == 0:
+        return []
+
+    # Input: the range we want to query (entire file)
+    class InputRange(ctypes.Structure):
+        _fields_ = [
+            ("FileOffset", ctypes.c_longlong),
+            ("Length", ctypes.c_longlong),
+        ]
+
+    inp = InputRange()
+    inp.FileOffset = 0
+    inp.Length = file_size
+
+    # Output buffer: up to 256 ranges
+    MAX_RANGES = 256
+    out_size = MAX_RANGES * ctypes.sizeof(FILE_ALLOCATED_RANGE_BUFFER)
+
+    results = []
+    offset = 0
+    remaining = file_size
+
+    while remaining > 0:
+        inp.FileOffset = offset
+        inp.Length = remaining
+
+        raw = device_io_control(handle, FSCTL_QUERY_ALLOCATED_RANGES, inp, out_size)
+
+        n = len(raw) // ctypes.sizeof(FILE_ALLOCATED_RANGE_BUFFER)
+        if n == 0:
+            break
+
+        buf = (FILE_ALLOCATED_RANGE_BUFFER * n).from_buffer_copy(raw)
+        for i in range(n):
+            r = buf[i]
+            results.append((r.FileOffset, r.Length))
+
+        if n < MAX_RANGES:
+            break
+
+        # Move past last range
+        last = buf[n - 1]
+        next_offset = last.FileOffset + last.Length
+        if next_offset <= offset:
+            break
+        offset = next_offset
+        remaining = file_size - offset
+
+    return results
