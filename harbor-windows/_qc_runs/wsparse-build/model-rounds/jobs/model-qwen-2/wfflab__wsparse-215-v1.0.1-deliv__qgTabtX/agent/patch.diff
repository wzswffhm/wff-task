new file mode 100644
index 0000000..d11c1fa
--- /dev/null
+++ b/_probe4.py
@@ -0,0 +1,133 @@
+import ctypes
+import os
+import tempfile
+from ctypes import wintypes
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+SHARE = 1 | 2 | 4
+OPEN_EXISTING = 3
+OPEN_ALWAYS = 4
+CREATE_ALWAYS = 2
+BACKUP_SEMANTICS = 0x02000000
+INVALID_HANDLE = wintypes.HANDLE(-1).value
+FSCTL_SET_SPARSE = 0x000900C4
+FSCTL_QUERY_ALLOCATED_RANGES = 0x000940CF
+
+CreateFileW = k.CreateFileW
+CreateFileW.restype = wintypes.HANDLE
+CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                        ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+DeviceIoControl = k.DeviceIoControl
+DeviceIoControl.restype = wintypes.BOOL
+DeviceIoControl.argtypes = [wintypes.HANDLE, wintypes.DWORD, ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.SetFilePointerEx.argtypes = [wintypes.HANDLE, wintypes.LARGE_INTEGER,
+                               ctypes.POINTER(wintypes.LARGE_INTEGER), wintypes.DWORD]
+k.SetEndOfFile.restype = wintypes.BOOL
+k.SetEndOfFile.argtypes = [wintypes.HANDLE]
+k.WriteFile.argtypes = [wintypes.HANDLE, ctypes.c_char_p, wintypes.DWORD,
+                        ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.GetFileInformationByHandleEx.argtypes = [wintypes.HANDLE, ctypes.c_int,
+                                           ctypes.c_void_p, wintypes.DWORD,
+                                           ctypes.POINTER(wintypes.DWORD)]
+
+
+class ARB(ctypes.Structure):
+    _fields_ = [("off", wintypes.LARGE_INTEGER), ("len", wintypes.LARGE_INTEGER)]
+
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [("alloc", wintypes.LARGE_INTEGER), ("eof", wintypes.LARGE_INTEGER),
+                ("links", wintypes.DWORD), ("dele", wintypes.BOOLEAN), ("dir", wintypes.BOOLEAN)]
+
+
+def stdinfo(h):
+    fsi = FILE_STANDARD_INFO()
+    rlen = wintypes.DWORD(0)
+    ok = k.GetFileInformationByHandleEx(h, 1, ctypes.byref(fsi), ctypes.sizeof(fsi),
+                                        ctypes.byref(rlen))
+    return ok, ctypes.get_last_error(), fsi.alloc, fsi.eof, fsi.dir
+
+
+def raw_query(h, start, length, cap):
+    out = (ARB * cap)()
+    inp = ARB()
+    inp.off = start
+    inp.len = length
+    ret = wintypes.DWORD(0)
+    ok = DeviceIoControl(h, FSCTL_QUERY_ALLOCATED_RANGES, ctypes.byref(inp), 16,
+                         out, ctypes.sizeof(out), ctypes.byref(ret), None)
+    err = ctypes.get_last_error()
+    n = ret.value // 16
+    return ok, err, [(out[i].off, out[i].len) for i in range(n)]
+
+
+tmp = tempfile.mkdtemp()
+
+# 1. fresh sparse file, no writes
+p = os.path.join(tmp, "fresh.bin")
+h = CreateFileW(p, GENERIC_READ | GENERIC_WRITE, SHARE, None, OPEN_ALWAYS, 0, None)
+r = wintypes.DWORD(0)
+print("1 set sparse:", DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(wintypes.DWORD(1)),
+                                       4, None, 0, ctypes.byref(r), None),
+      ctypes.get_last_error())
+print("1 set sparse NULL in:", DeviceIoControl(h, FSCTL_SET_SPARSE, None, 0, None, 0,
+                                               ctypes.byref(r), None), ctypes.get_last_error())
+k.SetFilePointerEx(h, 64 << 20, None, 0)
+print("1 set eof:", k.SetEndOfFile(h), ctypes.get_last_error())
+print("1 stdinfo:", stdinfo(h))
+print("1 query:", raw_query(h, 0, 64 << 20, 16))
+k.CloseHandle(h)
+print("1 attrs:", hex(os.stat(p).st_file_attributes), "size", os.path.getsize(p))
+
+# 2. dense small file, 100 bytes
+p2 = os.path.join(tmp, "small.bin")
+with open(p2, "wb") as f:
+    f.write(b"z" * 100)
+h2 = CreateFileW(p2, GENERIC_READ, SHARE, None, OPEN_EXISTING, 0, None)
+print("2 stdinfo:", stdinfo(h2))
+print("2 query:", raw_query(h2, 0, 100, 16))
+print("2 query full:", raw_query(h2, 0, 1 << 20, 16))
+k.CloseHandle(h2)
+
+# 3. zero-access handle + FileStandardInfo
+h3 = CreateFileW(p2, 0, SHARE, None, OPEN_EXISTING, 0, None)
+print("3 zero-access valid:", h3 != INVALID_HANDLE, "stdinfo:", stdinfo(h3))
+print("3 query with zero access:", raw_query(h3, 0, 100, 16))
+k.CloseHandle(h3)
+
+# 4. ERROR_MORE_DATA loop: 30 scattered 64KiB-block writes in a 64MiB sparse file
+p4 = os.path.join(tmp, "scat.bin")
+h4 = CreateFileW(p4, GENERIC_READ | GENERIC_WRITE, SHARE, None, OPEN_ALWAYS, 0, None)
+DeviceIoControl(h4, FSCTL_SET_SPARSE, ctypes.byref(wintypes.DWORD(1)), 4, None, 0,
+                ctypes.byref(r), None)
+k.SetFilePointerEx(h4, 64 << 20, None, 0)
+k.SetEndOfFile(h4)
+w = wintypes.DWORD(0)
+for i in range(30):
+    off = i * (1 << 20) + (1 << 19)
+    k.SetFilePointerEx(h4, off, None, 0)
+    k.WriteFile(h4, b"Q", 1, ctypes.byref(w), None)
+k.FlushFileBuffers(h4)
+print("4 stdinfo:", stdinfo(h4))
+print("4 query cap=2:", raw_query(h4, 0, 64 << 20, 2))
+print("4 query cap=1:", raw_query(h4, 0, 64 << 20, 1))
+print("4 query cap=64 count:", len(raw_query(h4, 0, 64 << 20, 64)[2]))
+print("4 query cap=64 first/last:", raw_query(h4, 0, 64 << 20, 64)[2][:2],
+      raw_query(h4, 0, 64 << 20, 64)[2][-2:])
+# resume from a non-cluster-aligned start
+print("4 query start=500:", raw_query(h4, 500, 64 << 20, 4))
+k.CloseHandle(h4)
+
+# 5. directory
+d = os.path.join(tmp, "dir")
+os.mkdir(d)
+h5 = CreateFileW(d, GENERIC_READ, SHARE, None, OPEN_EXISTING, BACKUP_SEMANTICS, None)
+print("5 dir valid:", h5 != INVALID_HANDLE, "stdinfo:", stdinfo(h5))
+print("5 dir query:", raw_query(h5, 0, 1 << 20, 4))
+k.CloseHandle(h5)
+print("5 dir attrs:", hex(os.stat(d).st_file_attributes))
