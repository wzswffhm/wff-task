new file mode 100644
index 0000000..004ae77
--- /dev/null
+++ b/_probe6.py
@@ -0,0 +1,145 @@
+import ctypes
+import os
+import tempfile
+from ctypes import wintypes
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+SHARE = 1 | 2 | 4
+OPEN_EXISTING = 3
+OPEN_ALWAYS = 4
+INVALID_HANDLE = wintypes.HANDLE(-1).value
+FSCTL_SET_SPARSE = 0x000900C4
+FSCTL_QUERY_ALLOCATED_RANGES = 0x000940CF
+
+CreateFileW = k.CreateFileW
+CreateFileW.restype = wintypes.HANDLE
+CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                        ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+DeviceIoControl = k.DeviceIoControl
+DeviceIoControl.restype = wintypes.BOOL
+DeviceIoControl.argtypes = [wintypes.HANDLE, wintypes.DWORD, ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.SetFilePointerEx.argtypes = [wintypes.HANDLE, wintypes.LARGE_INTEGER,
+                               ctypes.POINTER(wintypes.LARGE_INTEGER), wintypes.DWORD]
+k.SetEndOfFile.restype = wintypes.BOOL
+k.WriteFile.argtypes = [wintypes.HANDLE, ctypes.c_char_p, wintypes.DWORD,
+                        ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.GetFileInformationByHandleEx.argtypes = [wintypes.HANDLE, ctypes.c_int,
+                                           ctypes.c_void_p, wintypes.DWORD,
+                                           ctypes.POINTER(wintypes.DWORD)]
+k.GetCompressedFileSizeW.restype = wintypes.DWORD
+k.GetCompressedFileSizeW.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(wintypes.DWORD)]
+
+
+class ARB(ctypes.Structure):
+    _fields_ = [("off", wintypes.LARGE_INTEGER), ("len", wintypes.LARGE_INTEGER)]
+
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [("alloc", wintypes.LARGE_INTEGER), ("eof", wintypes.LARGE_INTEGER),
+                ("links", wintypes.DWORD), ("dele", wintypes.BOOLEAN), ("dir", wintypes.BOOLEAN)]
+
+
+def stdinfo(h):
+    fsi = FILE_STANDARD_INFO()
+    rlen = wintypes.DWORD(0)
+    ok = k.GetFileInformationByHandleEx(h, 1, ctypes.byref(fsi), ctypes.sizeof(fsi),
+                                        ctypes.byref(rlen))
+    return (fsi.alloc, fsi.eof) if ok else ctypes.get_last_error()
+
+
+def ranges(h, length, cap=256):
+    out = (ARB * cap)()
+    inp = ARB(0, length)
+    ret = wintypes.DWORD(0)
+    ok = DeviceIoControl(h, FSCTL_QUERY_ALLOCATED_RANGES, ctypes.byref(inp), 16, out,
+                         ctypes.sizeof(out), ctypes.byref(ret), None)
+    n = ret.value // 16
+    return ok, ctypes.get_last_error(), [(out[i].off, out[i].len) for i in range(n)]
+
+
+def compressed(path):
+    high = wintypes.DWORD(0)
+    low = k.GetCompressedFileSizeW(path, ctypes.byref(high))
+    return ((high.value << 32) | low, ctypes.get_last_error())
+
+
+tmp = tempfile.mkdtemp()
+ret = wintypes.DWORD(0)
+TRUE = wintypes.DWORD(1)
+
+p = os.path.join(tmp, "a.bin")
+h = CreateFileW(p, GENERIC_READ | GENERIC_WRITE, SHARE, None, OPEN_ALWAYS, 0, None)
+DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(TRUE), 4, None, 0, ctypes.byref(ret), None)
+k.SetFilePointerEx(h, 64 << 20, None, 0)
+k.SetEndOfFile(h)
+k.CloseHandle(h)
+
+print("--- write via python file object, then fresh handles ---")
+with open(p, "r+b") as f:
+    f.seek(40960)
+    f.write(b"hello")
+    f.seek(20 << 20)
+    f.write(b"world")
+
+for access, label in ((GENERIC_READ, "read"), (0, "zero"),
+                      (GENERIC_READ | GENERIC_WRITE, "rw")):
+    h = CreateFileW(p, access, SHARE, None, OPEN_EXISTING, 0, None)
+    if h == INVALID_HANDLE:
+        print(label, "open failed", ctypes.get_last_error())
+        continue
+    print(label, "stdinfo", stdinfo(h), "ranges", ranges(h, 64 << 20))
+    k.CloseHandle(h)
+print("compressed:", compressed(p))
+
+print("--- same, but write through the same handle + flush ---")
+p2 = os.path.join(tmp, "b.bin")
+h = CreateFileW(p2, GENERIC_READ | GENERIC_WRITE, SHARE, None, OPEN_ALWAYS, 0, None)
+DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(TRUE), 4, None, 0, ctypes.byref(ret), None)
+k.SetFilePointerEx(h, 64 << 20, None, 0)
+k.SetEndOfFile(h)
+print("before writes stdinfo:", stdinfo(h))
+w = wintypes.DWORD(0)
+for off in (40960, 20 << 20):
+    k.SetFilePointerEx(h, off, None, 0)
+    k.WriteFile(h, b"hello", 5, ctypes.byref(w), None)
+print("before flush stdinfo:", stdinfo(h), "ranges", ranges(h, 64 << 20)[2])
+k.FlushFileBuffers(h)
+print("after flush stdinfo:", stdinfo(h), "ranges", ranges(h, 64 << 20)[2])
+k.CloseHandle(h)
+h = CreateFileW(p2, GENERIC_READ, SHARE, None, OPEN_EXISTING, 0, None)
+print("reopened stdinfo:", stdinfo(h), "ranges", ranges(h, 64 << 20)[2])
+k.CloseHandle(h)
+print("compressed b:", compressed(p2))
+
+print("--- dense 64MiB via python ---")
+p3 = os.path.join(tmp, "d.bin")
+with open(p3, "wb") as f:
+    f.write(b"x" * (64 << 20))
+h = CreateFileW(p3, GENERIC_READ, SHARE, None, OPEN_EXISTING, 0, None)
+print("dense stdinfo", stdinfo(h), "ranges", ranges(h, 64 << 20)[2])
+k.CloseHandle(h)
+print("dense compressed", compressed(p3))
+
+print("--- directory / missing ---")
+d = os.path.join(tmp, "dir")
+os.mkdir(d)
+print("dir compressed:", compressed(d))
+print("missing compressed:", compressed(os.path.join(tmp, "nope")))
+
+print("--- 1GiB sparse, no writes ---")
+p4 = os.path.join(tmp, "g.bin")
+h = CreateFileW(p4, GENERIC_READ | GENERIC_WRITE, SHARE, None, OPEN_ALWAYS, 0, None)
+DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(TRUE), 4, None, 0, ctypes.byref(ret), None)
+k.SetFilePointerEx(h, 1 << 30, None, 0)
+k.SetEndOfFile(h)
+print("1GiB stdinfo:", stdinfo(h))
+k.CloseHandle(h)
+print("1GiB compressed:", compressed(p4), "size", os.path.getsize(p4))
+h = CreateFileW(p4, GENERIC_READ, SHARE, None, OPEN_EXISTING, 0, None)
+print("1GiB ranges:", ranges(h, 1 << 30))
+k.CloseHandle(h)
