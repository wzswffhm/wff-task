+k.FlushFileBuffers(h)
+print("C attrs now:", hex(os.stat(pC).st_file_attributes))
+print("C clear sparse:", DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(FALSE), 4, None, 0,
+                                         ctypes.byref(ret), None), ctypes.get_last_error())
+k.FlushFileBuffers(h)
+print("C attrs after clear:", hex(os.stat(pC).st_file_attributes))
+print("C stdinfo:", stdinfo(h))
+k.CloseHandle(h)
+
+# D) asset file
+asset = r"C:\testbed\assets\dense_64k.bin"
+if os.path.exists(asset):
+    print("D asset size:", os.path.getsize(asset), "attrs:", hex(os.stat(asset).st_file_attributes))
+    h = CreateFileW(asset, GENERIC_READ, SHARE, None, OPEN_EXISTING, 0, None)
+    print("D stdinfo:", stdinfo(h))
+    out = (ARB * 8)()
+    inp = ARB(0, 1 << 20)
+    DeviceIoControl(h, FSCTL_QUERY_ALLOCATED_RANGES, ctypes.byref(inp), 16, out,
+                    ctypes.sizeof(out), ctypes.byref(ret), None)
+    print("D ranges:", [(out[i].off, out[i].len) for i in range(ret.value // 16)])
+    k.CloseHandle(h)
+    high = wintypes.DWORD(0)
+    k.GetCompressedFileSizeW.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(wintypes.DWORD)]
+    print("D compressed:", k.GetCompressedFileSizeW(asset, ctypes.byref(high)))
+
+# E) dense file created by python then extended via SetEndOfFile
+pE = os.path.join(tmp, "e.bin")
+with open(pE, "wb") as f:
+    f.write(b"z" * 4096)
+h = CreateFileW(pE, GENERIC_READ | GENERIC_WRITE, SHARE, None, OPEN_EXISTING, 0, None)
+print("E set sparse:", DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(TRUE), 4, None, 0,
+                                       ctypes.byref(ret), None), ctypes.get_last_error())
+k.SetFilePointerEx(h, 1 << 22, None, 0)
+print("E set eof:", k.SetEndOfFile(h), ctypes.get_last_error())
+print("E stdinfo:", stdinfo(h))
+out = (ARB * 8)()
+inp = ARB(0, 1 << 22)
+DeviceIoControl(h, FSCTL_QUERY_ALLOCATED_RANGES, ctypes.byref(inp), 16, out,
+                ctypes.sizeof(out), ctypes.byref(ret), None)
+print("E ranges:", [(out[i].off, out[i].len) for i in range(ret.value // 16)])
+k.CloseHandle(h)
+with open(pE, "rb") as f:
+    print("E tail read zeros:", f.read()[-100:] == b"\x00" * 100, "len", os.path.getsize(pE))
+
+# F) volume cluster size of the testbed drive
+spc = wintypes.DWORD(); bps = wintypes.DWORD()
+k.GetDiskFreeSpaceW.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(wintypes.DWORD),
+                                ctypes.POINTER(wintypes.DWORD), ctypes.POINTER(wintypes.DWORD),
+                                ctypes.POINTER(wintypes.DWORD)]
+print("F cluster:", k.GetDiskFreeSpaceW("C:\\", ctypes.byref(spc), ctypes.byref(bps),
+                                         None, None), spc.value * bps.value)
