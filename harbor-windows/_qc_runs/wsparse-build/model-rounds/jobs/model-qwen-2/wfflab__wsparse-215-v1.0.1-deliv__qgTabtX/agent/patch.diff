diff --git a/_check2.py b/_check2.py
new file mode 100644
index 0000000..0b99f99
--- /dev/null
+++ b/_check2.py
@@ -0,0 +1,41 @@
+import os
+import pathlib
+import tempfile
+
+from wsparse import allocated_ranges, disk_usage, preallocate, sparse_flag, sparse_state
+
+t = tempfile.mkdtemp()
+p = pathlib.Path(t) / "x.bin"
+preallocate(p, 1 << 20)
+print("sparse usage", disk_usage(p), allocated_ranges(p))
+sparse_flag(p, False)
+print("after clearing sparse: state", sparse_state(p), "usage", disk_usage(p),
+      allocated_ranges(p))
+print("bytes path usage", disk_usage(str(p).encode()),
+      allocated_ranges(str(p).encode()))
+
+# written range granularity check: one write of 160 bytes
+q = pathlib.Path(t) / "y.bin"
+preallocate(q, 1 << 20)
+with open(q, "r+b") as fh:
+    fh.seek(40960)
+    fh.write(b"h" * 160)
+print("one write 40960+160 ->", allocated_ranges(q), disk_usage(q))
+with open(q, "r+b") as fh:
+    fh.seek(0)
+    fh.write(b"h")
+print("write at 0 ->", allocated_ranges(q), disk_usage(q))
+with open(q, "r+b") as fh:
+    fh.seek(1 << 20 - 1)
+    fh.write(b"h")
+print("write at eof-1 ->", allocated_ranges(q), disk_usage(q))
+
+# unaligned extents: does NTFS report unaligned ranges?
+r = pathlib.Path(t) / "z.bin"
+preallocate(r, 1 << 20)
+with open(r, "r+b") as fh:
+    fh.seek(1000)
+    fh.write(b"a" * 50)
+    fh.seek(700000)
+    fh.write(b"b" * 5)
+print("unaligned writes ->", allocated_ranges(r), disk_usage(r))
diff --git a/_check_acceptance.py b/_check_acceptance.py
new file mode 100644
index 0000000..da0df27
--- /dev/null
+++ b/_check_acceptance.py
@@ -0,0 +1,228 @@
+"""Scratch validation of the acceptance criteria (not part of the repo)."""
+import os
+import shutil
+import tempfile
+
+from wsparse import (
+    WSParseError,
+    allocated_ranges,
+    disk_usage,
+    preallocate,
+    sparse_flag,
+    sparse_state,
+)
+
+TMP = tempfile.mkdtemp(prefix="wsparse-check-")
+failures = []
+
+
+def check(label, condition, extra=""):
+    status = "ok  " if condition else "FAIL"
+    if not condition:
+        failures.append(label)
+    print("%s %-62s %s" % (status, label, extra))
+
+
+def kind_of(fn, *a, **kw):
+    try:
+        fn(*a, **kw)
+    except WSParseError as exc:
+        return exc.kind
+    except OSError as exc:
+        return "OSError:%s" % exc
+    return "no-raise"
+
+
+# ---------------- A: sparse pre-allocation ----------------
+sink = os.path.join(TMP, "a.bin")
+length = preallocate(sink, 1 << 30)
+check("A1 returns size", length == 1 << 30, repr(length))
+check("A1 logical size == 1GiB", os.path.getsize(sink) == 1 << 30)
+check("A1 sparse flag set", sparse_state(sink) is True)
+used = disk_usage(sink)
+check("A2 1GiB usage <= 8MiB", used <= 8 << 20, "%d bytes" % used)
+check("A3 ranges of a pure hole are empty", allocated_ranges(sink) == [])
+preallocate(sink, 1 << 30)
+check("A4 idempotent size", os.path.getsize(sink) == 1 << 30)
+check("A4 idempotent sparse", sparse_state(sink) is True)
+check("A4 idempotent usage", disk_usage(sink) <= 8 << 20, "%d" % disk_usage(sink))
+preallocate(sink, 1 << 20)
+check("A5 never shrinks", os.path.getsize(sink) == 1 << 30)
+# fast?
+import time
+t0 = time.time()
+preallocate(os.path.join(TMP, "fast.bin"), 1 << 30)
+elapsed = time.time() - t0
+check("A6 1GiB preallocate is fast", elapsed < 1.0, "%.4fs" % elapsed)
+
+# ---------------- B: write semantics ----------------
+payload = b"collector-payload" * 10
+with open(sink, "r+b") as fh:
+    fh.seek(40960)
+    fh.write(payload)
+with open(sink, "rb") as fh:
+    fh.seek(40960)
+    check("B1 data reads back", fh.read(len(payload)) == payload)
+    fh.seek(4096)
+    check("B2 hole reads as zeros", fh.read(64) == b"\x00" * 64)
+used_b = disk_usage(sink)
+check("B3 usage stayed small after one write", used_b <= 8 << 20, "%d" % used_b)
+rg = allocated_ranges(sink)
+check("B4 exactly one allocated range", len(rg) == 1, repr(rg))
+check("B4 range covers the written cluster", rg and rg[0][0] <= 40960 < rg[0][0] + rg[0][1])
+check("B4 range is cluster sized", rg and rg[0][1] == 4096, repr(rg))
+check("B4 range inside file", rg and rg[0][0] + rg[0][1] <= 1 << 30)
+
+# ---------------- C: occupancy ----------------
+sparse_path = os.path.join(TMP, "c-sparse.bin")
+preallocate(sparse_path, 64 << 20)
+with open(sparse_path, "r+b") as fh:
+    fh.seek(1 << 20)
+    fh.write(b"one")
+    fh.seek(40 << 20)
+    fh.write(b"two")
+check("C1 sparse 64MiB logical size", os.path.getsize(sparse_path) == 64 << 20)
+u_sparse = disk_usage(sparse_path)
+check("C1 sparse usage < 1MiB", u_sparse < 1 << 20, "%d bytes" % u_sparse)
+check("C1 sparse usage >= 2 clusters", u_sparse >= 2 * 4096, "%d" % u_sparse)
+check("C1 usage is cluster aligned", u_sparse % 4096 == 0, "%d" % u_sparse)
+check("C1 usage < logical size", u_sparse < 64 << 20)
+
+dense_path = os.path.join(TMP, "c-dense.bin")
+with open(dense_path, "wb") as fh:
+    fh.write(b"d" * (64 << 20))
+u_dense = disk_usage(dense_path)
+check("C2 dense usage ~= logical size", 64 << 20 <= u_dense <= (64 << 20) + 4096, "%d" % u_dense)
+check("C3 empty file usage 0", disk_usage(os.path.join(TMP, "empty0.bin")) if False else True)
+empty = os.path.join(TMP, "empty.bin")
+open(empty, "wb").close()
+check("C3 empty file usage is 0", disk_usage(empty) == 0, "%d" % disk_usage(empty))
+check("C3 empty ranges are []", allocated_ranges(empty) == [])
+small = os.path.join(TMP, "small.bin")
+with open(small, "wb") as fh:
+    fh.write(b"z" * 100)
+check("C4 100-byte file usage == 1 cluster", disk_usage(small) == 4096, "%d" % disk_usage(small))
+asset = "assets/dense_64k.bin"
+check("C5 asset dense_64k usage", disk_usage(asset) == 65536, "%d" % disk_usage(asset))
+check("C5 asset is not sparse", sparse_state(asset) is False)
+check("C5 asset ranges cover all", allocated_ranges(asset) == [(0, 65536)], repr(allocated_ranges(asset)))
+
+# ---------------- D: ranges ----------------
+rg = allocated_ranges(sparse_path)
+check("D1 sparse ranges count == 2", len(rg) == 2, repr(rg))
+check("D1 sorted & disjoint", all(rg[i][0] + rg[i][1] <= rg[i + 1][0] for i in range(len(rg) - 1)))
+check("D1 all positive lengths", all(l > 0 for _, l in rg))
+check("D1 inside file", all(o + l <= 64 << 20 for o, l in rg))
+hole_only = os.path.join(TMP, "d-hole.bin")
+preallocate(hole_only, 4 << 20)
+check("D2 all-hole file returns []", allocated_ranges(hole_only) == [])
+dense_small = os.path.join(TMP, "d-dense.bin")
+with open(dense_small, "wb") as fh:
+    fh.write(b"y" * 8192)
+check("D3 dense file one full range", allocated_ranges(dense_small) == [(0, 8192)],
+      repr(allocated_ranges(dense_small)))
+check("D3 dense non-sparse state", sparse_state(dense_small) is False)
+check("D3 ranges are tuples of int", all(isinstance(r, tuple) and all(isinstance(v, int) for v in r)
+                                         for r in allocated_ranges(sparse_path)))
+# many scattered extents
+many = os.path.join(TMP, "d-many.bin")
+preallocate(many, 64 << 20)
+with open(many, "r+b") as fh:
+    for i in range(200):
+        fh.seek(i * (256 << 10) + 4096)
+        fh.write(b"s")
+rg_many = allocated_ranges(many)
+check("D4 many extents reported (>100)", len(rg_many) > 100, "%d ranges" % len(rg_many))
+check("D4 sorted/disjoint", all(rg_many[i][0] + rg_many[i][1] <= rg_many[i + 1][0]
+                                for i in range(len(rg_many) - 1)))
+total = sum(l for _, l in rg_many)
+check("D4 usage matches sum of ranges", disk_usage(many) == ((total + 4095) // 4096) * 4096,
+      "%d vs %d" % (disk_usage(many), total))
+
+# ---------------- E: sparse flag not retroactive ----------------
+dense_e = os.path.join(TMP, "e.bin")
+with open(dense_e, "wb") as fh:
+    fh.write(b"e" * (8 << 20))
+before = disk_usage(dense_e)
+res = sparse_flag(dense_e, True)
+after = disk_usage(dense_e)
+check("E1 sparse_flag returns state", res is True, repr(res))
+check("E1 attribute really set", sparse_state(dense_e) is True)
+check("E2 usage unchanged after setting sparse", after == before, "%d -> %d" % (before, after))
+check("E2 still dense-sized", after >= 8 << 20, "%d" % after)
+check("E3 ranges still cover whole file",
+      allocated_ranges(dense_e) == [(0, 8 << 20)], repr(allocated_ranges(dense_e)))
+check("E4 clearing sparse works", sparse_flag(dense_e, False) is False)
+check("E4 attribute cleared", sparse_state(dense_e) is False)
+check("E5 dense preallocate keeps usage sane",
+      disk_usage(dense_e) >= 8 << 20, "%d" % disk_usage(dense_e))
+pre = os.path.join(TMP, "e2.bin")
+with open(pre, "wb") as fh:
+    fh.write(b"q" * 4096)
+check("E6 preallocate extends a dense file", preallocate(pre, 64 << 20) == 64 << 20)
+u = disk_usage(pre)
+check("E6 only the dense head occupies", u <= 8 << 20, "%d" % u)
+check("E6 sparse now set", sparse_state(pre) is True)
+
+# ---------------- F: unsupported ----------------
+adir = os.path.join(TMP, "dir")
+os.mkdir(adir)
+check("F1 disk_usage(dir) unsupported", kind_of(disk_usage, adir) == "unsupported",
+      kind_of(disk_usage, adir))
+check("F1 allocated_ranges(dir) unsupported", kind_of(allocated_ranges, adir) == "unsupported",
+      kind_of(allocated_ranges, adir))
+check("F1 sparse_flag(dir) unsupported", kind_of(sparse_flag, adir, True) == "unsupported",
+      kind_of(sparse_flag, adir, True))
+check("F1 sparse_state(dir) unsupported", kind_of(sparse_state, adir) == "unsupported",
+      kind_of(sparse_state, adir))
+check("F1 preallocate(dir) unsupported", kind_of(preallocate, adir, 4096) == "unsupported",
+      kind_of(preallocate, adir, 4096))
+nested = os.path.join(adir, "inner")
+os.mkdir(nested)
+check("F1 nested dir unsupported", kind_of(disk_usage, nested) == "unsupported")
+check("F2 missing file -> os", kind_of(disk_usage, os.path.join(TMP, "nope.bin")) == "os",
+      kind_of(disk_usage, os.path.join(TMP, "nope.bin")))
+check("F2 missing ranges -> os", kind_of(allocated_ranges, os.path.join(TMP, "nope.bin")) == "os")
+check("F2 missing sparse_flag -> os", kind_of(sparse_flag, os.path.join(TMP, "nope.bin"), True) == "os")
+check("F2 missing sparse_state -> os", kind_of(sparse_state, os.path.join(TMP, "nope.bin")) == "os")
+check("F3 bad size -> badarg", kind_of(preallocate, os.path.join(TMP, "x.bin"), -1) == "badarg")
+check("F3 float size -> badarg", kind_of(preallocate, os.path.join(TMP, "x.bin"), 1.5) == "badarg")
+check("F3 None size -> badarg", kind_of(preallocate, os.path.join(TMP, "x.bin"), None) == "badarg")
+check("F3 bad enabled -> badarg", kind_of(sparse_flag, dense_e, "yes") == "badarg")
+check("F4 WSParseError carries kind/path", hasattr(WSParseError("m", kind="os", path="p"), "kind"))
+
+# pathlib support
+import pathlib
+pp = pathlib.Path(TMP) / "pathlike.bin"
+check("G1 pathlib preallocate", preallocate(pp, 1 << 20) == 1 << 20)
+check("G1 pathlib usage", disk_usage(pp) == 0, "%d" % disk_usage(pp))
+check("G1 pathlib ranges", allocated_ranges(pp) == [])
+check("G1 pathlib sparse_state", sparse_state(pp) is True)
+check("G1 pathlib sparse_flag", sparse_flag(pp, False) is False)
+check("G1 bytes path", disk_usage(str(pp).encode()) == 0)
+check("G1 None path -> badarg", kind_of(disk_usage, None) == "badarg")
+check("G1 int path -> badarg", kind_of(disk_usage, 5) == "badarg")
+
+# ---------------- G: preallocated sink then streamed writes ----------------
+stream = os.path.join(TMP, "stream.bin")
+preallocate(stream, 16 << 20)
+with open(stream, "r+b") as fh:
+    for off in (0, 4 << 20, 12 << 20):
+        fh.seek(off)
+        fh.write(b"S" * (64 << 10))
+with open(stream, "rb") as fh:
+    fh.seek(4 << 20)
+    check("G2 streamed data intact", fh.read(16) == b"S" * 16)
+    fh.seek(1 << 20)
+    check("G2 untouched region is zero", fh.read(16) == b"\x00" * 16)
+check("G2 usage ~ 192KiB", 192 << 10 <= disk_usage(stream) <= 256 << 10, "%d" % disk_usage(stream))
+check("G2 three ranges", len(allocated_ranges(stream)) == 3, repr(allocated_ranges(stream)))
+
+print()
+shutil.rmtree(TMP, ignore_errors=True)
+if failures:
+    print("FAILURES: %d" % len(failures))
+    for f in failures:
+        print("  -", f)
+    raise SystemExit(1)
+print("ALL CHECKS PASSED")
diff --git a/_probe1.py b/_probe1.py
new file mode 100644
index 0000000..1925d91
--- /dev/null
+++ b/_probe1.py
@@ -0,0 +1,124 @@
+import ctypes
+import os
+import tempfile
+from ctypes import wintypes
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+
+print("0x940CE =", hex((9 << 16) | (1 << 14) | (51 << 2) | 2))
+print("0x940CF =", hex((9 << 16) | (1 << 14) | (51 << 2) | 3))
+
+tmp = tempfile.mkdtemp()
+p = os.path.join(tmp, "s.bin")
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+SHARE = 1 | 2 | 4
+CreateFileW = k.CreateFileW
+CreateFileW.restype = wintypes.HANDLE
+CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                        ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+DeviceIoControl = k.DeviceIoControl
+DeviceIoControl.restype = wintypes.BOOL
+DeviceIoControl.argtypes = [wintypes.HANDLE, wintypes.DWORD, ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.SetFilePointerEx.argtypes = [wintypes.HANDLE, wintypes.LARGE_INTEGER,
+                               ctypes.POINTER(wintypes.LARGE_INTEGER), wintypes.DWORD]
+k.WriteFile.argtypes = [wintypes.HANDLE, ctypes.c_char_p, wintypes.DWORD,
+                        ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.GetFileInformationByHandleEx.argtypes = [wintypes.HANDLE, ctypes.c_int,
+                                           ctypes.c_void_p, wintypes.DWORD,
+                                           ctypes.POINTER(wintypes.DWORD)]
+
+h = CreateFileW(p, GENERIC_READ | GENERIC_WRITE, SHARE, None, 4, 0, None)
+print("handle", h, ctypes.get_last_error())
+one = wintypes.DWORD(1)
+ret = wintypes.DWORD(0)
+ok = DeviceIoControl(h, 0x000900C4, ctypes.byref(one), 4, None, 0, ctypes.byref(ret), None)
+print("set sparse", ok, ctypes.get_last_error())
+print("seek", k.SetFilePointerEx(h, 64 * 1024 * 1024, None, 0), ctypes.get_last_error())
+print("eof", k.SetEndOfFile(h), ctypes.get_last_error())
+
+
+class ARB(ctypes.Structure):
+    _fields_ = [("off", wintypes.LARGE_INTEGER), ("len", wintypes.LARGE_INTEGER)]
+
+
+def query(code):
+    out = (ARB * 8)()
+    inp = ARB()
+    inp.off = 0
+    inp.len = 0
+    ret = wintypes.DWORD(0)
+    ok = DeviceIoControl(h, code, ctypes.byref(inp), ctypes.sizeof(inp),
+                         out, ctypes.sizeof(out), ctypes.byref(ret), None)
+    err = ctypes.get_last_error()
+    n = ret.value // ctypes.sizeof(ARB)
+    return ok, err, [(out[i].off, out[i].len) for i in range(n)]
+
+
+print("empty 0x940CE:", query(0x940CE))
+print("empty 0x940CF:", query(0x940CF))
+
+buf = b"A" * 100
+written = wintypes.DWORD(0)
+k.SetFilePointerEx(h, 4096 * 10, None, 0)
+print(k.WriteFile(h, buf, len(buf), ctypes.byref(written), None), written.value)
+k.SetFilePointerEx(h, 4096 * 5000, None, 0)
+print(k.WriteFile(h, buf, len(buf), ctypes.byref(written), None), written.value)
+k.FlushFileBuffers(h)
+print("written 0x940CE:", query(0x940CE))
+
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [("alloc", wintypes.LARGE_INTEGER), ("eof", wintypes.LARGE_INTEGER),
+                ("links", wintypes.DWORD), ("dele", wintypes.BOOLEAN), ("dir", wintypes.BOOLEAN)]
+
+
+fsi = FILE_STANDARD_INFO()
+rlen = wintypes.DWORD(0)
+ok = k.GetFileInformationByHandleEx(h, 1, ctypes.byref(fsi), ctypes.sizeof(fsi),
+                                    ctypes.byref(rlen))
+print("std info", ok, ctypes.get_last_error(), "alloc=", fsi.alloc, "eof=", fsi.eof)
+k.CloseHandle(h)
+print("st_size", os.path.getsize(p), "attrs", hex(os.stat(p).st_file_attributes))
+
+with open(p, "rb") as f:
+    f.seek(4096 * 3)
+    data = f.read(16)
+print("hole read", data)
+
+# dense comparison file
+p2 = os.path.join(tmp, "d.bin")
+with open(p2, "wb") as f:
+    f.write(b"D" * (64 * 1024 * 1024))
+print("dense attrs", hex(os.stat(p2).st_file_attributes))
+h2 = CreateFileW(p2, 0, SHARE, None, 3, 0, None)
+print("dense handle", h2, ctypes.get_last_error())
+out = (ARB * 8)()
+inp = ARB()
+inp.off = 0
+inp.len = 0
+ret = wintypes.DWORD(0)
+ok = DeviceIoControl(h2, 0x940CF, ctypes.byref(inp), 16, out, ctypes.sizeof(out),
+                     ctypes.byref(ret), None)
+print("dense query ok", ok, ctypes.get_last_error(), ret.value // 16,
+      [(out[i].off, out[i].len) for i in range(ret.value // 16)])
+fsi2 = FILE_STANDARD_INFO()
+ok = k.GetFileInformationByHandleEx(h2, 1, ctypes.byref(fsi2), ctypes.sizeof(fsi2),
+                                    ctypes.byref(rlen))
+print("dense std alloc", fsi2.alloc, fsi2.eof)
+k.CloseHandle(h2)
+
+# sparse query on dense file with proper handle (read access)
+print("dir test:")
+d = tempfile.mkdtemp()
+h3 = CreateFileW(d, 0, SHARE, None, 3, 0, None)
+print("dir handle", h3, ctypes.get_last_error())
+ok = DeviceIoControl(h3, 0x940CF, ctypes.byref(inp), 16, out, ctypes.sizeof(out),
+                     ctypes.byref(ret), None)
+print("dir query", ok, ctypes.get_last_error())
+ok = DeviceIoControl(h3, 0x000900C4, ctypes.byref(one), 4, None, 0, ctypes.byref(ret), None)
+print("dir set sparse", ok, ctypes.get_last_error())
+k.CloseHandle(h3)
diff --git a/_probe2.py b/_probe2.py
new file mode 100644
index 0000000..a46a755
--- /dev/null
+++ b/_probe2.py
@@ -0,0 +1,167 @@
+import ctypes
+import os
+import tempfile
+from ctypes import wintypes
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+SHARE = 1 | 2 | 4
+OPEN_EXISTING = 3
+CREATE_ALWAYS = 4
+INVALID_HANDLE = wintypes.HANDLE(-1).value
+
+CreateFileW = k.CreateFileW
+CreateFileW.restype = wintypes.HANDLE
+CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                        ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+DeviceIoControl = k.DeviceIoControl
+DeviceIoControl.restype = wintypes.BOOL
+DeviceIoControl.argtypes = [wintypes.HANDLE, wintypes.DWORD, ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.SetFilePointerEx.argtypes = [wintypes.HANDLE, wintypes.LARGE_INTEGER,
+                               ctypes.POINTER(wintypes.LARGE_INTEGER), wintypes.DWORD]
+k.WriteFile.argtypes = [wintypes.HANDLE, ctypes.c_char_p, wintypes.DWORD,
+                        ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.GetFileInformationByHandleEx.argtypes = [wintypes.HANDLE, ctypes.c_int,
+                                           ctypes.c_void_p, wintypes.DWORD,
+                                           ctypes.POINTER(wintypes.DWORD)]
+k.GetCompressedFileSizeW.restype = wintypes.DWORD
+k.GetCompressedFileSizeW.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(wintypes.DWORD)]
+
+
+class ARB(ctypes.Structure):
+    _fields_ = [("off", wintypes.LARGE_INTEGER), ("len", wintypes.LARGE_INTEGER)]
+
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [("alloc", wintypes.LARGE_INTEGER), ("eof", wintypes.LARGE_INTEGER),
+                ("links", wintypes.DWORD), ("dele", wintypes.BOOLEAN), ("dir", wintypes.BOOLEAN)]
+
+
+def stdinfo(h):
+    fsi = FILE_STANDARD_INFO()
+    rlen = wintypes.DWORD(0)
+    ok = k.GetFileInformationByHandleEx(h, 1, ctypes.byref(fsi), ctypes.sizeof(fsi),
+                                        ctypes.byref(rlen))
+    if not ok:
+        return (0, ctypes.get_last_error())
+    return (fsi.alloc, fsi.eof)
+
+
+def compressed_size(path):
+    high = wintypes.DWORD(0)
+    low = k.GetCompressedFileSizeW(path, ctypes.byref(high))
+    err = ctypes.get_last_error()
+    return ((high.value << 32) | low, err)
+
+
+def query_ranges(h, start, length, cap=64):
+    results = []
+    off = start
+    remaining = length
+    while remaining > 0:
+        out = (ARB * cap)()
+        inp = ARB()
+        inp.off = off
+        inp.len = remaining
+        ret = wintypes.DWORD(0)
+        ok = DeviceIoControl(h, 0x940CF, ctypes.byref(inp), ctypes.sizeof(inp),
+                             out, ctypes.sizeof(out), ctypes.byref(ret), None)
+        err = ctypes.get_last_error()
+        n = ret.value // ctypes.sizeof(ARB)
+        for i in range(n):
+            results.append((out[i].off, out[i].len))
+        if not ok:
+            if err == 234:  # ERROR_MORE_DATA
+                if n == 0:
+                    break
+                off = results[-1][0] + results[-1][1]
+                remaining = length - (off - start)
+                continue
+            return (0, err, results)
+        if n == 0:
+            break
+        off = results[-1][0] + results[-1][1]
+        remaining = length - (off - start)
+        if remaining <= 0:
+            break
+    return (1, 0, results)
+
+
+tmp = tempfile.mkdtemp()
+
+# ---------- sparse file with two writes ----------
+p = os.path.join(tmp, "s.bin")
+h = CreateFileW(p, GENERIC_READ | GENERIC_WRITE, SHARE, None, CREATE_ALWAYS, 0, None)
+ret = wintypes.DWORD(0)
+one = wintypes.DWORD(1)
+print("set sparse:", DeviceIoControl(h, 0x900C4, ctypes.byref(one), 4, None, 0,
+                                     ctypes.byref(ret), None), ctypes.get_last_error())
+k.SetFilePointerEx(h, 64 << 20, None, 0)
+print("set eof:", k.SetEndOfFile(h), ctypes.get_last_error())
+buf = b"A" * 100
+written = wintypes.DWORD(0)
+for offset in (40960, 20480000):
+    k.SetFilePointerEx(h, offset, None, 0)
+    k.WriteFile(h, buf, len(buf), ctypes.byref(written), None)
+k.FlushFileBuffers(h)
+print("sparse stdinfo:", stdinfo(h))
+print("sparse ranges (len=0):", query_ranges(h, 0, 0))
+print("sparse ranges (len=size):", query_ranges(h, 0, 64 << 20))
+k.CloseHandle(h)
+print("sparse compressed size:", compressed_size(p))
+print("sparse attrs:", hex(os.stat(p).st_file_attributes))
+
+# ---------- dense file ----------
+p2 = os.path.join(tmp, "d.bin")
+h2 = CreateFileW(p2, GENERIC_READ | GENERIC_WRITE, SHARE, None, CREATE_ALWAYS, 0, None)
+k.SetFilePointerEx(h2, 4 << 20, None, 0)
+k.SetEndOfFile(h2)
+k.SetFilePointerEx(h2, 0, None, 0)
+block = b"B" * (1 << 20)
+for _ in range(4):
+    k.WriteFile(h2, block, len(block), ctypes.byref(written), None)
+k.FlushFileBuffers(h2)
+print("dense stdinfo:", stdinfo(h2))
+print("dense ranges:", query_ranges(h2, 0, 4 << 20))
+# now set sparse on the dense file (criterion E)
+print("set sparse on dense:", DeviceIoControl(h2, 0x900C4, ctypes.byref(one), 4, None, 0,
+                                             ctypes.byref(ret), None), ctypes.get_last_error())
+print("dense-after-sparse stdinfo:", stdinfo(h2))
+print("dense-after-sparse ranges:", query_ranges(h2, 0, 4 << 20))
+k.CloseHandle(h2)
+print("dense attrs after:", hex(os.stat(p2).st_file_attributes))
+print("dense compressed size after:", compressed_size(p2))
+
+# ---------- directory ----------
+d = tempfile.mkdtemp()
+print("isdir:", os.path.isdir(d))
+h3 = CreateFileW(d, GENERIC_READ, SHARE, None, OPEN_EXISTING, 0, None)
+print("dir open GENERIC_READ handle valid:", h3 != INVALID_HANDLE, ctypes.get_last_error())
+print("dir set sparse:", DeviceIoControl(h3, 0x900C4, ctypes.byref(one), 4, None, 0,
+                                         ctypes.byref(ret), None), ctypes.get_last_error())
+print("dir ranges:", query_ranges(h3, 0, 1 << 20))
+print("dir stdinfo:", stdinfo(h3))
+k.CloseHandle(h3)
+print("dir compressed size:", compressed_size(d))
+h4 = CreateFileW(d, GENERIC_READ | GENERIC_WRITE, SHARE, None, OPEN_EXISTING, 0, None)
+print("dir open RW valid:", h4 != INVALID_HANDLE, ctypes.get_last_error())
+
+# ---------- missing file ----------
+print("missing compressed size:", compressed_size(os.path.join(tmp, "nope.bin")))
+print("missing open:", CreateFileW(os.path.join(tmp, "nope.bin"), GENERIC_READ, SHARE, None,
+                                   OPEN_EXISTING, 0, None) != INVALID_HANDLE,
+      ctypes.get_last_error())
+
+# ---------- volume info ----------
+k.GetDiskFreeSpaceW.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(wintypes.DWORD),
+                                ctypes.POINTER(wintypes.DWORD), ctypes.POINTER(wintypes.DWORD),
+                                ctypes.POINTER(wintypes.DWORD)]
+spc = wintypes.DWORD(); bps = wintypes.DWORD(); freec = wintypes.DWORD(); totc = wintypes.DWORD()
+root = os.path.splitdrive(os.path.abspath(tmp))[0] + "\\"
+print("root", root, k.GetDiskFreeSpaceW(root, ctypes.byref(spc), ctypes.byref(bps),
+                                        ctypes.byref(freec), ctypes.byref(totc)),
+      "cluster bytes:", spc.value * bps.value)
