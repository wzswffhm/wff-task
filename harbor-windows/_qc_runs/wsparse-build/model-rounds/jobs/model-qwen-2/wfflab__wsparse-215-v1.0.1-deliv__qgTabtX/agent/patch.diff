+import ctypes
+import os
+import tempfile
+from ctypes import wintypes
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+SHARE = 1 | 2 | 4
+OPEN_EXISTING = 3
+CREATE_ALWAYS = 4
+BACKUP_SEMANTICS = 0x02000000
+INVALID_HANDLE = wintypes.HANDLE(-1).value
+
+CreateFileW = k.CreateFileW
+CreateFileW.restype = wintypes.HANDLE
+CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                        ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+DeviceIoControl = k.DeviceIoControl
+DeviceIoControl.restype = wintypes.BOOL
+DeviceIoControl.argtypes = [wintypes.HANDLE, wintypes.DWORD, ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.c_void_p, wintypes.DWORD,
+                            ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+k.GetFileInformationByHandleEx.argtypes = [wintypes.HANDLE, ctypes.c_int,
+                                           ctypes.c_void_p, wintypes.DWORD,
+                                           ctypes.POINTER(wintypes.DWORD)]
+k.GetVolumeInformationW.argtypes = [wintypes.LPCWSTR, ctypes.c_void_p, wintypes.DWORD,
+                                    ctypes.c_void_p, ctypes.POINTER(wintypes.DWORD),
+                                    ctypes.POINTER(wintypes.DWORD), wintypes.LPWSTR,
+                                    wintypes.DWORD]
+
+
+class ARB(ctypes.Structure):
+    _fields_ = [("off", wintypes.LARGE_INTEGER), ("len", wintypes.LARGE_INTEGER)]
+
+
+class FILE_STANDARD_INFO(ctypes.Structure):
+    _fields_ = [("alloc", wintypes.LARGE_INTEGER), ("eof", wintypes.LARGE_INTEGER),
+                ("links", wintypes.DWORD), ("dele", wintypes.BOOLEAN), ("dir", wintypes.BOOLEAN)]
+
+
+def stdinfo(h):
+    fsi = FILE_STANDARD_INFO()
+    rlen = wintypes.DWORD(0)
+    ok = k.GetFileInformationByHandleEx(h, 1, ctypes.byref(fsi), ctypes.sizeof(fsi),
+                                        ctypes.byref(rlen))
+    if not ok:
+        return (0, ctypes.get_last_error())
+    return (fsi.alloc, fsi.eof, fsi.dir)
+
+
+def query(h, start, length, cap=4):
+    out = (ARB * cap)()
+    inp = ARB()
+    inp.off = start
+    inp.len = length
+    ret = wintypes.DWORD(0)
+    ok = DeviceIoControl(h, 0x940CF, ctypes.byref(inp), 16, out, ctypes.sizeof(out),
+                         ctypes.byref(ret), None)
+    err = ctypes.get_last_error()
+    n = ret.value // 16
+    return ok, err, ret.value, [(out[i].off, out[i].len) for i in range(n)]
+
+
+tmp = tempfile.mkdtemp()
+d = os.path.join(tmp, "sub")
+os.mkdir(d)
+h = CreateFileW(d, GENERIC_READ, SHARE, None, OPEN_EXISTING, BACKUP_SEMANTICS, None)
+print("dir handle valid:", h != INVALID_HANDLE, ctypes.get_last_error())
+print("dir stdinfo:", stdinfo(h))
+print("dir ranges:", query(h, 0, 1 << 20))
+ret = wintypes.DWORD(0)
+one = wintypes.DWORD(1)
+print("dir set sparse:", DeviceIoControl(h, 0x900C4, ctypes.byref(one), 4, None, 0,
+                                         ctypes.byref(ret), None), ctypes.get_last_error())
+print("dir zero sparse:", DeviceIoControl(h, 0x980C8, ctypes.byref(ARB(0, 1 << 20)), 16,
+                                          None, 0, ctypes.byref(ret), None),
+      ctypes.get_last_error())
+k.CloseHandle(h)
+
+# volume info: FILE_SUPPORTS_SPARSE_FILES = 0x00000040
+root = os.path.splitdrive(os.path.abspath(tmp))[0] + "\\"
+flags = wintypes.DWORD(0)
+name = ctypes.create_unicode_buffer(32)
+maxcomp = wintypes.DWORD(0)
+fsflags = wintypes.DWORD(0)
+ok = k.GetVolumeInformationW(root, None, 0, None, ctypes.byref(maxcomp),
+                             ctypes.byref(fsflags), name, 32)
+print("volume", ok, name.value, "fsflags", hex(fsflags.value),
+      "sparse supported:", bool(fsflags.value & 0x40))
+
+# ERROR_MORE_DATA behaviour with tiny output buffer
+p = os.path.join(tmp, "s.bin")
+h2 = CreateFileW(p, GENERIC_READ | GENERIC_WRITE, SHARE, None, CREATE_ALWAYS, 0, None)
+ret = wintypes.DWORD(0)
+DeviceIoControl(h2, 0x900C4, ctypes.byref(one), 4, None, 0, ctypes.byref(ret), None)
+k.SetFilePointerEx.argtypes = [wintypes.HANDLE, wintypes.LARGE_INTEGER,
+                               ctypes.POINTER(wintypes.LARGE_INTEGER), wintypes.DWORD]
+k.SetFilePointerEx(h2, 1 << 20, None, 0)
+k.SetEndOfFile(h2)
+k.WriteFile.argtypes = [wintypes.HANDLE, ctypes.c_char_p, wintypes.DWORD,
+                        ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
+w = wintypes.DWORD(0)
+for i in range(0, 20):
+    k.SetFilePointerEx(h2, i * 65536, None, 0)
+    k.WriteFile(h2, b"X", 1, ctypes.byref(w), None)
+k.FlushFileBuffers(h2)
+print("many small buffers:", query(h2, 0, 1 << 20, cap=4))
+print("stdinfo:", stdinfo(h2))
+k.CloseHandle(h2)
+
+# python open() on a directory
+try:
+    with open(d, "rb") as f:
+        pass
+except OSError as e:
+    print("open(dir) ->", type(e).__name__, e.errno, e.winerror)
+try:
+    with open(d, "r+b") as f:
+        pass
+except OSError as e:
+    print("open(dir,'r+b') ->", type(e).__name__, e.errno, e.winerror)
+
+# os.open flags available?
+print(hasattr(os, "O_BINARY"))
