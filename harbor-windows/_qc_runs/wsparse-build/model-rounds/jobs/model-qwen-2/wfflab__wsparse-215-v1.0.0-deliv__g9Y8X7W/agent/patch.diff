diff --git a/tmp/chk6.py b/tmp/chk6.py
new file mode 100644
index 0000000..c195a1c
--- /dev/null
+++ b/tmp/chk6.py
@@ -0,0 +1,17 @@
+import os,tempfile
+from wsparse import disk_usage,sparse_flag,sparse_state,WSParseError
+td=tempfile.mkdtemp()
+# Create a dense file first
+s=os.path.join(td,"dense_then_sparse.bin")
+f=open(s,"wb")
+f.write(b"D"*65536)
+f.close()
+u1=disk_usage(s)
+print("before sparse_flag usage",u1)
+result=sparse_flag(s,True)
+print("sparse_flag returned",result)
+u2=disk_usage(s)
+print("after sparse_flag usage",u2)
+# The disk usage should still reflect the dense allocation
+assert u2>=65536,f"usage dropped to {u2}, should stay >=65536"
+print("E OK")
