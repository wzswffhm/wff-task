diff --git a/wsparse/_common.py b/wsparse/_common.py
new file mode 100644
index 0000000..4cd148b
--- /dev/null
+++ b/wsparse/_common.py
@@ -0,0 +1,135 @@
+"""Argument and target validation shared by the public entry points.
+
+Everything here is platform neutral.  The checks exist so that the failure
+taxonomy is decided *before* a platform call gets a chance to report something
+vague: a directory (or any other object that cannot carry the sparse
+attribute) must come back as ``kind="unsupported"`` rather than as a bare
+``OSError`` or a silent success.
+"""
+
+import os
+import stat
+
+from .errors import WSParseError
+
+
+def check_size(size):
+    """Validate the ``size`` argument of :func:`wsparse.preallocate`."""
+    if isinstance(size, bool) or not isinstance(size, int):
+        raise WSParseError("size must be an integer, got %r" % (size,), kind="badarg")
+    if size < 0:
+        raise WSParseError("size must not be negative, got %r" % (size,), kind="badarg")
+    return size
+
+
+def normalise(path):
+    """Coerce ``path`` to ``str``/``bytes`` and reject empty input."""
+    try:
+        path = os.fspath(path)
+    except TypeError as exc:
+        raise WSParseError(
+            "path must be a path-like object, got %r" % (path,), kind="badarg"
+        ) from exc
+    if not path:
+        raise WSParseError("path must not be empty", kind="badarg")
+    return path
+
+
+def _lstat(path):
+    try:
+        return os.stat(path, follow_symlinks=True)
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+
+
+def reject_non_file(path, info):
+    """Raise ``unsupported`` when ``info`` does not describe a regular file.
+
+    Directories, devices, pipes and sockets cannot carry allocated ranges or
+    the sparse attribute, so every sparse entry point has to refuse them with
+    the classifier that tells the caller not to retry.
+    """
+    mode = info.st_mode
+    if stat.S_ISDIR(mode):
+        raise WSParseError(
+            "sparse-file operations are not supported on a directory",
+            kind="unsupported",
+            path=path,
+        )
+    if not stat.S_ISREG(mode):
+        raise WSParseError(
+            "sparse-file operations are not supported on this object",
+            kind="unsupported",
+            path=path,
+        )
+
+
+def require_file(path):
+    """Resolve ``path``, requiring that it already is a regular file.
+
+    Missing paths yield ``kind="os"``; objects that exist but can never be
+    sparse yield ``kind="unsupported"``.
+    """
+    path = normalise(path)
+    info = _lstat(path)
+    reject_non_file(path, info)
+    return path, info
+
+
+def require_creatable(path):
+    """Resolve ``path`` for :func:`wsparse.preallocate`.
+
+    The sink may legitimately not exist yet, but anything that exists and is
+    not a regular file is rejected as unsupported.
+    """
+    path = normalise(path)
+    try:
+        info = os.stat(path, follow_symlinks=True)
+    except FileNotFoundError:
+        return path, None
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+    reject_non_file(path, info)
+    return path, info
+
+
+def round_up(value, unit):
+    """Round ``value`` up to a whole multiple of ``unit``."""
+    if unit <= 0:
+        return value
+    remainder = value % unit
+    if remainder == 0:
+        return value
+    return value + (unit - remainder)
+
+
+def normalise_ranges(ranges, size):
+    """Sort, clip and merge ``ranges`` so the public contract always holds.
+
+    The result is ordered by offset, free of overlaps and empty entries, and
+    contained inside ``size``.
+    """
+    cleaned = []
+    for offset, length in ranges:
+        offset = int(offset)
+        length = int(length)
+        if offset < 0:
+            length += offset
+            offset = 0
+        if length <= 0 or offset >= size:
+            continue
+        if offset + length > size:
+            length = size - offset
+        if length > 0:
+            cleaned.append((offset, length))
+    cleaned.sort(key=lambda item: item[0])
+
+    merged = []
+    for offset, length in cleaned:
+        if merged and offset <= merged[-1][0] + merged[-1][1]:
+            previous_offset, previous_length = merged[-1]
+            end = max(previous_offset + previous_length, offset + length)
+            merged[-1] = (previous_offset, end - previous_offset)
+        else:
+            merged.append((offset, length))
+    return merged
diff --git a/wsparse/_posix.py b/wsparse/_posix.py
new file mode 100644
index 0000000..cb01c2b
--- /dev/null
+++ b/wsparse/_posix.py
@@ -0,0 +1,123 @@
+"""Fallback implementations for non-Windows kernels.
+
+The target platform of :mod:`wsparse` is Windows on NTFS and the acceptance
+criteria are stated in terms of NTFS cluster allocation; this module exists so
+that the package stays importable and self-consistent when the collector's
+test suite is exercised on a POSIX development box.  It is *not* a substitute
+for the Win32 path in :mod:`wsparse._winapi`.
+"""
+
+import os
+
+from ._common import normalise_ranges, round_up
+from .errors import WSParseError
+
+#: ``st_blocks`` is always counted in 512-byte units, independent of the
+#: file system's own block size.
+_STAT_BLOCK = 512
+
+DEFAULT_CLUSTER = 4096
+
+
+def _stat(path):
+    try:
+        return os.stat(path)
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+
+
+def cluster_size(path):
+    try:
+        return os.statvfs(path).f_frsize or DEFAULT_CLUSTER
+    except (OSError, AttributeError):
+        return DEFAULT_CLUSTER
+
+
+def preallocate(path, size):
+    """Extend ``path`` to ``size`` without materialising the tail.
+
+    ``ftruncate`` leaves a hole on every file system that supports sparse
+    files, which is the closest POSIX analogue of marking a file sparse and
+    moving its end-of-file marker.
+    """
+    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_BINARY", 0)
+    try:
+        fd = os.open(path, flags, 0o666)
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+    try:
+        current = os.fstat(fd).st_size
+        if size > current:
+            os.ftruncate(fd, size)
+        return max(current, size)
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+    finally:
+        os.close(fd)
+
+
+def disk_usage(path):
+    info = _stat(path)
+    blocks = getattr(info, "st_blocks", None)
+    if blocks is None:
+        return round_up(info.st_size, cluster_size(path))
+    return blocks * _STAT_BLOCK
+
+
+def allocated_ranges(path):
+    info = _stat(path)
+    size = info.st_size
+    if size == 0:
+        return []
+
+    seek_data = getattr(os, "SEEK_DATA", None)
+    seek_hole = getattr(os, "SEEK_HOLE", None)
+    if seek_data is None or seek_hole is None:
+        return [(0, size)]
+
+    try:
+        fd = os.open(path, os.O_RDONLY)
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+    ranges = []
+    try:
+        cursor = 0
+        while cursor < size:
+            try:
+                start = os.lseek(fd, cursor, seek_data)
+            except OSError:
+                break  # no data left: the rest of the file is a hole
+            if start >= size:
+                break
+            try:
+                end = os.lseek(fd, start, seek_hole)
+            except OSError:
+                end = size
+            if end <= start:
+                break
+            ranges.append((start, min(end, size) - start))
+            cursor = end
+    finally:
+        os.close(fd)
+    return normalise_ranges(ranges, size)
+
+
+def sparse_state(path):
+    """Report whether ``path`` currently holds fewer blocks than its length.
+
+    POSIX has no sparse *attribute*; a file is sparse exactly when it has
+    holes, so the state is derived from the allocation instead of a flag.
+    """
+    info = _stat(path)
+    if info.st_size == 0:
+        return False
+    return disk_usage(path) < round_up(info.st_size, cluster_size(path))
+
+
+def set_sparse(path, enabled):
+    raise WSParseError(
+        "the sparse attribute is a Windows file-system concept; "
+        "this volume has no equivalent to toggle",
+        kind="unsupported",
+        path=path,
+    )
