diff --git a/_tmp_acc.py b/_tmp_acc.py
new file mode 100644
index 0000000..253ff53
--- /dev/null
+++ b/_tmp_acc.py
@@ -0,0 +1,306 @@
+"""Acceptance-criteria verification for wsparse. Runs from %TEMP%, not the repo."""
+import os
+import shutil
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, r"C:\testbed")
+
+from wsparse import (  # noqa: E402
+    WSParseError,
+    allocated_ranges,
+    disk_usage,
+    preallocate,
+    sparse_flag,
+    sparse_state,
+)
+
+FAILED = []
+PASSED = []
+
+
+def check(name, cond, extra=""):
+    if cond:
+        PASSED.append(name)
+        print("  PASS %s %s" % (name, extra))
+    else:
+        FAILED.append(name)
+        print("  FAIL %s %s" % (name, extra))
+
+
+tmp = tempfile.mkdtemp(prefix="wsparse-acc-")
+MiB = 1 << 20
+GiB = 1 << 30
+
+print("=== A. sparse pre-allocation ===")
+p = os.path.join(tmp, "a1.bin")
+t0 = time.time()
+length = preallocate(p, GiB)
+elapsed = time.time() - t0
+check("A: returns size", length == GiB, length)
+check("A: file length", os.path.getsize(p) == GiB)
+used = disk_usage(p)
+check("A: disk_usage <= 8MiB", used <= 8 * MiB, used)
+check("A: fast", elapsed < 5.0, "%.3fs" % elapsed)
+check("A: sparse_state", sparse_state(p) is True)
+check("A: allocated_ranges empty", allocated_ranges(p) == [], allocated_ranges(p)[:3])
+# idempotent
+preallocate(p, GiB)
+preallocate(p, GiB)
+check("A: idempotent length", os.path.getsize(p) == GiB)
+check("A: idempotent usage", disk_usage(p) <= 8 * MiB, disk_usage(p))
+check("A: idempotent sparse", sparse_state(p) is True)
+check("A: idempotent ranges", allocated_ranges(p) == [])
+# grow then re-call smaller
+preallocate(p, GiB + 4096)
+check("A: grows", os.path.getsize(p) == GiB + 4096)
+preallocate(p, 16)
+check("A: never shrinks", os.path.getsize(p) == GiB + 4096)
+# existing content preserved
+p0 = os.path.join(tmp, "a0.bin")
+with open(p0, "wb") as f:
+    f.write(b"payload")
+preallocate(p0, MiB)
+with open(p0, "rb") as f:
+    check("A: content preserved", f.read(7) == b"payload")
+
+print("=== B. write semantics after pre-allocation ===")
+pb = os.path.join(tmp, "b.bin")
+preallocate(pb, 64 * MiB)
+base_used = disk_usage(pb)
+blobs = [(1 << 20, b"A" * 4096), (40 << 20, b"B" * 100), (7 * MiB + 13, b"C" * 9000)]
+with open(pb, "r+b") as f:
+    for off, data in blobs:
+        f.seek(off)
+        f.write(data)
+    f.flush()
+    os.fsync(f.fileno())
+with open(pb, "rb") as f:
+    for off, data in blobs:
+        f.seek(off)
+        check("B: readback @%d" % off, f.read(len(data)) == data)
+    f.seek(2 << 20)
+    check("B: hole reads zeroes", f.read(65536) == b"\x00" * 65536)
+used_b = disk_usage(pb)
+check("B: one write does not allocate everything", used_b < MiB, "%d (base %d)" % (used_b, base_used))
+ranges_b = allocated_ranges(pb)
+check("B: ranges reflect only writes", len(ranges_b) >= 3, ranges_b)
+check("B: ranges small", sum(l for _, l in ranges_b) < MiB, sum(l for _, l in ranges_b))
+
+print("=== C. disk_usage ===")
+pc = os.path.join(tmp, "c_sparse.bin")
+preallocate(pc, 64 * MiB)
+with open(pc, "r+b") as f:
+    f.seek(3 << 20)
+    f.write(b"x" * 1024)
+    f.seek(50 << 20)
+    f.write(b"y" * 1024)
+    f.flush()
+    os.fsync(f.fileno())
+check("C: sparse 64MiB usage < 1MiB", disk_usage(pc) < MiB, disk_usage(pc))
+check("C: usage != logical length", disk_usage(pc) != os.path.getsize(pc))
+pd = os.path.join(tmp, "c_dense.bin")
+with open(pd, "wb") as f:
+    f.write(b"d" * (64 * MiB))
+check("C: dense usage ~= logical", abs(disk_usage(pd) - 64 * MiB) <= 64 * 1024, disk_usage(pd))
+check("C: dense usage >= logical", disk_usage(pd) >= 64 * MiB)
+check("C: cluster aligned", disk_usage(pc) % 4096 == 0, disk_usage(pc))
+check("C: int type", isinstance(disk_usage(pc), int))
+pa = os.path.join(r"C:\testbed", "assets", "dense_64k.bin")
+if os.path.exists(pa):
+    check("C: asset dense_64k", disk_usage(pa) >= 65536, "%d / %d" % (disk_usage(pa), os.path.getsize(pa)))
+    check("C: asset ranges", allocated_ranges(pa) == [(0, os.path.getsize(pa))], allocated_ranges(pa))
+    check("C: asset not sparse", sparse_state(pa) is False)
+pe = os.path.join(tmp, "c_empty.bin")
+open(pe, "wb").close()
+check("C: empty file usage 0", disk_usage(pe) == 0, disk_usage(pe))
+check("C: empty ranges []", allocated_ranges(pe) == [])
+
+print("=== D. allocated_ranges ===")
+pr = os.path.join(tmp, "d.bin")
+preallocate(pr, 8 * MiB)
+check("D: all-hole -> []", allocated_ranges(pr) == [])
+pr2 = os.path.join(tmp, "d2.bin")
+with open(pr2, "wb") as f:
+    f.write(b"z" * (8 * MiB))
+check("D: non-sparse -> [(0,size)]", allocated_ranges(pr2) == [(0, 8 * MiB)], allocated_ranges(pr2))
+pr3 = os.path.join(tmp, "d3.bin")
+preallocate(pr3, 64 * MiB)
+with open(pr3, "r+b") as f:
+    for off in (0, 5 << 20, 20 << 20, 63 << 20):
+        f.seek(off)
+        f.write(b"W" * 4096)
+    f.flush()
+    os.fsync(f.fileno())
+ranges = allocated_ranges(pr3)
+size = os.path.getsize(pr3)
+prev = -1
+ok = True
+for off, ln in ranges:
+    if not (off >= 0 and ln > 0 and off + ln <= size and off >= prev):
+        ok = False
+    prev = off + ln
+check("D: ordered, disjoint, inside", ok, ranges)
+check("D: found the four writes", len(ranges) >= 4, ranges)
+# tuples
+check("D: tuples of 2", all(isinstance(r, tuple) and len(r) == 2 for r in ranges))
+
+print("=== E. sparse flag is not retroactive ===")
+pe2 = os.path.join(tmp, "e.bin")
+preallocate(pe2, 16 * MiB)
+with open(pe2, "r+b") as f:
+    f.write(b"f" * (16 * MiB))
+    f.flush()
+    os.fsync(f.fileno())
+dense_used = disk_usage(pe2)
+check("E: dense occupancy", dense_used >= 16 * MiB - 4096, dense_used)
+res = sparse_flag(pe2, True)
+check("E: sparse_flag returns bool", isinstance(res, bool), res)
+check("E: usage unchanged after late sparse flag", disk_usage(pe2) >= 16 * MiB - 4096, disk_usage(pe2))
+check("E: ranges still cover whole file", sum(l for _, l in allocated_ranges(pe2)) >= 16 * MiB - 4096)
+check("E: file length unchanged", os.path.getsize(pe2) == 16 * MiB)
+
+print("=== F. unsupported classification ===")
+for label, fn in (
+    ("preallocate(dir)", lambda p: preallocate(p, MiB)),
+    ("disk_usage(dir)", lambda p: disk_usage(p)),
+    ("allocated_ranges(dir)", lambda p: allocated_ranges(p)),
+    ("sparse_state(dir)", lambda p: sparse_state(p)),
+    ("sparse_flag(dir,True)", lambda p: sparse_flag(p, True)),
+    ("sparse_flag(dir,False)", lambda p: sparse_flag(p, False)),
+):
+    try:
+        rv = fn(tmp)
+        check("F: %s raises" % label, False, "returned %r" % (rv,))
+    except WSParseError as exc:
+        check("F: %s kind" % label, exc.kind == "unsupported", "%r %s" % (exc.kind, exc))
+    except Exception as exc:
+        check("F: %s WSParseError" % label, False, "%s: %s" % (type(exc).__name__, exc))
+
+nested = os.path.join(tmp, "sub")
+os.makedirs(nested)
+try:
+    preallocate(nested, 4096)
+    check("F: nested dir raises", False)
+except WSParseError as exc:
+    check("F: nested dir kind", exc.kind == "unsupported", exc.kind)
+
+print("=== F2. missing path is 'os' ===")
+missing = os.path.join(tmp, "absent.bin")
+for label, fn in (
+    ("disk_usage", lambda: disk_usage(missing)),
+    ("allocated_ranges", lambda: allocated_ranges(missing)),
+    ("sparse_state", lambda: sparse_state(missing)),
+    ("sparse_flag", lambda: sparse_flag(missing, True)),
+    ("preallocate", lambda: preallocate(missing, -1)),
+):
+    try:
+        fn()
+        check("F2: %s missing" % label, False, "no raise")
+    except WSParseError as exc:
+        want = "badarg" if label == "preallocate" else "os"
+        check("F2: %s kind" % label, exc.kind == want, "%r" % exc.kind)
+
+print("=== F3. badarg ===")
+for bad in (-1, 1.5, True, "x", None):
+    try:
+        preallocate(os.path.join(tmp, "bad.bin"), bad)
+        check("F3: badarg %r" % (bad,), False)
+    except WSParseError as exc:
+        check("F3: badarg %r" % (bad,), exc.kind == "badarg", exc.kind)
+# preallocate(0)
+pz = os.path.join(tmp, "zero.bin")
+check("F3: size 0", preallocate(pz, 0) == 0)
+check("F3: size 0 usage", disk_usage(pz) == 0)
+check("F3: size 0 ranges", allocated_ranges(pz) == [])
+check("F3: size 0 sparse", sparse_state(pz) is True)
+
+print("=== G. misc / pathlib / os.PathLike ===")
+import pathlib  # noqa: E402
+
+pp = pathlib.Path(tmp) / "pathlike.bin"
+check("G: pathlib preallocate", preallocate(pp, MiB) == MiB)
+check("G: pathlib usage", disk_usage(pp) < MiB, disk_usage(pp))
+check("G: pathlib ranges", allocated_ranges(pp) == [])
+check("G: pathlib state", sparse_state(pp) is True)
+check("G: pathlib flag", sparse_flag(pp, True) is True)
+
+print("=== H. sparse_flag(False) clears ===")
+ph = os.path.join(tmp, "h.bin")
+preallocate(ph, 4 * MiB)
+check("H: sparse before", sparse_state(ph) is True)
+check("H: clear returns False", sparse_flag(ph, False) is False, sparse_flag(ph, False))
+check("H: cleared", sparse_state(ph) is False)
+check("H: dense now", disk_usage(ph) >= 4 * MiB, disk_usage(ph))
+check("H: ranges full", allocated_ranges(ph) == [(0, 4 * MiB)], allocated_ranges(ph))
+check("H: reads zeroes", open(ph, "rb").read(4096) == b"\x00" * 4096)
+
+print("=== I. many ranges / fragmentation ===")
+pi = os.path.join(tmp, "i.bin")
+BIG = 512 * MiB
+preallocate(pi, BIG)
+for i in range(0, 400, 1):
+    with open(pi, "r+b") as f:
+        f.seek(i * (1 << 20))
+        f.write(b"Q" * 4096)
+rg = allocated_ranges(pi)
+check("I: 400 writes -> >= 400 ranges", len(rg) >= 400, len(rg))
+check("I: all inside", all(o >= 0 and l > 0 and o + l <= BIG for o, l in rg))
+check("I: ordered", all(rg[i][0] <= rg[i + 1][0] for i in range(len(rg) - 1)))
+check("I: disjoint", all(rg[i][0] + rg[i][1] <= rg[i + 1][0] for i in range(len(rg) - 1)))
+check("I: usage small", disk_usage(pi) < 8 * MiB, disk_usage(pi))
+check("I: logical size", os.path.getsize(pi) == BIG)
+
+print("=== J. unaligned writes ===")
+pj = os.path.join(tmp, "j.bin")
+preallocate(pj, 32 * MiB)
+with open(pj, "r+b") as f:
+    f.seek(4095)
+    f.write(b"U" * 3)
+    f.seek(10 * MiB + 1)
+    f.write(b"V" * 1)
+    f.flush()
+with open(pj, "rb") as f:
+    f.seek(4095)
+    check("J: readback unaligned", f.read(3) == b"U" * 3)
+check("J: usage small", disk_usage(pj) < MiB, disk_usage(pj))
+check("J: ranges", len(allocated_ranges(pj)) == 2, allocated_ranges(pj))
+
+print("=== K. concurrent handles ===")
+pk = os.path.join(tmp, "k.bin")
+holder = open(pk, "a+b")  # evaluator-style: keeps its own handle open
+try:
+    check("K: preallocate while held", preallocate(pk, 16 * MiB) == 16 * MiB)
+    check("K: usage while held", disk_usage(pk) < MiB, disk_usage(pk))
+    check("K: ranges while held", allocated_ranges(pk) == [])
+    with open(pk, "r+b") as f:
+        f.seek(1000)
+        f.write(b"Z" * 500)
+        f.flush()
+    check("K: usage after write while held", disk_usage(pk) < MiB, disk_usage(pk))
+    check("K: ranges after write", len(allocated_ranges(pk)) == 1, allocated_ranges(pk))
+finally:
+    holder.close()
+
+print("=== L. re-open with plain python after preallocate ===")
+pl = os.path.join(tmp, "l.bin")
+preallocate(pl, 4 * MiB)
+with open(pl, "r+b") as f:
+    f.write(b"hello")
+    f.flush()
+    os.fsync(f.fileno())
+check("L: still sparse", sparse_state(pl) is True)
+check("L: usage small", disk_usage(pl) < MiB, disk_usage(pl))
+check("L: ranges one", allocated_ranges(pl) == [(0, 65536)], allocated_ranges(pl))
+check("L: content", open(pl, "rb").read(5) == b"hello")
+check("L: length", os.path.getsize(pl) == 4 * MiB)
+
+print()
+print("passed=%d failed=%d" % (len(PASSED), len(FAILED)))
+if FAILED:
+    print("FAILURES:")
+    for f in FAILED:
+        print("  -", f)
+shutil.rmtree(tmp, ignore_errors=True)
+sys.exit(1 if FAILED else 0)
