@@ -0,0 +1,43 @@
+import ctypes
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, r"C:\testbed")
+from wsparse import _winapi as wa
+from wsparse import preallocate, allocated_ranges
+
+k = wa.kernel32()
+base = tempfile.mkdtemp(prefix="probe6-")
+try:
+    p = os.path.join(base, "frag.bin")
+    preallocate(p, 16 << 20)
+    with open(p, "r+b") as fh:
+        for i in range(200):
+            fh.seek(i * 65536)
+            fh.write(b"%04d" % i)
+        fh.flush()
+        os.fsync(fh.fileno())
+    full = allocated_ranges(p)
+    print("full enumeration: %d ranges, total %d" % (len(full), sum(l for _, l in full)))
+    print("first", full[:3], "last", full[-3:])
+    print("gcs", wa.compressed_size(p))
+
+    h = wa.create_file(p, wa.GENERIC_READ, wa.SHARE_ALL, wa.OPEN_EXISTING)
+    slot = wa.FILE_ALLOCATED_RANGE_BUFFER()
+    slot.FileOffset = 0
+    slot.Length = os.path.getsize(p)
+    ret = ctypes.c_uint32(0)
+    for bufsize in (16, 32, 64, 128, 4096):
+        buf = ctypes.create_string_buffer(bufsize)
+        ok = k.DeviceIoControl(h, wa.FSCTL_QUERY_ALLOCATED_RANGES,
+                               ctypes.byref(slot), ctypes.sizeof(slot),
+                               buf, bufsize, ctypes.byref(ret), None)
+        err = ctypes.get_last_error()
+        first = wa.FILE_ALLOCATED_RANGE_BUFFER.from_buffer_copy(buf.raw[:16])
+        print("bufsize=%-6d ok=%d err=%-4d returned=%-6d first=(%d,%d)" %
+              (bufsize, ok, err, ret.value, first.FileOffset, first.Length))
+    wa.close_handle(h)
+finally:
+    shutil.rmtree(base, ignore_errors=True)
