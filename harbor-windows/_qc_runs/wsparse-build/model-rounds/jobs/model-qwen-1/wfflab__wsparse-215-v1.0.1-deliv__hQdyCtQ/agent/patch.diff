new file mode 100644
index 0000000..4ecc7fc
--- /dev/null
+++ b/_probe.py
@@ -0,0 +1,93 @@
+import ctypes
+import os
+import stat
+import sys
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+k.GetCompressedFileSizeW.restype = ctypes.c_uint32
+k.GetCompressedFileSizeW.argtypes = (ctypes.c_wchar_p, ctypes.POINTER(ctypes.c_uint32))
+k.GetVolumeInformationW.restype = ctypes.c_int
+k.GetVolumeInformationW.argtypes = (
+    ctypes.c_wchar_p, ctypes.c_wchar_p, ctypes.c_uint32,
+    ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(ctypes.c_uint32),
+    ctypes.POINTER(ctypes.c_uint32), ctypes.c_wchar_p, ctypes.c_uint32)
+k.GetDiskFreeSpaceW.restype = ctypes.c_int
+k.GetDiskFreeSpaceW.argtypes = (ctypes.c_wchar_p, ctypes.POINTER(ctypes.c_uint32),
+                               ctypes.POINTER(ctypes.c_uint32),
+                               ctypes.POINTER(ctypes.c_uint32),
+                               ctypes.POINTER(ctypes.c_uint32))
+
+
+def gcs(path):
+    hi = ctypes.c_uint32(0)
+    lo = k.GetCompressedFileSizeW(path, ctypes.byref(hi))
+    err = ctypes.get_last_error()
+    return lo, hi.value, err
+
+
+def volinfo(path):
+    name = ctypes.create_unicode_buffer(64)
+    maxlen = ctypes.c_uint32(0)
+    flags = ctypes.c_uint32(0)
+    ok = k.GetVolumeInformationW(path, None, 0, None, ctypes.byref(maxlen),
+                                 ctypes.byref(flags), name, 64)
+    s = ctypes.c_uint32(0); b = ctypes.c_uint32(0)
+    f = ctypes.c_uint32(0); t = ctypes.c_uint32(0)
+    ok2 = k.GetDiskFreeSpaceW(path, ctypes.byref(s), ctypes.byref(b), ctypes.byref(f), ctypes.byref(t))
+    return ok, name.value, hex(flags.value), maxlen.value, (ok2, s.value, b.value, f.value, t.value)
+
+
+for d in (r"C:\\", r"C:\testbed", os.path.expandvars(r"%TEMP%"), r"C:\Users\ContainerAdministrator\AppData\Local\Temp"):
+    print("volinfo", d, volinfo(d))
+
+paths = [
+    r"C:\testbed\assets\dense_64k.bin",
+    r"C:\testbed\README.md",
+    r"C:\Python312\python.exe",
+]
+for p in paths:
+    st = os.stat(p)
+    print(p, "size", st.st_size, "attr", hex(getattr(st, "st_file_attributes", 0)),
+          "gcs", gcs(p), "blocks", getattr(st, "st_blocks", None))
+
+# fresh files in various dirs
+import tempfile
+for d in (r"C:\testbed", tempfile.gettempdir()):
+    f = os.path.join(d, "_probe_dense.bin")
+    with open(f, "wb") as fh:
+        fh.write(b"x" * 65536)
+    print("fresh dense", f, os.path.getsize(f), gcs(f))
+    os.remove(f)
+    f2 = os.path.join(d, "_probe_sparse.bin")
+    with open(f2, "wb") as fh:
+        fh.write(b"\0" * 1024)
+    # mark sparse + hole
+    hh = ctypes.windll.kernel32.CreateFileW(f2, 0xC0000000, 7, None, 3, 0, None)
+    print("handle", hh)
+    setting = ctypes.c_uint32(1)
+    ret = ctypes.c_uint32(0)
+    ok = k.DeviceIoControl(hh, 0x000900C4, ctypes.byref(setting), 4, None, 0, ctypes.byref(ret), None)
+    print("set_sparse ok", ok, ctypes.get_last_error())
+    ok = k.DeviceIoControl(hh, 0x000900C4, None, 0, None, 0, ctypes.byref(ret), None)
+    print("clear_sparse(null buf) ok", ok, ctypes.get_last_error())
+    setting0 = ctypes.c_uint32(0)
+    ok = k.DeviceIoControl(hh, 0x000900C4, ctypes.byref(setting0), 4, None, 0, ctypes.byref(ret), None)
+    print("clear_sparse(0) ok", ok, ctypes.get_last_error())
+    class ZD(ctypes.Structure):
+        _fields_ = (("FileOffset", ctypes.c_longlong), ("BeyondFinalZero", ctypes.c_longlong))
+    k.SetEndOfFile.restype = ctypes.c_int
+    k.SetEndOfFile.argtypes = (ctypes.c_void_p,)
+    k.SetFilePointerEx.restype = ctypes.c_int
+    k.SetFilePointerEx.argtypes = (ctypes.c_void_p, ctypes.c_longlong, ctypes.POINTER(ctypes.c_longlong), ctypes.c_uint32)
+    k.SetFilePointerEx(hh, 1 << 20, None, 0)
+    k.SetEndOfFile(hh)
+    zd = ZD(); zd.FileOffset = 4096; zd.BeyondFinalZero = 1 << 20
+    ok = k.DeviceIoControl(hh, 0x000980C8, ctypes.byref(zd), ctypes.sizeof(zd), None, 0, ctypes.byref(ret), None)
+    print("zero_data ok", ok, ctypes.get_last_error())
+    k.CloseHandle(hh)
+    st = os.stat(f2)
+    print("sparse file", f2, st.st_size, hex(st.st_file_attributes), "gcs", gcs(f2), "blocks", st.st_blocks)
+    os.remove(f2)
+
+# directory
+print("dir gcs", gcs(r"C:\testbed"))
