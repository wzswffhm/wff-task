diff --git a/_probe3.py b/_probe3.py
new file mode 100644
index 0000000..1bf4cf3
--- /dev/null
+++ b/_probe3.py
@@ -0,0 +1,85 @@
+import ctypes
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, r"C:\testbed")
+from wsparse import _winapi as wa
+from wsparse import preallocate, disk_usage, allocated_ranges, sparse_state
+
+k = wa.kernel32()
+
+
+def gcs(path):
+    hi = ctypes.c_uint32(0)
+    lo = k.GetCompressedFileSizeW(path, ctypes.byref(hi))
+    return ((hi.value << 32) | lo, ctypes.get_last_error())
+
+
+base = tempfile.mkdtemp(prefix="probe3-")
+print("base", base)
+
+# 1) sparse file with real data, created by our preallocate + python writes
+p = os.path.join(base, "s.bin")
+preallocate(p, 64 << 20)
+with open(p, "r+b") as fh:
+    fh.seek(1 << 20)
+    fh.write(b"A" * 8192)
+    fh.seek(40 << 20)
+    fh.write(b"B" * 8192)
+    fh.flush()
+    os.fsync(fh.fileno())
+print("sparse:", os.path.getsize(p), hex(os.stat(p).st_file_attributes),
+      "sparse?", sparse_state(p), "gcs", gcs(p), "ranges", allocated_ranges(p))
+
+# 2) same but built manually with ctypes, closed before measuring
+p2 = os.path.join(base, "s2.bin")
+h = wa.create_file(p2, wa.GENERIC_READ | wa.GENERIC_WRITE, wa.SHARE_ALL, wa.OPEN_ALWAYS)
+wa.set_sparse(h, p2)
+wa.set_end_of_file(h, 64 << 20, p2)
+wa.set_zero_data(h, 4096, (64 << 20) - 4096, p2)
+wa.close_handle(h)
+with open(p2, "r+b") as fh:
+    fh.seek(1 << 20)
+    fh.write(b"A" * 8192)
+    fh.flush()
+    os.fsync(fh.fileno())
+print("s2:", os.path.getsize(p2), hex(os.stat(p2).st_file_attributes), "gcs", gcs(p2),
+      "ranges", allocated_ranges(p2), "disk_usage", disk_usage(p2))
+
+# 3) sparse via fsutil
+p3 = os.path.join(base, "s3.bin")
+os.system('fsutil file createnew "%s" 67108864 >nul' % p3)
+os.system('fsutil sparse setflag "%s" >nul' % p3)
+os.system('fsutil sparse setrange "%s" 4096 67105216 >nul' % p3)
+with open(p3, "r+b") as fh:
+    fh.seek(1 << 20)
+    fh.write(b"A" * 8192)
+    fh.flush()
+print("s3:", os.path.getsize(p3), hex(os.stat(p3).st_file_attributes), "gcs", gcs(p3),
+      "ranges", allocated_ranges(p3))
+
+# 4) dense file written in base
+p4 = os.path.join(base, "d.bin")
+with open(p4, "wb") as fh:
+    fh.write(b"d" * 65536)
+print("dense:", os.path.getsize(p4), "gcs", gcs(p4), "ranges", allocated_ranges(p4))
+
+# 5) what does QUERY_ALLOCATED_RANGES say for a base-layer file (dense_64k)?
+a = r"C:\testbed\assets\dense_64k.bin"
+print("asset:", os.path.getsize(a), "gcs", gcs(a), "ranges", allocated_ranges(a),
+      "attr", hex(os.stat(a).st_file_attributes))
+h = wa.create_file(a, wa.GENERIC_READ, wa.SHARE_ALL, wa.OPEN_EXISTING)
+si = wa.get_standard_info(h, a)
+print("asset standard info: alloc", si.AllocationSize, "eof", si.EndOfFile, "dir", si.Directory)
+wa.close_handle(h)
+
+h = wa.create_file(p, wa.GENERIC_READ, wa.SHARE_ALL, wa.OPEN_EXISTING)
+si = wa.get_standard_info(h, p)
+print("s standard info: alloc", si.AllocationSize, "eof", si.EndOfFile)
+wa.close_handle(h)
+
+print("cluster", wa.volume_cluster_size(base), "fs", wa.volume_file_system(base), wa.volume_root(base))
+
+import shutil
+shutil.rmtree(base, ignore_errors=True)
diff --git a/_probe4.py b/_probe4.py
new file mode 100644
index 0000000..dcee1f6
--- /dev/null
+++ b/_probe4.py
@@ -0,0 +1,78 @@
+import ctypes
+import os
+import sys
+import tempfile
+import shutil
+
+sys.path.insert(0, r"C:\testbed")
+from wsparse import _winapi as wa
+from wsparse import preallocate, allocated_ranges
+
+k = wa.kernel32()
+
+
+def gcs(path):
+    hi = ctypes.c_uint32(0)
+    lo = k.GetCompressedFileSizeW(path, ctypes.byref(hi))
+    return ((hi.value << 32) | lo, ctypes.get_last_error())
+
+
+def alloc_size(path):
+    h = wa.create_file(path, wa.GENERIC_READ, wa.SHARE_ALL, wa.OPEN_EXISTING)
+    try:
+        si = wa.get_standard_info(h, path)
+        return si.AllocationSize
+    finally:
+        wa.close_handle(h)
+
+
+def report(tag, path):
+    r = allocated_ranges(path)
+    print("%-22s gcs=%-10d alloc=%-10d ranges=%s total=%d" %
+          (tag, gcs(path)[0], alloc_size(path), r, sum(l for _, l in r)))
+
+
+base = tempfile.mkdtemp(prefix="probe4-")
+try:
+    for tag, mode in (("no-flush", 0), ("flush-only", 1), ("flush+fsync", 2)):
+        p = os.path.join(base, "f%d.bin" % mode)
+        preallocate(p, 64 << 20)
+        fh = open(p, "r+b")
+        fh.seek(1 << 20)
+        fh.write(b"A" * 8192)
+        fh.seek(40 << 20)
+        fh.write(b"B" * 8192)
+        if mode >= 1:
+            fh.flush()
+        if mode >= 2:
+            os.fsync(fh.fileno())
+        fh.close()
+        report(tag, p)
+
+    # after reading the file back (forces cache population)
+    p = os.path.join(base, "f0.bin")
+    with open(p, "rb") as fh:
+        fh.seek(1 << 20)
+        assert fh.read(8192) == b"A" * 8192
+    report("after-read", p)
+
+    # after FlushFileBuffers via a separate handle
+    h = wa.create_file(p, wa.GENERIC_READ | wa.GENERIC_WRITE, wa.SHARE_ALL, wa.OPEN_EXISTING)
+    k.FlushFileBuffers.argtypes = (ctypes.c_void_p,)
+    print("FlushFileBuffers ->", k.FlushFileBuffers(h))
+    wa.close_handle(h)
+    report("after-flush-buffers", p)
+
+    # dense file, no fsync
+    d = os.path.join(base, "dense.bin")
+    with open(d, "wb") as fh:
+        fh.write(b"d" * (8 << 20))
+    report("dense-8MiB-no-fsync", d)
+
+    # small dense file no fsync
+    s = os.path.join(base, "small.bin")
+    with open(s, "wb") as fh:
+        fh.write(b"s" * 65536)
+    report("dense-64k-no-fsync", s)
+finally:
+    shutil.rmtree(base, ignore_errors=True)
