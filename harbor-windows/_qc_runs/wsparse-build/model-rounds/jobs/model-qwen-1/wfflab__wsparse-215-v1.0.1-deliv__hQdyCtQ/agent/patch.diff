index 0000000..176d153
--- /dev/null
+++ b/_probe5.py
@@ -0,0 +1,72 @@
+import ctypes
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, r"C:\testbed")
+from wsparse import _winapi as wa
+from wsparse import allocated_ranges, preallocate, sparse_flag, sparse_state, disk_usage
+
+k = wa.kernel32()
+
+
+def gcs(path):
+    hi = ctypes.c_uint32(0)
+    lo = k.GetCompressedFileSizeW(path, ctypes.byref(hi))
+    return ((hi.value << 32) | lo, ctypes.get_last_error())
+
+
+base = tempfile.mkdtemp(prefix="probe5-")
+try:
+    # --- clearing the sparse flag -------------------------------------
+    p = os.path.join(base, "c.bin")
+    preallocate(p, 1 << 20)
+    print("after preallocate: sparse?", sparse_state(p), gcs(p))
+    h = wa.create_file(p, wa.GENERIC_READ | wa.GENERIC_WRITE, wa.SHARE_ALL, wa.OPEN_EXISTING)
+    false_val = ctypes.c_uint32(0)
+    ret = ctypes.c_uint32(0)
+    ok = k.DeviceIoControl(h, wa.FSCTL_SET_SPARSE, ctypes.byref(false_val), 4, None, 0,
+                           ctypes.byref(ret), None)
+    print("clear with FALSE dword:", ok, ctypes.get_last_error(), "returned", ret.value)
+    b = wa.get_basic_info(h, p)
+    print("attr after FALSE:", hex(b.FileAttributes))
+    ok = k.DeviceIoControl(h, wa.FSCTL_SET_SPARSE, None, 0, None, 0, ctypes.byref(ret), None)
+    print("clear with NULL:", ok, ctypes.get_last_error())
+    b = wa.get_basic_info(h, p)
+    print("attr after NULL:", hex(b.FileAttributes))
+    wa.close_handle(h)
+    print("state now:", sparse_state(p), "gcs", gcs(p), "ranges", allocated_ranges(p))
+
+    # --- tiny / unaligned dense files ---------------------------------
+    for size in (1, 7, 100, 4095, 4096, 4097, 65536, 5 << 20):
+        f = os.path.join(base, "d%d.bin" % size)
+        with open(f, "wb") as fh:
+            fh.write(b"q" * size)
+        r = allocated_ranges(f)
+        print("dense %-8d gcs=%-10d ranges=%s total=%d" %
+              (size, gcs(f)[0], r, sum(l for _, l in r)))
+
+    # --- sparse file with unaligned writes ----------------------------
+    s = os.path.join(base, "s.bin")
+    preallocate(s, 10 << 20)
+    with open(s, "r+b") as fh:
+        fh.seek(100)
+        fh.write(b"z" * 50)
+        fh.seek((9 << 20) + 7)
+        fh.write(b"y" * 33)
+        fh.flush()
+        os.fsync(fh.fileno())
+    print("sparse unaligned gcs", gcs(s), "ranges", allocated_ranges(s))
+
+    # --- preallocate on an existing dense file (must not free clusters)
+    e = os.path.join(base, "e.bin")
+    with open(e, "wb") as fh:
+        fh.write(b"x" * (1 << 20))
+    print("dense before preallocate:", gcs(e), allocated_ranges(e))
+    preallocate(e, 2 << 20)
+    print("dense after preallocate:", gcs(e), allocated_ranges(e), sparse_state(e))
+    os.system('fsutil file layout "%s" > "%s"' % (e, os.path.join(base, "layout.txt")))
+    print(open(os.path.join(base, "layout.txt")).read()[:2000])
+finally:
+    shutil.rmtree(base, ignore_errors=True)
