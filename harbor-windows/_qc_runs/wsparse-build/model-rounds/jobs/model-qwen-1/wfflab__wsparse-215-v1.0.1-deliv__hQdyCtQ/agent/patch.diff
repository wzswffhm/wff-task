diff --git a/_acc_check.py b/_acc_check.py
new file mode 100644
index 0000000..33b56bf
--- /dev/null
+++ b/_acc_check.py
@@ -0,0 +1,198 @@
+import os
+import shutil
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, r"C:\testbed")
+
+import wsparse
+from wsparse import (
+    WSParseError,
+    allocated_ranges,
+    disk_usage,
+    preallocate,
+    sparse_flag,
+    sparse_state,
+)
+
+print("module file:", wsparse.__file__)
+base = tempfile.mkdtemp(prefix="wsparse-acc-")
+print("scratch:", base)
+fails = []
+
+
+def check(name, cond, extra=""):
+    print(("PASS " if cond else "FAIL ") + name + ("  " + str(extra) if extra else ""))
+    if not cond:
+        fails.append(name)
+
+
+try:
+    # ---- A. sparse preallocation -------------------------------------
+    p = os.path.join(base, "a.bin")
+    t0 = time.time()
+    n = preallocate(p, 1 << 30)
+    dt = time.time() - t0
+    check("A preallocate returns size", n == (1 << 30), n)
+    check("A file length", os.path.getsize(p) == (1 << 30), os.path.getsize(p))
+    check("A sparse attr", sparse_state(p) is True)
+    used = disk_usage(p)
+    check("A disk_usage <= 8MiB", used <= (8 << 20), "%d bytes (%.3f MiB)" % (used, used / 1048576))
+    check("A fast", dt < 5.0, "%.3fs" % dt)
+    check("A all-hole ranges", allocated_ranges(p) == [], allocated_ranges(p))
+    n2 = preallocate(p, 1 << 30)
+    check("A idempotent", n2 == (1 << 30) and disk_usage(p) <= (8 << 20), disk_usage(p))
+
+    n3 = preallocate(p, (1 << 30) + 4096)
+    check("A grow", n3 == (1 << 30) + 4096 and disk_usage(p) <= (8 << 20), disk_usage(p))
+
+    # ---- B. write semantics ------------------------------------------
+    payload = bytes(range(256)) * 4
+    with open(p, "r+b") as fh:
+        fh.seek(3 * 1024 * 1024)
+        fh.write(payload)
+        fh.seek((1 << 30) - 8192)
+        fh.write(b"tail-data")
+    with open(p, "rb") as fh:
+        fh.seek(3 * 1024 * 1024)
+        got = fh.read(len(payload))
+        fh.seek((1 << 30) - 8192)
+        got2 = fh.read(9)
+        fh.seek(1024 * 1024)
+        zeros = fh.read(4096)
+    check("B readback@3MiB", got == payload)
+    check("B readback@tail", got2 == b"tail-data", got2)
+    check("B hole reads zeros", zeros == b"\x00" * 4096)
+    u = disk_usage(p)
+    check("B usage still tiny", u <= (8 << 20), "%d bytes (%.1f KiB)" % (u, u / 1024))
+    rr = allocated_ranges(p)
+    check("B ranges == 2", len(rr) == 2, rr)
+    check("B ranges inside file", all(0 <= o and l > 0 and o + l <= os.path.getsize(p) for o, l in rr), rr)
+    covered = [(o, l) for o, l in rr if o <= 3 * 1024 * 1024 < o + l]
+    check("B range covers write", bool(covered), rr)
+
+    # ---- C. occupancy --------------------------------------------------
+    sp = os.path.join(base, "sparse64.bin")
+    open(sp, "wb").close()
+    preallocate(sp, 64 << 20)
+    with open(sp, "r+b") as fh:
+        fh.seek(1 << 20)
+        fh.write(b"A" * 8192)
+        fh.seek(40 << 20)
+        fh.write(b"B" * 8192)
+    u = disk_usage(sp)
+    check("C sparse usage < 1MiB", u < (1 << 20), "%d bytes (%.1f KiB)" % (u, u / 1024))
+    check("C sparse usage > 0", u > 0, u)
+    check("C sparse length", os.path.getsize(sp) == 64 << 20)
+    rr = allocated_ranges(sp)
+    check("C sparse ranges == 2", len(rr) == 2, rr)
+    total = sum(l for _, l in rr)
+    check("C ranges total <= usage", total <= u, (total, u))
+
+    dense = os.path.join(base, "dense64.bin")
+    with open(dense, "wb") as fh:
+        fh.write(b"d" * (64 << 20))
+    ud = disk_usage(dense)
+    check("C dense usage ~ len", 64 << 20 <= ud <= (64 << 20) + (1 << 20), ud)
+    rd = allocated_ranges(dense)
+    check("C dense single full range", rd == [(0, 64 << 20)], rd)
+    check("C dense not sparse", sparse_state(dense) is False)
+
+    asset = r"C:\testbed\assets\dense_64k.bin"
+    ua = disk_usage(asset)
+    ra = allocated_ranges(asset)
+    sa = os.path.getsize(asset)
+    check("C asset usage >= len", ua >= sa, (ua, sa))
+    check("C asset usage aligned", ua % 4096 == 0, ua)
+    check("C asset one full range", ra == [(0, sa)], (ra, sa))
+    check("C asset dense", sparse_state(asset) is False)
+
+    # ---- D. holes ------------------------------------------------------
+    hole = os.path.join(base, "hole.bin")
+    preallocate(hole, 1 << 20)
+    check("D all-hole empty list", allocated_ranges(hole) == [], allocated_ranges(hole))
+    check("D all-hole usage 0", disk_usage(hole) == 0, disk_usage(hole))
+    empty = os.path.join(base, "empty.bin")
+    open(empty, "wb").close()
+    check("D empty file ranges", allocated_ranges(empty) == [])
+    check("D empty file usage", disk_usage(empty) == 0)
+
+    # ---- E. sparse flag cannot retroactively free ----------------------
+    e = os.path.join(base, "e.bin")
+    with open(e, "wb") as fh:
+        fh.write(b"x" * (4 << 20))
+    before = disk_usage(e)
+    res = sparse_flag(e, True)
+    after = disk_usage(e)
+    check("E sparse_flag returns True", res is True, res)
+    check("E attr set", sparse_state(e) is True)
+    check("E usage unchanged", before == after, (before, after))
+    check("E usage >= len", after >= 4 << 20, after)
+    check("E ranges cover whole file", allocated_ranges(e) == [(0, 4 << 20)], allocated_ranges(e))
+
+    cleared = sparse_flag(e, False)
+    check("E clear sparse", cleared is False and sparse_state(e) is False, cleared)
+
+    # ---- F. unsupported ------------------------------------------------
+    d = os.path.join(base, "adir")
+    os.mkdir(d)
+    for fn, args in (
+        (preallocate, (d, 4096)),
+        (disk_usage, (d,)),
+        (allocated_ranges, (d,)),
+        (sparse_flag, (d, True)),
+        (sparse_state, (d,)),
+    ):
+        try:
+            r = fn(*args)
+            check("F %s on dir raises" % fn.__name__, False, "returned %r" % (r,))
+        except WSParseError as exc:
+            check("F %s on dir unsupported" % fn.__name__, exc.kind == "unsupported", (exc.kind, str(exc)))
+        except OSError as exc:
+            check("F %s on dir unsupported" % fn.__name__, False, "OSError %r" % exc)
+
+    for fn in (disk_usage, allocated_ranges, sparse_state):
+        try:
+            fn(os.path.join(base, "nope.bin"))
+            check("F %s missing raises" % fn.__name__, False)
+        except WSParseError as exc:
+            check("F %s missing == os" % fn.__name__, exc.kind == "os", exc.kind)
+    try:
+        sparse_flag(os.path.join(base, "nope.bin"), True)
+        check("F sparse_flag missing raises", False)
+    except WSParseError as exc:
+        check("F sparse_flag missing == os", exc.kind == "os", exc.kind)
+
+    try:
+        preallocate(os.path.join(base, "bad.bin"), -1)
+    except WSParseError as exc:
+        check("F negative badarg", exc.kind == "badarg", exc.kind)
+    try:
+        preallocate(os.path.join(base, "bad.bin"), 1.5)
+    except WSParseError as exc:
+        check("F float badarg", exc.kind == "badarg", exc.kind)
+
+    import pathlib
+    check("F size 0", preallocate(pathlib.Path(base) / "zero.bin", 0) == 0)
+    check("F pathlib works", preallocate(pathlib.Path(base) / "pl.bin", 1 << 20) == (1 << 20))
+
+    # existing content preserved on re-preallocate
+    keep = os.path.join(base, "keep.bin")
+    with open(keep, "wb") as fh:
+        fh.write(b"payload")
+    preallocate(keep, 1 << 20)
+    preallocate(keep, 16)
+    with open(keep, "rb") as fh:
+        data = fh.read()
+    check("G never shrinks", len(data) == 1 << 20, len(data))
+    check("G content kept", data[:7] == b"payload", data[:7])
+
+    print()
+    print("free space:", shutil.disk_usage(base))
+finally:
+    shutil.rmtree(base, ignore_errors=True)
+
+print()
+print("FAILURES:", fails if fails else "none")
+sys.exit(1 if fails else 0)
