diff --git a/wsparse/__init__.py b/wsparse/__init__.py
index c2caf00..153a7df 100644
--- a/wsparse/__init__.py
+++ b/wsparse/__init__.py
@@ -1,19 +1,21 @@
 """wsparse -- space management for the collector's on-disk sink files.
 
-The collector streams large payloads into *sink* files.  Two properties matter
-to the rest of the pipeline:
+The collector streams large payloads into *sink* files on an NTFS volume.
+Three properties matter to the rest of the pipeline:
 
 * a sink is **pre-allocated** so that the writer never has to grow the file
-  while it is streaming, and
-* the pipeline can ask how much disk a sink really occupies, and which byte
-  ranges of it are backed by allocated clusters, so that an interrupted
-  transfer can be resumed without re-downloading what is already on disk.
+  while it is streaming, and the reservation itself must be free -- the tail is
+  a sparse hole, not a gigabyte of zero writes,
+* the pipeline can ask how much disk a sink *really* occupies, which is the
+  clusters NTFS charged for it rather than its logical length, and
+* it can ask which byte ranges are backed by allocated clusters, so that an
+  interrupted transfer resumes without re-downloading what is already there.
 
 Public API
 ----------
 
 ``preallocate(path, size)``
-    Grow ``path`` to ``size`` bytes and reserve the space for it.
+    Mark ``path`` sparse and move its length out to ``size`` bytes.
 ``disk_usage(path)``
     Number of bytes ``path`` occupies on disk.
 ``allocated_ranges(path)``
@@ -23,9 +25,13 @@ Public API
 ``sparse_state(path)``
     ``True`` when ``path`` currently carries the sparse attribute.
 ``WSParseError``
-    Carries a ``kind`` classifier.
+    Carries a ``kind`` classifier: ``unsupported`` / ``os`` / ``badarg``.
 
-See ``docs/NOTES.md`` for the layout notes and ``README.md`` for the supported
+Objects that cannot hold sparse data -- a directory, or a volume whose file
+system does not implement the sparse FSCTLs -- raise ``WSParseError`` with
+``kind == "unsupported"`` rather than failing silently.
+
+``docs/NOTES.md`` is a superseded draft; see ``README.md`` for the supported
 Python versions.
 """
 
@@ -44,4 +50,4 @@ __all__ = [
     "sparse_state",
