+        try:
+            raw = _winapi.query_allocated_ranges(handle, size)
+        except WSParseError as exc:
+            # A file system that does not implement the sparse FSCTLs at all
+            # cannot have holes either, so everything in such a file is backed
+            # by clusters.  A sparse file that fails the query is a real error.
+            if exc.kind == "unsupported" and not sparse:
+                return [(0, size)]
+            raise
