+    if file_size.value == 0:
+        return []
+    
+    # Set up input range covering entire file
+    input_range = FILE_ALLOCATED_RANGE_BUFFER()
+    input_range.FileOffset = 0
+    input_range.Length = file_size.value
+    
+    # Output buffer for ranges
+    out_size = max_ranges * ctypes.sizeof(FILE_ALLOCATED_RANGE_BUFFER)
+    
+    try:
+        out_buf, bytes_returned = device_io_control(
+            handle,
+            FSCTL_QUERY_ALLOCATED_RANGES,
+            in_buffer=input_range,
+            out_buffer_size=out_size,
