+    
+    # Parse output
+    ranges = []
+    num_ranges = bytes_returned // ctypes.sizeof(FILE_ALLOCATED_RANGE_BUFFER)
+    
+    for i in range(num_ranges):
+        offset = ctypes.sizeof(FILE_ALLOCATED_RANGE_BUFFER) * i
+        entry = FILE_ALLOCATED_RANGE_BUFFER.from_buffer_copy(out_buf.raw, offset)
+        ranges.append((entry.FileOffset, entry.Length))
+    
+    return ranges
+
+
+def get_compressed_file_size(path):
+    """Get the compressed/allocated size of a file.
+    
+    This returns the actual disk space used by the file.
+    """
+    k32 = _kernel32()
+    high = wintypes.DWORD()
+    low = k32.GetCompressedFileSizeW(path, ctypes.byref(high))
+    
+    if low == 0xFFFFFFFF:
+        err = ctypes.get_last_error()
+        if err != 0:  # NO_ERROR
+            raise OSError(err, os.strerror(err), path)
+    
+    return (high.value << 32) | low
