+    except OSError as e:
+        # ERROR_MORE_DATA means there are more ranges than our buffer can hold
+        # For simplicity, we'll just work with what we have or re-query
+        # Actually, let's handle this properly
+        if e.winerror == 234:  # ERROR_MORE_DATA
+            # Re-query with larger buffer
+            out_size = 4096 * ctypes.sizeof(FILE_ALLOCATED_RANGE_BUFFER)
+            out_buf, bytes_returned = device_io_control(
+                handle,
+                FSCTL_QUERY_ALLOCATED_RANGES,
+                in_buffer=input_range,
+                out_buffer_size=out_size,
+            )
+        else:
