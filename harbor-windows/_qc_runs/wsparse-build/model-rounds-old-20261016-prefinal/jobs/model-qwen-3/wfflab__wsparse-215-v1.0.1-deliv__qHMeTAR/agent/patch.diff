index 0000000..8c8e85d
--- /dev/null
+++ b/_probe_tmp.py
@@ -0,0 +1,141 @@
+import ctypes, ctypes.wintypes as wt, os, tempfile
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+SHARE = 1 | 2 | 4
+OPEN_EXISTING = 3
+CREATE_ALWAYS = 2
+FSCTL_SET_SPARSE = 0x000900C4
+FSCTL_QUERY_ALLOCATED_RANGES = 0x000940CF
+
+CreateFileW = k.CreateFileW
+CreateFileW.restype = wt.HANDLE
+CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.HANDLE]
+DeviceIoControl = k.DeviceIoControl
+DeviceIoControl.restype = wt.BOOL
+DeviceIoControl.argtypes = [wt.HANDLE, wt.DWORD, ctypes.c_void_p, wt.DWORD, ctypes.c_void_p, wt.DWORD, ctypes.POINTER(wt.DWORD), ctypes.c_void_p]
+CloseHandle = k.CloseHandle
+SetFilePointerEx = k.SetFilePointerEx
+SetFilePointerEx.restype = wt.BOOL
+SetFilePointerEx.argtypes = [wt.HANDLE, wt.LARGE_INTEGER, ctypes.POINTER(wt.LARGE_INTEGER), wt.DWORD]
+SetEndOfFile = k.SetEndOfFile
+SetEndOfFile.restype = wt.BOOL
+SetEndOfFile.argtypes = [wt.HANDLE]
+GetCompressedFileSizeW = k.GetCompressedFileSizeW
+GetCompressedFileSizeW.restype = wt.DWORD
+GetCompressedFileSizeW.argtypes = [wt.LPCWSTR, ctypes.POINTER(wt.DWORD)]
+
+
+class FARB(ctypes.Structure):
+    _fields_ = [("FileOffset", wt.LARGE_INTEGER), ("Length", wt.LARGE_INTEGER)]
+
+
+class FSSB(ctypes.Structure):
+    _fields_ = [("SetSparse", ctypes.c_ubyte)]
+
+
+def comp(path):
+    hi = wt.DWORD()
+    lo = GetCompressedFileSizeW(path, ctypes.byref(hi))
+    return ((hi.value << 32) | lo), ctypes.get_last_error()
+
+
+def ranges_of(path, size, access=GENERIC_READ):
+    h = CreateFileW(path, access, SHARE, None, OPEN_EXISTING, 0, None)
+    if h is None or h == 2**64 - 1:
+        return ("open fail", ctypes.get_last_error())
+    inbuf = FARB(0, size)
+    out = ctypes.create_string_buffer(1 << 16)
+    ret = wt.DWORD()
+    res = []
+    while True:
+        ok = DeviceIoControl(h, FSCTL_QUERY_ALLOCATED_RANGES, ctypes.byref(inbuf), 16, out, 1 << 16, ctypes.byref(ret), None)
+        err = ctypes.get_last_error()
+        n = ret.value // 16
+        for i in range(n):
+            it = FARB.from_buffer_copy(out.raw, i * 16)
+            res.append((it.FileOffset, it.Length))
+        if not ok:
+            CloseHandle(h)
+            return (res, err)
+        if n == 0:
+            break
+        nxt = res[-1][0] + res[-1][1]
+        if nxt >= size:
+            break
+        inbuf = FARB(nxt, size - nxt)
+    CloseHandle(h)
+    return (res, 0)
+
+
+def set_sparse(path, enabled):
+    h = CreateFileW(path, GENERIC_READ | GENERIC_WRITE, SHARE, None, OPEN_EXISTING, 0, None)
+    if h is None or h == 2**64 - 1:
+        return ("open fail", ctypes.get_last_error())
+    req = FSSB(1 if enabled else 0)
+    ret = wt.DWORD()
+    ok = DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(req), 1, None, 0, ctypes.byref(ret), None)
+    err = ctypes.get_last_error()
+    CloseHandle(h)
+    return ok, err
+
+
+tmp = tempfile.gettempdir()
+size = 16 << 20
+
+p = os.path.join(tmp, "clear.bin")
+if os.path.exists(p):
+    os.remove(p)
+h = CreateFileW(p, GENERIC_READ | GENERIC_WRITE, SHARE, None, CREATE_ALWAYS, 0, None)
+ret = wt.DWORD()
+req = FSSB(1)
+print("set sparse", DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(req), 1, None, 0, ctypes.byref(ret), None))
+SetFilePointerEx(h, wt.LARGE_INTEGER(size), None, 0)
+SetEndOfFile(h)
+CloseHandle(h)
+with open(p, "r+b") as f:
+    f.seek(4096)
+    f.write(b"A" * 100)
+print("sparse w/ hole:", hex(os.stat(p).st_file_attributes), comp(p), ranges_of(p, size))
+print("clear:", set_sparse(p, False))
+print("after clear:", hex(os.stat(p).st_file_attributes), comp(p), ranges_of(p, size))
+with open(p, "rb") as f:
+    f.seek(4096)
+    print("data intact", f.read(8))
+    f.seek(8 << 20)
+    print("hole reads", f.read(8))
+os.remove(p)
+
+# 100 byte dense file, does query report cluster-aligned or exact?
+p2 = os.path.join(tmp, "exact.bin")
+with open(p2, "wb") as f:
+    f.write(b"Q" * 100)
+print("100B dense ranges", ranges_of(p2, 100), comp(p2))
+os.remove(p2)
+
+# a file written in two far-apart spots, non sparse
+p3 = os.path.join(tmp, "twow.bin")
+with open(p3, "wb") as f:
+    f.truncate(size)
+    f.seek(4096)
+    f.write(b"A" * 100)
+    f.seek(8 << 20)
+    f.write(b"B" * 100)
+print("non-sparse truncate+writes:", hex(os.stat(p3).st_file_attributes), comp(p3), ranges_of(p3, size))
+os.remove(p3)
+
+# sparse with many small writes - check range merging behaviour
+p4 = os.path.join(tmp, "many.bin")
+h = CreateFileW(p4, GENERIC_READ | GENERIC_WRITE, SHARE, None, CREATE_ALWAYS, 0, None)
+req = FSSB(1)
+DeviceIoControl(h, FSCTL_SET_SPARSE, ctypes.byref(req), 1, None, 0, ctypes.byref(ret), None)
+SetFilePointerEx(h, wt.LARGE_INTEGER(size), None, 0)
+SetEndOfFile(h)
+CloseHandle(h)
+with open(p4, "r+b") as f:
+    for i in range(8):
+        f.seek(i * 1000000 + 13)
+        f.write(b"M" * 17)
+print("many writes:", comp(p4), ranges_of(p4, size))
+os.remove(p4)
diff --git a/wsparse/_layout.py b/wsparse/_layout.py
new file mode 100644
index 0000000..ece2010
--- /dev/null
+++ b/wsparse/_layout.py
@@ -0,0 +1,121 @@
+"""Shared reader for the on-disk layout of a file.
+
+:func:`disk_usage` and :func:`allocated_ranges` both have to ask the file
+system the same question -- *which parts of this file are backed by clusters?*
+-- so the query lives here and both callers consume its answer.
+
+The layout is always read through ``FSCTL_QUERY_ALLOCATED_RANGES``.  That call
+looks at the file system's allocation map, which is kept up to date while the
+file is being written, whereas ``GetCompressedFileSize`` reports a cached value
+that NTFS only refreshes lazily.  ``GetCompressedFileSize`` is therefore used
+solely as a fallback for volumes that cannot answer the query at all.
+"""
+
+import os
+
+from . import _winapi
+from ._winapi import SPARSE_ATTRIBUTE, require_file_object, require_windows
+
+#: A handle opened for the layout query needs read access; the file system
+#: refuses ``FSCTL_QUERY_ALLOCATED_RANGES`` on an attribute-only handle.
+_QUERY_ACCESS = _winapi.GENERIC_READ
+
+
+class Allocation(object):
+    """What the file system says about the clusters a file holds.
+
+    ``size``
+        Logical length of the file in bytes.
+    ``sparse``
+        Whether the file currently carries the sparse attribute.
+    ``ranges``
+        ``[(offset, length), ...]`` of the allocated regions, ordered by
+        offset, disjoint and clipped to ``size``.
+    ``exact``
+        ``False`` when the volume could not answer the query and ``ranges`` is
+        an approximation derived from the length of the file.
+    """
+
+    __slots__ = ("path", "size", "sparse", "ranges", "exact", "attributes")
+
+    def __init__(self, path, size, sparse, ranges, exact, attributes=0):
+        self.path = path
+        self.size = size
+        self.sparse = sparse
+        self.ranges = ranges
+        self.exact = exact
+        self.attributes = attributes
+
+    def __repr__(self):  # pragma: no cover - debugging aid
+        return "<Allocation size=%d sparse=%s exact=%s ranges=%d>" % (
+            self.size,
+            self.sparse,
+            self.exact,
+            len(self.ranges),
+        )
+
+
+def _attributes(path, info):
+    """File attributes of ``path``, preferring the live ``GetFileAttributes``."""
+    attributes = _winapi.attributes_of(path)
+    if attributes is None:
+        attributes = getattr(info, "st_file_attributes", 0)
+    return int(attributes or 0)
+
+
+def allocation_of(path):
+    """Ask the file system how ``path`` is laid out on disk."""
+    require_windows(path)
+    info = require_file_object(path)
+    size = int(info.st_size)
+    attributes = _attributes(path, info)
+    sparse = bool(attributes & SPARSE_ATTRIBUTE)
+
+    if size <= 0:
+        return Allocation(path, 0, sparse, [], True, attributes)
+
+    handle = _winapi.open_handle(
+        path, _QUERY_ACCESS, _winapi.FILE_SHARE_ALL, _winapi.OPEN_EXISTING
+    )
+    try:
+        reported = _winapi.query_allocated_ranges(handle, size, path)
+    finally:
+        _winapi.close_handle(handle)
+
+    if reported is None:
+        # The volume has no notion of a hole, so every byte of the file is on
+        # disk as far as it is concerned.
+        ranges = [(0, size)]
+        exact = False
+    else:
+        ranges = reported
+        exact = True
+
+    ranges = _winapi.normalize_ranges(ranges, size)
+    if not sparse and not ranges:
+        # A file without the sparse attribute cannot have holes; an empty
+        # answer from the volume would under-report every byte of it.
+        ranges = [(0, size)]
+    return Allocation(path, size, sparse, ranges, exact, attributes)
+
+
+def disk_bytes(allocation):
+    """Bytes of disk ``allocation`` occupies, rounded out to whole clusters."""
+    cluster = _winapi.cluster_size(allocation.path)
+    if not allocation.exact:
+        compressed = _winapi.compressed_size(allocation.path)
+        if compressed is not None:
+            return max(_winapi.align_up(int(compressed), cluster), 0)
+    return _winapi.aligned_total(allocation.ranges, cluster)
+
+
+def check_path(path):
+    """Resolve ``path`` and reject objects that can never hold clusters."""
+    path = os.fspath(path)
+    if isinstance(path, bytes):
+        path = os.fsdecode(path)
+    if not isinstance(path, str) or not path:
+        raise _winapi.WSParseError(
+            "path must be a non-empty string, got %r" % (path,), kind="badarg", path=None
+        )
+    return path
