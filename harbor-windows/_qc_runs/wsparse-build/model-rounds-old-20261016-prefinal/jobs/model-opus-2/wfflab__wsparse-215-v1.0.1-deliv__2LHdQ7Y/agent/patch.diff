diff --git a/_verify_tmp.py b/_verify_tmp.py
new file mode 100644
index 0000000..b2a587c
--- /dev/null
+++ b/_verify_tmp.py
@@ -0,0 +1,178 @@
+import os
+import tempfile
+import time
+
+import wsparse
+from wsparse import (
+    WSParseError,
+    allocated_ranges,
+    disk_usage,
+    preallocate,
+    sparse_flag,
+    sparse_state,
+)
+
+root = tempfile.mkdtemp(prefix="wsparse-verify-")
+GIB = 1024 * 1024 * 1024
+MIB = 1024 * 1024
+
+line = print
+
+# A. sparse preallocation
+sink = os.path.join(root, "sink.bin")
+start = time.time()
+length = preallocate(sink, GIB)
+elapsed = time.time() - start
+used = disk_usage(sink)
+line("A length", length, os.path.getsize(sink), "elapsed", round(elapsed, 3))
+line("A usage", used, "<= 8MiB:", used <= 8 * MIB)
+line("A sparse", sparse_state(sink))
+line("A ranges", allocated_ranges(sink))
+assert length == GIB == os.path.getsize(sink)
+assert used <= 8 * MIB
+assert sparse_state(sink) is True
+assert allocated_ranges(sink) == []
+
+again = preallocate(sink, GIB)
+assert again == GIB
+assert disk_usage(sink) <= 8 * MIB
+assert allocated_ranges(sink) == []
+line("A idempotent ok")
+
+# B. write semantics
+payload = b"collector-payload" * 7
+with open(sink, "r+b") as handle:
+    handle.seek(700 * MIB)
+    handle.write(payload)
+    handle.flush()
+    os.fsync(handle.fileno())
+with open(sink, "rb") as handle:
+    handle.seek(700 * MIB)
+    assert handle.read(len(payload)) == payload
+    handle.seek(0)
+    assert handle.read(65536) == b"\x00" * 65536
+    handle.seek(1000 * MIB)
+    assert handle.read(4096) == b"\x00" * 4096
+used = disk_usage(sink)
+line("B usage after write", used, "<= 8MiB:", used <= 8 * MIB)
+line("B ranges", allocated_ranges(sink))
+assert used <= 8 * MIB
+ranges = allocated_ranges(sink)
+assert ranges and len(ranges) == 1
+assert ranges[0][0] <= 700 * MIB < ranges[0][0] + ranges[0][1]
+assert os.path.getsize(sink) == GIB
+
+# C. occupancy
+two = os.path.join(root, "two.bin")
+preallocate(two, 64 * MIB)
+with open(two, "r+b") as handle:
+    handle.seek(1 * MIB)
+    handle.write(b"a" * 4096)
+    handle.seek(40 * MIB)
+    handle.write(b"b" * 4096)
+    handle.flush()
+    os.fsync(handle.fileno())
+used = disk_usage(two)
+line("C sparse usage", used, "< 1MiB:", used < MIB)
+assert used < MIB
+assert os.path.getsize(two) == 64 * MIB
+
+dense = os.path.join(root, "dense.bin")
+with open(dense, "wb") as handle:
+    chunk = b"x" * MIB
+    for _ in range(64):
+        handle.write(chunk)
+used = disk_usage(dense)
+line("C dense usage", used, "logical", os.path.getsize(dense))
+assert abs(used - 64 * MIB) <= 64 * 1024
+
+asset = os.path.join("assets", "dense_64k.bin")
+line("C asset usage", disk_usage(asset), "logical", os.path.getsize(asset))
+assert disk_usage(asset) >= os.path.getsize(asset)
+
+# D. ranges
+line("D two ranges", allocated_ranges(two))
+rs = allocated_ranges(two)
+assert len(rs) == 2
+previous = -1
+for offset, rlength in rs:
+    assert offset >= 0 and rlength > 0
+    assert offset + rlength <= 64 * MIB
+    assert offset >= previous
+    previous = offset + rlength
+assert allocated_ranges(dense) == [(0, 64 * MIB)]
+
+empty = os.path.join(root, "empty.bin")
+open(empty, "wb").close()
+assert allocated_ranges(empty) == []
+
+hole = os.path.join(root, "hole.bin")
+preallocate(hole, 8 * MIB)
+assert allocated_ranges(hole) == []
+line("D all-hole ok")
+
+# E. sparse flag is not retroactive
+late = os.path.join(root, "late.bin")
+with open(late, "wb") as handle:
+    handle.write(b"q" * (8 * MIB))
+before = disk_usage(late)
+state = sparse_flag(late, True)
+after = disk_usage(late)
+line("E state", state, "before", before, "after", after)
+assert state is True
+assert after >= 8 * MIB
+assert abs(after - before) <= 64 * 1024
+line("E ranges", allocated_ranges(late)[:4])
+
+# F. unsupported classification
+sub = os.path.join(root, "sub")
+os.mkdir(sub)
+for target in (root, sub):
+    for func in (preallocate, disk_usage, allocated_ranges, sparse_state):
+        try:
+            if func is preallocate:
+                func(target, 4096)
+            else:
+                func(target)
+        except WSParseError as exc:
+            assert exc.kind == "unsupported", (func.__name__, exc.kind, exc)
+        else:
+            raise AssertionError("silent success for %s" % func.__name__)
+    try:
+        sparse_flag(target, True)
+    except WSParseError as exc:
+        assert exc.kind == "unsupported", exc.kind
+    else:
+        raise AssertionError("silent success for sparse_flag")
+line("F unsupported ok")
+
+missing = os.path.join(root, "absent.bin")
+for func in (disk_usage, allocated_ranges, sparse_state):
+    try:
+        func(missing)
+    except WSParseError as exc:
+        assert exc.kind == "os", (func.__name__, exc.kind)
+    else:
+        raise AssertionError("no error for %s" % func.__name__)
+try:
+    sparse_flag(missing, True)
+except WSParseError as exc:
+    assert exc.kind == "os", exc.kind
+else:
+    raise AssertionError("no error for sparse_flag")
+line("F missing ok")
+
+for bad in (-1, 1.5, True, "x"):
+    try:
+        preallocate(os.path.join(root, "bad.bin"), bad)
+    except WSParseError as exc:
+        assert exc.kind == "badarg", (bad, exc.kind)
+    else:
+        raise AssertionError("accepted %r" % (bad,))
+line("F badarg ok")
+
+cleared = sparse_flag(two, False)
+line("clear ->", cleared, "usage", disk_usage(two), "ranges", allocated_ranges(two)[:3])
+assert cleared is False
+
+line("ALL OK")
diff --git a/_verify_tmp2.py b/_verify_tmp2.py
new file mode 100644
index 0000000..2c70470
--- /dev/null
+++ b/_verify_tmp2.py
@@ -0,0 +1,31 @@
+import os
+import tempfile
+
+from wsparse import allocated_ranges, disk_usage, preallocate
+
+root = tempfile.mkdtemp(prefix="wsparse-frag-")
+MIB = 1024 * 1024
+
+frag = os.path.join(root, "frag.bin")
+preallocate(frag, 600 * MIB)
+with open(frag, "r+b") as f:
+    for index in range(600):
+        f.seek(index * MIB)
+        f.write(b"f" * 16)
+    f.flush()
+    os.fsync(f.fileno())
+
+ranges = allocated_ranges(frag)
+print("nranges", len(ranges), "first", ranges[:2], "last", ranges[-1:])
+print("usage", disk_usage(frag), "logical", os.path.getsize(frag))
+previous = -1
+for offset, length in ranges:
+    assert length > 0 and offset >= previous and offset + length <= 600 * MIB
+    previous = offset + length
+assert len(ranges) == 600
+with open(frag, "rb") as f:
+    f.seek(599 * MIB)
+    assert f.read(16) == b"f" * 16
+    f.seek(599 * MIB + 4096)
+    assert f.read(4096) == b"\x00" * 4096
+print("FRAG OK")
