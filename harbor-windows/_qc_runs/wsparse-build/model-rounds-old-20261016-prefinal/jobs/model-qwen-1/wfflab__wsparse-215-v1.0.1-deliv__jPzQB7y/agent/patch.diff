 """Thin ctypes bindings for the Win32 calls that :mod:`wsparse` needs.
 
+The bindings are deliberately dumb: they translate arguments, call into
+``kernel32`` and hand the raw results -- including the Win32 error code of a
+failed call -- back to :mod:`wsparse._ntfs`, which is the layer that decides how
+a failure is classified.
+
 Only the calls the current implementation actually uses are bound here. The
 module is written so that importing it on a non-Windows platform stays cheap:
-the DLL is loaded lazily, on first use.
+the DLL is loaded lazily, on first use, and every primitive reports failure
+through a return value instead of raising.
 """
 
+import ctypes
 import os
 
-# FILE_ATTRIBUTE_SPARSE_FILE
