+
+def last_error():
+    """Return the Win32 error code of the most recent call on this thread."""
+    return ctypes.get_last_error()
+
+
+def format_error(code):
+    """Return a human readable description of the Win32 error ``code``."""
+    try:
+        text = ctypes.FormatError(code)
+    except Exception:  # pragma: no cover - non-Windows
+        text = None
+    if not text:
+        return "Win32 error %d" % code
+    return text.rstrip(".")
+
+
+def _reset_error():
+    ctypes.set_last_error(0)
+
+
+# ---------------------------------------------------------------------------
+# Primitives.  Each one returns ``(value, win32_error)``; a non-zero error means
+# the call failed and ``value`` is meaningless.
+# ---------------------------------------------------------------------------
+
+
+def create_file(path, access, creation, share=FILE_SHARE_ALL, flags=0):
+    """Open ``path`` and return ``(handle, win32_error)``."""
+    dll = _kernel32()
+    _reset_error()
+    handle = dll.CreateFileW(
+        path,
+        access,
+        share,
+        None,
+        creation,
+        NORMAL_ATTRIBUTE | flags,
+        None,
+    )
+    if handle is None or handle == INVALID_HANDLE_VALUE:
+        return None, last_error() or ERROR_ACCESS_DENIED
+    return handle, 0
+
+
+def close_handle(handle):
+    """Close ``handle``, ignoring the result."""
+    if handle is None:
+        return
+    try:
+        _kernel32().CloseHandle(handle)
+    except Exception:  # pragma: no cover - defensive
+        pass
+
+
+def device_io_control(handle, code, in_buffer, in_size, out_buffer, out_size):
