+++ b/wsparse/_ntfs.py
@@ -0,0 +1,430 @@
+"""NTFS plumbing shared by the public entry points of :mod:`wsparse`.
+
+Everything in here talks to ``kernel32`` through :mod:`wsparse._winapi` and
+translates Win32 error codes into the :class:`~wsparse.errors.WSParseError`
+taxonomy, so that the public modules stay free of ctypes noise.
+
+Notes on the NTFS semantics this module relies on
+-------------------------------------------------
+
+* A file turns sparse through ``FSCTL_SET_SPARSE``.  From then on the file
+  system allocates clusters only for the ranges that are really written; every
+  other byte reads back as zero and costs nothing on disk.
+* Extending a sparse file with ``SetFileInformationByHandle`` and
+  ``FileEndOfFileInfo`` moves the end of the file without touching the disk.
+  Writing zeros over the tail instead -- what this module used to do -- would
+  allocate every granule it walks over and fill the volume up.
+* ``FSCTL_QUERY_ALLOCATED_RANGES`` is the authoritative answer to "which bytes
+  of this file are backed by clusters".  ``FILE_STANDARD_INFO.AllocationSize``
+  is *not*: it reports 0 for a sparse file even when clusters are allocated.
+* Setting the sparse attribute on a file that has already been extended as a
+  dense file does not hand the clusters back.  The attribute only describes how
+  future holes are treated, which is why occupancy accounting has to keep
+  measuring the file instead of trusting the flag.
+"""
+
+import ctypes
+import os
+
+from . import _winapi as w32
+from .errors import WSParseError
+
+#: Win32 codes that mean "this object/volume cannot do sparse files at all".
+_UNSUPPORTED_FSCTL_CODES = frozenset(
+    [
+        w32.ERROR_INVALID_FUNCTION,
+        w32.ERROR_INVALID_DEVICE_REQUEST,
+        w32.ERROR_NOT_SUPPORTED,
+        w32.ERROR_INVALID_PARAMETER,
+        w32.ERROR_CALL_NOT_IMPLEMENTED,
+    ]
+)
+
+#: Win32 codes that mean the same thing for plain file operations.
+_UNSUPPORTED_FILE_CODES = frozenset(
+    [
+        w32.ERROR_INVALID_FUNCTION,
+        w32.ERROR_NOT_SUPPORTED,
+        w32.ERROR_CALL_NOT_IMPLEMENTED,
+    ]
+)
+
+#: Codes that always describe the operating system, never a missing feature.
+_OS_CODES = frozenset(
+    [
+        w32.ERROR_FILE_NOT_FOUND,
+        w32.ERROR_PATH_NOT_FOUND,
+        w32.ERROR_ACCESS_DENIED,
+        w32.ERROR_INVALID_DRIVE,
+        w32.ERROR_NOT_READY,
+        w32.ERROR_SHARING_VIOLATION,
+        w32.ERROR_DIR_NOT_EMPTY,
+        w32.ERROR_BAD_PATHNAME,
+    ]
+)
+
+#: ``FILE_SUPPORTS_SPARSE_FILES`` in the flags returned by ``GetVolumeInformation``.
+FILE_SUPPORTS_SPARSE_FILES = 0x00000040
+#: ``FILE_ATTRIBUTE_DEVICE``.
+DEVICE_ATTRIBUTE = 0x00000040
+
+#: cluster size of a volume root, memoised per root
+_cluster_cache = {}
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+
+
+def fspath(path):
+    """Return ``path`` as a string, classifying unusable arguments."""
+    try:
+        return os.fspath(path)
+    except TypeError as exc:
+        raise WSParseError(
+            "path must be a string or os.PathLike, got %r" % (path,), kind="badarg"
+        ) from exc
+
+
+def require_windows(path, action):
+    """Raise ``unsupported`` when the platform cannot provide NTFS semantics."""
+    if not w32.is_windows():
+        raise WSParseError(
+            "%s needs the Windows file-system API" % action,
+            kind="unsupported",
+            path=path,
+        )
+
+
+def _is_directory(path):
+    attrs, _err = w32.get_file_attributes(path)
+    return attrs is not None and bool(attrs & w32.DIRECTORY_ATTRIBUTE)
+
+
+def error(code, path, action, codes=_UNSUPPORTED_FILE_CODES, extra=None):
+    """Build the :class:`WSParseError` that describes the Win32 error ``code``."""
+    detail = w32.format_error(code)
+    message = "%s failed: %s (Win32 error %d)" % (action, detail, code)
+    if extra:
+        message = "%s (%s)" % (message, extra)
+    if code in _OS_CODES:
+        kind = "os"
+    elif code in codes or extra:
+        kind = "unsupported"
+    else:
+        kind = "os"
+    return WSParseError(message, kind=kind, path=path)
+
+
+def volume_supports_sparse(path):
+    """Return ``True``/``False`` when the volume of ``path`` says so clearly.
+
+    ``None`` means the volume could not be interrogated, which the callers treat
+    as "do not claim anything".
+    """
+    root, err = w32.get_volume_path_name(path)
+    if root is None:
+        return None
+    _name, flags, err = w32.get_volume_information(root)
+    if err and not flags:
+        return None
+    return bool(flags & FILE_SUPPORTS_SPARSE_FILES)
+
+
+def attributes(path, action=None):
+    """Return the raw file attributes of ``path``.
+
+    A missing path is reported as an ``"os"`` failure, which keeps
+    ``disk_usage("/absent")`` in the same class as a failed ``open()``.
+    """
+    attrs, err = w32.get_file_attributes(path)
+    if attrs is not None:
+        return attrs
+    if err in (w32.ERROR_FILE_NOT_FOUND, w32.ERROR_PATH_NOT_FOUND):
+        raise WSParseError(
+            "no such file or directory: %s" % path, kind="os", path=path
+        )
+    raise error(err, path, action or "GetFileAttributes")
+
+
+def require_file_object(path, action, attrs=None):
+    """Raise ``unsupported`` when ``path`` cannot hold a sink file.
+
+    Directories and device objects have no sparse layout, no allocated ranges
+    and no meaningful occupancy; asking for any of those is a caller mistake
+    that retrying will never fix.
+    """
+    if attrs is None:
+        attrs = attributes(path, action)
+    if attrs & w32.DIRECTORY_ATTRIBUTE:
+        raise WSParseError(
+            "%s: %r is a directory and directories have no sparse layout"
+            % (action, path),
+            kind="unsupported",
+            path=path,
+        )
+    if attrs & DEVICE_ATTRIBUTE:
+        raise WSParseError(
+            "%s: %r is a device object and device objects have no sparse layout"
+            % (action, path),
+            kind="unsupported",
+            path=path,
+        )
+    return attrs
+
+
+class Handle(object):
+    """A Win32 file handle that closes itself.
+
+    ``Handle.winerror`` keeps the code of the failed ``CreateFileW`` around so
+    that :attr:`Handle.failure` can classify it.
+    """
+
+    __slots__ = ("value", "winerror", "path")
+
+    def __init__(self, value, winerror, path):
+        self.value = value
+        self.winerror = winerror
+        self.path = path
+
+    def __bool__(self):
+        return self.value is not None
+
+    __nonzero__ = __bool__
+
+    def __enter__(self):
+        if self.value is None:
+            raise self.failure
+        return self
+
+    def __exit__(self, *_exc_info):
+        self.close()
+        return False
+
+    def close(self):
+        if self.value is not None:
+            w32.close_handle(self.value)
+            self.value = None
+
+    @property
+    def failure(self):
+        """The classified error of the ``CreateFileW`` that produced this."""
+        code = self.winerror or w32.ERROR_ACCESS_DENIED
+        if code in (w32.ERROR_FILE_NOT_FOUND, w32.ERROR_PATH_NOT_FOUND):
+            return WSParseError(
+                "no such file or directory: %s" % self.path,
+                kind="os",
+                path=self.path,
+            )
+        if code == w32.ERROR_ACCESS_DENIED and _is_directory(self.path):
+            return WSParseError(
+                "not a file: %r is a directory" % self.path,
+                kind="unsupported",
+                path=self.path,
+            )
+        return error(code, self.path, "CreateFile")
+
+
+def open_file(path, access, creation, action, share=w32.FILE_SHARE_ALL):
+    """Open ``path`` or raise the classified :class:`WSParseError`."""
+    require_windows(path, action)
+    value, winerror = w32.create_file(path, access, creation, share)
+    handle = Handle(value, winerror, path)
+    if value is None:
+        raise handle.failure
+    return handle
+
+
+def open_for_metadata(path, action):
+    """Open ``path`` read-only for querying; falls back to a metadata handle."""
+    handle = open_file(
+        path,
+        w32.GENERIC_READ,
+        w32.OPEN_EXISTING,
+        action,
+    )
+    if handle.can_query_ranges():
+        return handle
+    handle.close()
+    return handle
+
+
+# ---------------------------------------------------------------------------
+# metadata of an open file
+# ---------------------------------------------------------------------------
+
+
+def standard_info(handle, path):
+    """Return ``(allocation_size, end_of_file, is_directory)`` for ``handle``."""
+    info = w32.FILE_STANDARD_INFO()
+    err = w32.get_file_info(handle.value, w32.FileStandardInfo, info)
+    if err:
+        raise error(err, path, "GetFileInformationByHandleEx(FileStandardInfo)")
+    return int(info.AllocationSize), int(info.EndOfFile), bool(info.Directory)
+
+
+def compression_info(handle, path):
+    """Return the compressed on-disk size of a file, or ``None``."""
+    info = w32.FILE_COMPRESSION_INFO()
+    err = w32.get_file_info(handle.value, w32.FileCompressionInfo, info)
+    if err:
+        return None
+    if info.CompressedFileSize < 0:
+        return None
+    return int(info.CompressedFileSize)
+
+
+def basic_info(handle, path):
+    """Return the file attributes as seen through ``handle``."""
+    info = w32.FILE_BASIC_INFO()
+    err = w32.get_file_info(handle.value, w32.FileBasicInfo, info)
+    if err:
+        raise error(err, path, "GetFileInformationByHandleEx(FileBasicInfo)")
+    return int(info.FileAttributes)
+
+
+# ---------------------------------------------------------------------------
+# sparse operations
+# ---------------------------------------------------------------------------
+
+
+def set_sparse(handle, path, enabled):
+    """Set or clear the sparse attribute of an open file."""
+    err = w32.set_sparse(handle.value, enabled)
+    if err:
+        action = "FSCTL_SET_SPARSE(%s)" % ("on" if enabled else "off")
+        raise error(
+            err,
+            path,
+            action,
+            codes=_UNSUPPORTED_FSCTL_CODES,
+            extra=_sparse_hint(path, err),
+        )
+
+
+def _sparse_hint(path, code):
+    """Describe why the volume refused a sparse operation, when it can say."""
+    del code  # the code is already part of the message
+    if volume_supports_sparse(path) is False:
+        return "the volume of %r does not support sparse files" % path
+    return None
+
+
+def set_end_of_file(handle, path, size):
+    """Move the end of the file to ``size`` without allocating anything."""
+    err = w32.set_end_of_file(handle.value, size)
+    if err:
+        raise error(err, path, "SetFileInformationByHandle(FileEndOfFileInfo)")
+
+
+def query_allocated_ranges(handle, path, limit=None):
+    """Return ``[(offset, length), ...]`` of the cluster-backed byte ranges.
+
+    ``limit`` -- normally the end of the file -- keeps the answer inside the
+    logical length.  The FSCTL fills at most one buffer per call and reports
+    ``ERROR_MORE_DATA`` when there is more to tell, so the enumeration runs
+    until it comes back with less than a buffer full.
+    """
+    entries = 64
+    buffer = (w32.FILE_ALLOCATED_RANGE_BUFFER * entries)()
+    buffer_size = ctypes.sizeof(buffer)
+    entry_size = ctypes.sizeof(w32.FILE_ALLOCATED_RANGE_BUFFER)
+    collected = []
+    start = 0
+    while True:
+        if limit is not None:
+            if start >= limit:
+                break
+            length = limit - start
+        else:
+            length = w32.MAX_LONGLONG - start
+        query = w32.FILE_ALLOCATED_RANGE_BUFFER(start, length)
+        returned, err = w32.device_io_control(
+            handle.value,
+            w32.FSCTL_QUERY_ALLOCATED_RANGES,
+            ctypes.byref(query),
+            ctypes.sizeof(query),
+            ctypes.addressof(buffer),
+            buffer_size,
+        )
+        count = returned // entry_size
+        for index in range(count):
+            collected.append(
+                (int(buffer[index].FileOffset), int(buffer[index].Length))
+            )
+        if err:
+            if err == w32.ERROR_MORE_DATA and count:
+                pass  # a full buffer: keep enumerating from where we stopped
+            else:
+                raise error(
+                    err,
+                    path,
+                    "FSCTL_QUERY_ALLOCATED_RANGES",
+                    codes=_UNSUPPORTED_FSCTL_CODES,
+                )
+        if count < entries:
+            break
+        next_start = collected[-1][0] + collected[-1][1]
+        if next_start <= start:
+            break
+        start = next_start
+    return collected
+
+
+def allocated_range_sum(ranges):
+    """Total number of bytes covered by ``ranges``."""
+    return sum(length for _offset, length in ranges)
+
+
+# ---------------------------------------------------------------------------
+# volume geometry
+# ---------------------------------------------------------------------------
+
+
+def cluster_size(path):
+    """Return the cluster size in bytes of the volume ``path`` lives on."""
+    root, err = w32.get_volume_path_name(path)
+    if root is None:
+        return w32.DEFAULT_CLUSTER_SIZE
+    cached = _cluster_cache.get(root)
+    if cached:
+        return cached
+    size, err = w32.get_cluster_size(root)
+    if not size:
+        size = w32.DEFAULT_CLUSTER_SIZE
+    _cluster_cache[root] = size
+    return size
+
+
+def align_up(value, unit):
+    """Round ``value`` up to a whole number of ``unit`` bytes."""
+    if value <= 0:
+        return 0
+    if unit <= 1:
+        return int(value)
+    return ((value + unit - 1) // unit) * unit
+
+
+def normalize_ranges(ranges, limit=None):
+    """Sort ``ranges``, trim them to ``limit``, drop empties, merge neighbours."""
+    cleaned = []
+    for offset, length in ranges:
+        if offset < 0 or length <= 0:
+            continue
+        end = offset + length
+        if limit is not None:
+            if offset >= limit:
+                continue
+            end = min(end, limit)
+        if end <= offset:
+            continue
+        cleaned.append((offset, end))
+    cleaned.sort()
+    merged = []
+    for offset, end in cleaned:
+        if merged and offset <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((offset, end))
+    return [(offset, end - offset) for offset, end in merged]
