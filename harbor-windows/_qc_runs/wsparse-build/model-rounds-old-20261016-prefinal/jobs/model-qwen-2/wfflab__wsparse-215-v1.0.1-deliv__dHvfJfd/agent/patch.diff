diff --git a/_tmp_probe.py b/_tmp_probe.py
new file mode 100644
index 0000000..cffc86c
--- /dev/null
+++ b/_tmp_probe.py
@@ -0,0 +1,133 @@
+import ctypes, os, sys, tempfile
+sys.path.insert(0, r"C:\testbed")
+from wsparse import _winapi
+
+QUERY_NEITHER = (9 << 16) | (1 << 14) | (51 << 2) | 3
+
+root = tempfile.mkdtemp(prefix="probe2_")
+print("root", root)
+k32 = _winapi.kernel32()
+
+
+def volinfo(path):
+    name = ctypes.create_unicode_buffer(256)
+    fsname = ctypes.create_unicode_buffer(256)
+    serial = ctypes.c_uint(0)
+    maxlen = ctypes.c_uint(0)
+    flags = ctypes.c_uint(0)
+    ok = k32.GetVolumeInformationW(path, name, 256, ctypes.byref(serial), ctypes.byref(maxlen),
+                                   ctypes.byref(flags), fsname, 256)
+    print("vol", path, "ok", ok, "err", _winapi.get_last_error(), repr(name.value),
+          repr(fsname.value), "flags", hex(flags.value), "sparse?", bool(flags.value & 0x400))
+
+
+volinfo(os.path.splitdrive(root)[0] + os.sep)
+
+
+class StdInfo(ctypes.Structure):
+    _fields_ = [("AllocationSize", ctypes.c_longlong), ("EndOfFile", ctypes.c_longlong),
+                ("NumberOfLinks", ctypes.c_uint), ("DeletePending", ctypes.c_ubyte),
+                ("Directory", ctypes.c_ubyte)]
+
+
+def standard_info(path):
+    h = _winapi.open_file(path, 0, creation=_winapi.OPEN_EXISTING,
+                          flags=_winapi.FILE_FLAG_BACKUP_SEMANTICS)
+    try:
+        si = StdInfo()
+        k32.GetFileInformationByHandleEx.restype = ctypes.c_int
+        k32.GetFileInformationByHandleEx.argtypes = [ctypes.c_void_p, ctypes.c_int,
+                                                     ctypes.c_void_p, ctypes.c_uint]
+        ok = k32.GetFileInformationByHandleEx(h, 1, ctypes.byref(si), ctypes.sizeof(si))
+        if not ok:
+            return None
+        return si.AllocationSize, si.EndOfFile
+    finally:
+        _winapi.close_handle(h)
+
+
+def query(path, size):
+    h = _winapi.open_file(path, _winapi.GENERIC_READ, creation=_winapi.OPEN_EXISTING,
+                          flags=_winapi.FILE_FLAG_BACKUP_SEMANTICS)
+    try:
+        req = _winapi._AllocatedRangeBuffer()
+        req.FileOffset = 0
+        req.Length = size
+        out = (ctypes.c_byte * 8192)()
+        ret = ctypes.c_uint(0)
+        ok = k32.DeviceIoControl(h, QUERY_NEITHER, ctypes.byref(req), ctypes.sizeof(req),
+                                 ctypes.byref(out), 8192, ctypes.byref(ret), None)
+        if not ok:
+            return ("err", _winapi.get_last_error())
+        n = ret.value // ctypes.sizeof(req)
+        return [(i.FileOffset, i.Length) for i in
+                (_winapi._AllocatedRangeBuffer * n).from_buffer(out)]
+    finally:
+        _winapi.close_handle(h)
+
+
+# ---- dense file
+d = os.path.join(root, "dense.bin")
+with open(d, "wb") as fh:
+    fh.write(b"q" * 100000)
+print("dense size", os.path.getsize(d), "compressed", _winapi.get_allocation_size(d),
+      "std", standard_info(d), "attrs", hex(_winapi.get_file_attributes(d)))
+
+# ---- sparse file, python write
+s1 = os.path.join(root, "sparse1.bin")
+_winapi.set_end_of_file  # noqa
+h = _winapi.open_file(s1, _winapi.GENERIC_READ | _winapi.GENERIC_WRITE,
+                      creation=_winapi.OPEN_ALWAYS, flags=0)
+_winapi.set_sparse(h)
+_winapi.set_end_of_file(h, 1 << 24)
+_winapi.close_handle(h)
+with open(s1, "r+b") as fh:
+    fh.seek(1 << 20)
+    fh.write(b"x" * 4096)
+print("sparse1 size", os.path.getsize(s1), "compressed", _winapi.get_allocation_size(s1),
+      "std", standard_info(s1), "ranges", query(s1, 1 << 24))
+
+# ---- sparse file, win32 write
+s2 = os.path.join(root, "sparse2.bin")
+h = _winapi.open_file(s2, _winapi.GENERIC_READ | _winapi.GENERIC_WRITE,
+                      creation=_winapi.OPEN_ALWAYS, flags=0)
+_winapi.set_sparse(h)
+_winapi.set_end_of_file(h, 1 << 24)
+_winapi.close_handle(h)
+k32.SetFilePointerEx.restype = ctypes.c_int
+k32.SetFilePointerEx.argtypes = [ctypes.c_void_p, ctypes.c_longlong,
+                                 ctypes.POINTER(ctypes.c_longlong), ctypes.c_uint]
+k32.WriteFile.restype = ctypes.c_int
+k32.WriteFile.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint,
+                          ctypes.POINTER(ctypes.c_uint), ctypes.c_void_p]
+hw = _winapi.open_file(s2, _winapi.GENERIC_WRITE, creation=_winapi.OPEN_EXISTING, flags=0)
+pos = ctypes.c_longlong(0)
+k32.SetFilePointerEx(hw, 1 << 20, ctypes.byref(pos), 0)
+written = ctypes.c_uint(0)
+k32.WriteFile(hw, b"z" * 4096, 4096, ctypes.byref(written), None)
+k32.FlushFileBuffers(hw)
+_winapi.close_handle(hw)
+print("sparse2 size", os.path.getsize(s2), "compressed", _winapi.get_allocation_size(s2),
+      "std", standard_info(s2), "ranges", query(s2, 1 << 24))
+
+# ---- all-hole sparse
+s3 = os.path.join(root, "hole.bin")
+h = _winapi.open_file(s3, _winapi.GENERIC_READ | _winapi.GENERIC_WRITE,
+                      creation=_winapi.OPEN_ALWAYS, flags=0)
+_winapi.set_sparse(h)
+_winapi.set_end_of_file(h, 1 << 24)
+_winapi.close_handle(h)
+print("hole size", os.path.getsize(s3), "compressed", _winapi.get_allocation_size(s3),
+      "std", standard_info(s3), "ranges", query(s3, 1 << 24))
+
+# ---- python truncate-based sparse
+s4 = os.path.join(root, "truncate.bin")
+with open(s4, "wb") as fh:
+    fh.truncate(1 << 24)
+print("truncate size", os.path.getsize(s4), "compressed", _winapi.get_allocation_size(s4),
+      "std", standard_info(s4), "attrs", hex(_winapi.get_file_attributes(s4)),
+      "ranges", query(s4, 1 << 24))
+
+for f in (d, s1, s2, s3, s4):
+    os.remove(f)
+os.rmdir(root)
diff --git a/_tmp_wspcheck.py b/_tmp_wspcheck.py
new file mode 100644
index 0000000..881508b
--- /dev/null
+++ b/_tmp_wspcheck.py
@@ -0,0 +1,242 @@
+import os, shutil, sys, tempfile, time, pathlib
+
+sys.path.insert(0, r"C:\testbed")
+
+from wsparse import (
+    WSParseError,
+    allocated_ranges,
+    disk_usage,
+    preallocate,
+    sparse_flag,
+    sparse_state,
+)
+
+root = tempfile.mkdtemp(prefix="wspcheck_")
+print("scratch:", root)
+
+results = []
+
+def report(name, ok, extra=""):
+    print(("PASS " if ok else "FAIL ") + name + (" | " + extra if extra else ""))
+    results.append(bool(ok))
+
+# A. sparse preallocate 1 GiB
+gi = 1 << 30
+p = os.path.join(root, "big.bin")
+t0 = time.time()
+length = preallocate(p, gi)
+dt = time.time() - t0
+size = os.path.getsize(p)
+used = disk_usage(p)
+ranges = allocated_ranges(p)
+report("A length == 1GiB", size == gi and length == gi, "size=%d len=%d" % (size, length))
+report("A sparse flag set", sparse_state(p) is True)
+report("A disk_usage <= 8MiB", used <= (8 << 20), "used=%d (%.3f MiB)" % (used, used / 1048576.0))
+report("A fast (<2s)", dt < 2.0, "dt=%.3f" % dt)
+report("A allocated_ranges empty", ranges == [], repr(ranges))
+
+preallocate(p, gi)
+preallocate(p, gi)
+report("A idempotent size", os.path.getsize(p) == gi)
+report("A idempotent usage", disk_usage(p) <= (8 << 20), "used=%d" % disk_usage(p))
+report("A idempotent sparse", sparse_state(p))
+
+with open(p, "rb") as fh:
+    fh.seek(1 << 20)
+    chunk = fh.read(1 << 20)
+report("B hole reads zeros", chunk == b"\x00" * len(chunk))
+
+payload = b"collector-payload" * 40
+with open(p, "r+b") as fh:
+    fh.seek(1024)
+    fh.write(payload)
+with open(p, "rb") as fh:
+    fh.seek(1024)
+    back = fh.read(len(payload))
+report("B write read back", back == payload)
+used2 = disk_usage(p)
+report("B usage only for written cluster", used2 < (64 << 10), "used=%d" % used2)
+r2 = allocated_ranges(p)
+report("B ranges == one cluster around 1024",
+       len(r2) == 1 and r2[0][0] <= 1024 < r2[0][0] + r2[0][1], repr(r2))
+
+with open(p, "r+b") as fh:
+    fh.seek(1 << 28)
+    fh.write(b"second-region")
+r3 = allocated_ranges(p)
+used3 = disk_usage(p)
+report("B two ranges", len(r3) == 2, repr(r3))
+report("B usage still small", used3 < (64 << 10), "used=%d" % used3)
+report("B length unchanged", os.path.getsize(p) == gi)
+os.remove(p)
+
+# C
+mi = 1 << 20
+p2 = os.path.join(root, "sparse64.bin")
+preallocate(p2, 64 * mi)
+with open(p2, "r+b") as fh:
+    fh.seek(3 * mi)
+    fh.write(b"A" * 100)
+    fh.seek(40 * mi)
+    fh.write(b"B" * 4096)
+u = disk_usage(p2)
+report("C sparse64 usage < 1MiB", u < mi, "used=%d" % u)
+rr = allocated_ranges(p2)
+report("C sparse64 ranges", len(rr) == 2, repr(rr))
+tot = sum(l for _, l in rr)
+report("C ranges sum == usage", tot == u, "sum=%d used=%d" % (tot, u))
+report("C cluster aligned", u % 4096 == 0, "used=%d" % u)
+report("C ranges inside file",
+       all(o >= 0 and l > 0 and o + l <= os.path.getsize(p2) for o, l in rr))
+report("C ranges ordered/disjoint",
+       all(rr[i][0] + rr[i][1] <= rr[i + 1][0] for i in range(len(rr) - 1)))
+
+p3 = os.path.join(root, "dense64.bin")
+with open(p3, "wb") as fh:
+    block = b"D" * mi
+    for _ in range(64):
+        fh.write(block)
+ud = disk_usage(p3)
+report("C dense64 usage == 64MiB", ud == 64 * mi, "used=%d" % ud)
+rd = allocated_ranges(p3)
+report("D dense ranges == [(0, size)]", rd == [(0, 64 * mi)], repr(rd))
+report("D dense not sparse flag", sparse_state(p3) is False)
+
+asset = r"C:\testbed\assets\dense_64k.bin"
+if os.path.exists(asset):
+    ra = allocated_ranges(asset)
+    ua = disk_usage(asset)
+    sz = os.path.getsize(asset)
+    report("D asset ranges full", ra == [(0, sz)], "%r size=%d" % (ra, sz))
+    report("C asset usage >= size", ua >= sz, "used=%d size=%d" % (ua, sz))
+
+p4 = os.path.join(root, "allhole.bin")
+preallocate(p4, 4 * mi)
+report("D all-hole ranges []", allocated_ranges(p4) == [], repr(allocated_ranges(p4)))
+report("D all-hole usage 0", disk_usage(p4) == 0, "used=%d" % disk_usage(p4))
+
+p5 = os.path.join(root, "empty.bin")
+open(p5, "wb").close()
+report("D empty ranges []", allocated_ranges(p5) == [])
+report("C empty usage 0", disk_usage(p5) == 0, "used=%d" % disk_usage(p5))
+
+# E
+p6 = os.path.join(root, "dense_then_sparse.bin")
+with open(p6, "wb") as fh:
+    fh.write(b"Z" * (8 * mi))
+before = disk_usage(p6)
+sparse_flag(p6, True)
+after = disk_usage(p6)
+report("E dense stays charged after sparse_flag", after == before == 8 * mi,
+       "before=%d after=%d" % (before, after))
+report("E state true after flag", sparse_state(p6) is True)
+re_after = allocated_ranges(p6)
+report("E ranges still full", re_after == [(0, 8 * mi)], repr(re_after))
+# punch_hole does free
+from wsparse.alloc import punch_hole
+punch_hole(p6, 0, 4 * mi)
+report("E punch_hole frees space", disk_usage(p6) == 4 * mi, "used=%d" % disk_usage(p6))
+report("E punch_hole ranges", allocated_ranges(p6) == [(4 * mi, 4 * mi)], repr(allocated_ranges(p6)))
+with open(p6, "rb") as fh:
+    head = fh.read(16)
+report("E punched region reads zeros", head == b"\x00" * 16, repr(head))
+
+# F
+d = os.path.join(root, "adir")
+os.mkdir(d)
+for fn, name in ((preallocate, "preallocate"), (disk_usage, "disk_usage"),
+                 (allocated_ranges, "allocated_ranges"), (sparse_flag, "sparse_flag"),
+                 (sparse_state, "sparse_state")):
+    try:
+        if fn is preallocate:
+            fn(d, 4096)
+        elif fn is sparse_flag:
+            fn(d, True)
+        else:
+            fn(d)
+    except WSParseError as exc:
+        report("F %s(dir) -> unsupported" % name, exc.kind == "unsupported",
+               "kind=%s msg=%s" % (exc.kind, exc))
+    except Exception as exc:
+        report("F %s(dir) -> WSParseError" % name, False, "got %r" % (exc,))
+    else:
+        report("F %s(dir) raised" % name, False, "no exception")
+
+mp = os.path.join(root, "nope.bin")
+for fn, name in ((disk_usage, "disk_usage"), (allocated_ranges, "allocated_ranges"),
+                 (sparse_flag, "sparse_flag"), (sparse_state, "sparse_state")):
+    try:
+        fn(mp)
+    except WSParseError as exc:
+        report("F %s(missing) -> os" % name, exc.kind == "os", "kind=%s" % exc.kind)
+    except Exception as exc:
+        report("F %s(missing) -> WSParseError" % name, False, repr(exc))
+    else:
+        report("F %s(missing) raised" % name, False, "no exception")
+
+for bad in (-1, 1.5, "x", True, None):
+    try:
+        preallocate(os.path.join(root, "bad.bin"), bad)
+    except WSParseError as exc:
+        report("G badarg %r" % (bad,), exc.kind == "badarg", "kind=%s" % exc.kind)
+    except Exception as exc:
+        report("G badarg %r" % (bad,), False, repr(exc))
+
+p7 = os.path.join(root, "keep.bin")
+with open(p7, "wb") as fh:
+    fh.write(b"payload")
+preallocate(p7, 4 * mi)
+preallocate(p7, 16)
+with open(p7, "rb") as fh:
+    head7 = fh.read(7)
+report("G never shrinks", os.path.getsize(p7) == 4 * mi and head7 == b"payload",
+       "size=%d head=%r" % (os.path.getsize(p7), head7))
+zp = os.path.join(root, "zero.bin")
+report("G preallocate size 0 ok", preallocate(zp, 0) == 0)
+report("G zero file ranges []", allocated_ranges(zp) == [])
+report("G zero file usage 0", disk_usage(zp) == 0)
+
+pl = pathlib.Path(root) / "pathlike.bin"
+preallocate(pl, 2 * mi)
+report("G PathLike works", os.path.getsize(str(pl)) == 2 * mi)
+report("G PathLike usage", disk_usage(pl) == 0, "used=%d" % disk_usage(pl))
+
+p8 = os.path.join(root, "clear.bin")
+preallocate(p8, 2 * mi)
+with open(p8, "r+b") as fh:
+    fh.seek(4096)
+    fh.write(b"q" * 4096)
+res = sparse_flag(p8, False)
+report("G clear sparse returns False", res is False, repr(res))
+report("G clear sparse keeps size", os.path.getsize(p8) == 2 * mi)
+report("G clear sparse state", sparse_state(p8) is False)
+
+p9 = os.path.join(root, "shared.bin")
+preallocate(p9, 16 * mi)
+fh = open(p9, "r+b")
+fh.seek(2 * mi)
+fh.write(b"s" * 8192)
+fh.flush()
+report("G shared handle usage", disk_usage(p9) < (64 << 10), "used=%d" % disk_usage(p9))
+report("G shared handle ranges", len(allocated_ranges(p9)) == 1, repr(allocated_ranges(p9)))
+fh.close()
+
+# reparse point
+link = os.path.join(root, "alink")
+try:
+    os.symlink(p9, link)
+    try:
+        disk_usage(link)
+    except WSParseError as exc:
+        report("F symlink -> unsupported", exc.kind == "unsupported", "kind=%s" % exc.kind)
+    except Exception as exc:
+        report("F symlink -> WSParseError", False, repr(exc))
+    else:
+        report("F symlink raised", False, "no exception (returned %r)" % (disk_usage(link),))
+except OSError as exc:
+    print("SKIP symlink:", exc)
+
+print()
+print("total %d, failures %d" % (len(results), results.count(False)))
+shutil.rmtree(root, ignore_errors=True)
+sys.exit(1 if False in results else 0)
