+"""Path handling and error classification shared by the :mod:`wsparse` modules.
+
+Every entry point of the public API accepts "a path", which on Windows may be
+a plain file, a directory, a reparse point, a volume root, or a path that does
+not exist at all.  The acceptance rules of the module are strict about what
+has to happen in each of those cases:
+
+* a missing path is an ``"os"`` failure -- the caller can fix it by creating
+  the file,
+* an object that can never hold a sparse file (a directory, a reparse point, a
+  volume root, a device, a file on a volume without sparse support) is an
+  ``"unsupported"`` failure,
+* anything else the kernel refuses is an ``"os"`` failure.
+
+This module turns the raw Win32 error codes into those classes so that the
+public functions stay readable.
+"""
+
+import os
+
+from . import _winapi
+from ._winapi import (
+    DIRECTORY_ATTRIBUTE,
+    ERROR_ALREADY_ASSIGNED,
+    ERROR_BAD_DEVICE_TYPE,
+    ERROR_BAD_NET_NAME,
+    ERROR_BAD_NETPATH,
+    ERROR_BAD_PATHNAME,
+    ERROR_DIRECTORY,
+    ERROR_FILE_NOT_FOUND,
+    ERROR_PATH_NOT_FOUND,
+    ERROR_UNRECOGNIZED_VOLUME,
+    REPARSE_POINT_ATTRIBUTE,
+    SPARSE_ATTRIBUTE,
+    UNSUPPORTED_ERRORS,
+    UnsupportedOperation,
+)
+from .errors import WSParseError
+
+#: Win32 codes that mean "the path you gave me does not resolve to anything".
+_MISSING_ERRORS = frozenset((ERROR_FILE_NOT_FOUND, ERROR_PATH_NOT_FOUND, ERROR_BAD_PATHNAME))
+
+#: Extra codes that mean "this object can never be a sparse file".
+_NOT_A_SPARSE_FILE_ERRORS = frozenset(
+    (
+        ERROR_DIRECTORY,
+        ERROR_BAD_DEVICE_TYPE,
+        ERROR_BAD_NET_NAME,
+        ERROR_BAD_NETPATH,
+        ERROR_UNRECOGNIZED_VOLUME,
+        ERROR_ALREADY_ASSIGNED,
+    )
+)
+
+#: Default NTFS allocation unit, used when the volume cannot be asked.
+DEFAULT_CLUSTER_SIZE = 4096
+
+__all__ = [
+    "DEFAULT_CLUSTER_SIZE",
+    "normalize",
+    "is_windows_or_raise",
+    "missing",
+    "not_a_sparse_file",
+    "volume_supports_sparse",
+    "translate",
+    "fail",
+    "open_stream",
+    "file_length",
+    "cluster_size",
+    "round_up",
+    "sparse_attribute_state",
+]
+
+
+def normalize(path):
+    """Return ``path`` as a string, rejecting unusable arguments."""
+    if path is None:
+        raise WSParseError("path must not be None", kind="badarg")
+    if isinstance(path, bytes):
+        try:
+            return os.fsdecode(path)
+        except Exception:
+            raise WSParseError("path must be decodable bytes, got %r" % (path,), kind="badarg")
+    try:
+        return os.fspath(path)
+    except TypeError:
+        raise WSParseError(
+            "path must be a string or os.PathLike, got %r" % (path,), kind="badarg"
+        )
+
+
+def is_windows_or_raise(path, what):
+    """Guard for the Win32 calls: only a Windows volume has sparse files."""
+    if _winapi.is_windows():
+        return
+    raise WSParseError(
+        "%s requires a Windows file system; this platform does not have one" % (what,),
+        kind="unsupported",
+        path=path,
+    )
+
+
+def _attributes(path):
+    """Attribute word of ``path``, or ``None`` when it cannot be read."""
+    if _winapi.is_windows():
+        try:
+            return _winapi.get_file_attributes(path)
+        except OSError:
+            pass
+    try:
+        return int(getattr(os.stat(path), "st_file_attributes", 0) or 0)
+    except Exception:
+        return None
+
+
+def missing(path):
+    """``True`` when ``path`` does not resolve to anything on the volume."""
+    return _attributes(path) is None
+
+
+def not_a_sparse_file(path):
+    """``True`` when ``path`` exists but can never carry a sparse attribute.
+
+    Directories, volume roots, reparse points and device objects all fall in
+    here: they are addressable, but ``FSCTL_SET_SPARSE`` and its friends are
+    meaningless on them.
+    """
+    attrs = _attributes(path)
+    if attrs is None:
+        return False
+    if attrs & (DIRECTORY_ATTRIBUTE | REPARSE_POINT_ATTRIBUTE):
+        return True
+    text = str(path).rstrip("\\/")
+    if not text or text.endswith(":"):
+        # "C:\" / "C:" is a volume root, "\\server\share" is a share root.
+        return True
+    return False
+
+
+def volume_supports_sparse(path):
+    """``True`` when the volume holding ``path`` advertises sparse files."""
+    if not _winapi.is_windows():
+        return False
+    return _winapi.get_volume_sparse_support(path)
+
+
+def sparse_attribute_state(path):
+    """``True`` when ``path`` currently carries ``FILE_ATTRIBUTE_SPARSE_FILE``."""
+    attrs = _attributes(path)
+    return bool(attrs & SPARSE_ATTRIBUTE) if attrs is not None else False
+
+
+def _winerror_of(exc):
+    code = getattr(exc, "winerror", None)
+    if code is None:
+        args = getattr(exc, "args", ())
+        if len(args) >= 4 and isinstance(args[3], int):
+            code = args[3]
+    return code if isinstance(code, int) and code else None
+
+
+def translate(exc, path, what):
+    """Classify a kernel failure as a :class:`WSParseError`."""
+    if isinstance(exc, WSParseError):
+        return exc
+
+    code = _winerror_of(exc)
+    if code is not None:
+        if code in UNSUPPORTED_ERRORS or code in _NOT_A_SPARSE_FILE_ERRORS:
+            return WSParseError(
+                "%s is not supported on %r (Win32 error %d)" % (what, path, code),
+                kind="unsupported",
+                path=path,
+            )
+        if code in _MISSING_ERRORS:
+            return WSParseError("no such file: %s" % (path,), kind="os", path=path)
+        return WSParseError(
+            "%s failed (%s)" % (what, _winapi.winerror_message(code)), kind="os", path=path
+        )
+
+    # No Win32 code to go on: classify by the shape of the object itself.
+    if not_a_sparse_file(path):
+        return WSParseError(
+            "%s is not supported on %r" % (what, path), kind="unsupported", path=path
+        )
+    if missing(path):
+        return WSParseError("no such file: %s" % (path,), kind="os", path=path)
+    return WSParseError("%s failed (%s)" % (what, exc), kind="os", path=path)
+
+
+def fail(exc, path, what):
+    """``raise translate(exc, path, what)`` -- never returns."""
+    raise translate(exc, path, what)
+
+
+def _classify_open_error(exc, path, what, writable):
+    """Classify a failure of :func:`open_stream`.
+
+    A directory (or any other object that can never be a sparse file) is
+    reported as ``"unsupported"`` even when the kernel only refused to grant
+    write access to it -- no amount of retrying would make the object work.
+    """
+    if isinstance(exc, UnsupportedOperation):
+        return WSParseError(
+            "%s is not supported on %r" % (what, path), kind="unsupported", path=path
+        )
+
+    code = _winerror_of(exc)
+    if code is not None and code in UNSUPPORTED_ERRORS:
+        return WSParseError(
+            "%s is not supported on %r (Win32 error %d)" % (what, path, code),
+            kind="unsupported",
+            path=path,
+        )
+    if (code is not None and code in _MISSING_ERRORS) or missing(path):
+        return WSParseError("no such file: %s" % (path,), kind="os", path=path)
+    if not_a_sparse_file(path):
+        return WSParseError(
+            "%s is not supported on %r" % (what, path), kind="unsupported", path=path
+        )
+    if writable and code is not None and code in _NOT_A_SPARSE_FILE_ERRORS:
+        return WSParseError(
+            "%s is not supported on %r (Win32 error %d)" % (what, path, code),
+            kind="unsupported",
+            path=path,
+        )
+    return WSParseError(
+        "%s failed (%s)" % (what, _winapi.winerror_message(code) if code else exc),
+        kind="os",
+        path=path,
+    )
+
+
+def open_stream(path, what, writable=False, create=False):
+    """Open ``path`` for the file-system control calls and return the handle.
+
+    ``writable`` asks for ``GENERIC_WRITE`` too, ``create`` creates the file
+    when it is missing.  Failures go through :func:`_classify_open_error`, and
+    an object that can never be sparse is rejected up front instead of failing
+    later inside a control call.
+    """
+    is_windows_or_raise(path, what)
+
+    access = _winapi.GENERIC_READ | (_winapi.GENERIC_WRITE if writable else 0)
+    creation = _winapi.OPEN_ALWAYS if create else _winapi.OPEN_EXISTING
+    try:
+        handle = _winapi.open_file(
+            path, access, creation=creation, flags=_winapi.FILE_FLAG_BACKUP_SEMANTICS
+        )
+    except OSError as exc:
+        raise _classify_open_error(exc, path, what, writable) from None
+
+    # FILE_FLAG_BACKUP_SEMANTICS happily opens a directory; the sparse control
+    # calls would only fail on it later, so catch that here.
+    if not_a_sparse_file(path):
+        _winapi.close_handle(handle)
+        raise WSParseError(
+            "%s is not supported on %r" % (what, path), kind="unsupported", path=path
+        )
+    return handle
+
+
+def file_length(path):
+    """Logical length of ``path`` in bytes, as a :class:`WSParseError` on failure."""
+    try:
+        return int(os.stat(path).st_size)
+    except OSError as exc:
+        fail(exc, path, "stat")
+
+
+def cluster_size(path):
+    """Allocation unit of the volume that holds ``path``."""
+    try:
+        size = _winapi.get_cluster_size(path)
+    except Exception:
+        size = 0
+    return int(size) if size > 0 else DEFAULT_CLUSTER_SIZE
+
+
+def round_up(value, unit):
+    """Round ``value`` up to a multiple of ``unit``."""
+    value = int(value)
+    if unit <= 1:
+        return value
+    return ((value + unit - 1) // unit) * unit
