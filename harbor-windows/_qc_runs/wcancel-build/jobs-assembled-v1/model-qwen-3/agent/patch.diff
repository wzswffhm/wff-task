     """Return ``True`` when ``handle`` can carry overlapping operations.
 
     ``handle`` must be an integer object handle.
+
+    Disk files and pipes opened with ``FILE_FLAG_OVERLAPPED`` support
+    asynchronous I/O.  Console handles and other character devices generally
+    do not.  We determine this by checking the file type: disk files and pipes
+    are assumed to have been opened with the overlapped flag (the collector's
+    pipe factory always does so), while console/character devices do not
+    support overlapped reads.
     """
     number = _winapi.as_number(handle)
     if not _winapi.is_usable_handle(number):
         raise WCancelError("not a usable object handle: %r" % (handle,),
-                           kind="os", handle=handle)
-    # The read layer has always taken its objects from the pipe factory, which
