-    # object the module is asked about.
-    return True
+                           kind="badarg", handle=handle)
+
+    raw = _winapi.file_type(number)
+    base_type = raw & ~_winapi.FILE_TYPE_REMOTE
+
+    # Disk files and pipes support overlapped I/O when opened with
+    # FILE_FLAG_OVERLAPPED.  Character devices (consoles) do not.
+    if base_type in (_winapi.FILE_TYPE_DISK, _winapi.FILE_TYPE_PIPE):
