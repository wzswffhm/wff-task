diff --git a/wcancel/_winapi.py b/wcancel/_winapi.py
index 1432894..8d90749 100644
--- a/wcancel/_winapi.py
+++ b/wcancel/_winapi.py
@@ -33,13 +33,27 @@ INFINITE = 0xFFFFFFFF
 
 FILE_MODE_INFORMATION_CLASS = 16
 
+# Synchronous I/O flags in FileModeInformation.Mode
+FILE_SYNCHRONOUS_IO_ALERT = 0x00000010
+FILE_SYNCHRONOUS_IO_NONALERT = 0x00000020
+
 _IS_WINDOWS = os.name == "nt"
 
 _kernel32 = None
+_ntdll = None
+
+
+class IO_STATUS_BLOCK(ctypes.Structure):
+    """The NT I/O status block returned by NtQueryInformationFile."""
+
+    _fields_ = [
+        ("Status", ctypes.c_void_p),
+        ("Pointer", ctypes.c_void_p),
+    ]
 
 
 class FILE_MODE_INFORMATION(ctypes.Structure):
-    """Payload of ``GetFileInformationByHandleEx(FileModeInformation)``."""
+    """Payload of ``NtQueryInformationFile(FileModeInformation)``."""
 
     _fields_ = [("Mode", wintypes.DWORD)]
 
@@ -85,6 +99,19 @@ def _kernel32_dll():
     return _kernel32
 
 
+def _ntdll_dll():
+    """The shared ``ntdll`` instance, loaded on first use."""
+    global _ntdll
+    if not _IS_WINDOWS:
+        raise WCancelError(
+            "overlapping I/O requires the Win32 API, which exists only on Windows",
+            kind="unsupported",
+        )
+    if _ntdll is None:
+        _ntdll = ctypes.WinDLL("ntdll", use_last_error=True)
+    return _ntdll
+
+
 def last_error():
     """The Win32 error code left by the most recent call."""
     return int(ctypes.get_last_error())
@@ -170,19 +197,29 @@ def file_type(handle):
 
 
 def file_mode(handle):
-    """Return the ``Mode`` word of ``GetFileInformationByHandleEx``."""
-    kernel32 = _kernel32_dll()
-    query = kernel32.GetFileInformationByHandleEx
-    query.argtypes = [wintypes.HANDLE, ctypes.c_int, wintypes.LPVOID, wintypes.DWORD]
-    query.restype = wintypes.BOOL
+    """Return the ``Mode`` word from ``NtQueryInformationFile(FileModeInformation)``.
+
+    Uses the native NT API rather than the kernel32 wrapper because
+    ``GetFileInformationByHandleEx(FileModeInformation)`` fails on several
+    object types (notably named pipes) while the NT call works uniformly.
+    """
+    ntdll = _ntdll_dll()
+    query = ntdll.NtQueryInformationFile
+    query.argtypes = [wintypes.HANDLE, ctypes.POINTER(IO_STATUS_BLOCK),
+                      wintypes.LPVOID, ctypes.c_ulong, ctypes.c_ulong]
+    query.restype = ctypes.c_long  # NTSTATUS
+
+    ios = IO_STATUS_BLOCK()
     info = FILE_MODE_INFORMATION()
-    ok = query(wintypes.HANDLE(int(handle)), FILE_MODE_INFORMATION_CLASS,
-               ctypes.byref(info), ctypes.sizeof(info))
-    if not ok:
-        error = last_error()
+    status = query(wintypes.HANDLE(int(handle)), ctypes.byref(ios),
+                   ctypes.byref(info), ctypes.sizeof(info),
+                   FILE_MODE_INFORMATION_CLASS)
+    if status != 0:
+        # Map common NTSTATUS codes to something descriptive.
         raise WCancelError(
-            "the mode of object %r could not be read (%s)" % (handle, describe(error)),
-            kind=error_kind(error),
+            "the mode of object %r could not be read (NTSTATUS 0x%08X)"
+            % (handle, status & 0xFFFFFFFF),
+            kind="os",
             handle=handle,
         )
     return int(info.Mode)
@@ -217,7 +254,7 @@ def wait_for_read(handle, overlapped, event, timeout_ms):
     """Wait for one outstanding read and report how it ended.
 
     Returns ``(outcome, bytes_read, error)`` with ``outcome`` one of
-    ``"completed"``, ``"timeout"`` or ``"error"``.
+    ``"completed"``, ``"cancelled"``, ``"timeout"`` or ``"error"``.
     """
     kernel32 = _kernel32_dll()
     wait = kernel32.WaitForSingleObject
@@ -238,6 +275,8 @@ def wait_for_read(handle, overlapped, event, timeout_ms):
     completed, error, transferred = read_status(handle, overlapped)
     if completed:
         return "completed", transferred, ERROR_SUCCESS
+    if error == ERROR_OPERATION_ABORTED:
+        return "cancelled", transferred, error
     return "error", transferred, error
 
 
@@ -260,10 +299,41 @@ def read_status(handle, overlapped):
     return False, last_error(), int(transferred.value)
 
 
+def cancel_io_ex(handle, overlapped):
+    """Ask the system to abandon one specific outstanding I/O request.
+
+    Uses ``CancelIoEx`` which targets a single OVERLAPPED operation regardless
+    of which thread issued it.  Returns ``True`` when the system accepted the
+    cancellation, ``False`` when the request was not found (already completed).
+    """
+    kernel32 = _kernel32_dll()
+    cancel_fn = kernel32.CancelIoEx
+    cancel_fn.argtypes = [wintypes.HANDLE, ctypes.POINTER(OVERLAPPED)]
+    cancel_fn.restype = wintypes.BOOL
+
+    ok = cancel_fn(wintypes.HANDLE(int(handle)), ctypes.byref(overlapped))
+    if ok:
+        return True
+    error = last_error()
+    if error == ERROR_NOT_FOUND:
+        # The I/O has already completed; nothing to cancel.
+        return False
