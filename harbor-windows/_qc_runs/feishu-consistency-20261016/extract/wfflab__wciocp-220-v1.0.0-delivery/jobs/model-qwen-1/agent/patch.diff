diff --git a/wciocp/_winapi.py b/wciocp/_winapi.py
index fdedcf4..fec5f09 100644
--- a/wciocp/_winapi.py
+++ b/wciocp/_winapi.py
@@ -18,15 +18,25 @@ ERROR_INVALID_PARAMETER = 87
 ERROR_NOT_ENOUGH_MEMORY = 8
 ERROR_IO_PENDING = 997
 ERROR_HANDLE_EOF = 38
+ERROR_OPERATION_ABORTED = 995
+ERROR_ABANDONED_WAIT_0 = 735
 
 WAIT_OBJECT_0 = 0x00000000
 WAIT_TIMEOUT = 0x00000102
 WAIT_FAILED = 0xFFFFFFFF
 INFINITE = 0xFFFFFFFF
 
+# NT status codes
+STATUS_CANCELLED = 0xC0000120
+
+# File mode flags (from ntddk.h)
+FILE_SYNCHRONOUS_IO_ALERT = 0x00000010
+FILE_SYNCHRONOUS_IO_NONALERT = 0x00000020
+
 _IS_WINDOWS = os.name == "nt"
 
 _kernel32 = None
+_ntdll_handle = None
 
 
 class OVERLAPPED(ctypes.Structure):
@@ -46,6 +56,19 @@ class OVERLAPPED(ctypes.Structure):
     ]
 
 
+class _IO_STATUS_BLOCK(ctypes.Structure):
+    _fields_ = [
+        ("Status", ctypes.c_void_p),
+        ("Information", ctypes.POINTER(ctypes.c_ulong)),
+    ]
+
+
+class _FILE_MODE_INFORMATION(ctypes.Structure):
+    _fields_ = [
+        ("Mode", wintypes.DWORD),
+    ]
+
+
 def is_windows():
     """Return ``True`` when running on a Windows kernel."""
     return _IS_WINDOWS
@@ -75,6 +98,19 @@ def _kernel32_dll():
     return _kernel32
 
 
+def _ntdll_dll():
+    """The shared ``ntdll`` instance, loaded on first use."""
+    global _ntdll_handle
+    if not _IS_WINDOWS:
+        raise WCIOCPError(
+            "the completion layer needs the Win32 API, which exists only on Windows",
+            kind="unsupported",
+        )
+    if _ntdll_handle is None:
+        _ntdll_handle = ctypes.WinDLL("ntdll", use_last_error=True)
+    return _ntdll_handle
+
+
 def last_error():
     """The Win32 error code left by the most recent call."""
     return int(ctypes.get_last_error())
@@ -111,6 +147,7 @@ def describe(error):
         ERROR_NOT_ENOUGH_MEMORY: "ERROR_NOT_ENOUGH_MEMORY",
         ERROR_IO_PENDING: "ERROR_IO_PENDING",
         ERROR_HANDLE_EOF: "ERROR_HANDLE_EOF",
+        ERROR_OPERATION_ABORTED: "ERROR_OPERATION_ABORTED",
     }
     label = names.get(int(error))
     if label is None:
@@ -243,6 +280,208 @@ class Event(object):
         return "Event(handle=%d)" % self.handle
 
 
