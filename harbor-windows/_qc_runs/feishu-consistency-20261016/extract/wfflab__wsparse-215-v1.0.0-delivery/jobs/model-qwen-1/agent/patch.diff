+    if not result:
+        err = ctypes.get_last_error()
+        raise OSError(err, os.strerror(err) if err else "GetFileSizeEx failed")
+    
+    return size.QuadPart
+
+
+def query_allocated_ranges(handle, file_size):
+    """Query the allocated ranges of a file using FSCTL_QUERY_ALLOCATED_RANGES.
+    
+    Returns a list of (offset, length) tuples representing allocated regions.
+    Raises OSError on failure.
+    """
+    if file_size == 0:
+        return []
+    
+    k32 = _kernel32()
+    
+    # Input buffer: FILE_ALLOCATED_RANGE_BUFFER specifying the range to query
+    input_range = _AllocatedRange()
+    input_range.FileOffset = 0
+    input_range.Length = file_size
+    
+    # Output buffer: array of FILE_ALLOCATED_RANGE_BUFFER
+    # Start with a reasonable buffer size; grow if needed
+    max_ranges = 1024
+    output_buffer = (_AllocatedRange * max_ranges)()
+    output_size = ctypes.sizeof(output_buffer)
+    
+    bytes_returned = wintypes.DWORD()
+    
+    ranges = []
+    
+    while True:
+        result = k32.DeviceIoControl(
+            handle,
+            FSCTL_QUERY_ALLOCATED_RANGES,
+            ctypes.byref(input_range),
+            ctypes.sizeof(input_range),
+            ctypes.byref(output_buffer),
+            output_size,
+            ctypes.byref(bytes_returned),
+            None,
+        )
+        
+        if not result:
+            err = ctypes.get_last_error()
+            # ERROR_MORE_DATA means there are more ranges to retrieve
+            # But we got some data back
+            if err == 234:  # ERROR_MORE_DATA
+                pass  # Continue processing what we got
+            elif err == 38:  # ERROR_HANDLE_EOF - no more ranges
+                break
+            else:
+                # Some other error
+                raise OSError(err, os.strerror(err) if err else "FSCTL_QUERY_ALLOCATED_RANGES failed")
+        
+        # Process returned ranges
+        num_ranges = bytes_returned.value // ctypes.sizeof(_AllocatedRange)
+        for i in range(num_ranges):
+            r = output_buffer[i]
+            ranges.append((r.FileOffset, r.Length))
+        
+        # If we got fewer ranges than our buffer could hold, we're done
+        if num_ranges < max_ranges:
+            break
+        
+        # Otherwise, continue from where we left off
+        last = ranges[-1]
+        input_range.FileOffset = last[0] + last[1]
+        input_range.Length = file_size - input_range.FileOffset
+        if input_range.Length <= 0:
+            break
+    
+    return ranges
