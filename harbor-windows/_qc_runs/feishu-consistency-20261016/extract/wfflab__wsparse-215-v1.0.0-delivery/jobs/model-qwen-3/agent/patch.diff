diff --git a/wsparse/_tmp_test.py b/wsparse/_tmp_test.py
new file mode 100644
index 0000000..050b9bc
--- /dev/null
+++ b/wsparse/_tmp_test.py
@@ -0,0 +1,70 @@
+import ctypes
+from ctypes import wintypes
+import os, tempfile
+
+kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+FILE_SHARE_READ = 0x00000001
+FILE_SHARE_WRITE = 0x00000002
+OPEN_ALWAYS = 4
+FILE_ATTRIBUTE_NORMAL = 0x80
+INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
+
+FSCTL_SET_SPARSE = 0x000900C4
+FSCTL_QUERY_ALLOCATED_RANGES = 0x000940CF
+
+LARGE_INTEGER = ctypes.c_int64
+
+tmpdir = tempfile.mkdtemp()
+path = os.path.join(tmpdir, 'test_sparse.bin')
+
+handle = kernel32.CreateFileW(
+    path, GENERIC_READ | GENERIC_WRITE,
+    FILE_SHARE_READ | FILE_SHARE_WRITE,
+    None, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, None
+)
+print('Handle:', handle, 'INVALID:', INVALID_HANDLE_VALUE)
+
+ret = kernel32.DeviceIoControl(handle, FSCTL_SET_SPARSE, None, 0, None, 0, ctypes.byref(wintypes.DWORD()), None)
+print('Set sparse result:', ret, 'err:', ctypes.get_last_error())
+
+size = 1 << 30
+new_pos = LARGE_INTEGER(size)
+kernel32.SetFilePointerEx(handle, new_pos, None, 0)
+ret = kernel32.SetEndOfFile(handle)
+print('SetEndOfFile result:', ret, 'err:', ctypes.get_last_error())
+
+st = os.stat(path)
+print('Logical size:', st.st_size)
+print('Attributes:', hex(getattr(st, 'st_file_attributes', 0)))
+
+compressed_size = LARGE_INTEGER()
+ret = kernel32.GetCompressedFileSizeW(path, ctypes.byref(compressed_size))
+print('GetCompressedFileSizeW result:', ret, 'compressed:', compressed_size.value)
+
+class FILE_ALLOCATED_RANGE_BUFFER(ctypes.Structure):
+    _fields_ = [
+        ('FileOffset', LARGE_INTEGER),
+        ('Length', LARGE_INTEGER),
+    ]
+
+ranges_buf = (FILE_ALLOCATED_RANGE_BUFFER * 256)()
+bytes_returned = wintypes.DWORD()
+ret = kernel32.DeviceIoControl(
+    handle, FSCTL_QUERY_ALLOCATED_RANGES,
+    None, 0,
+    ranges_buf, ctypes.sizeof(ranges_buf),
+    ctypes.byref(bytes_returned), None
+)
+print('QueryAllocatedRanges result:', ret, 'bytes_returned:', bytes_returned.value)
+num_ranges = bytes_returned.value // ctypes.sizeof(FILE_ALLOCATED_RANGE_BUFFER)
+for i in range(num_ranges):
+    r = ranges_buf[i]
+    print(f'  Range {i}: offset={r.FileOffset}, length={r.Length}')
+
+kernel32.CloseHandle(handle)
+os.unlink(path)
+os.rmdir(tmpdir)
+print("DONE")
diff --git a/wsparse/_tmp_test2.py b/wsparse/_tmp_test2.py
new file mode 100644
index 0000000..352de1f
--- /dev/null
+++ b/wsparse/_tmp_test2.py
@@ -0,0 +1,114 @@
+import ctypes
+from ctypes import wintypes
+import os, tempfile
+
+kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+FILE_SHARE_READ = 0x00000001
+FILE_SHARE_WRITE = 0x00000002
+OPEN_ALWAYS = 4
+FILE_ATTRIBUTE_NORMAL = 0x80
+INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
+FSCTL_SET_SPARSE = 0x000900C4
+FSCTL_QUERY_ALLOCATED_RANGES = 0x000940CF
+LARGE_INTEGER = ctypes.c_int64
+
+tmpdir = tempfile.mkdtemp()
+path = os.path.join(tmpdir, 'test_sparse2.bin')
+
+handle = kernel32.CreateFileW(
+    path, GENERIC_READ | GENERIC_WRITE,
+    FILE_SHARE_READ | FILE_SHARE_WRITE,
+    None, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, None
+)
+
+# Set sparse
+kernel32.DeviceIoControl(handle, FSCTL_SET_SPARSE, None, 0, None, 0, ctypes.byref(wintypes.DWORD()), None)
+
+# Set file size to 64 MiB
+size = 64 << 20
+new_pos = LARGE_INTEGER(size)
+kernel32.SetFilePointerEx(handle, new_pos, None, 0)
+kernel32.SetEndOfFile(handle)
+
+# Now write some data at offset 1MiB and 32MiB using python
+kernel32.CloseHandle(handle)
+
+with open(path, 'r+b') as f:
+    f.seek(1 << 20)
+    f.write(b'A' * 4096)
+    f.seek(32 << 20)
+    f.write(b'B' * 4096)
+
+# Reopen for query
+handle = kernel32.CreateFileW(
+    path, GENERIC_READ,
+    FILE_SHARE_READ | FILE_SHARE_WRITE,
+    None, 3,  # OPEN_EXISTING
+    FILE_ATTRIBUTE_NORMAL, None
+)
