+"""Shared path handling for :mod:`wsparse`.
+
+The sparse-file FSCTLs only apply to regular files on a volume that supports
+sparse files.  Handing one of the public entry points something else -- a
+directory, for instance -- is a permanent condition rather than a transient
+I/O error, so it is reported as ``kind="unsupported"``.
+"""
+
+import os
+import stat
+
+from ._winapi import is_windows
+from .errors import WSParseError
+
+
+def resolve(path):
+    """Normalise ``path`` into a ``str`` usable with the Win32 wide calls."""
+    try:
+        path = os.fspath(path)
+    except TypeError as exc:
+        raise WSParseError(
+            "path must be a string or os.PathLike, got %r" % (path,), kind="badarg"
+        ) from exc
+    if isinstance(path, bytes):
+        path = os.fsdecode(path)
+    if not isinstance(path, str):
+        raise WSParseError(
+            "path must be a string or os.PathLike, got %r" % (path,), kind="badarg"
+        )
+    return path
+
+
+def require_windows(path=None):
+    """Raise ``unsupported`` when the platform has no sparse-file concept."""
+    if not is_windows():
+        raise WSParseError(
+            "sparse files are a Windows/NTFS concept; this platform has none",
+            kind="unsupported",
+            path=path,
+        )
+
+
+def stat_existing(path):
+    """``os.stat`` ``path``, reporting a missing path as ``kind="os"``."""
+    try:
+        return os.stat(path)
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+
+
+def require_regular_file(path, info=None):
+    """Reject anything that cannot carry the sparse attribute.
+
+    Directories, devices, pipes and the like have no sparse semantics, so the
+    sparse-file entry points report them as ``kind="unsupported"``.
+    """
+    if info is None:
+        info = stat_existing(path)
+    mode = info.st_mode
+    if stat.S_ISDIR(mode):
+        raise WSParseError(
+            "a directory cannot carry the sparse attribute",
+            kind="unsupported",
+            path=path,
+        )
+    if not stat.S_ISREG(mode):
+        raise WSParseError(
+            "only regular files support sparse-file operations",
+            kind="unsupported",
+            path=path,
+        )
+    return info
