diff --git a/wsparse/_support.py b/wsparse/_support.py
new file mode 100644
index 0000000..f189adf
--- /dev/null
+++ b/wsparse/_support.py
@@ -0,0 +1,104 @@
+"""Shared plumbing for the :mod:`wsparse` entry points.
+
+Every public entry point has to agree on three things:
+
+* what a usable path is,
+* when a failure is an ``"unsupported"`` failure rather than an ``"os"`` one,
+* and that an unsupported object never gets a silent success.
+"""
+
+import os
+
+from . import _winapi
+from .errors import WSParseError
+
+
+def normalise_path(path):
+    """Return ``path`` as a string, rejecting values that cannot be a path."""
+    try:
+        return os.fspath(path)
+    except TypeError as exc:
+        raise WSParseError(
+            "path must be a path-like object, got %r" % (path,), kind="badarg"
+        ) from exc
+
+
+def require_windows(path):
