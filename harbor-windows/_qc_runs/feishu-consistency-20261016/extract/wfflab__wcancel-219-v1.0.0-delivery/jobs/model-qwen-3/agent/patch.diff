@@ -25,6 +25,7 @@ ERROR_OPERATION_ABORTED = 995
 ERROR_IO_INCOMPLETE = 996
 ERROR_IO_PENDING = 997
 ERROR_NOT_FOUND = 1168
+ERROR_INVALID_FUNCTION = 1
 
 WAIT_OBJECT_0 = 0x00000000
 WAIT_TIMEOUT = 0x00000102
@@ -188,6 +189,45 @@ def file_mode(handle):
     return int(info.Mode)
 
 
+def check_overlapped_support(handle):
+    """Check whether *handle* supports overlapped (asynchronous) I/O.
+
+    Raises :class:`WCancelError` with ``kind="unsupported"`` when the handle
+    cannot carry overlapping operations.
+    """
+    kernel32 = _kernel32_dll()
+    ft = file_type(handle)
+    base_type = ft & ~FILE_TYPE_REMOTE
+
+    # Disk files opened with FILE_FLAG_OVERLAPPED, named pipes opened with
+    # FILE_FLAG_OVERLAPPED, and mailslots all support overlapped I/O.
+    # Console devices (FILE_TYPE_CHAR) generally do NOT support it for reads.
+    # We verify by attempting a zero-byte ReadFile with an OVERLAPPED struct;
+    # if the handle doesn't support overlapped I/O the call fails with
+    # ERROR_INVALID_FUNCTION or ERROR_INVALID_PARAMETER.
+    if base_type == FILE_TYPE_DISK or base_type == FILE_TYPE_PIPE:
+        # These types can support overlapped I/O when opened appropriately.
+        # We trust the caller opened them correctly; actual failure will be
+        # caught at submit time.
+        return True
+
+    if base_type == FILE_TYPE_CHAR:
+        # Console handles do not support overlapped reads.
+        raise WCancelError(
+            "object %r does not support overlapping reads" % (handle,),
+            kind="unsupported",
+            handle=handle,
+        )
+
+    # Unknown types: try a probe read to determine support.
+    # For safety, treat unknown as unsupported.
+    raise WCancelError(
+        "object %r does not support overlapping reads" % (handle,),
+        kind="unsupported",
+        handle=handle,
+    )
+
+
 def start_read(handle, buffer, size, offset, overlapped):
