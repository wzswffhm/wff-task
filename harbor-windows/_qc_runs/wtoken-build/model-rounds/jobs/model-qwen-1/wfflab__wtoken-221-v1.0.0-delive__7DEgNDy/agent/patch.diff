+    # SID layout: Revision(1) + SubAuthorityCount(1) + IdentifierAuthority(6) + SubAuthority[n](4*n)
+    sub_auth_count = ctypes.c_ubyte.from_address(sid_ptr + 1).value
+    if sub_auth_count < 1:
+        raise OSError("Integrity SID has no sub-authorities")
+    last_sub_auth_offset = 8 + (sub_auth_count - 1) * 4
+    rid = ctypes.c_ulong.from_address(sid_ptr + last_sub_auth_offset).value
+    return rid
