+    # typedef struct _SID_AND_ATTRIBUTES {
+    #     PSID Sid;      // pointer-sized
+    #     DWORD Attributes;
+    # } SID_AND_ATTRIBUTES;
+    ptr_size = ctypes.sizeof(ctypes.c_void_p)
