+# ---------------------------------------------------------------------------
+# Token information constants
+# ---------------------------------------------------------------------------
+
+TOKEN_QUERY = 0x0008
+TOKEN_ADJUST_PRIVILEGES = 0x0020
+
+TokenPrivileges = 3
+TokenElevation = 20
+TokenIntegrityLevel = 25
+TokenElevationType = 18
+
+SE_PRIVILEGE_ENABLED = 0x00000002
+
+ELEVATION_TYPE_DEFAULT = 1
+ELEVATION_TYPE_FULL = 2
+ELEVATION_TYPE_LIMITED = 3
+
+# Well-known integrity level RIDs
+INTEGRITY_LEVEL_UNTRUSTED = 0x00000000
+INTEGRITY_LEVEL_LOW = 0x00001000
+INTEGRITY_LEVEL_MEDIUM = 0x00002000
+INTEGRITY_LEVEL_HIGH = 0x00003000
+INTEGRITY_LEVEL_SYSTEM = 0x00004000
+INTEGRITY_LEVEL_PROTECTED = 0x00005000
+
+
+class LUID(ctypes.Structure):
+    _fields_ = [
+        ("LowPart", ctypes.c_ulong),
+        ("HighPart", ctypes.c_long),
+    ]
+
+    def __eq__(self, other):
+        if not isinstance(other, LUID):
+            return NotImplemented
+        return self.LowPart == other.LowPart and self.HighPart == other.HighPart
+
+    def __hash__(self):
+        return hash((self.LowPart, self.HighPart))
+
+    def to_int(self):
+        """Return the 64-bit integer representation."""
+        return (self.HighPart << 32) | self.LowPart
+
+    @classmethod
+    def from_int(cls, val):
+        """Create a LUID from a 64-bit integer."""
+        obj = cls()
+        obj.LowPart = val & 0xFFFFFFFF
+        obj.HighPart = (val >> 32) & 0xFFFFFFFF
+        return obj
+
+
+class LUID_AND_ATTRIBUTES(ctypes.Structure):
+    _fields_ = [
+        ("Luid", LUID),
+        ("Attributes", ctypes.c_ulong),
+    ]
+
+
+def lookup_privilege_value(name):
+    """Call LookupPrivilegeValueW. Returns a LUID or raises WTokenError."""
+    _require_windows()
+    luid = LUID()
+    func = _advapi32().LookupPrivilegeValueW
+    func.argtypes = [ctypes.c_wchar_p, ctypes.c_wchar_p, ctypes.POINTER(LUID)]
+    func.restype = ctypes.c_int
+    if not func(None, name, ctypes.byref(luid)):
+        from .errors import WTokenError
+        raise WTokenError(
+            "LookupPrivilegeValueW failed for %r" % (name,),
+            kind="badarg",
+            privilege=name,
+        )
+    return luid
+
+
+def lookup_privilege_name(luid):
+    """Call LookupPrivilegeNameW. Returns the name string or raises WTokenError."""
+    _require_windows()
+    buf_len = ctypes.c_ulong(256)
+    buf = ctypes.create_unicode_buffer(buf_len.value)
+    func = _advapi32().LookupPrivilegeNameW
+    func.argtypes = [
+        ctypes.c_wchar_p,
+        ctypes.POINTER(LUID),
+        ctypes.c_wchar_p,
+        ctypes.POINTER(ctypes.c_ulong),
+    ]
+    func.restype = ctypes.c_int
+    if not func(None, ctypes.byref(luid), buf, ctypes.byref(buf_len)):
+        err = last_error()
+        # ERROR_INSUFFICIENT_BUFFER = 122
+        if err == 122:
+            buf = ctypes.create_unicode_buffer(buf_len.value)
+            if not func(None, ctypes.byref(luid), buf, ctypes.byref(buf_len)):
+                from .errors import WTokenError
+                raise WTokenError(
+                    "LookupPrivilegeNameW failed for LUID (%d, %d)"
+                    % (luid.LowPart, luid.HighPart),
+                    kind="badarg",
+                )
+        else:
+            from .errors import WTokenError
+            raise WTokenError(
+                "LookupPrivilegeNameW failed for LUID (%d, %d)"
+                % (luid.LowPart, luid.HighPart),
+                kind="badarg",
+            )
+    return buf.value
+
+
+def get_token_privileges(token_handle):
+    """Retrieve TOKEN_PRIVILEGES from a token handle.
+
+    *token_handle* is an integer handle value.
+
+    Returns a list of (LUID, attributes) tuples.
+    """
+    _require_windows()
+    func = _advapi32().GetTokenInformation
+    ret_len = ctypes.c_ulong(0)
+    func.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_int,
+        ctypes.c_void_p,
+        ctypes.c_ulong,
+        ctypes.POINTER(ctypes.c_ulong),
+    ]
+    func.restype = ctypes.c_int
+
+    h = ctypes.c_void_p(token_handle)
+    func(h, TokenPrivileges, None, 0, ctypes.byref(ret_len))
+    err = last_error()
+    if err != 122 and ret_len.value == 0:
+        raise OSError(err, "GetTokenInformation(TokenPrivileges) size query failed")
+
+    buf = ctypes.create_string_buffer(ret_len.value)
+    if not func(h, TokenPrivileges, buf, ret_len, ctypes.byref(ret_len)):
+        raise OSError(last_error(), "GetTokenInformation(TokenPrivileges) failed")
+
+    count = ctypes.c_ulong.from_buffer_copy(buf, 0).value
+    result = []
+    la_size = ctypes.sizeof(LUID_AND_ATTRIBUTES)
+    offset = ctypes.sizeof(ctypes.c_ulong)
+    for i in range(count):
+        la = LUID_AND_ATTRIBUTES.from_buffer_copy(buf, offset + i * la_size)
+        # Make a copy of the LUID so it doesn't reference the buffer
+        luid_copy = LUID()
+        luid_copy.LowPart = la.Luid.LowPart
+        luid_copy.HighPart = la.Luid.HighPart
+        result.append((luid_copy, la.Attributes))
+    return result
+
+
+def adjust_token_privileges(token_handle, luid, enable):
+    """Enable or disable a single privilege on the given token handle."""
+    _require_windows()
+
+    class TOKEN_PRIVILEGES_ADJ(ctypes.Structure):
+        _fields_ = [
+            ("PrivilegeCount", ctypes.c_ulong),
+            ("Luid", LUID),
+            ("Attributes", ctypes.c_ulong),
+        ]
+
+    tp = TOKEN_PRIVILEGES_ADJ()
+    tp.PrivilegeCount = 1
+    tp.Luid.LowPart = luid.LowPart
+    tp.Luid.HighPart = luid.HighPart
+    tp.Attributes = SE_PRIVILEGE_ENABLED if enable else 0
+
+    func = _advapi32().AdjustTokenPrivileges
+    func.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_int,
+        ctypes.POINTER(TOKEN_PRIVILEGES_ADJ),
+        ctypes.c_ulong,
+        ctypes.c_void_p,
+        ctypes.POINTER(ctypes.c_ulong),
+    ]
+    func.restype = ctypes.c_int
+
+    h = ctypes.c_void_p(token_handle)
+    if not func(h, 0, ctypes.byref(tp), 0, None, None):
+        raise OSError(last_error(), "AdjustTokenPrivileges failed")
+    # AdjustTokenPrivileges can succeed but still set last error to
+    # ERROR_NOT_ALL_ASSIGNED (1300) when the token doesn't hold the privilege.
+    err = last_error()
+    if err == 1300:
+        from .errors import WTokenError
+        raise WTokenError(
+            "the token does not hold this privilege",
+            kind="badarg",
+        )
+
+
+def get_token_elevation(token_handle):
+    """Return (is_elevated: bool, elevation_type: int) for the token."""
+    _require_windows()
+    func = _advapi32().GetTokenInformation
+
+    h = ctypes.c_void_p(token_handle)
+
+    # TOKEN_ELEVATION is a single DWORD
