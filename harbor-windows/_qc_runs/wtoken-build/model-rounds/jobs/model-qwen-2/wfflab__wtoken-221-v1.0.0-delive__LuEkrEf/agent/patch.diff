     if not _IS_WINDOWS:
         raise OSError("process tokens exist only on Windows")
     handle = wintypes.HANDLE()
@@ -59,10 +105,233 @@ def open_process_token(access):
 
 
 def close_handle(handle):
-    import ctypes
-    from ctypes import wintypes
-
+    """Close a Windows handle."""
     func = _kernel32().CloseHandle
     func.argtypes = [wintypes.HANDLE]
     func.restype = wintypes.BOOL
-    func(wintypes.HANDLE(int(handle)))
+    # handle may be a wintypes.HANDLE (c_void_p) or an int
+    if hasattr(handle, 'value'):
+        raw = handle.value
+    else:
+        raw = handle
+    func(wintypes.HANDLE(raw))
+
+
+# ── LUID helpers ─────────────────────────────────────────────────────────────
+
+def _luid_to_int(luid):
+    """Convert a LUID struct to a Python integer."""
+    return (luid.HighPart << 32) | luid.LowPart
+
+
+def _int_to_luid(value):
+    """Convert an integer back to a LUID struct."""
+    luid = LUID()
+    luid.LowPart = value & 0xFFFFFFFF
+    high = (value >> 32) & 0xFFFFFFFF
+    # HighPart is c_long (signed), so we need to handle sign
+    if high >= 0x80000000:
+        high -= 0x100000000
+    luid.HighPart = high
+    return luid
+
+
+# ── Public API ───────────────────────────────────────────────────────────────
+
+def lookup_privilege_value(name):
+    """Return the system LUID (as int) for a privilege name.
+
+    Raises ``OSError`` if the name is not recognised by the system.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("privilege lookup exists only on Windows")
+    adv = _advapi32()
+    luid = LUID()
+    func = adv.LookupPrivilegeValueW
+    func.argtypes = [wintypes.LPCWSTR, wintypes.LPCWSTR, ctypes.POINTER(LUID)]
+    func.restype = wintypes.BOOL
+    if not func(None, name, ctypes.byref(luid)):
+        raise OSError(last_error(), "LookupPrivilegeValueW failed for %r" % name)
+    return _luid_to_int(luid)
+
+
+def lookup_privilege_name(luid_int):
+    """Return the privilege name for a system LUID (given as int).
+
+    Raises ``OSError`` if the LUID is not recognised.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("privilege lookup exists only on Windows")
+    adv = _advapi32()
+    luid = _int_to_luid(luid_int)
+    buf = ctypes.create_unicode_buffer(256)
+    buf_len = wintypes.DWORD(256)
+    func = adv.LookupPrivilegeNameW
+    func.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(LUID), ctypes.c_wchar_p, ctypes.POINTER(wintypes.DWORD)]
+    func.restype = wintypes.BOOL
+    if not func(None, ctypes.byref(luid), buf, ctypes.byref(buf_len)):
+        raise OSError(last_error(), "LookupPrivilegeNameW failed for LUID %d" % luid_int)
+    return buf.value
+
+
+def get_token_privileges(token_handle):
+    """Return a list of ``(name, enabled)`` for every privilege in the token.
+
+    Reads the TOKEN_PRIVILEGES array from the token via GetTokenInformation.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("token queries exist only on Windows")
+    adv = _advapi32()
+
+    func = adv.GetTokenInformation
+    func.argtypes = [
+        wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p,
+        wintypes.DWORD, ctypes.POINTER(wintypes.DWORD),
+    ]
+    func.restype = wintypes.BOOL
+
+    # First call to determine buffer size
+    ret_len = wintypes.DWORD(0)
+    func(token_handle, TokenPrivilegesInfo, None, 0, ctypes.byref(ret_len))
+    buf_size = ret_len.value
+    if buf_size == 0:
+        raise OSError(last_error(), "GetTokenInformation returned zero size for privileges")
+
+    buf = ctypes.create_string_buffer(buf_size)
+    if not func(token_handle, TokenPrivilegesInfo, buf, buf_size, ctypes.byref(ret_len)):
+        raise OSError(last_error(), "GetTokenInformation failed for TokenPrivileges")
+
+    priv_count = ctypes.c_uint32.from_buffer_copy(buf, 0).value
+    result = []
+    la_size = ctypes.sizeof(LUID_AND_ATTRIBUTES)
+    for i in range(priv_count):
+        offset = 4 + i * la_size
+        la = LUID_AND_ATTRIBUTES.from_buffer_copy(buf, offset)
+        luid_int = _luid_to_int(la.Luid)
+        try:
+            name = lookup_privilege_name(luid_int)
+        except OSError:
+            # Unknown privilege – should not happen, but be safe
+            name = "UnknownPrivilege_%d" % luid_int
+        enabled = bool(la.Attributes & SE_PRIVILEGE_ENABLED)
+        result.append((name, enabled))
+    return result
+
+
+def adjust_token_privilege(token_handle, luid_int, enable):
+    """Enable or disable a single privilege on the token.
+
+    Raises ``OSError`` on failure.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("privilege adjustment exists only on Windows")
+    adv = _advapi32()
+
+    tp = TOKEN_PRIVILEGES()
+    tp.PrivilegeCount = 1
+    tp.Privileges[0].Luid = _int_to_luid(luid_int)
+    tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED if enable else 0
+
+    func = adv.AdjustTokenPrivileges
+    func.argtypes = [
+        wintypes.HANDLE, wintypes.BOOL, ctypes.POINTER(TOKEN_PRIVILEGES),
+        wintypes.DWORD, ctypes.POINTER(TOKEN_PRIVILEGES),
+        ctypes.POINTER(wintypes.DWORD),
+    ]
+    func.restype = wintypes.BOOL
+
+    prev = TOKEN_PRIVILEGES()
+    ret_len = wintypes.DWORD(0)
+    if not func(
+        token_handle, False, ctypes.byref(tp),
+        ctypes.sizeof(prev), ctypes.byref(prev), ctypes.byref(ret_len),
+    ):
+        raise OSError(last_error(), "AdjustTokenPrivileges failed")
+
+    # AdjustTokenPrivileges can return TRUE but still fail; check GetLastError
+    err = last_error()
+    # ERROR_NOT_ALL_ASSIGNED (1300) means the privilege is not held
+    if err == 1300:
+        raise OSError(err, "privilege not held by this token")
+
+
+def get_token_elevation(token_handle):
+    """Return ``(elevated: bool, type_name: str)`` for the token."""
+    if not _IS_WINDOWS:
+        raise OSError("elevation queries exist only on Windows")
+    adv = _advapi32()
+
+    func = adv.GetTokenInformation
+    func.argtypes = [
+        wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p,
+        wintypes.DWORD, ctypes.POINTER(wintypes.DWORD),
+    ]
+    func.restype = wintypes.BOOL
+
+    # Elevation flag
+    elev_buf = ctypes.c_uint32(0)
+    ret_len = wintypes.DWORD(0)
+    if not func(token_handle, TokenElevationInfo, ctypes.byref(elev_buf),
