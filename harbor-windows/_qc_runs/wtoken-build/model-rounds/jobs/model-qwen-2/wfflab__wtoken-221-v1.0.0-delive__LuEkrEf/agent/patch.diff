+    conv_func = adv.ConvertSidToStringSidW
+    conv_func.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_wchar_p)]
+    conv_func.restype = wintypes.BOOL
+    if not conv_func(sid_ptr, ctypes.byref(psid_str)):
