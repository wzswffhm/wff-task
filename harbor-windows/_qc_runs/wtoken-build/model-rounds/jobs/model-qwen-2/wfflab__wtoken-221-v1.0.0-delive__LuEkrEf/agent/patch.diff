 """Thin ctypes bindings for the token calls :mod:`wtoken` needs.
 
-Only what the current implementation actually calls is bound here; the library
-is loaded lazily so that importing the package stays cheap.
+Provides direct access to the Windows token APIs required for privilege
+auditing and adjustment.  The library is loaded lazily so that importing
+the package stays cheap.
 """
 
 import os
+import ctypes
+from ctypes import wintypes
 
 _IS_WINDOWS = os.name == "nt"
 
+# ── Constants ────────────────────────────────────────────────────────────────
+
+TOKEN_QUERY = 0x0008
+TOKEN_ADJUST_PRIVILEGES = 0x0020
+
+SE_PRIVILEGE_ENABLED = 0x00000002
+
+# TOKEN_INFORMATION_CLASS values
+TokenPrivilegesInfo = 3
+TokenElevationInfo = 20
+TokenElevationTypeInfo = 18
+TokenIntegrityLevelInfo = 25
+
+# Elevation types
+_ELEVATION_TYPE_NAMES = {
+    1: "default",
+    2: "full",
+    3: "limited",
+}
+
+# Well-known integrity SID sub-authorities (the last RID in S-1-16-XXXX)
+_INTEGRITY_LEVEL_NAMES = {
+    0: "untrusted",
+    4096: "low",
+    8192: "medium",
+    8448: "mediumplus",
+    12288: "high",
+    16384: "system",
+}
+
+
+# ── Structures ───────────────────────────────────────────────────────────────
+
+class LUID(ctypes.Structure):
+    _fields_ = [
+        ("LowPart", wintypes.DWORD),
+        ("HighPart", ctypes.c_long),
+    ]
+
+
+class LUID_AND_ATTRIBUTES(ctypes.Structure):
+    _fields_ = [
+        ("Luid", LUID),
+        ("Attributes", wintypes.DWORD),
+    ]
+
+
+class TOKEN_PRIVILEGES(ctypes.Structure):
+    _fields_ = [
+        ("PrivilegeCount", wintypes.DWORD),
+        ("Privileges", LUID_AND_ATTRIBUTES * 1),
+    ]
+
+
+# ── Helpers ──────────────────────────────────────────────────────────────────
 
 def is_windows():
     """Return ``True`` when running on a Windows kernel."""
@@ -15,38 +73,26 @@ def is_windows():
 
 
 def _advapi32():
-    import ctypes
-
     return ctypes.WinDLL("advapi32", use_last_error=True)
 
 
 def _kernel32():
-    import ctypes
-
     return ctypes.WinDLL("kernel32", use_last_error=True)
 
 
