+def lookup_privilege_value(name):
+    """Look up the LUID for a privilege name. Returns a LUID struct.
+
+    Raises OSError on failure.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("privilege lookups exist only on Windows")
+    luid = LUID()
+    func = _advapi32().LookupPrivilegeValueW
+    func.argtypes = [ctypes.c_wchar_p, ctypes.c_wchar_p, ctypes.POINTER(LUID)]
+    func.restype = ctypes.c_int  # BOOL
+    if not func(None, name, ctypes.byref(luid)):
+        raise OSError(last_error(), "LookupPrivilegeValueW failed for %r" % name)
+    return luid
+
+
+def lookup_privilege_name(luid):
+    """Look up the name for a privilege LUID. Returns a string.
+
+    Raises OSError on failure.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("privilege lookups exist only on Windows")
+    buf = ctypes.create_unicode_buffer(256)
+    size = ctypes.c_ulong(256)
+    func = _advapi32().LookupPrivilegeNameW
+    func.argtypes = [ctypes.c_wchar_p, ctypes.POINTER(LUID), ctypes.c_wchar_p, ctypes.POINTER(ctypes.c_ulong)]
+    func.restype = ctypes.c_int  # BOOL
+    if not func(None, ctypes.byref(luid), buf, ctypes.byref(size)):
+        raise OSError(last_error(), "LookupPrivilegeNameW failed")
+    return buf.value
+
+
+def get_token_privileges(token_handle):
+    """Return list of (LUID, attributes) for all privileges in the token."""
+    if not _IS_WINDOWS:
+        raise OSError("token queries exist only on Windows")
+
+    advapi = _advapi32()
+    func = advapi.GetTokenInformation
+    # First call to get required buffer size
+    ret_len = ctypes.c_ulong(0)
+    func.argtypes = [
+        ctypes.c_void_p,  # HANDLE
+        ctypes.c_int,     # TOKEN_INFORMATION_CLASS
+        ctypes.c_void_p,  # LPVOID
+        ctypes.c_ulong,   # DWORD
+        ctypes.POINTER(ctypes.c_ulong),  # PDWORD
+    ]
+    func.restype = ctypes.c_int  # BOOL
+
+    func(token_handle, TokenPrivileges, None, 0, ctypes.byref(ret_len))
+    # Expect ERROR_INSUFFICIENT_BUFFER (122)
+    err = last_error()
+    if ret_len.value == 0:
+        raise OSError(err or 0, "GetTokenInformation(TokenPrivileges) failed to get size")
+
+    buf = ctypes.create_string_buffer(ret_len.value)
+    if not func(token_handle, TokenPrivileges, buf, ret_len.value, ctypes.byref(ret_len)):
+        raise OSError(last_error(), "GetTokenInformation(TokenPrivileges) failed")
+
+    # Parse the returned buffer
+    # Layout: DWORD PrivilegeCount, then array of LUID_AND_ATTRIBUTES
+    count = ctypes.c_ulong.from_buffer_copy(buf, 0).value
+    offset = ctypes.sizeof(ctypes.c_ulong)
+    item_size = ctypes.sizeof(LUID_AND_ATTRIBUTES)
+
+    results = []
+    for i in range(count):
+        item = LUID_AND_ATTRIBUTES.from_buffer_copy(buf, offset + i * item_size)
+        results.append((item.Luid, item.Attributes))
+    return results
+
