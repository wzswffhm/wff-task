+def adjust_token_privileges(token_handle, luid, enable):
+    """Enable or disable a single privilege on the token.
+
+    Raises OSError on failure.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("privilege adjustment exists only on Windows")
+
+    class TP(ctypes.Structure):
+        _fields_ = [
+            ("PrivilegeCount", ctypes.c_ulong),
+            ("Luid", LUID),
+            ("Attributes", ctypes.c_ulong),
+        ]
+
+    tp = TP()
+    tp.PrivilegeCount = 1
+    tp.Luid.LowPart = luid.LowPart
+    tp.Luid.HighPart = luid.HighPart
+    tp.Attributes = SE_PRIVILEGE_ENABLED if enable else 0
+
+    advapi = _advapi32()
+    func = advapi.AdjustTokenPrivileges
+    func.argtypes = [
+        ctypes.c_void_p,   # TokenHandle
+        ctypes.c_int,      # DisableAllPrivileges
+        ctypes.POINTER(TP), # NewState
+        ctypes.c_ulong,    # BufferLength
+        ctypes.c_void_p,   # PreviousState
+        ctypes.POINTER(ctypes.c_ulong),  # ReturnLength
+    ]
+    func.restype = ctypes.c_int  # BOOL
+
+    ret_len = ctypes.c_ulong(0)
+    if not func(token_handle, False, ctypes.byref(tp), ctypes.sizeof(tp), None, ctypes.byref(ret_len)):
+        raise OSError(last_error(), "AdjustTokenPrivileges failed")
+
+    # AdjustTokenPrivileges can return TRUE but still fail; check GetLastError
+    err = last_error()
+    # ERROR_NOT_ALL_ASSIGNED (1300) means the privilege isn't held
+    if err and err != 0:
+        raise OSError(err, "AdjustTokenPrivileges reported error %d" % err)
+
+
+def get_token_elevation(token_handle):
+    """Return (is_elevated: bool, elevation_type: int)."""
+    if not _IS_WINDOWS:
+        raise OSError("elevation queries exist only on Windows")
+
+    advapi = _advapi32()
+    func = advapi.GetTokenInformation
+
+    # Get elevation
+    elev = TOKEN_ELEVATION()
+    ret_len = ctypes.c_ulong(0)
