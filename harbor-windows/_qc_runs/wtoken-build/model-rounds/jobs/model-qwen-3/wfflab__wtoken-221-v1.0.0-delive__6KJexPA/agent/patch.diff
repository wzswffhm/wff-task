+        ("Attributes", ctypes.c_ulong),
+    ]
+
+
+class TOKEN_PRIVILEGES(ctypes.Structure):
+    _fields_ = [
+        ("PrivilegeCount", ctypes.c_ulong),
+        ("Privileges", ctypes.ARRAY(LUID_AND_ATTRIBUTES, 1)),
+    ]
+
+
+class TOKEN_ELEVATION(ctypes.Structure):
