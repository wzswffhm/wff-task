+def get_token_integrity_level(token_handle):
+    """Return the integrity level RID from the token's mandatory label.
+
+    Returns an integer RID value.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("integrity queries exist only on Windows")
+
+    advapi = _advapi32()
+    func = advapi.GetTokenInformation
+
+    # First get size
+    ret_len = ctypes.c_ulong(0)
+    func.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_int,
+        ctypes.c_void_p,
+        ctypes.c_ulong,
+        ctypes.POINTER(ctypes.c_ulong),
+    ]
+    func.restype = ctypes.c_int
+
+    func(token_handle, TokenIntegrityLevel, None, 0, ctypes.byref(ret_len))
+    if ret_len.value == 0:
+        raise OSError(last_error(), "GetTokenInformation(TokenIntegrityLevel) failed to get size")
+
+    buf = ctypes.create_string_buffer(ret_len.value)
+    if not func(token_handle, TokenIntegrityLevel, buf, ret_len.value, ctypes.byref(ret_len)):
+        raise OSError(last_error(), "GetTokenInformation(TokenIntegrityLevel) failed")
+
+    # Use .raw to get a bytes object where indexing yields integers
+    raw = buf.raw
+
+    # TOKEN_MANDATORY_LABEL layout: SID_AND_ATTRIBUTES { PSID Sid; DWORD Attributes; }
+    # When returned by GetTokenInformation, the SID data is stored inline in
+    # the buffer and the PSID pointer points into the buffer itself.
+    sid_ptr = ctypes.c_void_p.from_buffer_copy(buf, 0).value
+    buf_addr = ctypes.addressof(buf)
+    sid_offset = sid_ptr - buf_addr
+
+    # SID structure: Revision(1 byte), SubAuthorityCount(1 byte),
+    #                IdentifierAuthority(6 bytes), SubAuthority[n](4 bytes each)
+    sub_auth_count = raw[sid_offset + 1]
+    if sub_auth_count < 1:
+        raise OSError(0, "Invalid integrity SID: no sub-authorities")
+
+    # The last sub-authority is the integrity RID
+    # SubAuthorities start at offset 8 within the SID
+    rid_offset = sid_offset + 8 + (sub_auth_count - 1) * 4
+    rid = ctypes.c_ulong.from_buffer_copy(raw, rid_offset).value
+    return rid
