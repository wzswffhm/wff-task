diff --git a/edge_tmp.py b/edge_tmp.py
new file mode 100644
index 0000000..1fdcc8b
--- /dev/null
+++ b/edge_tmp.py
@@ -0,0 +1,110 @@
+"""Throwaway edge-case harness."""
+import ctypes
+import gc
+import sys
+
+import wtoken
+from wtoken import _winapi
+
+FAILS = []
+
+
+def check(label, ok, extra=""):
+    print(("PASS " if ok else "FAIL ") + label + (" " + str(extra) if extra else ""))
+    if not ok:
+        FAILS.append(label)
+
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.GetProcessHandleCount.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong)]
+
+
+def handles():
+    n = ctypes.c_ulong()
+    k32.GetProcessHandleCount(k32.GetCurrentProcess(), ctypes.byref(n))
+    return n.value
+
+
+# unknown but well-formed luids
+for luid in (99999, 1, 0, 0xFFFFFFFF, (1 << 32) | 7):
+    try:
+        value = wtoken.privilege_name(luid)
+        print("   privilege_name(%d) -> %r" % (luid, value))
+    except wtoken.WTokenError as exc:
+        check("privilege_name(%d) kind=%s" % (luid, exc.kind), exc.kind == "badarg", exc)
+
+# luid of a privilege we do not hold still round-trips
+luid = wtoken.privilege_luid("SeTcbPrivilege")
+check("unheld-but-real name round-trips", wtoken.privilege_name(luid) == "SeTcbPrivilege",
+      luid)
+check("has_privilege('SeTcbPrivilege') is False",
+      wtoken.has_privilege("SeTcbPrivilege") is False)
+
+# default argument
+check("set_privilege default enables", wtoken.set_privilege("SeBackupPrivilege") is True)
+check("and can be turned off", wtoken.set_privilege("SeBackupPrivilege", False) is False)
+
+# case sensitivity of the system
+try:
+    l2 = wtoken.privilege_luid("sebackupprivilege")
+    check("lowercase name rejected by the system", False, l2)
+except wtoken.WTokenError as exc:
+    check("lowercase name kind=%s" % exc.kind, exc.kind == "badarg")
+
+# repeated calls: no handle leak
+before = handles()
+for _ in range(200):
+    wtoken.privileges()
+    wtoken.has_privilege("SeDebugPrivilege")
+    wtoken.elevation()
+    wtoken.integrity_level()
+    wtoken.set_privilege("SeBackupPrivilege", True)
+    wtoken.set_privilege("SeBackupPrivilege", False)
+gc.collect()
+after = handles()
+check("handle count does not grow", after - before <= 1, "before=%d after=%d" % (before, after))
+
+# non-Windows classification, simulated
+_winapi.IS_WINDOWS = False
+try:
+    for label, call in (
+        ("privileges", wtoken.privileges),
+        ("has_privilege", lambda: wtoken.has_privilege("SeBackupPrivilege")),
+        ("set_privilege", lambda: wtoken.set_privilege("SeBackupPrivilege", True)),
+        ("privilege_luid", lambda: wtoken.privilege_luid("SeBackupPrivilege")),
+        ("privilege_name", lambda: wtoken.privilege_name(17)),
+        ("elevation", wtoken.elevation),
+        ("integrity_level", wtoken.integrity_level),
+    ):
+        try:
+            call()
+            check("%s on a non-Windows kernel raises" % label, False)
+        except wtoken.WTokenError as exc:
+            check("%s on a non-Windows kernel kind=%s" % (label, exc.kind),
+                  exc.kind == "unsupported", exc)
+        except Exception as exc:
+            check("%s on a non-Windows kernel raises WTokenError" % label, False, repr(exc))
+finally:
+    _winapi.IS_WINDOWS = True
+
+# bad arguments are classified before any system call
+for label, call in (
+    ("set_privilege(None)", lambda: wtoken.set_privilege(None)),
+    ("set_privilege(name, 'yes')", lambda: wtoken.set_privilege("SeBackupPrivilege", "yes")),
+    ("has_privilege(5)", lambda: wtoken.has_privilege(5)),
+    ("privilege_luid(object())", lambda: wtoken.privilege_luid(object())),
+):
+    try:
+        call()
+        check("%s raises" % label, False)
+    except wtoken.WTokenError as exc:
+        check("%s kind=%s" % (label, exc.kind), exc.kind == "badarg", exc)
+
+# WTokenError keeps its documented shape
+err = wtoken.WTokenError("boom", kind="unsupported", privilege="SeXPrivilege")
+check("error kinds", wtoken.WTokenError.KINDS == ("unsupported", "os", "badarg"))
+check("error str carries the privilege", "SeXPrivilege" in str(err))
+
+print()
+print("FAILURES:", FAILS if FAILS else "none")
+sys.exit(1 if FAILS else 0)
diff --git a/probe_tmp.py b/probe_tmp.py
new file mode 100644
index 0000000..90a5876
--- /dev/null
+++ b/probe_tmp.py
@@ -0,0 +1,115 @@
+import ctypes
+import struct
+from ctypes import wintypes as w
+
+adv = ctypes.WinDLL("advapi32", use_last_error=True)
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+HANDLE = w.HANDLE
+BOOL = w.BOOL
+DWORD = w.DWORD
+LP = ctypes.c_void_p
+
+k32.GetCurrentProcess.restype = HANDLE
+tok = HANDLE()
+adv.OpenProcessToken.argtypes = [HANDLE, DWORD, ctypes.POINTER(HANDLE)]
+adv.OpenProcessToken.restype = BOOL
+print("open", adv.OpenProcessToken(k32.GetCurrentProcess(), 0x28, ctypes.byref(tok)),
+      ctypes.get_last_error())
+adv.GetTokenInformation.argtypes = [HANDLE, DWORD, LP, DWORD, ctypes.POINTER(DWORD)]
+adv.GetTokenInformation.restype = BOOL
+buf = ctypes.create_string_buffer(4096)
+ret = DWORD()
+print("privs", adv.GetTokenInformation(tok, 3, buf, 4096, ctypes.byref(ret)), ret.value)
+adv.LookupPrivilegeNameW.argtypes = [w.LPCWSTR, LP, w.LPWSTR, ctypes.POINTER(DWORD)]
+adv.LookupPrivilegeNameW.restype = BOOL
+
+cnt = struct.unpack_from("<I", buf.raw, 0)[0]
+print("count", cnt)
+for i in range(cnt):
+    off = 4 + i * 12
+    lo, hi, attr = struct.unpack_from("<Ili", buf.raw, off)
+    nm = ctypes.create_unicode_buffer(256)
+    cch = DWORD(256)
+    luid = ctypes.create_string_buffer(8)
+    ctypes.memmove(luid, buf.raw[off:off + 8], 8)
+    ok = adv.LookupPrivilegeNameW(None, luid, nm, ctypes.byref(cch))
+    print(ok, nm.value, attr, bool(attr & 2), lo, hi)
+
+# adjust
+class LUID(ctypes.Structure):
+    _fields_ = [("LowPart", DWORD), ("HighPart", w.LONG)]
+
+class TP1(ctypes.Structure):
+    _fields_ = [("PrivilegeCount", DWORD), ("Privileges", (LUID * 1))]
+
+adv.LookupPrivilegeValueW.argtypes = [w.LPCWSTR, w.LPCWSTR, ctypes.POINTER(LUID)]
+adv.LookupPrivilegeValueW.restype = BOOL
+adv.AdjustTokenPrivileges.argtypes = [HANDLE, BOOL, LP, DWORD, LP, ctypes.POINTER(DWORD)]
+adv.AdjustTokenPrivileges.restype = BOOL
+
+class TPx(ctypes.Structure):
+    _fields_ = [("PrivilegeCount", DWORD), ("Privileges", (ctypes.c_byte * 12) * 1)]
+
+def adjust(name, enable):
+    luid = LUID()
+    if not adv.LookupPrivilegeValueW(None, name, ctypes.byref(luid)):
+        return ("lookup failed", ctypes.get_last_error())
+    req = TPx()
+    req.PrivilegeCount = 1
+    struct.pack_into("<Ili", req.Privileges[0], 0, luid.LowPart, luid.HighPart,
+                     2 if enable else 0)
+    prev = ctypes.create_string_buffer(1024)
+    psz = DWORD()
+    ok = adv.AdjustTokenPrivileges(tok, False, ctypes.byref(req), 1024, prev, ctypes.byref(psz))
+    return ok, ctypes.get_last_error(), psz.value
+
+def read_state(name):
+    b = ctypes.create_string_buffer(4096)
+    r = DWORD()
+    adv.GetTokenInformation(tok, 3, b, 4096, ctypes.byref(r))
+    n = struct.unpack_from("<I", b.raw, 0)[0]
+    for i in range(n):
+        off = 4 + i * 12
+        lo, hi, attr = struct.unpack_from("<Ili", b.raw, off)
+        nm = ctypes.create_unicode_buffer(256)
+        cch = DWORD(256)
+        lu = ctypes.create_string_buffer(8)
+        ctypes.memmove(lu, b.raw[off:off + 8], 8)
+        adv.LookupPrivilegeNameW(None, lu, nm, ctypes.byref(cch))
+        if nm.value == name:
+            return attr
+    return None
+
+print("before:", read_state("SeBackupPrivilege"))
+print("enable:", adjust("SeBackupPrivilege", True), "after:", read_state("SeBackupPrivilege"))
+print("disable:", adjust("SeBackupPrivilege", False), "after:", read_state("SeBackupPrivilege"))
+print("bogus lookup:", adjust("SeNoSuchPrivilegeMadeUp", True))
+
+# elevation / integrity
+el = DWORD()
+print("elev", adv.GetTokenInformation(tok, 20, ctypes.byref(el), 4, ctypes.byref(ret)), el.value,
+      ctypes.get_last_error())
+et = ctypes.c_int()
+print("elevtype", adv.GetTokenInformation(tok, 18, ctypes.byref(et), 4, ctypes.byref(ret)),
+      et.value, ctypes.get_last_error())
+sz = DWORD()
+adv.GetTokenInformation(tok, 25, None, 0, ctypes.byref(sz))
+print("integrity size:", sz.value, ctypes.get_last_error())
+b2 = ctypes.create_string_buffer(sz.value or 64)
+print("integrity read", adv.GetTokenInformation(tok, 25, b2, sz.value or 64, ctypes.byref(ret)),
+      ret.value, ctypes.get_last_error())
+sid = struct.unpack_from("<Q", b2.raw, 0)[0]
+adv.GetSidSubAuthorityCount.argtypes = [LP]
+adv.GetSidSubAuthorityCount.restype = ctypes.POINTER(ctypes.c_ubyte)
+n = adv.GetSidSubAuthorityCount(sid).contents.value
+adv.GetSidSubAuthority.argtypes = [LP, DWORD]
+adv.GetSidSubAuthority.restype = ctypes.POINTER(DWORD)
+print("subauths", n, "rid", adv.GetSidSubAuthority(sid, n - 1).contents.value)
+ps = LP()
+adv.ConvertSidToStringSidW.argtypes = [LP, ctypes.POINTER(LP)]
+adv.ConvertSidToStringSidW.restype = BOOL
+print("sddl ok", adv.ConvertSidToStringSidW(sid, ctypes.byref(ps)), ctypes.get_last_error())
+print("sddl", ctypes.wstring_at(ps))
+k32.LocalFree.argtypes = [LP]
+k32.LocalFree(ps)
+k32.CloseHandle(tok)
