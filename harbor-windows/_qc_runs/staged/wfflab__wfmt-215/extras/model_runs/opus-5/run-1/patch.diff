@@ -0,0 +1,31 @@
+import sys
+sys.path.insert(0, '.')
+import wfmt
+import struct
+
+# Test current implementation
+data = open('assets/sample.wfmt', 'rb').read()
+print('Sample file length:', len(data))
+print('First 30 bytes:', repr(data[:30]))
+print('Last 10 bytes:', repr(data[-10:]))
+
+# Parse header manually
+magic = data[0:4]
+version = data[4]
+count_be = struct.unpack('>I', data[5:9])[0]
+print(f'\nHeader: magic={magic}, version={version}, count={count_be}')
+
+# Try to verify
+result = wfmt.verify(data)
+print('\nverify() result:', result)
+
+# Try to unpack
+try:
+    records = wfmt.unpack(data)
+    print('unpack() succeeded with', len(records), 'records')
+    for i, (tag, payload) in enumerate(records):
+        print(f'  Record {i}: tag={tag}, payload_len={len(payload)}, preview={payload[:20]}')
+except Exception as e:
+    print('unpack() failed:', type(e).__name__, str(e))
+    import traceback
+    traceback.print_exc()
diff --git a/decode_all.py b/decode_all.py
new file mode 100644
index 0000000..5d1b48c
--- /dev/null
+++ b/decode_all.py
@@ -0,0 +1,51 @@
+data = open('assets/sample.wfmt', 'rb').read()
+print('File size:', len(data))
+print()
+
+# Manual parse with proper varint
+def decode_varint(data, pos):
+    result = 0
+    shift = 0
+    while True:
+        if pos >= len(data):
+            return None, pos
+        byte = data[pos]
+        pos += 1
+        result |= (byte & 0x7F) << shift
+        if not (byte & 0x80):
+            return result, pos
+        shift += 7
+
+pos = 9
+rec_num = 0
+while pos < len(data) - 4:  # Stop before CRC
+    start_pos = pos
+    tag, pos = decode_varint(data, pos)
+    if tag is None:
+        break
+    length, pos = decode_varint(data, pos)
+    if length is None:
+        break
+    payload_start = pos
+    payload_end = pos + length
+    
+    print(f'Record {rec_num}:')
+    print(f'  Position: {start_pos}')
+    print(f'  Tag: {tag}')
+    print(f'  Length: {length}')
+    print(f'  Payload range: {payload_start}-{payload_end}')
+    if payload_end <= len(data) - 4:
+        payload = data[pos:payload_end]
+        print(f'  Payload preview: {repr(payload[:40])}')
+        pos = payload_end
+    else:
+        print(f'  ERROR: Payload extends past CRC boundary!')
+        break
+    
+    rec_num += 1
+    if rec_num > 10:
+        break
+
+print()
+print(f'Final position: {pos}')
+print(f'CRC position: {len(data) - 4}')
