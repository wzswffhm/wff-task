+def decode_varint_proper(data, pos):
+    result = 0
+    shift = 0
+    while True:
+        if pos >= len(data):
+            raise ValueError('truncated')
+        byte = data[pos]
+        pos += 1
+        result |= (byte & 0x7F) << shift
+        if not (byte & 0x80):
+            return result, pos
+        shift += 7
+
+data = open('assets/sample.wfmt', 'rb').read()
+
+# Parse records manually
+pos = 9
+for i in range(5):
+    tag, pos = decode_varint_proper(data, pos)
+    length, pos = decode_varint_proper(data, pos)
+    payload = data[pos:pos+length]
+    pos += length
+    print(f'Record {i}: tag={tag}, len={length}, payload={repr(payload[:30])}')
+    
+print(f'\nEnded at position {pos}, file has {len(data)} bytes, CRC starts at {len(data)-4}')
diff --git a/test_alignment.py b/test_alignment.py
new file mode 100644
index 0000000..5691477
--- /dev/null
+++ b/test_alignment.py
@@ -0,0 +1,42 @@
+data = open('assets/sample.wfmt', 'rb').read()
+
+def decode_varint(data, pos):
+    result = 0
+    shift = 0
+    while pos < len(data):
+        byte = data[pos]
+        pos += 1
+        result |= (byte & 0x7F) << shift
+        if not (byte & 0x80):
+            return result, pos
+        shift += 7
+    return None, pos
+
+def align_up(pos, align):
+    return (pos + align - 1) // align * align
+
+# Parse with 4-byte alignment
+pos = 9
+ALIGN = 4
+for i in range(5):
+    print(f'Record {i} at position {pos}:')
+    tag, pos = decode_varint(data, pos)
+    length, pos = decode_varint(data, pos)
+    payload = data[pos:pos+length]
+    pos += length
+    
+    print(f'  Tag: {tag}, Length: {length}')
+    print(f'  Payload: {repr(payload[:40])}')
+    print(f'  End position (before align): {pos}')
+    
+    # Apply alignment
+    aligned_pos = align_up(pos, ALIGN)
+    print(f'  Aligned position: {aligned_pos}')
+    pos = aligned_pos
+    print()
+    
+    if pos >= len(data) - 4:
+        break
+
+print(f'Final position: {pos}')
+print(f'CRC starts at: {len(data) - 4}')
diff --git a/test_mixed.py b/test_mixed.py
new file mode 100644
index 0000000..954b991
--- /dev/null
+++ b/test_mixed.py
@@ -0,0 +1,51 @@
+import struct
+
+data = open('assets/sample.wfmt', 'rb').read()
+
+def decode_varint(data, pos):
+    result = 0
+    shift = 0
+    while pos < len(data):
+        byte = data[pos]
+        pos += 1
+        result |= (byte & 0x7F) << shift
+        if not (byte & 0x80):
+            return result, pos
+        shift += 7
+    return None, pos
+
+def align_up(pos, align):
+    return (pos + align - 1) // align * align
+
+# Parse with tag=varint, length=u32 LE
+pos = 9
+ALIGN = 4
+for i in range(6):
+    print(f'Record {i} at position {pos}:')
+    tag, pos = decode_varint(data, pos)
+    if pos + 4 > len(data) - 4:
+        print(f'  Not enough data for length')
+        break
+    length = struct.unpack('<I', data[pos:pos+4])[0]
+    pos += 4
+    
+    if pos + length > len(data) - 4:
+        print(f'  Tag: {tag}, Length: {length} (would overflow!)')
+        break
+        
+    payload = data[pos:pos+length]
+    pos += length
+    
+    print(f'  Tag: {tag}, Length: {length}')
+    print(f'  Payload: {repr(payload[:40])}')
+    
+    # Apply alignment
+    aligned_pos = align_up(pos, ALIGN)
+    print(f'  Position after alignment: {aligned_pos}')
+    pos = aligned_pos
+    print()
+    
+    if pos >= len(data) - 4:
+        break
+
+print(f'Final position: {pos}, CRC at: {len(data) - 4}')
