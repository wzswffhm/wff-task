+import struct
+import zlib
+
+# Read sample
+data = open('assets/sample.wfmt', 'rb').read()
+print(f'Total length: {len(data)} bytes\n')
+
+# Parse header
+magic = data[0:4]
+version = data[4]
+count_le = struct.unpack('<I', data[5:9])[0]
+count_be = struct.unpack('>I', data[5:9])[0]
+
+print(f'Magic: {magic}')
+print(f'Version: {version}')
+print(f'Count (little-endian): {count_le}')
+print(f'Count (big-endian): {count_be}')
+
+# Check CRC
+body = data[:-4]
+crc_bytes = data[-4:]
+crc_stored = struct.unpack('<I', crc_bytes)[0]
+crc_std = zlib.crc32(body) & 0xFFFFFFFF
+
+print(f'\nLast 4 bytes (CRC): {crc_bytes.hex()}')
+print(f'Stored CRC: 0x{crc_stored:08x}')
+print(f'Standard CRC-32: 0x{crc_std:08x}')
+print(f'Match: {crc_stored == crc_std}')
+
+# Look at records area
+print(f'\nBytes after header:')
+pos = 9
+for i in range(min(80, len(data) - 9)):
+    if i % 16 == 0:
+        print(f'  {pos+i:3d}: ', end='')
+    b = data[pos + i]
+    print(f'{b:02x} ', end='')
+    if (i + 1) % 16 == 0:
+        print()
+if (len(data) - 9) % 16 != 0:
+    print()
+
+# Test varint decoding
+print(f'\nTesting varint at position 9:')
+print(f'  Byte: 0x{data[9]:02x} = {data[9]}')
+print(f'  Has continuation bit: {bool(data[9] & 0x80)}')
+print(f'  Value bits: {data[9] & 0x7f}')
