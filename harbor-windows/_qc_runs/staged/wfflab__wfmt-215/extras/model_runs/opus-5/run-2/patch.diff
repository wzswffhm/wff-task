+#!/usr/bin/env python3
+import struct
+
+data = open('assets/sample.wfmt', 'rb').read()
+
+def decode_varint(data, pos):
+    result = 0
+    shift = 0
+    while pos < len(data):
+        byte = data[pos]
+        pos += 1
+        result |= (byte & 0x7F) << shift
+        if (byte & 0x80) == 0:
+            return result, pos
+        shift += 7
+        if shift > 63:
+            raise ValueError('varint overflow')
+    raise ValueError('truncated')
+
+print('File length:', len(data))
+print('Checksum starts at:', len(data) - 4)
+print()
+
+# Parse until we hit the checksum
+pos = 9
+end = len(data) - 4
+records = []
+
+print('Parsing records with varint:')
+record_num = 0
+while pos < end:
+    print(f'\nRecord {record_num} at position {pos}:')
+    try:
+        tag_start = pos
+        tag, pos = decode_varint(data, pos)
+        print(f'  tag={tag} (bytes: {data[tag_start:pos].hex()})')
+        
+        len_start = pos
+        length, pos = decode_varint(data, pos)
+        print(f'  length={length} (bytes: {data[len_start:pos].hex()})')
+        
+        if pos + length > end:
+            print(f'  ERROR: payload would extend to {pos+length}, but body ends at {end}')
+            break
+            
+        payload = data[pos:pos+length]
+        pos += length
+        records.append((tag, payload))
+        print(f'  payload ({length} bytes): {payload[:50]}')
+        print(f'  next position: {pos}')
+        record_num += 1
+    except Exception as e:
+        print(f'  ERROR: {e}')
+        break
+
+print(f'\nParsed {len(records)} records')
+print(f'Final position: {pos}')
+print(f'Expected end: {end}')
+print(f'Match: {pos == end}')
+
+# Verify CRC
+if pos == end:
+    body = data[:end]
+    crc = 0xFFFFFFFF
+    poly = 0xEDB88320
+    for byte in body:
+        crc ^= byte
+        for _ in range(8):
+            if crc & 1:
+                crc = (crc >> 1) ^ poly
+            else:
+                crc >>= 1
+    computed = crc ^ 0xFFFFFFFF
+    expected = struct.unpack('<I', data[-4:])[0]
+    print(f'\nCRC computed: {computed:08x}')
+    print(f'CRC expected: {expected:08x}')
+    print(f'CRC match: {computed == expected}')
