+#!/usr/bin/env python3
+import struct
+
+data = open('assets/sample.wfmt', 'rb').read()
+
+print('Detailed byte analysis:')
+print()
+print('Record 0 at pos 9:')
+print('  bytes:', data[9:16].hex())
+print('  tag=0x01, len=0x05, payload=', data[11:16])
+print()
+
+print('Record 1 at pos 16:')
+print('  bytes:', data[16:20].hex())
+print('  tag=0x00, len=0x02, payload=', data[18:20].hex())
+print()
+
+print('Record 2 at pos 20:')
+print('  bytes 20-30:', data[20:30].hex())
+print('  byte 20 (tag?):', hex(data[20]))
+print('  byte 21:', hex(data[21]), '=', bin(data[21]))
+print('  byte 22:', hex(data[22]))
+print()
+
+# Maybe length is single byte and 0xac means something else?
+# Or maybe the format changed and it's tag=u8, length=u8?
+print('Testing: tag=u8, length=u8')
+pos = 9
+end = len(data) - 4
+count = 5
+
+for i in range(min(count, 10)):
+    if pos >= end:
+        print(f'Reached end at position {pos}')
+        break
+    print(f'Record {i} at pos {pos}:')
+    tag = data[pos]
+    length = data[pos+1]
+    print(f'  tag={tag}, length={length}')
+    if pos + 2 + length > end:
+        print(f'  ERROR: would extend to {pos + 2 + length}')
+        break
+    payload = data[pos+2:pos+2+length]
+    print(f'  payload: {payload[:50]}')
+    pos += 2 + length
+
+print()
+print(f'Final position: {pos}, expected: {end}, match: {pos == end}')
