new file mode 100644
index 0000000..7d19317
--- /dev/null
+++ b/wspawn/_create.py
@@ -0,0 +1,277 @@
+"""Process creation with a restricted handle table."""
+
+import ctypes
+import subprocess
+
+from . import _winapi
+
+# ---------------------------------------------------------------- types
+
+HANDLE = _winapi.HANDLE
+DWORD = _winapi.DWORD
+BOOL = _winapi.BOOL
+WORD = _winapi.WORD
+LPVOID = _winapi.LPVOID
+LPWSTR = _winapi.LPWSTR
+SIZE_T = _winapi.SIZE_T
+
+# ---------------------------------------------------------------- constants
+
+STARTF_USESTDHANDLES = 0x00000100
+CREATE_UNICODE_ENVIRONMENT = 0x00000400
+EXTENDED_STARTUPINFO_PRESENT = 0x00080000
+
+PROC_THREAD_ATTRIBUTE_HANDLE_LIST = 0x00020002
+
+INFINITE = 0xFFFFFFFF
+WAIT_OBJECT_0 = 0x00000000
+WAIT_TIMEOUT = 0x00000102
+WAIT_FAILED = 0xFFFFFFFF
+
+STILL_ACTIVE = 259
+
+_CACHE = {}
+
+
+# ---------------------------------------------------------------- structures
+
+
+class STARTUPINFOW(ctypes.Structure):
+    _fields_ = [
+        ("cb", DWORD),
+        ("lpReserved", LPWSTR),
+        ("lpDesktop", LPWSTR),
+        ("lpTitle", LPWSTR),
+        ("dwX", DWORD),
+        ("dwY", DWORD),
+        ("dwXSize", DWORD),
+        ("dwYSize", DWORD),
+        ("dwXCountChars", DWORD),
+        ("dwYCountChars", DWORD),
+        ("dwFillAttribute", DWORD),
+        ("dwFlags", DWORD),
+        ("wShowWindow", WORD),
+        ("cbReserved2", WORD),
+        ("lpReserved2", LPVOID),
+        ("hStdInput", HANDLE),
+        ("hStdOutput", HANDLE),
+        ("hStdError", HANDLE),
+    ]
+
+
+class STARTUPINFOEXW(ctypes.Structure):
+    _fields_ = [
+        ("StartupInfo", STARTUPINFOW),
+        ("lpAttributeList", LPVOID),
+    ]
+
+
+class PROCESS_INFORMATION(ctypes.Structure):
+    _fields_ = [
+        ("hProcess", HANDLE),
+        ("hThread", HANDLE),
+        ("dwProcessId", DWORD),
+        ("dwThreadId", DWORD),
+    ]
+
+
+# ---------------------------------------------------------------- API
+
+
+class _ProcessApi(object):
+    """Prototypes for the process-level ``kernel32`` entry points."""
+
+    def __init__(self):
+        dll = _winapi.kernel32()
+
+        self.InitializeProcThreadAttributeList = dll.InitializeProcThreadAttributeList
+        self.InitializeProcThreadAttributeList.argtypes = [
+            LPVOID, DWORD, DWORD, ctypes.POINTER(SIZE_T),
+        ]
+        self.InitializeProcThreadAttributeList.restype = BOOL
+
+        self.UpdateProcThreadAttribute = dll.UpdateProcThreadAttribute
+        self.UpdateProcThreadAttribute.argtypes = [
+            LPVOID, DWORD, SIZE_T, LPVOID, SIZE_T, LPVOID, LPVOID,
+        ]
+        self.UpdateProcThreadAttribute.restype = BOOL
+
+        self.DeleteProcThreadAttributeList = dll.DeleteProcThreadAttributeList
+        self.DeleteProcThreadAttributeList.argtypes = [LPVOID]
+        self.DeleteProcThreadAttributeList.restype = None
+
+        self.CreateProcessW = dll.CreateProcessW
+        self.CreateProcessW.argtypes = [
+            LPWSTR, LPWSTR, LPVOID, LPVOID, BOOL, DWORD, LPVOID, LPWSTR,
+            LPVOID, ctypes.POINTER(PROCESS_INFORMATION),
+        ]
+        self.CreateProcessW.restype = BOOL
+
+        self.WaitForSingleObject = dll.WaitForSingleObject
+        self.WaitForSingleObject.argtypes = [HANDLE, DWORD]
+        self.WaitForSingleObject.restype = DWORD
+
+        self.GetExitCodeProcess = dll.GetExitCodeProcess
+        self.GetExitCodeProcess.argtypes = [HANDLE, ctypes.POINTER(DWORD)]
+        self.GetExitCodeProcess.restype = BOOL
+
+        self.TerminateProcess = dll.TerminateProcess
+        self.TerminateProcess.argtypes = [HANDLE, ctypes.c_uint]
+        self.TerminateProcess.restype = BOOL
+
+
+def api():
+    """Return the cached process-level API prototypes."""
+    bound = _CACHE.get("process_api")
+    if bound is None:
+        bound = _ProcessApi()
+        _CACHE["process_api"] = bound
+    return bound
+
+
+# ---------------------------------------------------------------- attribute lists
+
+
+def build_attribute_list(handle_array):
+    """Allocate and populate an attribute list with ``HANDLE_LIST``.
+
+    Returns ``(buffer, attribute_list_ptr)``.  The buffer is a ctypes array
+    that must be kept alive for as long as the caller needs the pointer; when
+    that is no longer true, pass the pointer to ``release_attribute_list()``.
+    """
+    handle_count = len(handle_array)
+    attribute_count = 1
+
+    # Ask for the required buffer size.
+    size = SIZE_T(0)
+    api().InitializeProcThreadAttributeList(None, DWORD(attribute_count), DWORD(0), ctypes.byref(size))
+
+    # Allocate the buffer.
+    buffer = (ctypes.c_byte * size.value)()
+    list_ptr = ctypes.cast(buffer, LPVOID)
+
+    # Initialize the structure.
+    if not api().InitializeProcThreadAttributeList(
+        list_ptr, DWORD(attribute_count), DWORD(0), ctypes.byref(size)
+    ):
+        raise _winapi.win_error()
+
+    # Add the handle list attribute.
+    handle_type = HANDLE * handle_count
+    handle_buffer = handle_type(*[HANDLE(h) for h in handle_array])
+    if not api().UpdateProcThreadAttribute(
+        list_ptr,
+        DWORD(0),
+        SIZE_T(PROC_THREAD_ATTRIBUTE_HANDLE_LIST),
+        ctypes.cast(handle_buffer, LPVOID),
+        SIZE_T(ctypes.sizeof(handle_buffer)),
+        None,
+        None,
+    ):
+        api().DeleteProcThreadAttributeList(list_ptr)
+        raise _winapi.win_error()
+
+    # The caller needs to keep both buffers alive.
+    return buffer, handle_buffer, _winapi.handle_value(list_ptr)
+
+
+def release_attribute_list(list_ptr):
+    """Clean up an attribute list pointer returned by ``build_attribute_list``."""
+    api().DeleteProcThreadAttributeList(LPVOID(list_ptr))
+
+
+# ---------------------------------------------------------------- process creation
+
+
+def create_process(command_line, inherit_list, std_input, std_output, std_error):
+    """Create a process with an explicit handle table and standard handles.
+
+    *command_line* is the full command line string (see ``list2cmdline``).
+    *inherit_list* is the iterable of handle values to pass to the child, or
+    ``None`` to pass no handles at all.  *std_{input,output,error}* are the
+    standard handles for the child, or ``0`` to leave them disconnected.
+
+    Returns ``(process_handle, pid)``. The caller is responsible for calling
+    ``close_handle(process_handle)`` when finished with it.
+    """
+    si_ex = STARTUPINFOEXW()
+    si_ex.StartupInfo.cb = ctypes.sizeof(STARTUPINFOEXW)
+
+    # Always set standard handles explicitly so we do not inherit whatever
+    # the parent has by default.
+    si_ex.StartupInfo.dwFlags = STARTF_USESTDHANDLES
+    si_ex.StartupInfo.hStdInput = HANDLE(std_input)
+    si_ex.StartupInfo.hStdOutput = HANDLE(std_output)
+    si_ex.StartupInfo.hStdError = HANDLE(std_error)
+
+    pi = PROCESS_INFORMATION()
+    creation_flags = 0
+    inherit_handles = False
+
+    # If the caller wants specific handles, attach the handle list.
+    attribute_buffer = None
+    handle_buffer = None
+    list_ptr = None
+    try:
+        if inherit_list:
+            inherit_handles = True
+            creation_flags |= EXTENDED_STARTUPINFO_PRESENT
+            attribute_buffer, handle_buffer, list_ptr = build_attribute_list(inherit_list)
+            si_ex.lpAttributeList = LPVOID(list_ptr)
+
+        # Mutable wide string buffer for the command line.
+        command_buffer = ctypes.create_unicode_buffer(command_line)
+
+        # Create the process.
+        if not api().CreateProcessW(
+            None,
+            command_buffer,
+            None,
+            None,
+            BOOL(1 if inherit_handles else 0),
+            DWORD(creation_flags),
+            None,
+            None,
+            ctypes.cast(ctypes.byref(si_ex), LPVOID),
+            ctypes.byref(pi),
+        ):
+            raise _winapi.win_error()
+
+    finally:
+        if list_ptr is not None:
+            release_attribute_list(list_ptr)
+
+    # Close the thread handle immediately; the caller only needs the process.
+    _winapi.close_handle(_winapi.handle_value(pi.hThread))
+
+    return _winapi.handle_value(pi.hProcess), pi.dwProcessId
+
+
+def wait_process(handle, timeout_ms):
+    """Wait up to *timeout_ms* for the process to exit, or ``INFINITE``.
+
+    Returns ``True`` if the process exited, ``False`` if the timeout expired.
+    """
+    result = api().WaitForSingleObject(HANDLE(handle), DWORD(timeout_ms))
+    if result == WAIT_FAILED:
+        raise _winapi.win_error()
+    return result == WAIT_OBJECT_0
+
+
+def exit_code(handle):
+    """Return the current exit code of a process (``STILL_ACTIVE`` if running)."""
+    code = DWORD(0)
+    if not api().GetExitCodeProcess(HANDLE(handle), ctypes.byref(code)):
+        raise _winapi.win_error()
+    return int(code.value)
+
+
+def terminate_process(handle, exit_code_value):
+    """Terminate a process with the given exit code."""
+    if not api().TerminateProcess(HANDLE(handle), ctypes.c_uint(exit_code_value)):
+        raise _winapi.win_error()
+
+
+def list2cmdline(argv):
+    """Build a command line string in the way ``CreateProcessW`` expects it."""
+    return subprocess.list2cmdline(argv)
