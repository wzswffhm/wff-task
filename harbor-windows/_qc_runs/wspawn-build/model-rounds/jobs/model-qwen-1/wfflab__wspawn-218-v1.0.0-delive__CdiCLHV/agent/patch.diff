--- a/wspawn/_winapi.py
+++ b/wspawn/_winapi.py
@@ -5,6 +5,8 @@ loaded lazily so that importing the package stays cheap.
 """
 
 import os
+import ctypes
+from ctypes import wintypes
 
 FILE_TYPE_UNKNOWN = 0x0000
 FILE_TYPE_DISK = 0x0001
@@ -12,6 +14,20 @@ FILE_TYPE_CHAR = 0x0002
 FILE_TYPE_PIPE = 0x0003
 FILE_TYPE_REMOTE = 0x8000
 
+HANDLE_FLAG_INHERIT = 0x00000001
+HANDLE_FLAG_PROTECT_FROM_CLOSE = 0x00000002
+
+DUPLICATE_SAME_ACCESS = 0x00000002
+DUPLICATE_CLOSE_SOURCE = 0x00000001
+
+INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
+
+PROC_THREAD_ATTRIBUTE_HANDLE_LIST = 0x00020002
+
+EXTENDED_STARTUPINFO_PRESENT = 0x00080000
+
+CREATE_UNICODE_ENVIRONMENT = 0x00000400
+
 _IS_WINDOWS = os.name == "nt"
 
 
@@ -21,19 +37,417 @@ def is_windows():
 
 
 def _kernel32():
-    import ctypes
-
     return ctypes.WinDLL("kernel32", use_last_error=True)
 
 
+def _handle_to_int(h):
+    """Safely convert a ctypes HANDLE (c_void_p) to an int, treating None as 0."""
+    if h is None:
+        return 0
+    if isinstance(h, int):
+        return h
+    # c_void_p instance
+    v = h.value if hasattr(h, 'value') else h
+    return int(v) if v is not None else 0
+
+
+# ---------------------------------------------------------------------------
+# GetFileType
+# ---------------------------------------------------------------------------
+
 def file_type(handle):
     """Return the ``GetFileType`` value for an object handle."""
     if not _IS_WINDOWS:
         raise OSError("GetFileType is only available on Windows")
-    import ctypes
-    from ctypes import wintypes
-
-    func = _kernel32().GetFileType
+    k = _kernel32()
+    func = k.GetFileType
     func.argtypes = [wintypes.HANDLE]
     func.restype = wintypes.DWORD
-    return int(func(wintypes.HANDLE(int(handle))))
+    result = func(wintypes.HANDLE(int(handle)))
+    return int(result)
+
+
+# ---------------------------------------------------------------------------
+# GetHandleInformation / SetHandleInformation
+# ---------------------------------------------------------------------------
+
+def get_handle_information(handle):
+    """Return the flags for *handle* via ``GetHandleInformation``.
+
+    Raises ``OSError`` on failure (check ``ctypes.get_last_error()``).
+    """
+    k = _kernel32()
+    func = k.GetHandleInformation
+    func.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+    func.restype = wintypes.BOOL
+    flags = wintypes.DWORD()
+    ok = func(wintypes.HANDLE(int(handle)), ctypes.byref(flags))
+    if not ok:
+        err = ctypes.get_last_error()
+        raise OSError(err, "GetHandleInformation failed")
+    return int(flags.value)
+
+
+def set_handle_information(handle, mask, flags):
+    """Call ``SetHandleInformation`` on *handle*.
+
+    *mask* selects which bits to modify; *flags* supplies the new values for
+    those bits.  Raises ``OSError`` on failure.
+    """
+    k = _kernel32()
+    func = k.SetHandleInformation
+    func.argtypes = [wintypes.HANDLE, wintypes.DWORD, wintypes.DWORD]
+    func.restype = wintypes.BOOL
+    ok = func(wintypes.HANDLE(int(handle)), wintypes.DWORD(mask), wintypes.DWORD(flags))
+    if not ok:
+        err = ctypes.get_last_error()
+        raise OSError(err, "SetHandleInformation failed")
+
+
+# ---------------------------------------------------------------------------
+# DuplicateHandle
+# ---------------------------------------------------------------------------
+
+def duplicate_handle(source_handle, target_process=None, desired_access=0,
+                     inheritable=False, options=DUPLICATE_SAME_ACCESS):
+    """Duplicate *source_handle* into *target_process*.
+
+    Returns the new handle value as an integer.
+    """
+    k = _kernel32()
+    func = k.DuplicateHandle
+    func.argtypes = [
+        wintypes.HANDLE,   # hSourceProcessHandle
+        wintypes.HANDLE,   # hSourceHandle
+        wintypes.HANDLE,   # hTargetProcessHandle
+        ctypes.POINTER(wintypes.HANDLE),  # lpTargetHandle
+        wintypes.DWORD,    # dwDesiredAccess
+        wintypes.BOOL,     # bInheritHandle
+        wintypes.DWORD,    # dwOptions
+    ]
+    func.restype = wintypes.BOOL
+
+    if target_process is None:
+        target_process = get_current_process()
+
+    target = wintypes.HANDLE()
+    ok = func(
+        get_current_process(),
+        wintypes.HANDLE(int(source_handle)),
+        wintypes.HANDLE(int(target_process)),
+        ctypes.byref(target),
+        wintypes.DWORD(desired_access),
+        wintypes.BOOL(inheritable),
+        wintypes.DWORD(options),
+    )
+    if not ok:
+        err = ctypes.get_last_error()
+        raise OSError(err, "DuplicateHandle failed")
+    return _handle_to_int(target)
+
+
+def get_current_process():
+    """Return the pseudo-handle for the current process."""
+    k = _kernel32()
+    func = k.GetCurrentProcess
+    func.argtypes = []
+    func.restype = wintypes.HANDLE
+    return _handle_to_int(func())
+
+
+def close_handle(handle):
+    """Close a Windows handle."""
+    k = _kernel32()
+    func = k.CloseHandle
+    func.argtypes = [wintypes.HANDLE]
+    func.restype = wintypes.BOOL
+    ok = func(wintypes.HANDLE(int(handle)))
+    if not ok:
+        err = ctypes.get_last_error()
+        raise OSError(err, "CloseHandle failed")
+
+
+# ---------------------------------------------------------------------------
+# STARTUPINFOEX + PROC_THREAD_ATTRIBUTE_HANDLE_LIST
+# ---------------------------------------------------------------------------
+
+class _STARTUPINFOW(ctypes.Structure):
+    _fields_ = [
+        ("cb", wintypes.DWORD),
+        ("lpReserved", wintypes.LPWSTR),
+        ("lpDesktop", wintypes.LPWSTR),
+        ("lpTitle", wintypes.LPWSTR),
+        ("dwX", wintypes.DWORD),
+        ("dwY", wintypes.DWORD),
+        ("dwXSize", wintypes.DWORD),
+        ("dwYSize", wintypes.DWORD),
+        ("dwXCountChars", wintypes.DWORD),
+        ("dwYCountChars", wintypes.DWORD),
+        ("dwFillAttribute", wintypes.DWORD),
+        ("dwFlags", wintypes.DWORD),
+        ("wShowWindow", wintypes.WORD),
+        ("cbReserved2", wintypes.WORD),
