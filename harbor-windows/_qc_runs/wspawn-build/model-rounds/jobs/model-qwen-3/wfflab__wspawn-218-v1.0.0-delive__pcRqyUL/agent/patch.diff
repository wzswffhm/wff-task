+def get_handle_information(handle):
+    """Return the flags for *handle* via ``GetHandleInformation``.
+
+    Raises ``OSError`` on failure.
+    """
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = _kernel32()
+    func = k32.GetHandleInformation
+    func.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+    func.restype = wintypes.BOOL
+
+    flags = wintypes.DWORD()
+    ok = func(wintypes.HANDLE(int(handle)), ctypes.byref(flags))
+    if not ok:
+        raise ctypes.WinError(ctypes.get_last_error())
+    return flags.value
+
+
+def set_handle_information(handle, mask, flags):
+    """Call ``SetHandleInformation`` for *handle*.
+
+    *mask* selects which flag bits to modify; *flags* supplies the new values
+    for those bits.  Raises ``OSError`` on failure.
+    """
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = _kernel32()
+    func = k32.SetHandleInformation
+    func.argtypes = [wintypes.HANDLE, wintypes.DWORD, wintypes.DWORD]
+    func.restype = wintypes.BOOL
+
+    ok = func(
+        wintypes.HANDLE(int(handle)),
+        wintypes.DWORD(mask),
+        wintypes.DWORD(flags),
+    )
+    if not ok:
+        raise ctypes.WinError(ctypes.get_last_error())
+
+
+def get_console_mode(handle):
+    """Return the console mode for *handle*, or raise ``OSError``.
+
+    This can be used to determine whether a CHAR-type handle is a console.
+    """
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = _kernel32()
+    func = k32.GetConsoleMode
+    func.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+    func.restype = wintypes.BOOL
+
+    mode = wintypes.DWORD()
+    ok = func(wintypes.HANDLE(int(handle)), ctypes.byref(mode))
+    if not ok:
+        raise ctypes.WinError(ctypes.get_last_error())
+    return mode.value
+
+
+def close_handle(handle):
+    """Close a Windows handle. Raises ``OSError`` on failure."""
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = _kernel32()
+    func = k32.CloseHandle
+    func.argtypes = [wintypes.HANDLE]
+    func.restype = wintypes.BOOL
+
+    ok = func(wintypes.HANDLE(int(handle)))
+    if not ok:
+        raise ctypes.WinError(ctypes.get_last_error())
+
+
+# ---------- STARTUPINFOEX + PROC_THREAD_ATTRIBUTE_HANDLE_LIST ----------
+
+class _ProcThreadAttributeList:
+    """Manages a PROC_THREAD_ATTRIBUTE_LIST with a HANDLE_LIST entry."""
+
+    def __init__(self, handle_list):
+        import ctypes
+        from ctypes import wintypes
+
+        self._buf = None
+        k32 = _kernel32()
+
+        attr_count = len(handle_list)
+        size = ctypes.c_size_t(0)
+
+        init_func = k32.InitializeProcThreadAttributeList
+        init_func.argtypes = [
+            ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD,
+            ctypes.POINTER(ctypes.c_size_t),
+        ]
+        init_func.restype = wintypes.BOOL
+
+        # First call: query required size
+        ok = init_func(None, attr_count, 0, ctypes.byref(size))
+        if not ok:
+            err = ctypes.get_last_error()
+            if err != 122:  # ERROR_INSUFFICIENT_BUFFER
+                raise ctypes.WinError(err)
+
+        buf = ctypes.create_string_buffer(size.value)
+        ok = init_func(buf, attr_count, 0, ctypes.byref(size))
+        if not ok:
+            raise ctypes.WinError(ctypes.get_last_error())
+        self._buf = buf
+
+        # Build the handle array
+        HANDLE_ARRAY = wintypes.HANDLE * len(handle_list)
+        arr = HANDLE_ARRAY(*[wintypes.HANDLE(int(h)) for h in handle_list])
+        # Keep a reference so it doesn't get GC'd
+        self._arr = arr
+
+        update_func = k32.UpdateProcThreadAttribute
+        # lpAttribute is DWORD_PTR (pointer-sized integer), NOT a pointer
+        update_func.argtypes = [
+            ctypes.c_void_p,       # lpAttributeList
+            wintypes.DWORD,        # dwFlags
+            ctypes.c_size_t,       # lpAttribute (DWORD_PTR)
+            ctypes.c_void_p,       # lpValue
+            ctypes.c_size_t,       # cbSize
+            ctypes.c_void_p,       # lpPreviousValue
+            ctypes.POINTER(ctypes.c_size_t),  # lpReturnSize
+        ]
+        update_func.restype = wintypes.BOOL
+
+        ok = update_func(
+            buf,
+            0,
+            PROC_THREAD_ATTRIBUTE_HANDLE_LIST,  # passed as DWORD_PTR value
+            ctypes.cast(arr, ctypes.c_void_p),
+            ctypes.sizeof(arr),
+            None,
+            None,
+        )
+        if not ok:
+            raise ctypes.WinError(ctypes.get_last_error())
+
+    @property
+    def buffer(self):
+        return self._buf
+
+    def cleanup(self):
+        if self._buf is not None:
+            import ctypes
+            k32 = _kernel32()
+            delete_func = k32.DeleteProcThreadAttributeList
+            delete_func.argtypes = [ctypes.c_void_p]
+            delete_func.restype = None
+            delete_func(self._buf)
+            self._buf = None
+            self._arr = None
+
+    def __del__(self):
+        try:
+            self.cleanup()
+        except Exception:
+            pass
+
+
+# Define STARTUPINFOEX once at module level (lazily)
+_startupinfoex_cls = None
+
+
+def _get_startupinfoex_class():
+    global _startupinfoex_cls
+    if _startupinfoex_cls is not None:
+        return _startupinfoex_cls
+
+    import ctypes
+    from ctypes import wintypes
+
+    class STARTUPINFOW(ctypes.Structure):
+        _fields_ = [
+            ("cb", wintypes.DWORD),
+            ("lpReserved", wintypes.LPWSTR),
+            ("lpDesktop", wintypes.LPWSTR),
+            ("lpTitle", wintypes.LPWSTR),
+            ("dwX", wintypes.DWORD),
+            ("dwY", wintypes.DWORD),
+            ("dwXSize", wintypes.DWORD),
+            ("dwYSize", wintypes.DWORD),
+            ("dwXCountChars", wintypes.DWORD),
+            ("dwYCountChars", wintypes.DWORD),
+            ("dwFillAttribute", wintypes.DWORD),
+            ("dwFlags", wintypes.DWORD),
+            ("wShowWindow", wintypes.WORD),
+            ("cbReserved2", wintypes.WORD),
+            ("lpReserved2", ctypes.POINTER(ctypes.c_byte)),
+            ("hStdInput", wintypes.HANDLE),
+            ("hStdOutput", wintypes.HANDLE),
+            ("hStdError", wintypes.HANDLE),
+        ]
+
+    class STARTUPINFOEX(ctypes.Structure):
+        _fields_ = [
+            ("StartupInfo", STARTUPINFOW),
+            ("lpAttributeList", ctypes.c_void_p),
+        ]
+
+    _startupinfoex_cls = STARTUPINFOEX
+    return STARTUPINFOEX
+
+
+def create_process_with_handle_list(command_line, handle_list,
+                                     stdin=None, stdout=None, stderr=None):
+    """Create a child process that inherits **only** the handles in *handle_list*.
+
+    Standard stream handles (*stdin*, *stdout*, *stderr*) are set in the
+    startup info and should also appear in *handle_list* if they need to be
+    inherited.
+
+    Returns ``(pid, process_handle)``.  The caller must close
+    *process_handle* when done.
+    """
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = _kernel32()
+
+    STARTUPINFOEX = _get_startupinfoex_class()
+
+    attr_list = _ProcThreadAttributeList(handle_list)
+    try:
+        si = STARTUPINFOEX()
+        si.StartupInfo.cb = ctypes.sizeof(STARTUPINFOEX)
+        si.lpAttributeList = ctypes.cast(attr_list.buffer, ctypes.c_void_p)
+
+        # Set standard handles
+        if stdin is not None:
+            si.StartupInfo.hStdInput = wintypes.HANDLE(int(stdin))
+        if stdout is not None:
