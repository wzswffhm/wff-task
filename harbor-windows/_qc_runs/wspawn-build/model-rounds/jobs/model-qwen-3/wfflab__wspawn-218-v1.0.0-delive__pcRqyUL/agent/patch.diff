@@ -0,0 +1,194 @@
+"""Verification script for wspawn fixes."""
+import os
+import sys
+import subprocess
+import tempfile
+import msvcrt
+
+sys.path.insert(0, '.')
+from wspawn import (
+    spawn, set_inheritable, is_inheritable, inheritable_handles,
+    handle_kind, WSpawnError,
+)
+
+PY = sys.executable
+
+print("=== Test 1: set_inheritable / is_inheritable ===")
+r_fd, w_fd = os.pipe()
+r_handle = msvcrt.get_osfhandle(r_fd)
+w_handle = msvcrt.get_osfhandle(w_fd)
+
+print(f"Pipe handles: read={r_handle}, write={w_handle}")
+
+inh = is_inheritable(r_handle)
+print(f"is_inheritable(read) = {inh}")
+
+set_inheritable(r_handle, True)
+inh = is_inheritable(r_handle)
+print(f"After set_inheritable(True): is_inheritable(read) = {inh}")
+assert inh == True
+
+set_inheritable(r_handle, False)
+inh = is_inheritable(r_handle)
+print(f"After set_inheritable(False): is_inheritable(read) = {inh}")
+assert inh == False
+
+os.close(r_fd)
+os.close(w_fd)
+print("PASS\n")
+
+print("=== Test 2: handle_kind ===")
+stdout_h = msvcrt.get_osfhandle(1)
+kind = handle_kind(stdout_h)
+print(f"stdout kind = {kind}")
+
+tf = tempfile.NamedTemporaryFile(delete=False)
+tf_handle = msvcrt.get_osfhandle(tf.fileno())
+kind = handle_kind(tf_handle)
+print(f"temp file kind = {kind}")
+assert kind == "file"
+tf.close()
+os.unlink(tf.name)
+
+try:
+    handle_kind(999999999)
+    print("ERROR: Should have raised WSpawnError")
+except WSpawnError as e:
+    print(f"Invalid handle error: kind={e.kind}")
+    assert e.kind in ("unsupported", "os")
+
+try:
+    handle_kind("nope")
+except WSpawnError as e:
+    print(f"Non-integer error: kind={e.kind}")
+    assert e.kind == "badarg"
+print("PASS\n")
+
+print("=== Test 3: Precise handover - no extra handles leaked ===")
+r_fd3, w_fd3 = os.pipe()
+r_fd4, w_fd4 = os.pipe()
+w_handle3 = msvcrt.get_osfhandle(w_fd3)
+w_handle4 = msvcrt.get_osfhandle(w_fd4)
+
+set_inheritable(w_handle3, True)
+set_inheritable(w_handle4, True)
+
+result_file = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt')
+result_path = result_file.name
+result_file.close()
+
+child_code = f"""
+import ctypes
+from ctypes import wintypes
+k32 = ctypes.windll.kernel32
+k32.GetHandleInformation.restype = wintypes.BOOL
+k32.GetHandleInformation.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+flags = wintypes.DWORD()
+ok = k32.GetHandleInformation(wintypes.HANDLE({w_handle4}), ctypes.byref(flags))
+with open(r'{result_path}', 'w') as f:
+    f.write('LEAKED' if ok else 'NOT_LEAKED')
+"""
+
+helper = spawn(
+    [PY, "-c", child_code],
+    inherit=[w_handle3],
+    stdout=subprocess.DEVNULL,
+    stderr=subprocess.DEVNULL,
+)
+helper.wait(timeout=30)
+
+with open(result_path) as f:
+    result = f.read().strip()
+print(f"Handle4 in child (should be NOT_LEAKED): {result}")
+assert result == "NOT_LEAKED", f"Handle leaked! Got: {result}"
+print("PASS\n")
+
+os.unlink(result_path)
+os.close(r_fd3)
+os.close(w_fd3)
+os.close(r_fd4)
+os.close(w_fd4)
+
+print("=== Test 4: Handle value preservation + data integrity ===")
+r_fd5, w_fd5 = os.pipe()
+w_handle5 = msvcrt.get_osfhandle(w_fd5)
+set_inheritable(w_handle5, True)
+
+result_file2 = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt')
+result_path2 = result_file2.name
+result_file2.close()
+
+child_code2 = f"""
+import os, msvcrt
+expected = {w_handle5}
+try:
+    fd = msvcrt.open_osfhandle(expected, os.O_WRONLY)
+    os.write(fd, b'value-preserved')
+    with open(r'{result_path2}', 'w') as f:
+        f.write('VALUE_OK')
+except Exception as e:
+    with open(r'{result_path2}', 'w') as f:
+        f.write(f'VALUE_FAIL: {{e}}')
+"""
+
+helper2 = spawn(
+    [PY, "-c", child_code2],
+    inherit=[w_handle5],
+    stdout=subprocess.DEVNULL,
+    stderr=subprocess.DEVNULL,
+)
+helper2.wait(timeout=30)
+
+with open(result_path2) as f:
+    result = f.read().strip()
+print(f"Handle value preservation: {result}")
+
+os.close(w_fd5)
+data = os.read(r_fd5, 1024)
+print(f"Data from child: {data}")
+os.close(r_fd5)
+os.unlink(result_path2)
+
+assert "VALUE_OK" in result and b"value-preserved" in data
+print("PASS\n")
+
+print("=== Test 5: Empty inherit means no extra handles ===")
+r_fd6, w_fd6 = os.pipe()
+w_handle6 = msvcrt.get_osfhandle(w_fd6)
+set_inheritable(w_handle6, True)
+
+result_file3 = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt')
+result_path3 = result_file3.name
+result_file3.close()
+
+child_code3 = f"""
+import ctypes
+from ctypes import wintypes
+k32 = ctypes.windll.kernel32
+k32.GetHandleInformation.restype = wintypes.BOOL
+k32.GetHandleInformation.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+flags = wintypes.DWORD()
+ok = k32.GetHandleInformation(wintypes.HANDLE({w_handle6}), ctypes.byref(flags))
+with open(r'{result_path3}', 'w') as f:
+    f.write('LEAKED' if ok else 'NOT_LEAKED')
+"""
+
+helper3 = spawn(
+    [PY, "-c", child_code3],
+    inherit=[],  # Empty inherit
+    stdout=subprocess.DEVNULL,
+    stderr=subprocess.DEVNULL,
+)
+helper3.wait(timeout=30)
+
+with open(result_path3) as f:
+    result = f.read().strip()
+print(f"Handle6 with empty inherit (should be NOT_LEAKED): {result}")
+assert result == "NOT_LEAKED", f"Handle leaked with empty inherit! Got: {result}"
+print("PASS\n")
+
+os.unlink(result_path3)
+os.close(r_fd6)
+os.close(w_fd6)
+
+print("=== All verification tests PASSED ===")
