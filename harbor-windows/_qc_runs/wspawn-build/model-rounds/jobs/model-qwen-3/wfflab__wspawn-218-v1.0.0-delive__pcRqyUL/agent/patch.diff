@@ -0,0 +1,103 @@
+"""Debug: check what spawn() does differently."""
+import os, sys, ctypes, tempfile, msvcrt, subprocess
+from ctypes import wintypes
+
+sys.path.insert(0, '.')
+from wspawn._winapi import (
+    create_process_with_handle_list, set_handle_information, get_handle_information,
+    close_handle, HANDLE_FLAG_INHERIT,
+)
+from wspawn.proc import _handle_from_stream, _get_std_handle, _build_command_line
+
+PY = sys.executable
+
+# Create two pipes
+r1, w1 = os.pipe()
+r2, w2 = os.pipe()
+h1 = msvcrt.get_osfhandle(w1)
+h2 = msvcrt.get_osfhandle(w2)
+
+set_handle_information(h1, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT)
+set_handle_information(h2, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT)
+
+print(f"h1={h1}, h2={h2}")
+
+result_file = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt')
+result_path = result_file.name
+result_file.close()
+
+child_code = f"""
+import ctypes
+from ctypes import wintypes
+k32 = ctypes.windll.kernel32
+k32.GetHandleInformation.restype = wintypes.BOOL
+k32.GetHandleInformation.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+flags = wintypes.DWORD()
+ok = k32.GetHandleInformation(wintypes.HANDLE({h2}), ctypes.byref(flags))
+with open(r'{result_path}', 'w') as f:
+    f.write('LEAKED' if ok else 'NOT_LEAKED')
+"""
+
+# Simulate what spawn() does
+handles = (h1,)  # inherit=[h1]
+stdin_h = None
+stdout_h = _handle_from_stream(subprocess.DEVNULL, for_output=True)
+stderr_h = _handle_from_stream(subprocess.DEVNULL, for_output=True)
+
+if stdin_h is None:
+    stdin_h = _get_std_handle(0)
+if stdout_h is None:
+    stdout_h = _get_std_handle(1)
+if stderr_h is None:
+    stderr_h = _get_std_handle(2)
+
+print(f"stdin_h={stdin_h}, stdout_h={stdout_h}, stderr_h={stderr_h}")
+
+all_handles = list(handles)
+for h in (stdin_h, stdout_h, stderr_h):
+    if h is not None and h not in all_handles:
+        all_handles.append(h)
+
+print(f"all_handles = {all_handles}")
+print(f"h2 ({h2}) in all_handles? {h2 in all_handles}")
+
+# Set inheritable
+original_states = {}
+for h in all_handles:
+    try:
+        flags = get_handle_information(h)
+        original_states[h] = bool(flags & HANDLE_FLAG_INHERIT)
+        if not (flags & HANDLE_FLAG_INHERIT):
+            set_handle_information(h, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT)
+    except OSError:
+        pass
+
+cmd_line = _build_command_line([PY, "-c", child_code])
+
+pid, proc_h = create_process_with_handle_list(
+    cmd_line,
+    all_handles,
+    stdin=stdin_h,
+    stdout=stdout_h,
+    stderr=stderr_h,
+)
+
+# Restore
+for h, was_inh in original_states.items():
+    try:
+        target = HANDLE_FLAG_INHERIT if was_inh else 0
+        set_handle_information(h, HANDLE_FLAG_INHERIT, target)
+    except OSError:
+        pass
+
+k32 = ctypes.windll.kernel32
+k32.WaitForSingleObject(wintypes.HANDLE(proc_h), wintypes.DWORD(30000))
+close_handle(proc_h)
+
+with open(result_path) as f:
+    result = f.read().strip()
+print(f"Result: {result}")
+
+os.unlink(result_path)
+os.close(r1); os.close(w1)
+os.close(r2); os.close(w2)
