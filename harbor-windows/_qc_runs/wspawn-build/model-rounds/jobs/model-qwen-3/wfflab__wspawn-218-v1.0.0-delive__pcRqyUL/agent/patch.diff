@@ -0,0 +1,59 @@
+import ctypes
+from ctypes import wintypes
+import sys
+
+print(f'Python {sys.version}, pointer size: {ctypes.sizeof(ctypes.c_void_p)}')
+
+k32 = ctypes.WinDLL('kernel32', use_last_error=True)
+
+# Get stdout handle and make it inheritable
+h = k32.GetStdHandle(wintypes.DWORD(-11))
+hval = h.value if hasattr(h, 'value') else int(h)
+print(f'stdout handle = {hval}')
+
+HANDLE_FLAG_INHERIT = 0x00000001
+ok = k32.SetHandleInformation(wintypes.HANDLE(hval), HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT)
+print(f'SetHandleInformation ok={ok}')
+
+size = ctypes.c_size_t(0)
+init_func = k32.InitializeProcThreadAttributeList
+init_func.argtypes = [ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(ctypes.c_size_t)]
+init_func.restype = wintypes.BOOL
+
+ok = init_func(None, 1, 0, ctypes.byref(size))
+buf = ctypes.create_string_buffer(size.value)
+ok = init_func(buf, 1, 0, ctypes.byref(size))
+print(f'Init ok={ok}')
+
+PROC_THREAD_ATTRIBUTE_HANDLE_LIST = 0x00020002
+
+update_func = k32.UpdateProcThreadAttribute
+# Fix: lpAttribute should be DWORD_PTR (pointer-sized), not POINTER(DWORD)
+update_func.argtypes = [
+    ctypes.c_void_p,       # lpAttributeList
+    wintypes.DWORD,        # dwFlags
+    ctypes.c_size_t,       # lpAttribute (DWORD_PTR)
+    ctypes.c_void_p,       # lpValue
+    ctypes.c_size_t,       # cbSize
+    ctypes.c_void_p,       # lpPreviousValue
+    ctypes.POINTER(ctypes.c_size_t),  # lpReturnSize
+]
+update_func.restype = wintypes.BOOL
+
+arr = (wintypes.HANDLE * 1)(wintypes.HANDLE(hval))
+
+ok = update_func(
+    buf,
+    0,
+    PROC_THREAD_ATTRIBUTE_HANDLE_LIST,  # Pass as DWORD_PTR directly
+    ctypes.cast(arr, ctypes.c_void_p),
+    ctypes.sizeof(arr),
+    None,
+    None,
+)
+print(f'UpdateProcThreadAttribute ok={ok}, lasterr={ctypes.get_last_error()}')
+
+delete_func = k32.DeleteProcThreadAttributeList
+delete_func.argtypes = [ctypes.c_void_p]
+delete_func.restype = None
+delete_func(buf)
