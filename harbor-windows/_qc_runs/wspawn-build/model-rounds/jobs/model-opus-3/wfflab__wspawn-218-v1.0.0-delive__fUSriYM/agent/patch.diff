diff --git a/_negctl_tmp.py b/_negctl_tmp.py
new file mode 100644
index 0000000..81f5b1c
--- /dev/null
+++ b/_negctl_tmp.py
@@ -0,0 +1,76 @@
+"""Negative control: show the harness's leak check actually fires (temp file)."""
+import os
+import subprocess
+import sys
+import tempfile
+
+import msvcrt
+
+PY = sys.executable
+MARKER = b"LEAK-MARKER-9f3a"
+
+PROBE = (
+    "import ctypes,sys\n"
+    "from ctypes import wintypes\n"
+    "k=ctypes.WinDLL('kernel32',use_last_error=True)\n"
+    "k.GetFileInformationByHandleEx.argtypes=[wintypes.HANDLE,wintypes.DWORD,wintypes.LPVOID,wintypes.DWORD]\n"
+    "k.PeekNamedPipe.argtypes=[wintypes.HANDLE,wintypes.LPVOID,wintypes.DWORD,wintypes.LPDWORD,wintypes.LPDWORD,wintypes.LPDWORD]\n"
+    "def nm(h):\n"
+    " b=ctypes.create_string_buffer(8196)\n"
+    " ok=k.GetFileInformationByHandleEx(wintypes.HANDLE(h),2,ctypes.cast(b,wintypes.LPVOID),wintypes.DWORD(8196))\n"
+    " return None if not ok else b.raw[4:4+int.from_bytes(b.raw[:4],'little')].decode('utf-16-le','replace')\n"
+    "def pk(h):\n"
+    " b=ctypes.create_string_buffer(512);r=wintypes.DWORD();a=wintypes.DWORD();l=wintypes.DWORD()\n"
+    " ok=k.PeekNamedPipe(wintypes.HANDLE(h),ctypes.cast(b,wintypes.LPVOID),wintypes.DWORD(512),ctypes.byref(r),ctypes.byref(a),ctypes.byref(l))\n"
+    " return b'' if not ok else b.raw[:r.value]\n"
+    "bad=0\n"
+    "for d in [int(x) for x in sys.argv[1:]]:\n"
+    " n=nm(d) or ''\n"
+    " p=pk(d)\n"
+    " if 'wspawn-decoy' in n or " + repr(MARKER) + " in p: bad+=1\n"
+    "sys.exit(bad)\n"
+)
+
+
+def main():
+    decoy_fd, decoy_path = tempfile.mkstemp(prefix="wspawn-decoy-")
+    os.set_inheritable(decoy_fd, True)
+    dfh = msvcrt.get_osfhandle(decoy_fd)
+
+    pr, pw = os.pipe()
+    os.set_inheritable(pr, True)
+    os.set_inheritable(pw, True)
+    os.write(pw, MARKER)
+    prh = msvcrt.get_osfhandle(pr)
+    pwh = msvcrt.get_osfhandle(pw)
+
+    decoys = [str(dfh), str(prh), str(pwh)]
+
+    # The buggy behaviour the issue describes: inherit everything.
+    p = subprocess.Popen([PY, "-c", PROBE] + decoys, close_fds=False,
+                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    leaked_old = p.wait()
+    print("close_fds=False (old behaviour): decoys identified in child =", leaked_old)
+
+    # The fixed behaviour.
+    import wspawn
+    q = wspawn.spawn([PY, "-c", PROBE] + decoys,
+                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    leaked_new = q.wait()
+    print("wspawn.spawn (no inherit):      decoys identified in child =", leaked_new)
+
+    os.close(decoy_fd)
+    os.close(pr)
+    os.close(pw)
+    try:
+        os.unlink(decoy_path)
+    except OSError:
+        pass
+
+    ok = leaked_old > 0 and leaked_new == 0
+    print("negative control meaningful:", ok)
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/_probe_tmp.py b/_probe_tmp.py
new file mode 100644
index 0000000..0cce4a6
--- /dev/null
+++ b/_probe_tmp.py
@@ -0,0 +1,84 @@
+"""Probe: does NtQueryObject(ObjectNameInformation) separate ConDrv from Null? (temp)"""
+import ctypes
+import os
+import tempfile
+from ctypes import wintypes
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+nt = ctypes.WinDLL("ntdll", use_last_error=True)
+
+k32.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                            wintypes.LPVOID, wintypes.DWORD, wintypes.DWORD,
+                            wintypes.HANDLE]
+k32.CreateFileW.restype = wintypes.HANDLE
+
+nt.NtQueryObject.argtypes = [wintypes.HANDLE, ctypes.c_int, wintypes.LPVOID,
+                             wintypes.ULONG, ctypes.POINTER(wintypes.ULONG)]
+nt.NtQueryObject.restype = ctypes.c_long
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+OPEN_EXISTING = 3
+
+
+class UNICODE_STRING(ctypes.Structure):
+    _fields_ = [("Length", wintypes.USHORT),
+                ("MaximumLength", wintypes.USHORT),
+                ("Buffer", wintypes.LPWSTR)]
+
+
+def obj_name(handle, info_class):
+    size = 2048
+    buf = ctypes.create_string_buffer(size)
+    need = wintypes.ULONG(0)
+    status = nt.NtQueryObject(wintypes.HANDLE(handle), info_class,
+                              ctypes.cast(buf, wintypes.LPVOID),
+                              wintypes.ULONG(size), ctypes.byref(need))
+    if status < 0:
+        return "STATUS 0x%08x" % (status & 0xFFFFFFFF)
+    us = ctypes.cast(buf, ctypes.POINTER(UNICODE_STRING)).contents
+    if not us.Buffer or not us.Length:
+        return ""
+    return ctypes.wstring_at(us.Buffer, us.Length // 2)
+
+
+def show(label, handle):
+    if not handle or handle in (-1, 0xFFFFFFFFFFFFFFFF):
+        print("%-12s <could not open> err=%d" % (label, ctypes.get_last_error()))
+        return
+    k32.GetFileType.restype = wintypes.DWORD
+    print("%-12s handle=%-6d type=%d name=%r typename=%r"
+          % (label, handle, k32.GetFileType(wintypes.HANDLE(handle)),
+             obj_name(handle, 1), obj_name(handle, 2)))
+
+
+con = k32.CreateFileW("CONOUT$", GENERIC_READ | GENERIC_WRITE, 3, None, OPEN_EXISTING, 0, None)
+conin = k32.CreateFileW("CONIN$", GENERIC_READ | GENERIC_WRITE, 3, None, OPEN_EXISTING, 0, None)
+conw = k32.CreateFileW("CONOUT$", GENERIC_WRITE, 3, None, OPEN_EXISTING, 0, None)
+nul = k32.CreateFileW("NUL", GENERIC_READ | GENERIC_WRITE, 3, None, OPEN_EXISTING, 0, None)
+
+show("CONOUT$ rw", con)
+show("CONIN$ rw", conin)
+show("CONOUT$ w", conw)
+show("NUL", nul)
+
+fd, path = tempfile.mkstemp()
+import msvcrt
+show("file", msvcrt.get_osfhandle(fd))
+r, w = os.pipe()
+show("pipe", msvcrt.get_osfhandle(r))
+show("event", k32.CreateEventW(None, 0, 0, None))
+
+# does GetConsoleMode work on a write-only console handle?
+mode = wintypes.DWORD()
+k32.GetConsoleMode.argtypes = [wintypes.HANDLE, wintypes.LPDWORD]
+for label, h in (("CONOUT$ rw", con), ("CONOUT$ w", conw), ("CONIN$ rw", conin), ("NUL", nul)):
+    if h and h not in (-1, 0xFFFFFFFFFFFFFFFF):
+        ctypes.set_last_error(0)
+        ok = k32.GetConsoleMode(wintypes.HANDLE(h), ctypes.byref(mode))
+        print("GetConsoleMode %-12s ok=%s err=%d" % (label, bool(ok), ctypes.get_last_error()))
+
+os.close(fd)
+os.close(r)
+os.close(w)
+os.unlink(path)
diff --git a/_verify2_tmp.py b/_verify2_tmp.py
new file mode 100644
index 0000000..b0ae94a
--- /dev/null
+++ b/_verify2_tmp.py
@@ -0,0 +1,120 @@
+"""Second temporary harness: console kind, file handover, probe cost."""
+import ctypes
+import os
+import subprocess
+import sys
+import tempfile
+import time
+from ctypes import wintypes
+
+import msvcrt
+
+import wspawn
+from wspawn import _winapi
+
+PY = sys.executable
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+failures = []
+
+
+def check(label, ok, detail=""):
+    print(("PASS " if ok else "FAIL ") + label + ((" :: " + detail) if detail else ""))
+    if not ok:
+        failures.append(label)
+
+
+# ---- console handle classification (open the real console device) ----
+k32.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                            wintypes.LPVOID, wintypes.DWORD, wintypes.DWORD,
+                            wintypes.HANDLE]
+k32.CreateFileW.restype = wintypes.HANDLE
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+FILE_SHARE_READ = 1
+FILE_SHARE_WRITE = 2
+OPEN_EXISTING = 3
+
+con = k32.CreateFileW("CONOUT$", GENERIC_READ | GENERIC_WRITE,
+                      FILE_SHARE_READ | FILE_SHARE_WRITE, None, OPEN_EXISTING, 0, None)
+if con and con != -1 and con != 0xFFFFFFFFFFFFFFFF:
+    kind = wspawn.handle_kind(con)
+    check("E CONOUT$ classified as console", kind == "console", str(kind))
+    print("   (console handle value %d, GetFileType=%d)" % (con, _winapi.file_type(con)))
+else:
+    print("SKIP console: no console attached (err %d)" % ctypes.get_last_error())
+
+# ---- NUL device ----
+nul = k32.CreateFileW("NUL", GENERIC_READ | GENERIC_WRITE,
+                      FILE_SHARE_READ | FILE_SHARE_WRITE, None, OPEN_EXISTING, 0, None)
+if nul and nul not in (-1, 0xFFFFFFFFFFFFFFFF):
+    print("   NUL kind=%s type=%d name=%r"
+          % (wspawn.handle_kind(nul), _winapi.file_type(nul), _winapi.object_name(nul)))
+
+# ---- B/D: hand over a *file* handle and read it in the child ----
+fd, path = tempfile.mkstemp(prefix="wspawn-payload-")
+os.write(fd, b"payload-contents-42")
+os.fsync(fd)
+os.lseek(fd, 0, os.SEEK_SET)
+fh = msvcrt.get_osfhandle(fd)
+
+child = (
+    "import os,sys,msvcrt\n"
+    "h=int(sys.argv[1])\n"
+    "fd=msvcrt.open_osfhandle(h,os.O_RDONLY)\n"
+    "os.lseek(fd,0,os.SEEK_SET)\n"
+    "data=os.read(fd,4096)\n"
+    "sys.exit(0 if data==b'payload-contents-42' else 7)\n"
+)
+helper = wspawn.spawn([PY, "-c", child, str(fh)], inherit=[fh],
+                      stdout=subprocess.DEVNULL, stderr=None)
+rc = helper.wait(timeout=60)
+check("B/D file handed over at the same value and readable", rc == 0, "rc=%s" % rc)
+
+# ---- the handed-over handle's flag is restored afterwards ----
+check("spawn leaves the caller's flag as it found it",
+      wspawn.is_inheritable(fh) is False, str(wspawn.is_inheritable(fh)))
+
+# ---- probe cost ----
+start = time.perf_counter()
+handles = wspawn.inheritable_handles()
+elapsed = time.perf_counter() - start
+print("   inheritable_handles(): %d entries in %.3fs" % (len(handles), elapsed))
+check("inheritable_handles is not pathologically slow", elapsed < 2.0, "%.3fs" % elapsed)
+
+# ---- a handle flagged inheritable is still not handed over unless listed ----
+os.set_inheritable(fd, True)
+check("flagged handle shows up in the enumeration", fh in wspawn.inheritable_handles())
+helper2 = wspawn.spawn([PY, "-c", child, str(fh)],
+                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+rc2 = helper2.wait(timeout=60)
+check("A flagged-but-unlisted object does not reach the helper", rc2 != 0, "rc=%s" % rc2)
+
+# ---- F: non-Windows path / unsupported classification sanity ----
+try:
+    wspawn.spawn([PY, "-c", "pass"], inherit=[0])
+    check("F inherit=[0] raises", False)
+except wspawn.WSpawnError as exc:
+    check("F inherit=[0] typed", exc.kind in wspawn.WSpawnError.KINDS, exc.kind)
+
+try:
+    wspawn.spawn([PY, "-c", "pass"], inherit=[2 ** 80])
+    check("F out-of-range handle raises", False)
+except wspawn.WSpawnError as exc:
+    check("F out-of-range handle typed", exc.kind in wspawn.WSpawnError.KINDS, exc.kind)
+
+# file-like objects accepted by set_inheritable/handle_kind
+with open(path, "rb") as stream:
+    wspawn.set_inheritable(stream, True)
+    check("C file object accepted and flag set", wspawn.is_inheritable(stream) is True)
+    check("E file object classified", wspawn.handle_kind(stream) == "file")
+
+os.close(fd)
+try:
+    os.unlink(path)
+except OSError:
+    pass
+
+print()
+print("FAILURES: %r" % (failures,))
+sys.exit(1 if failures else 0)
diff --git a/_verify_tmp.py b/_verify_tmp.py
new file mode 100644
index 0000000..9f94ed8
--- /dev/null
+++ b/_verify_tmp.py
@@ -0,0 +1,275 @@
+"""Temporary verification harness for wspawn (deleted after the run).
+
+Checks object *identity* in the child, not just "is some handle with that value
+alive" -- Windows reuses handle values across processes, so liveness alone
+produces false positives.
+"""
+import ctypes
+import os
+import subprocess
+import sys
+import tempfile
+from ctypes import wintypes
+
+import wspawn
+from wspawn import _winapi
+
+PY = sys.executable
+
+# argv: report_handle input_handle marker  decoy...
+CHILD = r'''
+import ctypes, os, sys, msvcrt
+from ctypes import wintypes
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+k.GetHandleInformation.argtypes = [wintypes.HANDLE, wintypes.LPDWORD]
+k.GetHandleInformation.restype = wintypes.BOOL
+k.GetFileType.argtypes = [wintypes.HANDLE]
+k.GetFileType.restype = wintypes.DWORD
+k.GetFileInformationByHandleEx.argtypes = [wintypes.HANDLE, wintypes.DWORD,
+                                           wintypes.LPVOID, wintypes.DWORD]
+k.GetFileInformationByHandleEx.restype = wintypes.BOOL
+k.PeekNamedPipe.argtypes = [wintypes.HANDLE, wintypes.LPVOID, wintypes.DWORD,
+                            wintypes.LPDWORD, wintypes.LPDWORD, wintypes.LPDWORD]
+k.PeekNamedPipe.restype = wintypes.BOOL
+
+report_h = int(sys.argv[1])
+input_h = int(sys.argv[2])
+marker = sys.argv[3].encode("ascii")
+decoys = [int(x) for x in sys.argv[4:]]
+
+def ftype(h):
+    return int(k.GetFileType(wintypes.HANDLE(h)))
+
+def name(h):
+    size = 4 + 2 * 4096
+    buf = ctypes.create_string_buffer(size)
+    if not k.GetFileInformationByHandleEx(wintypes.HANDLE(h), 2,
+                                          ctypes.cast(buf, wintypes.LPVOID),
+                                          wintypes.DWORD(size)):
+        return None
+    n = int.from_bytes(buf.raw[:4], "little")
+    return buf.raw[4:4 + n].decode("utf-16-le", "replace")
+
+def peek(h):
+    buf = ctypes.create_string_buffer(512)
+    read = wintypes.DWORD(0)
+    avail = wintypes.DWORD(0)
+    left = wintypes.DWORD(0)
+    ok = k.PeekNamedPipe(wintypes.HANDLE(h), ctypes.cast(buf, wintypes.LPVOID),
+                         wintypes.DWORD(512), ctypes.byref(read),
+                         ctypes.byref(avail), ctypes.byref(left))
+    if not ok:
+        return None
+    return buf.raw[:read.value]
+
+lines = []
+
+# B/D: use the object the host handed over, under the value the host passed.
+fd_in = msvcrt.open_osfhandle(input_h, os.O_RDONLY)
+got = b""
+while True:
+    chunk = os.read(fd_in, 4096)
+    if not chunk:
+        break
+    got += chunk
+lines.append("GOT=" + got.decode("ascii", "replace"))
+lines.append("REPORT_TYPE=" + str(ftype(report_h)))
+
+# A: did any of the host's other objects come across *as themselves*?
+for d in decoys:
+    t = ftype(d)
+    nm = name(d)
+    pk = peek(d) if t == 3 else None
+    leaked = False
+    if nm and "wspawn-decoy" in nm:
+        leaked = True
+    if pk and marker in pk:
+        leaked = True
+    lines.append("DECOY %d type=%d leaked=%s name=%r peek=%r"
+                 % (d, t, leaked, nm, pk))
+
+fd_out = msvcrt.open_osfhandle(report_h, 0)
+os.write(fd_out, ("\n".join(lines) + "\n").encode("ascii", "replace"))
+'''
+
+MARKER = "LEAK-MARKER-9f3a"
+
+
+def h(fd):
+    import msvcrt
+    return msvcrt.get_osfhandle(fd)
+
+
+def run_child(inherit, report_w, input_r, decoys, marker=MARKER):
+    report_h = h(report_w)
+    input_h = h(input_r)
+    argv = [PY, "-c", CHILD, str(report_h), str(input_h), marker] + \
+           [str(d) for d in decoys]
+    helper = wspawn.spawn(argv, inherit=inherit,
+                          stdout=subprocess.DEVNULL, stderr=None)
+    return helper
+
+
+def main():
+    failures = []
+
+    def check(label, ok, detail=""):
+        print(("PASS " if ok else "FAIL ") + label + ((" :: " + detail) if detail else ""))
+        if not ok:
+            failures.append(label)
+
+    # ---------- decoys the helper must never see ----------
+    decoy_fd, decoy_path = tempfile.mkstemp(prefix="wspawn-decoy-")
+    os.write(decoy_fd, b"host-only-secret")
+    decoy_file_h = h(decoy_fd)
+    wspawn.set_inheritable(decoy_file_h, True)
+
+    decoy_pipe_r, decoy_pipe_w = os.pipe()
+    wspawn.set_inheritable(h(decoy_pipe_r), True)
+    wspawn.set_inheritable(h(decoy_pipe_w), True)
+    os.write(decoy_pipe_w, MARKER.encode("ascii"))
+
+    decoy2_fd, decoy2_path = tempfile.mkstemp(prefix="wspawn-decoy2-")
+    wspawn.set_inheritable(h(decoy2_fd), True)
+
+    decoys = [decoy_file_h, h(decoy_pipe_r), h(decoy_pipe_w), h(decoy2_fd)]
+
+    # ---------- C: flag is real and externally observable ----------
+    probe_fd, probe_path = tempfile.mkstemp(prefix="wspawn-probe-")
+    probe_h = h(probe_fd)
+    wspawn.set_inheritable(probe_h, True)
+    check("C set(True) observable via GetHandleInformation",
+          bool(_winapi.get_handle_information(probe_h) & _winapi.HANDLE_FLAG_INHERIT))
+    check("C is_inheritable agrees with it", wspawn.is_inheritable(probe_h) is True)
+    check("C os.get_inheritable agrees too", os.get_inheritable(probe_fd) is True)
+    wspawn.set_inheritable(probe_h, False)
+    check("C set(False) observable via GetHandleInformation",
+          not (_winapi.get_handle_information(probe_h) & _winapi.HANDLE_FLAG_INHERIT))
+    check("C is_inheritable agrees (False)", wspawn.is_inheritable(probe_h) is False)
+    check("C inheritable_handles lists a flagged object",
+          decoy_file_h in wspawn.inheritable_handles())
+    check("C inheritable_handles omits an unflagged object",
+          probe_h not in wspawn.inheritable_handles())
+
+    # ---------- E: kinds ----------
+    check("E file", wspawn.handle_kind(probe_h) == "file", wspawn.handle_kind(probe_h))
+    check("E pipe", wspawn.handle_kind(h(decoy_pipe_w)) == "pipe",
+          wspawn.handle_kind(h(decoy_pipe_w)))
+    ev = ctypes.WinDLL("kernel32", use_last_error=True).CreateEventW(None, 0, 0, None)
+    check("E event -> unknown", wspawn.handle_kind(ev) == "unknown",
+          str(wspawn.handle_kind(ev)))
+    for bogus in (0, 999999999, -5):
+        try:
+            wspawn.handle_kind(bogus)
+            check("E invalid handle %r raises" % (bogus,), False)
+        except wspawn.WSpawnError as exc:
+            check("E invalid handle %r typed" % (bogus,),
+                  exc.kind in wspawn.WSpawnError.KINDS, exc.kind)
+
+    # ---------- A/B/D: the handover ----------
+    report_r, report_w = os.pipe()
+    input_r, input_w = os.pipe()
+    os.write(input_w, b"ping-from-host")
+    os.close(input_w)
+
+    helper = run_child([h(report_w), h(input_r)], report_w, input_r, decoys)
+    os.close(report_w)
+    os.close(input_r)
+    data = b""
+    while True:
+        chunk = os.read(report_r, 4096)
+        if not chunk:
+            break
+        data += chunk
+    rc = helper.wait(timeout=60)
+    text = data.decode("ascii", "replace")
+    print("---- child report (rc=%s) ----" % rc)
+    print(text)
+    print("------------------------------")
+    os.close(report_r)
+
+    check("B helper used the handed-over report pipe", bool(text.strip()))
+    check("B helper read exactly what the host wrote", "GOT=ping-from-host" in text)
+    check("D handed-over value still names the same pipe", "REPORT_TYPE=3" in text)
+    leaks = [ln for ln in text.splitlines() if ln.startswith("DECOY") and "leaked=True" in ln]
+    check("A no other inheritable object reached the helper", not leaks, "; ".join(leaks))
+
+    # ---------- A: empty inherit ----------
+    report2_r, report2_w = os.pipe()
+    # Hand over nothing; the child reports through an explicit stdout instead.
+    out_fd, out_path = tempfile.mkstemp(prefix="wspawn-out-")
+    os.close(out_fd)
+    probe_code = (
+        "import ctypes,sys;from ctypes import wintypes;"
+        "k=ctypes.WinDLL('kernel32',use_last_error=True);"
+        "k.GetFileInformationByHandleEx.argtypes=[wintypes.HANDLE,wintypes.DWORD,"
+        "wintypes.LPVOID,wintypes.DWORD];"
+        "k.PeekNamedPipe.argtypes=[wintypes.HANDLE,wintypes.LPVOID,wintypes.DWORD,"
+        "wintypes.LPDWORD,wintypes.LPDWORD,wintypes.LPDWORD];"
+        "import os\n"
+        "def nm(h):\n"
+        " b=ctypes.create_string_buffer(8196)\n"
+        " ok=k.GetFileInformationByHandleEx(wintypes.HANDLE(h),2,ctypes.cast(b,wintypes.LPVOID),wintypes.DWORD(8196))\n"
+        " return None if not ok else b.raw[4:4+int.from_bytes(b.raw[:4],'little')].decode('utf-16-le','replace')\n"
+        "def pk(h):\n"
+        " b=ctypes.create_string_buffer(512);r=wintypes.DWORD();a=wintypes.DWORD();l=wintypes.DWORD()\n"
+        " ok=k.PeekNamedPipe(wintypes.HANDLE(h),ctypes.cast(b,wintypes.LPVOID),wintypes.DWORD(512),ctypes.byref(r),ctypes.byref(a),ctypes.byref(l))\n"
+        " return b'' if not ok else b.raw[:r.value]\n"
+        "bad=0\n"
+        "for d in [int(x) for x in sys.argv[1:]]:\n"
+        " n=nm(d) or ''\n"
+        " p=pk(d)\n"
+        " if 'wspawn-decoy' in n or " + repr(MARKER.encode("ascii")) + " in p: bad+=1\n"
+        "sys.exit(bad)\n"
+    )
+    helper2 = wspawn.spawn([PY, "-c", probe_code] + [str(d) for d in decoys],
+                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    rc2 = helper2.wait(timeout=60)
+    check("A empty inherit hands over nothing", rc2 == 0,
+          "decoys identified in child = %s" % rc2)
+    os.close(report2_r)
+    os.close(report2_w)
+
+    # ---------- F: classification ----------
+    for bogus in (999999999, 0):
+        try:
+            wspawn.set_inheritable(bogus, True)
+            check("F set_inheritable(%r) raises" % (bogus,), False)
+        except wspawn.WSpawnError as exc:
+            check("F set_inheritable(%r) typed" % (bogus,),
+                  exc.kind in wspawn.WSpawnError.KINDS, exc.kind)
+    try:
+        wspawn.set_inheritable("nope", True)
+        check("F set_inheritable(str) raises", False)
+    except wspawn.WSpawnError as exc:
+        check("F set_inheritable(str) is badarg", exc.kind == "badarg", exc.kind)
+    try:
+        wspawn.spawn([PY, "-c", "pass"], inherit=[999999999])
+        check("F spawn with a dead handle raises", False)
+    except wspawn.WSpawnError as exc:
+        check("F spawn with a dead handle typed", exc.kind in ("os", "unsupported"), exc.kind)
+    try:
+        wspawn.set_inheritable(ev, True)
+        check("F event accepts the flag (it does on Win32)", True)
+    except wspawn.WSpawnError as exc:
+        check("F event flag typed", exc.kind in wspawn.WSpawnError.KINDS, exc.kind)
+
+    # ---------- cleanup ----------
+    for fd in (decoy_fd, decoy2_fd, probe_fd, decoy_pipe_r, decoy_pipe_w):
+        try:
+            os.close(fd)
+        except OSError:
+            pass
+    for path in (decoy_path, decoy2_path, probe_path, out_path):
+        try:
+            os.unlink(path)
+        except OSError:
+            pass
+
+    print()
+    print("FAILURES: %r" % (failures,))
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
