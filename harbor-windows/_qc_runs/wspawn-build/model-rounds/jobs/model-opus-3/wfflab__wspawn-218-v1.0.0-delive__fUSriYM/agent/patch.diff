@@ -1,5 +1,7 @@
 """Error taxonomy for :mod:`wspawn`."""
 
+from . import _winapi
+
 
 class WSpawnError(Exception):
     """Raised when a handle-handover operation cannot be carried out.
@@ -27,3 +29,33 @@ class WSpawnError(Exception):
         if self.handle is None:
             return base
         return "%s (handle %r)" % (base, self.handle)
+
+
+def require_windows(operation):
+    """Raise ``unsupported`` unless the Win32 handle API is available.
+
+    The handover semantics this package guarantees are Windows handle
+    semantics.  Where they cannot be provided, the module says so instead of
+    degrading into a best-effort imitation.
+    """
+    if not _winapi.is_windows():
+        raise WSpawnError(
+            "%s needs the Windows handle API, which is unavailable on this platform"
+            % (operation,),
+            kind="unsupported",
+        )
+
+
+def from_oserror(exc, operation, handle=None):
+    """Translate an :class:`OSError` from a Win32 call into a ``WSpawnError``.
+
+    Error codes that mean "this object does not implement that" become
+    ``unsupported``; everything else is a plain ``os`` failure.
+    """
+    winerror = getattr(exc, "winerror", None)
+    kind = "unsupported" if winerror in _winapi.UNSUPPORTED_ERRORS else "os"
+    if kind == "unsupported":
+        message = "%s is not supported for this object: %s" % (operation, exc)
+    else:
+        message = "%s failed: %s" % (operation, exc)
+    return WSpawnError(message, kind=kind, handle=handle)
