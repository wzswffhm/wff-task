diff --git a/wspawn/_winapi.py b/wspawn/_winapi.py
index 273b792..ff6cee6 100644
--- a/wspawn/_winapi.py
+++ b/wspawn/_winapi.py
@@ -5,6 +5,7 @@ loaded lazily so that importing the package stays cheap.
 """
 
 import os
+import sys
 
 FILE_TYPE_UNKNOWN = 0x0000
 FILE_TYPE_DISK = 0x0001
@@ -12,6 +13,28 @@ FILE_TYPE_CHAR = 0x0002
 FILE_TYPE_PIPE = 0x0003
 FILE_TYPE_REMOTE = 0x8000
 
+HANDLE_FLAG_INHERIT = 0x00000001
+HANDLE_FLAG_PROTECT_FROM_CLOSE = 0x00000002
+
+# Process creation flags
+EXTENDED_STARTUPINFO_PRESENT = 0x00080000
+
+# ProcThreadAttribute constants
+PROC_THREAD_ATTRIBUTE_HANDLE_LIST = 0x00020002
+
+# STARTF_USESTDHANDLES
+STARTF_USESTDHANDLES = 0x00000100
+
+# Standard handle IDs
+STD_INPUT_HANDLE = -10
+STD_OUTPUT_HANDLE = -11
+STD_ERROR_HANDLE = -12
+
+# Wait constants
+WAIT_OBJECT_0 = 0x00000000
+WAIT_TIMEOUT = 0x00000102
+INFINITE = 0xFFFFFFFF
+
 _IS_WINDOWS = os.name == "nt"
 
 
@@ -36,4 +59,325 @@ def file_type(handle):
     func = _kernel32().GetFileType
     func.argtypes = [wintypes.HANDLE]
     func.restype = wintypes.DWORD
-    return int(func(wintypes.HANDLE(int(handle))))
+    result = func(wintypes.HANDLE(int(handle)))
+    # GetFileType returns FILE_TYPE_UNKNOWN (0) on error, but also for some valid handles
+    # Check GetLastError to distinguish
+    err = ctypes.get_last_error()
+    if result == FILE_TYPE_UNKNOWN and err != 0:
+        raise OSError(err, "GetFileType failed")
+    return int(result)
+
+
+def get_handle_information(handle):
+    """Return the flags for a handle via GetHandleInformation.
+    
+    Returns the flags as an integer. Raises OSError on failure.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("GetHandleInformation is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = _kernel32()
+    flags = wintypes.DWORD()
+    success = kernel32.GetHandleInformation(wintypes.HANDLE(int(handle)), ctypes.byref(flags))
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "GetHandleInformation failed")
+    return int(flags.value)
+
+
+def set_handle_information(handle, mask, flags):
+    """Set handle flags via SetHandleInformation.
+    
+    mask: which flags to modify
+    flags: new values for those flags
+    Raises OSError on failure.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("SetHandleInformation is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = _kernel32()
+    success = kernel32.SetHandleInformation(
+        wintypes.HANDLE(int(handle)),
+        wintypes.DWORD(mask),
+        wintypes.DWORD(flags)
+    )
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "SetHandleInformation failed")
+
+
+def get_std_handle(which):
+    """Get a standard handle (STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE)."""
+    if not _IS_WINDOWS:
+        raise OSError("GetStdHandle is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    kernel32.GetStdHandle.argtypes = [wintypes.DWORD]
+    kernel32.GetStdHandle.restype = wintypes.HANDLE
+    
+    # Convert negative constants to DWORD
+    if which < 0:
+        which = which & 0xFFFFFFFF
+    
+    handle = kernel32.GetStdHandle(wintypes.DWORD(which))
+    return int(handle)
+
+
+def close_handle(handle):
+    """Close a Windows handle."""
+    if not _IS_WINDOWS:
+        return
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    kernel32.CloseHandle(wintypes.HANDLE(int(handle)))
+
+
+def wait_for_single_object(handle, timeout_ms):
+    """Wait for a single object. Returns WAIT_OBJECT_0 or WAIT_TIMEOUT."""
+    if not _IS_WINDOWS:
+        raise OSError("WaitForSingleObject is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    result = kernel32.WaitForSingleObject(
+        wintypes.HANDLE(int(handle)),
+        wintypes.DWORD(timeout_ms)
+    )
+    return int(result)
+
+
+def get_exit_code_process(process_handle):
+    """Get the exit code of a process."""
+    if not _IS_WINDOWS:
+        raise OSError("GetExitCodeProcess is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    exit_code = wintypes.DWORD()
+    success = kernel32.GetExitCodeProcess(
+        wintypes.HANDLE(int(process_handle)),
+        ctypes.byref(exit_code)
+    )
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "GetExitCodeProcess failed")
+    return int(exit_code.value)
+
+
+def terminate_process(process_handle, exit_code=1):
+    """Terminate a process."""
+    if not _IS_WINDOWS:
+        raise OSError("TerminateProcess is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    success = kernel32.TerminateProcess(
+        wintypes.HANDLE(int(process_handle)),
+        wintypes.UINT(exit_code)
+    )
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "TerminateProcess failed")
+
+
+def create_process_with_handle_list(command_line, handle_list, stdin=None, stdout=None, stderr=None):
+    """Create a process with an explicit handle inheritance list.
+    
+    Uses STARTUPINFOEX with PROC_THREAD_ATTRIBUTE_HANDLE_LIST to ensure
+    only the specified handles are inherited by the child process.
+    
