+import ctypes
+from ctypes import wintypes
+
+class STARTUPINFO(ctypes.Structure):
+    _fields_ = [
+        ('cb', wintypes.DWORD),
+        ('lpReserved', wintypes.LPWSTR),
+        ('lpDesktop', wintypes.LPWSTR),
+        ('lpTitle', wintypes.LPWSTR),
+        ('dwX', wintypes.DWORD),
+        ('dwY', wintypes.DWORD),
+        ('dwXSize', wintypes.DWORD),
+        ('dwYSize', wintypes.DWORD),
+        ('dwXCountChars', wintypes.DWORD),
+        ('dwYCountChars', wintypes.DWORD),
+        ('dwFillAttribute', wintypes.DWORD),
+        ('dwFlags', wintypes.DWORD),
+        ('wShowWindow', wintypes.WORD),
+        ('cbReserved2', wintypes.WORD),
+        ('lpReserved2', ctypes.POINTER(ctypes.c_byte)),
+        ('hStdInput', wintypes.HANDLE),
+        ('hStdOutput', wintypes.HANDLE),
+        ('hStdError', wintypes.HANDLE),
+    ]
+
+class STARTUPINFOEX(ctypes.Structure):
+    _fields_ = [
+        ('cb', wintypes.DWORD),
+        ('lpReserved', wintypes.LPWSTR),
+        ('lpDesktop', wintypes.LPWSTR),
+        ('lpTitle', wintypes.LPWSTR),
+        ('dwX', wintypes.DWORD),
+        ('dwY', wintypes.DWORD),
+        ('dwXSize', wintypes.DWORD),
+        ('dwYSize', wintypes.DWORD),
+        ('dwXCountChars', wintypes.DWORD),
+        ('dwYCountChars', wintypes.DWORD),
+        ('dwFillAttribute', wintypes.DWORD),
+        ('dwFlags', wintypes.DWORD),
+        ('wShowWindow', wintypes.WORD),
+        ('cbReserved2', wintypes.WORD),
+        ('lpReserved2', ctypes.POINTER(ctypes.c_byte)),
+        ('hStdInput', wintypes.HANDLE),
+        ('hStdOutput', wintypes.HANDLE),
+        ('hStdError', wintypes.HANDLE),
+        ('lpAttributeList', ctypes.c_void_p),
+    ]
+
+print('STARTUPINFO size:', ctypes.sizeof(STARTUPINFO))
+print('STARTUPINFOEX size:', ctypes.sizeof(STARTUPINFOEX))
+print('Expected STARTUPINFOEX on x64: 112')
+
+# Check field offsets
+si = STARTUPINFO()
+sie = STARTUPINFOEX()
+print('STARTUPINFO.cb offset:', type(si).cb.offset)
+print('STARTUPINFOEX.cb offset:', type(sie).cb.offset)
+print('STARTUPINFOEX.lpAttributeList offset:', type(sie).lpAttributeList.offset)
diff --git a/test_create.py b/test_create.py
new file mode 100644
index 0000000..63219f7
--- /dev/null
+++ b/test_create.py
@@ -0,0 +1,66 @@
+import ctypes
+from ctypes import wintypes
+import subprocess
+
+kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+# Simple test without attribute list first
+class STARTUPINFO(ctypes.Structure):
+    _fields_ = [
+        ('cb', wintypes.DWORD),
+        ('lpReserved', wintypes.LPWSTR),
+        ('lpDesktop', wintypes.LPWSTR),
+        ('lpTitle', wintypes.LPWSTR),
+        ('dwX', wintypes.DWORD),
+        ('dwY', wintypes.DWORD),
+        ('dwXSize', wintypes.DWORD),
+        ('dwYSize', wintypes.DWORD),
+        ('dwXCountChars', wintypes.DWORD),
+        ('dwYCountChars', wintypes.DWORD),
+        ('dwFillAttribute', wintypes.DWORD),
+        ('dwFlags', wintypes.DWORD),
+        ('wShowWindow', wintypes.WORD),
+        ('cbReserved2', wintypes.WORD),
+        ('lpReserved2', ctypes.POINTER(ctypes.c_byte)),
+        ('hStdInput', wintypes.HANDLE),
+        ('hStdOutput', wintypes.HANDLE),
+        ('hStdError', wintypes.HANDLE),
+    ]
+
+class PROCESS_INFORMATION(ctypes.Structure):
+    _fields_ = [
+        ('hProcess', wintypes.HANDLE),
+        ('hThread', wintypes.HANDLE),
+        ('dwProcessId', wintypes.DWORD),
+        ('dwThreadId', wintypes.DWORD),
+    ]
+
+si = STARTUPINFO()
+si.cb = ctypes.sizeof(STARTUPINFO)
+
+pi = PROCESS_INFORMATION()
+
+cmd = subprocess.list2cmdline(['python', '-c', 'print("hello")'])
+cmd_buf = ctypes.create_unicode_buffer(cmd)
+
+success = kernel32.CreateProcessW(
+    None,
+    cmd_buf,
+    None,
+    None,
+    False,  # bInheritHandles
+    0,      # dwCreationFlags
+    None,
+    None,
+    ctypes.byref(si),
+    ctypes.byref(pi)
+)
+
+if success:
+    print('Success! PID:', pi.dwProcessId)
+    kernel32.WaitForSingleObject(pi.hProcess, 5000)
+    kernel32.CloseHandle(pi.hProcess)
+    kernel32.CloseHandle(pi.hThread)
+else:
+    err = ctypes.get_last_error()
+    print('Failed with error:', err)
diff --git a/test_create_ex.py b/test_create_ex.py
new file mode 100644
index 0000000..c5888ec
--- /dev/null
+++ b/test_create_ex.py
@@ -0,0 +1,110 @@
+import ctypes
+from ctypes import wintypes
+import subprocess
+
+kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+EXTENDED_STARTUPINFO_PRESENT = 0x00080000
+PROC_THREAD_ATTRIBUTE_HANDLE_LIST = 0x00020002
+STARTF_USESTDHANDLES = 0x00000100
+STD_INPUT_HANDLE = -10 & 0xFFFFFFFF
+STD_OUTPUT_HANDLE = -11 & 0xFFFFFFFF
+STD_ERROR_HANDLE = -12 & 0xFFFFFFFF
+
+class STARTUPINFOEX(ctypes.Structure):
+    _fields_ = [
+        ('cb', wintypes.DWORD),
+        ('lpReserved', wintypes.LPWSTR),
+        ('lpDesktop', wintypes.LPWSTR),
+        ('lpTitle', wintypes.LPWSTR),
+        ('dwX', wintypes.DWORD),
+        ('dwY', wintypes.DWORD),
+        ('dwXSize', wintypes.DWORD),
+        ('dwYSize', wintypes.DWORD),
+        ('dwXCountChars', wintypes.DWORD),
+        ('dwYCountChars', wintypes.DWORD),
+        ('dwFillAttribute', wintypes.DWORD),
+        ('dwFlags', wintypes.DWORD),
+        ('wShowWindow', wintypes.WORD),
+        ('cbReserved2', wintypes.WORD),
+        ('lpReserved2', ctypes.POINTER(ctypes.c_byte)),
+        ('hStdInput', wintypes.HANDLE),
+        ('hStdOutput', wintypes.HANDLE),
+        ('hStdError', wintypes.HANDLE),
+        ('lpAttributeList', ctypes.c_void_p),
+    ]
+
+class PROCESS_INFORMATION(ctypes.Structure):
+    _fields_ = [
+        ('hProcess', wintypes.HANDLE),
+        ('hThread', wintypes.HANDLE),
+        ('dwProcessId', wintypes.DWORD),
+        ('dwThreadId', wintypes.DWORD),
+    ]
+
+# Get standard handles
+stdin_h = kernel32.GetStdHandle(STD_INPUT_HANDLE)
+stdout_h = kernel32.GetStdHandle(STD_OUTPUT_HANDLE)
+stderr_h = kernel32.GetStdHandle(STD_ERROR_HANDLE)
+
+print('stdin:', stdin_h, 'stdout:', stdout_h, 'stderr:', stderr_h)
+
+# Initialize attribute list
+attr_list_size = ctypes.c_size_t(0)
+kernel32.InitializeProcThreadAttributeList(None, 1, 0, ctypes.byref(attr_list_size))
+print('attr_list_size:', attr_list_size.value)
+
+attr_list = ctypes.create_string_buffer(attr_list_size.value)
+success = kernel32.InitializeProcThreadAttributeList(attr_list, 1, 0, ctypes.byref(attr_list_size))
+print('InitializeProcThreadAttributeList success:', success)
+if not success:
+    print('Error:', ctypes.get_last_error())
+
+# Create handle array with std handles
+handles = [int(stdin_h), int(stdout_h), int(stderr_h)]
+handle_array = (wintypes.HANDLE * len(handles))(*handles)
+
+success = kernel32.UpdateProcThreadAttribute(
+    attr_list, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
+    handle_array, ctypes.sizeof(handle_array), None, None
+)
+print('UpdateProcThreadAttribute success:', success)
+if not success:
+    print('Error:', ctypes.get_last_error())
+
+si = STARTUPINFOEX()
+si.cb = ctypes.sizeof(STARTUPINFOEX)
+si.lpAttributeList = ctypes.cast(attr_list, ctypes.c_void_p)
+si.dwFlags = STARTF_USESTDHANDLES
+si.hStdInput = stdin_h
+si.hStdOutput = stdout_h
+si.hStdError = stderr_h
+
+pi = PROCESS_INFORMATION()
+
+cmd = subprocess.list2cmdline(['python', '-c', 'print("hello from ex")'])
+cmd_buf = ctypes.create_unicode_buffer(cmd)
+
+success = kernel32.CreateProcessW(
+    None,
+    cmd_buf,
+    None,
+    None,
+    True,  # bInheritHandles must be True
+    EXTENDED_STARTUPINFO_PRESENT,
+    None,
+    None,
+    ctypes.byref(si),
+    ctypes.byref(pi)
+)
+
+if success:
+    print('Success! PID:', pi.dwProcessId)
+    kernel32.WaitForSingleObject(pi.hProcess, 5000)
+    kernel32.CloseHandle(pi.hProcess)
+    kernel32.CloseHandle(pi.hThread)
+else:
+    err = ctypes.get_last_error()
+    print('Failed with error:', err)
+
+kernel32.DeleteProcThreadAttributeList(attr_list)
diff --git a/test_debug.py b/test_debug.py
new file mode 100644
index 0000000..f5d9ed0
--- /dev/null
+++ b/test_debug.py
@@ -0,0 +1,30 @@
+import sys
+sys.path.insert(0, '/testbed')
+
+from wspawn._winapi import get_handle_information, HANDLE_FLAG_INHERIT, _open_nul_write
+import ctypes
+from ctypes import wintypes
+
+kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+# Open NUL for writing
+nul_h = _open_nul_write()
+print('NUL handle:', nul_h)
+
+# Check if it's inheritable
+flags = get_handle_information(nul_h)
+print('Flags:', hex(flags))
+print('Is inheritable:', bool(flags & HANDLE_FLAG_INHERIT))
+
+# Try to make it inheritable
+success = kernel32.SetHandleInformation(wintypes.HANDLE(nul_h), HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT)
+print('SetHandleInformation success:', success)
+if not success:
+    print('Error:', ctypes.get_last_error())
+
+# Check again
+flags = get_handle_information(nul_h)
+print('Flags after set:', hex(flags))
+print('Is inheritable after set:', bool(flags & HANDLE_FLAG_INHERIT))
+
+kernel32.CloseHandle(wintypes.HANDLE(nul_h))
