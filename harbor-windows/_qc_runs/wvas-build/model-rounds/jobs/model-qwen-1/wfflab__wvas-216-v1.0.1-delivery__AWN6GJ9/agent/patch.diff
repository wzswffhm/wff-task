diff --git a/_probe_tmp.py b/_probe_tmp.py
new file mode 100644
index 0000000..93ab1a3
--- /dev/null
+++ b/_probe_tmp.py
@@ -0,0 +1,57 @@
+import ctypes, os, sys
+from ctypes import wintypes as wt
+
+sys.path.insert(0, r'C:\testbed')
+k32 = ctypes.WinDLL('kernel32', use_last_error=True)
+k32.CreateFileW.restype = wt.HANDLE
+k32.CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, wt.LPVOID, wt.DWORD, wt.DWORD, wt.HANDLE]
+k32.GetFinalPathNameByHandleW.restype = wt.DWORD
+k32.GetFinalPathNameByHandleW.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD, wt.DWORD]
+
+fp = ctypes.create_unicode_buffer(32768)
+INVALID = ctypes.c_void_p(-1).value
+
+for path in (r'C:\Python312\python312.dll', r'C:\testbed\README.md',
+             r'C:\Users\ContainerAdministrator\AppData\Local\Temp',
+             r'C:\Windows\System32\l_intl.nls', r'C:\testbed', r'C:\Python312'):
+    hf = k32.CreateFileW(path, 0x0080, 0x7, None, 3, 0x02000000, None)
+    if not hf or hf == INVALID:
+        print('open fail', path, ctypes.get_last_error())
+        continue
+    n = k32.GetFinalPathNameByHandleW(hf, fp, 32768, 1)  # VOLUME_NAME_NT
+    print(path)
+    print('   NT :', repr(fp.value) if n else 'err %d' % ctypes.get_last_error())
+    n = k32.GetFinalPathNameByHandleW(hf, fp, 32768, 0)  # VOLUME_NAME_DOS
+    print('   DOS:', repr(fp.value) if n else 'err %d' % ctypes.get_last_error())
+    k32.CloseHandle(hf)
+
+# create a file inside the repo and see what its NT name is
+d = os.path.join(r'C:\testbed', '_probe_dir')
+os.makedirs(d, exist_ok=True)
+p = os.path.join(d, 'probe.bin')
+with open(p, 'wb') as f:
+    f.write(b'z' * 4096)
+hf = k32.CreateFileW(p, 0x0080, 0x7, None, 3, 0x02000000, None)
+n = k32.GetFinalPathNameByHandleW(hf, fp, 32768, 1)
+print('repo file NT:', repr(fp.value) if n else 'err %d' % ctypes.get_last_error())
+n = k32.GetFinalPathNameByHandleW(hf, fp, 32768, 0)
+print('repo file DOS:', repr(fp.value) if n else 'err %d' % ctypes.get_last_error())
+k32.CloseHandle(hf)
+
+# map it and see what GetMappedFileNameW says
+psapi = ctypes.WinDLL('psapi', use_last_error=True)
+psapi.GetMappedFileNameW.restype = wt.DWORD
+psapi.GetMappedFileNameW.argtypes = [wt.HANDLE, wt.LPCVOID, wt.LPWSTR, wt.DWORD]
+k32.CreateFileMappingW.restype = wt.HANDLE
+k32.CreateFileMappingW.argtypes = [wt.HANDLE, wt.LPVOID, wt.DWORD, wt.DWORD, wt.DWORD, wt.LPCWSTR]
+k32.MapViewOfFile.restype = wt.LPVOID
+k32.MapViewOfFile.argtypes = [wt.HANDLE, wt.DWORD, wt.DWORD, wt.DWORD, ctypes.c_size_t]
+hf2 = k32.CreateFileW(p, 0x80000000, 0x3, None, 3, 0x80, None)
+print('open rw', hf2, ctypes.get_last_error())
+hm = k32.CreateFileMappingW(hf2, None, 0x02, 0, 0, None)
+print('section', hm, ctypes.get_last_error())
+view = k32.MapViewOfFile(hm, 0x0004, 0, 0, 0)
+print('view', hex(view), ctypes.get_last_error())
+buf = ctypes.create_unicode_buffer(32768)
+got = psapi.GetMappedFileNameW(k32.GetCurrentProcess(), ctypes.c_void_p(view), buf, 32768)
+print('mapped name:', repr(buf.value) if got else 'err %d' % ctypes.get_last_error())
