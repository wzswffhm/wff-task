+_POINTER_BITS = ctypes.sizeof(ctypes.c_void_p) * 8
+
+#: Upper bound used when nothing better can be learnt from the system.
+DEFAULT_MAX_ADDRESS = 0x7FFFFFFFFFFF if _POINTER_BITS == 64 else 0xFFFFFFFF
+
+
+def max_application_address():
+    """Highest address the auditor has to probe, inclusive."""
+    if not AVAILABLE:
+        return DEFAULT_MAX_ADDRESS
+    info = SYSTEM_INFO()
+    try:
+        GetNativeSystemInfo(ctypes.byref(info))
+    except Exception:  # pragma: no cover - defensive
+        try:
+            GetSystemInfo(ctypes.byref(info))
+        except Exception:
+            return DEFAULT_MAX_ADDRESS
+    highest = info.lpMaximumApplicationAddress or 0
+    if _POINTER_BITS == 64 and highest < DEFAULT_MAX_ADDRESS:
+        # A 64 bit auditor can be asked about a 64 bit target even when the
+        # reported maximum belongs to a narrower view of the address space.
+        highest = DEFAULT_MAX_ADDRESS
+    return highest or DEFAULT_MAX_ADDRESS
+
+
+def page_size():
+    if not AVAILABLE:
+        return 0x1000
+    info = SYSTEM_INFO()
+    try:
+        GetSystemInfo(ctypes.byref(info))
+    except Exception:  # pragma: no cover - defensive
+        return 0x1000
+    return info.dwPageSize or 0x1000
