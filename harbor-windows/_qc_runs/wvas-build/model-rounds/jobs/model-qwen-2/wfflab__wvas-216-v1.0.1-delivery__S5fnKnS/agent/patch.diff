+        for name in self._names:
+            if upper == name:
+                return self._spell(self._devices[name], rest)
+            if upper.startswith(name + "\\"):
+                tail = device[len(name) + 1:]
+                if rest:
+                    tail = tail + "\\" + rest
+                return self._spell(self._devices[name], tail)
+
+        return self._spell(self._outside_roots(device), rest)
 
+    def _spell(self, roots, rest):
+        rest = (rest or "").strip("\\")
+        out = []
+        for root in roots:
+            candidate = root + rest if rest else root
+            if candidate and candidate not in out:
+                out.append(candidate)
+        if len(out) > 1:
+            # More than one DOS name can reach the same file (a substituted
+            # drive, a second mount point); prefer one that exists here.
+            out.sort(key=lambda item: (not _path_exists(item), item))
+        return out
 
