diff --git a/_probe_dev.py b/_probe_dev.py
new file mode 100644
index 0000000..0613f67
--- /dev/null
+++ b/_probe_dev.py
@@ -0,0 +1,61 @@
+"""Temporary probe of the container's device naming - deleted before submit."""
+
+import ctypes
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, r"C:\testbed")
+from wvas import _winapi as w
+from wvas import vas
+
+k32 = w.kernel32
+k32.CreateFileW.restype = ctypes.c_void_p
+k32.CreateFileW.argtypes = [ctypes.c_wchar_p, ctypes.c_uint32, ctypes.c_uint32,
+                            ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32,
+                            ctypes.c_void_p]
+k32.CreateFileMappingW.restype = ctypes.c_void_p
+k32.CreateFileMappingW.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint32,
+                                   ctypes.c_uint32, ctypes.c_uint32, ctypes.c_wchar_p]
+k32.MapViewOfFile.restype = ctypes.c_void_p
+k32.MapViewOfFile.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32,
+                              ctypes.c_uint32, ctypes.c_size_t]
+k32.UnmapViewOfFile.argtypes = [ctypes.c_void_p]
+k32.CloseHandle.argtypes = [ctypes.c_void_p]
+
+handle = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ, False,
+                       os.getpid())
+made = []
+for index, directory in enumerate((tempfile.gettempdir(), r"C:\testbed",
+                                   r"C:\Python312", r"C:\Windows")):
+    if not os.path.isdir(directory):
+        print("skip", directory)
+        continue
+    path = os.path.join(directory, "wvas_probe_map_%d.bin" % index)
+    with open(path, "wb") as handle2:
+        handle2.write(b"y" * 65536)
+    made.append(path)
+    fh = k32.CreateFileW(path, 0x80000000, 1, None, 3, 0, None)
+    section = k32.CreateFileMappingW(fh, None, 2, 0, 65536, None)
+    view = k32.MapViewOfFile(section, 4, 0, 0, 65536)
+    raw = vas._mapped_file_name(handle, view)
+    print()
+    print("dir     :", directory)
+    print("path    :", path)
+    print("raw     :", raw)
+    print("resolved:", vas.RESOLVER.openable(raw))
+    print("realpath:", os.path.realpath(path))
+    print("candidates:", vas.RESOLVER._candidates(
+        *vas._split_device(vas._normalise(raw))))
+    k32.UnmapViewOfFile(view)
+    k32.CloseHandle(section)
+    k32.CloseHandle(fh)
+
+print()
+print("python312.dll raw:", vas._mapped_file_name(handle, ctypes.addressof(
+    ctypes.c_char.from_address(0))))
+for path in made:
+    try:
+        os.remove(path)
+    except OSError as error:
+        print("leftover", path, error)
diff --git a/_probe_tmp.py b/_probe_tmp.py
new file mode 100644
index 0000000..13ae09c
--- /dev/null
+++ b/_probe_tmp.py
@@ -0,0 +1,301 @@
+"""Temporary behavioural probe - deleted before submit."""
+
+import ctypes
+import os
+import subprocess
+import sys
+import tempfile
+import textwrap
+
+sys.path.insert(0, r"C:\testbed")
+
+import wvas
+from wvas import _winapi as w
+
+CHILD = textwrap.dedent(r'''
+    import ctypes, os, sys, tempfile, time
+
+    k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    k32.VirtualAlloc.restype = ctypes.c_void_p
+    k32.VirtualAlloc.argtypes = [ctypes.c_void_p, ctypes.c_size_t,
+                                 ctypes.c_uint32, ctypes.c_uint32]
+    MEM_RESERVE, MEM_COMMIT, PAGE_READWRITE, PAGE_NOACCESS = 0x2000, 0x1000, 4, 1
+    GB = 1024 ** 3
+
+    big = k32.VirtualAlloc(None, 6 * GB, MEM_RESERVE, PAGE_NOACCESS) or 0
+    inside = 0
+    if big:
+        inside = k32.VirtualAlloc(ctypes.c_void_p(big + 5 * GB), 4096,
+                                  MEM_COMMIT, PAGE_READWRITE) or 0
+    high = k32.VirtualAlloc(ctypes.c_void_p(0x0000020000000000), 300 * 1024 * 1024,
+                            MEM_RESERVE, PAGE_NOACCESS) or 0
+
+    path = os.path.join(tempfile.gettempdir(), "wvas_probe_mapped.bin")
+    with open(path, "wb") as handle:
+        handle.write(b"x" * (2 * 1024 * 1024))
+    k32.CreateFileW.restype = ctypes.c_void_p
+    k32.CreateFileW.argtypes = [ctypes.c_wchar_p, ctypes.c_uint32, ctypes.c_uint32,
+                                ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32,
+                                ctypes.c_void_p]
+    fh = k32.CreateFileW(path, 0x80000000, 1, None, 3, 0, None)
+    k32.CreateFileMappingW.restype = ctypes.c_void_p
+    k32.CreateFileMappingW.argtypes = [ctypes.c_void_p, ctypes.c_void_p,
+                                       ctypes.c_uint32, ctypes.c_uint32,
+                                       ctypes.c_uint32, ctypes.c_wchar_p]
+    k32.MapViewOfFile.restype = ctypes.c_void_p
+    k32.MapViewOfFile.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32,
+                                  ctypes.c_uint32, ctypes.c_size_t]
+    INVALID = ctypes.c_void_p(-1).value
+    section = k32.CreateFileMappingW(fh, None, 2, 0, 2 * 1024 * 1024, None)
+    mapped = k32.MapViewOfFile(section, 4, 0, 0, 2 * 1024 * 1024) or 0
+    anon_section = k32.CreateFileMappingW(INVALID, None, 4, 0, 65536, None)
+    anon = k32.MapViewOfFile(anon_section, 4, 0, 0, 65536) or 0
+
+    sys.stdout.write("%d %d %d %d %d %d %s\n" % (os.getpid(), big, inside, high,
+                                                 mapped, anon, path))
+    sys.stdout.flush()
+    time.sleep(40)
+''')
+
+script = os.path.join(tempfile.gettempdir(), "wvas_probe_child.py")
+with open(script, "w") as handle:
+    handle.write(CHILD)
+
+proc = subprocess.Popen([sys.executable, script], stdout=subprocess.PIPE, text=True)
+line = proc.stdout.readline().strip()
+pid, big, inside, high, mapped, anon, mapped_file = line.split()
+pid, big, inside, high, mapped, anon = map(int, (pid, big, inside, high, mapped, anon))
+print("child pid=%d big=0x%x inside=0x%x high=0x%x mapped=0x%x anon=0x%x"
+      % (pid, big, inside, high, mapped, anon))
+print("mapped file:", mapped_file)
+
+failures = []
+
+
+def check(label, condition, detail=""):
+    print(("PASS " if condition else "FAIL ") + label
+          + ((" :: " + detail) if detail else ""))
+    if not condition:
+        failures.append(label)
+
+
+class MBI(ctypes.Structure):
+    _fields_ = [
+        ("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+        ("AllocationProtect", w.DWORD), ("RegionSize", ctypes.c_size_t),
+        ("State", w.DWORD), ("Protect", w.DWORD), ("Type", w.DWORD),
+    ]
+
+
+handle = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ, False, pid)
+truth = {}
+mbi = MBI()
+address = 0
+while address < 0x7FFFFFFEFFFF:
+    if not w.VirtualQueryEx(handle, address, ctypes.byref(mbi), ctypes.sizeof(mbi)):
+        break
+    if mbi.State in (w.MEM_COMMIT, w.MEM_RESERVE):
+        truth[mbi.BaseAddress] = (mbi.RegionSize, mbi.State, mbi.Type, mbi.Protect)
+    nxt = mbi.BaseAddress + mbi.RegionSize
+    if nxt <= address:
+        break
+    address = nxt
+w.CloseHandle(handle)
+print("independently measured %d commit/reserve regions" % len(truth))
+
+reported = wvas.regions(pid)
+check("regions() reports every measured region", len(reported) == len(truth),
+      "reported=%d measured=%d" % (len(reported), len(truth)))
+check("keys are exactly the documented seven",
+      all(set(item) == {"base", "size", "state", "type", "protect", "path", "image"}
+          for item in reported))
+check("ordered by base",
+      [i["base"] for i in reported] == sorted(i["base"] for i in reported))
+mismatch = [(hex(i["base"]), i["size"], truth.get(i["base"])) for i in reported
+            if i["base"] not in truth or truth[i["base"]][0] != i["size"]]
+check("every base/size matches VirtualQueryEx exactly", not mismatch, str(mismatch[:4]))
+states = {i["base"]: i["state"] for i in reported}
+bad_state = [hex(b) for b, (size, state, t, p) in truth.items()
+             if states.get(b) != ("commit" if state == w.MEM_COMMIT else "reserve")]
+check("state matches the measured MEM_COMMIT/MEM_RESERVE", not bad_state,
+      str(bad_state[:4]))
+
+above4g = [i for i in reported if i["base"] > 0xFFFFFFFF]
+check("regions above 4 GiB keep their full address", bool(above4g),
+      "%d above 4GiB, e.g. 0x%x" % (len(above4g), above4g[0]["base"])
+      if above4g else "none")
+
+six = [i for i in reported if inside and i["base"] <= inside < i["base"] + i["size"]
+       and i["state"] == "commit"]
+check("committed page inside the 6 GiB reservation reported", bool(six))
+res6 = [i for i in reported if big and i["state"] == "reserve"
+        and i["base"] <= big < i["base"] + i["size"]]
+check("the 6 GiB reservation reported as reserve", bool(res6))
+if big:
+    total = sum(i["size"] for i in reported if i["state"] == "reserve"
+                and big <= i["base"] < big + 6 * 1024 ** 3)
+    check("sizes above 4 GiB are not truncated", total >= 5 * 1024 ** 3,
+          "reserved span = %d bytes" % total)
+check("a reserve region exists above 4 GiB",
+      any(i["state"] == "reserve" and i["base"] > 0xFFFFFFFF for i in reported))
+
+committed_only = wvas.regions(pid, include_reserved=False)
+check("include_reserved=False drops every reserve region",
+      all(i["state"] == "commit" for i in committed_only)
+      and len(committed_only) < len(reported),
+      "commit=%d all=%d" % (len(committed_only), len(reported)))
+
+backed = wvas.file_backed_regions(pid)
+check("file_backed_regions == path-carrying subset, same order",
+      backed == [i for i in reported if i["path"] is not None])
+paths = [i["path"] for i in reported if i["path"] is not None]
+check("no empty-string path anywhere", all(p for p in paths))
+check("no path is an internal device name",
+      not any(p.startswith("\\Device") or p.startswith("\\??") or p.startswith("\\\\?")
+              for p in paths), str([p for p in paths if p.startswith("\\")][:3]))
+check("every path is a drive path or a UNC path",
+      all((len(p) > 1 and p[1] == ":") or p.startswith("\\\\") for p in paths))
+check("every local path really exists",
+      all(p.startswith("\\\\") or os.path.exists(p) for p in paths),
+      str([p for p in paths if not p.startswith("\\\\") and not os.path.exists(p)][:3]))
+
+if mapped:
+    region = [i for i in reported if i["base"] <= mapped < i["base"] + i["size"]]
+    check("the file mapped view is reported", bool(region))
+    if region:
+        got = region[0]["path"]
+        check("mapped region path == real file path",
+              got is not None and os.path.normcase(os.path.realpath(got))
+              == os.path.normcase(os.path.realpath(mapped_file)),
+              "reported=%r expected=%r" % (got, mapped_file))
+        check("mapped region path can be opened", bool(got) and os.path.exists(got))
+        check("mapped region type is 'mapped'", region[0]["type"] == "mapped",
+              region[0]["type"])
+
+if anon:
+    region = [i for i in reported if i["base"] <= anon < i["base"] + i["size"]]
+    check("the anonymous mapping is reported", bool(region))
+    if region:
+        check("anonymous mapping path is None, not ''",
+              region[0]["path"] is None, repr(region[0]["path"]))
+
+private = [i for i in reported if i["type"] == "private"]
+check("private regions carry no path", all(i["path"] is None for i in private),
+      str([i["path"] for i in private if i["path"]][:3]))
+reserve = [i for i in reported if i["state"] == "reserve"]
+check("reserved regions carry no path", all(i["path"] is None for i in reserve))
+check("image flag agrees with the type",
+      all(i["image"] == (i["type"] == "image") for i in reported))
+check("protection names are all short names",
+      all(i["protect"] in {"none", "r", "rw", "wc", "x", "xr", "xrw", "xwc", "?"}
+          for i in reported), str(sorted(set(i["protect"] for i in reported))))
+check("no '?' protections", not [i for i in reported if i["protect"] == "?"],
+      str([(hex(i["base"]), i["state"]) for i in reported
+           if i["protect"] == "?"][:5]))
+
+mods = wvas.modules(pid)
+check("modules() is non empty", bool(mods))
+check("modules() ordered by base",
+      [m["base"] for m in mods] == sorted(m["base"] for m in mods))
+bases = [m["base"] for m in mods]
+check("no module base repeated", len(bases) == len(set(bases)))
+mpaths = [m["path"] for m in mods if m["path"]]
+check("no module path repeated", len(mpaths) == len(set(mpaths)),
+      str([p for p in set(mpaths) if mpaths.count(p) > 1]))
+check("every module path exists", all(os.path.exists(p) for p in mpaths),
+      str([p for p in mpaths if not os.path.exists(p)][:3]))
+check("no module path is a device name",
+      not any(p.startswith("\\Device") or p.startswith("\\??") for p in mpaths))
+check("all module paths reported", len(mpaths) == len(mods),
+      "%d/%d" % (len(mpaths), len(mods)))
+check("python's own DLL is among the modules",
+      any(os.path.basename(p).lower().startswith("python3") for p in mpaths),
+      str([os.path.basename(p) for p in mpaths][:8]))
+check("module sizes are sane", all(0 < m["size"] < 1 << 32 for m in mods))
+image_regions = [i for i in reported if i["image"]]
+check("module list is shorter than the raw image regions",
+      len(mods) < len(image_regions),
+      "%d modules vs %d image regions" % (len(mods), len(image_regions)))
+covered = set(i["base"] for i in image_regions)
+check("every image region falls inside exactly one module",
+      all(any(m["base"] <= b < m["base"] + m["size"] for m in mods) for b in covered))
+check("module base is an image region base",
+      all(any(i["base"] == m["base"] for i in image_regions) for m in mods))
+
+for bad, kind in ((-1, "badarg"), (0, "badarg"), ("x", "badarg"), (True, "badarg")):
+    for function in (wvas.regions, wvas.modules, wvas.file_backed_regions):
+        try:
+            function(bad)
+            check("%s(%r) raises %s" % (function.__name__, bad, kind), False,
+                  "no error raised")
+        except wvas.WVasError as error:
+            check("%s(%r) raises %s" % (function.__name__, bad, kind),
+                  error.kind == kind, error.kind)
+        except OSError as error:
+            check("%s(%r) raises %s" % (function.__name__, bad, kind), False,
+                  "leaked OSError %r" % (error,))
+
+dead = 4194301
+for function in (wvas.regions, wvas.modules, wvas.file_backed_regions):
+    try:
+        function(dead)
+        check("%s(dead) raises no-such-process" % function.__name__, False,
+              "no error raised")
+    except wvas.WVasError as error:
+        check("%s(dead) raises no-such-process" % function.__name__,
+              error.kind == "no-such-process", error.kind)
+    except OSError as error:
+        check("%s(dead) raises no-such-process" % function.__name__, False,
+              "leaked OSError %r" % (error,))
+
+protected = None
+buf = (w.DWORD * 8192)()
+need = w.DWORD(0)
+w.EnumProcesses(buf, 8192 * 4, ctypes.byref(need))
+for candidate in buf[: need.value // 4]:
+    if candidate in (0, 4, os.getpid(), pid):
+        continue
+    h = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ, False,
+                      candidate)
+    if h:
+        w.CloseHandle(h)
+        continue
+    if w.last_error() == w.ERROR_ACCESS_DENIED:
+        protected = candidate
+        break
+if protected:
+    try:
+        wvas.regions(protected)
+        check("protected pid %d raises access-denied" % protected, False, "no error")
+    except wvas.WVasError as error:
+        check("protected pid %d raises access-denied" % protected,
+              error.kind == "access-denied", error.kind)
+else:
+    print("SKIP access-denied (no protected process found)")
+
+check("protection_name is pure",
+      wvas.protection_name(0x04) == "rw" and wvas.protection_name(0x20) == "xr"
+      and wvas.protection_name(0x104) == "r")
+check("type_name is pure",
+      wvas.type_name(0x1000000) == "image" and wvas.type_name(0x40000) == "mapped"
+      and wvas.type_name(0x20000) == "private")
+
+other = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(6)"])
+try:
+    data = wvas.regions(other.pid)
+    check("an unrelated live process can be audited", bool(data),
+          "%d regions" % len(data))
+    omods = wvas.modules(other.pid)
+    check("its module list has real paths",
+          bool(omods) and all(m["path"] and os.path.exists(m["path"]) for m in omods),
+          str([m["path"] for m in omods][:4]))
+finally:
+    other.kill()
+
+proc.kill()
+proc.wait()
+print()
+print("FAILURES: %d" % len(failures))
+for item in failures:
+    print(" -", item)
+sys.exit(1 if failures else 0)
