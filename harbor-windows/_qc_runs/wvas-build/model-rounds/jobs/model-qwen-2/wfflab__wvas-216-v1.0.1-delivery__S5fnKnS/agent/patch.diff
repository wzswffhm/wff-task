+class _PathResolver(object):
+    """Translate the NT names the system reports into openable Windows paths.
+
+    The system names a mapped file by its NT device path
+    (``\\Device\\HarddiskVolume5\\Users\\...``), which no editor, no explorer and
+    no support engineer can open.  The translation is learned from the machine
+    the collector runs on: every DOS device is asked which NT device it points
+    at.  That also covers a mapped network drive, whose letter resolves to a UNC
+    share instead of a local volume, and a substituted drive.
+
+    The table is rebuilt for every audit -- it costs a few dozen cheap calls and
+    drive letters come and go -- and it is never baked into a constant, because
+    drive letters belong to the machine, not to the package.
+    """
+
+    def __init__(self):
+        self.refresh()
+
+    def refresh(self):
+        """Forget everything learned about this machine's devices."""
+        self._devices = None
+        self._names = ()
+        self._foreign = {}
+        self._cache = {}
+        self._foreign_roots = None
+        self._container = None
+
+    # -- learning the machine ------------------------------------------------
+
+    def _dos_aliases(self):
+        aliases = {}
+        if w.query_dos_device is None:
+            return aliases
+        for letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
+            try:
+                targets = w.query_dos_device(letter + ":")
+            except Exception:  # pragma: no cover - defensive
+                targets = None
+            for target in targets or ():
+                if not target.upper().startswith("\\DEVICE\\"):
+                    continue
+                aliases.setdefault(target.upper(), []).append(letter + ":")
+        return aliases
+
+    def _build(self):
+        if self._devices is not None:
+            return
+        aliases = self._dos_aliases()
+        # Longest device name first, so that a substituted drive
+        # ("\\Device\\HarddiskVolume5\\build") wins over the volume it sits on.
+        self._names = tuple(sorted(aliases, key=len, reverse=True))
+        self._devices = aliases
+
+    def _outside_roots(self, device):
+        """The drive letters a file from outside this namespace may live on.
+
+        A file can be named after a device no DOS letter here resolves to -- a
+        container runtime redirecting a host volume into the collector's address
+        space is the common case.  Its NT name still describes where the file
+        sits on that device, so the drive letters of this machine are the only
+        honest spelling left; the filesystem check keeps just the ones that
+        reach a real file.
+        """
+        known = self._foreign.get(device.upper())
+        if known is None:
+            if self._foreign_roots is None:
+                roots = []
+                for letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
+                    try:
+                        if w.query_dos_device(letter + ":"):
+                            roots.append(letter + ":\\")
+                    except Exception:  # pragma: no cover - defensive
+                        continue
