diff --git a/_probe8.py b/_probe8.py
new file mode 100644
index 0000000..992dc1e
--- /dev/null
+++ b/_probe8.py
@@ -0,0 +1,38 @@
+"""Probe 8: reserved region fields, anonymous mapped names."""
+import ctypes, ctypes.wintypes as wt, os, sys
+
+k = ctypes.WinDLL('kernel32', use_last_error=True)
+p = ctypes.WinDLL('psapi', use_last_error=True)
+
+pid = int(sys.argv[1])
+h = k.OpenProcess(0x0410 | 0x0010, False, pid)
+
+class MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+                ("AllocationProtect", wt.DWORD), ("RegionSize", ctypes.c_size_t),
+                ("State", wt.DWORD), ("Protect", wt.DWORD), ("Type", wt.DWORD)]
+
+k.VirtualQueryEx.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.POINTER(MBI), ctypes.c_size_t]
+k.VirtualQueryEx.restype = ctypes.c_size_t
+p.GetMappedFileNameW.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.LPWSTR, wt.DWORD]
+p.GetMappedFileNameW.restype = wt.DWORD
+
+mbi = MBI()
+addr = 0
+while True:
+    n = k.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not n:
+        print('end at', hex(addr), 'err', ctypes.get_last_error())
+        break
+    if mbi.State == 0x2000 or mbi.RegionSize > 0xFFFFFFFF:
+        buf = ctypes.create_unicode_buffer(2048)
+        m = p.GetMappedFileNameW(h, ctypes.c_void_p(mbi.BaseAddress or 0), buf, 2048)
+        name = buf[:m] if m else 'ERR%d' % ctypes.get_last_error()
+        print('base %-16s alloc %-16s size %-14d state %#x prot %#x type %#x name %s' % (
+            hex(mbi.BaseAddress or 0), hex(mbi.AllocationBase or 0), mbi.RegionSize,
+            mbi.State, mbi.Protect, mbi.Type, name))
+    nxt = (mbi.BaseAddress or 0) + mbi.RegionSize
+    if nxt <= addr:
+        break
+    addr = nxt
+k.CloseHandle(h)
