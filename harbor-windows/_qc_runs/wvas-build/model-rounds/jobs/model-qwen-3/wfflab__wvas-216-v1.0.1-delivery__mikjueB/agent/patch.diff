diff --git a/wvas/_winapi.py b/wvas/_winapi.py
index 82faf2f..00f25b2 100644
--- a/wvas/_winapi.py
+++ b/wvas/_winapi.py
@@ -1,13 +1,35 @@
-"""ctypes bindings for the Win32 calls the auditor uses."""
+"""ctypes bindings for the Win32 calls the auditor uses.
+
+Every raw prototype lives here so that :mod:`wvas.vas` stays free of ctypes
+plumbing.  The bindings are created on Windows only; anywhere else
+:data:`AVAILABLE` is ``False`` and the public API answers ``unsupported``
+instead of failing while the collector is still importing its plugins.
+"""
 
 import ctypes
-import ctypes.wintypes as wt
+import sys
+
+# ---- plain Win32 types -----------------------------------------------------
+# Declared with ctypes primitives rather than ctypes.wintypes so that the
+# structures below can be built (and therefore imported) on any platform.
+BOOL = ctypes.c_int
