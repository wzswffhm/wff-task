+def _nt_to_dos_path(nt_path):
+    """Convert an NT device path to a DOS path.
+
+    Converts paths like ``\\Device\\HarddiskVolume5\\Users\\...`` to
+    ``C:\\Users\\...``.  Returns *None* if the conversion cannot be performed.
+    """
+    if not nt_path:
+        return None
+
+    # Handle \\?\ prefix (strip it and try to convert the remainder)
+    if nt_path.startswith("\\??\\"):
+        nt_path = nt_path[4:]
+        # After stripping \\??\ we might have a DOS path already
+        if len(nt_path) >= 2 and nt_path[1] == ':':
+            return nt_path
+        # Or it might be a UNC path
+        if nt_path.startswith("UNC\\"):
+            return "\\\\" + nt_path[4:]
+        # Or it might be a device path
+        if nt_path.startswith("Device\\"):
+            nt_path = "\\Device\\" + nt_path[7:]
+
+    if nt_path.startswith("\\Device\\"):
+        dos_map = _build_dos_device_map()
+        for nt_prefix, dos_drive in dos_map:
+            # nt_prefix is like "\\Device\\HarddiskVolume5"
+            # Check if nt_path starts with nt_prefix + "\\"
+            if nt_path.startswith(nt_prefix + "\\"):
+                remainder = nt_path[len(nt_prefix):]
+                return dos_drive + remainder
+            elif nt_path == nt_prefix:
+                return dos_drive + "\\"
+        # Could not map this device
+        return None
+
+    # Already a DOS path or UNC path
+    if len(nt_path) >= 2 and nt_path[1] == ':':
+        return nt_path
+    if nt_path.startswith("\\\\"):
+        return nt_path
+
+    return None
