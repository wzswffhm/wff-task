+def _build_dos_device_map():
+    """Build a mapping from NT device prefixes to DOS drive letters.
+
+    Returns a list of (nt_prefix, dos_drive) tuples sorted by prefix length
+    descending so that longer matches are tried first.
+    """
+    global _dos_device_cache
+    if _dos_device_cache is not None:
+        return _dos_device_cache
+
+    mapping = []
+    # Get all logical drive strings (e.g., "C:\\\0D:\\\0\0")
+    buf = ctypes.create_unicode_buffer(256)
+    length = w.GetLogicalDriveStringsW(256, buf)
+    if length == 0:
+        _dos_device_cache = mapping
+        return mapping
+
+    # Parse null-separated drive strings
+    drives = []
+    start = 0
+    for i in range(length):
+        if buf[i] == '\0':
+            if i > start:
+                drives.append(buf[start:i])
+            start = i + 1
+
+    for drive in drives:
+        # Remove trailing backslash: "C:\" -> "C:"
+        drive_letter = drive.rstrip('\\')
+        query_buf = ctypes.create_unicode_buffer(256)
+        result = w.QueryDosDeviceW(drive_letter, query_buf, 256)
+        if result:
+            nt_path = query_buf.value
+            mapping.append((nt_path, drive_letter))
+
+    # Sort by NT path length descending for longest-match-first
+    mapping.sort(key=lambda x: len(x[0]), reverse=True)
+    _dos_device_cache = mapping
+    return mapping
