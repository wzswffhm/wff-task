+# Cache for NT device prefix -> DOS drive letter mapping
+_drive_map_cache = None
+
+
+def _build_drive_map():
+    """Build a mapping from NT device paths to DOS drive letters.
+
+    Returns a list of (nt_prefix, dos_prefix) tuples sorted by length
+    descending so that longer matches are tried first.
+    """
+    global _drive_map_cache
+    if _drive_map_cache is not None:
+        return _drive_map_cache
+
+    mapping = []
+    # Get all logical drive strings
+    buf_size = 256
+    buf = ctypes.create_unicode_buffer(buf_size)
+    result = w.GetLogicalDriveStringsW(buf_size, buf)
+    if result == 0:
+        _drive_map_cache = mapping
+        return mapping
+
+    # Parse null-separated drive strings like "C:\\\0D:\\\0\0"
+    drives = []
+    start = 0
+    for i in range(result):
+        if buf[i] == '\0':
+            if i > start:
+                drives.append(buf[start:i])
+            start = i + 1
+
+    for drive in drives:
+        # drive is like "C:\"
+        # QueryDosDeviceW wants "C:" (without trailing backslash)
+        device_name = drive.rstrip('\\')
+        nt_buf = ctypes.create_unicode_buffer(PATH_BUFFER_CHARS)
+        ret = w.QueryDosDeviceW(device_name, nt_buf, PATH_BUFFER_CHARS)
+        if ret > 0:
+            nt_path = nt_buf.value
+            # nt_path is like "\\Device\\HarddiskVolume5"
+            # We want to map this to "C:"
+            mapping.append((nt_path, device_name))
+
+    # Sort by length descending so longest match wins
+    mapping.sort(key=lambda x: len(x[0]), reverse=True)
+    _drive_map_cache = mapping
+    return mapping
+
+
+def _nt_path_to_dos(nt_path):
+    """Convert an NT path like \\Device\\HarddiskVolume5\\... to a DOS path.
+
+    Returns the DOS path string, or None if conversion fails.
+    """
+    if not nt_path:
+        return None
+
+    drive_map = _build_drive_map()
+    for nt_prefix, dos_prefix in drive_map:
+        if nt_path.startswith(nt_prefix + '\\'):
+            # Replace the NT prefix with the DOS drive letter
+            remainder = nt_path[len(nt_prefix):]
+            return dos_prefix + remainder
+        elif nt_path == nt_prefix:
+            return dos_prefix
+
+    # Try handling \\??\\ prefix (some systems use this)
+    if nt_path.startswith('\\??\\'):
+        inner = nt_path[4:]
+        # This might already be a DOS-style path like C:\...
+        if len(inner) >= 2 and inner[1] == ':':
+            return inner
+        # Otherwise try matching against drive map
+        for nt_prefix, dos_prefix in drive_map:
+            if inner.startswith(nt_prefix + '\\'):
+                remainder = inner[len(nt_prefix):]
+                return dos_prefix + remainder
+
+    return None
+
