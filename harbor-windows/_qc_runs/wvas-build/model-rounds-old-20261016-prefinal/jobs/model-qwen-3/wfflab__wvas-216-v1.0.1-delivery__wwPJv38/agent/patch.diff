diff --git a/wvas/_winapi.py b/wvas/_winapi.py
index 82faf2f..2489c4a 100644
--- a/wvas/_winapi.py
+++ b/wvas/_winapi.py
@@ -1,4 +1,17 @@
-"""ctypes bindings for the Win32 calls the auditor uses."""
+"""ctypes bindings for the Win32 calls the auditor uses.
+
+Everything here is a thin, faithful declaration of the platform SDK
+prototype.  Two details matter more than the rest and are worth spelling
+out:
+
+* the user-mode address space of a process is 48 bits wide on x64, so every
+  address and every length has to keep full width - truncating them to 32
+  bits is what makes high regions and multi-gigabyte reservations
+  unreadable;
+* ``MEMORY_BASIC_INFORMATION`` is laid out differently by a 32-bit and by a
+  64-bit process, so the structure is chosen here from the pointer size this
+  interpreter was built with.
+"""
 
 import ctypes
 import ctypes.wintypes as wt
@@ -6,8 +19,12 @@ import ctypes.wintypes as wt
 kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
 psapi = ctypes.WinDLL("psapi", use_last_error=True)
 
+#: True when this interpreter is a 64-bit process.
+IS_64BIT = ctypes.sizeof(ctypes.c_void_p) == 8
+
 # ---- access rights ---------------------------------------------------------
 PROCESS_QUERY_INFORMATION = 0x0400
+PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
 PROCESS_VM_READ = 0x0010
 
 # ---- region state ----------------------------------------------------------
@@ -31,18 +48,85 @@ PAGE_EXECUTE_READWRITE = 0x40
 PAGE_EXECUTE_WRITECOPY = 0x80
 PAGE_GUARD = 0x100
 
+# ---- file access and creation ---------------------------------------------
+GENERIC_READ = 0x80000000
+FILE_SHARE_READ = 0x00000001
+FILE_SHARE_WRITE = 0x00000002
+FILE_SHARE_DELETE = 0x00000004
+OPEN_EXISTING = 3
+FILE_FLAG_BACKUP_SEMANTICS = 0x02000000
+
+#: ``VOLUME_NAME_DOS`` - ask for the drive letter form of a volume.
+VOLUME_NAME_DOS = 0x0
+#: ``VOLUME_NAME_GUID`` - ask for the ``\\?\Volume{...}`` form of a volume.
+VOLUME_NAME_GUID = 0x1
+
+# ---- module listing --------------------------------------------------------
+LIST_MODULES_DEFAULT = 0x0
+LIST_MODULES_32BIT = 0x1
+LIST_MODULES_64BIT = 0x2
+LIST_MODULES_ALL = 0x3
+
+# ---- errors ----------------------------------------------------------------
+ERROR_SUCCESS = 0
+ERROR_INVALID_HANDLE = 6
+ERROR_ACCESS_DENIED = 5
+ERROR_BAD_LENGTH = 24
+ERROR_INVALID_PARAMETER = 87
+ERROR_INSUFFICIENT_BUFFER = 122
+ERROR_MORE_DATA = 234
+ERROR_PARTIAL_COPY = 299
+
+#: Largest NT namespace path the Win32 layer will hand back.
+MAX_NT_PATH_CHARS = 32768
+
+
+class _MEMORY_BASIC_INFORMATION32(ctypes.Structure):
+    """MEMORY_BASIC_INFORMATION as laid out inside a 32-bit process."""
 
-class MEMORY_BASIC_INFORMATION(ctypes.Structure):
-    """MEMORY_BASIC_INFORMATION, as declared by the platform SDK."""
+    _fields_ = [
+        ("BaseAddress", wt.DWORD),
+        ("AllocationBase", wt.DWORD),
+        ("AllocationProtect", wt.DWORD),
+        ("RegionSize", wt.DWORD),
+        ("State", wt.DWORD),
+        ("Protect", wt.DWORD),
+        ("Type", wt.DWORD),
+    ]
+
+
+class _MEMORY_BASIC_INFORMATION64(ctypes.Structure):
+    """MEMORY_BASIC_INFORMATION as laid out inside a 64-bit process."""
 
     _fields_ = [
-        ("BaseAddress", ctypes.c_void_p),
-        ("AllocationBase", ctypes.c_void_p),
+        ("BaseAddress", ctypes.c_uint64),
+        ("AllocationBase", ctypes.c_uint64),
         ("AllocationProtect", wt.DWORD),
-        ("RegionSize", ctypes.c_size_t),
+        ("__alignment1", wt.DWORD),
+        ("RegionSize", ctypes.c_uint64),
         ("State", wt.DWORD),
         ("Protect", wt.DWORD),
         ("Type", wt.DWORD),
+        ("__alignment2", wt.DWORD),
+    ]
+
+
+#: The layout the running process uses; full width on both sides.
+MEMORY_BASIC_INFORMATION = (
+    _MEMORY_BASIC_INFORMATION64 if IS_64BIT else _MEMORY_BASIC_INFORMATION32
+)
+
+#: Highest address a walk of the user-mode address space has to reach.
+MAX_ADDRESS = 0x7FFFFFFF0000 if IS_64BIT else 0xFFFF0000
+
+
+class MODULEINFO(ctypes.Structure):
+    """MODULEINFO, as declared by the platform SDK."""
+
+    _fields_ = [
+        ("lpBaseOfDll", ctypes.c_void_p),
+        ("SizeOfImage", wt.DWORD),
