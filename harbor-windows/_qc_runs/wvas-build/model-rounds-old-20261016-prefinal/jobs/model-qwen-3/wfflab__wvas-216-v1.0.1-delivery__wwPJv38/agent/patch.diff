diff --git a/_probe_check.py b/_probe_check.py
new file mode 100644
index 0000000..657cb23
--- /dev/null
+++ b/_probe_check.py
@@ -0,0 +1,215 @@
+"""Ad-hoc verification of the wvas fixes against a separate target process."""
+import ctypes, ctypes.wintypes as wt, os, subprocess, sys, tempfile
+
+sys.path.insert(0, r'C:\testbed')
+import wvas
+
+TARGET = r'''
+import ctypes, ctypes.wintypes as wt, os, tempfile, time
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+k.VirtualAlloc.restype = ctypes.c_void_p
+k.CreateFileW.restype = wt.HANDLE
+k.CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, wt.LPVOID, wt.DWORD, wt.DWORD, wt.HANDLE]
+k.CreateFileMappingW.restype = wt.HANDLE
+k.CreateFileMappingW.argtypes = [wt.HANDLE, wt.LPVOID, wt.DWORD, wt.DWORD, wt.DWORD, wt.LPCWSTR]
+k.MapViewOfFile.restype = ctypes.c_void_p
+k.MapViewOfFile.argtypes = [wt.HANDLE, wt.DWORD, wt.DWORD, wt.DWORD, ctypes.c_size_t]
+
+SIX_GIB = 6 * 1024 ** 3
+res = k.VirtualAlloc(None, SIX_GIB, 0x2000, 0x04)
+print("RESERVE", hex(res or 0), flush=True)
+
+d = tempfile.mkdtemp()
+f = os.path.join(d, "mapped_thing.bin")
+with open(f, "wb") as fh:
+    fh.write(b"z" * (1024 * 1024))
+print("MAPFILE", f, flush=True)
+# note: share mode 0, nobody else may open it while it is mapped
+hf = k.CreateFileW(f, 0x80000000 | 0x40000000, 0, None, 3, 0x80, None)
+print("HF", hex(hf or 0), flush=True)
+hm = k.CreateFileMappingW(hf, None, 0x04, 0, 0, None)
+view = k.MapViewOfFile(hm, 0x000F001F, 0, 0, 0)
+print("VIEW", hex(view or 0), flush=True)
+
+hm2 = k.CreateFileMappingW(wt.HANDLE(-1), None, 0x04, 0, 4096, None)
+view2 = k.MapViewOfFile(hm2, 0x000F001F, 0, 0, 0)
+print("ANON", hex(view2 or 0), flush=True)
+time.sleep(60)
+'''
+
+proc = subprocess.Popen([sys.executable, '-c', TARGET], stdout=subprocess.PIPE, text=True)
+info = {}
+for _ in range(6):
+    line = proc.stdout.readline().strip()
+    print('target:', line)
+    key, _, value = line.partition(' ')
+    info[key] = value
+    if key == 'ANON':
+        break
+
+pid = proc.pid
+print('pid', pid)
+
+regions = wvas.regions(pid)
+print('region count', len(regions))
+by_base = {r['base']: r for r in regions}
+
+# 1. reserve region of 6 GiB
+reserve_base = int(info['RESERVE'], 16)
+r = by_base.get(reserve_base)
+print('reserve region:', r)
+assert r is not None, '6GiB reservation missing'
+assert r['size'] == 6 * 1024 ** 3, r['size']
+assert r['state'] == 'reserve', r['state']
+assert r['path'] is None, r['path']
+assert r['type'] == 'private', r['type']
+
+# 2. mapped file region
+view = int(info['VIEW'], 16)
+r = by_base.get(view)
+print('mapped region:', r)
+assert r is not None, 'mapped view missing'
+assert r['type'] == 'mapped', r['type']
+expected = info['MAPFILE']
+print('expected path', expected)
+assert r['path'] is not None, 'mapped path is None'
+assert os.path.samefile(r['path'], expected), (r['path'], expected)
+
+# 3. anonymous mapping -> path None
+anon = int(info['ANON'], 16)
+r = by_base.get(anon)
+print('anon region:', r)
+assert r is not None
+assert r['type'] == 'mapped'
+assert r['path'] is None, r['path']
+
+# 4. cross-check the whole walk against VirtualQueryEx
+k = ctypes.WinDLL('kernel32', use_last_error=True)
+
+
+class MBI64(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_uint64), ("AllocationBase", ctypes.c_uint64),
+                ("AllocationProtect", wt.DWORD), ("a1", wt.DWORD),
+                ("RegionSize", ctypes.c_uint64), ("State", wt.DWORD),
+                ("Protect", wt.DWORD), ("Type", wt.DWORD), ("a2", wt.DWORD)]
+
+
+k.VirtualQueryEx.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.POINTER(MBI64), ctypes.c_size_t]
+k.VirtualQueryEx.restype = ctypes.c_size_t
+k.OpenProcess.argtypes = [wt.DWORD, wt.BOOL, wt.DWORD]
+k.OpenProcess.restype = wt.HANDLE
+h = k.OpenProcess(0x0410, False, pid)
+assert h, 'probe could not open target'
+mbi = MBI64()
+addr = 0
+truth = []
+while addr < (1 << 47):
+    if not k.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi)):
+        break
+    if mbi.State in (0x1000, 0x2000):
+        truth.append((mbi.BaseAddress, mbi.RegionSize, mbi.State, mbi.Type, mbi.Protect))
+    addr = mbi.BaseAddress + mbi.RegionSize
+k.CloseHandle(h)
+print('truth count', len(truth))
+assert len(truth) == len(regions), (len(truth), len(regions))
+mismatch = 0
+states = {0x1000: 'commit', 0x2000: 'reserve'}
+types = {0x1000000: 'image', 0x40000: 'mapped', 0x20000: 'private'}
+for item, got in zip(truth, regions):
+    base, size, state, rtype, protect = item
+    want = (base, size, states[state], types.get(rtype, 'private'))
+    have = (got['base'], got['size'], got['state'], got['type'])
+    if want != have:
+        mismatch += 1
+        print('MISMATCH got', have, 'want', want)
+print('mismatches', mismatch)
+assert mismatch == 0
+
+# 5. high address regions
+high = [r for r in regions if r['base'] > 0xFFFFFFFF]
+print('high regions', len(high), [hex(r['base']) for r in high[:5]])
+assert high
+assert all(r['base'] > 0xFFFFFFFF for r in high)
+
+# 6. include_reserved=False
+committed = wvas.regions(pid, include_reserved=False)
+assert all(r['state'] == 'commit' for r in committed)
+reserved_bases = {x[0] for x in truth if x[2] == 0x2000}
+assert not (set(r['base'] for r in committed) & reserved_bases)
+print('commit-only count', len(committed), 'with reserve', len(regions))
+assert len(committed) == len(truth) - len(reserved_bases)
+
+# 7. file backed
+backed = wvas.file_backed_regions(pid)
+print('file backed', len(backed))
+assert all(r['path'] for r in backed)
+keys = [(r['base'], r['size']) for r in regions]
+assert all((r['base'], r['size']) in keys for r in backed)
+order = [(r['base'], r['size']) for r in backed]
+filtered = [k for k in keys if k in set(order)]
+assert order == filtered, 'file_backed_regions order differs'
+for r in backed:
+    assert not r['path'].startswith('\\Device'), r['path']
+    assert not r['path'].startswith('\\??'), r['path']
+print('  sample backed paths:', [r['path'] for r in backed[:3]])
+
+# 8. modules
+mods = wvas.modules(pid)
+print('modules', len(mods))
+paths = [m['path'] for m in mods if m['path']]
+assert len(paths) == len(set(paths)), 'duplicate paths in modules'
+bases = [m['base'] for m in mods]
+assert bases == sorted(bases)
+assert len(bases) == len(set(bases)), 'duplicate bases'
+for m in mods[:4]:
+    print('  module', hex(m['base']), m['size'], m['path'])
+for m in mods:
+    assert m['path'] is None or (len(m['path']) > 2 and m['path'][1] == ':'), m['path']
+
+# 9. errors
+for bad, kind in ((-1, 'badarg'), (0, 'badarg'), (999999, 'no-such-process'), (2 ** 40, 'badarg')):
+    for fn in (wvas.regions, wvas.modules, wvas.file_backed_regions):
+        try:
+            fn(bad)
+        except wvas.WVasError as exc:
+            print(fn.__name__, bad, '->', exc.kind, '(want', kind, ')')
+            assert exc.kind == kind, (fn.__name__, bad, exc.kind, kind)
+        except OSError as exc:
+            raise AssertionError('OSError leaked: %r' % (exc,))
+        else:
+            raise AssertionError('no error for %r' % (bad,))
+for bad in ('x', None, 1.5, True):
+    try:
+        wvas.regions(bad)
+    except wvas.WVasError as exc:
+        print('regions', repr(bad), '->', exc.kind)
+        assert exc.kind == 'badarg', (bad, exc.kind)
+    except Exception as exc:
+        raise AssertionError('leaked %r for %r' % (exc, bad))
+    else:
+        raise AssertionError('no error for %r' % (bad,))
+
+# 10. pure helpers
+assert wvas.protection_name(0x04) == 'rw'
+assert wvas.protection_name(0x104) == 'rw'
+assert wvas.protection_name(0x20) == 'xr'
+assert wvas.protection_name(0) == 'none'
+assert wvas.protection_name(0x99) == '?'
+assert wvas.type_name(0x1000000) == 'image'
+assert wvas.type_name(0x40000) == 'mapped'
+assert wvas.type_name(0x20000) == 'private'
+
+# 11. own process sanity, and key sets
+mine = wvas.regions(os.getpid())
+assert mine and all(set(r) == {'base', 'size', 'state', 'type', 'protect', 'path', 'image'} for r in mine)
+assert [r['base'] for r in mine] == sorted(r['base'] for r in mine)
+assert all(isinstance(r['image'], bool) for r in mine)
+assert all(r['path'] is None or isinstance(r['path'], str) for r in mine)
+my_mods = wvas.modules(os.getpid())
+assert my_mods and all(m['path'] for m in my_mods)
+assert len({m['path'].lower() for m in my_mods}) == len(my_mods)
+
+proc.kill()
+proc.wait()
+print('ALL OK')
