+def max_application_address():
+    """Return the highest address a user mode allocation can live at.
+
+    The region walk runs up to this address, which is what keeps a scan of a
+    64 bit target from stopping below its high allocations.  A conservative
+    64 bit default is used when the system call cannot be reached.
+    """
+    if not AVAILABLE:
