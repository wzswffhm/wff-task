+    GetNativeSystemInfo(ctypes.byref(info))
+    return info.lpMaximumApplicationAddress or 0x7FFFFFFEFFFF
diff --git a/wvas/vas.py b/wvas/vas.py
index 868a1c4..ea8cecb 100644
--- a/wvas/vas.py
+++ b/wvas/vas.py
@@ -15,6 +15,16 @@ The answers are what the field engineers read when a machine reports
 "something keeps the log file mapped" or "the process has no address space
 left", so they have to describe the target process, not a snapshot of an
 earlier call.
+
+Three properties decide whether the numbers are usable at all:
+
+* every address and length is carried at the full pointer width, so a region
+  above 4 GiB keeps its base and a reservation larger than 4 GiB keeps its
+  length;
+* reserved ranges are first class, because an address space is normally
+  exhausted by reservations rather than by commits;
+* a file name is only reported once it has been translated back into a path
+  the reader can paste into a ticket and open.
 """
 
 import ctypes
@@ -22,7 +32,9 @@ import ctypes
 from . import _winapi as w
 from .errors import WVasError
 
-PATH_BUFFER_CHARS = 260
+#: A mapped file name can be as long as an NT object name, which is well past
+#: ``MAX_PATH``.  Sizing the buffer to the real limit keeps long paths intact.
+PATH_BUFFER_CHARS = w.MAX_NT_PATH_CHARS
 
 _PROTECTION_NAMES = {
     w.PAGE_NOACCESS: "none",
@@ -41,87 +53,523 @@ _TYPE_NAMES = {
     w.MEM_PRIVATE: "private",
 }
 
+#: Namespace prefixes a caller cannot hand to the filesystem.
+_UNOPENABLE_PREFIXES = ("\\device\\", "\\??\\", "\\\\?\\", "\\\\.\\")
+
 
 def protection_name(protect):
-    """Map a PAGE_* protection value onto its short textual name."""
+    """Map a ``PAGE_*`` protection value onto its short textual name.
+
+    Pure: the modifier bits (``PAGE_GUARD``, ``PAGE_NOCACHE``,
+    ``PAGE_WRITECOMBINE``) are masked off and the remaining base protection is
+    looked up in a constant table.  No process is consulted.
+    """
+    try:
+        protect = int(protect)
+    except (TypeError, ValueError):
+        return "?"
     return _PROTECTION_NAMES.get(protect & 0xFF, "?")
 
 
 def type_name(region_type):
-    """Map a MEM_* region type onto its short textual name."""
+    """Map a ``MEM_*`` region type onto its short textual name.
+
+    Pure, like :func:`protection_name`.
+    """
+    try:
+        region_type = int(region_type)
+    except (TypeError, ValueError):
+        return "private"
     return _TYPE_NAMES.get(region_type, "private")
 
 
