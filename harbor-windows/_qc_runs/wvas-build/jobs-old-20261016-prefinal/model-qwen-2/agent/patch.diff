diff --git a/_check.py b/_check.py
new file mode 100644
index 0000000..cb3b6c4
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,227 @@
+"""Independent checker: measures the target process with the raw Win32 API."""
+import ctypes
+import ctypes.wintypes as wt
+import os
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import wvas
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+
+
+class MBI(ctypes.Structure):
+    _fields_ = [
+        ("BaseAddress", ctypes.c_void_p),
+        ("AllocationBase", ctypes.c_void_p),
+        ("AllocationProtect", wt.DWORD),
+        ("RegionSize", ctypes.c_size_t),
+        ("State", wt.DWORD),
+        ("Protect", wt.DWORD),
+        ("Type", wt.DWORD),
+    ]
+
+
+OpenProcess = k.OpenProcess
+OpenProcess.argtypes = [wt.DWORD, wt.BOOL, wt.DWORD]
+OpenProcess.restype = wt.HANDLE
+VQ = k.VirtualQueryEx
+VQ.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t]
+VQ.restype = ctypes.c_size_t
+
+
+def truth(pid):
+    h = OpenProcess(0x0400 | 0x0010, False, pid)
+    assert h, ctypes.get_last_error()
+    out = []
+    mbi = MBI()
+    addr = 0
+    while True:
+        n = VQ(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+        if not n:
+            break
+        base = mbi.BaseAddress or 0
+        size = mbi.RegionSize
+        out.append((base, size, mbi.State, mbi.Protect, mbi.Type, mbi.AllocationBase or 0))
+        nxt = base + size
+        if size == 0 or nxt <= addr:
+            break
+        addr = nxt
+    k.CloseHandle(h)
+    return out
+
+
+def main():
+    here = os.path.dirname(os.path.abspath(__file__))
+    proc = subprocess.Popen(
+        [sys.executable, os.path.join(here, "_target.py")],
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,
+    )
+    facts = {}
+    try:
+        for line in proc.stdout:
+            line = line.strip()
+            if line == "READY":
+                break
+            print("target>", line)
+        for _ in range(10):
+            line = proc.stdout.readline()
+            if not line:
+                break
+            key, _, rest = line.strip().partition(" ")
+            facts[key] = rest
+        print("facts:", facts)
+        pid = int(facts["PID"])
+
+        t0 = time.time()
+        regions_all = wvas.regions(pid)
+        t1 = time.time()
+        regions_commit = wvas.regions(pid, include_reserved=False)
+        backed = wvas.file_backed_regions(pid)
+        mods = wvas.modules(pid)
+        print("timing: regions %.3fs" % (t1 - t0))
+
+        raw = truth(pid)
+        raw_commit_reserve = [r for r in raw if r[2] in (0x1000, 0x2000)]
+        raw_commit = [r for r in raw if r[2] == 0x1000]
+
+        print("\n=== A. region description ===")
+        print("wvas all:", len(regions_all), "raw commit+reserve:", len(raw_commit_reserve))
+        print("wvas commit:", len(regions_commit), "raw commit:", len(raw_commit))
+        assert len(regions_all) == len(raw_commit_reserve), "count mismatch (all)"
+        assert len(regions_commit) == len(raw_commit), "count mismatch (commit only)"
+        assert all(r["state"] == "commit" for r in regions_commit)
+        bases = [r["base"] for r in regions_all]
+        assert bases == sorted(bases), "not ascending"
+        assert len(set(bases)) == len(bases), "duplicate bases"
+        for got, want in zip(regions_all, raw_commit_reserve):
+            assert got["base"] == want[0], (hex(got["base"]), hex(want[0]))
+            assert got["size"] == want[1], (hex(got["size"]), hex(want[1]))
+            assert got["state"] == ("commit" if want[2] == 0x1000 else "reserve")
+            assert got["type"] == wvas.type_name(want[4])
+            assert got["protect"] == wvas.protection_name(want[3])
+            assert set(got) == {"base", "size", "state", "type", "protect", "path", "image"}
+            assert isinstance(got["image"], bool)
+            assert got["image"] == (want[4] == 0x1000000)
+        print("every base/size matches VirtualQueryEx exactly")
+        reserved = [r for r in regions_all if r["state"] == "reserve"]
+        print("reserved regions reported:", len(reserved), "bytes:", sum(r["size"] for r in reserved))
+        assert reserved, "no reserve regions reported"
+
+        print("\n=== 6 GiB reservation ===")
+        reserve_base, reserve_size = (int(x) for x in facts["RESERVE"].split())
+        raw_alloc = sum(r[1] for r in raw if r[5] == reserve_base)
+        got_alloc = sum(r["size"] for r in regions_all
+                        if reserve_base <= r["base"] < reserve_base + raw_alloc)
+        print("requested", reserve_size, "raw", raw_alloc, "wvas", got_alloc, "at", hex(reserve_base))
+        assert raw_alloc >= 6 * 1024 ** 3, raw_alloc
+        assert got_alloc == raw_alloc, (got_alloc, raw_alloc)
+        biggest = max(r["size"] for r in regions_all)
+        print("biggest region size:", biggest, hex(biggest))
+        assert biggest >= 4 * 1024 ** 3, "no region larger than 4 GiB reported"
+        big = [r for r in regions_all if r["size"] >= 4 * 1024 ** 3]
+        print("regions >= 4GiB:", [(hex(r["base"]), r["size"], r["state"]) for r in big])
+
+        print("\n=== B. file backing ===")
+        mapped_path = facts["MAPPATH"]
+        mapped_view = int(facts["MAPVIEW"])
+        anon_view = int(facts["ANON"])
+        hit = [r for r in regions_all if r["base"] <= mapped_view < r["base"] + r["size"]][0]
+        print("mapped region:", hex(hit["base"]), hit["size"], hit["type"], hit["path"])
+        assert hit["type"] == "mapped"
+        assert hit["path"] == os.path.realpath(mapped_path), (hit["path"], mapped_path)
+        assert os.path.exists(hit["path"]), hit["path"]
+        anon = [r for r in regions_all if r["base"] <= anon_view < r["base"] + r["size"]][0]
+        print("anon region:", hex(anon["base"]), anon["size"], anon["type"], repr(anon["path"]))
+        assert anon["path"] is None, repr(anon["path"])
+        assert not any(r["path"] == "" for r in regions_all), "empty path reported"
+        for r in regions_all:
+            p = r["path"]
+            if p is None:
+                continue
+            assert not p.lower().startswith(("\\device", "\\??", "\\dosdevices", "\\\\?\\")), p
+            assert p.startswith("\\\\") or (len(p) > 2 and p[1] == ":" and p[2] == "\\"), p
+            assert os.path.exists(p), p
+        print("all paths openable and existing")
+        assert all(r["path"] is not None for r in backed)
+        keys_backed = [(r["base"], r["size"]) for r in backed]
+        expected = [(r["base"], r["size"]) for r in regions_all if r["path"] is not None]
+        assert keys_backed == expected, "file_backed_regions is not an ordered subset"
+        print("file_backed_regions is the ordered subset:", len(backed), "of", len(regions_all))
+
+        print("\n=== C. modules ===")
+        mbases = [m["base"] for m in mods]
+        assert mbases == sorted(mbases), "modules not ascending"
+        assert len(set(mbases)) == len(mbases), "duplicate module bases"
+        mpaths = [m["path"] for m in mods]
+        assert len(set(os.path.normcase(p) for p in mpaths if p)) == len([p for p in mpaths if p]), \
+            "duplicate module paths"
+        assert all(isinstance(m["size"], int) and m["size"] > 0 for m in mods)
+        assert all(set(m) == {"base", "size", "path"} for m in mods)
+        image_alloc = {}
+        for base, size, state, protect, rtype, alloc in raw:
+            if rtype == 0x1000000 and state == 0x1000:
+                image_alloc[alloc or base] = image_alloc.get(alloc or base, 0) + size
+        print("raw image allocations:", len(image_alloc), "wvas modules:", len(mods))
+        missing = [hex(b) for b in image_alloc if b not in set(mbases)]
+        print("missing:", missing[:10])
+        assert not missing, missing
+        sizes = {m["base"]: m["size"] for m in mods}
+        wrong = [(hex(b), s, sizes.get(b)) for b, s in image_alloc.items() if sizes.get(b) != s]
+        print("size mismatches:", wrong[:5])
+        assert not wrong, wrong
+        for m in mods:
+            assert m["path"], m
+            assert os.path.exists(m["path"]), m
+        print("module sample:", mods[0])
+        print("module sample:", mods[-1])
+
+        print("\n=== D. errors ===")
+        for bad in (-1, 0, "x", None, 1.5, True, 2 ** 32, 2 ** 64):
+            try:
+                wvas.regions(bad)
+            except wvas.WVasError as exc:
+                assert exc.kind == "badarg", (bad, exc.kind)
+            else:
+                raise AssertionError("no error for %r" % (bad,))
+        print("badarg ok")
+        dead = 999999
+        while OpenProcess(0x0400, False, dead):
+            dead += 1
+        for fn in (wvas.regions, wvas.file_backed_regions, wvas.modules):
+            try:
+                fn(dead)
+            except wvas.WVasError as exc:
+                print(fn.__name__, "kind:", exc.kind, "pid:", exc.pid)
+                assert exc.kind == "no-such-process", exc.kind
+            except OSError as exc:
+                raise AssertionError("OSError leaked: %r" % (exc,))
+            else:
+                raise AssertionError("no error for dead pid")
+        try:
+            wvas.regions(4)
+        except wvas.WVasError as exc:
+            print("pid 4 kind:", exc.kind)
+        except OSError as exc:
+            raise AssertionError("OSError leaked for pid 4: %r" % (exc,))
+        else:
+            print("pid 4 opened fine (running as SYSTEM)")
+
+        print("\n=== E. own process ===")
+        mine = os.getpid()
+        r1 = wvas.regions(mine)
+        print("own regions:", len(r1))
+        assert len(r1) > 10
+        print("\nALL CHECKS PASSED")
+    finally:
+        proc.terminate()
+        try:
+            proc.wait(timeout=10)
+        except Exception:
+            proc.kill()
+
+
+main()
diff --git a/_probe.py b/_probe.py
new file mode 100644
index 0000000..c875d40
--- /dev/null
+++ b/_probe.py
@@ -0,0 +1,98 @@
+import ctypes
+import ctypes.wintypes as wt
+import os
+import sys
+
+sys.path.insert(0, "C:\\testbed")
+
+from wvas import _winapi as w
+
+k = w.kernel32
+ps = w.psapi
+
+ep = ps.EnumProcesses
+ep.argtypes = [ctypes.POINTER(wt.DWORD), wt.DWORD, ctypes.POINTER(wt.DWORD)]
+ep.restype = wt.BOOL
+buf = (wt.DWORD * 4096)()
+need = wt.DWORD()
+ep(buf, ctypes.sizeof(buf), ctypes.byref(need))
+pids = [p for p in list(buf)[:need.value // 4] if p]
+
+
+def walk(handle):
+    mbi = w.MEMORY_BASIC_INFORMATION()
+    addr = 0
+    out = []
+    while True:
+        n = w.VirtualQueryEx(handle, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+        if not n:
+            break
+        out.append((mbi.BaseAddress or 0, mbi.AllocationBase or 0, mbi.RegionSize,
+                    mbi.State, mbi.Protect, mbi.AllocationProtect, mbi.Type))
+        nxt = (mbi.BaseAddress or 0) + mbi.RegionSize
+        if nxt <= addr:
+            break
+        addr = nxt
+    return out
+
+
+def modules_region(handle):
+    out = {}
+    for base, alloc, size, state, protect, aprot, rtype in walk(handle):
+        if rtype != 0x1000000:
+            continue
+        key = alloc or base
+        entry = out.setdefault(key, [0, 0])
+        entry[0] += size
+        entry[1] += 1
+    return out
+
+
+def modules_psapi(handle):
+    needed = wt.DWORD(0)
+    arr = (wt.HMODULE * 4096)()
+    ok = w.EnumProcessModulesEx(handle, arr, ctypes.sizeof(arr), ctypes.byref(needed), 0x3)
+    count = needed.value // ctypes.sizeof(wt.HMODULE) if ok else 0
+    out = {}
+    for i in range(count):
+        m = arr[i]
+        mi = w.MODULEINFO()
+        if w.GetModuleInformation(handle, m, ctypes.byref(mi), ctypes.sizeof(mi)):
+            out[int(m or 0)] = mi.SizeOfImage
+    return out, ok, count
+
+
+mismatch_total = 0
+for p in pids:
+    handle = w.OpenProcess(0x0400 | 0x0010, False, p)
+    if not handle:
+        continue
+    try:
+        regs = modules_region(handle)
+        mods, ok, count = modules_psapi(handle)
+        bad = []
+        for base, size in mods.items():
+            got = regs.get(base)
+            if got is None or got[0] != size:
+                bad.append((hex(base), size, got))
+        missing = [hex(b) for b in regs if b not in mods]
+        if bad or missing or not ok:
+            print("pid", p, "enum ok", ok, "count", count, "regions-images", len(regs), "mismatch", bad[:4], "missing", missing[:4])
+            mismatch_total += 1
+    finally:
+        k.CloseHandle(handle)
+print("processes with differences:", mismatch_total)
+
+print("=== device map ===")
+qdd = w.QueryDosDeviceW
+big = ctypes.create_unicode_buffer(w.MULTI_SZ_CHARS)
+n = qdd(None, big, w.MULTI_SZ_CHARS)
+names = w.multi_sz(big, n)
+print("names:", names)
+for nm in names:
+    sub = ctypes.create_unicode_buffer(w.MULTI_SZ_CHARS)
+    m = qdd(nm, sub, w.MULTI_SZ_CHARS)
+    if m:
+        print("  ", nm, "->", w.multi_sz(sub, m))
+    else:
+        print("  ", nm, "-> ERR", ctypes.get_last_error())
diff --git a/_target.py b/_target.py
new file mode 100644
index 0000000..1088fa1
--- /dev/null
+++ b/_target.py
@@ -0,0 +1,72 @@
+"""Target process: builds a known address space, then waits."""
+import ctypes
+import ctypes.wintypes as wt
+import os
+import sys
+import tempfile
+import time
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+
+RESERVE_SIZE = 6 * 1024 * 1024 * 1024  # 6 GiB reservation
+RESERVE2_SIZE = 5 * 1024 * 1024 * 1024
+
+
+def main():
+    path = os.path.join(tempfile.gettempdir(), "wvas_target_mapped.bin")
+    with open(path, "wb") as fh:
+        fh.write(b"y" * (512 * 1024))
+
+    VA = k.VirtualAlloc
+    VA.argtypes = [ctypes.c_void_p, ctypes.c_size_t, wt.DWORD, wt.DWORD]
+    VA.restype = ctypes.c_void_p
+    reserve = VA(None, RESERVE_SIZE, 0x2000, 0x04)  # MEM_RESERVE, PAGE_READWRITE
+    if not reserve:
+        print("reserve failed", ctypes.get_last_error())
+        return
+    # commit a piece in the middle, so the reservation shows up as several regions
+    committed = VA(reserve + 0x10000, 0x10000, 0x1000, 0x04)
+    if not committed:
+        print("commit failed", ctypes.get_last_error())
+
+    big2 = VA(None, RESERVE2_SIZE, 0x2000, 0x04)
+    if not big2:
+        print("reserve2 failed", ctypes.get_last_error())
+
+    CF = k.CreateFileW
+    CF.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.HANDLE]
+    CF.restype = wt.HANDLE
+    hfile = CF(path, 0x80000000, 1, None, 3, 0, None)
+    CFM = k.CreateFileMappingW
+    CFM.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.DWORD, wt.LPCWSTR]
+    CFM.restype = wt.HANDLE
+    hmap = CFM(hfile, None, 0x02, 0, 0, None)
+    if not hmap:
+        print("createfilemapping failed", ctypes.get_last_error())
+        return
+    MV = k.MapViewOfFile
+    MV.argtypes = [wt.HANDLE, wt.DWORD, wt.DWORD, wt.DWORD, ctypes.c_size_t]
+    MV.restype = ctypes.c_void_p
+    view = MV(hmap, 4, 0, 0, 0)
+    if not view:
+        print("mapviewoffile failed", ctypes.get_last_error())
+
+    hanon = CFM(wt.HANDLE(-1), None, 0x04, 0, 0x100000, None)
+    anon = MV(hanon, 2, 0, 0, 0) if hanon else 0
+
+    # hold a reference so the OS keeps the objects alive
+    globals()["_keepalive"] = (reserve, committed, big2, hfile, hmap, view, hanon, anon)
+
+    print("READY")
+    print("PID", os.getpid())
+    print("RESERVE", reserve, RESERVE_SIZE)
+    print("COMMIT", committed)
+    print("RESERVE2", big2, RESERVE2_SIZE)
+    print("MAPVIEW", view)
+    print("MAPPATH", path)
+    print("ANON", anon)
+    sys.stdout.flush()
+    time.sleep(300)
+
+
+main()
