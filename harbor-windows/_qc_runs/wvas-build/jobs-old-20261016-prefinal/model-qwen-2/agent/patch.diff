+class _PathResolver:
+    """Works out the file behind a region of one target process.
+
+    The device table, the loader's module table and every name already
+    resolved are kept for the lifetime of a single audit: a process has
+    hundreds of regions but only a handful of distinct files behind them.
+    """
+
+    def __init__(self, handle):
+        self._handle = handle
+        self._devices = None
+        self._by_name = {}
+        self._modules = None
+
+    def resolve(self, base, allocation_base, region_type):
+        """The openable path of the file behind this region, or ``None``."""
+        if region_type == _MEM_IMAGE:
+            path = self._module_paths().get(allocation_base)
+            if path is None:
+                path = self._resolve_name(base)
+        else:
+            path = self._resolve_name(base)
+        return path
+
+    # -- one region --------------------------------------------------------
+    def _resolve_name(self, base):
+        name = self._mapped_name(base)
+        if name is None:
+            # Nothing backs this region: an anonymous section, private or
+            # reserved memory.  Reporting "" here would read as "a file we
+            # could not name" instead of "no file at all".
+            return None
+        if name in self._by_name:
+            return self._by_name[name]
+        path = _dos_path(name, self._device_map())
+        if path is None or not _is_openable(path):
+            path = _final_path(_GLOBALROOT + name)
+        if path is not None and not _is_openable(path):
+            path = None
+        self._by_name[name] = path
+        return path
+
+    def _mapped_name(self, base):
+        """The NT device name the system gives for the file mapped at ``base``."""
+        if not _callable("GetMappedFileNameW"):
+            return None
+        size = w.MAX_PATH
+        while True:
+            buffer = ctypes.create_unicode_buffer(size)
+            written = w.GetMappedFileNameW(
+                self._handle, ctypes.c_void_p(base), buffer, size
+            )
+            if written:
+                return buffer.value or None
+            if (
+                w.last_error() == w.ERROR_INSUFFICIENT_BUFFER
+                and size < PATH_BUFFER_CHARS
+            ):
+                size *= 4
+                continue
+            return None
+
+    # -- lazily built tables -----------------------------------------------
+    def _device_map(self):
+        if self._devices is None:
+            self._devices = _dos_device_map()
+        return self._devices
+
+    def _module_paths(self):
+        if self._modules is None:
+            self._modules = _enumerate_module_paths(self._handle)
+        return self._modules
+
+
+def _enumerate_module_paths(handle):
+    """``{image base: Win32 path}`` for the images the loader lists."""
+    if not _callable("EnumProcessModulesEx") or not _callable("GetModuleFileNameExW"):
+        return {}
+    paths = {}
+    count = 64
+    for _ in range(4):
+        modules = (ctypes.c_void_p * count)()
+        needed = ctypes.wintypes.DWORD(0)
+        ok = w.EnumProcessModulesEx(
+            handle,
+            modules,
+            ctypes.sizeof(modules),
+            ctypes.byref(needed),
+            w.LIST_MODULES_ALL,
+        )
+        if ok:
+            total = needed.value // ctypes.sizeof(ctypes.c_void_p)
+            for index in range(min(total, count)):
+                base = modules[index] or 0
+                if not base or base in paths:
+                    continue
+                buffer = ctypes.create_unicode_buffer(PATH_BUFFER_CHARS)
+                written = w.GetModuleFileNameExW(
+                    handle, ctypes.c_void_p(base), buffer, PATH_BUFFER_CHARS
+                )
+                if written:
+                    name = buffer.value
+                    if _is_openable(name):
+                        paths[base] = name
+            return paths
+        if w.last_error() != w.ERROR_BAD_LENGTH:
+            return paths
+        count *= 4
+    return paths
