+# --------------------------------------------------------------------------
+# the walk over the address space
+# --------------------------------------------------------------------------
+
+def _address_space_limit():
+    if not _callable("GetSystemInfo"):
+        return _MAX_APPLICATION_ADDRESS
+    info = w.SYSTEM_INFO()
+    w.GetSystemInfo(ctypes.byref(info))
+    limit = info.lpMaximumApplicationAddress or 0
+    return limit if limit > 0 else _MAX_APPLICATION_ADDRESS
+
+
+def _walk(handle, pid, include_reserved):
+    """Yield ``(descriptor, allocation base)`` for every region in use.
+
+    Regions are reported exactly as ``VirtualQueryEx`` measures them -- no
+    rounding, no truncation, no merging of neighbours -- so that every number
+    can be held next to the one a debugger shows for the same process.
+    """
+    resolver = _PathResolver(handle)
+    limit = _address_space_limit()
+    info = w.MEMORY_BASIC_INFORMATION()
+    length = ctypes.sizeof(info)
+    address = 0
+    queried = False
+
+    while address <= limit:
+        written = w.VirtualQueryEx(
+            handle, ctypes.c_void_p(address), ctypes.byref(info), length
+        )
+        if not written:
+            if not queried:
+                _fail(
+                    "cannot query the address space",
+                    pid,
+                    kinds={w.ERROR_ACCESS_DENIED: "access-denied"},
+                )
+            break
+        queried = True
+
+        base = info.BaseAddress or 0
+        size = info.RegionSize or 0
+        state = info.State
+        region_type = info.Type
+        allocation_base = info.AllocationBase or base
+
+        if state == w.MEM_COMMIT or (include_reserved and state == w.MEM_RESERVE):
+            descriptor = {
+                "base": base,
+                "size": size,
+                "state": "commit" if state == w.MEM_COMMIT else "reserve",
+                "type": type_name(region_type),
+                "protect": protection_name(info.Protect),
+                "path": None,
+                "image": region_type == _MEM_IMAGE,
+            }
+            if region_type in (_MEM_IMAGE, _MEM_MAPPED):
+                descriptor["path"] = resolver.resolve(base, allocation_base, region_type)
+            yield descriptor, allocation_base
+
+        step = base + size
+        if size == 0 or step <= address:
+            break
+        address = step
+
+
+def _audit(pid, include_reserved):
+    """Run one audit of ``pid`` and return its descriptors, ascending."""
+    handle = _open_process(pid)
+    try:
+        descriptors = [item for item, _ in _walk(handle, pid, include_reserved)]
+    finally:
+        w.CloseHandle(handle)
+    descriptors.sort(key=lambda item: item["base"])
+    return descriptors
+
+
+# --------------------------------------------------------------------------
+# public API
+# --------------------------------------------------------------------------
+
+def regions(pid, include_reserved=True):
+    """Return the regions of ``pid``'s virtual address space.
+
+    Committed *and* reserved regions are reported unless ``include_reserved``
+    is false; address space that is free is never reported.
+    """
+    return _audit(pid, True if include_reserved else False)
