+def _is_openable(path):
+    """True for a path the caller can hand to ``open()`` or to Explorer."""
+    if not path:
+        return False
+    if path.startswith("\\\\"):
+        # \\server\share is a UNC path; \\?\ and \\.\ are object manager
+        # syntax that no shell and no file dialog understands.
+        return not path.startswith("\\\\?\\") and not path.startswith("\\\\.\\")
+    if path.startswith("\\"):
+        return False
+    return len(path) > 2 and path[1] == ":"
