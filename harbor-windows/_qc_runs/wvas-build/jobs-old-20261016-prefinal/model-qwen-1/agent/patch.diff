diff --git a/_probe_scratch.py b/_probe_scratch.py
new file mode 100644
index 0000000..366f248
--- /dev/null
+++ b/_probe_scratch.py
@@ -0,0 +1,89 @@
+import ctypes
+import ctypes.wintypes as wt
+import os
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, r"C:\testbed")
+import wvas
+from wvas import _winapi as W
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.VirtualQueryEx.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t]
+k32.VirtualQueryEx.restype = ctypes.c_size_t
+k32.OpenProcess.argtypes = [wt.DWORD, wt.BOOL, wt.DWORD]
+k32.OpenProcess.restype = wt.HANDLE
+
+
+def ground_truth(pid, include_reserved=True):
+    h = k32.OpenProcess(0x0400 | 0x0010, False, pid)
+    mbi = W.MEMORY_BASIC_INFORMATION64()
+    out = []
+    addr = 0
+    while addr <= (1 << 47) - 1:
+        if not k32.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi)):
+            break
+        if mbi.State in (0x1000, 0x2000):
+            if include_reserved or mbi.State == 0x1000:
+                out.append((mbi.BaseAddress, mbi.RegionSize, mbi.State))
+        nxt = (mbi.BaseAddress or 0) + mbi.RegionSize
+        if nxt <= addr:
+            break
+        addr = nxt
+    k32.CloseHandle(h)
+    return out
+
+
+TARGET = os.path.join(os.environ["TEMP"], "wvas_idle.py")
+open(TARGET, "w").write("import time\ntime.sleep(120)\n")
+proc = subprocess.Popen([sys.executable, TARGET])
+time.sleep(2.5)
+tpid = proc.pid
+try:
+    for attempt in range(4):
+        truth = ground_truth(tpid)
+        mine = [(r["base"], r["size"], 0x1000 if r["state"] == "commit" else 0x2000) for r in wvas.regions(tpid)]
+        if mine == truth:
+            print("target match OK on attempt", attempt)
+            break
+        print("attempt", attempt, "len", len(mine), len(truth))
+        only_mine = [x for x in mine if x not in truth]
+        only_truth = [x for x in truth if x not in mine]
+        print("  only in wvas:", [(hex(a), b, hex(c)) for a, b, c in only_mine][:10])
+        print("  only in truth:", [(hex(a), b, hex(c)) for a, b, c in only_truth][:10])
+finally:
+    proc.kill()
+    proc.wait()
+
+# self process
+for attempt in range(3):
+    truth = ground_truth(os.getpid())
+    mine = [(r["base"], r["size"], 0x1000 if r["state"] == "commit" else 0x2000) for r in wvas.regions(os.getpid())]
+    print("self attempt", attempt, len(mine), len(truth), "equal", mine == truth)
+    only_mine = [x for x in mine if x not in truth]
+    only_truth = [x for x in truth if x not in mine]
+    print("   only wvas", [(hex(a), b) for a, b, c in only_mine][:6])
+    print("   only truth", [(hex(a), b) for a, b, c in only_truth][:6])
+
+# exited pid behaviour
+dead = subprocess.Popen([sys.executable, "-c", "pass"])
+dead.wait()
+h = k32.OpenProcess(0x0400 | 0x0010, False, dead.pid)
+print("open dead pid handle:", h, "err", ctypes.get_last_error())
+if h:
+    mbi = W.MEMORY_BASIC_INFORMATION64()
+    r = k32.VirtualQueryEx(h, ctypes.c_void_p(0), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    print("VQ on dead:", r, "err", ctypes.get_last_error())
+    k32.GetExitCodeProcess.argtypes = [wt.HANDLE, ctypes.POINTER(wt.DWORD)]
+    code = wt.DWORD()
+    print("GetExitCodeProcess:", k32.GetExitCodeProcess(h, ctypes.byref(code)), code.value)
+try:
+    wvas.regions(dead.pid)
+    print("regions(dead) -> no error")
+except wvas.WVasError as e:
+    print("regions(dead) -> WVasError", e.kind, e)
+
+# image regions with None path in the self process
+nopath = [(hex(r["base"]), r["size"], r["type"]) for r in wvas.regions(os.getpid()) if r["type"] == "image" and r["path"] is None]
+print("image regions without path:", len(nopath), nopath[:6])
