+def _strip_volume_prefix(path):
+    """Drop the volume prefixes CreateFile accepts but callers do not want."""
+    if path.startswith("\\\\?\\UNC\\"):
+        return "\\\\" + path[8:]
+    if path.startswith("\\\\?\\") or path.startswith("\\\\.\\"):
+        return path[4:]
+    return path
