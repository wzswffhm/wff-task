@@ -0,0 +1,77 @@
+"""TEMPORARY probe - deleted before submit."""
+import ctypes
+import ctypes.wintypes as wt
+import os
+import subprocess
+import sys
+import tempfile
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+CFW = k32.CreateFileW
+CFW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.HANDLE]
+CFW.restype = wt.HANDLE
+CFMW = k32.CreateFileMappingW
+CFMW.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.DWORD, wt.LPCWSTR]
+CFMW.restype = wt.HANDLE
+MV = k32.MapViewOfFile
+MV.argtypes = [wt.HANDLE, wt.DWORD, wt.DWORD, wt.DWORD, ctypes.c_size_t]
+MV.restype = ctypes.c_void_p
+gmfn = ctypes.WinDLL("psapi", use_last_error=True).GetMappedFileNameW
+gmfn.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.LPWSTR, wt.DWORD]
+gmfn.restype = wt.DWORD
+
+tmp = tempfile.mkdtemp(prefix="wvas-probe-")
+path = os.path.join(tmp, "data.txt")
+with open(path, "wb") as fh:
+    fh.write(b"x" * 4096)
+
+fh = CFW(path, 0x80000000 | 0x40000000, 3, None, 3, 0x80, None)
+sec = CFMW(fh, None, 0x04, 0, 0x10000, None)
+view = MV(sec, 0x0004, 0, 0, 0)
+print("view", hex(view))
+
+# now check the region state / type as VirtualQueryEx sees it
+class MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+                ("AllocationProtect", wt.DWORD), ("RegionSize", ctypes.c_size_t),
+                ("State", wt.DWORD), ("Protect", wt.DWORD), ("Type", wt.DWORD)]
+vq = k32.VirtualQueryEx
+vq.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.POINTER(MBI), ctypes.c_size_t]
+vq.restype = ctypes.c_size_t
+h = k32.OpenProcess(0x0410, False, os.getpid())
+info = MBI()
+vq(h, ctypes.c_void_p(view), ctypes.byref(info), ctypes.sizeof(info))
+print("region state=%#x type=%#x protect=%#x size=%#x" % (info.State, info.Type, info.Protect, info.RegionSize))
+buf = ctypes.create_unicode_buffer(4096)
+n = gmfn(h, ctypes.c_void_p(view), buf, 4096)
+print("mapped name", n, repr(buf.value), "real", path)
+
+# anonymous named section
+anon = CFMW(wt.HANDLE(-1), None, 0x04, 0, 0x100000, "WvasAnonymousProbe")
+anon_view = MV(anon, 0x0004, 0, 0, 0)
+print("anon view", hex(anon_view))
+buf2 = ctypes.create_unicode_buffer(4096)
+n2 = gmfn(h, ctypes.c_void_p(anon_view), buf2, 4096)
+print("anon name n=", n2, ctypes.get_last_error(), repr(buf2.value))
+info2 = MBI()
+vq(h, ctypes.c_void_p(anon_view), ctypes.byref(info2), ctypes.sizeof(info2))
+print("anon region state=%#x type=%#x protect=%#x size=%#x" % (info2.State, info2.Type, info2.Protect, info2.RegionSize))
+
+# anonymous unnamed section
+anon2 = CFMW(wt.HANDLE(-1), None, 0x04, 0, 0x10000, None)
+anon2_view = MV(anon2, 0x0004, 0, 0, 0)
+buf3 = ctypes.create_unicode_buffer(4096)
+n3 = gmfn(h, ctypes.c_void_p(anon2_view), buf3, 4096)
+print("anon unnamed view", hex(anon2_view), "name n=", n3, ctypes.get_last_error(), repr(buf3.value))
+
+# wvas view of this very process
+sys.path.insert(0, r"C:\testbed")
+import wvas
+regions = wvas.regions(os.getpid())
+mine = [r for r in regions if r["base"] in (view, anon_view, anon2_view)]
+for r in mine:
+    print(hex(r["base"]), r["size"], r["state"], r["type"], r["protect"], repr(r["path"]))
+print("total regions", len(regions))
+print("paths sample", sorted({r["path"] for r in regions if r["path"]})[:8])
+bad = [r["path"] for r in regions if r["path"] and (r["path"].startswith("\\") and not r["path"].startswith("\\\\"))]
+print("non-dos paths", bad[:5])
