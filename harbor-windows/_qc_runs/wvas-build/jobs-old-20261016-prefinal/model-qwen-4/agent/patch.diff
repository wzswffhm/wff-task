-"""ctypes bindings for the Win32 calls the auditor uses."""
+"""ctypes bindings for the Win32 calls the auditor uses.
+
+Every entry point is resolved once, at import time. A platform that cannot
+provide one of the :data:`REQUIRED_FUNCTIONS` leaves the module unavailable
+(:func:`available` returns ``False``) so that :mod:`wvas.vas` can report the
+query as ``unsupported`` instead of failing with an ``AttributeError``.
+"""
 
 import ctypes
 import ctypes.wintypes as wt
-
-kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
-psapi = ctypes.WinDLL("psapi", use_last_error=True)
+import sys
 
 # ---- access rights ---------------------------------------------------------
 PROCESS_QUERY_INFORMATION = 0x0400
+PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
 PROCESS_VM_READ = 0x0010
 
 # ---- region state ----------------------------------------------------------
@@ -30,10 +35,46 @@ PAGE_EXECUTE_READ = 0x20
 PAGE_EXECUTE_READWRITE = 0x40
 PAGE_EXECUTE_WRITECOPY = 0x80
 PAGE_GUARD = 0x100
+PAGE_NOCACHE = 0x200
+PAGE_WRITECOMBINE = 0x400
+
+# ---- module listings -------------------------------------------------------
+LIST_MODULES_DEFAULT = 0x00
+LIST_MODULES_32BIT = 0x01
+LIST_MODULES_64BIT = 0x02
+LIST_MODULES_ALL = 0x03
+
+# ---- Win32 errors the auditor has to tell apart ----------------------------
+ERROR_SUCCESS = 0
+ERROR_INVALID_FUNCTION = 1
+ERROR_FILE_NOT_FOUND = 2
+ERROR_PATH_NOT_FOUND = 3
+ERROR_ACCESS_DENIED = 5
+ERROR_INVALID_HANDLE = 6
+ERROR_NOT_ENOUGH_MEMORY = 8
+ERROR_NO_MORE_FILES = 18
+ERROR_BAD_LENGTH = 24
+ERROR_SHARING_VIOLATION = 32
+ERROR_INVALID_PARAMETER = 87
+ERROR_CALL_NOT_IMPLEMENTED = 120
+ERROR_INSUFFICIENT_BUFFER = 122
+ERROR_BAD_PATHNAME = 161
+ERROR_BAD_EXE_FORMAT = 193
+ERROR_MORE_DATA = 234
+ERROR_PARTIAL_COPY = 299
+ERROR_PRIVILEGE_NOT_HELD = 1314
+
+#: the widest process id Win32 accepts
+MAXIMUM_PID = 0xFFFFFFFF
 
 
 class MEMORY_BASIC_INFORMATION(ctypes.Structure):
-    """MEMORY_BASIC_INFORMATION, as declared by the platform SDK."""
+    """MEMORY_BASIC_INFORMATION, as declared by the platform SDK.
+
+    ``BaseAddress`` and ``RegionSize`` are pointer sized on purpose: a 64 bit
+    caller auditing a 64 bit process has to see whole addresses and whole
+    region lengths, not their low halves.
+    """
 
     _fields_ = [
         ("BaseAddress", ctypes.c_void_p),
@@ -46,26 +87,180 @@ class MEMORY_BASIC_INFORMATION(ctypes.Structure):
     ]
 
 
