@@ -0,0 +1,74 @@
+"""Temporary patcher - deleted before submit."""
+import io
+
+path = r"C:\testbed\wvas\vas.py"
+with io.open(path, encoding="utf-8") as handle:
+    source = handle.read()
+
+BS = "\\"
+
+old = (
+    '    path = nt_path.replace("/", "' + BS + BS + '")\n'
+    '    while path.startswith("' + BS + BS + '??' + BS + BS + '") or '
+    'path.startswith("' + BS + BS + BS + BS + '.' + BS + BS + '"):\n'
+    '        path = path[4:]\n'
+    '    if not path.startswith("' + BS + BS + '"):\n'
+    '        return None\n'
+    '    if _is_openable(path):\n'
+    '        return path\n'
+    '    if path.startswith("' + BS + BS + BS + BS + '?"):\n'
+    '        return None  # the extended length spelling opens nothing for a human\n'
+)
+new = (
+    '    path = nt_path.replace("/", "' + BS + BS + '")\n'
+    '    # strip the NT object manager spellings that introduce a device path\n'
+    '    while path.startswith("' + BS + BS + '??' + BS + BS + '") or '
+    'path.startswith("' + BS + BS + BS + BS + '.' + BS + BS + '"):\n'
+    '        path = path[4:]\n'
+    '    if not path.startswith("' + BS + BS + '"):\n'
+    '        return None\n'
+    '    if path.startswith("' + BS + BS + BS + BS + '?'):\n'
+    '        path = _shorten_extended_path(path)\n'
+    '    if _is_openable(path):\n'
+    '        return path\n'
+)
+assert old in source, "head block not found"
+source = source.replace(old, new)
+
+old_match = (
+    '        prefix += "' + BS + BS + '" + part\n'
+    '        root = roots.get(prefix.lower())\n'
+    '        if root is not _SKIP and prefix.lower() in roots:\n'
+    '            match = (prefix, roots[prefix.lower()])\n'
+)
+new_match = (
+    '        prefix += "' + BS + BS + '" + part\n'
+    '        if prefix.lower() in roots:\n'
+    '            match = (prefix, roots[prefix.lower()])\n'
+)
+assert old_match in source, "match block not found"
+source = source.replace(old_match, new_match)
+
+helper = '''
+def _shorten_extended_path(path):
+    """Turn a \\\\\\\\?\\\\ spelling of a path into the plain one."""
+    UNC = "\\\\\\\\"
+    marker = UNC + "?" + "\\\\"
+    if not path.startswith(marker):
+        return path
+    body = path[len(marker):]
+    if body[:4].upper() == "UNC" + "\\\\":
+        return UNC + body[4:]
+    if len(body) >= 2 and body[1] == ":" and body[2:3] == "\\\\":
+        return body
+    return body
+
+
+'''
+anchor = "def _dos_path(nt_path):"
+assert anchor in source
+source = source.replace(anchor, helper.lstrip("\n") + anchor, 1)
+
+with io.open(path, "w", encoding="utf-8") as handle:
+    handle.write(source)
+print("patched")
