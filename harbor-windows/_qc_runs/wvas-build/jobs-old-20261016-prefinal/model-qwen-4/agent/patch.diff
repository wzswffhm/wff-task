@@ -0,0 +1,318 @@
+"""TEMPORARY acceptance harness - deleted before submit."""
+import ctypes
+import ctypes.wintypes as wt
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, r"C:\testbed")
+
+import wvas
+from wvas import _winapi as w
+
+FAILURES = []
+
+
+def check(label, condition, detail=""):
+    if condition:
+        print("  ok   %s" % label)
+    else:
+        print("  FAIL %s %s" % (label, detail))
+        FAILURES.append(label)
+
+
+class MBI(ctypes.Structure):
+    _fields_ = [
+        ("BaseAddress", ctypes.c_void_p),
+        ("AllocationBase", ctypes.c_void_p),
+        ("AllocationProtect", wt.DWORD),
+        ("RegionSize", ctypes.c_size_t),
+        ("State", wt.DWORD),
+        ("Protect", wt.DWORD),
+        ("Type", wt.DWORD),
+    ]
+
+
+def reference_regions(pid, include_reserved=True):
+    h = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ, False, pid)
+    if not h:
+        h = w.OpenProcess(w.PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
+    assert h, "cannot open %s" % pid
+    vq = w.VirtualQueryEx
+    info = MBI()
+    out = []
+    addr = 0
+    try:
+        while True:
+            n = vq(h, ctypes.c_void_p(addr), ctypes.byref(info), ctypes.sizeof(info))
+            if not n:
+                break
+            base = int(info.BaseAddress or 0)
+            size = int(info.RegionSize)
+            if info.State != w.MEM_FREE:
+                state = "commit" if info.State == w.MEM_COMMIT else "reserve"
+                if include_reserved or state == "commit":
+                    out.append((base, size, state, info.Protect, info.Type))
+            addr = base + size
+            if size <= 0 or addr <= base:
+                break
+    finally:
+        w.CloseHandle(h)
+    return out
+
+
+def is_openable(path):
+    if not path:
+        return False
+    if path.startswith("\\Device\\") or path.startswith("\\??\\"):
+        return False
+    if path.startswith("\\\\?"):
+        return False
+    if len(path) >= 3 and path[1] == ":" and path[2] in "\\/":
+        return True
+    return path.startswith("\\\\")
+
+
+TARGET = r'''
+import ctypes, ctypes.wintypes as wt, os, sys, time
+
+path = sys.argv[1]
+marker = sys.argv[2]
+k32 = ctypes.WinDLL('kernel32', use_last_error=True)
+CFW = k32.CreateFileW
+CFW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.HANDLE]
+CFW.restype = wt.HANDLE
+CFMW = k32.CreateFileMappingW
+CFMW.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.DWORD, wt.LPCWSTR]
+CFMW.restype = wt.HANDLE
+MV = k32.MapViewOfFile
+MV.argtypes = [wt.HANDLE, wt.DWORD, wt.DWORD, wt.DWORD, ctypes.c_size_t]
+MV.restype = ctypes.c_void_p
+VA = k32.VirtualAlloc
+VA.argtypes = [ctypes.c_void_p, ctypes.c_size_t, wt.DWORD, wt.DWORD]
+VA.restype = ctypes.c_void_p
+
+fh = CFW(path, 0x80000000, 3, None, 3, 0x80, None)
+assert fh, ('CreateFileW', ctypes.get_last_error())
+sec = CFMW(fh, None, 0x02, 0, 0x10000, None)
+assert sec, ('CreateFileMappingW', ctypes.get_last_error())
+view = MV(sec, 0x0004, 0, 0, 0)
+assert view, ('MapViewOfFile', ctypes.get_last_error())
+
+anon = CFMW(wt.HANDLE(-1), None, 0x04, 0, 0x100000, 'WvasAnonymousProbe')
+assert anon, ('anon section', ctypes.get_last_error())
+anon_view = MV(anon, 0x0004, 0, 0, 0)
+assert anon_view, ('anon view', ctypes.get_last_error())
+
+big = VA(None, 6 * 1024 * 1024 * 1024, 0x2000, 0x01)
+assert big, ('reserve 6GiB', ctypes.get_last_error())
+
+with open(marker, 'w') as handle:
+    handle.write('%d %d %d %d\n' % (os.getpid(), view, anon_view, big))
+
+time.sleep(120)
+'''
+
+
+def main():
+    tmp = tempfile.mkdtemp(prefix="wvas-accept-")
+    data = os.path.join(tmp, "mapped_target.txt")
+    with open(data, "wb") as fh:
+        fh.write(b"wvas mapped file content\n" * 100)
+    script = os.path.join(tmp, "target.py")
+    with open(script, "w") as fh:
+        fh.write(TARGET)
+    marker = os.path.join(tmp, "marker.txt")
+    real_path = os.path.normcase(os.path.abspath(data))
+
+    proc = subprocess.Popen([sys.executable, script, data, marker])
+    try:
+        for _ in range(200):
+            if os.path.exists(marker):
+                break
+            time.sleep(0.05)
+        assert os.path.exists(marker), "target did not start"
+        with open(marker) as fh:
+            pid, view, anon_view, big = (int(x) for x in fh.read().split())
+        print("target pid=%d file view=%#x anon view=%#x reserve=%#x" %
+              (pid, view, anon_view, big))
+        time.sleep(0.3)
+
+        print("\n== A. regions ==")
+        got = wvas.regions(pid)
+        ref = reference_regions(pid)
+        check("non-empty list of dicts", isinstance(got, list) and bool(got))
+        keys = {"base", "size", "state", "type", "protect", "path", "image"}
+        check("exact keys", all(set(r) == keys for r in got), repr(set(got[0])))
+        bases = [r["base"] for r in got]
+        check("ascending by base", bases == sorted(bases))
+        check("same count as VirtualQueryEx", len(got) == len(ref),
+              "%d vs %d" % (len(got), len(ref)))
+        mism = [(a, b) for a, b in zip(got, ref)
+                if (a["base"], a["size"], a["state"]) != (b[0], b[1], b[2])]
+        check("base/size/state match VirtualQueryEx one by one", not mism,
+              repr(mism[:2]))
+        prot_mism = [(a["protect"], b[3]) for a, b in zip(got, ref)
+                     if wvas.protection_name(b[3]) != a["protect"]]
+        check("protect matches", not prot_mism, repr(prot_mism[:3]))
+        type_mism = [(a["type"], b[4]) for a, b in zip(got, ref)
+                     if wvas.type_name(b[4]) != a["type"]]
+        check("type matches", not type_mism, repr(type_mism[:3]))
+        check("base is full width (some region above 4 GiB)",
+              any(r["base"] > 0xFFFFFFFF for r in got))
+        check("no truncation of a 6 GiB reservation",
+              any(r["size"] == 6 * 1024 * 1024 * 1024 for r in got),
+              repr(sorted((r["size"] for r in got), reverse=True)[:3]))
+        check("reserved regions are reported",
+              any(r["state"] == "reserve" for r in got))
+        check("reserved region at the 6 GiB reservation",
+              any(r["base"] == big and r["size"] >= 6 * 1024 * 1024 * 1024
+                  for r in got), "%#x" % big)
+        committed = wvas.regions(pid, include_reserved=False)
+        check("include_reserved=False drops reserve",
+              all(r["state"] == "commit" for r in committed))
+        check("include_reserved=False keeps every commit region",
+              [r["base"] for r in committed] ==
+              [r["base"] for r in got if r["state"] == "commit"])
+        check("image flag set for image regions only",
+              all((r["image"] == (r["type"] == "image")) for r in got))
+        check("path is None or str",
+              all(r["path"] is None or isinstance(r["path"], str) for r in got))
+        check("no empty-string paths", all(r["path"] != "" for r in got))
+        check("reserved regions have no path",
+              all(r["path"] is None for r in got if r["state"] == "reserve"))
+
+        print("\n== B. paths ==")
+        paths = [r["path"] for r in got if r["path"] is not None]
+        check("some paths reported", bool(paths))
+        bad = [p for p in paths if not is_openable(p)]
+        check("all paths are openable DOS/UNC", not bad, repr(bad[:3]))
+        prefixed = [p for p in paths
+                    if p.startswith(("\\Device", "\\??\\", "\\\\?\\"))]
+        check("no device/NT/extended prefix anywhere", not prefixed,
+              repr(prefixed[:3]))
+        file_regions = [r for r in got if r["base"] == view]
+        check("the file mapping view is reported", bool(file_regions),
+              "%#x" % view)
+        check("file mapping has a path", bool(file_regions) and file_regions[0]["path"],
+              repr(file_regions))
+        if file_regions and file_regions[0]["path"]:
+            got_path = os.path.normcase(os.path.abspath(file_regions[0]["path"]))
+            check("file mapping path is the real disk path",
+                  got_path == real_path, "%r vs %r" % (got_path, real_path))
+            check("the reported path can actually be opened",
+                  os.path.isfile(file_regions[0]["path"]),
+                  file_regions[0]["path"])
+        anon_regions = [r for r in got if r["base"] == anon_view]
+        check("anonymous view is reported", bool(anon_regions), "%#x" % anon_view)
+        check("anonymous mapping has path None",
+              bool(anon_regions) and anon_regions[0]["path"] is None,
+              repr(anon_regions))
+        private_regions = [r for r in got if r["type"] == "private"]
+        check("private memory has no path",
+              all(r["path"] is None for r in private_regions),
+              repr([r["path"] for r in private_regions if r["path"]][:3]))
+        backed = wvas.file_backed_regions(pid)
+        check("file_backed_regions is a list", isinstance(backed, list))
+        check("file_backed_regions == regions with a path, same order",
+              backed == [r for r in got if r["path"] is not None])
+        check("every file_backed_region path is openable",
+              all(is_openable(r["path"]) for r in backed))
+
+        print("\n== C. modules ==")
+        mods = wvas.modules(pid)
+        check("modules non-empty", bool(mods))
+        check("module keys", all(set(m) == {"path", "base", "size"} for m in mods),
+              repr(set(mods[0])))
+        mbases = [m["base"] for m in mods]
+        check("modules ascending by base", mbases == sorted(mbases))
+        check("modules unique by base", len(mbases) == len(set(mbases)),
+              "%d vs %d" % (len(mbases), len(set(mbases))))
+        named = [m["path"] for m in mods if m["path"]]
+        dupes = [p for p in named if sum(1 for q in named if q.lower() == p.lower()) > 1]
+        check("module paths unique", not dupes, repr(dupes[:3]))
+        check("no duplicate of python.exe",
+              sum(1 for p in named
+                  if os.path.basename(p).lower() == "python.exe") <= 1,
+              repr([p for p in named if p.lower().endswith("python.exe")][:5]))
+        not_openable = [p for p in named if not is_openable(p)]
+        check("module paths are openable", not not_openable, repr(not_openable[:3]))
+        check("python.exe present",
+              any(os.path.normcase(p) == os.path.normcase(sys.executable)
+                  for p in named), repr(named[:3]))
+        check("ntdll.dll present",
+              any(os.path.basename(p).lower() == "ntdll.dll" for p in named))
+        check("module sizes positive", all(m["size"] > 0 for m in mods))
+        image_bases = {r["base"] for r in got if r["image"]}
+        check("every image region base is in modules",
+              image_bases <= set(mbases),
+              repr([hex(b) for b in (image_bases - set(mbases))][:5]))
+
+        print("\n== D. errors ==")
+        for bad in (-1, 0, -100, 1 << 40):
+            for fn in (wvas.regions, wvas.modules, wvas.file_backed_regions):
+                try:
+                    fn(bad)
+                    check("%s badarg for pid=%r" % (fn.__name__, bad), False,
+                          "no error raised")
+                except wvas.WVasError as exc:
+                    check("%s badarg for pid=%r" % (fn.__name__, bad),
+                          exc.kind == "badarg", exc.kind)
+                except Exception as exc:
+                    check("%s badarg for pid=%r" % (fn.__name__, bad), False,
+                          repr(exc))
+        for fn in (wvas.regions, wvas.modules, wvas.file_backed_regions):
+            try:
+                fn(999999)
+                check("%s no-such-process" % fn.__name__, False, "no error")
+            except wvas.WVasError as exc:
+                check("%s no-such-process" % fn.__name__,
+                      exc.kind == "no-such-process", exc.kind)
+            except Exception as exc:
+                check("%s no-such-process" % fn.__name__, False, repr(exc))
+        for value, label in (("x", "str pid"), (True, "bool pid"),
+                             (None, "None pid"), (3.5, "float pid")):
+            try:
+                wvas.regions(value)
+                check("badarg for a %s" % label, False, "no error")
+            except wvas.WVasError as exc:
+                check("badarg for a %s" % label, exc.kind == "badarg", exc.kind)
+            except Exception as exc:
+                check("badarg for a %s" % label, False, repr(exc))
+
+        print("\n== E. purity and self process ==")
+        check("protection_name pure",
+              wvas.protection_name(0x04) == "rw" and wvas.protection_name(0x20) == "xr")
+        check("type_name pure",
+              wvas.type_name(0x1000000) == "image"
+              and wvas.type_name(0x40000) == "mapped"
+              and wvas.type_name(0x20000) == "private")
+        check("unknown protection is ?", wvas.protection_name(0x9999) == "?")
+        check("guard modifier ignored", wvas.protection_name(0x104) == "rw")
+        mine = wvas.regions(os.getpid())
+        check("own process regions", bool(mine))
+        mymods = wvas.modules(os.getpid())
+        check("own process modules", bool(mymods))
+        check("own process module paths all present",
+              all(m["path"] for m in mymods),
+              repr([m for m in mymods if not m["path"]][:3]))
+
+        print("\n== extra ==")
+        again = wvas.regions(pid)
+        check("repeat call keeps working", len(again) >= len(got) - 40)
+        print("  info: %d regions, %d file backed, %d modules" %
+              (len(got), len(backed), len(mods)))
+    finally:
+        proc.kill()
+        proc.wait()
+
+    print("\n%d checks failed" % len(FAILURES))
+    for label in FAILURES:
+        print("  -", label)
+    return 1 if FAILURES else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
