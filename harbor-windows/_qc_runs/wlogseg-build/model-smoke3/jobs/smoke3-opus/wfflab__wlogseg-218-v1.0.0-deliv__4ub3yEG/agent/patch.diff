diff --git a/wlogseg/crc.py b/wlogseg/crc.py
index 6656acb..2beed73 100644
--- a/wlogseg/crc.py
+++ b/wlogseg/crc.py
@@ -1,4 +1,8 @@
-"""容器尾部校验和使用的 32 位校验和。"""
+"""容器尾部校验和使用的 32 位校验和。
+
+容器使用的是标准的 CRC-32（CRC-32/ISO-HDLC，即 zlib / PNG / gzip 所用的那个
+变体：多项式 0xEDB88320 反射、初值 0xFFFFFFFF、结果再异或 0xFFFFFFFF）。
+"""
 
 from __future__ import annotations
 
@@ -6,12 +10,18 @@ import zlib
 
 
 def crc32_update(data, value: int = 0) -> int:
-    """在 ``value`` 的基础上继续累积校验和。"""
-    return (zlib.crc32(bytes(data), value) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+    """在 ``value`` 的基础上继续累积校验和。
+
+    满足 ``crc32_update(b, crc32_update(a)) == compute_crc(a + b)``，
+    因此可以用于流式分块计算。
+    """
+    if isinstance(data, str):
+        raise TypeError("crc32_update expects a bytes-like object")
+    return zlib.crc32(data, value & 0xFFFFFFFF) & 0xFFFFFFFF
 
 
 def compute_crc(data) -> int:
-    """返回容器使用的 32 位校验和。"""
+    """返回容器使用的 32 位校验和（标准 CRC-32）。"""
     if isinstance(data, str):
         raise TypeError("compute_crc expects a bytes-like object")
     return crc32_update(data, 0)
diff --git a/wlogseg/index.py b/wlogseg/index.py
