@@ -1,4 +1,8 @@
-"""尾部段索引。"""
+"""尾部段索引。
+
+真实样本里每个索引条目是 8 字节：段在文件中的起始偏移 + 该段的整体长度
+（段头 + 数据 + 填充），都是小端 32 位无符号整数。
+"""
 
 from __future__ import annotations
 
@@ -6,25 +10,28 @@ import struct
 
 from .errors import WSegError
 
-INDEX_ENTRY_SIZE = 4
+INDEX_ENTRY_SIZE = 8
 
-_ENTRY = struct.Struct("<I")
+_ENTRY = struct.Struct("<II")
 
 
-def build_index(offsets) -> bytes:
+def build_index(entries) -> bytes:
+    """``entries`` 为 [(offset, total_length), ...]。"""
     out = bytearray()
-    for offset in offsets:
-        out += _ENTRY.pack(offset & 0xFFFFFFFF)
+    for offset, total_length in entries:
+        out += _ENTRY.pack(offset & 0xFFFFFFFF, total_length & 0xFFFFFFFF)
     return bytes(out)
 
 
-def parse_index(data: bytes, pos: int, count: int):
-    """读取 ``count`` 个索引条目，返回各段偏移。"""
+def parse_index(data, pos: int, count: int):
+    """读取 ``count`` 个索引条目，返回 [(offset, total_length), ...]。"""
+    if pos < 0 or count < 0:
+        raise WSegError("structure", f"bad index location {pos}/{count}")
     needed = pos + INDEX_ENTRY_SIZE * count
     if needed > len(data):
-        raise WSegError("structure", f"index needs {INDEX_ENTRY_SIZE * count} bytes at {pos}")
-    offsets = []
+        raise WSegError("truncated", f"index needs {INDEX_ENTRY_SIZE * count} bytes at {pos}")
+    entries = []
     for index in range(count):
-        (offset,) = _ENTRY.unpack_from(data, pos + index * INDEX_ENTRY_SIZE)
-        offsets.append(offset)
-    return offsets
+        offset, total_length = _ENTRY.unpack_from(data, pos + index * INDEX_ENTRY_SIZE)
+        entries.append((offset, total_length))
+    return entries
