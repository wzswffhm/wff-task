+def _read_exactly(handle, count: int, what: str) -> bytes:
+    """读满 ``count`` 字节，否则抛 WSegError("truncated")。"""
+    if count <= 0:
+        return b""
+    chunks = []
+    remaining = count
+    while remaining > 0:
+        chunk = handle.read(remaining)
+        if not isinstance(chunk, (bytes, bytearray, memoryview)):
+            raise WSegError("structure",
+                            f"the stream returned {type(chunk).__name__}")
+        chunk = bytes(chunk)
+        if not chunk:
+            raise WSegError("truncated",
+                            f"{what} needs {count} bytes, got {count - remaining}")
+        chunks.append(chunk)
+        remaining -= len(chunk)
+        if remaining < 0:
+            raise WSegError("structure", f"the stream returned more than {count} bytes")
+    return b"".join(chunks)
 
 
