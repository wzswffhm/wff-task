index 0000000..dae76d7
--- /dev/null
+++ b/_tmp_inspect.py
@@ -0,0 +1,21 @@
+import zlib
+
+data = open('assets/sample.wlsg', 'rb').read()
+empty = open('assets/sample_empty.wlsg', 'rb').read()
+
+# empty sample: header is first 16 bytes, data_crc = last 4 bytes
+hdr = empty[:16]
+import struct
+idx_crc_e, data_crc_e = struct.unpack('<II', empty[16:24])
+print('empty index_crc=%08x data_crc=%08x' % (idx_crc_e, data_crc_e))
+print('zlib.crc32(hdr) = %08x' % zlib.crc32(hdr))
+print('zlib.crc32(hdr)^FFFFFFFF = %08x' % (zlib.crc32(hdr) ^ 0xFFFFFFFF))
+
+# sample: index region 344..384, trailer at 384
+idx_crc, data_crc = struct.unpack('<II', data[384:392])
+print('sample index_crc=%08x data_crc=%08x' % (idx_crc, data_crc))
+index_region = data[344:384]
+print('zlib.crc32(index_region) = %08x' % zlib.crc32(index_region))
+
+# data crc coverage: header + segment region = data[0:344]
+print('zlib.crc32(data[0:344]) = %08x' % zlib.crc32(data[0:344]))
