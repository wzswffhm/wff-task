+import struct
+
+data = open("assets/sample.wlsg", "rb").read()
+
+# Header
+magic, ver, flags, seg_count, idx_off, reserved = struct.unpack("<4sBBHII", data[:16])
+print(f"Header: magic={magic} ver={ver} flags={flags:#x} seg_count={seg_count} idx_off={idx_off:#x}")
+
+# Print exact bytes at key offsets
+for off in [0x10, 0x20, 0x28, 0x3C, 0x48]:
+    print(f"\nBytes @{off:#x}: {data[off:off+8].hex(' ')}")
+    # Try different struct interpretations
+    # Current: <HBBI = H(2)+B(1)+B(1)+I(4) = 8
+    v1 = struct.unpack_from("<HBBI", data, off)
+    print(f"  <HBBI: seg_id={v1[0]} flags={v1[1]} rsv={v1[2]} body_len={v1[3]}")
+    # Alternative: <HHI = H(2)+H(2)+I(4) = 8
+    v2 = struct.unpack_from("<HHI", data, off)
+    print(f"  <HHI:  seg_id={v2[0]} flags={v2[1]} body_len={v2[2]}")
+    # Alternative: <HIH 
+    v3 = struct.unpack_from("<HIH", data, off)
+    print(f"  <HIH:  seg_id={v3[0]} body_len={v3[1]} flags={v3[2]}")
+    # What about <HHi?
+    v4 = struct.unpack_from("<HHi", data, off)
+    print(f"  <HHi:  seg_id={v4[0]} flags={v4[1]} body_len={v4[2]}")
+
+# Let me also try interpreting as: seg_id(2), body_len(2), flags(1), reserved(3)?
+# Or seg_id(2), body_len(4), flags(1), pad(1)?
+print("\n\n--- Trying <H I B B (same as HBBI essentially) ---")
+# Actually let me look at what makes sense given the known segments
+
+# From the index entries:
+print("\nIndex entries:")
+for i in range(seg_count):
+    off_val = struct.unpack_from("<I", data, idx_off + i*4)[0]
+    print(f"  [{i}] -> {off_val:#x}")
+
+# So index says: seg0@0x10, seg1@0x10?? That can't be right...
+# Wait, let me re-read the index area
+print(f"\nIndex area ({idx_off:#x} to {idx_off + seg_count*4:#x}):")
+print(f"  hex: {data[idx_off:idx_off+seg_count*4].hex(' ')}")
+
+# And the full trailer area
+trailer_start = idx_off + seg_count * 4
+print(f"\nAfter index ({trailer_start:#x} to end {len(data):#x}):")
+remaining = data[trailer_start:]
+print(f"  hex: {remaining.hex(' ')}")
+print(f"  len: {len(remaining)}")
