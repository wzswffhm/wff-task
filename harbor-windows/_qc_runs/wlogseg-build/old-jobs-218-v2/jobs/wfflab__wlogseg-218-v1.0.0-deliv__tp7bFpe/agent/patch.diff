+import sys, io
+sys.path.insert(0, '.')
+
+from wlogseg import pack, unpack, verify, iter_segments, read_all, WSegError
+
+# Test: stream doesn't use read() without args
+class StrictBytesIO(io.BytesIO):
+    """Raises if read() is called without a positive integer argument."""
+    def read(self, n=None):
+        if n is None or n < 0:
+            raise RuntimeError(f"read() called with n={n!r} — forbidden!")
+        return super().read(n)
+
+sample = open("assets/sample.wlsg", "rb").read()
+print("=== Stream strictness test ===")
+try:
+    result = list(iter_segments(StrictBytesIO(sample)))
+    print(f"iter_segments with strict IO: OK ({len(result)} segments)")
+except RuntimeError as e:
+    print(f"FAIL: {e}")
+except Exception as e:
+    print(f"Other error: {type(e).__name__}: {e}")
+
+# Test: checksum error from stream
+print("\n=== Stream checksum error ===")
+tampered = bytearray(sample)
+tampered[20] ^= 0xFF
+try:
+    list(iter_segments(StrictBytesIO(bytes(tampered))))
+    print("FAIL: no error raised for tampered data")
+except WSegError as e:
+    print(f"OK: kind={e.kind}")
+
+# Test: structure errors
+print("\n=== Structure error tests ===")
+
+# Invalid seg_id
+try:
+    pack([(70000, b"x")])
+    print("FAIL: accepted seg_id > 65535")
+except WSegError as e:
+    print(f"seg_id out of range: kind={e.kind}")
+
+# Non-bytes payload
+try:
+    pack([(1, "string")])
+    print("FAIL: accepted string payload")
+except WSegError as e:
+    print(f"non-bytes payload: kind={e.kind}")
+
+# Negative seg_id
+try:
+    pack([(-1, b"x")])
+    print("FAIL: accepted negative seg_id")
+except WSegError as e:
+    print(f"negative seg_id: kind={e.kind}")
+
+# Bool seg_id (should be rejected since isinstance(True, int) is True)
+try:
+    pack([(True, b"x")])
+    print("FAIL: accepted bool seg_id")
+except WSegError as e:
+    print(f"bool seg_id: kind={e.kind}")
+
+# Empty payload is legal
+blob = pack([(42, b"")])
+result = unpack(blob)
+print(f"\nEmpty payload roundtrip: {result == [(42, b'')]}")
+
+# Test: truncated index
+print("\n=== Truncated index test ===")
+trunc = sample[:len(sample)-4]  # chop off part of trailer
+try:
+    unpack(trunc)
+    print("FAIL: no error for truncated trailer")
+except WSegError as e:
+    print(f"truncated trailer: kind={e.kind}")
+
+# Test: truncated segment
+trunc2 = sample[:50]  # well into segment area but incomplete
+try:
+    unpack(trunc2)
+    print("FAIL: no error for truncated segment")
+except WSegError as e:
+    print(f"truncated segment: kind={e.kind}")
+
+# Test: verify never raises
+print("\n=== verify never raises ===")
+for bad in [b"", b"x", b"WLSG", sample[:5], bytearray(sample), None]:
+    try:
+        r = verify(bad if bad is not None else b"")
+        print(f"  verify({type(bad).__name__} len={len(bad) if bad else 0}): {r}")
+    except Exception as e:
+        print(f"  FAIL: verify raised {type(e).__name__}: {e}")
+
+# Verify None specifically
+try:
+    r = verify(None)
+    print(f"  verify(None): {r}")
+except Exception as e:
+    print(f"  FAIL: verify(None) raised {type(e).__name__}: {e}")
+
+print("\nDone!")
