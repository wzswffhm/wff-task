@@ -0,0 +1,81 @@
+import struct
+
+data = open("assets/sample.wlsg", "rb").read()
+magic, ver, flags, seg_count, idx_off, reserved = struct.unpack("<4sBBHII", data[:16])
+
+print("Checking ALIGNMENT=8:")
+ALIGNMENT = 8
+SEG_HDR = 8
+
+pos = 16
+for i in range(seg_count):
+    # Read index entry
+    idx_off_val, idx_size = struct.unpack_from("<II", data, idx_off + i*8)
+    
+    # Read segment header at current pos
+    seg_id, seg_flags, rsv, body_len = struct.unpack_from("<HBBI", data, pos)
+    
+    raw_total = SEG_HDR + body_len
+    pad = (-raw_total) % ALIGNMENT
+    aligned_total = raw_total + pad
+    
+    print(f"seg[{i}] @{pos:#x}: id={seg_id} flags={seg_flags} body_len={body_len}")
+    print(f"  raw_total={raw_total} pad={pad} aligned_total={aligned_total}")
+    print(f"  index: offset={idx_off_val:#x} size={idx_size}")
+    print(f"  match offset: {pos == idx_off_val}, match size: {aligned_total == idx_size}")
+    
+    payload = data[pos+SEG_HDR:pos+SEG_HDR+body_len]
+    print(f"  payload preview: {payload[:20].hex(' ')}")
+    
+    pos += aligned_total
+
+print(f"\nFinal pos: {pos:#x}, expected idx_off: {idx_off:#x}, match: {pos == idx_off}")
+
+# Now check the trailer / checksums
+trailer_start = idx_off + seg_count * 8
+trailer = data[trailer_start:]
+print(f"\nTrailer ({len(trailer)} bytes): {trailer.hex(' ')}")
+
+if len(trailer) == 8:
+    crc1, crc2 = struct.unpack_from("<II", trailer, 0)
+    print(f"CRC1 (index?): {crc1:#010x}")
+    print(f"CRC2 (data?):  {crc2:#010x}")
+    
+    import zlib
+    
+    # Index region
+    index_region = data[idx_off:trailer_start]
+    print(f"\nIndex region ({len(index_region)} bytes): {index_region.hex(' ')}")
+    
+    # Try various CRC computations
+    def try_crc(label, d):
+        std = zlib.crc32(d) & 0xFFFFFFFF
+        raw0 = zlib.crc32(d, 0) & 0xFFFFFFFF
+        xor = (zlib.crc32(d, 0) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+        print(f"  {label}: std={std:#010x} raw0={raw0:#010x} xor={xor:#010x}")
+    
+    print("\nCRC of index region:")
+    try_crc("index_region", index_region)
+    
+    print("\nCRC of header only:")
+    try_crc("header", data[:16])
+    
+    print("\nCRC of header + segments (up to idx_off):")
+    try_crc("header+segments", data[:idx_off])
+    
+    print("\nCRC of segments only (no header):")
+    try_crc("segments_only", data[16:idx_off])
+
+# Also check empty sample
+print("\n\n=== Empty sample ===")
+edata = open("assets/sample_empty.wlsg", "rb").read()
+etrailer = edata[16:]
+ecrc1, ecrc2 = struct.unpack_from("<II", etrailer, 0)
+print(f"Empty trailer: {etrailer.hex(' ')}")
+print(f"CRC1={ecrc1:#010x} CRC2={ecrc2:#010x}")
+
+print("\nCRC of empty header:")
+try_crc("empty_header", edata[:16])
+
+print("\nCRC of empty bytes:")
+try_crc("empty", b"")
diff --git a/_tmp_crc.py b/_tmp_crc.py
