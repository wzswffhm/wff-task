index 0000000..ce24e11
--- /dev/null
+++ b/_tmp_debug_stream.py
@@ -0,0 +1,68 @@
+import sys, io, struct
+sys.path.insert(0, '.')
+
+from wlogseg import WSegError
+from wlogseg.stream import iter_segments
+from wlogseg.crc import crc32_update, compute_crc
+from wlogseg.segment import SEGMENT_HEADER_SIZE, segment_length
+
+sample = open("assets/sample.wlsg", "rb").read()
+tampered = bytearray(sample)
+tampered[20] ^= 0xFF
+
+# Manually trace what happens
+print(f"Sample byte at 20: orig={sample[20]:#x} tampered={tampered[20]:#x}")
+
+# Parse header to know seg_count
+hdr = tampered[:16]
+magic, ver, flags, seg_count, idx_off, rsv = struct.unpack("<4sBBHII", hdr)
+print(f"seg_count={seg_count} idx_off={idx_off:#x}")
+
+# The tampered byte is at position 20, which is in segment area (starts at 16)
+# seg[0] @0x10: header 8 bytes + body 5 bytes + pad 3 bytes = 16 bytes total
+# So pos 20 = 0x14 = seg[0].payload[4] (the 5th byte of "alpha" = 'a')
+# After tampering, the payload changes but length stays same
+
+# In stream mode, we read segments sequentially. The CRC should differ.
+# Let me check if _read_exact is failing somehow
+
+class DebugBytesIO(io.BytesIO):
+    def __init__(self, data):
+        super().__init__(data)
+        self._pos = 0
+    def read(self, n=None):
+        result = super().read(n)
+        # print(f"  read({n}) -> {len(result)} bytes at pos ~{self._pos}")
+        self._pos += len(result)
+        return result
+
+try:
+    result = list(iter_segments(DebugBytesIO(bytes(tampered))))
+    print(f"Unexpected success: {len(result)} segments")
+except WSegError as e:
+    print(f"WSegError: kind={e.kind}, msg={e.message}")
+except Exception as e:
+    print(f"Other: {type(e).__name__}: {e}")
+
+# Actually let me just add some debug prints to understand
+# The issue might be that the CRC computation in stream differs from unpack
+# because in stream we're computing incrementally vs all-at-once
+
+# Let's verify: does incremental CRC match bulk CRC?
+from wlogseg.crc import crc32_update
+bulk_crc = compute_crc(sample[:idx_off])
+incr = 0
+# header
+incr = crc32_update(sample[:16], incr)
+# segments one by one
+pos = 16
+for i in range(seg_count):
+    seg_hdr = sample[pos:pos+SEGMENT_HEADER_SIZE]
+    _, _, _, body_len = struct.unpack_from("<HBBI", seg_hdr, 0)
+    slen = segment_length(body_len)
+    incr = crc32_update(sample[pos:pos+slen], incr)
+    pos += slen
+incr &= 0xFFFFFFFF
+print(f"\nBulk CRC of header+segments: {bulk_crc:#010x}")
+print(f"Incremental CRC:             {incr:#010x}")
+print(f"Match: {bulk_crc == incr}")
