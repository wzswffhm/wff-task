+import sys
+sys.path.insert(0, '.')
+from wlogseg import verify, unpack, WSegError
+
+sample = open("assets/sample.wlsg", "rb").read()
+
+# Tamper payload content (not header)
+# seg[0] payload starts at 0x18 (header=0x10+8=0x18), body="alpha"
+# Let's tamper byte at 0x18 (first byte of payload)
+t1 = bytearray(sample)
+t1[0x18] ^= 0xFF
+print(f"Tamper payload byte: verify={verify(bytes(t1))}")
+
+# Tamper padding area
+t2 = bytearray(sample)
+t2[0x1D] ^= 0xFF  # padding after seg[0]
+print(f"Tamper padding byte: verify={verify(bytes(t2))}")
+
+# Tamper index area
+idx_off = 0x158
+t3 = bytearray(sample)
+t3[idx_off] ^= 0xFF
+print(f"Tamper index byte: verify={verify(bytes(t3))}")
+
+# Tamper header reserved field (shouldn't affect semantics but changes CRC)
+t4 = bytearray(sample)
+t4[14] ^= 0xFF
+print(f"Tamper header reserved: verify={verify(bytes(t4))}")
+
+# Now test stream with payload-only tampering
+import io
+from wlogseg import iter_segments
+
+t5 = bytearray(sample)
+t5[0x18] ^= 0xFF  # tamper first payload byte
+try:
+    list(iter_segments(io.BytesIO(bytes(t5))))
+    print("Stream with tampered payload: NO ERROR")
+except WSegError as e:
+    print(f"Stream with tampered payload: kind={e.kind}")
diff --git a/_tmp_verify.py b/_tmp_verify.py
new file mode 100644
index 0000000..c6839f0
--- /dev/null
+++ b/_tmp_verify.py
@@ -0,0 +1,105 @@
+import sys
+sys.path.insert(0, '.')
+
+from wlogseg import pack, unpack, verify, iter_segments, read_all, compute_crc, crc32_update, WSegError
+import io
+
+# Test 1: sample compatibility
+print("=== Test 1: Sample compatibility ===")
+sample = open("assets/sample.wlsg", "rb").read()
+print(f"verify(sample): {verify(sample)}")
+
+try:
+    segs = unpack(sample)
+    print(f"unpack(sample) returned {len(segs)} segments:")
+    for sid, pay in segs:
+        print(f"  id={sid} payload_len={len(pay)} preview={pay[:20]}")
+except Exception as e:
+    print(f"unpack(sample) FAILED: {e}")
+
+# Test 2: roundtrip
+print("\n=== Test 2: Roundtrip ===")
+try:
+    repacked = pack(unpack(sample))
+    print(f"pack(unpack(sample)) == sample: {repacked == sample}")
+    if repacked != sample:
+        print(f"  original len={len(sample)}, repacked len={len(repacked)}")
+        # Find first diff
+        for i in range(min(len(sample), len(repacked))):
+            if sample[i] != repacked[i]:
+                print(f"  first diff at byte {i}: orig={sample[i]:#x} new={repacked[i]:#x}")
+                break
+except Exception as e:
+    print(f"Roundtrip FAILED: {e}")
+
+# Test 3: empty sample
+print("\n=== Test 3: Empty sample ===")
+empty_sample = open("assets/sample_empty.wlsg", "rb").read()
+print(f"verify(empty_sample): {verify(empty_sample)}")
+try:
+    empty_segs = unpack(empty_sample)
+    print(f"unpack(empty_sample): {empty_segs}")
+    repacked_empty = pack(empty_segs)
+    print(f"pack(unpack(empty_sample)) == empty_sample: {repacked_empty == empty_sample}")
+except Exception as e:
+    print(f"Empty sample FAILED: {e}")
+
+# Test 4: own pack/unpack roundtrip
+print("\n=== Test 4: Own roundtrip ===")
+records = [(1, b"alpha"), (2, b"beta")]
+blob = pack(records)
+print(f"verify(own): {verify(blob)}")
+print(f"unpack(pack(records)) == records: {unpack(blob) == records}")
+
+# Test 5: CRC
+print("\n=== Test 5: CRC ===")
+import zlib
+test_data = b"Hello, World!"
+our_crc = compute_crc(test_data)
+std_crc = zlib.crc32(test_data) & 0xFFFFFFFF
+print(f"compute_crc({test_data!r}) = {our_crc:#010x}")
+print(f"zlib.crc32 standard       = {std_crc:#010x}")
+print(f"Match: {our_crc == std_crc}")
+
+# Test 6: iter_segments
+print("\n=== Test 6: iter_segments ===")
+try:
+    result = list(iter_segments(io.BytesIO(sample)))
+    print(f"iter_segments count: {len(result)}")
+    print(f"Matches unpack: {result == unpack(sample)}")
+except Exception as e:
+    print(f"iter_segments FAILED: {e}")
+
+# Test 7: error kinds
+print("\n=== Test 7: Error classification ===")
+# Bad magic
+bad_magic = bytearray(sample)
+bad_magic[0:4] = b"XXXX"
+try:
+    unpack(bytes(bad_magic))
+    print("bad magic: NO ERROR (BAD)")
+except WSegError as e:
+    print(f"bad magic: kind={e.kind} (expected 'magic')")
+
+# Truncated
+try:
+    unpack(sample[:10])
+    print("truncated: NO ERROR (BAD)")
+except WSegError as e:
+    print(f"truncated: kind={e.kind} (expected 'truncated')")
+
+# Bad version
+bad_ver = bytearray(sample)
+bad_ver[4] = 99
+try:
+    unpack(bytes(bad_ver))
+    print("bad version: NO ERROR (BAD)")
+except WSegError as e:
+    print(f"bad version: kind={e.kind} (expected 'version')")
+
+# Tampered content
+tampered = bytearray(sample)
+tampered[20] ^= 0xFF
+print(f"tampered verify: {verify(bytes(tampered))} (expected False)")
+
+print("\n=== All basic tests done ===")
