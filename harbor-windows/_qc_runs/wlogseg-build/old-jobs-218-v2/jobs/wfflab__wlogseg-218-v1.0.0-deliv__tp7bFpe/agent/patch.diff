index 0000000..c216975
--- /dev/null
+++ b/_tmp_crc.py
@@ -0,0 +1,94 @@
+import zlib
+
+# Standard CRC32 variants
+def crc32_std(data):
+    return zlib.crc32(data) & 0xFFFFFFFF
+
+def crc32_update_raw(data, value=0):
+    return zlib.crc32(bytes(data), value) & 0xFFFFFFFF
+
+# Current implementation
+def crc32_update_current(data, value=0):
+    return (zlib.crc32(bytes(data), value) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+
+# Empty sample analysis
+empty = open("assets/sample_empty.wlsg", "rb").read()
+header = empty[:16]
+trailer_bytes = empty[16:]
+print("Empty sample:")
+print(f"  header hex: {header.hex()}")
+print(f"  trailer hex: {trailer_bytes.hex()}")
+
+# The trailer is 8 bytes: could be (index_crc, data_crc) or something else
+import struct
+t1, t2 = struct.unpack("<II", trailer_bytes)
+print(f"  trailer as two u32 LE: {t1:#010x}, {t2:#010x}")
+
+# Try various CRC computations on header
+print(f"\nCRC of header (std):          {crc32_std(header):#010x}")
+print(f"CRC of header (raw update 0): {crc32_update_raw(header, 0):#010x}")
+print(f"CRC of header (current impl): {crc32_update_current(header, 0):#010x}")
+
+# Maybe the CRC covers nothing for empty? Or just header?
+# If index is empty (0 bytes), its CRC might be CRC of empty
+print(f"\nCRC of empty bytes (std):     {crc32_std(b''):#010x}")
+print(f"CRC of empty (raw update 0):  {crc32_update_raw(b'', 0):#010x}")
+print(f"CRC of empty (current impl):  {crc32_update_current(b'', 0):#010x}")
+
+# What about no-finalize CRC (i.e. zlib internal state)?
+# zlib.crc32 with init 0 gives raw; with default gives standard
+print(f"\nzlib.crc32(b''):              {zlib.crc32(b'') & 0xFFFFFFFF:#010x}")
+print(f"zlib.crc32(b'', 0):           {zlib.crc32(b'', 0) & 0xFFFFFFFF:#010x}")
+
+# Check if t2 matches any CRC of header
+print(f"\nt1={t1:#010x} t2={t2:#010x}")
+
+# Now analyze sample.wlsg
+data = open("assets/sample.wlsg", "rb").read()
+print(f"\n\nSample.wlsg len={len(data)}")
+hdr = data[:16]
+magic, ver, flags, seg_count, idx_off, reserved = struct.unpack("<4sBBHII", hdr)
+print(f"  magic={magic} ver={ver} flags={flags} seg_count={seg_count} idx_off={idx_off:#x} reserved={reserved:#x}")
+
+# Index region
+INDEX_ENTRY_SIZE = 4
+idx_end = idx_off + INDEX_ENTRY_SIZE * seg_count
+print(f"  index region: {idx_off:#x} .. {idx_end:#x} ({idx_end - idx_off} bytes)")
+trailer_start = idx_end
+trailer_end = len(data)
+print(f"  trailer: {trailer_start:#x} .. {trailer_end:#x} ({trailer_end - trailer_start} bytes)")
+trailer_data = data[trailer_start:trailer_end]
+print(f"  trailer hex: {trailer_data.hex()}")
+
+if len(trailer_data) >= 8:
+    t1, t2 = struct.unpack("<II", trailer_data[-8:])
+    print(f"  last 8 bytes as two u32 LE: {t1:#010x}, {t2:#010x}")
+
+# Let's also look at what's between header and index
+seg_area = data[16:idx_off]
+print(f"\n  segment area: 16 .. {idx_off:#x} ({len(seg_area)} bytes)")
+
+# Parse segments manually
+SEGMENT_HEADER_SIZE = 8
+pos = 16
+seg_idx = 0
+while pos < idx_off:
+    if pos + SEGMENT_HEADER_SIZE > idx_off:
+        print(f"  [!] incomplete segment header at {pos:#x}")
+        break
+    seg_id, flags, rsv, body_len = struct.unpack("<HBBI", data[pos:pos+8])
+    print(f"  seg[{seg_idx}] @{pos:#x}: id={seg_id} flags={flags} rsv={rsv} body_len={body_len}")
+    payload = data[pos+8:pos+8+body_len]
+    # check alignment
+    total = 8 + body_len
+    pad = (-total) % 4
+    print(f"         payload({len(payload)} bytes) pad={pad} total_with_pad={total+pad}")
+    pos += total + pad
+    seg_idx += 1
+print(f"  final pos after segments: {pos:#x}, expected idx_off: {idx_off:#x}")
+
+# Index entries
+print("\n  Index entries:")
+for i in range(seg_count):
+    off = struct.unpack("<I", data[idx_off + i*4:idx_off + i*4 + 4])[0]
+    print(f"    [{i}] -> {off:#x}")
