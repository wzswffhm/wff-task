+import struct
+
+data = open("assets/sample.wlsg", "rb").read()
+magic, ver, flags, seg_count, idx_off, reserved = struct.unpack("<4sBBHII", data[:16])
+print(f"seg_count={seg_count} idx_off={idx_off:#x} file_len={len(data)}")
+
+# If index entries are 8 bytes each
+remaining_after_idx = len(data) - idx_off
+print(f"remaining after idx_off: {remaining_after_idx} bytes")
+
+# Try 8-byte entries: 5*8=40, leaving 8 for trailer
+if remaining_after_idx == seg_count * 8 + 8:
+    print("=> Index entries are likely 8 bytes each, trailer is 8 bytes")
+    
+    # Parse 8-byte index entries
+    for i in range(seg_count):
+        entry = data[idx_off + i*8 : idx_off + i*8 + 8]
+        # Try different interpretations
+        v1 = struct.unpack_from("<II", entry, 0)
+        v2 = struct.unpack_from("<IH", entry, 0)
+        v3 = struct.unpack_from("<HHI", entry, 0)
+        print(f"  [{i}] hex={entry.hex(' ')}")
+        print(f"       <II: {v1[0]:#x}, {v1[1]:#x}")
+        print(f"       <IHxx: offset={v2[0]:#x}, something={v2[1]}")
+        print(f"       <HHI: {v3[0]}, {v3[1]}, {v3[2]:#x}")
+
+# Also check empty sample
+print("\n--- Empty sample ---")
+edata = open("assets/sample_empty.wlsg", "rb").read()
+emagic, ever, eflags, eseg_count, eidx_off, ereserved = struct.unpack("<4sBBHII", edata[:16])
+print(f"seg_count={eseg_count} idx_off={eidx_off:#x} file_len={len(edata)}")
+eremaining = len(edata) - eidx_off
+print(f"remaining after idx_off: {eremaining} bytes")
+print(f"trailer bytes: {edata[eidx_off:].hex(' ')}")
+
+# For empty: 0 entries * 8 + 8 = 8 bytes trailer. 24 - 16 = 8. Checks out!
+# So the trailer is always 8 bytes, and index entries are 8 bytes each.
+
+# Now let's verify: with 8-byte index entries, do the offsets make sense?
+print("\n--- Segment verification with 8-byte index ---")
+for i in range(seg_count):
+    off, size_or_something = struct.unpack_from("<II", data, idx_off + i*8)
+    print(f"  [{i}] offset={off:#x} second_u32={size_or_something:#x} ({size_or_something})")
+    if off + 8 <= len(data):
+        seg_hdr = data[off:off+8]
+        seg_id, b_flags, rsv, body_len = struct.unpack_from("<HBBI", seg_hdr, 0)
+        print(f"       seg_header: id={seg_id} flags={b_flags} body_len={body_len}")
