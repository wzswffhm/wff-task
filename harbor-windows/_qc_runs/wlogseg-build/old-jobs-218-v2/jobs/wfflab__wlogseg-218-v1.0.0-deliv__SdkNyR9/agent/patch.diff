+class _Reader:
+    """对文件对象做固定大小读取的薄封装，并顺带累积 CRC。"""
+
+    def __init__(self, handle, chunk_size: int = 65536) -> None:
+        self._handle = handle
+        self._chunk_size = chunk_size
+        self._pending = b""
+        self._pos = 0
+
+    def read(self, size: int) -> bytes:
+        """读满 ``size`` 个字节；不足说明流提前结束。"""
+        if size < 0:
+            raise WSegError("truncated", "cannot read a negative amount")
+        chunks = []
+        need = size
+        while need:
+            part = self._handle.read(min(need, self._chunk_size))
+            if part is None:
+                part = b""
+            if not isinstance(part, (bytes, bytearray, memoryview)):
+                raise WSegError(
+                    "structure", f"the stream returned {type(part).__name__}"
+                )
+            part = bytes(part)
+            if not part:
+                raise WSegError("truncated", f"expected {size} bytes, got {size - need} at {self._pos}")
+            chunks.append(part)
+            need -= len(part)
+            self._pos += len(part)
+        return b"".join(chunks)
+
+    def skip(self, size: int) -> None:
+        """跳过 ``size`` 个字节（仍按固定块读取）。"""
+        while size > 0:
+            chunk = self.read(min(size, self._chunk_size))
+            size -= len(chunk)
+
