+"""容器尾部校验和使用的 32 位校验和。
+
+格式使用标准的 CRC-32（IEEE 802.3 / zlib 的 ``crc32``）：
+
+- 多项式 ``0xEDB88320``（反射形式，正向为 ``0x04C11DB7``）
+- 初始值 ``0xFFFFFFFF``，输出异或 ``0xFFFFFFFF``
+- 逐字节反射输入、反射输出，即 ``zlib.crc32`` / ``binascii.crc32`` 的实现
+
+因此 ``compute_crc(b"123456789") == 0xCBF43926``，与公开的 CRC-32
+检测向量一致。
+"""
 
 from __future__ import annotations
 
 import zlib
 
+CRC_POLY = 0xEDB88320
+CRC_INIT = 0xFFFFFFFF
+CRC_XOROUT = 0xFFFFFFFF
+
+_TABLE = None
+
+
+def _table() -> tuple:
+    """惰性构建逐字节查表。"""
+    global _TABLE
+    if _TABLE is None:
+        table = []
+        for byte in range(256):
+            value = byte
+            for _ in range(8):
+                if value & 1:
+                    value = (value >> 1) ^ CRC_POLY
+                else:
+                    value >>= 1
+            table.append(value)
+        _TABLE = tuple(table)
+    return _TABLE
+
 
 def crc32_update(data, value: int = 0) -> int:
-    """在 ``value`` 的基础上继续累积校验和。"""
-    return (zlib.crc32(bytes(data), value) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+    """在 ``value`` 的基础上继续累积 CRC-32。
+
+    ``value`` 是上一次调用（或 0）的返回值，因此可以链式地对
+    分块数据累计校验和，例如
+    ``crc32_update(chunk_b, crc32_update(chunk_a, 0))``。
+    """
+    if isinstance(data, str):
+        raise TypeError("crc32_update expects a bytes-like object")
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError("crc32_update expects an integer crc value")
+    value &= 0xFFFFFFFF
+    table = _table()
+    view = memoryview(bytes(data))
+    for byte in view:
+        value = table[(value ^ byte) & 0xFF] ^ (value >> 8)
+    return value
 
 
 def compute_crc(data) -> int:
-    """返回容器使用的 32 位校验和。"""
+    """返回 ``data`` 的标准 CRC-32（IEEE 802.3）校验和。"""
     if isinstance(data, str):
         raise TypeError("compute_crc expects a bytes-like object")
-    return crc32_update(data, 0)
+    return crc32_update(data, CRC_INIT) ^ CRC_XOROUT
