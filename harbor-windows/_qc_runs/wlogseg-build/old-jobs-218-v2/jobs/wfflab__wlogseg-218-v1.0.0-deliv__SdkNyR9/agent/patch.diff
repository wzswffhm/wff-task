diff --git a/__tmp_dump.py b/__tmp_dump.py
new file mode 100644
index 0000000..2c2076c
--- /dev/null
+++ b/__tmp_dump.py
@@ -0,0 +1,48 @@
+import struct, zlib
+d = open('assets/sample.wlsg','rb').read()
+e = open('assets/sample_empty.wlsg','rb').read()
+
+# Hypothesis:
+#  header (16B): <4sBBHII> magic, version, flags, seg_count, index_offset, reserved
+#  segments: 8B header <HBBI> (seg_id, flags, reserved, body_len) + payload + zero pad to 8B record alignment
+#  index: seg_count * 8B entries <II> = (segment_offset, segment_record_length)
+#  trailer (8B): <II> (crc32(index_region), crc32(data[0:index_offset]))
+
+def parse(data):
+    magic, ver, flags, seg_count, index_offset, res = struct.unpack_from('<4sBBHII', data, 0)
+    print('hdr', magic, ver, flags, seg_count, index_offset, res)
+    cursor = 16
+    entries = []
+    segs = []
+    for i in range(seg_count):
+        seg_id, fl, r, blen = struct.unpack_from('<HBBI', data, cursor)
+        rec = 8 + blen + (-(8+blen)) % 8
+        print('  seg', i, 'off', cursor, 'id', seg_id, 'len', blen, 'rec', rec,
+              'pad', (-(8+blen)) % 8, 'payload', data[cursor+8:cursor+8+blen][:12])
+        segs.append((seg_id, data[cursor+8:cursor+8+blen]))
+        entries.append((cursor, rec))
+        cursor += rec
+    print('  cursor end', cursor, 'index_offset', index_offset, 'match', cursor == index_offset)
+    index_end = index_offset + 8*seg_count
+    print('  index_end', index_end, 'filelen', len(data), 'exact', index_end + 8 == len(data))
+    idx = data[index_offset:index_end]
+    got = [struct.unpack_from('<II', idx, i*8) for i in range(seg_count)]
+    print('  index entries', got, 'match', got == entries)
+    icrc, dcrc = struct.unpack_from('<II', data, len(data)-8)
+    print('  trailer', hex(icrc), hex(dcrc))
+    print('  crc32(index)', hex(zlib.crc32(idx)), 'match', zlib.crc32(idx) == icrc)
+    print('  crc32(data[:index_offset])', hex(zlib.crc32(data[:index_offset])), 'match', zlib.crc32(data[:index_offset]) == dcrc)
+    return segs
+
+print('=== sample ==='); segs = parse(d)
+print('=== empty ==='); parse(e)
+print()
+print('seg ids/payload lens:', [(i, len(p)) for i, p in segs])
+
+# check padding bytes are zero
+c = 16
+for i,(sid,p) in enumerate(segs):
+    blen = len(p)
+    pad = (-(8+blen)) % 8
+    print('seg', i, 'padding bytes', d[c+8+blen:c+8+blen+pad].hex(), 'zero' if set(d[c+8+blen:c+8+blen+pad]) <= {0} else 'NONZERO')
+    c += 8+blen+pad
