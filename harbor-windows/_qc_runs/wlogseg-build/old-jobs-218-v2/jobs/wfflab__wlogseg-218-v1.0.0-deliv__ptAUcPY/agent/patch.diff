diff --git a/check_crc.py b/check_crc.py
new file mode 100644
index 0000000..bfef93d
--- /dev/null
+++ b/check_crc.py
@@ -0,0 +1,73 @@
+import struct, zlib
+
+data = open('assets/sample.wlsg', 'rb').read()
+
+# Header: bytes 0..15
+header = data[:16]
+
+# Segments area: bytes 16..343
+seg_area = data[16:344]
+
+# Index region: bytes 344..383 (40 bytes = 5 entries * 8 bytes)
+index_region = data[344:384]
+
+# Trailer: bytes 384..391
+trailer = data[384:392]
+t1 = struct.unpack_from('<I', trailer, 0)[0]
+t2 = struct.unpack_from('<I', trailer, 4)[0]
+print(f"Stored trailer values: ({hex(t1)}, {hex(t2)})")
+
+# Standard CRC-32
+def std_crc(d):
+    return zlib.crc32(d) & 0xFFFFFFFF
+
+# Try various CRC coverage options
+print("\n--- Trying different CRC coverages ---")
+
+# Option 1: t1 = CRC(index), t2 = CRC(header + seg_area)
+c1 = std_crc(index_region)
+c2 = std_crc(header + seg_area)
+print(f"CRC(index)={hex(c1)}, CRC(header+seg_area)={hex(c2)}")
+print(f"  Match t1? {c1==t1}, Match t2? {c2==t2}")
+
+# Option 2: t1 = CRC(header + seg_area), t2 = CRC(index)
+print(f"  Swap: Match t1? {c2==t1}, Match t2? {c1==t2}")
+
+# Option 3: t1 = CRC(index), t2 = CRC(header only)
+c3 = std_crc(header)
+print(f"CRC(index)={hex(c1)}, CRC(header)={hex(c3)}")
+print(f"  Match t1? {c1==t1}, Match t2? {c3==t2}")
+
+# Option 4: CRC of entire file except trailer
+c4 = std_crc(data[:-8])
+print(f"CRC(all_except_trailer)={hex(c4)}")
+print(f"  Match t1? {c4==t1}, Match t2? {c4==t2}")
+
+# Option 5: t1 = CRC(seg_area only), t2 = CRC(header + index)
+c5 = std_crc(seg_area)
+c6 = std_crc(header + index_region)
+print(f"CRC(seg_area)={hex(c5)}, CRC(header+index)={hex(c6)}")
+print(f"  Match t1? {c5==t1}, Match t2? {c6==t2}")
+
+# Option 6: Maybe segment data without padding?
+# Build segment data without padding
+entries = [(16,16),(32,8),(40,24),(64,264),(328,16)]
+seg_no_pad = bytearray()
+for off, tlen in entries:
+    body_len = struct.unpack_from('<I', data, off+4)[0]
+    seg_no_pad += data[off:off+8+body_len]
+c7 = std_crc(header + bytes(seg_no_pad))
+print(f"CRC(header+seg_no_pad)={hex(c7)}")
+print(f"  Match t1? {c7==t1}, Match t2? {c7==t2}")
+
+# Also check empty sample
+print("\n=== Empty sample ===")
+edata = open('assets/sample_empty.wlsg', 'rb').read()
+etrailer = edata[16:24]
+et1 = struct.unpack_from('<I', etrailer, 0)[0]
+et2 = struct.unpack_from('<I', etrailer, 4)[0]
+print(f"Stored: ({hex(et1)}, {hex(et2)})")
+eheader = edata[:16]
+print(f"CRC(empty_header)={hex(std_crc(eheader))}")
+print(f"CRC(empty_bytes)={hex(std_crc(b''))}")
+print(f"Match et1? empty_crc={std_crc(b'')==et1}, header_crc={std_crc(eheader)==et2}")
diff --git a/parse_sample.py b/parse_sample.py
new file mode 100644
index 0000000..e68cb86
--- /dev/null
+++ b/parse_sample.py
@@ -0,0 +1,68 @@
+import struct
+
+data = open('assets/sample.wlsg', 'rb').read()
+print(f"Total length: {len(data)}")
+
+# Header
+magic = data[0:4]
+version = data[4]
+flags = data[5]
+seg_count = struct.unpack_from('<H', data, 6)[0]
+index_offset = struct.unpack_from('<I', data, 8)[0]
+reserved = struct.unpack_from('<I', data, 12)[0]
+print(f"Header: magic={magic}, ver={version}, flags={flags}, seg_count={seg_count}, index_offset={index_offset}, reserved={reserved}")
+
+# Parse segments sequentially
+pos = 16
+print("\nSegments (sequential parse):")
+for i in range(seg_count):
+    seg_id = struct.unpack_from('<H', data, pos)[0]
+    sflags = data[pos+2]
+    sresv = data[pos+3]
+    body_len = struct.unpack_from('<I', data, pos+4)[0]
+    payload = data[pos+8:pos+8+body_len]
+    pad = (-(8 + body_len)) % 4
+    total = 8 + body_len + pad
+    print(f"  Seg {i}: pos={pos}, seg_id={seg_id}, flags={sflags}, resv={sresv}, body_len={body_len}, pad={pad}, total={total}")
+    print(f"    payload preview: {payload[:30]}")
+    pos += total
+
+print(f"\nAfter segments: pos={pos}, index_offset={index_offset}")
+
+# Index region
+idx_end = len(data) - 8  # assuming 8-byte trailer
+idx_region = data[index_offset:idx_end]
+print(f"\nIndex region ({index_offset} to {idx_end}):")
+print(f"  Index region size: {len(idx_region)} bytes")
+entry_size = len(idx_region) // seg_count if seg_count > 0 else 0
+print(f"  Entry size: {entry_size} bytes")
+
+# Try different entry sizes
+for esz in [4, 8, 12, 16]:
+    if len(idx_region) % esz == 0 and len(idx_region) // esz == seg_count:
+        print(f"\n  Trying entry_size={esz}:")
+        for j in range(seg_count):
+            entry = idx_region[j*esz:(j+1)*esz]
+            print(f"    [{j}] = {entry.hex()}")
+
+# Trailer
+trailer = data[-8:]
+print(f"\nTrailer (last 8 bytes): {trailer.hex()}")
+t1 = struct.unpack_from('<I', trailer, 0)[0]
+t2 = struct.unpack_from('<I', trailer, 4)[0]
+print(f"  As two LE uint32: ({hex(t1)}, {hex(t2)})")
+
+# Also check empty sample
+print("\n\n=== Empty sample ===")
+edata = open('assets/sample_empty.wlsg', 'rb').read()
+print(f"Length: {len(edata)}")
+print(f"Hex: {edata.hex()}")
+emagic = edata[0:4]
+ever = edata[4]
+efl = edata[5]
+esc = struct.unpack_from('<H', edata, 6)[0]
+eio = struct.unpack_from('<I', edata, 8)[0]
+eresv = struct.unpack_from('<I', edata, 12)[0]
+print(f"Header: magic={emagic}, ver={ever}, flags={efl}, seg_count={esc}, index_offset={eio}, reserved={eresv}")
+etrailer = edata[16:]
+print(f"After header: {etrailer.hex()} ({len(etrailer)} bytes)")
