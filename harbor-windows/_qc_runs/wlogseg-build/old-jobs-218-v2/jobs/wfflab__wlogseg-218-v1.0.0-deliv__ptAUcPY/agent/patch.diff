@@ -0,0 +1,42 @@
+import struct
+
+data = open('assets/sample.wlsg', 'rb').read()
+
+# Index entries as (offset, total_length)
+entries = [
+    (16, 16),
+    (32, 8),
+    (40, 24),
+    (64, 264),
+    (328, 16),
+]
+
+for i, (off, tlen) in enumerate(entries):
+    seg_data = data[off:off+tlen]
+    print(f"\nSeg {i}: offset={off}, total_len={tlen}")
+    print(f"  Raw header (8 bytes): {seg_data[:8].hex()}")
+    
+    # Try current format: <HBBI (seg_id:H, flags:B, resv:B, body_len:I)
+    seg_id = struct.unpack_from('<H', seg_data, 0)[0]
+    flags = seg_data[2]
+    resv = seg_data[3]
+    body_len = struct.unpack_from('<I', seg_data, 4)[0]
+    print(f"  <HBBI: seg_id={seg_id}, flags={flags}, resv={resv}, body_len={body_len}")
+    if body_len <= tlen - 8:
+        payload = seg_data[8:8+body_len]
+        pad = tlen - 8 - body_len
+        print(f"    payload ({body_len} bytes): {payload[:40]}")
+        print(f"    padding: {pad} bytes")
+    else:
+        print(f"    ERROR: body_len > available space")
+    
+    # Try alternative format: <HHI (seg_id:H, flags:H, body_len:I)
+    seg_id2 = struct.unpack_from('<H', seg_data, 0)[0]
+    flags2 = struct.unpack_from('<H', seg_data, 2)[0]
+    body_len2 = struct.unpack_from('<I', seg_data, 4)[0]
+    print(f"  <HHI: seg_id={seg_id2}, flags={flags2}, body_len={body_len2}")
+    
+    # Try: <II (seg_id:I, body_len:I) 
+    seg_id3 = struct.unpack_from('<I', seg_data, 0)[0]
+    body_len3 = struct.unpack_from('<I', seg_data, 4)[0]
+    print(f"  <II: seg_id={seg_id3}, body_len={body_len3}")
