@@ -0,0 +1,34 @@
+import struct, zlib
+
+data = open('assets/sample.wlsg', 'rb').read()
+
+# Index region: offset 344, 5 entries of 8 bytes each = 40 bytes
+index_region = data[344:384]
+idx_crc_computed = zlib.crc32(index_region) & 0xFFFFFFFF
+idx_crc_stored = struct.unpack_from('<I', data, 384)[0]
+print(f"Index CRC: computed={idx_crc_computed:#010x} stored={idx_crc_stored:#010x} match={idx_crc_computed==idx_crc_stored}")
+
+# Data CRC covers header + segment area (offset 0 to 344)
+header_and_segs = data[:344]
+data_crc_computed = zlib.crc32(header_and_segs) & 0xFFFFFFFF
+data_crc_stored = struct.unpack_from('<I', data, 388)[0]
+print(f"Data CRC:  computed={data_crc_computed:#010x} stored={data_crc_stored:#010x} match={data_crc_computed==data_crc_stored}")
+
+# Verify empty sample
+edata = open('assets/sample_empty.wlsg', 'rb').read()
+# index_offset=16, 0 entries, trailer at 16
+e_data_crc = zlib.crc32(edata[:16]) & 0xFFFFFFFF
+e_data_crc_stored = struct.unpack_from('<I', edata, 20)[0]
+print(f"\nEmpty Data CRC: computed={e_data_crc:#010x} stored={e_data_crc_stored:#010x} match={e_data_crc==e_data_crc_stored}")
+
+# Also check: does the current code's segment parsing work with ALIGNMENT=8?
+print("\n--- Segment parsing with ALIGNMENT=8 ---")
+pos = 16
+for i in range(5):
+    sid, fl, resv, blen = struct.unpack_from('<HBBI', data, pos)
+    pad = (-(8 + blen)) % 8
+    total = 8 + blen + pad
+    payload = data[pos+8:pos+8+blen]
+    print(f"seg[{i}] @{pos}: id={sid} body_len={blen} pad={pad} total={total} payload_preview={payload[:20]}")
+    pos += total
+print(f"Final pos={pos}, expected index_offset=344, match={pos==344}")
diff --git a/_analyze5.py b/_analyze5.py
new file mode 100644
index 0000000..35914be
--- /dev/null
+++ b/_analyze5.py
@@ -0,0 +1,67 @@
+import struct, zlib
+
+# What does the current code produce for the same segments?
+# seg0: id=1, body=b'alpha' (5 bytes)
+# seg1: id=2, body=b'' (0 bytes)
+# seg2: id=300, body=b'xxxxxxxxxx' (10 bytes)
+# seg3: id=4, body=bytes(range(256)) (256 bytes)
+# seg4: id=65000, body=b'z' (1 byte)
+
+segments = [
+    (1, b'alpha'),
+    (2, b''),
+    (300, b'xxxxxxxxxx'),
+    (4, bytes(range(256))),
+    (65000, b'z'),
+]
+
+# With ALIGNMENT=8 and INDEX_ENTRY_SIZE=8
+HEADER_SIZE = 16
+SEG_HEADER_SIZE = 8
+ALIGNMENT = 8
+INDEX_ENTRY_SIZE = 8
+
+# Build segments
+seg_bytes = bytearray()
+offsets = []
+cursor = HEADER_SIZE
+for sid, payload in segments:
+    offsets.append(cursor)
+    pad = (-(SEG_HEADER_SIZE + len(payload))) % ALIGNMENT
+    seg_hdr = struct.pack('<HBBI', sid, 0, 0, len(payload))
+    seg_bytes += seg_hdr + payload + b'\x00' * pad
+    cursor += SEG_HEADER_SIZE + len(payload) + pad
+
+index_offset = cursor
+header = struct.pack('<4sBBHII', b'WLSG', 1, 0, len(segments), index_offset, 0)
+
+# Build index (8 bytes per entry: offset + total_length)
+index_data = bytearray()
+for i, (sid, payload) in enumerate(segments):
+    pad = (-(SEG_HEADER_SIZE + len(payload))) % ALIGNMENT
+    total = SEG_HEADER_SIZE + len(payload) + pad
+    index_data += struct.pack('<II', offsets[i], total)
+
+# CRC
+data_to_crc = bytes(header) + bytes(seg_bytes)
+data_crc = zlib.crc32(data_to_crc) & 0xFFFFFFFF
+index_crc = zlib.crc32(bytes(index_data)) & 0xFFFFFFFF
+
+trailer = struct.pack('<II', index_crc, data_crc)
+
+result = bytes(header) + bytes(seg_bytes) + bytes(index_data) + trailer
+
+# Compare with sample
+sample = open('assets/sample.wlsg', 'rb').read()
+print(f"Generated length: {len(result)}")
+print(f"Sample length: {len(sample)}")
+print(f"Match: {result == sample}")
+
+if result != sample:
+    # Find first difference
+    for i in range(min(len(result), len(sample))):
+        if result[i] != sample[i]:
+            print(f"First diff at byte {i}: generated={result[i]:#04x} sample={sample[i]:#04x}")
+            break
+    if len(result) != len(sample):
+        print(f"Length mismatch: {len(result)} vs {len(sample)}")
