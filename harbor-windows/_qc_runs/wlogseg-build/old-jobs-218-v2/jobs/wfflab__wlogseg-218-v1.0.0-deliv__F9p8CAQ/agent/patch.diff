diff --git a/_analyze.py b/_analyze.py
new file mode 100644
index 0000000..ef37180
--- /dev/null
+++ b/_analyze.py
@@ -0,0 +1,65 @@
+import struct, zlib
+
+data = open('assets/sample.wlsg', 'rb').read()
+print(f"Total length: {len(data)}")
+
+# Parse header
+m, v, f, sc, io_off, r = struct.unpack_from('<4sBBHII', data, 0)
+print(f"Header: magic={m} ver={v} flags={f} seg_count={sc} idx_off={io_off} reserved={r}")
+
+# Parse segments starting at offset 16
+pos = 16
+seg_hdr = struct.Struct('<HBBI')
+offsets = []
+idx = 0
+while pos < io_off:
+    sid, fl, resv, blen = seg_hdr.unpack_from(data, pos)
+    payload = data[pos+8:pos+8+blen]
+    pad = (-(8 + blen)) % 4
+    seg_total = 8 + blen + pad
+    print(f"seg[{idx}] @{pos}: id={sid} flags={fl} resv={resv} body_len={blen} pad={pad} total={seg_total}")
+    print(f"  payload({len(payload)}): {payload[:50]}")
+    offsets.append(pos)
+    pos += seg_total
+    idx += 1
+
+print(f"\nParsed {idx} segments, final pos={pos}, index_offset={io_off}")
+
+# Parse index
+print("\nIndex entries:")
+for i in range(sc):
+    entry_off = io_off + i * 4
+    (off,) = struct.unpack_from('<I', data, entry_off)
+    print(f"  index[{i}] = {off} (parsed_offset={offsets[i]}) match={off==offsets[i]}")
+
+# Parse trailer
+trailer_pos = io_off + sc * 4
+print(f"\nTrailer at offset {trailer_pos}:")
+idx_crc, data_crc = struct.unpack_from('<II', data, trailer_pos)
+print(f"  index_crc = {idx_crc:#010x}")
+print(f"  data_crc  = {data_crc:#010x}")
+
+# Verify CRCs with standard zlib.crc32
+index_region = data[io_off:io_off + sc * 4]
+std_idx_crc = zlib.crc32(index_region) & 0xFFFFFFFF
+print(f"\n  computed index_crc (std) = {std_idx_crc:#010x} match={std_idx_crc == idx_crc}")
+
+# Data CRC covers header + segment area
+header_and_segs = data[:io_off]
+std_data_crc = zlib.crc32(header_and_segs) & 0xFFFFFFFF
+print(f"  computed data_crc (std, header+segs) = {std_data_crc:#010x} match={std_data_crc == data_crc}")
+
+# Also check what current impl gives
+cur_data_crc = (zlib.crc32(header_and_segs, 0) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+print(f"  computed data_crc (current impl) = {cur_data_crc:#010x}")
+
+# Check empty sample too
+print("\n--- Empty sample ---")
+edata = open('assets/sample_empty.wlsg', 'rb').read()
+em, ev, ef, esc, eio, er = struct.unpack_from('<4sBBHII', edata, 0)
+print(f"Header: magic={em} ver={ev} flags={ef} seg_count={esc} idx_off={eio} reserved={er}")
+etrailer = edata[eio:eio+8]
+eidx_crc, edata_crc = struct.unpack_from('<II', etrailer, 0)
+print(f"  index_crc={eidx_crc:#010x} data_crc={edata_crc:#010x}")
+estd = zlib.crc32(edata[:eio]) & 0xFFFFFFFF
+print(f"  computed data_crc (std)={estd:#010x} match={estd==edata_crc}")
diff --git a/_analyze2.py b/_analyze2.py
new file mode 100644
index 0000000..1a47702
--- /dev/null
+++ b/_analyze2.py
@@ -0,0 +1,35 @@
+import struct, zlib
+
+data = open('assets/sample.wlsg', 'rb').read()
+
+# Index region: offset 344 to 384 (exclusive), 5 entries of 8 bytes each
+print("Index entries (8 bytes each):")
+for i in range(5):
+    off = 344 + i * 8
+    val = data[off:off+8]
+    print(f"  entry[{i}] @{off}: {val.hex()} -> as two u32le: {struct.unpack_from('<II', data, off)}")
+    # Maybe it's a single u64?
+    print(f"    as u64le: {struct.unpack_from('<Q', data, off)[0]}")
+
+# Trailer at 384..391
+print(f"\nTrailer @{384}: {data[384:392].hex()}")
+idx_crc, data_crc = struct.unpack_from('<II', data, 384)
+print(f"  idx_crc={idx_crc:#010x} data_crc={data_crc:#010x}")
+
+# Now let's figure out what the 8-byte index entries mean
+# First 4 bytes could be offset, second 4 bytes could be length or something else
+print("\nInterpreting as (offset_u32, something_u32):")
+for i in range(5):
+    off = 344 + i * 8
+    a, b = struct.unpack_from('<II', data, off)
+    print(f"  entry[{i}]: offset={a}, other={b}")
+
+# Also check empty sample
+edata = open('assets/sample_empty.wlsg', 'rb').read()
+print(f"\nEmpty sample len={len(edata)}")
+# Header 16, no segments, index_offset=16
+# With 0 entries of 8 bytes, index is 0 bytes
+# Trailer should be at offset 16, 8 bytes -> total 24. That matches!
+print(f"Empty trailer: {edata[16:24].hex()}")
+eidx_crc, edata_crc = struct.unpack_from('<II', edata, 16)
+print(f"  idx_crc={eidx_crc:#010x} data_crc={edata_crc:#010x}")
diff --git a/_analyze3.py b/_analyze3.py
