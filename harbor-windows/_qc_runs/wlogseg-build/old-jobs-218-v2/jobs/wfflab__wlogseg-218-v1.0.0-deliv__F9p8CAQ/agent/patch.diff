+++ b/_analyze3.py
@@ -0,0 +1,40 @@
+import struct
+
+data = open('assets/sample.wlsg', 'rb').read()
+
+segments_info = [
+    (16, 16),   # seg0
+    (32, 8),    # seg1
+    (40, 24),   # seg2
+    (64, 264),  # seg3
+    (328, 16),  # seg4
+]
+
+for i, (off, length) in enumerate(segments_info):
+    raw = data[off:off+length]
+    print(f"\nseg[{i}] @{off} len={length}:")
+    print(f"  hex: {raw.hex()}")
+    # Try different header interpretations
+    # Option A: <HBBI (current code) - 8 byte header
+    if length >= 8:
+        sid_a, fl_a, resv_a, blen_a = struct.unpack_from('<HBBI', raw, 0)
+        print(f"  <HBBI: id={sid_a} flags={fl_a} resv={resv_a} body_len={blen_a}")
+        print(f"    header(8)+body({blen_a})={8+blen_a}, remaining={length-8-blen_a}")
+    
+    # Option B: <HHI - 8 byte header
+    if length >= 8:
+        sid_b, x_b, blen_b = struct.unpack_from('<HHI', raw, 0)
+        print(f"  <HHI: id={sid_b} x={x_b} body_len={blen_b}")
+        print(f"    header(8)+body({blen_b})={8+blen_b}, remaining={length-8-blen_b}")
+
+    # Option C: <HI - 6 byte header
+    if length >= 6:
+        sid_c, blen_c = struct.unpack_from('<HI', raw, 0)
+        print(f"  <HI: id={sid_c} body_len={blen_c}")
+        print(f"    header(6)+body({blen_c})={6+blen_c}, remaining={length-6-blen_c}")
+
+    # Option D: <II - 8 byte header (seg_id as u32)
+    if length >= 8:
+        sid_d, blen_d = struct.unpack_from('<II', raw, 0)
+        print(f"  <II: id={sid_d} body_len={blen_d}")
+        print(f"    header(8)+body({blen_d})={8+blen_d}, remaining={length-8-blen_d}")
