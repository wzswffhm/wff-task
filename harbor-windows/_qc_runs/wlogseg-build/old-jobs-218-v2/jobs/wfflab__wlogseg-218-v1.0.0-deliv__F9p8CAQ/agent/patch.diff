+from .segment import SEGMENT_HEADER_SIZE, segment_length
+
+TRAILER_SIZE = 8
+_TRAILER = struct.Struct("<II")
+
+
+def _read_exact(handle, n: int, context: str = "") -> bytes:
+    """Read exactly *n* bytes from *handle*, raising WSegError on short read."""
+    if n == 0:
+        return b""
+    buf = bytearray()
+    while len(buf) < n:
+        chunk = handle.read(n - len(buf))
+        if not chunk:
+            raise WSegError("truncated",
+                            f"expected {n} bytes{f' for {context}' if context else ''}, "
+                            f"got {len(buf)}")
+        buf.extend(chunk)
+    return bytes(buf)
 
 
 def iter_segments(handle):
-    """产出 (seg_id, payload)。"""
-    data = handle.read()
-    if not isinstance(data, (bytes, bytearray, memoryview)):
-        raise WSegError("structure", f"the stream returned {type(data).__name__}")
-    for item in unpack(bytes(data)):
-        yield item
+    """惰性产出 (seg_id, payload)，不将整个容器读入内存。
+
+    读完所有段后仍会校验尾部索引与尾部校验和；校验失败抛
+    ``WSegError(kind="checksum")``。
+    """
+    # Read header
+    header_data = _read_exact(handle, HEADER_SIZE, "header")
+    _version, _flags, seg_count, index_offset = parse_header(header_data)
+
+    # Running CRC for header + segment area
+    crc_acc = crc32_update(header_data, 0)
+
+    # Read and yield segments one by one
+    for i in range(seg_count):
+        # Read segment header
+        seg_hdr_data = _read_exact(handle, SEGMENT_HEADER_SIZE, f"segment {i} header")
+        seg_id, _seg_flags, _reserved, body_len = struct.unpack_from("<HBBI", seg_hdr_data, 0)
+
+        total_seg_len = segment_length(body_len)
+        pad_len = total_seg_len - SEGMENT_HEADER_SIZE - body_len
+
+        # Read body
+        if body_len > 0:
+            body_data = _read_exact(handle, body_len, f"segment {i} body")
+        else:
+            body_data = b""
+
+        # Read padding
+        if pad_len > 0:
+            pad_data = _read_exact(handle, pad_len, f"segment {i} padding")
+        else:
+            pad_data = b""
+
+        # Update running CRC with this segment's full bytes
+        crc_acc = crc32_update(seg_hdr_data, crc_acc)
+        if body_len > 0:
+            crc_acc = crc32_update(body_data, crc_acc)
+        if pad_len > 0:
+            crc_acc = crc32_update(pad_data, crc_acc)
+
+        yield (seg_id, body_data)
+
+    # Now read the index region
+    index_size = INDEX_ENTRY_SIZE * seg_count
+    if index_size > 0:
+        index_data = _read_exact(handle, index_size, "index")
+    else:
+        index_data = b""
+
+    # Read trailer
+    trailer_data = _read_exact(handle, TRAILER_SIZE, "trailer")
+    index_crc_stored, data_crc_stored = _TRAILER.unpack_from(trailer_data, 0)
+
+    # Verify index CRC
+    if compute_crc(index_data) != index_crc_stored:
+        raise WSegError("checksum", "the index region does not match its checksum")
+
+    # Verify data CRC (header + segment area)
+    if crc_acc != data_crc_stored:
+        raise WSegError("checksum", "the segment region does not match its checksum")
 
 
