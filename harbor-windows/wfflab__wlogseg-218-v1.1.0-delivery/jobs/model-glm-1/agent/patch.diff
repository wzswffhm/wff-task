@@ -0,0 +1,46 @@
+import io, struct, sys
+sys.path.insert(0, '.')
+from wlogseg import pack, unpack, verify, iter_segments, WSegError
+
+sample = open('assets/sample.wlsg','rb').read()
+RECS = [(1, b"alpha"), (2, b""), (300, b"x"*10), (4, bytes(range(256))), (65000, b"z")]
+
+# 1) corrected length formula: header + segments + 8*N index + 8 trailer
+def expected_len(segs):
+    n = 16 + 8 + 8*len(segs)
+    for _, p in segs:
+        n += 8 + len(p) + (-(8+len(p))) % 8
+    return n
+cases = [[], [(1,b'')], [(1,b'a')], [(1,b'a'*7)], [(1,b'a'*8)], [(1,b'a'*9)],
+         [(0,b''),(1,b''),(2,b'x'*13)], [(5,b'hello world')],
+         [(i, bytes([i%256])*i) for i in range(20)], RECS]
+print('1) lengths ok:', all(len(pack(c)) == expected_len(c) for c in cases),
+      [ (len(pack(c)), expected_len(c)) for c in cases if len(pack(c)) != expected_len(c)])
+
+# 2) a *consistent-length* structure contradiction
+t = bytearray(sample); t[8:12] = struct.pack('<I', 336)   # 392 - 40 - 8 - 8 = 336
+try:
+    unpack(bytes(t)); print('2) NO ERROR (bad)')
+except WSegError as e: print('2) index_offset=336 ->', e.kind)
+
+t = bytearray(sample); t[8:12] = struct.pack('<I', 352)
+try:
+    unpack(bytes(t)); print('2) NO ERROR (bad)')
+except WSegError as e: print('2) index_offset=352 ->', e.kind)
+
+# seg_count larger but still fits (structure: region walk mismatch)
+t = bytearray(pack([(1,b'a'),(2,b'bb'),(3,b'ccc')]))
+print('   base len', len(t))
+t2 = bytearray(t); t2[6:8] = struct.pack('<H', 2)
+try:
+    unpack(bytes(t2)); print('2) NO ERROR')
+except WSegError as e: print('2) seg_count=2 (trailing junk) ->', e.kind)
+
+# 3) tamper an actual payload byte
+t = bytearray(sample); t[25] ^= 0xFF   # inside 'alpha'
+try:
+    list(iter_segments(io.BytesIO(bytes(t)))); print('3) stream: NO ERROR (bad)')
+except WSegError as e: print('3) stream payload tamper ->', e.kind)
+try:
+    unpack(bytes(t)); print('3) unpack: NO ERROR (bad)')
+except WSegError as e: print('3) unpack payload tamper ->', e.kind)
