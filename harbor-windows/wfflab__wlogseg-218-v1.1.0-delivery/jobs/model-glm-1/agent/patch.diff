new file mode 100644
index 0000000..9e81e97
--- /dev/null
+++ b/.tmp_probe3.py
@@ -0,0 +1,30 @@
+import struct, zlib
+
+segs = [(1, b"alpha"), (2, b""), (300, b"x"*10), (4, bytes(range(256))), (65000, b"z")]
+
+def pad(n):
+    return (-(8+n)) % 8
+
+body = bytearray()
+entries = []
+cursor = 16
+for sid, p in segs:
+    rec = struct.pack("<HBBI", sid, 0, 0, len(p)) + p + b"\x00"*pad(len(p))
+    entries.append((cursor, len(rec)))
+    body += rec
+    cursor += len(rec)
+
+idxoff = cursor
+hdr = struct.pack("<4sBBHII", b"WLSG", 1, 0, len(segs), idxoff, 0)
+idx = b"".join(struct.pack("<II", o, l) for o, l in entries)
+trailer = struct.pack("<II", zlib.crc32(idx), zlib.crc32(bytes(hdr)+bytes(body)))
+out = bytes(hdr)+bytes(body)+idx+trailer
+
+sample = open('assets/sample.wlsg','rb').read()
+print('built  len', len(out))
+print('sample len', len(sample))
+print('EQUAL:', out == sample)
+
+empty = struct.pack("<4sBBHII", b"WLSG", 1, 0, 0, 16, 0) + b"" + struct.pack("<II", zlib.crc32(b""), zlib.crc32(struct.pack("<4sBBHII", b"WLSG",1,0,0,16,0)))
+se = open('assets/sample_empty.wlsg','rb').read()
+print('EMPTY EQUAL:', empty == se, len(empty), len(se))
diff --git a/.tmp_probe4.py b/.tmp_probe4.py
new file mode 100644
index 0000000..c545658
--- /dev/null
+++ b/.tmp_probe4.py
@@ -0,0 +1,30 @@
+import struct, zlib
+
+# Derived format:
+#  header  : <4sBBHII> magic 'WLSG', version=1, flags, seg_count(u16), index_offset(u32), reserved=0
+#  segment : <HBBI> seg_id(u16), flags(u8), reserved(u8), body_len(u32), payload, pad to 8-byte record alignment
+#  index   : per segment <II> (record_offset, record_length)  -> 8 bytes each
+#  trailer : <II> (crc32(index_region), crc32(header+segment_region))
+segs = [(1, b"alpha"), (2, b""), (300, b"x"*10), (4, bytes(range(256))), (65000, b"z")]
+
+def build(segs):
+    body = bytearray(); entries = []; cursor = 16
+    for sid, p in segs:
+        pad = (-(8 + len(p))) % 8
+        rec = struct.pack("<HBBI", sid, 0, 0, len(p)) + p + b"\x00"*pad
+        entries.append((cursor, len(rec))); body += rec; cursor += len(rec)
+    hdr = struct.pack("<4sBBHII", b"WLSG", 1, 0, len(segs), cursor, 0)
+    idx = b"".join(struct.pack("<II", o, l) for o, l in entries)
+    tr = struct.pack("<II", zlib.crc32(idx), zlib.crc32(bytes(hdr)+bytes(body)))
+    return bytes(hdr)+bytes(body)+idx+tr
+
+sample = open('assets/sample.wlsg','rb').read()
+empty  = open('assets/sample_empty.wlsg','rb').read()
+print('sample roundtrip:', build(segs) == sample)
+print('empty roundtrip :', build([]) == empty)
+print('crc32("123456789") = %08x (standard CRC-32 check value = cbf43926)' % zlib.crc32(b"123456789"))
+# alignment: verify every record length in sample index is a multiple of 8
+idxoff = int.from_bytes(sample[8:12],'little')
+cnt = int.from_bytes(sample[6:8],'little')
+print('record lengths:', [int.from_bytes(sample[idxoff+8*i+4:idxoff+8*i+8],'little') for i in range(cnt)])
+print('all multiples of 8:', all(int.from_bytes(sample[idxoff+8*i+4:idxoff+8*i+8],'little') % 8 == 0 for i in range(cnt)))
