+import zlib, binascii
+
+d = open('assets/sample.wlsg','rb').read()
+de = open('assets/sample_empty.wlsg','rb').read()
+
+def hdr(blob):
+    print('  magic', blob[:4], 'ver', blob[4], 'flags', blob[5],
+          'count', int.from_bytes(blob[6:8],'little'),
+          'idxoff', int.from_bytes(blob[8:12],'little'),
+          'reserved', blob[12:16].hex(), 'rle:', int.from_bytes(blob[12:16],'little'))
+
+print('sample:'); hdr(d)
+print('empty:'); hdr(de)
+
+# trailer candidates
+print()
+print('sample tail bytes', d[-16:].hex(' '))
+print('empty tail bytes', de[-16:].hex(' '))
+
+def try_variants(name, prefix, body, expected):
+    cands = {}
+    cands['crc32'] = zlib.crc32(prefix+body) & 0xffffffff
+    cands['crc32_no_final'] = (~zlib.crc32(prefix+body)) & 0xffffffff
+    cands['crc32_le_swapped'] = int.from_bytes((zlib.crc32(prefix+body)&0xffffffff).to_bytes(4,'big'),'little')
+    # big-endian interpretation of the 4 bytes
+    cands['crc32_be_bytes'] = int.from_bytes((zlib.crc32(prefix+body)&0xffffffff).to_bytes(4,'little'),'big')
+    cands['adler32'] = zlib.adler32(prefix+body) & 0xffffffff
+    # crc32 with bytes reversed
+    cands['crc32_revdata'] = zlib.crc32((prefix+body)[::-1]) & 0xffffffff
+    cands['crc32c?'] = None
+    hits = [k for k,v in cands.items() if v == expected]
+    print(name, 'expected %08x' % expected, 'hits:', hits, {k:('%08x'%v if v is not None else None) for k,v in cands.items()})
+
+try_variants('empty', de[:16], b'', int.from_bytes(de[20:24],'little'))
