index 0000000..8a36744
--- /dev/null
+++ b/.tmp_accept.py
@@ -0,0 +1,179 @@
+import io, sys, struct, zlib, itertools
+sys.path.insert(0, '.')
+import wlogseg
+from wlogseg import pack, unpack, verify, iter_segments, read_all, compute_crc, crc32_update, WSegError
+
+fails = []
+def check(name, cond):
+    print(('PASS ' if cond else 'FAIL ') + name)
+    if not cond: fails.append(name)
+
+sample = open('assets/sample.wlsg','rb').read()
+empty = open('assets/sample_empty.wlsg','rb').read()
+RECS = [(1, b"alpha"), (2, b""), (300, b"x"*10), (4, bytes(range(256))), (65000, b"z")]
+
+def expect_error(fn, kind):
+    try:
+        fn()
+    except WSegError as e:
+        return e.kind == kind
+    except Exception as e:
+        print('     unexpected', type(e).__name__, e)
+        return False
+    return False
+
+print('=== A. sample compat ===')
+check('verify(sample)', verify(sample) is True)
+check('pack(unpack(sample))==sample', pack(unpack(sample)) == sample)
+check('verify(empty)', verify(empty) is True)
+check('pack(unpack(empty))==empty', pack(unpack(empty)) == empty)
+check('verify(memoryview)', verify(memoryview(sample)) is True)
+check('unpack(bytearray) roundtrip', pack(unpack(bytearray(sample))) == sample)
+
+print('=== B. segment semantics ===')
+check('unpack order/ids', unpack(sample) == RECS)
+check('payload types are bytes', all(isinstance(p, bytes) for _, p in unpack(sample)))
+check('empty payload ok', unpack(pack([(1, b'')])) == [(1, b'')])
+check('seg_id 0 and 65535 ok', unpack(pack([(0,b'a'),(65535,b'b')])) == [(0,b'a'),(65535,b'b')])
+check('seg_id -1 raises structure', expect_error(lambda: pack([(-1, b'a')]), 'structure'))
+check('seg_id 65536 raises structure', expect_error(lambda: pack([(65536, b'a')]), 'structure'))
+check('str payload raises structure', expect_error(lambda: pack([(1, 'x')]), 'structure'))
+check('None payload raises structure', expect_error(lambda: pack([(1, None)]), 'structure'))
+check('bool seg_id raises structure', expect_error(lambda: pack([(True, b'a')]), 'structure'))
+check('huge seg_id raises structure', expect_error(lambda: pack([(10**9, b'a')]), 'structure'))
+check('bytearray payload accepted', unpack(pack([(1, bytearray(b'ab'))])) == [(1, b'ab')])
+check('memoryview payload accepted', unpack(pack([(1, memoryview(b'ab'))])) == [(1, b'ab')])
+check('genexp input accepted', unpack(pack((i, b'') for i in range(3))) == [(0,b''),(1,b''),(2,b'')])
+
+print('=== C. layout & index ===')
+def expected_len(segs):
+    n = 16 + 8
+    for _, p in segs:
+        n += 8 + len(p) + (-(8+len(p))) % 8
+    return n
+cases = [[], [(1,b'')], [(1,b'a')], [(1,b'a'*7)], [(1,b'a'*8)], [(1,b'a'*9)],
+         [(0,b''),(1,b''),(2,b'x'*13)], [(5,b'hello world')],
+         [(i, bytes([i%256])*i) for i in range(20)], RECS]
+check('container lengths match real layout', all(len(pack(c)) == expected_len(c) for c in cases))
+check('sample length matches', len(pack(RECS)) == len(sample) == 392)
+b = pack([(1,b'abc'),(2,b'defgh')])
+idx_off = int.from_bytes(b[8:12],'little')
+ent0 = struct.unpack_from('<II', b, idx_off); ent1 = struct.unpack_from('<II', b, idx_off+8)
+check('index entry 0 == (16, 16)', ent0 == (16, 16))
+check('index entry 1 == (32, 16)', ent1 == (32, 16))
+
+print('=== D. checksum ===')
+check('crc32 standard check value', compute_crc(b'123456789') == 0xcbf43926)
+check('compute_crc == zlib.crc32', compute_crc(bytes(range(256))) == zlib.crc32(bytes(range(256))))
+check('crc32_update assoc', crc32_update(b'ab', crc32_update(b'c')) == compute_crc(b'cab'))
+check('crc32_update(b"") identity', crc32_update(b'', 0x11223344) == 0x11223344)
+check('compute_crc(b"")==0', compute_crc(b'') == 0)
+for pos, label in [(0,'magic'),(4,'version'),(16,'seg header'),(20,'payload'),(22,'padding')]:
+    t = bytearray(sample); t[pos] ^= 0xFF
+    check('tamper @%s rejected' % label, verify(bytes(t)) is False)
+for pos in [0, 4, 16, 20, 22, 100, 344, 350, 384]:
+    t = bytearray(sample); t[pos] ^= 0x01
+    check('tamper byte %d rejected' % pos, verify(bytes(t)) is False)
+check('trailer data-crc covers header+segs',
+      int.from_bytes(sample[-4:],'little') == zlib.crc32(sample[:344]))
+check('trailer index-crc covers index',
+      int.from_bytes(sample[-8:-4],'little') == zlib.crc32(sample[344:384]))
+
+print('=== E. error classification ===')
+check('bad magic -> magic', expect_error(lambda: unpack(b'XXXX'+sample[4:]), 'magic'))
+check('bad version 2 -> version', expect_error(lambda: unpack(sample[:4]+bytes([2])+sample[5:]), 'version'))
+check('version 0 -> version', expect_error(lambda: unpack(sample[:4]+b'\x00'+sample[5:]), 'version'))
+check('version 255 -> version', expect_error(lambda: unpack(sample[:4]+b'\xff'+sample[5:]), 'version'))
+for n in [0,1,15,16,23]:
+    check('len %d -> truncated' % n, expect_error(lambda: unpack(sample[:n]), 'truncated'))
+check('cut mid-segment -> truncated', expect_error(lambda: unpack(sample[:100]), 'truncated'))
+check('cut before trailer -> truncated', expect_error(lambda: unpack(sample[:-1]), 'truncated'))
+check('cut in index -> truncated', expect_error(lambda: unpack(sample[:360]), 'truncated'))
+t = bytearray(pack([(1,b'a')])); t[6:8] = struct.pack('<H', 5)
+check('seg_count/region mismatch -> structure', expect_error(lambda: unpack(bytes(t)), 'structure'))
+t = bytearray(pack([(1,b'a'),(2,b'b')])); t[8:12] = struct.pack('<I', 24)
+check('index_offset wrong -> structure', expect_error(lambda: unpack(bytes(t)), 'structure'))
+t = bytearray(pack([(1,b'a')])); t[8:12] = struct.pack('<I', 8)
+check('index_offset<16 -> structure', expect_error(lambda: unpack(bytes(t)), 'structure'))
+t = bytearray(sample); t[-1] ^= 0xFF
+check('trailer corruption -> checksum', expect_error(lambda: unpack(bytes(t)), 'checksum'))
+t = bytearray(sample); t[-5] ^= 0xFF
+check('index-crc corruption -> checksum', expect_error(lambda: unpack(bytes(t)), 'checksum'))
+weird = [b'', b'W', b'WLSG', b'WLSG\x01', b'\x00'*24, b'WLSG'+b'\x01'*100, sample[:3],
+         b'not a container at all', sample[:-3], sample+b'\x00', b'\xff'*392, None, 123, [], {}]
+ok = True
+for w in weird:
+    try: verify(w)
+    except Exception: ok = False
+check('verify never raises on %d weird inputs' % len(weird), ok)
+check('verify(None) is False', verify(None) is False)
+check('verify(123) is False', verify(123) is False)
+check('unpack(str) raises structure', expect_error(lambda: unpack('abc'), 'structure'))
+
+print('=== F. streaming ===')
+class StrictReader(io.RawIOBase):
+    def __init__(self, data): self._d=data; self._p=0
+    def read(self, n=-1):
+        if not isinstance(n, int) or n <= 0:
+            raise AssertionError('illegal read(%r)' % (n,))
+        c = self._d[self._p:self._p+n]; self._p += len(c); return c
+    def seek(self, off, whence=0):
+        if whence==2: self._p = len(self._d)+off
+        elif whence==1: self._p += off
+        else: self._p = off
+        return self._p
+    def tell(self): return self._p
+    def readlines(self, *a): raise AssertionError('readlines called')
+
+sr = StrictReader(sample)
+got = list(iter_segments(sr))
+check('strict reader yields all segs', got == RECS)
+
+class ProbingReader(io.RawIOBase):
+    def __init__(self, data): self._d=data; self._p=0; self.reads=[]
+    def read(self, n=-1):
+        if not isinstance(n,int) or n<=0: raise AssertionError('illegal read')
+        self.reads.append(n)
+        c=self._d[self._p:self._p+n]; self._p+=len(c); return c
+    def seek(self, off, whence=0):
+        if whence==2: self._p=len(self._d)+off
+        elif whence==1: self._p+=off
+        else: self._p=off
+        return self._p
+    def tell(self): return self._p
+
+pr = ProbingReader(sample)
+it = iter_segments(pr)
+first = next(it)
+check('lazy: first segment correct', first == (1, b'alpha'))
+maxpos = max(pr.reads) if pr.reads else 0
+check('lazy: reads are bounded (max n=%d)' % maxpos, maxpos <= 64)
+
+big = [(i, b'y'*4096) for i in range(2000)]
+blob = pack(big)
+pr2 = ProbingReader(blob)
+it2 = iter_segments(pr2)
+seen = [next(it2) for _ in range(3)]
+check('lazy: huge container partial read ok', seen == big[:3])
+check('lazy: huge container did not slurp (max read %d)' % max(pr2.reads), max(pr2.reads) <= 8192)
+check('lazy: huge container full read ok', read_all(io.BytesIO(blob)) == big)
+check('stream empty container', read_all(io.BytesIO(empty)) == [])
+check('stream truncated -> truncated', expect_error(lambda: list(iter_segments(io.BytesIO(sample[:-1]))), 'truncated'))
+t = bytearray(sample); t[20] ^= 0xFF
+check('stream tampered payload -> checksum', expect_error(lambda: list(iter_segments(io.BytesIO(bytes(t)))), 'checksum'))
+t = bytearray(sample); t[-1] ^= 0xFF
+check('stream tampered trailer -> checksum', expect_error(lambda: list(iter_segments(io.BytesIO(bytes(t)))), 'checksum'))
+t = bytearray(sample); t[350] ^= 0xFF
+try:
+    list(iter_segments(io.BytesIO(bytes(t)))); t_ok = False
+except WSegError as e: t_ok = e.kind in ('checksum','structure')
+check('stream tampered index rejected', t_ok)
+it3 = iter_segments(io.BytesIO(sample))
+check('partial consumption works', next(it3) == (1, b'alpha'))
+check('read_all == unpack', read_all(io.BytesIO(sample)) == unpack(sample))
+with open('assets/sample.wlsg','rb') as f:
+    check('real file object', list(iter_segments(f)) == RECS)
+
+print()
+print('FAILURES: %d' % len(fails))
+for f in fails: print('  -', f)
