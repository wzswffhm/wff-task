+for i in range(5):
+    start = struct.unpack_from('<I', data, idx_off + i*8)[0]
+    end = struct.unpack_from('<I', data, idx_off + i*8 + 4)[0]
+    size = end - start if end > start else '?'
+    print(f'  Idx[{i}]: start={start}, end={end}, size={size}')
+
+# Or (start_offset_of_payload, body_len)?
+print("\n=== Maybe (payload_offset, body_len)? ===")
+for i in range(5):
+    pay_off = struct.unpack_from('<I', data, idx_off + i*8)[0]
+    bl = struct.unpack_from('<I', data, idx_off + i*8 + 4)[0]
+    print(f'  Idx[{i}]: payload_at={pay_off}, body_len={bl}')
+
+# None of these make clean sense. Let me go back to basics.
+# Let me check: does the current code's pack() produce something that matches the sample structure?
+print("\n=== Current code pack output for same segments ===")
+# First, what ARE the actual segments in the sample?
+# From our parsing with <HBBI:
+# Seg0: id=1, payload=b'alpha' (5 bytes)
+# Seg1: id=2, payload=b'' (0 bytes)
+# Seg2: id=300, payload=b'xxxxxxxxxx' (10 bytes)
+# Seg3: id=0, payload=data[68:72] = \x00\x01\x00\x00 (4 bytes) -- suspicious
+# Seg4: broken
+
+# Let me try a completely different segment header format.
+# What if it's actually: <IHH = body_len(I), seg_id(H), flags(H)?
+print("\n=== Trying <IHH segment header ===")
+pos = 16
+for i in range(5):
+    bl = struct.unpack_from('<I', data, pos)[0]
+    sid = struct.unpack_from('<H', data, pos+4)[0]
+    fl = struct.unpack_from('<H', data, pos+6)[0]
+    pad = (-(8+bl)) % 4
+    total = 8 + bl + pad
+    payload = data[pos+8:pos+8+min(bl,30)]
+    print(f'Seg{i}: off={pos} body_len={bl} id={sid} flags={fl} total={total}')
+    if bl <= 30:
+        print(f'  payload: {payload}')
+    pos += total
+    if pos > 400:
+        print('  STOPPING - went too far')
+        break
+print(f'Final pos: {pos}')
+
+# Try <HHI: seg_id(H), flags(H), body_len(I)
+print("\n=== Trying <HHI segment header ===")
+pos = 16
+for i in range(5):
+    sid = struct.unpack_from('<H', data, pos)[0]
+    fl = struct.unpack_from('<H', data, pos+2)[0]
+    bl = struct.unpack_from('<I', data, pos+4)[0]
+    pad = (-(8+bl)) % 4
+    total = 8 + bl + pad
+    payload = data[pos+8:pos+8+min(bl,30)]
+    print(f'Seg{i}: off={pos} id={sid} flags={fl} body_len={bl} total={total}')
+    if bl <= 30:
+        print(f'  payload: {payload}')
+    pos += total
+    if pos > 400:
+        print('  STOPPING')
+        break
+print(f'Final pos: {pos}')
