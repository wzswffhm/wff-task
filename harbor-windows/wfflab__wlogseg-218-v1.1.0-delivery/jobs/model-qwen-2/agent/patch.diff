+            ec1 = struct.unpack_from('<I', edata, e_io)[0]
+            ec2 = struct.unpack_from('<I', edata, e_io+4)[0]
+            print(f'Empty trailer CRC1 = 0x{ec1:08x}')
+            print(f'Empty trailer CRC2 = 0x{ec2:08x}')
+            
+            # What data would these CRCs cover?
+            e_header = edata[:16]
+            e_all_before = edata[:e_io]
+            print(f'crc32(empty header): 0x{zlib.crc32(e_header) & 0xFFFFFFFF:08x}')
+            print(f'crc32(header)^FF: 0x{(zlib.crc32(e_header) ^ 0xFFFFFFFF) & 0xFFFFFFFF:08x}')
+            print(f'crc32(all_before_trailer): 0x{zlib.crc32(e_all_before) & 0xFFFFFFFF:08x}')
+            print(f'crc32(all_before)^FF: 0x{(zlib.crc32(e_all_before) ^ 0xFFFFFFFF) & 0xFFFFFFFF:08x}')
diff --git a/_analyze_tmp.py b/_analyze_tmp.py
new file mode 100644
index 0000000..4e3ffb5
--- /dev/null
+++ b/_analyze_tmp.py
@@ -0,0 +1,169 @@
+import struct, zlib
+
+data = open('assets/sample.wlsg', 'rb').read()
+print(f'Total length: {len(data)}')
+
+# Header
+magic = data[0:4]
+ver = data[4]
+fl = data[5]
+sc = struct.unpack_from('<H', data, 6)[0]
+io_off = struct.unpack_from('<I', data, 8)[0]
+reserved = struct.unpack_from('<I', data, 12)[0]
+print(f'Magic: {magic}')
+print(f'Version: {ver}, Flags: {fl}')
+print(f'Seg count: {sc}')
+print(f'Index offset: {io_off}')
+print(f'Reserved: {reserved}')
+
+# Parse segments manually
+pos = 16
+seg_info = []
+for i in range(sc):
+    if pos + 8 > len(data):
+        print(f'ERROR: not enough data for seg header at {pos}')
+        break
+    sid = struct.unpack_from('<H', data, pos)[0]
+    flag = data[pos+2]
+    rv = data[pos+3]
+    bl = struct.unpack_from('<I', data, pos+4)[0]
+    payload = data[pos+8:pos+8+bl]
+    pad = (-(8 + bl)) % 4
+    total = 8 + bl + pad
+    seg_info.append((pos, sid, flag, rv, bl, payload, total))
+    print(f'Seg{i}: off={pos} id={sid} fl={flag} rv={rv} body_len={bl} total={total} payload_preview={payload[:30]}')
+    pos += total
+
+print(f'\nAfter all segments: pos={pos}')
+print(f'Expected index offset: {io_off}')
+print(f'Match: {pos == io_off}')
+
+# Index entries
+print('\nIndex entries:')
+idx_pos = io_off
+index_offsets = []
+for i in range(sc):
+    off = struct.unpack_from('<I', data, idx_pos)[0]
+    index_offsets.append(off)
+    print(f'  Idx[{i}] = {off}')
+    idx_pos += 4
+
+# Compare index offsets with actual segment offsets
+print('\nIndex vs actual segment offsets:')
+for i in range(sc):
+    actual = seg_info[i][0]
+    indexed = index_offsets[i]
+    match = 'OK' if actual == indexed else 'MISMATCH'
+    print(f'  Seg{i}: actual={actual} indexed={indexed} {match}')
+
+# Trailer
+tr_start = idx_pos
+print(f'\nTrailer starts at: {tr_start}')
+print(f'File ends at: {len(data)}')
+print(f'Trailer bytes remaining: {len(data) - tr_start}')
+
+if tr_start + 8 <= len(data):
+    c1 = struct.unpack_from('<I', data, tr_start)[0]
+    c2 = struct.unpack_from('<I', data, tr_start+4)[0]
+    print(f'CRC1 = 0x{c1:08x} ({c1})')
+    print(f'CRC2 = 0x{c2:08x} ({c2})')
+
+# Try various CRC computations to figure out the algorithm
+print('\n--- CRC analysis ---')
+
+# Standard zlib crc32
+header_data = data[:16]
+seg_region = data[16:io_off]
+index_region = data[io_off:tr_start]
+all_before_trailer = data[:tr_start]
+
+print(f'Header region: {len(header_data)} bytes')
+print(f'Segment region: {len(seg_region)} bytes')
+print(f'Index region: {len(index_region)} bytes')
+
+# Standard CRC32 variants
+crc_std_header = zlib.crc32(header_data) & 0xFFFFFFFF
+crc_std_seg = zlib.crc32(seg_region) & 0xFFFFFFFF
+crc_std_idx = zlib.crc32(index_region) & 0xFFFFFFFF
+crc_std_all = zlib.crc32(all_before_trailer) & 0xFFFFFFFF
+crc_std_hdr_seg = zlib.crc32(header_data + seg_region) & 0xFFFFFFFF
+
+print(f'std crc32(header):       0x{crc_std_header:08x}')
+print(f'std crc32(seg_region):   0x{crc_std_seg:08x}')
+print(f'std crc32(index_region): 0x{crc_std_idx:08x}')
+print(f'std crc32(hdr+seg):      0x{crc_std_hdr_seg:08x}')
+print(f'std crc32(all_before):   0x{crc_std_all:08x}')
+
+# XOR with 0xFFFFFFFF
+print(f'std crc32(header)^FF:       0x{(crc_std_header^0xFFFFFFFF)&0xFFFFFFFF:08x}')
+print(f'std crc32(seg_region)^FF:   0x{(crc_std_seg^0xFFFFFFFF)&0xFFFFFFFF:08x}')
+print(f'std crc32(index_region)^FF: 0x{(crc_std_idx^0xFFFFFFFF)&0xFFFFFFFF:08x}')
+print(f'std crc32(hdr+seg)^FF:      0x{(crc_std_hdr_seg^0xFFFFFFFF)&0xFFFFFFFF:08x}')
+print(f'std crc32(all_before)^FF:   0x{(crc_std_all^0xFFFFFFFF)&0xFFFFFFFF:08x}')
+
+# Current implementation's compute_crc
+def current_crc32_update(data_bytes, value=0):
+    return (zlib.crc32(bytes(data_bytes), value) ^ 0xFFFFFFFF) & 0xFFFFFFFF
+
+def current_compute_crc(data_bytes):
+    return current_crc32_update(data_bytes, 0)
+
+print(f'\ncurrent compute_crc(header):       0x{current_compute_crc(header_data):08x}')
+print(f'current compute_crc(seg_region):   0x{current_compute_crc(seg_region):08x}')
+print(f'current compute_crc(index_region): 0x{current_compute_crc(index_region):08x}')
+print(f'current compute_crc(hdr+seg):      0x{current_compute_crc(header_data+seg_region):08x}')
+print(f'current compute_crc(all_before):   0x{current_compute_crc(all_before_trailer):08x}')
+
+# Check what the trailer CRC values are
+if tr_start + 8 <= len(data):
+    c1 = struct.unpack_from('<I', data, tr_start)[0]
+    c2 = struct.unpack_from('<I', data, tr_start+4)[0]
+    print(f'\nTrailer CRC1 = 0x{c1:08x}')
+    print(f'Trailer CRC2 = 0x{c2:08x}')
+    
+    # What matches CRC1?
+    print('\nWhat matches CRC1?')
+    if c1 == crc_std_idx: print('  -> std crc32(index_region)')
+    if c1 == (crc_std_idx^0xFFFFFFFF)&0xFFFFFFFF: print('  -> std crc32(index_region)^FF')
+    if c1 == current_compute_crc(index_region): print('  -> current_compute_crc(index_region)')
+    
+    print('What matches CRC2?')
+    if c2 == crc_std_hdr_seg: print('  -> std crc32(hdr+seg)')
+    if c2 == (crc_std_hdr_seg^0xFFFFFFFF)&0xFFFFFFFF: print('  -> std crc32(hdr+seg)^FF')
+    if c2 == current_compute_crc(header_data+seg_region): print('  -> current_compute_crc(hdr+seg)')
+    if c2 == crc_std_all: print('  -> std crc32(all_before_trailer)')
+    if c2 == current_compute_crc(all_before_trailer): print('  -> current_compute_crc(all_before_trailer)')
+
+# Let's also look at how the current code computes checksums in pack()
+# In pack(), it does:
+#   checksummed = header + (for each seg: encoded[:SEGMENT_HEADER_SIZE + len(payload)])
+# That means it excludes padding from checksum computation!
+print('\n--- Simulating current pack checksum logic ---')
+checksummed = bytearray(data[:16])  # header
+for si in seg_info:
+    off, sid, flag, rv, bl, payload, total = si
+    # The segment as stored in file includes padding
+    seg_bytes = data[off:off+total]
+    # Current code only checksums header + body (no padding)
+    checksummed += seg_bytes[:8+bl]
+    
+cc = current_compute_crc(bytes(checksummed))
+print(f'current checksum (hdr + seg_hdr+body no pad): 0x{cc:08x}')
+if tr_start + 8 <= len(data):
+    c2 = struct.unpack_from('<I', data, tr_start+4)[0]
+    print(f'Trailer CRC2:                                  0x{c2:08x}')
+    print(f'Match: {cc == c2}')
+
+# What about just header + full segment region (including padding)?
+cc2 = current_compute_crc(data[:io_off])
+print(f'current checksum (hdr + full seg region):      0x{cc2:08x}')
+if tr_start + 8 <= len(data):
+    c2 = struct.unpack_from('<I', data, tr_start+4)[0]
+    print(f'Match: {cc2 == c2}')
+
+# Standard crc32 of header + full segment region
+cc3 = zlib.crc32(data[:io_off]) & 0xFFFFFFFF
+print(f'std crc32(hdr + full seg region):              0x{cc3:08x}')
+if tr_start + 8 <= len(data):
+    c2 = struct.unpack_from('<I', data, tr_start+4)[0]
+    print(f'Match: {cc3 == c2}')
