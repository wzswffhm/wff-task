@@ -0,0 +1,94 @@
+"""Test error classification."""
+import io
+from wlogseg import pack, unpack, verify, WSegError, iter_segments
+
+# Test 1: Bad magic
+print("=== Bad magic ===")
+blob = bytearray(pack([(1, b"a")]))
+blob[0:4] = b"XXXX"
+try:
+    unpack(bytes(blob))
+except WSegError as e:
+    print(f"  kind={e.kind} (expected: magic)")
+assert not verify(bytes(blob))
+
+# Test 2: Bad version
+print("=== Bad version ===")
+blob = bytearray(pack([(1, b"a")]))
+blob[4] = 99
+try:
+    unpack(bytes(blob))
+except WSegError as e:
+    print(f"  kind={e.kind} (expected: version)")
+assert not verify(bytes(blob))
+
+# Test 3: Truncated - too short
+print("=== Truncated (too short) ===")
+blob = pack([(1, b"a")])[:10]
+try:
+    unpack(blob)
+except WSegError as e:
+    print(f"  kind={e.kind} (expected: truncated)")
+assert not verify(blob)
+
+# Test 4: Truncated - segment payload cut off
+print("=== Truncated (segment payload cut) ===")
+blob = bytearray(pack([(1, b"hello world")]))
+# Cut off some payload bytes
+truncated = bytes(blob[:20])
+try:
+    unpack(truncated)
+except WSegError as e:
+    print(f"  kind={e.kind} (expected: truncated or structure)")
+assert not verify(truncated)
+
+# Test 5: Checksum mismatch - tampered content
+print("=== Checksum (tampered content) ===")
+blob = bytearray(pack([(1, b"alpha")]))
+# Tamper with payload
+blob[17] = 0xFF
+try:
+    unpack(bytes(blob))
+except WSegError as e:
+    print(f"  kind={e.kind} (expected: checksum)")
+assert not verify(bytes(blob))
+
+# Test 6: Structure - index offset beyond container
+print("=== Structure (bad index offset) ===")
+blob = bytearray(pack([(1, b"a")]))
+# Set index_offset to something huge
+import struct
+struct.pack_into('<I', blob, 8, 99999)
+try:
+    unpack(bytes(blob))
+except WSegError as e:
+    print(f"  kind={e.kind} (expected: structure)")
+assert not verify(bytes(blob))
+
+# Test 7: Invalid seg_id in pack
+print("=== Pack with invalid seg_id ===")
+try:
+    pack([(70000, b"x")])
+except WSegError as e:
+    print(f"  kind={e.kind} (expected: structure)")
+
+# Test 8: Non-bytes payload in pack
+print("=== Pack with non-bytes payload ===")
+try:
+    pack([(1, "string")])
+except WSegError as e:
+    print(f"  kind={e.kind} (expected: structure)")
+
+# Test 9: verify never raises
+print("=== verify never raises ===")
+for bad_input in [b"", b"x", b"WLSG", b"WLSG\x01\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00", None]:
+    try:
+        if bad_input is None:
+            result = verify(bad_input)
+        else:
+            result = verify(bad_input)
+        print(f"  verify({bad_input!r:.30}) = {result}")
+    except Exception as e:
+        print(f"  ERROR: verify raised {type(e).__name__}: {e}")
+
+print("\nAll error tests passed!")
