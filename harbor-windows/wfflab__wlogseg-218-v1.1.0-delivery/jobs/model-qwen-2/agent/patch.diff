+    payload = data[pos+8:pos+8+bl]
+    print(f'Seg{i}: off={pos} id={sid} body_len={bl} raw={raw_size} padded={padded}')
+    if bl <= 30:
+        print(f'  payload: {payload}')
+    pos += padded
+
+print(f'Final pos: {pos}, expected index_offset: 344')
+
+# That doesn't match either. Let me try yet another approach.
