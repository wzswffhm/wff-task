new file mode 100644
index 0000000..3fcd54a
--- /dev/null
+++ b/_test_stream.py
@@ -0,0 +1,41 @@
+"""Test that iter_segments doesn't use read() without arguments."""
+import io
+from wlogseg import iter_segments, pack, unpack, WSegError
+
+class TrackingBytesIO(io.BytesIO):
+    """A BytesIO that tracks read calls and rejects read() / read(-1)."""
+    def __init__(self, data):
+        super().__init__(data)
+        self.read_calls = []
+    
+    def read(self, n=-1):
+        if n is None or n < 0:
+            raise RuntimeError(f"iter_segments called read({n}) - should use read(n) with positive n!")
+        self.read_calls.append(n)
+        return super().read(n)
+
+# Test with sample file
+data = open('assets/sample.wlsg', 'rb').read()
+tracker = TrackingBytesIO(data)
+segs = list(iter_segments(tracker))
+expected = unpack(data)
+print(f"Segments match: {segs == expected}")
+print(f"Read calls: {tracker.read_calls}")
+print(f"Max read size: {max(tracker.read_calls)}")
+print(f"All reads are bounded: {all(n > 0 for n in tracker.read_calls)}")
+
+# Test with empty sample
+edata = open('assets/sample_empty.wlsg', 'rb').read()
+tracker2 = TrackingBytesIO(edata)
+segs2 = list(iter_segments(tracker2))
+print(f"\nEmpty segments match: {segs2 == []}")
+print(f"Read calls: {tracker2.read_calls}")
+
+# Test with our own packed data
+pdata = pack([(1, b"hello"), (2, b"world")])
+tracker3 = TrackingBytesIO(pdata)
+segs3 = list(iter_segments(tracker3))
+print(f"\nPacked segments match: {segs3 == [(1, b'hello'), (2, b'world')]}")
+print(f"Read calls: {tracker3.read_calls}")
+
+print("\nStream tests passed!")
