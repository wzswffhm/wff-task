+# Trailer: 384..391 (8 bytes)
+
+print("=== Hypothesis: 8-byte index entries (offset, body_len) ===")
+idx_off = 344
+for i in range(5):
+    seg_offset = struct.unpack_from('<I', data, idx_off + i*8)[0]
+    body_len = struct.unpack_from('<I', data, idx_off + i*8 + 4)[0]
+    print(f'  Idx[{i}]: seg_offset={seg_offset}, body_len={body_len}')
+
+# Results:
+# Idx[0]: seg_offset=16, body_len=16
+# Idx[1]: seg_offset=32, body_len=8
+# Idx[2]: seg_offset=40, body_len=24
+# Idx[3]: seg_offset=64, body_len=264
+# Idx[4]: seg_offset=328, body_len=16
+
+# Now let's verify by reading segments at those offsets with those body_lens
+print("\n=== Reading segments using index info ===")
+for i in range(5):
+    seg_offset = struct.unpack_from('<I', data, idx_off + i*8)[0]
+    body_len = struct.unpack_from('<I', data, idx_off + i*8 + 4)[0]
+    
+    # Read segment header at seg_offset
+    sid = struct.unpack_from('<H', data, seg_offset)[0]
+    fl = data[seg_offset+2]
+    rv = data[seg_offset+3]
+    hdr_body_len = struct.unpack_from('<I', data, seg_offset+4)[0]
+    
+    payload = data[seg_offset+8:seg_offset+8+body_len]
+    print(f'Seg{i}: file_off={seg_offset} seg_id={sid} fl={fl} rv={rv} hdr_bodylen={hdr_body_len} idx_bodylen={body_len}')
+    if body_len <= 40:
+        print(f'  payload: {payload}')
+    else:
+        print(f'  payload(first 20): {payload[:20]}...')
+        print(f'  payload(last 10): ...{payload[-10:]}')
+
+# Hmm, if idx_bodylen includes the header, then actual payload = body_len - 8
+# Let me try that
+print("\n=== Maybe body_len in index includes header? (payload = body_len - 8) ===")
+for i in range(5):
+    seg_offset = struct.unpack_from('<I', data, idx_off + i*8)[0]
+    total_size = struct.unpack_from('<I', data, idx_off + i*8 + 4)[0]
+    payload_len = total_size - 8
+    
+    sid = struct.unpack_from('<H', data, seg_offset)[0]
+    fl = data[seg_offset+2]
+    rv = data[seg_offset+3]
+    hdr_body_len = struct.unpack_from('<I', data, seg_offset+4)[0]
+    
+    payload = data[seg_offset+8:seg_offset+8+payload_len]
+    print(f'Seg{i}: off={seg_offset} id={sid} total={total_size} pay_len={payload_len} hdr_blen={hdr_body_len}')
+    if payload_len <= 40:
+        print(f'  payload: {payload}')
+    else:
+        print(f'  payload(first 20): {payload[:20]}...')
+
+# Another idea: maybe the index stores (offset, total_segment_size) where total includes header + payload + padding
+# Seg0: offset=16, total=16 -> 8 header + 5 payload + 3 pad = 16 ✓
+# Seg1: offset=32, total=8 -> 8 header + 0 payload = 8 ✓
+# Seg2: offset=40, total=24 -> 8 header + ? payload... 24-8=16 payload? But hdr says body_len=10
+#   Unless body_len=10 and padding to some other boundary?
+#   Actually 8+10=18, pad to 4 = 20, not 24.
+#   Pad to 8 = 24! So maybe ALIGNMENT=8?
+
+print("\n=== Trying ALIGNMENT=8 ===")
+def pad8(n):
+    return (-n) % 8
+
+pos = 16
+for i in range(5):
+    sid = struct.unpack_from('<H', data, pos)[0]
+    fl = data[pos+2]
+    rv = data[pos+3]
+    bl = struct.unpack_from('<I', data, pos+4)[0]
