+"""wsync 在真实 Windows 文件系统语义下的镜像同步测试。
+
+这些用例依赖 Windows 特有的文件系统语义（只读属性、文件名大小写不敏感、
+打开句柄造成的共享冲突、同名文件/目录不能共存、目录的只读属性），
+必须在真实 Windows Runtime 中执行。
+"""
+
+from __future__ import annotations
+
+import os
+import stat
+from pathlib import Path
+
+import pytest
+
+from wsync import sync_tree
+
+pytestmark = pytest.mark.skipif(
+    os.name != "nt",
+    reason="依赖 Windows 文件系统语义（只读属性 / 大小写不敏感 / 共享冲突 / 类型冲突）",
+)
+
+
+# ------------------------------------------------------------------ 工具
+
+def write(path, text, mtime=None):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8")
+    if mtime is not None:
+        os.utime(path, (mtime, mtime))
+    return path
+
+
+def read(path):
+    return Path(path).read_text(encoding="utf-8")
+
+
+def set_readonly(path):
+    """给文件或目录打上只读属性。"""
+    os.chmod(path, os.stat(path).st_mode & ~stat.S_IWRITE)
+
+
+def files_under(root):
+    root = Path(root)
+    found = []
+    for dirpath, _dirnames, filenames in os.walk(root):
+        for name in filenames:
+            rel = os.path.relpath(os.path.join(dirpath, name), root)
+            found.append(rel.replace(os.sep, "/"))
+    return sorted(found)
+
+
+# ------------------------------------------------------------------ F2P：只读属性
+# 目标端的只读条目会以 WinError 5（拒绝访问）挡住覆盖与删除；目录自身的只读
+# 属性则会挡住它的删除，使清空后的空目录残留。
+
+def test_update_readonly_target_file(tmp_path):
+    """目标里已存在的只读文件应当能被源内容覆盖。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "config.ini", "mode=production", mtime=1_700_000_000)
+    readonly = write(target / "config.ini", "mode=legacy", mtime=1_600_000_000)
+    set_readonly(readonly)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert read(target / "config.ini") == "mode=production"
+
+
+def test_delete_readonly_file_in_target_root(tmp_path):
+    """目标根目录下只读的多余文件应当被删除。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "keep.txt", "keep")
+    readonly = write(target / "obsolete.dat", "legacy payload")
+    set_readonly(readonly)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert not (target / "obsolete.dat").exists()
+
+
+def test_delete_readonly_file_in_subtree(tmp_path):
+    """目标子目录里只读的多余文件应当被删除，清空后的目录随之清理。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "keep.txt", "keep")
+    readonly = write(target / "archive" / "2024" / "dump.bin", "legacy payload")
+    set_readonly(readonly)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert not (target / "archive").exists()
+
+
+def test_readonly_empty_directory_is_pruned(tmp_path):
+    """目标中多余的只读空目录必须被清理干净，不得静默残留。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "keep.txt", "keep")
+    stale = target / "stale_dir"
+    stale.mkdir(parents=True)
+    set_readonly(stale)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert not (target / "stale_dir").exists()
+
+
+# ------------------------------------------------------------------ F2P：文件名大小写
+# 目标平台的文件名比较不区分大小写：只有大小写不同的两个相对路径指向同一条目。
+
+def test_case_only_difference_updates_existing_file(tmp_path):
+    """仅大小写不同的路径指向同一个文件，应当就地更新而不是重建。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "Report.PDF", "AAAA", mtime=1_700_000_000)
+    write(target / "report.pdf", "BBBB", mtime=1_600_000_000)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert read(target / "report.pdf") == "AAAA"
+
+
+def test_case_only_difference_does_not_lose_file(tmp_path):
+    """仅大小写不同时不得出现“先写入又被删除”的结果。
+
+    题面只要求“该文件存在、内容为源中的内容、条目不多不少”，
+    并未规定终态保留源侧还是目标侧的**名字大小写**（两者在 Windows 上是同一条路径），
+    因此这里只断言“恰好一个条目、按大小写不敏感比较等于源的名字、内容正确”。
+    """
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "Notes.TXT", "AAAA", mtime=1_700_000_000)
+    write(target / "notes.txt", "BBBB", mtime=1_600_000_000)
+
+    sync_tree(str(source), str(target))
+
+    found = files_under(target)
+    assert len(found) == 1, found
+    assert found[0].lower() == "notes.txt", found
+    assert read(target / found[0]) == "AAAA"
+
+
+def test_case_only_difference_identical_content_makes_no_change(tmp_path):
+    """内容一致、仅大小写不同时应当判为未变化，不产生任何动作。
+
+    同样不对名字大小写做规定：只要求“既不更新也不删除”，且条目不多不少。
+    """
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "Readme.MD", "same", mtime=1_600_000_000)
+    write(target / "readme.md", "same", mtime=1_600_000_000)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.updated == []
+    assert result.deleted == []
+    found = files_under(target)
+    assert len(found) == 1, found
+    assert found[0].lower() == "readme.md", found
+
+
+def test_case_only_difference_between_file_and_directory(tmp_path):
+    """源上是目录、目标上是仅大小写不同的同名文件：二者在 Windows 上是同一条路径，
+    必须清掉这个文件、建立目录，并使终态与源一致。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "Data" / "report.txt", "report")
+    target.mkdir(parents=True, exist_ok=True)
+    (target / "data").write_text("stale file", encoding="utf-8")
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert files_under(target) == ["Data/report.txt"]
+    assert read(target / "Data" / "report.txt") == "report"
+
+
+# ------------------------------------------------------------------ F2P：条目类型冲突
+# Windows 上同一条路径不能既是文件又是目录；来源不同时目标侧的类型必须先被清掉。
+
+def test_target_file_replaced_by_source_directory(tmp_path):
+    """目标上是同名文件、源上是目录：必须清掉该文件，建立目录并写入其中所有文件。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "bundle" / "one.txt", "one")
+    write(source / "bundle" / "nested" / "two.txt", "two")
+    target.mkdir(parents=True, exist_ok=True)
+    (target / "bundle").write_text("i am a file", encoding="utf-8")
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert (target / "bundle").is_dir()
+    assert read(target / "bundle" / "one.txt") == "one"
+    assert read(target / "bundle" / "nested" / "two.txt") == "two"
+
+
+def test_target_directory_replaced_by_source_file(tmp_path):
+    """目标上是目录树（其中还有只读文件）、源上是同名文件：
+    必须清掉整棵目录再写入该文件。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "payload.bin", "PAYLOAD")
+    write(target / "payload.bin" / "leftover.txt", "leftover")
+    readonly = write(target / "payload.bin" / "locked.dat", "locked")
+    set_readonly(readonly)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert (target / "payload.bin").is_file()
+    assert read(target / "payload.bin") == "PAYLOAD"
+
+
+def test_conflict_cleanup_keeps_unrelated_readonly_entries_intact(tmp_path):
+    """为消解类型冲突而做的清理不得波及其它无关条目，只读条目也不例外。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "app", "APP")
+    write(source / "kept" / "ro.dat", "KEEP", mtime=1_600_000_000)
+    write(target / "app" / "leftover.txt", "leftover")
+    readonly = write(target / "kept" / "ro.dat", "KEEP", mtime=1_600_000_000)
+    set_readonly(readonly)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok, result.failed
+    assert (target / "app").is_file()
+    assert read(target / "app") == "APP"
+    assert read(target / "kept" / "ro.dat") == "KEEP"
+    assert files_under(target) == ["app", "kept/ro.dat"]
+
+
+# ------------------------------------------------------------------ F2P：内容判定与幂等
+# 内容是否需要更新必须依据内容本身，而不是大小与修改时间；同步结果也必须可重复。
+
+def test_same_size_and_mtime_but_different_content_is_updated(tmp_path):
+    """目标文件与源文件大小、修改时间都相同但内容不同：不得据此判为“未变化”。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "blob.bin", "AAAAA", mtime=1_700_000_000)
+    write(target / "blob.bin", "BBBBB", mtime=1_700_000_000)
+
+    result = sync_tree(str(source), str(target))
+
+    assert read(target / "blob.bin") == "AAAAA"
+
+
+def test_sync_is_idempotent_and_preserves_source_mtime(tmp_path):
+    """同步后目标文件的修改时间必须与源一致；紧接着再同步一次不得产生任何动作。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "a.txt", "same bytes", mtime=1_700_000_000)
+    write(source / "sub" / "b.txt", "nested", mtime=1_699_000_000)
+    write(target / "a.txt", "same bytes", mtime=1_600_000_000)
+    write(target / "sub" / "b.txt", "nested", mtime=1_600_000_000)
+
+    sync_tree(str(source), str(target))
+
+    assert os.stat(target / "a.txt").st_mtime_ns == os.stat(source / "a.txt").st_mtime_ns
+    assert (os.stat(target / "sub" / "b.txt").st_mtime_ns
+            == os.stat(source / "sub" / "b.txt").st_mtime_ns)
+
+    second = sync_tree(str(source), str(target))
+
+    assert second.created == []
+    assert second.updated == []
+    assert second.deleted == []
+
+
+# ------------------------------------------------------------------ F2P：被占用的目标条目
+# 打开句柄会以 WinError 32（共享冲突）挡住删除与覆盖；这与只读属性（WinError 5）
+# 是两种不同的失败，必须分别处理。
+
+def test_locked_target_entry_is_reported_and_sync_continues(tmp_path):
+    """可写但被占用的条目要记入 failed，其余条目仍须正常完成。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "keep.txt", "keep")
+    write(target / "locked.tmp", "L")
+    write(target / "stale.tmp", "S")
+
+    handle = open(target / "locked.tmp", "r", encoding="utf-8")
+    try:
+        result = sync_tree(str(source), str(target))
+    finally:
+        handle.close()
+
+    assert result.failed, "被占用的条目必须记录为失败，而不是中断整次同步"
+    assert any(
+        entry["relpath"].lower().endswith("locked.tmp") for entry in result.failed
+    ), result.failed
+    assert not (target / "stale.tmp").exists()
+    assert (target / "keep.txt").exists()
+
+
+def test_readonly_and_locked_target_entry_is_reported_without_abort(tmp_path):
+    """既只读又被占用的条目：清掉只读属性也依然删不掉，必须记入失败清单而
+    不是中断整次同步；同一批里纯粹只读的条目仍应被正常处理。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "keep.txt", "keep")
+    write(source / "fresh.txt", "fresh")
+    busy = write(target / "busy.tmp", "B")
+    set_readonly(busy)
+    stale_ro = write(target / "spent.tmp", "S")
+    set_readonly(stale_ro)
+
+    handle = open(busy, "rb")
+    try:
+        result = sync_tree(str(source), str(target))
+    finally:
+        handle.close()
+
+    assert not result.ok
+    assert [entry["relpath"].lower() for entry in result.failed] == ["busy.tmp"], result.failed
+    assert not (target / "spent.tmp").exists()
+    assert read(target / "fresh.txt") == "fresh"
+    assert read(target / "keep.txt") == "keep"
+
+
+# ------------------------------------------------------------------ P2P：既有行为
+# 这些行为在 base 上已经正确，任何改动都不得破坏它们。
+
+def test_creates_missing_file(tmp_path):
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "new.txt", "new")
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok
+    assert read(target / "new.txt") == "new"
+    assert result.created == ["new.txt"]
+
+
+def test_updates_changed_file(tmp_path):
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "a.txt", "v2", mtime=1_700_000_000)
+    write(target / "a.txt", "v1", mtime=1_600_000_000)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok
+    assert read(target / "a.txt") == "v2"
+    assert result.updated == ["a.txt"]
+
+
+def test_deletes_stale_file(tmp_path):
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "keep.txt", "keep")
+    write(target / "stale.txt", "stale")
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok
+    assert not (target / "stale.txt").exists()
+    assert result.deleted == ["stale.txt"]
+
+
+def test_keeps_identical_file(tmp_path):
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "same.txt", "same", mtime=1_600_000_000)
+    write(target / "same.txt", "same", mtime=1_600_000_000)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.updated == []
+    assert result.deleted == []
+    assert result.kept == ["same.txt"]
+
+
+def test_mirrors_nested_tree(tmp_path):
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "a" / "b" / "deep.txt", "deep")
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok
+    assert read(target / "a" / "b" / "deep.txt") == "deep"
+
+
+def test_handles_unicode_names(tmp_path):
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "文档" / "报表 2024q1.txt", "内容")
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok
+    assert read(target / "文档" / "报表 2024q1.txt") == "内容"
+
+
+def test_dry_run_leaves_target_untouched(tmp_path):
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "new.txt", "new")
+    write(target / "stale.txt", "stale")
+
+    result = sync_tree(str(source), str(target), dry_run=True)
+
+    assert (target / "stale.txt").exists()
+    assert not (target / "new.txt").exists()
+    assert sorted(result.created + result.deleted) == ["new.txt", "stale.txt"]
+
+
+def test_creates_target_directory_when_missing(tmp_path):
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    write(source / "a.txt", "a")
+    assert not target.exists()
+
+    sync_tree(str(source), str(target))
+
+    assert read(target / "a.txt") == "a"
+
+
+def test_readonly_source_file_is_still_copied(tmp_path):
+    """只读的源文件也应当能被正常读出并复制。"""
+    source = tmp_path / "source"
+    target = tmp_path / "target"
+    readonly = write(source / "payload.bin", "payload")
+    set_readonly(readonly)
+
+    result = sync_tree(str(source), str(target))
+
+    assert result.ok
+    assert read(target / "payload.bin") == "payload"
