+"""Round 4: final edge scenarios."""
+import os
+import shutil
+import stat
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wsync import sync_tree  # noqa: E402
+
+FAILURES = []
+
+
+def check(name, condition, detail=""):
+    if condition:
+        print("PASS  %s" % name)
+    else:
+        print("FAIL  %s  %s" % (name, detail))
+        FAILURES.append(name)
+
+
+def write(path, text, mtime=None):
+    path = os.path.join(*path) if isinstance(path, tuple) else path
+    d = os.path.dirname(path)
+    if d:
+        os.makedirs(d, exist_ok=True)
+    mode = "wb" if isinstance(text, bytes) else "w"
+    with open(path, mode) as fh:
+        fh.write(text)
+    if mtime is not None:
+        os.utime(path, (mtime, mtime))
+    return path
+
+
+def files_only(root):
+    out = {}
+    for dirpath, _dn, filenames in os.walk(root):
+        for n in filenames:
+            p = os.path.join(dirpath, n)
+            with open(p, "rb") as fh:
+                out[os.path.relpath(p, root).lower()] = fh.read()
+    return out
+
+
+base = tempfile.mkdtemp(prefix="wsync_verify4_")
+
+# K) parent dir exists with different case in the target
+s = os.path.join(base, "sK"); t = os.path.join(base, "tK")
+os.makedirs(os.path.join(s, "Logs")); os.makedirs(os.path.join(t, "LOGS"))
+write((s, "Logs", "a.txt"), "a", mtime=1_600_000_000)
+write((t, "LOGS", "b.txt"), "b")
+r = sync_tree(s, t)
+check("K1 case-differing parent dir", files_only(t) == {os.path.join("logs", "a.txt").lower(): b"a"},
+      files_only(t))
+check("K2 ok", r.ok, r.failed)
+r2 = sync_tree(s, t)
+check("K3 rerun no-op", not (r2.created or r2.updated or r2.deleted), r2)
+
+# L) file bigger than one chunk (3.5 MB) + exact content/mtime round-trip
+s = os.path.join(base, "sL"); t = os.path.join(base, "tL")
+os.makedirs(s); os.makedirs(t)
+blob = bytes(range(256)) * 14336  # 3.5 MB, patterned
+write((s, "big.bin"), blob, mtime=1_600_000_000)
+write((t, "big.bin"), b"x" * len(blob), mtime=1_600_000_000)
+r = sync_tree(s, t)
+check("L1 big file updated", r.updated == ["big.bin"], r)
+check("L2 big file content", files_only(t)[os.path.join("big.bin").lower()] == blob)
+check("L3 big file mtime", os.stat(os.path.join(t, "big.bin")).st_mtime_ns
+      == os.stat(os.path.join(s, "big.bin")).st_mtime_ns)
+r2 = sync_tree(s, t)
+check("L4 rerun no-op", not (r2.created or r2.updated or r2.deleted), r2)
+
+# M) deep chain of type conflicts in one sync
+s = os.path.join(base, "sM"); t = os.path.join(base, "tM")
+os.makedirs(os.path.join(s, "x", "y", "z"))
+os.makedirs(t)
+write((s, "x", "y", "z", "leaf.txt"), "leaf")
+write((s, "x", "y", "plain.txt"), "plain")
+write((t, "x"), "file blocking x")
+r = sync_tree(s, t)
+check("M1 deep conflict resolved", files_only(t) == {
+    os.path.join("x", "y", "z", "leaf.txt").lower(): b"leaf",
+    os.path.join("x", "y", "plain.txt").lower(): b"plain",
+}, files_only(t))
+check("M2 ok", r.ok, r.failed)
+
+# N) reverse deep chain: source file under path where target has nested dirs
+s = os.path.join(base, "sN"); t = os.path.join(base, "tN")
+os.makedirs(s)
+os.makedirs(os.path.join(t, "x", "y", "z"))
+write((s, "x"), "file at top")
+write((t, "x", "y", "z", "deep.txt"), "deep stale")
+r = sync_tree(s, t)
+check("N1 deep reverse conflict", files_only(t) == {"x": b"file at top"}, files_only(t))
+check("N2 dirs pruned", not os.path.exists(os.path.join(t, "x", "y")), os.listdir(t))
+check("N3 ok", r.ok, r.failed)
+
+# O) sync into a fresh nested target root; readonly target dir contents
+s = os.path.join(base, "sO"); t = os.path.join(base, "tO", "deep", "new")
+os.makedirs(os.path.join(s, "a"))
+write((s, "a", "f.txt"), "f", mtime=1_600_000_000)
+r = sync_tree(s, t)
+check("O1 nested new target root", files_only(t) == {os.path.join("a", "f.txt").lower(): b"f"}, files_only(t))
+r2 = sync_tree(s, t)
+check("O2 rerun no-op", not (r2.created or r2.updated or r2.deleted), r2)
+
+print()
+if FAILURES:
+    print("FAILED:", len(FAILURES), FAILURES)
+    for dirpath, dirnames, filenames in os.walk(base):
+        for n in filenames + dirnames:
+            try:
+                os.chmod(os.path.join(dirpath, n), stat.S_IWRITE)
+            except OSError:
+                pass
+    shutil.rmtree(base, ignore_errors=True)
+    sys.exit(1)
+print("ALL CHECKS PASSED")
+for dirpath, dirnames, filenames in os.walk(base):
+    for n in filenames + dirnames:
+        try:
+            os.chmod(os.path.join(dirpath, n), stat.S_IWRITE)
+        except OSError:
+            pass
+shutil.rmtree(base, ignore_errors=True)
