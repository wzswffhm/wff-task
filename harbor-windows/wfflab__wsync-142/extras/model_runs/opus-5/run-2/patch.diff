+def clear_readonly(path: str) -> None:
+    """清除路径的只读属性（如果有的话）。"""
+    try:
+        if is_readonly(path):
+            current_mode = os.stat(path).st_mode
+            os.chmod(path, current_mode | stat.S_IWRITE)
+    except OSError:
+        pass
+
+
 def remove_file(path: str) -> None:
     """删除单个文件。"""
+    clear_readonly(path)
     os.remove(path)
 
 
 def remove_tree(path: str) -> None:
     """递归删除一棵目录树。"""
+    # 需要递归清除所有只读属性
+    for root, dirs, files in os.walk(path, topdown=False):
+        for name in files:
+            clear_readonly(os.path.join(root, name))
+        for name in dirs:
+            clear_readonly(os.path.join(root, name))
+    clear_readonly(path)
     shutil.rmtree(path)
 
 
+def remove_any(path: str) -> None:
+    """智能删除：根据路径类型选择删除文件还是目录树。"""
+    if os.path.isdir(path):
+        remove_tree(path)
+    elif os.path.exists(path):
+        remove_file(path)
+
+
+def ensure_parent_is_dir(path: str) -> None:
+    """确保路径的所有父级分量都是目录。
+
+    如果某个父级分量是文件，则删除该文件并创建目录。
+    """
+    parent = os.path.dirname(path)
+    if not parent:
+        return
+    
+    # 收集所有需要检查的父级路径（从最深到最浅）
+    parts = []
+    current = parent
+    while current:
+        parts.append(current)
+        new_current = os.path.dirname(current)
+        if new_current == current:  # 已到根目录
+            break
+        current = new_current
+    
+    # 从最浅到最深检查和修复
+    for p in reversed(parts):
+        if os.path.exists(p) and not os.path.isdir(p):
+            # 是文件，需要删除
+            remove_file(p)
+        if not os.path.exists(p):
+            os.makedirs(p, exist_ok=True)
+
