+def compute_file_hash(path: str) -> Optional[str]:
+    """计算文件内容的 SHA256 哈希。
+
+    读取失败时返回 ``None``。
+    """
+    try:
+        hasher = hashlib.sha256()
+        with open(path, "rb") as f:
+            while True:
+                chunk = f.read(1024 * 1024)
+                if not chunk:
+                    break
+                hasher.update(chunk)
+        return hasher.hexdigest()
+    except OSError:
+        return None
+
