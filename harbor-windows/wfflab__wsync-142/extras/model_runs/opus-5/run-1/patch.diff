+def clear_readonly(path: str) -> None:
+    """清除路径的只读属性（包括目录及其内容）。"""
+    try:
+        if os.path.isdir(path):
+            # 递归清除目录及其所有内容的只读属性
+            for root, dirs, files in os.walk(path):
+                for name in files:
+                    full = os.path.join(root, name)
+                    try:
+                        if is_readonly(full):
+                            os.chmod(full, stat.S_IWRITE | stat.S_IREAD)
