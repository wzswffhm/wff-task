+def files_equal(path1: str, path2: str) -> bool:
+    """比较两个文件的内容是否完全相同。"""
+    try:
+        # 先比较大小，不同则直接返回
+        stat1 = os.stat(path1)
+        stat2 = os.stat(path2)
+        if stat1.st_size != stat2.st_size:
+            return False
+        
+        # 逐块比较内容
+        chunk_size = 1024 * 1024  # 1MB
+        with open(path1, "rb") as f1, open(path2, "rb") as f2:
+            while True:
+                chunk1 = f1.read(chunk_size)
+                chunk2 = f2.read(chunk_size)
+                if chunk1 != chunk2:
+                    return False
+                if not chunk1:  # 都读完了
+                    break
+        return True
+    except OSError:
+        return False
