@@ -0,0 +1,51 @@
+#!/usr/bin/env python
+"""Test type conflict handling."""
+
+import tempfile
+from pathlib import Path
+import shutil
+
+tmp = Path(tempfile.mkdtemp())
+try:
+    src = tmp / 'src'
+    tgt = tmp / 'tgt'
+    src.mkdir()
+    tgt.mkdir()
+
+    # Source has a directory
+    data_dir = src / 'data'
+    data_dir.mkdir()
+    (data_dir / 'file.txt').write_text('nested file')
+
+    # Target has a file with the same name
+    (tgt / 'data').write_text('plain file')
+
+    print('Before sync:')
+    print(f'  Source data is dir: {data_dir.is_dir()}')
+    print(f'  Target data is file: {(tgt / "data").is_file()}')
+
+    from wsync.planner import build_plan
+    plan = build_plan(str(src), str(tgt))
+
+    print(f'\nPlan has {len(plan.entries)} entries:')
+    for entry in plan.entries:
+        print(f'  {entry.action}: {entry.relpath}')
+
+    from wsync import sync_tree
+    result = sync_tree(str(src), str(tgt))
+
+    print('\nAfter sync:')
+    print(f'  Created: {result.created}')
+    print(f'  Updated: {result.updated}')
+    print(f'  Deleted: {result.deleted}')
+    print(f'  Failed: {result.failed}')
+    print(f'  Target data is dir: {(tgt / "data").is_dir()}')
+    print(f'  Target data is file: {(tgt / "data").is_file()}')
+    
+    if (tgt / 'data').is_dir():
+        print(f'  Target data/file.txt exists: {(tgt / "data" / "file.txt").exists()}')
+        if (tgt / 'data' / 'file.txt').exists():
+            print(f'  Content: {(tgt / "data" / "file.txt").read_text()}')
+
+finally:
+    shutil.rmtree(tmp)
