+def content_equal(path1: str, path2: str) -> bool:
+    """比较两个文件的内容是否完全相同。"""
+    try:
+        with open(path1, "rb") as f1, open(path2, "rb") as f2:
+            chunk_size = 1024 * 1024
+            while True:
+                chunk1 = f1.read(chunk_size)
+                chunk2 = f2.read(chunk_size)
+                if chunk1 != chunk2:
+                    return False
+                if not chunk1:
+                    return True
+    except OSError:
+        return False
+
