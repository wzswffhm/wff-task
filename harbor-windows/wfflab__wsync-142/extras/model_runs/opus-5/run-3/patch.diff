+def _clear_path_for_file(target_path: str) -> None:
+    """确保 target_path 可以作为文件写入。
+
+    如果该路径上已经有一个目录（或其它非文件类型的条目），会先删除它。
+    """
+    if os.path.isdir(target_path):
+        fsops.remove_tree(target_path)
+    elif os.path.exists(target_path) and not os.path.isfile(target_path):
+        # 可能是符号链接或其它特殊类型，尝试删除
+        try:
+            os.remove(target_path)
+        except OSError:
+            pass
+
+
+def _ensure_parent_is_dir(target_path: str) -> None:
+    """确保 target_path 的父目录存在且是目录。
+
+    如果父路径上有一个文件占着位置，会先删除那个文件。
+    """
+    parent = os.path.dirname(target_path)
+    if not parent:
+        return
+    
+    # 递归确保所有上级路径都是目录
+    parts = []
+    current = parent
+    while current:
+        if os.path.isdir(current):
+            break
+        if os.path.exists(current):
+            # 有一个文件或其它东西占着这条路径
+            parts.append(current)
+        parent_of_current = os.path.dirname(current)
+        if parent_of_current == current:
+            break
+        current = parent_of_current
+    
+    # 自顶向下清理并创建目录
+    for path in reversed(parts):
+        if os.path.isfile(path):
+            fsops.remove_file(path)
+        elif os.path.exists(path):
+            try:
+                os.remove(path)
+            except OSError:
+                pass
+    
+    os.makedirs(parent, exist_ok=True)
+
+
 def _apply(entry: PlanEntry) -> None:
+    """执行一条同步动作。"""
     if entry.action in (CREATE, UPDATE):
+        # 确保父目录路径清晰
+        _ensure_parent_is_dir(entry.target)
+        # 确保目标路径上没有目录或其它障碍
+        _clear_path_for_file(entry.target)
+        # 执行复制
         fsops.copy_file(entry.source, entry.target)
     elif entry.action == DELETE:
-        fsops.remove_file(entry.target)
+        if os.path.isdir(entry.target):
+            fsops.remove_tree(entry.target)
+        elif os.path.exists(entry.target):
+            fsops.remove_file(entry.target)
 
 
 def _record(result: SyncResult, action: str, relpath: str) -> None:
+    """把已完成的动作记录到结果中。"""
     if action == CREATE:
         result.created.append(relpath)
     elif action == UPDATE:
@@ -66,8 +127,18 @@ def sync_tree(source_root: str, target_root: str, dry_run: bool = False) -> Sync
         if dry_run:
             _record(result, entry.action, entry.relpath)
             continue
-        _apply(entry)
-        _record(result, entry.action, entry.relpath)
+        
+        # 实际执行，捕获错误但不中断整个同步
+        try:
+            _apply(entry)
