+"""临时验收脚本（不属于仓库，运行后会被删除）。"""
+
+import os
+import shutil
+import stat
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wsync import build_plan, sync_tree  # noqa: E402
+
+FAILURES = []
+
+
+def check(label, condition, extra=""):
+    if condition:
+        print("PASS", label)
+    else:
+        print("FAIL", label, extra)
+        FAILURES.append(label)
+
+
+def write(path, text, mtime=None):
+    path = os.path.abspath(path)
+    parent = os.path.dirname(path)
+    if parent:
+        os.makedirs(parent, exist_ok=True)
+    with open(path, "w", encoding="utf-8") as handle:
+        handle.write(text)
+    if mtime is not None:
+        os.utime(path, (mtime, mtime))
+    return path
+
+
+def read(path):
+    with open(path, encoding="utf-8") as handle:
+        return handle.read()
+
+
+def readonly(path):
+    os.chmod(path, stat.S_IREAD)
+    return path
+
+
+def listing(root):
+    out = []
+    for dirpath, dirnames, filenames in os.walk(root):
+        for name in filenames:
+            out.append(os.path.relpath(os.path.join(dirpath, name), root))
+    return sorted(out)
+
+
+def dirs(root):
+    out = []
+    for dirpath, dirnames, _filenames in os.walk(root):
+        for name in dirnames:
+            out.append(os.path.relpath(os.path.join(dirpath, name), root))
+    return sorted(out)
+
+
+def scenario():
+    base = tempfile.mkdtemp(prefix="wsync-check-")
+    return base, os.path.join(base, "source"), os.path.join(base, "target")
+
+
+# --- 1 只读条目 -----------------------------------------------------------
+base, source, target = scenario()
+write(os.path.join(source, "a.txt"), "new-a")
+write(os.path.join(source, "sub", "b.txt"), "new-b")
+write(os.path.join(source, "keep.txt"), "keep")
+readonly(write(os.path.join(target, "a.txt"), "old-a"))
+readonly(write(os.path.join(target, "sub", "b.txt"), "old-b"))
+readonly(write(os.path.join(target, "stale.txt"), "stale"))
+write(os.path.join(target, "keep.txt"), "keep")
+os.makedirs(os.path.join(target, "emptydir"), exist_ok=True)
+readonly(os.path.join(target, "emptydir"))
+os.makedirs(os.path.join(target, "ro-dir"), exist_ok=True)
+readonly(os.path.join(target, "ro-dir"))
+readonly(write(os.path.join(target, "ro-dir", "gone.txt"), "gone"))
+readonly(os.path.join(target, "sub"))
+
+result = sync_tree(source, target)
+check("1.ok", result.ok, result.failed)
+check("1.updated", sorted(result.updated) == ["a.txt", os.path.join("sub", "b.txt")], result.updated)
+check("1.deleted", sorted(result.deleted) == [os.path.join("ro-dir", "gone.txt"), "stale.txt"],
+      result.deleted)
+check("1.content-a", read(os.path.join(target, "a.txt")) == "new-a")
+check("1.content-b", read(os.path.join(target, "sub", "b.txt")) == "new-b")
+check("1.stale-gone", not os.path.exists(os.path.join(target, "stale.txt")))
+check("1.emptydir-gone", not os.path.exists(os.path.join(target, "emptydir")))
+check("1.ro-dir-gone", not os.path.exists(os.path.join(target, "ro-dir")))
+check("1.listing", listing(target) == ["a.txt", "keep.txt", os.path.join("sub", "b.txt")],
+      listing(target))
+check("1.dirs", dirs(target) == ["sub"], dirs(target))
+again = sync_tree(source, target)
+check("1.idempotent", not again.created and not again.updated and not again.deleted and again.ok,
+      (again.created, again.updated, again.deleted, again.failed))
+shutil.rmtree(base, ignore_errors=True)
+
+# --- 2/3 大小写不同 -------------------------------------------------------
+base, source, target = scenario()
+write(os.path.join(source, "Report.PDF"), "new-content")
+write(os.path.join(source, "other.txt"), "other")
+write(os.path.join(target, "report.pdf"), "old-content")
+result = sync_tree(source, target)
+check("2.ok", result.ok, result.failed)
+check("2.content", read(os.path.join(target, "Report.PDF")) == "new-content")
+check("2.entries", len(os.listdir(target)) == 2, os.listdir(target))
+check("2.actions", sorted(result.created + result.updated + result.deleted) == ["Report.PDF", "other.txt"],
+      (result.created, result.updated, result.deleted))
+check("2.no-temp-leftover", all("wsync-tmp" not in name for name in os.listdir(target)), os.listdir(target))
+again = sync_tree(source, target)
+check("2.idempotent", not again.created and not again.updated and not again.deleted and again.ok,
+      (again.created, again.updated, again.deleted, again.failed))
+shutil.rmtree(base, ignore_errors=True)
+
+base, source, target = scenario()
+write(os.path.join(source, "Report.PDF"), "same")
+write(os.path.join(target, "report.pdf"), "same")
+result = sync_tree(source, target)
+check("3.no-action", not result.created and not result.updated and not result.deleted, result)
+check("3.kept", result.kept == ["Report.PDF"], result.kept)
+check("3.still-there", os.listdir(target) == ["report.pdf"]
+      and read(os.path.join(target, "report.pdf")) == "same", os.listdir(target))
+shutil.rmtree(base, ignore_errors=True)
+
+# 大小写不同的目录
+base, source, target = scenario()
+write(os.path.join(source, "Docs", "a.txt"), "a")
+write(os.path.join(target, "docs", "b.txt"), "b")
+result = sync_tree(source, target)
+check("3b.ok", result.ok, result.failed)
+check("3b.files", listing(target) == [os.path.join("docs", "a.txt")]
+      or listing(target) == [os.path.join("Docs", "a.txt")], listing(target))
+check("3b.content", read(os.path.join(target, "Docs", "a.txt")) == "a")
+shutil.rmtree(base, ignore_errors=True)
+
+# --- 4 被占用的条目 -------------------------------------------------------
+base, source, target = scenario()
+write(os.path.join(source, "ok.txt"), "ok")
+write(os.path.join(source, "changed.txt"), "v2")
+write(os.path.join(target, "busy.log"), "original")
+write(os.path.join(target, "changed.txt"), "v1")
+write(os.path.join(target, "stale.txt"), "stale")
+readonly(write(os.path.join(target, "ro-stale.txt"), "ro"))
+handle = open(os.path.join(target, "busy.log"), "rb")
+try:
+    result = sync_tree(source, target)
+finally:
+    handle.close()
+failed_paths = [item["relpath"] for item in result.failed]
+check("4.busy-failed", failed_paths == ["busy.log"], result.failed)
+check("4.busy-action", result.failed[0]["action"] == "delete", result.failed)
+check("4.busy-still-there", os.path.exists(os.path.join(target, "busy.log")))
+check("4.busy-content", read(os.path.join(target, "busy.log")) == "original")
+check("4.others-done", sorted(result.created) == ["ok.txt"] and sorted(result.deleted) == ["ro-stale.txt", "stale.txt"]
+      and result.updated == ["changed.txt"], (result.created, result.updated, result.deleted))
+check("4.ro-stale-deleted", not os.path.exists(os.path.join(target, "ro-stale.txt")), result.failed)
+check("4.not-ok", not result.ok)
+check("4.error-text", all(item["error"] for item in result.failed), result.failed)
+check("4.no-temp", all("wsync-tmp" not in n for n in os.listdir(target)), os.listdir(target))
+shutil.rmtree(base, ignore_errors=True)
+
+# 只读 + 被占用
+base, source, target = scenario()
+write(os.path.join(source, "x.txt"), "x")
+locked = readonly(write(os.path.join(target, "locked.txt"), "locked"))
+handle = open(locked, "rb")
+try:
+    result = sync_tree(source, target)
+finally:
+    handle.close()
+check("4b.failed", [i["relpath"] for i in result.failed] == ["locked.txt"], result.failed)
+check("4b.created", result.created == ["x.txt"], result.created)
+check("4b.exists", os.path.exists(locked))
+shutil.rmtree(base, ignore_errors=True)
+
+# 被占用的文件需要被更新（内容不能写坏）
+base, source, target = scenario()
+write(os.path.join(source, "live.txt"), "new-content")
+live = write(os.path.join(target, "live.txt"), "old-content")
+handle = open(live, "rb")
+try:
+    result = sync_tree(source, target)
+finally:
+    handle.close()
+check("4c.recorded", len(result.failed) + len(result.updated) == 1, result)
+check("4c.file-exists", os.path.exists(live))
+check("4c.no-temp", all("wsync-tmp" not in n for n in os.listdir(target)), os.listdir(target))
+shutil.rmtree(base, ignore_errors=True)
+
+# --- 5/6 类型冲突 ---------------------------------------------------------
+base, source, target = scenario()
+write(os.path.join(source, "bundle"), "payload")
+write(os.path.join(source, "keep.txt"), "keep")
+write(os.path.join(target, "bundle", "x.txt"), "old-x")
+readonly(write(os.path.join(target, "bundle", "ro.txt"), "old-ro"))
+os.makedirs(os.path.join(target, "bundle", "deep"), exist_ok=True)
+write(os.path.join(target, "keep.txt"), "keep")
+result = sync_tree(source, target)
+check("5.ok", result.ok, result.failed)
+check("5.is-file", os.path.isfile(os.path.join(target, "bundle")))
+check("5.content", read(os.path.join(target, "bundle")) == "payload")
+check("5.no-leftover", listing(target) == ["bundle", "keep.txt"], listing(target))
+check("5.dirs", dirs(target) == [], dirs(target))
+again = sync_tree(source, target)
+check("5.idempotent", not again.created and not again.updated and not again.deleted and again.ok,
+      (again.created, again.updated, again.deleted, again.failed))
+shutil.rmtree(base, ignore_errors=True)
+
+base, source, target = scenario()
+write(os.path.join(source, "Data", "x.txt"), "x")
+write(os.path.join(source, "Data", "deep", "y.txt"), "y")
+write(os.path.join(source, "unrelated.txt"), "u")
+readonly(write(os.path.join(target, "data"), "occupied"))
+write(os.path.join(target, "unrelated.txt"), "u")
+write(os.path.join(target, "other.txt"), "o")
+result = sync_tree(source, target)
+check("6.ok", result.ok, result.failed)
+check("6.dir-created", os.path.isdir(os.path.join(target, "Data")))
+check("6.files", read(os.path.join(target, "Data", "x.txt")) == "x"
+      and read(os.path.join(target, "Data", "deep", "y.txt")) == "y")
+check("6.deleted-only-conflict", sorted(result.deleted) == ["data", "other.txt"], result.deleted)
+check("6.unrelated-kept", read(os.path.join(target, "unrelated.txt")) == "u")
+check("6.listing", listing(target) == [os.path.join("Data", "deep", "y.txt"),
+                                      os.path.join("Data", "x.txt"), "unrelated.txt"], listing(target))
+again = sync_tree(source, target)
+check("6.idempotent", not again.created and not again.updated and not again.deleted and again.ok,
+      (again.created, again.updated, again.deleted, again.failed))
+shutil.rmtree(base, ignore_errors=True)
+
+# 源文件 vs 目标空只读目录
+base, source, target = scenario()
+write(os.path.join(source, "slot"), "content")
+os.makedirs(os.path.join(target, "slot"))
+readonly(os.path.join(target, "slot"))
+result = sync_tree(source, target)
+check("7.ok", result.ok, result.failed)
+check("7.file", os.path.isfile(os.path.join(target, "slot"))
+      and read(os.path.join(target, "slot")) == "content")
+shutil.rmtree(base, ignore_errors=True)
+
+# 目标目录树里有一个被占用的文件，源里同一路径是文件
+base, source, target = scenario()
+write(os.path.join(source, "pack"), "payload")
+busy = write(os.path.join(target, "pack", "busy.bin"), "busy")
+handle = open(busy, "rb")
+try:
+    result = sync_tree(source, target)
+finally:
+    handle.close()
+check("7b.failed-recorded", bool(result.failed), result)
+check("7b.busy-survives", os.path.exists(busy) and read(busy) == "busy")
+shutil.rmtree(base, ignore_errors=True)
+
+# --- 8 内容判定与时间戳 ---------------------------------------------------
+base, source, target = scenario()
+stamp = 1_600_000_000
+write(os.path.join(source, "same-stamp.txt"), "version-2", mtime=stamp)
+write(os.path.join(target, "same-stamp.txt"), "version-1", mtime=stamp)
+write(os.path.join(source, "fresh.txt"), "fresh", mtime=stamp)
+write(os.path.join(source, "kept.txt"), "kept", mtime=stamp)
+write(os.path.join(target, "kept.txt"), "kept", mtime=stamp - 100)
+write(os.path.join(source, "big.bin"), os.urandom(0).hex() + "x" * 5000, mtime=stamp)
+write(os.path.join(target, "big.bin"), "y" * 5000, mtime=stamp)
+result = sync_tree(source, target)
+check("8.updated", sorted(result.updated) == ["big.bin", "same-stamp.txt"], result.updated)
+check("8.content", read(os.path.join(target, "same-stamp.txt")) == "version-2")
+check("8.content-big", read(os.path.join(target, "big.bin")).startswith("x"))
+for rel in ("same-stamp.txt", "fresh.txt", "kept.txt", "big.bin"):
+    src_mtime = os.stat(os.path.join(source, rel)).st_mtime_ns
+    dst_mtime = os.stat(os.path.join(target, rel)).st_mtime_ns
+    check("8.mtime " + rel, src_mtime == dst_mtime, (src_mtime, dst_mtime))
+again = sync_tree(source, target)
+check("8.noop", not again.created and not again.updated and not again.deleted and again.ok,
+      (again.created, again.updated, again.deleted, again.failed))
+check("8.kept", sorted(again.kept) == ["big.bin", "fresh.txt", "kept.txt", "same-stamp.txt"], again.kept)
+shutil.rmtree(base, ignore_errors=True)
+
+# --- 9 只读源文件 ---------------------------------------------------------
+base, source, target = scenario()
+readonly(write(os.path.join(source, "ro-source.txt"), "from-read-only-source"))
+os.makedirs(os.path.join(source, "ro-nested"), exist_ok=True)
+readonly(write(os.path.join(source, "ro-nested", "inner.txt"), "inner"))
+readonly(os.path.join(source, "ro-nested"))
+result = sync_tree(source, target)
+check("9.ok", result.ok, result.failed)
+check("9.content", read(os.path.join(target, "ro-source.txt")) == "from-read-only-source")
+check("9.nested", read(os.path.join(target, "ro-nested", "inner.txt")) == "inner")
+again = sync_tree(source, target)
+check("9.noop", not again.created and not again.updated and not again.deleted and again.ok, again)
+# 只读源文件更新后仍然可读
+os.chmod(os.path.join(source, "ro-source.txt"), stat.S_IWRITE)
+write(os.path.join(source, "ro-source.txt"), "changed")
+readonly(os.path.join(source, "ro-source.txt"))
+result = sync_tree(source, target)
+check("9.update", read(os.path.join(target, "ro-source.txt")) == "changed", result.failed)
+shutil.rmtree(base, ignore_errors=True)
+
+# --- 10 dry run -----------------------------------------------------------
+base, source, target = scenario()
+write(os.path.join(source, "new.txt"), "new")
+write(os.path.join(target, "stale.txt"), "stale")
+result = sync_tree(source, target, dry_run=True)
+check("10.dry", os.path.exists(os.path.join(target, "stale.txt"))
+      and not os.path.exists(os.path.join(target, "new.txt"))
+      and sorted(result.created + result.deleted) == ["new.txt", "stale.txt"], result)
+shutil.rmtree(base, ignore_errors=True)
+
+# --- 11 build_plan 配对 ---------------------------------------------------
+base, source, target = scenario()
+write(os.path.join(source, "Report.PDF"), "v2")
+write(os.path.join(target, "report.pdf"), "v1")
+plan = build_plan(source, target)
+check("11.plan", [e.action for e in plan.entries] == ["update"], plan.entries)
+check("11.by-action", [e.relpath for e in plan.by_action("update")] == ["Report.PDF"], plan.entries)
+check("11.actions", plan.actions() == ["update"], plan.actions())
+shutil.rmtree(base, ignore_errors=True)
+
+print()
+if FAILURES:
+    print("FAILED:", len(FAILURES), FAILURES)
+    sys.exit(1)
+print("ALL CHECKS PASSED")
