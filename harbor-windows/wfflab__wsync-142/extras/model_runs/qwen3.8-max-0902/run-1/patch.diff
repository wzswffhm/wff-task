@@ -0,0 +1,32 @@
+import os
+import stat
+import tempfile
+
+base = tempfile.mkdtemp(prefix="wsync-probe3-")
+p = os.path.join(base, "ro.txt")
+with open(p, "w") as fh:
+    fh.write("x")
+os.chmod(p, stat.S_IREAD)
+print("readonly:", not bool(os.stat(p).st_mode & stat.S_IWRITE))
+try:
+    os.utime(p, (1_600_000_000, 1_600_000_000))
+    print("utime on readonly file -> OK", os.stat(p).st_mtime)
+except OSError as exc:
+    print("utime on readonly file -> FAIL", type(exc).__name__, exc.errno,
+          getattr(exc, "winerror", None), exc.strerror)
+print("still readonly:", not bool(os.stat(p).st_mode & stat.S_IWRITE))
+
+d = os.path.join(base, "rodir")
+os.makedirs(d)
+os.chmod(d, stat.S_IREAD)
+try:
+    os.utime(d, (1_600_000_000, 1_600_000_000))
+    print("utime on readonly dir -> OK")
+except OSError as exc:
+    print("utime on readonly dir -> FAIL", type(exc).__name__, exc.errno,
+          getattr(exc, "winerror", None), exc.strerror)
+os.chmod(p, stat.S_IWRITE)
+os.chmod(d, stat.S_IWRITE)
+os.remove(p)
+os.rmdir(d)
+os.rmdir(base)
