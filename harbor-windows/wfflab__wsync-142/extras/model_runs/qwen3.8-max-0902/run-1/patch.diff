new file mode 100644
index 0000000..4facdce
--- /dev/null
+++ b/_scratch_check2.py
@@ -0,0 +1,140 @@
+"""临时补充验收（不属于仓库，运行后会被删除）。"""
+
+import os
+import shutil
+import stat
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from wsync import sync_tree  # noqa: E402
+
+FAILURES = []
+
+
+def check(label, condition, extra=""):
+    print(("PASS " if condition else "FAIL ") + label, "" if condition else extra)
+    if not condition:
+        FAILURES.append(label)
+
+
+def write(path, text):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write(text)
+    return path
+
+
+def read(path):
+    with open(path, encoding="utf-8") as fh:
+        return fh.read()
+
+
+def ro(path):
+    os.chmod(path, stat.S_IREAD)
+    return path
+
+
+def tree(root):
+    out = []
+    for dirpath, dirnames, filenames in os.walk(root):
+        rel = os.path.relpath(dirpath, root)
+        for name in filenames:
+            out.append(os.path.normpath(os.path.join(rel, name)))
+        for name in dirnames:
+            out.append(os.path.normpath(os.path.join(rel, name)) + "/")
+    return sorted(out)
+
+
+def scenario():
+    base = tempfile.mkdtemp(prefix="wsync-check2-")
+    return base, os.path.join(base, "source"), os.path.join(base, "target")
+
+
+# C 深层只读目录整棵清掉
+base, source, target = scenario()
+write(os.path.join(source, "top.txt"), "top")
+deep = os.path.join(target, "a", "b", "c")
+write(os.path.join(deep, "file.txt"), "gone")
+ro(os.path.join(deep, "file.txt"))
+for part in ("c", "b", "a"):
+    ro(os.path.join(target, "a", "b", "c") if part == "c" else os.path.join(target, *("a", "b")[: {"b": 2, "a": 1}[part]]))
+result = sync_tree(source, target)
+check("C.ok", result.ok, result.failed)
+check("C.tree", tree(target) == ["top.txt"], tree(target))
+shutil.rmtree(base, ignore_errors=True)
+
+# D 目标把文件位置放成了一棵目录
+base, source, target = scenario()
+write(os.path.join(source, "x", "y.txt"), "payload")
+write(os.path.join(target, "x", "y.txt", "z.txt"), "stale")
+ro(os.path.join(target, "x", "y.txt", "z.txt"))
+result = sync_tree(source, target)
+check("D.ok", result.ok, result.failed)
+check("D.is-file", os.path.isfile(os.path.join(target, "x", "y.txt")))
+check("D.content", read(os.path.join(target, "x", "y.txt")) == "payload")
+check("D.tree", tree(target) == [os.path.join("x", "y.txt")], tree(target))
+again = sync_tree(source, target)
+check("D.idem", not again.created and not again.updated and not again.deleted and again.ok, again)
+shutil.rmtree(base, ignore_errors=True)
+
+# F 源文件 vs 目标同名（大小写不同）目录
+base, source, target = scenario()
+write(os.path.join(source, "pack"), "payload")
+write(os.path.join(target, "PACK", "inner.txt"), "stale")
+ro(os.path.join(target, "PACK"))
+result = sync_tree(source, target)
+check("F.ok", result.ok, result.failed)
+check("F.is-file", os.path.isfile(os.path.join(target, "pack")) and read(os.path.join(target, "pack")) == "payload")
+check("F.tree", [t.lower() for t in tree(target)] == ["pack"], tree(target))
+shutil.rmtree(base, ignore_errors=True)
+
+# G 目录被占用时 prune 不炸
+base, source, target = scenario()
+write(os.path.join(source, "s.txt"), "s")
+os.makedirs(os.path.join(target, "busydir"))
+busy = write(os.path.join(target, "busydir", "live.log"), "live")
+handle = open(busy, "rb")
+try:
+    result = sync_tree(source, target)
+finally:
+    handle.close()
+check("G.failed", [i["relpath"] for i in result.failed] == [os.path.join("busydir", "live.log")], result.failed)
+check("G.created", result.created == ["s.txt"], result.created)
+check("G.dir-kept", os.path.isdir(os.path.join(target, "busydir")))
+shutil.rmtree(base, ignore_errors=True)
+
+# H 目标根目录带只读属性
+base, source, target = scenario()
+write(os.path.join(source, "a", "b.txt"), "b")
+os.makedirs(target)
+ro(target)
+result = sync_tree(source, target)
+check("H.ok", result.ok, result.failed)
+check("H.content", read(os.path.join(target, "a", "b.txt")) == "b")
+os.chmod(target, stat.S_IWRITE)
+shutil.rmtree(base, ignore_errors=True)
+
+# I 二次同步完全静止（含只读、大小写、时间戳）
+base, source, target = scenario()
+write(os.path.join(source, "Report.PDF"), "same")
+os.utime(os.path.join(source, "Report.PDF"), (1_600_000_000, 1_600_000_000))
+write(os.path.join(source, "dir", "f.txt"), "f")
+os.utime(os.path.join(source, "dir", "f.txt"), (1_600_000_001, 1_600_000_001))
+write(os.path.join(target, "report.pdf"), "same")
+os.utime(os.path.join(target, "report.pdf"), (1_500_000_000, 1_500_000_000))
+first = sync_tree(source, target)
+check("I.first", first.created == [os.path.join("dir", "f.txt")] and first.kept == ["Report.PDF"]
+      and not first.updated and not first.deleted and first.ok, first)
+check("I.mtime-aligned",
+      os.stat(os.path.join(target, "report.pdf")).st_mtime_ns == os.stat(os.path.join(source, "Report.PDF")).st_mtime_ns)
+second = sync_tree(source, target)
+check("I.second-quiet", not second.created and not second.updated and not second.deleted and second.ok, second)
+check("I.entries", sorted(os.listdir(target)) == ["dir", "report.pdf"], os.listdir(target))
+shutil.rmtree(base, ignore_errors=True)
+
+print()
+if FAILURES:
+    print("FAILED:", FAILURES)
+    sys.exit(1)
+print("ALL EXTRA CHECKS PASSED")
diff --git a/_scratch_dbg.py b/_scratch_dbg.py
new file mode 100644
index 0000000..f7661ae
--- /dev/null
+++ b/_scratch_dbg.py
@@ -0,0 +1,43 @@
+import os
+import shutil
+import stat
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from wsync import build_plan, sync_tree
+from wsync import fsops
+
+base = tempfile.mkdtemp(prefix="wsync-dbg-")
+source = os.path.join(base, "source")
+target = os.path.join(base, "target")
+
+
+def write(path, text):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write(text)
+    return path
+
+
+write(os.path.join(source, "Data", "x.txt"), "x")
+write(os.path.join(source, "Data", "deep", "y.txt"), "y")
+write(os.path.join(source, "unrelated.txt"), "u")
+p = write(os.path.join(target, "data"), "occupied")
+os.chmod(p, stat.S_IREAD)
+write(os.path.join(target, "unrelated.txt"), "u")
+write(os.path.join(target, "other.txt"), "o")
+
+plan = build_plan(source, target)
+for e in plan.entries:
+    print("PLAN", e.action, e.relpath, "|", e.source, "->", e.target)
+
+result = sync_tree(source, target)
+print("created", result.created)
+print("updated", result.updated)
+print("deleted", result.deleted)
+print("kept", result.kept)
+print("failed", result.failed)
+for dirpath, dirnames, filenames in os.walk(target):
+    print("DIR", os.path.relpath(dirpath, target), dirnames, filenames)
+shutil.rmtree(base, ignore_errors=True)
