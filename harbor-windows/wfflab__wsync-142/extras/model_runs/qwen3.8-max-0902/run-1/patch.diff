diff --git a/_patch_tmp.py b/_patch_tmp.py
new file mode 100644
index 0000000..2ae0a9f
--- /dev/null
+++ b/_patch_tmp.py
@@ -0,0 +1,31 @@
+import io
+
+path = "wsync/fsops.py"
+with io.open(path, encoding="utf-8") as handle:
+    source = handle.read()
+
+old = """    try:
+        info = os.stat(source)
+        _utime(target, (info.st_atime_ns, info.st_mtime_ns))
+    except (OSError, SyncError):
+        return False
+    return True
+"""
+
+new = """    try:
+        info = os.stat(source)
+        current = os.stat(target)
+        if current.st_mtime_ns == info.st_mtime_ns:
+            return True  # 已经对齐，连时间戳都不必再写一次
+        _utime(target, (info.st_atime_ns, info.st_mtime_ns))
+    except (OSError, SyncError):
+        return False
+    return True
+"""
+
+assert old in source, "pattern not found"
+source = source.replace(old, new, 1)
+
+with io.open(path, "w", encoding="utf-8", newline="") as handle:
+    handle.write(source)
+print("patched")
