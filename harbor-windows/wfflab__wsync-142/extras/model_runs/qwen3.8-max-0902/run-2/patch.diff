@@ -0,0 +1,141 @@
+import os
+import stat
+import tempfile
+import shutil
+import msvcrt
+
+base = tempfile.mkdtemp()
+
+
+def mkrel(name, content="data"):
+    p = os.path.join(base, name)
+    with open(p, "w") as h:
+        h.write(content)
+    return p
+
+
+print("--- A: os.replace onto target with plain open handle")
+t = mkrel("a.txt", "old")
+tmp = mkrel("a.txt.tmp", "new")
+h = open(t, "rb")
+try:
+    os.replace(tmp, t)
+    print("  replace: OK (!) content=", open(t).read())
+except OSError as e:
+    print("  replace failed:", type(e).__name__, e)
+h.close()
+if os.path.exists(tmp):
+    os.remove(tmp)
+
+print("--- B: os.replace onto byte-range locked target")
+t = mkrel("b.txt", "old")
+tmp = mkrel("b.txt.tmp", "new")
+fd = os.open(t, os.O_RDWR)
+msvcrt.locking(fd, msvcrt.LK_NBLCK, 3)
+try:
+    os.replace(tmp, t)
+    print("  replace: OK (!)")
+except OSError as e:
+    print("  replace failed:", type(e).__name__, e)
+msvcrt.locking(fd, msvcrt.LK_UNLCK, 3)
+os.close(fd)
+print("  content now:", repr(open(t).read()))
+if os.path.exists(tmp):
+    os.remove(tmp)
+
+print("--- C: direct open(wb)+write on byte-range locked target")
+t = mkrel("c.txt", "old")
+fd = os.open(t, os.O_RDWR)
+msvcrt.locking(fd, msvcrt.LK_NBLCK, 3)
+try:
+    with open(t, "wb") as hh:
+        hh.write(b"new")
+    print("  direct write: OK (!)")
+except OSError as e:
+    print("  direct write failed:", type(e).__name__, e)
+msvcrt.locking(fd, msvcrt.LK_UNLCK, 3)
+os.close(fd)
+print("  content now:", repr(open(t).read()))
+
+print("--- D: read-only directory: create file inside / write existing file / remove file")
+d = os.path.join(base, "rodir")
+os.mkdir(d)
+inner = os.path.join(d, "inner.txt")
+with open(inner, "w") as hh:
+    hh.write("inner")
+os.chmod(d, stat.S_IREAD)
+print("  dir readonly:", not bool(os.stat(d).st_mode & stat.S_IWRITE))
+try:
+    with open(os.path.join(d, "brand-new.txt"), "wb") as hh:
+        hh.write(b"x")
+    print("  create new file inside ro dir: OK")
+except OSError as e:
+    print("  create new file inside ro dir failed:", type(e).__name__, e)
+try:
+    with open(inner, "wb") as hh:
+        hh.write(b"changed")
+    print("  overwrite existing file inside ro dir: OK")
+except OSError as e:
+    print("  overwrite existing file inside ro dir failed:", type(e).__name__, e)
+try:
+    import tempfile as tf
+    fdx, tmpp = tf.mkstemp(dir=d)
+    os.close(fdx)
+    print("  mkstemp inside ro dir: OK")
+    os.replace(tmpp, inner)
+    print("  replace inside ro dir: OK")
+except OSError as e:
+    print("  mkstemp/replace inside ro dir failed:", type(e).__name__, e)
+try:
+    os.remove(os.path.join(d, "brand-new.txt"))
+    print("  remove file inside ro dir: OK")
+except OSError as e:
+    print("  remove file inside ro dir failed:", type(e).__name__, e)
+os.chmod(d, stat.S_IWRITE)
+
+print("--- E: os.replace onto missing target / onto readonly-cleared target")
+t = mkrel("e.txt", "old")
+os.chmod(t, stat.S_IREAD)
+tmp = mkrel("e.tmp", "new")
+try:
+    os.replace(tmp, t)
+    print("  replace onto readonly target: OK (!)")
+except OSError as e:
+    print("  replace onto readonly target failed:", type(e).__name__, e)
+    os.chmod(t, stat.S_IWRITE)
+    os.replace(tmp, t)
+    print("  after chmod replace OK")
+print("  content:", repr(open(t).read()), "readonly now:", not bool(os.stat(t).st_mode & stat.S_IWRITE))
+
+t2 = os.path.join(base, "missing.txt")
+tmp2 = mkrel("e2.tmp", "new")
+os.replace(tmp2, t2)
+print("  replace onto missing target: OK", open(t2).read())
+
+print("--- F: mkstemp default mode")
+fdx, tmpp = tempfile.mkstemp(dir=base)
+os.close(fdx)
+print("  mode:", oct(os.stat(tmpp).st_mode & 0o777))
+os.remove(tmpp)
+
+print("--- G: does replace preserve mtime set on the temp file")
+src = mkrel("g-src.txt", "s")
+os.utime(src, (1_600_000_000, 1_600_000_000))
+fdx, tmpp = tempfile.mkstemp(dir=base)
+with os.fdopen(fdx, "wb") as hh:
+    hh.write(b"s")
+st = os.stat(src)
+os.utime(tmpp, ns=(st.st_atime_ns, st.st_mtime_ns))
+tgt = os.path.join(base, "g-dst.txt")
+os.replace(tmpp, tgt)
+print("  src mtime_ns:", os.stat(src).st_mtime_ns, "dst:", os.stat(tgt).st_mtime_ns,
+      "equal:", os.stat(src).st_mtime_ns == os.stat(tgt).st_mtime_ns)
+
+for dirpath, dirnames, filenames in os.walk(base):
+    for n in dirnames + filenames:
+        try:
+            os.chmod(os.path.join(dirpath, n), stat.S_IWRITE)
+        except OSError:
+            pass
+shutil.rmtree(base, ignore_errors=True)
+print("cleanup:", not os.path.exists(base))
