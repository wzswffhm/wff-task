new file mode 100644
index 0000000..741cda2
--- /dev/null
+++ b/_verify3_tmp.py
@@ -0,0 +1,99 @@
+"""临时压力验证（提交前删除）。"""
+
+import os
+import random
+import stat
+import sys
+import shutil
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wsync import sync_tree, build_plan
+
+NAMES = ["a.txt", "B.TXT", "c.bin", "Report.PDF", "report.pdf", "d", "D", "sub", "Sub",
+         "x y.txt", "ünïcode.txt", "deep.dat", "log.log"]
+
+
+def build_random_tree(root, rng, depth=0):
+    os.makedirs(root, exist_ok=True)
+    for name in NAMES:
+        if rng.random() < 0.45:
+            continue
+        rel = os.path.join(root, name)
+        if depth < 2 and rng.random() < 0.3:
+            build_random_tree(rel, rng, depth + 1)
+        else:
+            with open(rel, "wb") as handle:
+                handle.write(bytes(rng.randrange(256) for _ in range(rng.randrange(0, 300))))
+            stamp = rng.choice([1_500_000_000, 1_600_000_000, 1_700_000_000])
+            os.utime(rel, (stamp, stamp))
+            if rng.random() < 0.25:
+                os.chmod(rel, stat.S_IREAD)
+    if depth < 2 and rng.random() < 0.3:
+        empty = os.path.join(root, rng.choice(["empty", "Empty", "hollow"]))
+        os.makedirs(empty, exist_ok=True)
+        if rng.random() < 0.5:
+            os.chmod(empty, stat.S_IREAD)
+
+
+def snapshot(root):
+    files = {}
+    for dirpath, dirnames, filenames in os.walk(root):
+        for name in filenames:
+            full = os.path.join(dirpath, name)
+            rel = os.path.relpath(full, root)
+            with open(full, "rb") as handle:
+                files[rel.lower()] = (handle.read(), os.stat(full).st_mtime_ns)
+    return files
+
+
+def writable(root):
+    for dirpath, dirnames, filenames in os.walk(root):
+        for name in dirnames + filenames:
+            try:
+                os.chmod(os.path.join(dirpath, name), stat.S_IWRITE)
+            except OSError:
+                pass
+
+
+problems = []
+for seed in range(40):
+    rng = random.Random(seed)
+    base = tempfile.mkdtemp(prefix="wsyncstress_")
+    src = os.path.join(base, "source")
+    dst = os.path.join(base, "target")
+    build_random_tree(src, random.Random(seed * 7 + 1))
+    if seed % 3:  # 大多数轮次让目标里先有一堆旧东西
+        build_random_tree(dst, random.Random(seed * 13 + 5))
+    res = sync_tree(src, dst)
+    if res.failed:
+        problems.append((seed, "failed", res.failed))
+    left = snapshot(src)
+    right = snapshot(dst)
+    if left != right:
+        missing = sorted(set(left) - set(right))
+        extra = sorted(set(right) - set(left))
+        differing = sorted(k for k in set(left) & set(right) if left[k] != right[k])
+        problems.append((seed, "mismatch", missing[:5], extra[:5], differing[:5]))
+    # 幂等
+    res2 = sync_tree(src, dst)
+    if (res2.created, res2.updated, res2.deleted) != ([], [], []):
+        problems.append((seed, "not idempotent", res2.created, res2.updated, res2.deleted))
+    if res2.failed:
+        problems.append((seed, "second failed", res2.failed))
+    if snapshot(src) != snapshot(dst):
+        problems.append((seed, "mismatch after second"))
+    # 目标里不该留下临时文件
+    tmp_left = [p for p in snapshot(dst) if "wsynctmp" in p]
+    if tmp_left:
+        problems.append((seed, "temp leftovers", tmp_left))
+    writable(base)
+    shutil.rmtree(base, ignore_errors=True)
+    if os.path.exists(base):
+        problems.append((seed, "cleanup failed", base))
+
+print("seeds:", 40, "problems:", len(problems))
+for item in problems[:10]:
+    print(" ", item)
+sys.exit(1 if problems else 0)
