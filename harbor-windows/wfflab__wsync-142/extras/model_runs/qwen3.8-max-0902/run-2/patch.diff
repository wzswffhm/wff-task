+"""临时验证脚本 2（会在提交前删除）。"""
+
+import os
+import stat
+import sys
+import tempfile
+import shutil
+import msvcrt
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wsync import build_plan, sync_tree
+from wsync import fsops
+
+FAILURES = []
+
+
+def check(name, cond, extra=""):
+    if cond:
+        print("  PASS", name)
+    else:
+        print("  FAIL", name, extra)
+        FAILURES.append(name)
+
+
+def write(path, text, mtime=None, readonly=False):
+    path = os.path.abspath(path)
+    parent = os.path.dirname(path)
+    if parent:
+        os.makedirs(parent, exist_ok=True)
+    with open(path, "w", encoding="utf-8") as handle:
+        handle.write(text)
+    if mtime is not None:
+        os.utime(path, (mtime, mtime))
+    if readonly:
+        os.chmod(path, stat.S_IREAD)
+    return path
+
+
+def ro_dir(path):
+    os.makedirs(path, exist_ok=True)
+    os.chmod(path, stat.S_IREAD)
+    return path
+
+
+def tree(root):
+    out = []
+    for dirpath, dirnames, filenames in os.walk(root):
+        for name in sorted(filenames):
+            out.append(os.path.relpath(os.path.join(dirpath, name), root))
+        for name in sorted(dirnames):
+            out.append(os.path.relpath(os.path.join(dirpath, name), root) + os.sep)
+    return sorted(out)
+
+
+def read(path):
+    with open(path, encoding="utf-8") as handle:
+        return handle.read()
+
+
+def fresh():
+    base = tempfile.mkdtemp(prefix="wsynccheck2_")
+    return base, os.path.join(base, "source"), os.path.join(base, "target")
+
+
+def done(base):
+    for dirpath, dirnames, filenames in os.walk(base):
+        for name in dirnames + filenames:
+            try:
+                os.chmod(os.path.join(dirpath, name), stat.S_IWRITE)
+            except OSError:
+                pass
+    shutil.rmtree(base, ignore_errors=True)
+
+
+def leftovers(root):
+    return [p for p in tree(root) if "wsynctmp" in p]
+
+
+print("A source dir vs read-only target file")
+base, src, dst = fresh()
+write(os.path.join(src, "bundle", "inner.txt"), "inner")
+write(os.path.join(dst, "bundle"), "file", readonly=True)
+res = sync_tree(src, dst)
+check("ok", res.ok, res.failed)
+check("tree", tree(dst) == sorted(["bundle" + os.sep, os.path.join("bundle", "inner.txt")]), tree(dst))
+check("content", read(os.path.join(dst, "bundle", "inner.txt")) == "inner")
+check("no leftovers", leftovers(dst) == [], leftovers(dst))
+done(base)
+
+print("B source file vs read-only target dir with read-only file")
+base, src, dst = fresh()
+write(os.path.join(src, "data"), "file")
+write(os.path.join(dst, "Data", "x.txt"), "xxx", readonly=True)
+ro_dir(os.path.join(dst, "Data"))
+res = sync_tree(src, dst)
+check("ok", res.ok, res.failed)
+check("isfile", os.path.isfile(os.path.join(dst, "data")))
+check("content", read(os.path.join(dst, "data")) == "file")
+check("tree", tree(dst) == ["data"], tree(dst))
+check("no leftovers", leftovers(dst) == [], leftovers(dst))
+done(base)
+
+print("C locked blocker file where source needs a dir")
+base, src, dst = fresh()
+write(os.path.join(src, "bundle", "inner.txt"), "inner")
+write(os.path.join(dst, "bundle"), "locked-file")
+fd = os.open(os.path.join(dst, "bundle"), os.O_RDWR)
+msvcrt.locking(fd, msvcrt.LK_NBLCK, 4)
+try:
+    res = sync_tree(src, dst)
+    check("did not raise", True)
+    check("both failed", sorted(i["relpath"] for i in res.failed) == sorted(["bundle", os.path.join("bundle", "inner.txt")]), res.failed)
+finally:
+    msvcrt.locking(fd, msvcrt.LK_UNLCK, 4)
+    os.close(fd)
+check("blocker intact", read(os.path.join(dst, "bundle")) == "locked-file")
+check("no leftovers", leftovers(dst) == [], leftovers(dst))
+done(base)
+
+print("D locked file inside target dir that must be removed for a source file")
+base, src, dst = fresh()
+write(os.path.join(src, "bundle"), "file")
+write(os.path.join(dst, "bundle", "busy.txt"), "busy")
+write(os.path.join(src, "other.txt"), "o")
+fd = os.open(os.path.join(dst, "bundle", "busy.txt"), os.O_RDWR)
+msvcrt.locking(fd, msvcrt.LK_NBLCK, 4)
+try:
+    res = sync_tree(src, dst)
+    check("did not raise", True)
+    check("created other", res.created == ["other.txt"], res.created)
+    check("failed entries", sorted(i["relpath"] for i in res.failed) == sorted(["bundle", os.path.join("bundle", "busy.txt")]), res.failed)
+    check("busy still exists", os.path.exists(os.path.join(dst, "bundle", "busy.txt")))
+finally:
+    msvcrt.locking(fd, msvcrt.LK_UNLCK, 4)
+    os.close(fd)
+check("no leftovers", leftovers(dst) == [], leftovers(dst))
+done(base)
+
+print("E target root is a file")
+base, src, dst = fresh()
+write(os.path.join(src, "a.txt"), "a")
+write(dst, "i-am-a-file")
+res = sync_tree(src, dst)
+check("ok", res.ok, res.failed)
+check("isdir", os.path.isdir(dst))
+check("content", read(os.path.join(dst, "a.txt")) == "a")
+done(base)
+
+print("F case-insensitive update inside existing dirs")
+base, src, dst = fresh()
+write(os.path.join(src, "Dir", "Report.PDF"), "new")
+write(os.path.join(dst, "dir", "report.pdf"), "old")
+res = sync_tree(src, dst)
+check("ok", res.ok, res.failed)
+check("updated", res.updated == [os.path.join("Dir", "Report.PDF")], res.updated)
+check("nothing else", (res.created, res.deleted) == ([], []), (res.created, res.deleted))
+check("tree", [t.lower() for t in tree(dst)] == sorted(["dir" + os.sep, os.path.join("dir", "report.pdf")]), tree(dst))
+check("content", read(os.path.join(dst, "dir", "report.pdf")) == "new")
+second = sync_tree(src, dst)
+check("second noop", (second.created, second.updated, second.deleted) == ([], [], []), (second.created, second.updated, second.deleted))
+check("second kept", second.kept == [os.path.join("Dir", "Report.PDF")], second.kept)
+done(base)
+
+print("G plan for case-only difference is a single update")
+base, src, dst = fresh()
+write(os.path.join(src, "Report.PDF"), "new")
+write(os.path.join(dst, "report.pdf"), "old")
+plan = build_plan(src, dst)
+check("actions", plan.actions() == ["update"], plan.actions())
+check("entry target is the existing file", plan.entries[0].target == os.path.join(dst, "report.pdf"), plan.entries[0])
+check("entry relpath from source", plan.entries[0].relpath == "Report.PDF", plan.entries[0])
+done(base)
+
+print("H mixed batch: readonly, stale, locked, conflicts")
+base, src, dst = fresh()
+write(os.path.join(src, "same.txt"), "same", mtime=1_600_000_000)
+write(os.path.join(src, "ro-update.txt"), "new-content", mtime=1_600_000_000)
+write(os.path.join(src, "new.txt"), "new")
+write(os.path.join(src, "pack", "one.txt"), "one")
+write(os.path.join(src, "solo"), "solo")
+write(os.path.join(dst, "same.txt"), "same", mtime=1_600_000_000)
+write(os.path.join(dst, "ro-update.txt"), "old", readonly=True)
+write(os.path.join(dst, "stale.txt"), "stale", readonly=True)
+write(os.path.join(dst, "pack"), "was-a-file")
+write(os.path.join(dst, "Solo", "junk.txt"), "junk")
+write(os.path.join(dst, "busy.txt"), "busy")
+fd = os.open(os.path.join(dst, "busy.txt"), os.O_RDWR)
+msvcrt.locking(fd, msvcrt.LK_NBLCK, 4)
+try:
+    res = sync_tree(src, dst)
+    check("created", sorted(res.created) == sorted(["new.txt", os.path.join("pack", "one.txt"), "solo"]), res.created)
+    check("updated", res.updated == ["ro-update.txt"], res.updated)
+    check("kept", res.kept == ["same.txt"], res.kept)
+    check("deleted", sorted(res.deleted) == sorted(["stale.txt", "pack", os.path.join("Solo", "junk.txt")]), res.deleted)
+    check("failed", sorted(i["relpath"] for i in res.failed) == ["busy.txt"], res.failed)
+    check("content ro-update", read(os.path.join(dst, "ro-update.txt")) == "new-content")
+    check("content pack", read(os.path.join(dst, "pack", "one.txt")) == "one")
+    check("solo is file", os.path.isfile(os.path.join(dst, "solo")) and read(os.path.join(dst, "solo")) == "solo")
+    check("stale gone", not os.path.exists(os.path.join(dst, "stale.txt")))
+    check("busy kept", os.path.exists(os.path.join(dst, "busy.txt")))
+    check("mtime", os.stat(os.path.join(dst, "ro-update.txt")).st_mtime_ns == 1_600_000_000 * 10 ** 9, os.stat(os.path.join(dst, "ro-update.txt")).st_mtime_ns)
+finally:
+    msvcrt.locking(fd, msvcrt.LK_UNLCK, 4)
+    os.close(fd)
+check("no leftovers", leftovers(dst) == [], leftovers(dst))
+done(base)
+
+print("I idempotency on a rich tree")
+base, src, dst = fresh()
+write(os.path.join(src, "a", "b", "c.txt"), "c", mtime=1_500_000_000)
+write(os.path.join(src, "top.bin"), "T" * 5000, mtime=1_550_000_000)
+write(os.path.join(src, "ro.txt"), "ro", mtime=1_400_000_000, readonly=True)
+first = sync_tree(src, dst)
+check("first ok", first.ok, first.failed)
+second = sync_tree(src, dst)
+check("second ok", second.ok, second.failed)
+check("second noop", (second.created, second.updated, second.deleted) == ([], [], []), (second.created, second.updated, second.deleted))
+check("second kept", sorted(second.kept) == sorted([os.path.join("a", "b", "c.txt"), "top.bin", "ro.txt"]), second.kept)
+for rel in (os.path.join("a", "b", "c.txt"), "top.bin", "ro.txt"):
+    check("mtime " + rel,
+          os.stat(os.path.join(src, rel)).st_mtime_ns == os.stat(os.path.join(dst, rel)).st_mtime_ns)
+check("no leftovers", leftovers(dst) == [], leftovers(dst))
+done(base)
+
+print("J fsops helpers")
+check("path_key folds case", fsops.path_key("A/B.Txt") == fsops.path_key("a\\b.txt"), (fsops.path_key("A/B.Txt"), fsops.path_key("a\\b.txt")))
+check("path_key keeps separators", fsops.path_key("a/b") == os.path.join("a", "b").lower(), fsops.path_key("a/b"))
+check("case_insensitive_fs", fsops.case_insensitive_fs() is (os.name == "nt"), fsops.case_insensitive_fs())
+check("content_equal same", fsops.content_equal(sys.argv[0], sys.argv[0]) is True)
+check("stat_signature None for missing", fsops.stat_signature(os.path.join(tempfile.gettempdir(), "nope-xyz-123")) is None)
+check("needs_update missing target", __import__("wsync.planner", fromlist=["needs_update"]).needs_update(sys.argv[0], os.path.join(tempfile.gettempdir(), "nope-xyz-123")) is True)
+
+print()
+if FAILURES:
+    print("FAILED:", len(FAILURES), FAILURES)
+    sys.exit(1)
+print("ALL CHECKS PASSED")
