+"""wsync 的底层文件系统操作。
+
+所有直接接触磁盘的调用都集中在本模块，这样文件属性、路径形式和共享
+冲突的处理就只有一个地方需要关心。
+
+Windows 上有几件与 POSIX 不同的事情必须在这里处理掉：
+
+* 带只读属性的文件既不能删除也不能覆盖，带只读属性的空目录连 ``rmdir``
+  都会失败，必须先 ``chmod`` 去掉属性再重试；
+* 文件系统不区分文件名大小写，``Report.PDF`` 与 ``report.pdf`` 是同一个
+  条目，比较路径时必须折叠大小写；
+* 目标条目被别的进程占用时，删除/替换会抛 ``PermissionError``，只能由
+  调用方决定如何记账，本模块不做吞异常的事情；
+* 直接 ``open(target, "wb")`` 覆盖一个被占用的文件会先把原文件截断、再
+  在写入时失败，等于把目标数据毁掉；所以覆盖一律先写同目录下的临时文件，
+  再原子替换过去；
+* 同一条路径上一边是文件、一边是目录时，落地之前要先把挡路的旧条目清掉，
+  而且只允许清掉真正挡路的那一条。
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import stat
+import tempfile
+import uuid
+from typing import Dict, List, Optional, Tuple
+
+__all__ = [
+    "join",
+    "path_key",
+    "case_insensitive_fs",
+    "list_entries",
+    "stat_signature",
+    "content_equal",
+    "is_readonly",
+    "clear_readonly",
+    "ensure_dir",
+    "remove_file",
+    "remove_dir",
+    "remove_path",
+    "remove_tree",
+    "copy_file",
+    "copy_times",
+    "prune_empty_dirs",
+]
+
+_CHUNK_SIZE = 1024 * 1024
+_TEMP_ATTEMPTS = 16
+
+_case_insensitive_cache: Optional[bool] = None
+
+
+def join(root: str, relpath: str) -> str:
+    """把目标根目录和一个相对路径拼成绝对路径。"""
+    return os.path.join(root, relpath)
+
+
+def case_insensitive_fs() -> bool:
+    """当前平台的文件系统是否**不**区分文件名大小写。
+
+    结果会被缓存；探测失败时按平台默认值（Windows 不区分、其它区分）处理。
+    """
+    global _case_insensitive_cache
+    if _case_insensitive_cache is None:
+        _case_insensitive_cache = _detect_case_insensitive()
+    return _case_insensitive_cache
+
+
+def _detect_case_insensitive() -> bool:
+    """在临时目录里放一个探测文件，看它的大写名字是否也存在。"""
+    token = "wsyncprobe" + uuid.uuid4().hex[:8]
+    directory = tempfile.gettempdir()
+    probe = os.path.join(directory, token)
+    try:
+        with open(probe, "wb"):
+            pass
+    except OSError:
+        return os.name == "nt"
+    try:
+        return os.path.exists(os.path.join(directory, token.upper()))
+    except OSError:
+        return os.name == "nt"
+    finally:
+        try:
+            os.remove(probe)
+        except OSError:
+            pass
+
+
+def path_key(relpath: str) -> str:
+    """把相对路径规整成用于比较的键。
+
+    目标平台的文件系统如何认定“两个路径写的是同一个东西”，由本函数
+    决定；调用方不应自己再做字符串拼比较。在不区分大小写的文件系统上
+    （Windows / NTFS 默认设置），``Report.PDF`` 与 ``report.pdf`` 会得到
+    同一个键，因此不会被当成“新建一个、再删掉一个”。
+    """
+    key = relpath.replace("/", os.sep)
+    if os.altsep:
+        key = key.replace(os.altsep, os.sep)
+    if case_insensitive_fs():
+        key = key.lower()
+    return key
+
+
+def list_entries(root: str) -> Dict[str, str]:
+    """列出目录树中的所有普通文件。
+
+    返回 ``{相对路径: 绝对路径}``；``root`` 不存在时返回空字典。相对路径保留
+    磁盘上的真实大小写，比较时请交给 :func:`path_key`。
+    """
+    entries: Dict[str, str] = {}
+    if not os.path.isdir(root):
+        return entries
+    for dirpath, _dirnames, filenames in os.walk(root):
+        for name in filenames:
+            full = os.path.join(dirpath, name)
+            entries[os.path.relpath(full, root)] = full
+    return entries
+
+
+def stat_signature(path: str) -> Optional[Tuple[int, int]]:
+    """返回路径的大小与修改时间签名；读取失败时返回 ``None``。
+
+    注意：这个签名**不足以**判断内容是否变化——上游工具可能就地改写文件却把
+    原来的修改时间保留下来。判断变化请用 :func:`content_equal`。
+    """
+    try:
+        info = os.stat(path)
+    except OSError:
+        return None
+    return (info.st_size, info.st_mtime_ns)
+
+
+def content_equal(left: str, right: str) -> bool:
+    """两个文件的字节内容是否完全一致。
+
+    任意一边读不出来（不存在、被占用等）都返回 ``False``，由调用方决定要不要
+    覆盖。
+    """
+    try:
+        if os.path.samefile(left, right):
+            return True
+    except OSError:
+        pass
+    try:
+        with open(left, "rb") as left_handle, open(right, "rb") as right_handle:
+            while True:
+                left_chunk = left_handle.read(_CHUNK_SIZE)
+                right_chunk = right_handle.read(_CHUNK_SIZE)
+                if left_chunk != right_chunk:
+                    return False
+                if not left_chunk:
+                    return True
+    except OSError:
+        return False
+
+
+def is_readonly(path: str) -> bool:
+    """路径是否带有只读属性。"""
+    try:
+        info = os.stat(path)
+    except OSError:
+        return False
+    return not bool(info.st_mode & stat.S_IWRITE)
+
+
+def clear_readonly(path: str) -> bool:
+    """去掉路径上的只读属性。
+
+    确实改动了属性时返回 ``True``；路径不存在、本来就可写或者改不动时返回
+    ``False``（调用方据此决定要不要重试原操作）。
+    """
+    try:
+        info = os.stat(path)
+    except OSError:
+        return False
+    if info.st_mode & stat.S_IWRITE:
+        return False
+    try:
+        os.chmod(path, info.st_mode | stat.S_IWRITE)
+    except OSError:
+        return False
+    return True
+
+
+def _without_readonly(operation, path: str) -> None:
+    """执行 ``operation(path)``；因只读属性失败时去掉属性再试一次。"""
+    try:
+        operation(path)
+    except PermissionError:
+        if not clear_readonly(path):
+            raise
+        operation(path)
+
+
+def ensure_dir(path: str) -> None:
+    """确保 ``path`` 是一个存在的目录。
+
+    路径上被同名**文件**占住的分量会被清掉（只清挡路的那几条，不动其它
+    条目），然后逐级创建目录。
+    """
+    if not path:
+        return
+    if os.path.isdir(path):
+        return
+    blockers: List[str] = []
+    cursor = path
+    while cursor:
+        if os.path.isdir(cursor):
+            break
+        if os.path.lexists(cursor):
+            blockers.append(cursor)
+        parent = os.path.dirname(cursor)
+        if parent == cursor:
+            break
+        cursor = parent
+    for blocker in reversed(blockers):
+        remove_path(blocker)
+    os.makedirs(path, exist_ok=True)
+
+
+def remove_file(path: str) -> None:
+    """删除单个文件；文件带只读属性时先去掉属性。"""
+    _without_readonly(os.remove, path)
+
+
+def remove_dir(path: str) -> None:
+    """删除一个空目录；目录带只读属性时先去掉属性。"""
+    if os.path.islink(path):
+        remove_file(path)
+        return
+    _without_readonly(os.rmdir, path)
+
+
+def remove_path(path: str) -> None:
+    """删除一个条目：目录（含其中的内容）整棵删掉，其它按文件删。"""
+    if os.path.isdir(path) and not os.path.islink(path):
+        remove_tree(path)
+    else:
+        remove_file(path)
+
+
+def remove_tree(path: str) -> None:
+    """递归删除一棵目录树；树里只读的文件与只读的子目录同样删得掉。"""
+    if os.path.islink(path):
+        remove_file(path)
+        return
+    for dirpath, dirnames, filenames in os.walk(path, topdown=False):
+        for name in filenames:
+            remove_file(os.path.join(dirpath, name))
+        for name in dirnames:
+            remove_dir(os.path.join(dirpath, name))
+    remove_dir(path)
+
+
+def copy_times(source: str, target: str) -> None:
+    """把源文件的访问/修改时间带到目标文件上。
+
+    同步之后目标的时间戳与源一致，下一次同步就不会把刚写好的文件又当成
+    “变了”的文件重复处理。
+    """
+    info = os.stat(source)
+    os.utime(target, ns=(info.st_atime_ns, info.st_mtime_ns))
+
+
+def copy_file(source: str, target: str) -> None:
+    """把 ``source`` 的内容写到 ``target``，必要时创建父目录。
+
+    目标侧的旧状态会先被清理成“可以按文件落地”的样子：
+
+    * 父目录路径上挡着同名文件 → 只删掉那个挡路的文件；
+    * ``target`` 自身是一棵目录（源里是文件、目标里是同名目录，含只有大小写
+      不同的情形）→ 删掉那棵目录；
+    * ``target`` 带只读属性 → 去掉只读属性。
+
+    内容先写进同目录下的临时文件，再原子替换到 ``target``：目标文件被别的
+    进程占用时替换会失败，原文件保持原样，不会被截断成半个文件。写完把源
+    文件的时间戳带过去。
+    """
+    parent = os.path.dirname(target)
+    if parent:
+        ensure_dir(parent)
+    _prepare_target_file(target)
+
+    temp_path: Optional[str] = None
+    try:
+        handle, temp_path = _create_temp_file(target)
+        with open(source, "rb") as src_handle, os.fdopen(handle, "wb") as dst_handle:
+            shutil.copyfileobj(src_handle, dst_handle, length=_CHUNK_SIZE)
+            dst_handle.flush()
+        copy_times(source, temp_path)
+        _replace_with(temp_path, target)
+        temp_path = None
+    finally:
+        if temp_path is not None:
+            _discard(temp_path)
+
+
+def _prepare_target_file(target: str) -> None:
+    """把 ``target`` 这条路径清理成可以落地一个普通文件的状态。"""
+    if os.path.isdir(target) and not os.path.islink(target):
+        # 源里是文件、目标里是同一条路径上的目录：先让位。
+        remove_tree(target)
+        return
+    if os.path.lexists(target):
+        clear_readonly(target)
+
+
+def _create_temp_file(target: str) -> Tuple[int, str]:
+    """在目标所在目录里创建一个临时文件，返回 ``(fd, 路径)``。"""
+    directory = os.path.dirname(target) or "."
+    last_error: Optional[OSError] = None
+    for _ in range(_TEMP_ATTEMPTS):
+        # 临时名要短：目标路径本来就接近 MAX_PATH 时不要再添太多字符。
+        candidate = os.path.join(directory, ".{0}.wsynctmp".format(uuid.uuid4().hex[:12]))
+        try:
+            handle = os.open(
+                candidate,
+                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0),
+                0o666,
+            )
+        except FileExistsError as error:  # pragma: no cover - 名字撞车才会走到
+            last_error = error
+            continue
+        return handle, candidate
+    if last_error is not None:
+        raise last_error
+    raise OSError("cannot create a temporary file next to %r" % (target,))
+
+
+def _replace_with(temp_path: str, target: str) -> None:
+    """把临时文件原子替换到目标路径上。"""
+    try:
+        os.replace(temp_path, target)
+    except PermissionError:
+        # 目标只读时 Windows 会拒绝替换；去掉属性再试一次。
+        if not clear_readonly(target):
+            raise
+        os.replace(temp_path, target)
+
+
+def _discard(path: str) -> None:
+    """删掉写坏的临时文件，删不掉也不追究。"""
+    try:
+        remove_file(path)
+    except OSError:
+        pass
+
+
+def prune_empty_dirs(root: str) -> None:
+    """自底向上删除目标树中的空目录（不含 ``root`` 自身）。
+
+    只剩只读属性的空目录同样会被删掉；删不动的（例如被别的进程占用）保持
+    原样，不影响其它条目。
+    """
+    root = os.path.abspath(root)
+    for dirpath, _dirnames, _filenames in os.walk(root, topdown=False):
+        if os.path.abspath(dirpath) == root:
+            continue
+        try:
+            if os.listdir(dirpath):
+                continue
+        except OSError:
+            continue
+        try:
+            remove_dir(dirpath)
+        except OSError:
+            pass
