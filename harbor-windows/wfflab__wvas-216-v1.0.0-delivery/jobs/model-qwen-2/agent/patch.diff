+def _parse_multi_string(buf, char_count):
+    """Parse a double-null-terminated multi-string from a ctypes wchar buffer.
+
+    Returns a list of individual strings.
+    """
+    result = []
+    current = []
+    for i in range(char_count):
+        ch = buf[i]
+        if ch == '\0':
+            if current:
+                result.append(''.join(current))
+                current = []
+            # Check for double null (end of multi-string)
+            if i + 1 < char_count and buf[i + 1] == '\0':
+                break
+        else:
+            current.append(ch)
+    if current:
+        result.append(''.join(current))
+    return result
+
