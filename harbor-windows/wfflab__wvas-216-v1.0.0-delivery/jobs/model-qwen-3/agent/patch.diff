+++ b/_tmp_test6.py
@@ -0,0 +1,51 @@
+import ctypes, ctypes.wintypes as wt
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+nt_path = r"\Device\vmsmb\VSMB-{dcc079ae-60ba-4d07-847c-3493609c0870}\EF1C7BAF-9DC4-5D2D-AD94-D515E6FA7579\Files\Python312\python.exe"
+
+# Try opening with \\?\GLOBALROOT prefix
+unc_path = "\\\\?\\GLOBALROOT" + nt_path
+
+CF = k32.CreateFileW
+CF.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.HANDLE]
+CF.restype = wt.HANDLE
+
+GENERIC_READ = 0x80000000
+FILE_SHARE_READ = 0x00000001
+OPEN_EXISTING = 3
+FILE_FLAG_BACKUP_SEMANTICS = 0x02000000
+
+h = CF(unc_path, GENERIC_READ, FILE_SHARE_READ, None, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, None)
+err = ctypes.get_last_error()
+print(f"handle={h}, err={err}")
+
+if h and h != -1:
+    GFP = k32.GetFinalPathNameByHandleW
+    GFP.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD, wt.DWORD]
+    GFP.restype = wt.DWORD
+    
+    for flag_name, flag in [("DOS", 0), ("NT", 1), ("GUID", 2), ("VOLUME_GUID", 3)]:
+        buf = ctypes.create_unicode_buffer(1024)
+        n = GFP(h, buf, 1024, flag)
+        err2 = ctypes.get_last_error()
+        print(f"  {flag_name}: n={n}, err={err2}, value={repr(buf.value)}")
+    
+    # Try GetFileInformationByHandleEx with FileNameInfo
+    GFIBHE = k32.GetFileInformationByHandleEx
+    GFIBHE.argtypes = [wt.HANDLE, ctypes.c_int, ctypes.c_void_p, wt.DWORD]
+    GFIBHE.restype = wt.BOOL
+    
+    # FileNameInfo = 2
+    class FILE_NAME_INFO(ctypes.Structure):
+        _fields_ = [("FileNameLength", wt.DWORD), ("FileName", ctypes.c_wchar * 1024)]
+    
+    fni = FILE_NAME_INFO()
+    ok = GFIBHE(h, 2, ctypes.byref(fni), ctypes.sizeof(fni))
+    err3 = ctypes.get_last_error()
+    print(f"  FileNameInfo: ok={ok}, err={err3}, name={repr(fni.FileName[:fni.FileNameLength])}")
+    
+    CH = k32.CloseHandle
+    CH.argtypes = [wt.HANDLE]
+    CH.restype = wt.BOOL
+    CH(h)
diff --git a/_tmp_test7.py b/_tmp_test7.py
new file mode 100644
index 0000000..3d74797
--- /dev/null
+++ b/_tmp_test7.py
@@ -0,0 +1,71 @@
+import ctypes, ctypes.wintypes as wt
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+ntdll = ctypes.WinDLL("ntdll", use_last_error=True)
+
+nt_path = r"\Device\vmsmb\VSMB-{dcc079ae-60ba-4d07-847c-3493609c0870}\EF1C7BAF-9DC4-5D2D-AD94-D515E6FA7579\Files\Python312\python.exe"
+
+# Try NtOpenFile + NtQueryInformationFile
+# Or try using RtlNtPathNameToDosPathName
+
+# First, let's try the simplest approach: just check if the file exists
+# at the expected DOS location by extracting the relative path
+
+# Actually, let's try a completely different approach:
+# Use GetLongPathNameW or GetFullPathNameW on a constructed path
+
+# Or: use the fact that in this container, C: maps to the vmsmb share
+# and try to find the mapping by comparing file IDs
+
+# Let's try opening via \\.\GLOBALROOT
+unc_path = "\\\\.\\GLOBALROOT" + nt_path
+print(f"Trying: {unc_path}")
+
+CF = k32.CreateFileW
+CF.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.HANDLE]
+CF.restype = wt.HANDLE
+
+GENERIC_READ = 0x80000000
+FILE_SHARE_READ = 0x00000001
+OPEN_EXISTING = 3
+
+h = CF(unc_path, GENERIC_READ, FILE_SHARE_READ, None, OPEN_EXISTING, 0, None)
+err = ctypes.get_last_error()
+print(f"handle={h}, err={err}")
+
+if h and h != -1:
+    GFP = k32.GetFinalPathNameByHandleW
+    GFP.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD, wt.DWORD]
+    GFP.restype = wt.DWORD
+    
+    buf = ctypes.create_unicode_buffer(1024)
+    n = GFP(h, buf, 1024, 0)
+    print(f"DOS: n={n}, value={repr(buf.value)}")
+    
+    CH = k32.CloseHandle
+    CH.argtypes = [wt.HANDLE]
+    CH.restype = wt.BOOL
+    CH(h)
+
+# Try another approach: use DosPathToSessionPathW
+print("\n--- DosPathToSessionPathW ---")
+DPSP = k32.DosPathToSessionPathW
+# This function doesn't exist in kernel32, it's in kernelbase
+
+# Let's try yet another approach: enumerate all symbolic links in \??\
+# using NtQueryDirectoryObject or RegQueryValueEx on HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\DOS Devices
+
+import winreg
+try:
+    key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, r"SYSTEM\CurrentControlSet\Control\Session Manager\DOS Devices")
+    i = 0
+    while True:
+        try:
+            name, value, vtype = winreg.EnumValue(key, i)
+            print(f"  {name} = {value}")
+            i += 1
+        except OSError:
+            break
+    winreg.CloseKey(key)
+except Exception as e:
+    print(f"Registry error: {e}")
