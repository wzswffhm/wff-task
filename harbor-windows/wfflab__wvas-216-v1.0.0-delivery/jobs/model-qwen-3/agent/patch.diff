diff --git a/_tmp_test3.py b/_tmp_test3.py
new file mode 100644
index 0000000..7354690
--- /dev/null
+++ b/_tmp_test3.py
@@ -0,0 +1,56 @@
+import ctypes, ctypes.wintypes as wt
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+QDD = k32.QueryDosDeviceW
+QDD.argtypes = [wt.LPCWSTR, wt.LPWSTR, wt.DWORD]
+QDD.restype = wt.DWORD
+
+# Check all drive letters
+dbuf = ctypes.create_unicode_buffer(260)
+for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
+    drive = c + ":"
+    n = QDD(drive, dbuf, 260)
+    if n:
+        print(f"{drive} -> {dbuf.value}")
+
+# Also check GetLogicalDrives
+GD = k32.GetLogicalDrives
+GD.restype = wt.DWORD
+bits = GD()
+print(f"\nLogical drives bitmask: {bits:#010x}")
+for i in range(26):
+    if bits & (1 << i):
+        print(f"  {chr(65+i)}: is available")
+
+# Try FindFirstVolume / FindNextVolume
+FFV = k32.FindFirstVolumeW
+FFV.argtypes = [wt.LPWSTR, wt.DWORD]
+FFV.restype = wt.HANDLE
+FNV = k32.FindNextVolumeW
+FNV.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD]
+FNV.restype = wt.BOOL
+FVC = k32.FindVolumeClose
+FVC.argtypes = [wt.HANDLE]
+FVC.restype = wt.BOOL
+
+vol_buf = ctypes.create_unicode_buffer(260)
+h = FFV(vol_buf, 260)
+if h and h != -1:
+    print("\nVolumes:")
+    while True:
+        print(f"  {vol_buf.value}")
+        # Get volume path names
+        GVPN = k32.GetVolumePathNamesForVolumeNameW
+        GVPN.argtypes = [wt.LPCWSTR, wt.LPWSTR, wt.DWORD, ctypes.POINTER(wt.DWORD)]
+        GVPN.restype = wt.BOOL
+        path_buf = ctypes.create_unicode_buffer(1024)
+        ret_len = wt.DWORD()
+        ok = GVPN(vol_buf.value, path_buf, 1024, ctypes.byref(ret_len))
+        if ok:
+            paths = path_buf.value.split('\x00')
+            for p in paths:
+                if p:
+                    print(f"    mounted at: {p}")
+        if not FNV(h, vol_buf, 260):
+            break
+    FVC(h)
diff --git a/_tmp_test4.py b/_tmp_test4.py
new file mode 100644
index 0000000..9df73e6
--- /dev/null
+++ b/_tmp_test4.py
@@ -0,0 +1,49 @@
+import ctypes, ctypes.wintypes as wt, os
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+nt_path = r"\Device\vmsmb\VSMB-{dcc079ae-60ba-4d07-847c-3493609c0870}\EF1C7BAF-9DC4-5D2D-AD94-D515E6FA7579\Files\Python312\python.exe"
+unc_path = "\\\\?\\GLOBALROOT" + nt_path
+
+CF = k32.CreateFileW
+CF.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.HANDLE]
+CF.restype = wt.HANDLE
+
+GENERIC_READ = 0x80000000
+FILE_SHARE_READ = 0x00000001
+OPEN_EXISTING = 3
+FILE_ATTRIBUTE_NORMAL = 0x80
+
+h = CF(unc_path, GENERIC_READ, FILE_SHARE_READ, None, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, None)
+if h and h != -1:
+    print("Opened successfully!")
+    GFP = k32.GetFinalPathNameByHandleW
+    GFP.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD, wt.DWORD]
+    GFP.restype = wt.DWORD
+    
+    for flag in [0, 1, 2, 3]:
+        buf = ctypes.create_unicode_buffer(1024)
+        n = GFP(h, buf, 1024, flag)
+        err = ctypes.get_last_error()
+        print(f"flag={flag}: n={n}, err={err}, value={repr(buf.value)}")
+    
+    CH = k32.CloseHandle
+    CH.argtypes = [wt.HANDLE]
+    CH.restype = wt.BOOL
+    CH(h)
+else:
+    err = ctypes.get_last_error()
+    print(f"Failed to open, error={err}")
+
+# Also try with \\?\ prefix directly on the NT path (without GLOBALROOT)
+print("\n--- Try without GLOBALROOT ---")
+unc_path2 = "\\\\?" + nt_path
+h2 = CF(unc_path2, GENERIC_READ, FILE_SHARE_READ, None, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, None)
+if h2 and h2 != -1:
+    print("Opened!")
+    buf = ctypes.create_unicode_buffer(1024)
+    n = GFP(h2, buf, 1024, 0)
+    print(f"DOS: n={n}, value={repr(buf.value)}")
+    CH(h2)
+else:
+    print(f"Failed, err={ctypes.get_last_error()}")
diff --git a/_tmp_test5.py b/_tmp_test5.py
new file mode 100644
index 0000000..15c7ae8
--- /dev/null
+++ b/_tmp_test5.py
@@ -0,0 +1,28 @@
+import ctypes, os
+import wvas._winapi as w
+
+handle = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ, False, os.getpid())
+mbi = w.MEMORY_BASIC_INFORMATION()
+address = 0
+image_paths = set()
+count = 0
+
+while address < 0x7FFFFFFFFFFF:
+    written = w.VirtualQueryEx(handle, ctypes.c_void_p(address), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not written:
+        break
+    if mbi.Type == w.MEM_IMAGE and mbi.State == w.MEM_COMMIT:
+        buf = ctypes.create_unicode_buffer(1024)
+        n = w.GetMappedFileNameW(handle, ctypes.c_void_p(mbi.BaseAddress), buf, 1024)
+        if n:
+            image_paths.add(buf.value)
+    next_addr = (mbi.BaseAddress or 0) + mbi.RegionSize
+    if next_addr <= address:
+        break
+    address = next_addr
+
+w.CloseHandle(handle)
+
+print(f"Unique image paths ({len(image_paths)}):")
+for p in sorted(image_paths):
+    print(f"  {p}")
