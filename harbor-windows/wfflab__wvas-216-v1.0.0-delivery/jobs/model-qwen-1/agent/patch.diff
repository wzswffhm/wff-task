diff --git a/_tmp_check6.py b/_tmp_check6.py
new file mode 100644
index 0000000..a0a2b53
--- /dev/null
+++ b/_tmp_check6.py
@@ -0,0 +1,21 @@
+import os, ctypes, ctypes.wintypes as wt
+from wvas import _winapi as w
+
+h = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ, False, os.getpid())
+mbi = w.MEMORY_BASIC_INFORMATION()
+addr = 0
+found = 0
+while addr < 0x7FFFFFFFFFFF and found < 5:
+    ret = w.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not ret:
+        break
+    if mbi.Type == w.MEM_IMAGE and mbi.State == w.MEM_COMMIT:
+        buf = ctypes.create_unicode_buffer(1024)
+        n = w.GetMappedFileNameW(h, ctypes.c_void_p(mbi.BaseAddress), buf, 1024)
+        print(f'Image at {hex(mbi.BaseAddress)}: GetMappedFileNameW returned {n}, path={repr(buf.value[:n] if n else "")}')
+        found += 1
+    nxt = (mbi.BaseAddress or 0) + mbi.RegionSize
+    if nxt <= addr:
+        break
+    addr = nxt
+w.CloseHandle(h)
diff --git a/_tmp_check7.py b/_tmp_check7.py
new file mode 100644
index 0000000..d726a5c
--- /dev/null
+++ b/_tmp_check7.py
@@ -0,0 +1,29 @@
+import os, ctypes, ctypes.wintypes as wt
+from wvas import _winapi as w
+
+psapi = ctypes.WinDLL("psapi", use_last_error=True)
+GetModuleFileNameExW = psapi.GetModuleFileNameExW
+GetModuleFileNameExW.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.LPWSTR, wt.DWORD]
+GetModuleFileNameExW.restype = wt.DWORD
+
+h = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ, False, os.getpid())
+mbi = w.MEMORY_BASIC_INFORMATION()
+addr = 0
+found = 0
+while addr < 0x7FFFFFFFFFFF and found < 5:
+    ret = w.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not ret:
+        break
+    if mbi.Type == w.MEM_IMAGE and mbi.State == w.MEM_COMMIT:
+        # Try GetModuleFileNameExW with the AllocationBase
+        alloc_base = mbi.AllocationBase
+        buf = ctypes.create_unicode_buffer(1024)
+        n = GetModuleFileNameExW(h, ctypes.c_void_p(alloc_base), buf, 1024)
+        err = ctypes.get_last_error()
+        print(f'Image at {hex(mbi.BaseAddress)} alloc={hex(alloc_base or 0)}: GetModuleFileNameExW returned {n}, err={err}, path={repr(buf.value[:n] if n else "")}')
+        found += 1
+    nxt = (mbi.BaseAddress or 0) + mbi.RegionSize
+    if nxt <= addr:
+        break
+    addr = nxt
+w.CloseHandle(h)
