+def _get_max_user_address():
+    """Return the maximum user-mode address for this system."""
+    si = w.SYSTEM_INFO()
+    w.GetSystemInfo(ctypes.byref(si))
+    return si.lpMaximumApplicationAddress or 0x7FFFFFFFFFFF
+
+
+def _build_dos_device_map():
+    """Build a mapping from NT device paths to DOS drive letters.
+
+    Returns a list of (device_prefix, drive_letter) tuples sorted by
+    longest prefix first so that the most specific match wins.
+    """
+    entries = []
+    for letter_ord in range(ord('A'), ord('Z') + 1):
+        letter = chr(letter_ord)
+        drive_spec = letter + ":"
+        buf = ctypes.create_unicode_buffer(256)
+        ret = w.QueryDosDeviceW(drive_spec, buf, 256)
+        if ret:
+            device_path = buf.value
+            if device_path:
+                entries.append((device_path, letter + ":"))
+    # Sort by length descending so longer (more specific) prefixes match first
+    entries.sort(key=lambda e: len(e[0]), reverse=True)
+    return entries
+
+
+def _nt_to_dos_path(nt_path, dos_map):
+    """Convert an NT device path to a DOS drive-letter path.
+
+    *nt_path* is something like ``\\Device\\HarddiskVolume4\\Windows\\...``.
+    Returns the equivalent ``C:\\Windows\\...`` string, or ``None`` if the
+    conversion cannot be performed.
+    """
+    if not nt_path:
+        return None
+
+    for device_prefix, drive_letter in dos_map:
+        if nt_path.startswith(device_prefix):
+            remainder = nt_path[len(device_prefix):]
+            # Ensure we matched at a path boundary
+            if remainder == "" or remainder.startswith("\\"):
+                if remainder == "":
+                    return drive_letter + "\\"
+                return drive_letter + remainder
+
+    # Handle \\??\\ prefix (sometimes seen)
+    if nt_path.startswith("\\??\\"):
+        candidate = nt_path[4:]
+        if len(candidate) >= 2 and candidate[1] == ':':
+            return candidate
+
+    # Already a DOS path?
+    if len(nt_path) >= 3 and nt_path[1] == ':' and nt_path[2] == '\\':
+        return nt_path
+
+    # UNC path (\\server\share\...)
+    if nt_path.startswith("\\\\") and not nt_path.startswith("\\\\?\\"):
+        return nt_path
+
+    return None
+
