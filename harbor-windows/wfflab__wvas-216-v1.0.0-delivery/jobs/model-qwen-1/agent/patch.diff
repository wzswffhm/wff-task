diff --git a/_tmp_check.py b/_tmp_check.py
new file mode 100644
index 0000000..c95ad90
--- /dev/null
+++ b/_tmp_check.py
@@ -0,0 +1,33 @@
+import ctypes, ctypes.wintypes as wt
+k = ctypes.WinDLL('kernel32', use_last_error=True)
+
+class SI(ctypes.Structure):
+    _fields_ = [
+        ('dwPageSize', wt.DWORD),
+        ('lpMinimumApplicationAddress', ctypes.c_void_p),
+        ('lpMaximumApplicationAddress', ctypes.c_void_p),
+        ('dwActiveProcessorMask', ctypes.POINTER(ctypes.c_ulong)),
+        ('dwNumberOfProcessors', wt.DWORD),
+        ('dwProcessorType', wt.DWORD),
+        ('dwAllocationGranularity', wt.DWORD),
+        ('wProcessorLevel', wt.WORD),
+        ('wProcessorRevision', wt.WORD),
+    ]
+
+si = SI()
+k.GetSystemInfo(ctypes.byref(si))
+print('MaxAppAddr=', hex(si.lpMaximumApplicationAddress or 0))
+print('MinAppAddr=', hex(si.lpMinimumApplicationAddress or 0))
+
+# Also check ERROR codes for OpenProcess
+ERROR_INVALID_PARAMETER = 87
+ERROR_ACCESS_DENIED = 5
+print('Testing OpenProcess with invalid pid...')
+h = k.OpenProcess(0x0400 | 0x0010, False, 99999)
+err = ctypes.get_last_error()
+print(f'handle={h}, last_error={err}')
+
+# Test with negative pid (will wrap to large DWORD)
+h2 = k.OpenProcess(0x0400 | 0x0010, False, 0xFFFFFFFF)
+err2 = ctypes.get_last_error()
+print(f'handle2={h2}, last_error2={err2}')
diff --git a/_tmp_check2.py b/_tmp_check2.py
new file mode 100644
index 0000000..a9c0a94
--- /dev/null
+++ b/_tmp_check2.py
@@ -0,0 +1,25 @@
+import ctypes, ctypes.wintypes as wt, os
+k = ctypes.WinDLL('kernel32', use_last_error=True)
+
+# Find a pid that doesn't exist - try high numbers
+for test_pid in [99999, 88888, 77777]:
+    h = k.OpenProcess(0x0400 | 0x0010, False, test_pid)
+    err = ctypes.get_last_error()
+    print(f'pid={test_pid}: handle={h}, error={err}')
+    if h:
+        k.CloseHandle(h)
+
+# Try to open system process (should get access denied)
+# PID 4 is usually System
+h = k.OpenProcess(0x0400 | 0x0010, False, 4)
+err = ctypes.get_last_error()
+print(f'pid=4 (System): handle={h}, error={err}')
+if h:
+    k.CloseHandle(h)
+
+# Current process should work
+h = k.OpenProcess(0x0400 | 0x0010, False, os.getpid())
+err = ctypes.get_last_error()
+print(f'pid={os.getpid()} (self): handle={h}, error={err}')
+if h:
+    k.CloseHandle(h)
diff --git a/_tmp_check3.py b/_tmp_check3.py
new file mode 100644
index 0000000..6794638
--- /dev/null
+++ b/_tmp_check3.py
@@ -0,0 +1,35 @@
+import ctypes, ctypes.wintypes as wt
+k = ctypes.WinDLL('kernel32', use_last_error=True)
+
+# ERROR codes
+ERROR_INVALID_PARAMETER = 87
+ERROR_ACCESS_DENIED = 5
+
+# For non-existent process, OpenProcess returns ERROR_INVALID_PARAMETER
+# But we should also check if it could be something else
+# The standard approach: try to open, check error code
+
+# Also test: what does GetMappedFileNameW return for anonymous mapping?
+import os
+from wvas import _winapi as w
+
+h = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ, False, os.getpid())
+mbi = w.MEMORY_BASIC_INFORMATION()
+addr = 0
+anon_count = 0
+while addr < 0x7FFFFFFFFFFF and anon_count < 3:
+    ret = w.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not ret:
+        break
+    if mbi.State == w.MEM_COMMIT and mbi.Type == w.MEM_PRIVATE:
+        # Private memory - no file backing
+        buf = ctypes.create_unicode_buffer(260)
+        n = w.GetMappedFileNameW(h, ctypes.c_void_p(mbi.BaseAddress), buf, 260)
+        print(f'Private at {hex(mbi.BaseAddress)}: GetMappedFileNameW returned {n}, buf={repr(buf.value)}')
+        anon_count += 1
+    nxt = (mbi.BaseAddress or 0) + mbi.RegionSize
+    if nxt <= addr:
+        break
+    addr = nxt
+
+w.CloseHandle(h)
diff --git a/_tmp_check4.py b/_tmp_check4.py
new file mode 100644
index 0000000..b553f87
--- /dev/null
+++ b/_tmp_check4.py
@@ -0,0 +1,53 @@
+import ctypes, ctypes.wintypes as wt
+
+k = ctypes.WinDLL('kernel32', use_last_error=True)
+
+def nt_to_dos_path(nt_path):
+    """Convert \\Device\\HarddiskVolumeN\\... to X:\\..."""
+    if not nt_path:
+        return None
+    
+    # Handle \\Device\\HarddiskVolumeN\\... format
+    prefix = '\\Device\\HarddiskVolume'
+    if nt_path.startswith(prefix):
+        # Extract volume number
+        rest = nt_path[len(prefix):]
+        slash_pos = rest.find('\\')
+        if slash_pos == -1:
+            return None
+        vol_num = rest[:slash_pos]
+        sub_path = rest[slash_pos:]  # includes leading backslash
+        
+        # Find which drive letter maps to this volume
+        # Try all drive letters A-Z
+        for letter_ord in range(ord('A'), ord('Z') + 1):
+            letter = chr(letter_ord) + ':'
+            dos_buf = ctypes.create_unicode_buffer(256)
+            ret = k.QueryDosDeviceW(letter, dos_buf, 256)
+            if ret and dos_buf.value == '\\Device\\HarddiskVolume' + vol_num:
+                return letter + sub_path
+    
+    # Handle \\??\\... format  
+    if nt_path.startswith('\\??\\'):
+        return nt_path[4:]
+    
+    # Already a DOS path?
+    if len(nt_path) >= 2 and nt_path[1] == ':':
+        return nt_path
+    
+    # UNC path
+    if nt_path.startswith('\\\\'):
+        return nt_path
+    
+    return None
+
+# Test
+test_paths = [
+    '\\Device\\HarddiskVolume4\\Windows\\System32\\kernel32.dll',
+    '\\Device\\HarddiskVolume4\\Users\\test\\file.txt',
+    '',
+    None,
+]
+
+for p in test_paths:
+    print(f'{repr(p)} -> {repr(nt_to_dos_path(p))}')
