new file mode 100644
index 0000000..1b83599
--- /dev/null
+++ b/_target.py
@@ -0,0 +1,60 @@
+"""Throwaway verification target. Deleted after use."""
+import ctypes, os, sys, tempfile, time
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+k.VirtualAlloc.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_ulong,
+                           ctypes.c_ulong]
+k.VirtualAlloc.restype = ctypes.c_void_p
+k.CreateFileMappingW.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong,
+                                 ctypes.c_ulong, ctypes.c_ulong, ctypes.c_wchar_p]
+k.CreateFileMappingW.restype = ctypes.c_void_p
+k.MapViewOfFile.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong,
+                            ctypes.c_ulong, ctypes.c_size_t]
+k.MapViewOfFile.restype = ctypes.c_void_p
+k.CreateFileW.argtypes = [ctypes.c_wchar_p, ctypes.c_ulong, ctypes.c_ulong,
+                          ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong,
+                          ctypes.c_void_p]
+k.CreateFileW.restype = ctypes.c_void_p
+
+MEM_RESERVE = 0x2000
+MEM_COMMIT = 0x1000
+PAGE_READWRITE = 0x04
+PAGE_NOACCESS = 0x01
+INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
+
+SIX_GIB = 6 * 1024 * 1024 * 1024
+
+facts = {}
+
+reserved = k.VirtualAlloc(None, SIX_GIB, MEM_RESERVE, PAGE_NOACCESS)
+assert reserved, ctypes.get_last_error()
+facts["reserve_base"] = reserved
+facts["reserve_size"] = SIX_GIB
+
+# a real file mapping
+path = os.path.join(tempfile.gettempdir(), "wvas_verify_%d.bin" % os.getpid())
+with open(path, "wb") as fh:
+    fh.write(b"z" * 0x20000)
+fh = k.CreateFileW(path, 0x80000000, 1, None, 3, 0x80, None)
+assert fh != INVALID_HANDLE_VALUE, ctypes.get_last_error()
+mapping = k.CreateFileMappingW(fh, None, 0x02, 0, 0, None)
+assert mapping, ctypes.get_last_error()
+view = k.MapViewOfFile(mapping, 0x04, 0, 0, 0x20000)
+assert view, ctypes.get_last_error()
+facts["file_view"] = view
+facts["file_path"] = path
+
+# an anonymous (pagefile backed) mapping
+anon_map = k.CreateFileMappingW(INVALID_HANDLE_VALUE, None, PAGE_READWRITE,
+                                0, 0x10000, None)
+assert anon_map, ctypes.get_last_error()
+anon = k.MapViewOfFile(anon_map, 0x0002, 0, 0, 0x10000)
+assert anon, ctypes.get_last_error()
+facts["anon_view"] = anon
+
+# private committed memory
+priv = k.VirtualAlloc(None, 0x30000, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE)
+facts["private"] = priv
+
+print(repr(facts), flush=True)
+sys.stdin.readline()
diff --git a/_verify.py b/_verify.py
new file mode 100644
index 0000000..cfc84c1
--- /dev/null
+++ b/_verify.py
@@ -0,0 +1,140 @@
+"""Throwaway verification driver. Deleted after use."""
+import ast, ctypes, os, subprocess, sys, time
+
+import wvas
+import wvas._winapi as w
+
+proc = subprocess.Popen([sys.executable, "_target.py"], stdout=subprocess.PIPE,
+                        stdin=subprocess.PIPE, text=True)
+facts = ast.literal_eval(proc.stdout.readline().strip())
+pid = proc.pid
+print("target pid", pid)
+
+try:
+    regs = wvas.regions(pid)
+    by_base = {r["base"]: r for r in regs}
+
+    # --- independent measurement with VirtualQueryEx on our own handle ----
+    handle = w.OpenProcess(w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ,
+                           False, pid)
+    assert handle, ctypes.get_last_error()
+    truth = []
+    mbi = w.MEMORY_BASIC_INFORMATION()
+    addr = 0
+    info = w.SYSTEM_INFO(); w.GetNativeSystemInfo(ctypes.byref(info))
+    top = int(info.lpMaximumApplicationAddress)
+    while addr <= top:
+        if not w.VirtualQueryEx(handle, ctypes.c_void_p(addr),
+                                ctypes.byref(mbi), ctypes.sizeof(mbi)):
+            break
+        if mbi.State in (w.MEM_COMMIT, w.MEM_RESERVE):
+            truth.append((int(mbi.BaseAddress or 0), int(mbi.RegionSize)))
+        nxt = int(mbi.BaseAddress or 0) + int(mbi.RegionSize)
+        if nxt <= addr:
+            break
+        addr = nxt
+    w.CloseHandle(handle)
+
+    mine = [(r["base"], r["size"]) for r in regs]
+    print("counts: reported", len(mine), "measured", len(truth))
+    only_mine = set(mine) - set(truth)
+    only_truth = set(truth) - set(mine)
+    print("report-only", len(only_mine), "measure-only", len(only_truth))
+
+    # --- the 6 GiB reservation -------------------------------------------
+    rb = facts["reserve_base"]
+    hits = [r for r in regs if r["base"] == rb]
+    print("6GiB reservation entry:", [(hex(h['base']), hex(h['size']), h['state'],
+                                       h['type'], h['path']) for h in hits])
+    total = sum(r["size"] for r in regs
+                if rb <= r["base"] < rb + facts["reserve_size"])
+    print("6GiB span reported:", hex(total), "expected", hex(facts["reserve_size"]))
+    assert total == facts["reserve_size"], "reservation length wrong"
+    assert any(r["state"] == "reserve" for r in regs), "no reserve state"
+
+    # --- file mapping path ------------------------------------------------
+    fv = facts["file_view"]
+    hit = [r for r in regs if r["base"] <= fv < r["base"] + r["size"]][0]
+    print("file view:", hit["type"], repr(hit["path"]))
+    print("expected  :", repr(facts["file_path"]))
+    assert hit["path"] is not None
+    assert os.path.normcase(hit["path"]) == os.path.normcase(facts["file_path"]), hit["path"]
+    assert os.path.exists(hit["path"])
+
+    # --- anonymous mapping -----------------------------------------------
+    av = facts["anon_view"]
+    hit = [r for r in regs if r["base"] <= av < r["base"] + r["size"]][0]
+    print("anon view:", hit["type"], repr(hit["path"]))
+    assert hit["path"] is None, "anonymous mapping must have path None"
+
+    # --- private memory ---------------------------------------------------
+    pv = facts["private"]
+    hit = [r for r in regs if r["base"] <= pv < r["base"] + r["size"]][0]
+    print("private:", hit["type"], repr(hit["path"]), hit["state"])
+    assert hit["path"] is None and hit["type"] == "private"
+
+    # --- include_reserved=False ------------------------------------------
+    committed = wvas.regions(pid, include_reserved=False)
+    assert all(r["state"] == "commit" for r in committed)
+    assert len(committed) < len(regs)
+    print("committed", len(committed), "all", len(regs))
+
+    # --- paths all openable ----------------------------------------------
+    backed = wvas.file_backed_regions(pid)
+    bad = [r["path"] for r in backed
+           if r["path"].startswith(("\\Device", "\\??", "\\\\?\\"))]
+    missing = [r["path"] for r in backed if not os.path.exists(r["path"])]
+    print("file_backed", len(backed), "bad-prefix", bad[:3], "missing", missing[:3])
+    assert not bad and not missing
+    assert [ (r["base"],r["size"]) for r in backed ] == \
+           [ (r["base"],r["size"]) for r in regs if r["path"] is not None ]
+
+    # --- modules ----------------------------------------------------------
+    mods = wvas.modules(pid)
+    paths = [m["path"] for m in mods]
+    print("modules", len(mods), "none-paths", sum(p is None for p in paths))
+    lowered = [p.lower() for p in paths if p]
+    assert len(lowered) == len(set(lowered)), "duplicate module paths"
+    assert [m["base"] for m in mods] == sorted(m["base"] for m in mods)
+    for m in mods:
+        if m["path"]:
+            assert os.path.exists(m["path"]), m["path"]
+            assert not m["path"].startswith(("\\Device", "\\??", "\\\\?\\"))
+    names = sorted(os.path.basename(p).lower() for p in paths if p)
+    print("sample modules", names[:6], "... total", len(names))
+    assert any(n.endswith("python.exe") for n in names)
+    assert any(n == "ntdll.dll" for n in names)
+
+    print("ALL CHECKS PASSED")
+finally:
+    try:
+        proc.stdin.write("\n"); proc.stdin.flush()
+    except Exception:
+        pass
+    proc.wait(timeout=10)
+
+# --- error taxonomy on a dead pid ---------------------------------------
+time.sleep(0.3)
+try:
+    wvas.regions(pid)
+    print("dead pid: NO ERROR (unexpected)")
+except wvas.WVasError as exc:
+    print("dead pid kind:", exc.kind)
+except OSError as exc:
+    print("dead pid leaked OSError:", exc)
+
+for bad_pid in (-1, 0, "x", 2**40, True):
+    try:
+        wvas.regions(bad_pid)
+        print("bad pid", repr(bad_pid), "-> no error")
+    except wvas.WVasError as exc:
+        print("bad pid", repr(bad_pid), "->", exc.kind)
+    except Exception as exc:
+        print("bad pid", repr(bad_pid), "-> LEAK", type(exc).__name__, exc)
+
+try:
+    wvas.regions(4)   # System process
+except wvas.WVasError as exc:
+    print("pid 4 ->", exc.kind)
+except Exception as exc:
+    print("pid 4 -> LEAK", type(exc).__name__, exc)
