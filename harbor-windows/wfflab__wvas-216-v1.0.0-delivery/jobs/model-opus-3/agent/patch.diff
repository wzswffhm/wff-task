+"""Virtual address space auditing for the wvas diagnostic collector.
+
+The collector asks three questions about a target process:
+
+``regions(pid)``
+    Which parts of the virtual address space does the process have in use?
+
+``file_backed_regions(pid)``
+    Which of those parts are backed by a file on disk, and which file?
+
+``modules(pid)``
+    Which executable images are loaded, and where?
+
+The answers are what the field engineers read when a machine reports
+"something keeps the log file mapped" or "the process has no address space
+left", so they have to describe the target process, not a snapshot of an
+earlier call.
+
+Three properties matter for every number reported here.
+
+* Addresses and lengths are reported at full pointer width.  A 64 bit target
+  has regions far above 4 GiB and reservations larger than 4 GiB, so nothing
+  may be masked down to 32 bits.
+* Both committed and reserved ranges are walked, because a reservation is
+  exactly what a caller asking "where did the address space go?" is after.
+* A path is only reported when the caller can open it.  The kernel names a
+  mapped file with an NT device path (``\\Device\\HarddiskVolume3\\...``);
+  that name is translated back to a DOS or UNC path before it leaves the
+  module, and a region with nothing behind it reports ``None`` rather than an
+  empty string.
+"""
+
+import ctypes
+
+from . import _winapi as w
+from .errors import WVasError
+
+#: Initial character count for path buffers.  Grown on demand, because an NT
+#: device path can be considerably longer than ``MAX_PATH``.
+PATH_BUFFER_CHARS = 1024
+
+#: Upper bound for the buffer growth loops (the Win32 long path limit).
+_MAX_PATH_BUFFER_CHARS = 32768
+
+_PROTECTION_NAMES = {
+    w.PAGE_NOACCESS: "none",
+    w.PAGE_READONLY: "r",
+    w.PAGE_READWRITE: "rw",
+    w.PAGE_WRITECOPY: "wc",
+    w.PAGE_EXECUTE: "x",
+    w.PAGE_EXECUTE_READ: "xr",
+    w.PAGE_EXECUTE_READWRITE: "xrw",
+    w.PAGE_EXECUTE_WRITECOPY: "xwc",
+}
+
+_TYPE_NAMES = {
+    w.MEM_IMAGE: "image",
+    w.MEM_MAPPED: "mapped",
+    w.MEM_PRIVATE: "private",
+}
+
+#: NT devices that stand for a remote share rather than a local volume.
+_UNC_DEVICE_PREFIXES = (
+    "\\Device\\Mup\\",
+    "\\Device\\LanmanRedirector\\",
+    "\\Device\\WinDfs\\Root\\",
+    "\\Device\\WebDavRedirector\\",
+)
+
+
+def protection_name(protect):
+    """Map a PAGE_* protection value onto its short textual name.
+
+    Pure: a constant goes in, a short name comes out.  No process is queried.
+    """
+    return _PROTECTION_NAMES.get(protect & 0xFF, "?")
+
+
+def type_name(region_type):
+    """Map a MEM_* region type onto its short textual name.
+
+    Pure: a constant goes in, a short name comes out.  No process is queried.
+    """
+    return _TYPE_NAMES.get(region_type, "private")
+
+
+# --------------------------------------------------------------------------
+# platform and handle plumbing
+# --------------------------------------------------------------------------
+
+def _require_windows(pid=None):
+    if not w.AVAILABLE:
+        raise WVasError(
+            "virtual address space auditing is only supported on Windows",
+            kind="unsupported",
+            pid=pid,
+        )
+
+
+def _check_pid(pid):
+    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
+        raise WVasError("pid must be a positive integer", kind="badarg", pid=pid)
+    if pid > 0xFFFFFFFF:
+        raise WVasError("pid is out of range for a process id", kind="badarg",
+                        pid=pid)
+
+
+def _open_process(pid):
+    """Open ``pid`` for reading, or raise a classified :class:`WVasError`."""
+    _check_pid(pid)
+    _require_windows(pid)
+
+    # The full query needs PROCESS_QUERY_INFORMATION | PROCESS_VM_READ.  A more
+    # privileged or protected process may still answer the cheaper
+    # limited-information query, so step down instead of giving up: a partial
+    # answer beats an access-denied failure.
+    error = 0
+    for access in (
+        w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ | w.SYNCHRONIZE,
+        w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ,
+        w.PROCESS_QUERY_INFORMATION,
+        w.PROCESS_QUERY_LIMITED_INFORMATION,
+    ):
+        ctypes.set_last_error(0)
+        handle = w.OpenProcess(access, False, pid)
+        if handle:
+            if _has_exited(handle):
+                # The pid still has a handle open somewhere, so OpenProcess
+                # succeeds, but the process itself is gone: its address space
+                # no longer exists and every query would fail obscurely.
+                _close(handle)
+                raise WVasError(
+                    "no such process", kind="no-such-process", pid=pid
+                )
+            return handle
+        error = w.last_error()
+        if error != w.ERROR_ACCESS_DENIED:
+            break
+
+    raise _classify_open_error(error, pid)
+
+
+def _has_exited(handle):
+    """Whether ``handle`` names a process that has already terminated."""
+    code = w.DWORD(0)
+    if not w.GetExitCodeProcess(handle, ctypes.byref(code)):
+        return False
+    if code.value != w.STILL_ACTIVE:
+        return True
+    # A process may legitimately exit *with* code 259, which is
+    # indistinguishable from "still running" here, so confirm by asking
+    # whether the process object is signalled.  Needs SYNCHRONIZE; without it
+    # the wait fails and the process is taken to be alive.
+    return w.WaitForSingleObject(handle, 0) == w.WAIT_OBJECT_0
+
+
+def _classify_open_error(error, pid):
+    if error == w.ERROR_ACCESS_DENIED:
+        return WVasError(
+            "process exists but cannot be opened for reading",
+            kind="access-denied",
+            pid=pid,
+        )
+    if error in (w.ERROR_INVALID_PARAMETER, w.ERROR_INVALID_HANDLE):
+        # OpenProcess reports ERROR_INVALID_PARAMETER when the pid does not
+        # name a live process.
+        return WVasError("no such process", kind="no-such-process", pid=pid)
+    return WVasError(
+        "OpenProcess failed (error %d)" % (error,),
+        kind="query-failed",
+        pid=pid,
+    )
+
+
+def _close(handle):
+    if handle:
+        w.CloseHandle(handle)
+
+
+# --------------------------------------------------------------------------
+# raw Win32 name lookups
+# --------------------------------------------------------------------------
+
+def _mapped_file_name(handle, address):
+    """NT name of the file backing ``address``, or ``None`` if there is none."""
+    chars = PATH_BUFFER_CHARS
+    while chars <= _MAX_PATH_BUFFER_CHARS:
+        buffer = ctypes.create_unicode_buffer(chars)
+        written = w.GetMappedFileNameW(
+            handle, ctypes.c_void_p(address), buffer, chars
+        )
+        if not written:
+            # Nothing mapped from a file at this address: private memory, a
+            # reservation, or a pagefile-backed anonymous mapping.
+            return None
+        if written >= chars - 1:
+            chars *= 2
+            continue
+        return buffer.value or None
+    return None
+
+
+def _module_file_name(handle, module):
+    """Loader's own file name for ``module``, or ``None``."""
+    chars = PATH_BUFFER_CHARS
+    while chars <= _MAX_PATH_BUFFER_CHARS:
+        buffer = ctypes.create_unicode_buffer(chars)
+        written = w.GetModuleFileNameExW(handle, module, buffer, chars)
+        if not written:
+            return None
+        if written >= chars - 1:
+            chars *= 2
+            continue
+        return buffer.value or None
+    return None
+
+
+def _module_size(handle, module):
+    """``SizeOfImage`` of ``module``, or ``None`` when it cannot be read."""
+    info = w.MODULEINFO()
+    if not w.GetModuleInformation(
+        handle, module, ctypes.byref(info), ctypes.sizeof(info)
+    ):
+        return None
+    return int(info.SizeOfImage) or None
+
+
+def _enumerate_module_handles(handle):
+    """Return the HMODULE bases loaded into ``handle``, 32 and 64 bit alike."""
+    needed = w.DWORD(0)
+    count = 256
+    while count <= 1 << 16:
+        array = (w.HANDLE * count)()
+        ok = w.EnumProcessModulesEx(
+            handle,
+            array,
+            ctypes.sizeof(array),
+            ctypes.byref(needed),
+            w.LIST_MODULES_ALL,
+        )
+        if not ok:
+            # A process we may query but not read cannot be enumerated; the
+            # region walk still describes its images.
+            return []
+        returned = needed.value // ctypes.sizeof(w.HANDLE)
+        if returned > count:
+            count = returned + 64
+            continue
+        return [int(array[i] or 0) for i in range(returned) if array[i]]
+    return []
+
+
+# --------------------------------------------------------------------------
+# NT device path -> openable DOS / UNC path
+# --------------------------------------------------------------------------
+
+def _is_dos_path(path):
+    return (
+        len(path) >= 3
+        and path[0].isalpha()
+        and path[1] == ":"
+        and path[2] == "\\"
+    )
+
+
+def _strip_nt_prefix(path):
+    """Drop the ``\\??\\`` / ``\\\\?\\`` escapes, which callers cannot open."""
+    for prefix in ("\\\\?\\", "\\??\\"):
+        if path.startswith(prefix):
+            rest = path[len(prefix):]
+            if rest[:4].upper() == "UNC\\":
+                return "\\\\" + rest[4:]
+            return rest
+    return path
+
+
+def _common_suffix_length(left, right):
+    limit = min(len(left), len(right))
+    count = 0
+    while count < limit and left[-1 - count].lower() == right[-1 - count].lower():
+        count += 1
+    return count
+
+
+class _PathResolver:
+    """Turns the NT names Win32 reports into paths a caller can open.
+
+    Resolution is tried in order of reliability:
+
+    1. the drive letter table (``QueryDosDevice`` over the logical drives),
+    2. prefixes learned by pairing a module's NT name with the DOS name the
+       loader reports for the same module -- this is what resolves devices
+       that carry no drive letter, such as a container's image layers,
+    3. opening the device name through ``\\\\?\\GLOBALROOT`` and asking the
+       file system for its final DOS name.
+
+    When none of those yields a DOS or UNC path, the name is unusable and the
+    resolver reports ``None`` rather than an unopenable ``\\Device\\...``
+    string.
+    """
+
+    def __init__(self, handle=None):
+        self._handle = handle
+        self._devices = _dos_device_map()
+        self._learned = {}
+        self._cache = {}
+        if handle is not None:
+            self._learn_from_modules(handle)
+
+    # -- calibration -------------------------------------------------------
+    def _learn_from_modules(self, handle):
+        """Pair NT names with loader names to learn device prefixes."""
+        for module in _enumerate_module_handles(handle):
+            dos = _module_file_name(handle, module)
+            if not dos:
+                continue
+            dos = _strip_nt_prefix(dos)
+            if not (_is_dos_path(dos) or dos.startswith("\\\\")):
+                continue
+            device = _mapped_file_name(handle, module)
+            if not device or not device.startswith("\\Device\\"):
+                continue
+            shared = _common_suffix_length(dos, device)
+            if shared < 2:
+                continue
+            device_prefix = device[: len(device) - shared]
+            dos_prefix = dos[: len(dos) - shared]
+            if device_prefix and device_prefix not in self._learned:
+                self._learned[device_prefix] = dos_prefix
+
+    # -- resolution --------------------------------------------------------
+    def resolve(self, raw):
+        if not raw:
+            return None
+        try:
+            return self._cache[raw]
+        except KeyError:
+            pass
+        resolved = self._resolve_uncached(raw)
+        self._cache[raw] = resolved
+        return resolved
+
+    def _resolve_uncached(self, raw):
+        path = _strip_nt_prefix(raw)
+
+        if path.startswith("\\\\") and not path.startswith("\\\\?\\"):
+            return path                        # already a UNC path
+        if _is_dos_path(path):
+            return path                        # already a DOS path
+
+        lowered = path.lower()
+        for prefix in _UNC_DEVICE_PREFIXES:
+            if lowered.startswith(prefix.lower()):
+                return "\\\\" + path[len(prefix):]
+
+        if not path.startswith("\\Device\\"):
+            return None
+
+        mapped = self._apply_prefixes(path, self._devices, with_separator=True)
+        if mapped:
+            return mapped
+        mapped = self._apply_prefixes(path, self._learned, with_separator=False)
+        if mapped:
+            return mapped
+        return _final_dos_name(path)
+
+    @staticmethod
+    def _apply_prefixes(path, table, with_separator):
+        """Replace the longest matching device prefix in ``path``."""
+        lowered = path.lower()
+        # Longest first, so "\Device\Harddisk1" cannot shadow
+        # "\Device\Harddisk10".
+        for device in sorted(table, key=len, reverse=True):
+            key = device.lower()
+            if with_separator:
+                if lowered == key or lowered == key + "\\":
+                    return table[device] + "\\"
+                if not lowered.startswith(key + "\\"):
+                    continue
+            elif not lowered.startswith(key):
+                continue
+            candidate = table[device] + path[len(device):]
+            candidate = _strip_nt_prefix(candidate)
+            if _is_dos_path(candidate) or candidate.startswith("\\\\"):
+                return candidate
+        return None
+
+
+def _dos_device_map():
+    """Map NT device names (``\\Device\\HarddiskVolume3``) to drive letters."""
+    mapping = {}
+    if not w.AVAILABLE:
+        return mapping
+    size = w.GetLogicalDriveStringsW(0, None)
+    if not size:
+        return mapping
+    buffer = ctypes.create_unicode_buffer(size + 1)
+    written = w.GetLogicalDriveStringsW(size + 1, buffer)
+    if not written:
+        return mapping
+
+    for entry in buffer[:written].split("\0"):
+        if not entry:
+            continue
+        drive = entry.rstrip("\\")             # "C:\" -> "C:"
+        if not drive.endswith(":"):
+            continue
+        target = ctypes.create_unicode_buffer(PATH_BUFFER_CHARS)
+        if not w.QueryDosDeviceW(drive, target, PATH_BUFFER_CHARS):
+            continue
+        device = (target.value or "").rstrip("\\")
+        if device:
+            mapping[device] = drive
+    return mapping
+
+
+def _final_dos_name(device_path):
+    """Ask the file system for the DOS name behind an NT device path."""
+    handle = w.CreateFileW(
+        "\\\\?\\GLOBALROOT" + device_path,
+        0,                                     # query metadata only
+        w.FILE_SHARE_READ | w.FILE_SHARE_WRITE | w.FILE_SHARE_DELETE,
+        None,
+        w.OPEN_EXISTING,
+        w.FILE_FLAG_BACKUP_SEMANTICS,
+        None,
+    )
+    if not handle or handle == w.INVALID_HANDLE_VALUE:
+        return None
+    try:
+        chars = PATH_BUFFER_CHARS
+        while chars <= _MAX_PATH_BUFFER_CHARS:
+            buffer = ctypes.create_unicode_buffer(chars)
+            written = w.GetFinalPathNameByHandleW(
+                handle, buffer, chars, w.FILE_NAME_NORMALIZED | w.VOLUME_NAME_DOS
+            )
+            if not written:
+                return None
+            if written >= chars:
+                chars = written + 1
+                continue
+            name = _strip_nt_prefix(buffer.value or "")
+            if _is_dos_path(name) or name.startswith("\\\\"):
+                return name
+            return None
+        return None
+    finally:
+        w.CloseHandle(handle)
+
+
+# --------------------------------------------------------------------------
+# region walking
+# --------------------------------------------------------------------------
+
+def _maximum_application_address():
+    """Top of the user mode address space, at native pointer width."""
+    info = w.SYSTEM_INFO()
+    w.GetNativeSystemInfo(ctypes.byref(info))
+    top = int(info.lpMaximumApplicationAddress or 0)
+    if not top:
+        top = (1 << (8 * ctypes.sizeof(ctypes.c_void_p))) - 1
+    return top
+
+
+def _region_path(handle, mbi, resolver):
+    """Openable path of the file backing ``mbi``, or ``None``."""
+    if mbi.State == w.MEM_RESERVE:
+        # A reservation holds no pages, so nothing is mapped behind it.
+        return None
+    if mbi.Type not in (w.MEM_IMAGE, w.MEM_MAPPED):
+        return None
+    raw = _mapped_file_name(handle, int(mbi.BaseAddress or 0))
+    if raw is None:
+        # A mapping created from CreateFileMapping(INVALID_HANDLE_VALUE, ...)
+        # is backed by the pagefile, not by a file: None, never "".
+        return None
+    return resolver.resolve(raw)
+
+
+def _walk(handle, pid, include_reserved, resolver):
+    """Describe every in-use region of ``handle``, ascending by base."""
+    result = []
+    mbi = w.MEMORY_BASIC_INFORMATION()
+    mbi_size = ctypes.sizeof(mbi)
+    top = _maximum_application_address()
+    address = 0
+    answered = False
+
+    while address <= top:
+        ctypes.set_last_error(0)
+        written = w.VirtualQueryEx(
+            handle, ctypes.c_void_p(address), ctypes.byref(mbi), mbi_size
+        )
+        if not written:
+            if answered:
+                break                          # walked off the end: done
+            raise _classify_query_error(w.last_error(), pid, handle)
+
+        answered = True
+        base = int(mbi.BaseAddress or 0)
+        size = int(mbi.RegionSize or 0)
+        if size <= 0:
+            break
+
+        state = int(mbi.State)
+        if state == w.MEM_COMMIT or (state == w.MEM_RESERVE and include_reserved):
+            result.append({
+                "base": base,
+                "size": size,
+                "state": "commit" if state == w.MEM_COMMIT else "reserve",
+                "type": type_name(int(mbi.Type)),
+                "protect": protection_name(int(mbi.Protect)),
+                "path": _region_path(handle, mbi, resolver),
+                "image": int(mbi.Type) == w.MEM_IMAGE,
+            })
+
+        next_address = base + size
+        if next_address <= address:
+            break
+        address = next_address
+
+    result.sort(key=lambda item: item["base"])
+    return result
+
+
+def _classify_query_error(error, pid, handle=None):
+    if handle is not None and _has_exited(handle):
+        # The process exited between opening it and walking it.
+        return WVasError("no such process", kind="no-such-process", pid=pid)
+    if error == w.ERROR_ACCESS_DENIED:
+        return WVasError(
+            "process cannot be queried", kind="access-denied", pid=pid
+        )
+    if error in (w.ERROR_INVALID_PARAMETER, w.ERROR_INVALID_HANDLE):
+        # The very first query was rejected: the process is gone.
+        return WVasError("no such process", kind="no-such-process", pid=pid)
+    return WVasError(
+        "VirtualQueryEx failed (error %d)" % (error,),
+        kind="query-failed",
+        pid=pid,
+    )
+
+
+def regions(pid, include_reserved=True):
+    """Return the regions of ``pid``'s virtual address space.
+
+    Each descriptor is a dict with exactly ``base``, ``size``, ``state``,
+    ``type``, ``protect``, ``path`` and ``image``, and the list is ascending by
+    ``base``.  ``base`` and ``size`` are the values the kernel reports, at full
+    pointer width.  With ``include_reserved`` the list holds both committed and
+    reserved ranges; without it, only committed ones.
+    """
+    handle = _open_process(pid)
+    try:
+        resolver = _PathResolver(handle)
+        return _walk(handle, pid, bool(include_reserved), resolver)
+    finally:
+        _close(handle)
+
+
+def file_backed_regions(pid):
+    """Return only the regions that have a file behind them.
+
+    The subset of :func:`regions` whose ``path`` is not ``None``, in the same
+    order.
+    """
+    return [item for item in regions(pid) if item["path"] is not None]
+
+
+# --------------------------------------------------------------------------
+# modules
+# --------------------------------------------------------------------------
+
+def modules(pid):
+    """Return the loaded executable images, lowest base address first.
+
+    Every loaded image appears exactly once and no file path is listed twice.
+    ``path`` is where the image file really is on disk, or ``None`` when that
+    location cannot be turned into a path the caller could open -- the image
+    is still listed in that case.
+    """
+    handle = _open_process(pid)
+    try:
+        resolver = _PathResolver(handle)
+        found = {}
+
+        # The loader's own view: exact image sizes, and a usable file name even
+        # for images whose device name resists translation.
+        for module in _enumerate_module_handles(handle):
+            raw = _module_file_name(handle, module)
+            found[module] = {
+                "path": resolver.resolve(raw) if raw else None,
+                "base": module,
+                "size": _module_size(handle, module) or 0,
+            }
+
+        # The address space view, so that an image the loader list misses is
+        # still reported.  Image regions are split into protection runs; fold
+        # the runs of one allocation back together.
+        extents = {}
+        for item in _walk(handle, pid, False, resolver):
+            if not item["image"]:
+                continue
+            allocation = _allocation_base(handle, item["base"])
+            low, high, path = extents.get(allocation, (None, None, None))
+            start, end = item["base"], item["base"] + item["size"]
+            low = start if low is None else min(low, start)
+            high = end if high is None else max(high, end)
+            extents[allocation] = (low, high, path or item["path"])
+
+        for allocation, (low, high, path) in extents.items():
+            entry = found.get(allocation)
+            if entry is None:
+                found[allocation] = {
+                    "path": path,
+                    "base": allocation,
+                    "size": high - low,
+                }
+                continue
+            if entry["path"] is None and path is not None:
+                entry["path"] = path
+            if not entry["size"]:
+                entry["size"] = high - low
+
+        # One entry per image: never the same file path twice.
+        unique = []
+        seen = set()
+        for entry in sorted(found.values(), key=lambda item: item["base"]):
+            if entry["path"] is not None:
+                key = entry["path"].lower()
+                if key in seen:
+                    continue
+                seen.add(key)
+            unique.append(entry)
+        return unique
+    finally:
+        _close(handle)
+
+
+def _allocation_base(handle, address):
+    """Allocation base covering ``address``, or ``address`` if unknown."""
+    mbi = w.MEMORY_BASIC_INFORMATION()
+    written = w.VirtualQueryEx(
+        handle, ctypes.c_void_p(address), ctypes.byref(mbi), ctypes.sizeof(mbi)
+    )
+    if not written:
+        return address
+    return int(mbi.AllocationBase or 0) or address
