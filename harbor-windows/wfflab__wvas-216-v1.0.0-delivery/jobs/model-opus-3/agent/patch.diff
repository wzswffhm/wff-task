diff --git a/_edge.py b/_edge.py
new file mode 100644
index 0000000..865944c
--- /dev/null
+++ b/_edge.py
@@ -0,0 +1,101 @@
+"""Throwaway edge-case checks. Deleted after use."""
+import ctypes, os, subprocess, sys, time
+import wvas
+import wvas._winapi as w
+
+# modules of own process: dedup + completeness vs loader list
+from wvas.vas import _open_process, _enumerate_module_handles, _module_file_name
+h = _open_process(os.getpid())
+loader = {}
+for m in _enumerate_module_handles(h):
+    loader[m] = _module_file_name(h, m)
+mods = wvas.modules(os.getpid())
+print("loader modules", len(loader), "reported", len(mods))
+rep_bases = {m["base"] for m in mods}
+missing = [v for k, v in loader.items() if k not in rep_bases]
+print("loader modules missing from report:", missing)
+assert not missing, missing
+paths = [m["path"] for m in mods]
+assert all(p for p in paths), [m for m in mods if not m["path"]]
+low = [p.lower() for p in paths]
+assert len(low) == len(set(low)), "dupes"
+print("all module sizes >0:", all(m["size"] > 0 for m in mods))
+
+# purity: no process queried, pure constant mapping
+import wvas.vas as v
+calls = []
+orig = w.OpenProcess
+w.OpenProcess = lambda *a: calls.append(a) or orig(*a)
+try:
+    for val in (0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x104, 0x0, 0x999):
+        v.protection_name(val)
+    for val in (0x1000000, 0x40000, 0x20000, 0, 12345):
+        v.type_name(val)
+finally:
+    w.OpenProcess = orig
+print("helper opened a process:", bool(calls))
+assert not calls
+print("prot(0x104) =", v.protection_name(0x104), " prot(0)=", v.protection_name(0),
+      " type(0)=", v.type_name(0))
+
+# guarded page: PAGE_GUARD|PAGE_READWRITE must still name the base protection
+assert v.protection_name(0x104) == "rw"
+
+# keys exactly as documented, for every single region, including reserved
+expect = {"base", "size", "state", "type", "protect", "path", "image"}
+regs = wvas.regions(os.getpid())
+assert all(set(r) == expect for r in regs)
+assert all(isinstance(r["base"], int) and r["base"] > 0 for r in regs)
+assert all(isinstance(r["size"], int) and r["size"] > 0 for r in regs)
+assert all(r["state"] in ("commit", "reserve") for r in regs)
+assert all(r["type"] in ("image", "mapped", "private") for r in regs)
+assert all(r["path"] is None or isinstance(r["path"], str) for r in regs)
+assert all(r["path"] != "" for r in regs), "empty-string path"
+assert all(isinstance(r["image"], bool) for r in regs)
+assert [r["base"] for r in regs] == sorted(r["base"] for r in regs)
+# no overlaps
+prev_end = 0
+for r in regs:
+    assert r["base"] >= prev_end, (hex(r["base"]), hex(prev_end))
+    prev_end = r["base"] + r["size"]
+print("region invariants ok;", len(regs), "regions, top base", hex(regs[-1]["base"]))
+
+# include_reserved subset relationship
+com = wvas.regions(os.getpid(), include_reserved=False)
+assert all(r["state"] == "commit" for r in com)
+
+# file_backed order matches regions order
+fb = wvas.file_backed_regions(os.getpid())
+assert all(r["path"] is not None for r in fb)
+assert [r["base"] for r in fb] == sorted(r["base"] for r in fb)
+
+# unsupported platform path
+import importlib
+saved = w.AVAILABLE
+w.AVAILABLE = False
+try:
+    try:
+        wvas.regions(os.getpid())
+        print("unsupported -> no error!")
+    except wvas.WVasError as e:
+        print("unsupported ->", e.kind)
+    try:
+        wvas.modules(os.getpid())
+    except wvas.WVasError as e:
+        print("unsupported modules ->", e.kind)
+    # badarg still wins over unsupported
+    try:
+        wvas.regions(-5)
+    except wvas.WVasError as e:
+        print("badarg before unsupported ->", e.kind)
+finally:
+    w.AVAILABLE = saved
+
+# repeated calls are stable and do not leak handles
+before = None
+for i in range(25):
+    wvas.regions(os.getpid())
+    wvas.modules(os.getpid())
+print("25 round trips ok")
+
+print("EDGE CHECKS PASSED")
diff --git a/_perf.py b/_perf.py
new file mode 100644
index 0000000..7fde222
--- /dev/null
+++ b/_perf.py
@@ -0,0 +1,30 @@
+"""Throwaway perf/handle check. Deleted after use."""
+import ctypes, os, time
+import wvas
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+k.GetProcessHandleCount.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong)]
+
+
+def handles():
+    n = ctypes.c_ulong(0)
+    k.GetProcessHandleCount(k.GetCurrentProcess(), ctypes.byref(n))
+    return n.value
+
+
+t = time.perf_counter()
+r = wvas.regions(os.getpid())
+print("regions: %.3fs for %d" % (time.perf_counter() - t, len(r)))
+t = time.perf_counter()
+m = wvas.modules(os.getpid())
+print("modules: %.3fs for %d" % (time.perf_counter() - t, len(m)))
+
+before = handles()
+for _ in range(60):
+    wvas.regions(os.getpid())
+    wvas.modules(os.getpid())
+    wvas.file_backed_regions(os.getpid())
+after = handles()
+print("handles before/after:", before, after)
+assert after - before < 10, "handle leak"
+print("PERF/HANDLE OK")
diff --git a/_probe2.py b/_probe2.py
new file mode 100644
index 0000000..9a44c5f
--- /dev/null
+++ b/_probe2.py
@@ -0,0 +1,76 @@
+"""Throwaway probe. Deleted after use."""
+import ctypes, subprocess, sys, time
+import wvas._winapi as w
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+psapi = ctypes.WinDLL("psapi", use_last_error=True)
+
+EnumProcesses = psapi.EnumProcesses
+EnumProcesses.argtypes = [ctypes.POINTER(ctypes.c_ulong), ctypes.c_ulong,
+                          ctypes.POINTER(ctypes.c_ulong)]
+EnumProcesses.restype = ctypes.c_int
+
+GetExitCodeProcess = k.GetExitCodeProcess
+GetExitCodeProcess.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong)]
+GetExitCodeProcess.restype = ctypes.c_int
+
+
+def pids():
+    n = 4096
+    while True:
+        arr = (ctypes.c_ulong * n)()
+        need = ctypes.c_ulong(0)
+        if not EnumProcesses(arr, ctypes.sizeof(arr), ctypes.byref(need)):
+            return None
+        got = need.value // ctypes.sizeof(ctypes.c_ulong)
+        if got >= n:
+            n *= 2
+            continue
+        return set(arr[i] for i in range(got))
+
+
+def probe(pid, label):
+    for name, access in (
+        ("QI|VM", w.PROCESS_QUERY_INFORMATION | w.PROCESS_VM_READ),
+        ("QLI", w.PROCESS_QUERY_LIMITED_INFORMATION),
+        ("QLI|SYNC", w.PROCESS_QUERY_LIMITED_INFORMATION | 0x00100000),
+    ):
+        ctypes.set_last_error(0)
+        h = w.OpenProcess(access, False, pid)
+        err = ctypes.get_last_error()
+        extra = ""
+        if h:
+            code = ctypes.c_ulong(0)
+            ok = GetExitCodeProcess(h, ctypes.byref(code))
+            wait = k.WaitForSingleObject(ctypes.c_void_p(h), 0)
+            extra = " exitok=%s code=%s wait=%s" % (ok, code.value, wait)
+            w.CloseHandle(h)
+        print("%-22s %-9s handle=%s err=%d%s" % (label, name, bool(h), err, extra))
+
+
+live = pids()
+print("EnumProcesses count", len(live) if live else None)
+
+proc = subprocess.Popen([sys.executable, "-c", "import sys;sys.stdin.readline()"],
+                        stdin=subprocess.PIPE, text=True)
+time.sleep(0.5)
+probe(proc.pid, "live child")
+print("in EnumProcesses:", proc.pid in pids())
+proc.stdin.write("\n"); proc.stdin.flush(); proc.wait()
+time.sleep(0.5)
+print("--- after exit (parent still holds handle) ---")
+probe(proc.pid, "exited child")
+print("in EnumProcesses:", proc.pid in pids())
+dead = proc.pid
+del proc
+print("--- after releasing handle ---")
+probe(dead, "released child")
+print("in EnumProcesses:", dead in pids())
+print("--- never existed ---")
+probe(999999, "bogus pid")
+print("in EnumProcesses:", 999999 in pids())
+print("--- odd-numbered bogus ---")
+probe(999998, "bogus even")
+print("--- System ---")
+probe(4, "System pid 4")
+print("in EnumProcesses:", 4 in pids())
