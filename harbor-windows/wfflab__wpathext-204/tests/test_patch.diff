+"""PATH / PATHEXT 解析与批处理脚本执行的行为验证。
+
+覆盖三类只在 Windows 上成立的语义：可执行扩展名由 PATHEXT 决定、
+名字已经带扩展名时不得再叠加、以及批处理脚本必须经命令解释器执行。
+"""
+
+import os
+
+import pytest
+
+from wexec import EXECUTABLE_EXTENSIONS, CommandNotFound, resolve, run, search_dirs
+
+
+@pytest.fixture()
+def bindir(tmp_path, monkeypatch):
+    directory = tmp_path / "bin"
+    directory.mkdir()
+    monkeypatch.setenv("PATH", str(directory) + os.pathsep + os.environ.get("PATH", ""))
+    return directory
+
+
+def write_script(bindir, name, body, ext=".CMD"):
+    path = bindir / (name + ext)
+    path.write_bytes(("@echo off\r\n%s\r\n" % body).encode("ascii"))
+    return path
+
+
+# --- 核心回归（base 上失败） ------------------------------------------------
+
+
+def test_resolve_finds_cmd_script(bindir):
+    script = write_script(bindir, "hello-cmd", "echo hello")
+    assert os.path.samefile(resolve("hello-cmd"), script)
+
+
+def test_resolve_finds_bat_script(bindir):
+    script = write_script(bindir, "hello-bat", "echo hello", ".BAT")
+    assert os.path.samefile(resolve("hello-bat"), script)
+
+
+def test_resolve_honours_pathext_order(bindir, monkeypatch):
+    script = write_script(bindir, "pick", "echo cmd", ".CMD")
+    write_script(bindir, "pick", "placeholder", ".EXE")
+    monkeypatch.setenv("PATHEXT", ".CMD;.EXE")
+    assert os.path.samefile(resolve("pick"), script)
+
+
+def test_resolve_does_not_stack_extension_when_present(bindir):
+    script = write_script(bindir, "direct", "echo direct", ".CMD")
+    assert os.path.samefile(resolve("direct.CMD"), script)
+
+
+def test_runner_executes_cmd_script(bindir):
+    write_script(bindir, "say-cmd", "echo say-cmd-ok")
+    proc = run(["say-cmd"])
+    assert proc.returncode == 0
+    assert "say-cmd-ok" in proc.stdout
+
+
+def test_runner_executes_bat_script(bindir):
+    write_script(bindir, "say-bat", "echo say-bat-ok", ".BAT")
+    proc = run(["say-bat"])
+    assert proc.returncode == 0
+    assert "say-bat-ok" in proc.stdout
+
+
+def test_runner_surfaces_script_exit_code(bindir):
+    write_script(bindir, "fail7", "exit /b 7")
+    assert run(["fail7"]).returncode == 7
+
+
+# --- 回归保护（base 与参考解上都必须通过） ----------------------------------
+
+
+def test_resolve_finds_exe_without_extension():
+    assert os.path.isfile(resolve("cmd"))
+
+
+def test_resolve_returns_absolute_path():
+    assert os.path.isabs(resolve("cmd"))
+
+
+def test_resolve_missing_command_raises():
+    with pytest.raises(CommandNotFound):
+        resolve("definitely-not-a-real-command-xyz")
+
+
+def test_search_dirs_uses_path(monkeypatch, tmp_path):
+    monkeypatch.setenv("PATH", str(tmp_path))
+    assert search_dirs() == [str(tmp_path)]
+
+
+def test_runner_runs_system_executable():
+    assert run(["cmd", "/c", "exit 0"]).returncode == 0
+
+
+def test_fallback_extension_list_is_not_empty():
+    assert len(EXECUTABLE_EXTENSIONS) >= 1
+    assert all(e.startswith(".") for e in EXECUTABLE_EXTENSIONS)
