+    # 检查是否是批处理脚本（.cmd 或 .bat）
+    # 这些文件不能直接由 CreateProcess 执行，必须通过 cmd.exe 启动
+    path_lower = path.lower()
+    if path_lower.endswith('.cmd') or path_lower.endswith('.bat'):
+        # 使用 cmd.exe /c 来执行批处理脚本
+        # /c 参数表示执行完命令后退出
