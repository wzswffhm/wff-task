--- a/wexec/resolve.py
+++ b/wexec/resolve.py
@@ -1,8 +1,8 @@
 """在 PATH 上把命令名解析成磁盘路径。
 
-Windows 上「命令名」通常不带扩展名，例如 ``where``、``git``、``build``。
-Shell 之所以能找到它们，是因为按 :envvar:`PATHEXT` 里声明的扩展名顺序
-逐个试探。任何要自己启动外部程序的工具都必须照做，否则只能看见 ``.exe``。
+Windows 上「命令名」通常不带扩展名,例如 ``where``、``git``、``build``。
+Shell 之所以能找到它们,是因为按 :envvar:`PATHEXT` 里声明的扩展名顺序
+逐个试探。任何要自己启动外部程序的工具都必须照做,否则只能看见 ``.exe``。
 """
 
 import os
@@ -24,7 +24,19 @@ def executable_extensions():
 
     优先使用环境变量 :envvar:`PATHEXT`；它缺失时才退回内置兜底值。
     """
-    return EXECUTABLE_EXTENSIONS
+    pathext = os.environ.get("PATHEXT", "")
+    if not pathext:
+        return EXECUTABLE_EXTENSIONS
+    
+    # PATHEXT 格式例如: ".COM;.EXE;.BAT;.CMD"
+    # 分割并转小写以便不区分大小写比较
+    extensions = []
+    for ext in pathext.split(os.pathsep):
+        ext = ext.strip()
+        if ext:
+            extensions.append(ext.lower())
+    
+    return tuple(extensions) if extensions else EXECUTABLE_EXTENSIONS
 
 
 def resolve(name):
@@ -35,9 +47,23 @@ def resolve(name):
     if not name:
         raise CommandNotFound(name)
 
+    exts = executable_extensions()
+    
+    # 检查名字是否已经带有可执行扩展名
+    name_lower = name.lower()
+    has_extension = any(name_lower.endswith(ext) for ext in exts)
+    
     for directory in search_dirs():
-        candidate = os.path.join(directory, "%s.exe" % name)
-        if os.path.isfile(candidate):
-            return os.path.abspath(candidate)
+        if has_extension:
+            # 名字已经有扩展名,直接查找
+            candidate = os.path.join(directory, name)
+            if os.path.isfile(candidate):
+                return os.path.abspath(candidate)
+        else:
+            # 名字没有扩展名,按 PATHEXT 顺序试探
+            for ext in exts:
+                candidate = os.path.join(directory, name + ext)
+                if os.path.isfile(candidate):
+                    return os.path.abspath(candidate)
 
     raise CommandNotFound(name)
