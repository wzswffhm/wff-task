diff --git a/wexec/resolve.py b/wexec/resolve.py
index e01bd19..e7a0761 100644
--- a/wexec/resolve.py
+++ b/wexec/resolve.py
@@ -24,6 +24,10 @@ def executable_extensions():
 
     优先使用环境变量 :envvar:`PATHEXT`；它缺失时才退回内置兜底值。
     """
+    pathext = os.environ.get("PATHEXT", "")
+    if pathext:
+        exts = [ext.lower() for ext in pathext.split(os.pathsep) if ext]
+        return tuple(exts) if exts else EXECUTABLE_EXTENSIONS
     return EXECUTABLE_EXTENSIONS
 
 
@@ -35,9 +39,23 @@ def resolve(name):
     if not name:
         raise CommandNotFound(name)
 
+    exts = executable_extensions()
+    
+    # 检查名字本身是否已经带有 PATHEXT 中的扩展名
+    name_lower = name.lower()
+    has_ext = any(name_lower.endswith(ext) for ext in exts)
+    
     for directory in search_dirs():
-        candidate = os.path.join(directory, "%s.exe" % name)
-        if os.path.isfile(candidate):
-            return os.path.abspath(candidate)
+        if has_ext:
+            # 名字已有扩展名，直接查找
+            candidate = os.path.join(directory, name)
+            if os.path.isfile(candidate):
+                return os.path.abspath(candidate)
+        else:
+            # 名字无扩展名，按 PATHEXT 顺序逐个尝试
+            for ext in exts:
+                candidate = os.path.join(directory, name + ext)
+                if os.path.isfile(candidate):
+                    return os.path.abspath(candidate)
 
     raise CommandNotFound(name)
diff --git a/wexec/runner.py b/wexec/runner.py
index db6ba24..bef9240 100644
--- a/wexec/runner.py
+++ b/wexec/runner.py
@@ -11,8 +11,16 @@ def run(argv, timeout=None):
         raise ValueError("argv must not be empty")
 
     path = resolve(argv[0])
+    
+    # 批处理脚本必须通过 cmd.exe 启动
+    path_lower = path.lower()
+    if path_lower.endswith('.cmd') or path_lower.endswith('.bat'):
+        cmd_args = ['cmd.exe', '/c', path] + [str(a) for a in argv[1:]]
+    else:
+        cmd_args = [path] + [str(a) for a in argv[1:]]
+    
     return subprocess.run(
-        [path] + [str(a) for a in argv[1:]],
+        cmd_args,
         capture_output=True,
         text=True,
         timeout=timeout,
