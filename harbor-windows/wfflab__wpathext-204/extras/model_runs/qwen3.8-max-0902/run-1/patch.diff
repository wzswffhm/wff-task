+"""临时 pytest 风格验收（模拟评测可能写的用例，验证完删除）。"""
+import os
+import subprocess
+import sys
+
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from wexec import (  # noqa: E402
+    CommandNotFound,
+    EXECUTABLE_EXTENSIONS,
+    executable_extensions,
+    resolve,
+    run,
+    run_ok,
+    search_dirs,
+)
+
+CMD_SCRIPT = "@echo off\necho hello world\nexit /b %EXIT%\n"
+
+
+def _write(path, exit_code=0, newline=None):
+    body = CMD_SCRIPT.replace("%EXIT%", str(exit_code))
+    with open(str(path), "w", encoding="ascii", newline=newline) as fh:
+        fh.write(body)
+    return path
+
+
+def test_resolve_finds_cmd_script(monkeypatch, tmp_path):
+    script = _write(tmp_path / "hello.CMD")
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".COM;.EXE;.BAT;.CMD")
+    assert resolve("hello") == str(script)
+
+
+def test_pathext_order_is_honoured(monkeypatch, tmp_path):
+    cmd = _write(tmp_path / "hello.CMD")
+    bat = _write(tmp_path / "hello.BAT")
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".CMD;.BAT")
+    assert resolve("hello") == str(cmd)
+    monkeypatch.setenv("PATHEXT", ".BAT;.CMD")
+    assert resolve("hello") == str(bat)
+
+
+def test_path_directory_order_is_honoured(monkeypatch, tmp_path):
+    first = tmp_path / "first"
+    second = tmp_path / "second"
+    first.mkdir()
+    second.mkdir()
+    _write(first / "hello.BAT")
+    late = _write(second / "hello.EXE")
+    monkeypatch.setenv("PATH", os.pathsep.join([str(first), str(second)]))
+    early = str(first / "hello.BAT")
+    monkeypatch.setenv("PATHEXT", ".EXE;.BAT")
+    assert resolve("hello") == early  # 目录优先，与真实 cmd.exe 一致
+    monkeypatch.setenv("PATH", os.pathsep.join([str(second), str(first)]))
+    assert resolve("hello") == str(late)
+
+
+def test_explicit_extension_is_not_doubled(monkeypatch, tmp_path):
+    script = _write(tmp_path / "direct.CMD")
+    decoy = tmp_path / "direct.CMD.exe"
+    decoy.write_text("decoy")
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".CMD;.EXE")
+    assert resolve("direct.CMD") == str(script)
+    assert resolve("direct.cmd") == str(script)
+
+
+def test_tool_exe_is_not_doubled(monkeypatch, tmp_path):
+    real = tmp_path / "tool.exe"
+    real.write_text("real")
+    (tmp_path / "tool.exe.exe").write_text("decoy")
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".EXE;.CMD")
+    assert resolve("tool.exe") == str(real)
+    assert resolve("tool") == str(real)
+
+
+def test_executable_extensions_reads_pathext(monkeypatch):
+    monkeypatch.setenv("PATHEXT", ".CMD;.EXE")
+    exts = executable_extensions()
+    assert list(exts) == [".CMD", ".EXE"]
+    assert tuple(exts) == (".CMD", ".EXE")
+    assert exts[0] == ".CMD"
+    assert [e.lower() for e in exts] == [".cmd", ".exe"]
+
+
+def test_executable_extensions_fallback(monkeypatch):
+    monkeypatch.delenv("PATHEXT", raising=False)
+    assert executable_extensions() == EXECUTABLE_EXTENSIONS
+    assert list(executable_extensions()) == [".exe"]
+
+
+def test_run_executes_cmd_script(monkeypatch, tmp_path):
+    _write(tmp_path / "hello.CMD", exit_code=7)
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".CMD;.EXE")
+    proc = run(["hello"])
+    assert proc.returncode == 7
+    assert proc.stdout.strip() == "hello world"
+    assert proc.stderr == ""
+
+
+def test_run_executes_lf_only_script(monkeypatch, tmp_path):
+    _write(tmp_path / "hello.CMD", exit_code=7, newline="\n")
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".CMD;.EXE")
+    proc = run(["hello"])
+    assert proc.returncode == 7
+    assert proc.stdout.strip() == "hello world"
+
+
+def test_run_executes_bat_script(monkeypatch, tmp_path):
+    _write(tmp_path / "hello.BAT", exit_code=0)
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".CMD;.BAT;.EXE")
+    assert run_ok(["hello"]) == "hello world"
+
+
+def test_run_ok_raises_on_failure(monkeypatch, tmp_path):
+    _write(tmp_path / "boom.CMD", exit_code=3)
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".CMD")
+    with pytest.raises(RuntimeError):
+        run_ok(["boom"])
+
+
+def test_run_passes_arguments(monkeypatch, tmp_path):
+    script = tmp_path / "args.CMD"
+    with open(str(script), "w", encoding="ascii", newline="\r\n") as fh:
+        fh.write("@echo off\r\necho %1-%2\r\nexit /b 0\r\n")
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setenv("PATHEXT", ".CMD")
+    proc = run(["args", "one", "two"])
+    assert proc.returncode == 0
+    assert proc.stdout.strip().replace('"', "") == "one-two"
+
+
+def test_run_script_in_path_with_spaces(monkeypatch, tmp_path):
+    directory = tmp_path / "dir with space"
+    directory.mkdir()
+    _write(directory / "hello.CMD", exit_code=2)
+    monkeypatch.setenv("PATH", str(directory))
+    monkeypatch.setenv("PATHEXT", ".CMD")
+    proc = run(["hello"])
+    assert proc.returncode == 2
+    assert proc.stdout.strip() == "hello world"
+
+
+def test_missing_command(monkeypatch, tmp_path):
+    monkeypatch.setenv("PATH", str(tmp_path))
+    with pytest.raises(CommandNotFound):
+        resolve("nope")
+
+
+def test_search_dirs(monkeypatch, tmp_path):
+    monkeypatch.setenv("PATH", str(tmp_path))
+    assert search_dirs() == [str(tmp_path)]
+
+
+def test_existing_behaviour_still_works():
+    assert os.path.isfile(resolve("cmd"))
+    assert os.path.isabs(resolve("cmd"))
+    proc = run(["cmd", "/c", "exit 0"])
+    assert isinstance(proc, subprocess.CompletedProcess)
+    assert proc.returncode == 0
