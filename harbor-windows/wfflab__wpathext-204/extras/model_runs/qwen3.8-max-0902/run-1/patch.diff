+"""临时验收探针 2（验证完删除）。"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from wexec import resolve, run, run_ok  # noqa: E402
+from wexec.runner import build_command, command_interpreter, needs_interpreter  # noqa: E402
+
+TMP = os.path.join(tempfile.gettempdir(), "wexec-accept2")
+shutil.rmtree(TMP, ignore_errors=True)
+os.makedirs(TMP)
+SAVED = dict(os.environ)
+failures = []
+
+
+def check(label, got, want):
+    ok = got == want
+    print(("PASS " if ok else "FAIL ") + label + " -> got=%r want=%r" % (got, want))
+    if not ok:
+        failures.append(label)
+
+
+def check_true(label, cond):
+    print(("PASS " if cond else "FAIL ") + label)
+    if not cond:
+        failures.append(label)
+
+
+def write(name, body):
+    path = os.path.join(TMP, name)
+    with open(path, "w", newline="\r\n") as fh:
+        fh.write(body.replace("\n", "\r\n"))
+    return path
+
+
+system32 = os.path.join(os.environ.get("SystemRoot", r"C:\Windows"), "System32")
+
+# timeout：让 ping 可用（PATH 里要有 System32）
+write("slow.CMD", "@echo off\nping -n 4 127.0.0.1 >nul\nexit /b 0\n")
+os.environ["PATH"] = TMP + os.pathsep + system32
+os.environ["PATHEXT"] = ".CMD;.BAT;.EXE"
+try:
+    run(["slow"], timeout=0.4)
+    check_true("timeout raises", False)
+except subprocess.TimeoutExpired:
+    check_true("timeout raises", True)
+
+# COMSPEC 缺失时的回退
+os.environ.pop("COMSPEC", None)
+check_true("interpreter fallback", os.path.isfile(command_interpreter()))
+write("plain.BAT", "@echo off\necho nocomspec ok\nexit /b 0\n")
+check("run without COMSPEC", run_ok(["plain"]), "nocomspec ok")
+os.environ["COMSPEC"] = SAVED["COMSPEC"]
+
+# 批处理内部再调用批处理，退出码要如实传出
+write("inner.CMD", "@echo off\necho inner\nexit /b 42\n")
+write("outer.CMD", '@echo off\ncall "%~dp0inner.CMD"\nexit /b %errorlevel%\n')
+check("nested exit code", run(["outer"]).returncode, 42)
+check("nested stdout", run(["outer"]).stdout.strip(), "inner")
+
+# 直接执行 .exe 时不经过 cmd.exe
+check("build_command exe", build_command(r"C:\x\tool.exe", ["a b"]), [r"C:\x\tool.exe", "a b"])
+cmd = build_command(os.path.join(TMP, "outer.CMD"), ["a b"])
+check_true("build_command bat is string", isinstance(cmd, str))
+print("  cmd line:", cmd)
+check_true("needs_interpreter .CMD", needs_interpreter(os.path.join(TMP, "outer.CMD")))
+check_true("needs_interpreter .exe false", not needs_interpreter(r"C:\x\tool.exe"))
+
+# 真 exe 走 PATH 解析并执行
+os.environ["PATHEXT"] = SAVED["PATHEXT"]
+os.environ["PATH"] = SAVED["PATH"]
+check("real exe run", run_ok([sys.executable, "-c", "print('hi')"]), "hi")
+check_true("resolve python.exe", os.path.isfile(resolve("python")))
+
+# 参数里有引号/特殊字符时不能崩
+write("args.CMD", "@echo off\necho %1\nexit /b 0\n")
+os.environ["PATH"] = TMP
+os.environ["PATHEXT"] = ".CMD"
+proc = run(["args", 'say "hi"'])
+print("  quoted arg ->", proc.returncode, repr(proc.stdout), repr(proc.stderr))
+proc = run(["args", "a&b"])
+print("  amp arg    ->", proc.returncode, repr(proc.stdout), repr(proc.stderr))
+
+os.environ.clear()
+os.environ.update(SAVED)
+print()
+print("failures:", failures)
+sys.exit(1 if failures else 0)
