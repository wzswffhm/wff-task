diff --git a/_probe_tmp/accept.py b/_probe_tmp/accept.py
new file mode 100644
index 0000000..c158e4e
--- /dev/null
+++ b/_probe_tmp/accept.py
@@ -0,0 +1,201 @@
+"""临时验收探针（不属于仓库测试，验证完会删除）。"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from wexec import (  # noqa: E402
+    CommandNotFound,
+    EXECUTABLE_EXTENSIONS,
+    executable_extensions,
+    resolve,
+    run,
+    run_ok,
+    search_dirs,
+)
+
+TMP = os.path.join(tempfile.gettempdir(), "wexec-accept")
+shutil.rmtree(TMP, ignore_errors=True)
+os.makedirs(TMP)
+
+SAVED = dict(os.environ)
+failures = []
+
+
+def env(**kwargs):
+    for key in ("PATH", "PATHEXT"):
+        os.environ.pop(key, None)
+    for key, value in kwargs.items():
+        if value is None:
+            os.environ.pop(key, None)
+        else:
+            os.environ[key] = value
+
+
+def restore():
+    os.environ.clear()
+    os.environ.update(SAVED)
+
+
+def check(label, got, want):
+    ok = got == want
+    print(("PASS " if ok else "FAIL ") + label + " -> got=%r want=%r" % (got, want))
+    if not ok:
+        failures.append(label)
+
+
+def check_true(label, cond):
+    print(("PASS " if cond else "FAIL ") + label)
+    if not cond:
+        failures.append(label)
+
+
+def mkdir(name):
+    path = os.path.join(TMP, name)
+    os.makedirs(path, exist_ok=True)
+    return path
+
+
+def write(directory, name, body):
+    path = os.path.join(directory, name)
+    with open(path, "w", newline="\r\n") as fh:
+        fh.write(body.replace("\n", "\r\n"))
+    return path
+
+
+# ---------------------------------------------------------------- 场景 1/2
+bin1 = mkdir("bin1")
+write(bin1, "hello.CMD", "@echo off\necho hello from cmd\nexit /b 0\n")
+write(bin1, "hello.BAT", "@echo off\necho hello from bat\nexit /b 0\n")
+write(bin1, "hello.EXE", "not a real exe\n")
+
+env(PATH=bin1, PATHEXT=".CMD;.BAT;.EXE")
+check("pathext order 1", os.path.basename(resolve("hello")).lower(), "hello.cmd")
+env(PATH=bin1, PATHEXT=".BAT;.CMD;.EXE")
+check("pathext order 2", os.path.basename(resolve("hello")).lower(), "hello.bat")
+env(PATH=bin1, PATHEXT=".EXE;.BAT;.CMD")
+check("pathext order 3", os.path.basename(resolve("hello")).lower(), "hello.exe")
+
+# PATH 目录顺序优先
+bin2 = mkdir("bin2")
+write(bin2, "hello.CMD", "@echo off\necho hello from bin2\n")
+env(PATH=bin1 + os.pathsep + bin2, PATHEXT=".CMD")
+check("path dir order", os.path.dirname(resolve("hello")).lower(), bin1.lower())
+
+# 大小写不敏感
+bin3 = mkdir("bin3")
+write(bin3, "lower.cmd", "@echo off\necho lower\n")
+env(PATH=bin3, PATHEXT=".CMD;.EXE")
+check("case-insensitive match", os.path.basename(resolve("lower")).lower(), "lower.cmd")
+check("case-insensitive name", os.path.basename(resolve("LOWER")).lower(), "lower.cmd")
+
+# ------------------------------------------------------------- 场景 3：不叠加
+direct = write(bin1, "direct.CMD", "@echo off\necho direct\nexit /b 0\n")
+env(PATH=bin1, PATHEXT=".CMD;.EXE")
+check("direct.CMD", resolve("direct.CMD").lower(), direct.lower())
+check("direct.cmd lowercase", resolve("direct.cmd").lower(), direct.lower())
+write(bin1, "tool.exe", "x")
+write(bin1, "tool.exe.exe", "y")
+check("tool.exe not doubled", resolve("tool.exe").lower(), os.path.join(bin1, "tool.exe").lower())
+check("bare tool", resolve("tool").lower(), os.path.join(bin1, "tool.exe").lower())
+
+# 带路径的调用
+env(PATH=bin2, PATHEXT=".CMD")
+check("absolute path", resolve(direct).lower(), direct.lower())
+cwd = os.getcwd()
+os.chdir(bin1)
+env(PATH=bin1, PATHEXT=".CMD")
+try:
+    check("relative path", resolve("direct.CMD").lower(), direct.lower())
+    check("relative dir path", resolve(os.path.join(".", "direct.CMD")).lower(), direct.lower())
+finally:
+    os.chdir(cwd)
+
+# 找不到
+env(PATH=bin1, PATHEXT=".CMD;.EXE")
+try:
+    resolve("definitely-not-a-real-command-xyz")
+    check_true("missing raises", False)
+except CommandNotFound:
+    check_true("missing raises", True)
+try:
+    resolve("")
+    check_true("empty raises", False)
+except CommandNotFound:
+    check_true("empty raises", True)
+
+# 扩展名不在 PATHEXT 中：按原名兜底
+write(bin1, "notes.txt", "hello")
+check("unknown ext fallback", resolve("notes.txt").lower(), os.path.join(bin1, "notes.txt").lower())
+
+# ------------------------------------------------------- executable_extensions
+env(PATHEXT=".CMD;.EXE")
+check("exts value", list(executable_extensions()), [".CMD", ".EXE"])
+check_true("exts == tuple", executable_extensions() == (".CMD", ".EXE"))
+check_true("exts == list", executable_extensions() == [".CMD", ".EXE"])
+check_true("exts != other", executable_extensions() != (".EXE",))
+env(PATHEXT=None)
+check_true("exts fallback", executable_extensions() == EXECUTABLE_EXTENSIONS)
+check_true("exts fallback list", list(executable_extensions()) == [".exe"])
+env(PATHEXT="")
+check_true("exts empty fallback", executable_extensions() == EXECUTABLE_EXTENSIONS)
+check_true("exts indexable", executable_extensions()[0].lower() == ".exe")
+check_true("exts iterable", [e.lower() for e in executable_extensions()] == [".exe"])
+
+# ------------------------------------------------------------------ search_dirs
+env(PATH=bin1)
+check("search_dirs", search_dirs(), [bin1])
+
+# ------------------------------------------------------------- 场景 4：run
+spaced = mkdir("dir with space")
+script = write(spaced, "hello.CMD", "@echo off\necho hello %1\nexit /b 7\n")
+bat = write(spaced, "world.BAT", "@echo off\necho world\nexit /b 0\n")
+env(PATH=spaced, PATHEXT=".CMD;.BAT;.EXE")
+proc = run(["hello"])
+check("run cmd returncode", proc.returncode, 7)
+check("run cmd stdout", proc.stdout.strip(), "hello")
+proc = run(["world"])
+check("run bat returncode", proc.returncode, 0)
+check("run bat stdout", proc.stdout.strip(), "world")
+check("run_ok bat", run_ok(["world"]), "world")
+proc = run(["hello", "arg with space", "--flag=1"])
+check("run with spaced arg rc", proc.returncode, 7)
+check("run with spaced arg out", proc.stdout.strip(), 'hello "arg with space"')
+check("run direct path", run([script]).stdout.strip(), "hello")
+
+# 退出码为 0 的批处理 + stderr
+write(spaced, "err.CMD", "@echo off\necho boom 1>&2\nexit /b 3\n")
+proc = run(["err"])
+check("stderr captured", proc.stderr.strip(), "boom")
+check("stderr rc", proc.returncode, 3)
+try:
+    run_ok(["err"])
+    check_true("run_ok raises", False)
+except RuntimeError as exc:
+    check_true("run_ok raises", "exited with 3" in str(exc))
+
+# 普通 exe 依旧直接执行
+restore()
+proc = run(["cmd", "/c", "exit 0"])
+check("plain exe rc", proc.returncode, 0)
+check_true("resolve cmd is file", os.path.isfile(resolve("cmd")))
+check_true("resolve cmd abs", os.path.isabs(resolve("cmd")))
+check_true("resolve where", os.path.isfile(resolve("where")))
+check_true("resolve python", os.path.isfile(resolve("python")))
+
+# timeout 仍然生效
+env(PATH=spaced, PATHEXT=".CMD")
+write(spaced, "slow.CMD", "@echo off\nping -n 4 127.0.0.1 >nul\nexit /b 0\n")
+try:
+    run(["slow"], timeout=0.3)
+    check_true("timeout raises", False)
+except subprocess.TimeoutExpired:
+    check_true("timeout raises", True)
+
+restore()
+print()
+print("failures:", failures)
+sys.exit(1 if failures else 0)
