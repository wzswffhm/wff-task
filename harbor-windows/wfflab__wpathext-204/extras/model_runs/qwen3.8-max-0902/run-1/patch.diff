+"""临时探针：真实 cmd.exe 在「PATH 目录顺序」与「PATHEXT 顺序」冲突时怎么选。"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TMP = os.path.join(tempfile.gettempdir(), "wexec-order")
+shutil.rmtree(TMP, ignore_errors=True)
+first = os.path.join(TMP, "first")
+second = os.path.join(TMP, "second")
+os.makedirs(first)
+os.makedirs(second)
+
+# first 里放 .BAT，second 里放真正的 .EXE
+with open(os.path.join(first, "hello.BAT"), "w", newline="\r\n") as fh:
+    fh.write("@echo off\r\necho BAT-FROM-FIRST\r\n")
+shutil.copy(os.path.join(os.environ["SystemRoot"], "System32", "where.exe"),
+            os.path.join(second, "hello.EXE"))
+
+env = dict(os.environ)
+env["PATH"] = os.pathsep.join([first, second])
+env["PATHEXT"] = ".EXE;.BAT"
+
+print("PATH = first;second  |  PATHEXT = .EXE;.BAT")
+print("  真实 cmd.exe 选择：", end="")
+proc = subprocess.run([os.environ["COMSPEC"], "/c", "hello"], capture_output=True,
+                      text=True, env=env, cwd=TMP)
+out = (proc.stdout or "").strip().splitlines()
+print(out[0] if out and "BAT" in out[0] else "EXE-FROM-SECOND(where 的输出)",
+      "| rc =", proc.returncode)
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+os.environ["PATH"] = env["PATH"]
+os.environ["PATHEXT"] = env["PATHEXT"]
+from wexec import resolve  # noqa: E402
+
+print("  wexec.resolve 选择：", resolve("hello"))
+
+print()
+env["PATHEXT"] = ".BAT;.EXE"
+os.environ["PATHEXT"] = env["PATHEXT"]
+print("PATH = first;second  |  PATHEXT = .BAT;.EXE")
+print("  真实 cmd.exe 选择：", end="")
+proc = subprocess.run([os.environ["COMSPEC"], "/c", "hello"], capture_output=True,
+                      text=True, env=env, cwd=TMP)
+out = (proc.stdout or "").strip().splitlines()
+print(out[0] if out and "BAT" in out[0] else "EXE-FROM-SECOND(where 的输出)",
+      "| rc =", proc.returncode)
+print("  wexec.resolve 选择：", resolve("hello"))
+
+print()
+print("shutil.which 选择：", shutil.which("hello", path=env["PATH"]))
+shutil.rmtree(TMP, ignore_errors=True)
