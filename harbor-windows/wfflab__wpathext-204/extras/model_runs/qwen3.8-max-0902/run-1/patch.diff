+"""运行已经解析出来的命令。
 
+``CreateProcess`` 只能启动真正的可执行映像：批处理脚本（``.cmd`` /
+``.bat``）必须由命令解释器 ``cmd.exe`` 来跑，否则会得到 WinError 193
+（“不是有效的 Win32 应用程序”）。这里统一处理这件事，并保证脚本自己的
+退出码原样出现在返回的 ``CompletedProcess`` 里。
+"""
+
+import os
 import subprocess
 
 from .resolve import resolve
 
+#: 必须经由命令解释器启动的脚本扩展名（小写比较）。
+INTERPRETED_EXTENSIONS = (".bat", ".cmd")
+
+#: 启动批处理脚本时使用的 cmd.exe 开关：
+#: ``/d`` 跳过 AutoRun，``/s`` 固定 ``/c`` 后面命令行的引号处理规则。
+_INTERPRETER_SWITCHES = ("/d", "/s", "/c")
+
+
+def command_interpreter():
+    """返回用于启动批处理脚本的命令解释器路径。"""
+    comspec = os.environ.get("COMSPEC")
+    if comspec:
+        return comspec
+    system_root = os.environ.get("SystemRoot") or os.environ.get("windir")
+    if system_root:
+        return os.path.join(system_root, "System32", "cmd.exe")
+    return "cmd.exe"
+
+
+def needs_interpreter(path):
+    """``path`` 是否是不能由 CreateProcess 直接执行的脚本。"""
+    return os.path.splitext(path)[1].lower() in INTERPRETED_EXTENSIONS
+
+
+def build_command(path, args=()):
+    """构造交给 :mod:`subprocess` 的命令。
+
+    普通可执行文件返回参数列表；批处理脚本返回一条完整的 ``cmd.exe``
+    命令行字符串——只有这样才能在路径或参数含空格时仍然保持正确的
+    引号结构（``cmd /s /c "<命令行>"``）。
+    """
+    args = [str(arg) for arg in args]
+    if not needs_interpreter(path):
+        return [path] + args
+
+    interpreter = subprocess.list2cmdline([command_interpreter()] + list(_INTERPRETER_SWITCHES))
+    script = subprocess.list2cmdline([path] + args)
+    return '%s "%s"' % (interpreter, script)
+
 
