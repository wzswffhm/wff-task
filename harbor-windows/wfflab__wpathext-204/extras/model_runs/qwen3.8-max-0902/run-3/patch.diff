+"""运行已经解析出来的命令。
 
+``.bat`` / ``.cmd`` 是批处理脚本，不是 PE 可执行文件：把它们直接交给
+CreateProcess 会得到 WinError 193（``%1 不是有效的 Win32 应用程序``）。
+Windows 的要求是启动命令解释器 ``cmd.exe``，把 ``/c`` 和脚本名传给它；
+解释器执行完会把脚本的退出码原样带回来。
+"""
+
+import os
 import subprocess
 
+from .errors import CommandNotFound
 from .resolve import resolve
 
+#: 必须经由命令解释器启动的脚本扩展名（小写，含前导点）。
+INTERPRETER_EXTENSIONS = (".bat", ".cmd")
+
+#: 在 cmd.exe 命令行里会被当成控制字符、必须用引号包起来的字符。
+_CMD_SPECIAL_CHARS = "&|<>()^"
+
+
+def needs_command_interpreter(path):
+    """判断 ``path`` 是否必须由 ``cmd.exe`` 代为启动。"""
+    if os.name != "nt":
+        return False
+    return os.path.splitext(path)[1].lower() in INTERPRETER_EXTENSIONS
+
+
+def command_interpreter():
+    """返回命令解释器（``cmd.exe``）的路径。"""
+    comspec = os.environ.get("COMSPEC") or ""
+    if comspec and os.path.isfile(comspec):
+        return comspec
+    try:
+        return resolve("cmd.exe")
+    except CommandNotFound:
+        return comspec or "cmd.exe"
+
+
+def _quote_for_cmd(value):
+    """按 cmd.exe 的规矩给单个参数加引号。"""
+    text = str(value)
+    quoted = subprocess.list2cmdline([text])
+    if quoted == text and any(ch in text for ch in _CMD_SPECIAL_CHARS):
+        # list2cmdline 只关心空格与引号；cmd.exe 还需要引号保护这些控制字符。
+        quoted = '"%s"' % text
+    return quoted
+
+
+def build_command_line(path, args=()):
+    """返回可直接交给 CreateProcess 的命令行字符串。
+
+    批处理脚本会被包成 ``cmd.exe /D /S /C "<脚本> <参数…>"``：``/D`` 跳过
+    AutoRun，``/S`` 让 cmd.exe 稳定地剥掉最外层引号，于是路径里带空格、
+    参数里带引号都能原样送达脚本。
+    """
+    argv = [path] + [str(a) for a in args]
+    if not needs_command_interpreter(path):
+        return subprocess.list2cmdline(argv)
+
+    inner = " ".join(_quote_for_cmd(item) for item in argv)
+    return '"%s" /D /S /C "%s"' % (command_interpreter(), inner)
+
 
