-    """解析 ``argv[0]`` 并执行，返回 ``subprocess.CompletedProcess``。"""
+    """解析 ``argv[0]`` 并执行，返回 ``subprocess.CompletedProcess``。
+
+    批处理脚本（``.cmd`` / ``.bat``）会经由 ``cmd.exe`` 启动，脚本自身的退出
+    码就是返回结果里的 ``returncode``。
+    """
     if not argv:
         raise ValueError("argv must not be empty")
 
-    path = resolve(argv[0])
     return subprocess.run(
-        [path] + [str(a) for a in argv[1:]],
+        _command(argv),
         capture_output=True,
         text=True,
+        errors="replace",
         timeout=timeout,
     )
 
