-"""运行已经解析出来的命令。"""
+"""运行已经解析出来的命令。
 
+Windows 上「能被 :func:`resolve` 找到」并不等于「能被 :func:`CreateProcess`
+直接启动」：``.cmd`` / ``.bat`` 是批处理脚本，交给 ``CreateProcess`` 会得到
+``WinError 193``（不是有效的 Win32 应用程序）。它们必须由命令解释器
+``cmd.exe`` 代为执行，并且脚本的退出码要原样带回给调用方。
+"""
+
+import os
 import subprocess
 
+from .errors import CommandNotFound
 from .resolve import resolve
 
+#: 必须由命令解释器代为启动的脚本扩展名（小写）。
+BATCH_SCRIPT_EXTENSIONS = frozenset((".bat", ".cmd"))
+
+#: 在 cmd.exe 命令行里有特殊含义、必须用引号包起来的字符。
+_CMD_METACHARACTERS = frozenset('&<>()^|"')
+
+
+def command_interpreter():
+    """返回 Windows 命令解释器（``cmd.exe``）的路径。
+
+    优先使用 :envvar:`COMSPEC`；它缺失时退回按名字解析 ``cmd``。
+    """
+    comspec = os.environ.get("COMSPEC")
+    if comspec:
+        return comspec
+    try:
+        return resolve("cmd")
+    except CommandNotFound:
+        return "cmd.exe"
+
+
+def needs_interpreter(path):
+    """判断 ``path`` 是否是不能由 CreateProcess 直接启动的批处理脚本。"""
+    return os.path.splitext(path)[1].lower() in BATCH_SCRIPT_EXTENSIONS
+
+
+def _quote_argument(argument):
+    """按 MSVCRT 规则引用单个参数。
+
+    含空白时 :func:`subprocess.list2cmdline` 会自动加引号；此外还要把 cmd.exe
+    的元字符（``&``、``|``、``<`` 等）包进引号，否则它们会被解释器当成命令
+    分隔符，把一条参数劈成好几条命令。
+    """
+    text = subprocess.list2cmdline([argument])
+    if text.startswith('"'):
+        return text
+    if _CMD_METACHARACTERS.isdisjoint(text):
+        return text
+    return '"%s"' % text
+
+
+def _batch_command_line(script, args):
+    """拼出启动批处理脚本的完整命令行。
+
+    形式是 ``cmd.exe /S /C "<整条命令>"``：``/S`` 让 cmd.exe 老老实实地剥掉
+    最外层这一对引号，剩下的部分原样执行，于是脚本路径和参数里的空格、
+    引号都能被正确保留。
+    """
+    inner = " ".join([_quote_argument(script)] + [_quote_argument(a) for a in args])
+    return '%s /S /C "%s"' % (_quote_argument(command_interpreter()), inner)
+
+
+def _command(argv):
+    """把 ``argv`` 变成可以直接交给 :func:`subprocess.run` 的命令。"""
+    path = resolve(argv[0])
+    args = [str(a) for a in argv[1:]]
+
+    if needs_interpreter(path):
+        return _batch_command_line(path, args)
+    return [path] + args
+
 
