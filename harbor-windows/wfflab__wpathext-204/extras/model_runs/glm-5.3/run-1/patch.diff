index e01bd19..fe52610 100644
--- a/wexec/resolve.py
+++ b/wexec/resolve.py
@@ -3,6 +3,12 @@
 Windows 上「命令名」通常不带扩展名，例如 ``where``、``git``、``build``。
 Shell 之所以能找到它们，是因为按 :envvar:`PATHEXT` 里声明的扩展名顺序
 逐个试探。任何要自己启动外部程序的工具都必须照做，否则只能看见 ``.exe``。
+
+两个容易踩坑的地方这里都照顾到了：
+
+* ``PATHEXT`` 的顺序就是优先级，顺序换了结果就得跟着换；
+* 名字自带扩展名时（``tool.exe``、``direct.CMD``）必须原样使用，
+  不能再往上叠扩展名，否则会去找 ``tool.exe.exe``。
 """
 
 import os
@@ -12,6 +18,9 @@ from .errors import CommandNotFound
 #: 找不到 PATHEXT 时使用的兜底扩展名。
 EXECUTABLE_EXTENSIONS = (".exe",)
 
+#: 目录列举失败时的哨兵，用来区分「目录是空的」和「目录读不出来」。
+_UNREADABLE = object()
+
 
 def search_dirs():
     """返回 PATH 中需要搜索的目录列表。"""
@@ -23,8 +32,111 @@ def executable_extensions():
     """返回按优先级排列的可执行扩展名。
 
     优先使用环境变量 :envvar:`PATHEXT`；它缺失时才退回内置兜底值。
+
+    返回值保持 :envvar:`PATHEXT` 里的书写顺序（以及大小写）——这个顺序
+    就是查找时的优先级，`.CMD;.EXE` 和 `.EXE;.CMD` 会解析出不同的结果。
+    """
+    extensions = []
+    seen = set()
+    for raw in os.environ.get("PATHEXT", "").split(os.pathsep):
+        ext = raw.strip()
+        if not ext:
+            # PATHEXT 里混进的空段直接跳过
+            continue
+        if not ext.startswith("."):
+            # 容错：不带前导点的写法（``CMD``）也按 ``.CMD`` 理解
+            ext = "." + ext
+        key = ext.lower()
+        if key not in seen:  # 重复的扩展名只保留第一次出现
+            seen.add(key)
+            extensions.append(ext)
+    if not extensions:
+        # PATHEXT 缺失（或者全是空段）时才退回兜底值
+        return tuple(EXECUTABLE_EXTENSIONS)
+    return tuple(extensions)
+
+
+def _separators():
+    """当前平台上合法的路径分隔符。"""
+    return (os.sep, os.altsep) if os.altsep else (os.sep,)
+
+
+def _has_directory_part(name):
+    """``name`` 是否自带位置信息（绝对路径或相对子路径）。"""
+    if os.path.isabs(name):
+        return True
+    return any(sep in name for sep in _separators())
+
+
+def _candidate_names(name):
+    """按优先级返回 ``name`` 可能对应的文件名（已含扩展名）。"""
+    if os.path.splitext(name)[1]:
+        # 名字已经带了扩展名（tool.exe / direct.CMD）：原样使用。
+        # 这里绝不能再叠加扩展名，否则 tool.exe 会变成 tool.exe.exe。
+        return (name,)
+    return tuple(name + ext for ext in executable_extensions())
+
+
+def _candidate_paths(name):
+    """按优先级生成 ``name`` 的候选完整路径。"""
+    names = _candidate_names(name)
+
+    if os.path.isabs(name):
+        # 绝对路径：只在该位置找，PATH 不参与
+        for candidate in names:
+            yield candidate
+        return
+
+    if _has_directory_part(name):
+        # 相对子路径：先按名字写出的位置（相对当前目录）找
+        for candidate in names:
+            yield candidate
+
+    # 不带位置的命令名：逐个 PATH 目录、逐个 PATHEXT 扩展名试探。
+    # 目录在外层、扩展名在内层，和 cmd.exe 的查找顺序一致。
+    for directory in search_dirs():
+        for candidate in names:
+            yield os.path.join(directory, candidate)
+
+
+def _directory_index(directory, cache):
+    """返回 ``directory`` 的 ``{小写文件名: 实际文件名}`` 映射。
+
+    Windows 的文件系统不区分大小写：PATH 里写着 ``hello.CMD``、
+    PATHEXT 里写着 ``.cmd`` 时命中的是同一个文件。这里用目录列举
+    建索引，既能不区分大小写地匹配，又能把磁盘上的真实文件名
+    （连同真实大小写）返回给调用方。
+
+    目录列举失败（不存在、无权限……）时返回 :data:`_UNREADABLE`。
     """
-    return EXECUTABLE_EXTENSIONS
+    key = os.path.normcase(os.path.abspath(directory))
+    if key in cache:
+        return cache[key]
+
+    try:
+        entries = os.listdir(directory)
+    except OSError:
+        index = _UNREADABLE
+    else:
+        index = {}
+        for entry in entries:
+            index.setdefault(entry.lower(), entry)
+    cache[key] = index
+    return index
+
+
+def _match_entry(directory, filename, cache):
+    """在 ``directory`` 里找 ``filename``（不区分大小写）。
+
+    命中时返回磁盘上的真实文件名，找不到返回 ``None``。
+    """
+    index = _directory_index(directory, cache)
+    if index is _UNREADABLE:
+        # 目录列举不出来，退回逐个探测
+        if os.path.isfile(os.path.join(directory, filename)):
+            return filename
+        return None
+    return index.get(filename.lower())
 
 
 def resolve(name):
@@ -35,9 +147,20 @@ def resolve(name):
     if not name:
         raise CommandNotFound(name)
 
-    for directory in search_dirs():
-        candidate = os.path.join(directory, "%s.exe" % name)
-        if os.path.isfile(candidate):
-            return os.path.abspath(candidate)
+    if isinstance(name, os.PathLike):
+        name = os.fspath(name)
+    if isinstance(name, bytes):
+        name = os.fsdecode(name)
+
+    cache = {}
+    for candidate in _candidate_paths(name):
+        directory = os.path.dirname(candidate) or os.curdir
+        filename = os.path.basename(candidate)
+        entry = _match_entry(directory, filename, cache)
+        if entry is None:
+            continue
+        full = os.path.join(directory, entry)
+        if os.path.isfile(full):  # 同名的目录不算可执行文件
+            return os.path.abspath(full)
 
     raise CommandNotFound(name)
