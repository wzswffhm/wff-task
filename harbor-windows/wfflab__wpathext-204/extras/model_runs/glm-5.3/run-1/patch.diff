diff --git a/_tmp_check.py b/_tmp_check.py
new file mode 100644
index 0000000..255db28
--- /dev/null
+++ b/_tmp_check.py
@@ -0,0 +1,227 @@
+import os
+import pathlib
+import subprocess
+import tempfile
+import time
+
+from wexec import CommandNotFound, executable_extensions, resolve, run, run_ok
+
+ok = fail = 0
+
+
+def check(label, cond, extra=""):
+    global ok, fail
+    if cond:
+        ok += 1
+        print("PASS  %s" % label)
+    else:
+        fail += 1
+        print("FAIL  %s  %s" % (label, extra))
+
+
+ORIG_PATH = os.environ["PATH"]
+ORIG_PATHEXT = os.environ["PATHEXT"]
+
+# ---------------------------------------------------------------- extensions
+print("PATHEXT default:", executable_extensions())
+check("default ext tuple", isinstance(executable_extensions(), tuple))
+
+os.environ["PATHEXT"] = ".CMD;.EXE;.BAT"
+check("pathext read", executable_extensions() == (".CMD", ".EXE", ".BAT"),
+      executable_extensions())
+os.environ["PATHEXT"] = ".cmd;.exe;.bat"
+check("pathext case kept", executable_extensions() == (".cmd", ".exe", ".bat"),
+      executable_extensions())
+os.environ["PATHEXT"] = "CMD;.EXE"
+check("dot normalization", executable_extensions() == (".CMD", ".EXE"),
+      executable_extensions())
+os.environ["PATHEXT"] = ".EXE;.EXE;"
+check("dupes dropped", executable_extensions() == (".EXE",), executable_extensions())
+del os.environ["PATHEXT"]
+check("fallback", executable_extensions() == (".exe",), executable_extensions())
+os.environ["PATHEXT"] = ""
+check("empty fallback", executable_extensions() == (".exe",), executable_extensions())
+os.environ["PATHEXT"] = ORIG_PATHEXT
+
+# ------------------------------------------------------------------ resolve
+d = tempfile.mkdtemp(prefix="wexec_t_")
+os.environ["PATH"] = d
+
+hello = os.path.join(d, "hello.CMD")
+with open(hello, "w") as f:
+    f.write("@echo off\necho hello-from-cmd\n")
+check("resolve hello (upper ext)", resolve("hello") == hello, resolve("hello"))
+
+os.remove(hello)
+hello_lower = os.path.join(d, "hello.cmd")
+with open(hello_lower, "w") as f:
+    f.write("@echo off\necho hello-from-cmd\n")
+check("resolve hello (lower ext on disk)", resolve("hello") == hello_lower,
+      resolve("hello"))
+
+direct = os.path.join(d, "direct.CMD")
+with open(direct, "w") as f:
+    f.write("@echo off\necho direct\n")
+check("resolve direct.CMD", resolve("direct.CMD") == direct, resolve("direct.CMD"))
+check("resolve direct.cmd", resolve("direct.cmd") == direct, resolve("direct.cmd"))
+
+tool = os.path.join(d, "tool.exe")
+with open(tool, "wb") as f:
+    f.write(b"")
+check("resolve tool.exe not doubled", resolve("tool.exe") == tool, resolve("tool.exe"))
+check("resolve tool -> tool.exe", resolve("tool") == tool, resolve("tool"))
+os.remove(tool)
+
+a_cmd = os.path.join(d, "multi.cmd")
+a_exe = os.path.join(d, "multi.exe")
+for p in (a_cmd, a_exe):
+    with open(p, "wb") as f:
+        f.write(b"")
+os.environ["PATHEXT"] = ".CMD;.EXE"
+check("order cmd first", resolve("multi") == a_cmd, resolve("multi"))
+os.environ["PATHEXT"] = ".EXE;.CMD"
+check("order exe first", resolve("multi") == a_exe, resolve("multi"))
+os.remove(a_cmd)
+os.remove(a_exe)
+
+d2 = tempfile.mkdtemp(prefix="wexec_t2_")
+os.environ["PATH"] = os.pathsep.join([d2, d])
+first = os.path.join(d2, "multi.exe")
+second = os.path.join(d, "multi.cmd")
+for p in (first, second):
+    with open(p, "wb") as f:
+        f.write(b"")
+os.environ["PATHEXT"] = ".CMD;.EXE"
+check("dir order wins", resolve("multi") == first, resolve("multi"))
+os.remove(first)
+os.remove(second)
+
+os.environ["PATH"] = d
+for name in ("nope-not-here", "nope.exe", ""):
+    try:
+        resolve(name)
+        check("missing %r raises" % name, False)
+    except CommandNotFound:
+        check("missing %r raises" % name, True)
+
+check("resolve absolute", resolve(direct) == direct, resolve(direct))
+check("resolve PathLike", resolve(pathlib.Path(direct)) == direct, resolve(direct))
+
+os.makedirs(os.path.join(d, "dircmd.cmd"), exist_ok=True)
+try:
+    resolve("dircmd")
+    check("dir not matched", False, resolve("dircmd"))
+except CommandNotFound:
+    check("dir not matched", True)
+
+sub = os.path.join(d, "sub")
+os.makedirs(sub, exist_ok=True)
+with open(os.path.join(sub, "rel.exe"), "wb") as f:
+    f.write(b"")
+old_cwd = os.getcwd()
+os.chdir(d)
+check("relative subdir", resolve(os.path.join("sub", "rel")) ==
+      os.path.join(sub, "rel.exe"), resolve(os.path.join("sub", "rel")))
+os.chdir(old_cwd)
+
+# --------------------------------------------------------------------- run
+os.environ["PATHEXT"] = ".COM;.EXE;.BAT;.CMD"
+
+with open(os.path.join(d, "hello.CMD"), "w") as f:
+    f.write("@echo off\necho hello-from-cmd\n")
+proc = run(["hello"])
+check("run cmd script rc", proc.returncode == 0, proc)
+check("run cmd script out", proc.stdout.strip() == "hello-from-cmd", repr(proc.stdout))
+
+with open(os.path.join(d, "hello.bat"), "w") as f:
+    f.write("@echo off\necho hello-from-bat\n")
+os.environ["PATHEXT"] = ".BAT;.CMD"
+proc = run(["hello"])
+check("run bat script out", proc.stdout.strip() == "hello-from-bat", repr(proc.stdout))
+check("run_ok on bat", run_ok(["hello"]) == "hello-from-bat")
+
+with open(os.path.join(d, "exit3.cmd"), "w") as f:
+    f.write("@echo off\nexit /b 3\n")
+check("exit /b 3 rc", run(["exit3"]).returncode == 3, run(["exit3"]).returncode)
+
+with open(os.path.join(d, "exit7.bat"), "w") as f:
+    f.write("@echo off\nexit 7\n")
+check("exit 7 rc", run(["exit7"]).returncode == 7, run(["exit7"]).returncode)
+
+with open(os.path.join(d, "echomsg.cmd"), "w") as f:
+    f.write("@echo off\necho [%1]\n")
+proc = run(["echomsg", "one"])
+check("simple arg passes", proc.stdout.strip() == "[one]", repr(proc.stdout))
+proc = run(["echomsg", "two words"])
+check("spaced arg reaches script", "two words" in proc.stdout, repr(proc.stdout))
+proc = run(["echomsg", "-DFOO=bar(x)"])
+check("parens arg", proc.returncode == 0 and "bar(x)" in proc.stdout,
+      (proc.returncode, repr(proc.stdout), repr(proc.stderr)))
+proc = run(["echomsg", "x&y"])
+check("ampersand arg", proc.returncode == 0 and "x&y" in proc.stdout,
+      (proc.returncode, repr(proc.stdout), repr(proc.stderr)))
+proc = run(["echomsg", "a|b<c>d^e"])
+check("meta arg", proc.returncode == 0, (proc.returncode, repr(proc.stdout),
+                                         repr(proc.stderr)))
+proc = run(["echomsg", ""])
+check("empty arg survives", proc.returncode == 0, (proc.returncode, proc.stdout))
+
+with open(os.path.join(d, "both.cmd"), "w") as f:
+    f.write("@echo off\necho out-line\necho err-line 1>&2\nexit /b 5\n")
+proc = run(["both"])
+check("stderr captured", proc.stderr.strip() == "err-line", repr(proc.stderr))
+check("rc 5", proc.returncode == 5, proc.returncode)
+try:
+    run_ok(["both"])
+    check("run_ok raises on failure", False)
+except RuntimeError as exc:
+    check("run_ok raises on failure", True, str(exc))
+
+sp = tempfile.mkdtemp(prefix="wexec space_")
+os.environ["PATH"] = sp
+with open(os.path.join(sp, "hello.CMD"), "w") as f:
+    f.write("@echo off\necho spaced\nexit /b 2\n")
+proc = run(["hello"])
+check("spaced path run", proc.returncode == 2 and proc.stdout.strip() == "spaced",
+      (proc.returncode, proc.stdout))
+proc = run(["hello", "a b", "c"])
+check("spaced path with args", proc.returncode == 2,
+      (proc.returncode, proc.stdout, proc.stderr))
+
+os.environ["PATH"] = ORIG_PATH
+os.environ["PATHEXT"] = ORIG_PATHEXT
+proc = run(["cmd", "/c", "exit 4"])
+check("exe run rc", proc.returncode == 4, proc.returncode)
+check("exe run output", run_ok(["cmd", "/c", "echo hi"]) == "hi")
+
+os.environ["PATH"] = sp
+with open(os.path.join(sp, "slow.cmd"), "w") as f:
+    f.write("@echo off\n%SystemRoot%\\System32\\ping.exe -n 4 127.0.0.1 >nul\n")
+try:
+    run(["slow"], timeout=1)
+    check("timeout", False)
+except subprocess.TimeoutExpired:
+    check("timeout", True)
+
+proc = run([os.path.join(sp, "hello.CMD")])
+check("run absolute script", proc.returncode == 2, proc.returncode)
+
+os.environ["COMSPEC"] = ""
+proc = run(["hello"])
+check("no COMSPEC fallback", proc.returncode == 2 and proc.stdout.strip() == "spaced",
+      (proc.returncode, proc.stdout, proc.stderr))
+del os.environ["COMSPEC"]
+proc = run(["hello"])
+check("COMSPEC deleted fallback", proc.returncode == 2, (proc.returncode, proc.stderr))
+os.environ["COMSPEC"] = r"C:\Windows\system32\cmd.exe"
+
+os.environ["PATH"] = ORIG_PATH
+os.environ["PATHEXT"] = ORIG_PATHEXT
+t0 = time.perf_counter()
+for _ in range(5):
+    resolve("cmd")
+print("resolve('cmd') x5: %.3fs" % (time.perf_counter() - t0))
+check("resolve cmd", os.path.isfile(resolve("cmd")))
+
+print()
+print("passed=%d failed=%d" % (ok, fail))
diff --git a/_tmp_check2.py b/_tmp_check2.py
new file mode 100644
index 0000000..252c8d1
--- /dev/null
+++ b/_tmp_check2.py
@@ -0,0 +1,22 @@
+import os
+import subprocess
+import tempfile
+
+from wexec import run
+
+# cmd 的批处理参数本身就用 = , ; 分隔，这里只验证括号不会被
+# 我们的命令行层破坏（退出码为 0、前半段原样到达）。
+d = tempfile.mkdtemp(prefix="wexec_paren_")
+os.environ["PATH"] = d
+os.environ["PATHEXT"] = ".COM;.EXE;.BAT;.CMD"
+with open(os.path.join(d, "echomsg.cmd"), "w") as f:
+    f.write("@echo off\necho [%1]\n")
+
+for arg, expect in [("-DFOO=bar(x)", "-DFOO"), ("plain", "plain"), ("a^b", "a^b"),
+                    ("x&y", "x&y"), ("two words", "two words")]:
+    proc = run(["echomsg", arg])
+    print("%-16r rc=%s out=%r" % (arg, proc.returncode, proc.stdout.strip()))
+    assert proc.returncode == 0, (arg, proc.returncode, proc.stderr)
+    assert expect in proc.stdout, (arg, proc.stdout)
+
+print("all ok")
