diff --git a/wexec/resolve.py b/wexec/resolve.py
index e01bd19..ec1e51f 100644
--- a/wexec/resolve.py
+++ b/wexec/resolve.py
@@ -22,22 +22,62 @@ def search_dirs():
 def executable_extensions():
     """返回按优先级排列的可执行扩展名。
 
-    优先使用环境变量 :envvar:`PATHEXT`；它缺失时才退回内置兜底值。
+    优先使用环境变量 :envvar:`PATHEXT`；它缺失或为空时才退回内置兜底值。
+    返回的每个扩展名都带前导点（例如 ``.COM``、``.EXE``、``.CMD``），
+    顺序与 PATHEXT 中声明的一致。
     """
-    return EXECUTABLE_EXTENSIONS
+    raw = os.environ.get("PATHEXT", "")
+    exts = []
+    for part in raw.split(os.pathsep):
+        part = part.strip()
+        if not part:
+            continue
+        if not part.startswith("."):
+            part = "." + part
+        exts.append(part)
+    if not exts:
+        return EXECUTABLE_EXTENSIONS
+    return tuple(exts)
+
+
+def _has_extension(name):
+    """判断命令名本身是否已经带了扩展名。"""
+    return bool(os.path.splitext(name)[1])
+
+
+def _candidate_names(name):
+    """按优先级生成 ``name`` 对应的候选文件名。
+
+    名字已带扩展名时直接使用原名（不再叠加扩展名）；否则按
+    :func:`executable_extensions` 的顺序逐个拼接。
+    """
+    if _has_extension(name):
+        return [name]
