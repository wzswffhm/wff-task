+             '<Repetition><Interval>P99999999999999999D</Interval></Repetition>'
+             '</TimeTrigger></Triggers></Task>')
+expect_error("empty text", "xml", wtask.parse_task_xml, "")
+expect_error("None input", "xml", wtask.parse_task_xml, None)
+
+# 手工构造的模型也要能序列化 / 回读
+manual = wtask.Task(
