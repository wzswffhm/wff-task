diff --git a/_verify_spec.py b/_verify_spec.py
new file mode 100644
index 0000000..6f6f613
--- /dev/null
+++ b/_verify_spec.py
@@ -0,0 +1,549 @@
+"""一次性验证脚本（运行后立即删除，不属于仓库内容）。"""
+
+from datetime import datetime, timedelta
+
+import wtask
+from wtask import TaskDefError
+
+FAILS = []
+CHECKS = [0]
+
+
+def check(label, got, want):
+    CHECKS[0] += 1
+    if got != want:
+        FAILS.append("%s:\n   got  %r\n   want %r" % (label, got, want))
+
+
+def check_raises(label, kind, func, *args, **kwargs):
+    CHECKS[0] += 1
+    try:
+        result = func(*args, **kwargs)
+    except TaskDefError as exc:
+        if exc.kind != kind:
+            FAILS.append("%s: kind=%r want %r (%s)" % (label, exc.kind, kind, exc))
+        return
+    except Exception as exc:  # noqa: BLE001
+        FAILS.append("%s: raised %s(%s), want TaskDefError(%s)" % (label, type(exc).__name__, exc, kind))
+        return
+    FAILS.append("%s: no error, returned %r (want TaskDefError %s)" % (label, result, kind))
+
+
+def xml(body, version="1.2", settings=""):
+    return (
+        "<Task version=\"%s\" xmlns=\"http://schemas.microsoft.com/windows/2004/02/mit/task\">"
+        "<Triggers>%s</Triggers>%s</Task>" % (version, body, settings)
+    )
+
+
+def cal(inner, extra=""):
+    return "<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>%s%s</CalendarTrigger>" % (inner, extra)
+
+
+# --------------------------------------------------------------- §3.1 daily
+daily3 = wtask.parse_task_xml(xml(cal("<ScheduleByDay><DaysInterval>3</DaysInterval></ScheduleByDay>")))
+check("daily3 model", (daily3.triggers[0].type, daily3.triggers[0].days_interval), ("daily", 3))
+check(
+    "daily3 phase",
+    daily3.next_runs(datetime(2025, 12, 31), 4),
+    [datetime(2026, 1, 1, 8), datetime(2026, 1, 4, 8), datetime(2026, 1, 7, 8), datetime(2026, 1, 10, 8)],
+)
+check(
+    "daily3 phase mid",
+    daily3.next_runs(datetime(2026, 1, 2), 2),
+    [datetime(2026, 1, 4, 8), datetime(2026, 1, 7, 8)],
+)
+daily_default = wtask.parse_task_xml(xml(cal("<ScheduleByDay/>")))
+check("daily default interval", daily_default.triggers[0].days_interval, 1)
+check("daily default runs", daily_default.next_runs(datetime(2026, 1, 1, 8), 2),
+      [datetime(2026, 1, 2, 8), datetime(2026, 1, 3, 8)])
+check("daily strict-after", daily_default.next_runs(datetime(2026, 1, 1, 7, 59, 59), 1),
+      [datetime(2026, 1, 1, 8)])
+
+# --------------------------------------------------------------- §3.2 weekly
+weekly2 = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-07T08:00:00</StartBoundary>"
+    "<ScheduleByWeek><DaysOfWeek><Monday/><Wednesday/></DaysOfWeek><WeeksInterval>2</WeeksInterval>"
+    "</ScheduleByWeek></CalendarTrigger>"
+))
+check("weekly2 model", (weekly2.triggers[0].type, weekly2.triggers[0].weeks_interval,
+                        weekly2.triggers[0].days_of_week), ("weekly", 2, (1, 3)))
+check(
+    "weekly2 runs",
+    weekly2.next_runs(datetime(2026, 1, 1), 5),
+    [datetime(2026, 1, 7, 8), datetime(2026, 1, 19, 8), datetime(2026, 1, 21, 8),
+     datetime(2026, 2, 2, 8), datetime(2026, 2, 4, 8)],
+)
+weekly1 = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-07T08:00:00</StartBoundary>"
+    "<ScheduleByWeek><DaysOfWeek><Monday/><Wednesday/></DaysOfWeek></ScheduleByWeek></CalendarTrigger>"
+))
+check("weekly1 default interval", weekly1.triggers[0].weeks_interval, 1)
+check("weekly1 runs", weekly1.next_runs(datetime(2026, 1, 1), 4),
+      [datetime(2026, 1, 7, 8), datetime(2026, 1, 12, 8), datetime(2026, 1, 14, 8),
+       datetime(2026, 1, 19, 8)])
+# 周一起始：StartBoundary 在周日时，那一周从周一算起
+weekly_sun = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-04T09:00:00</StartBoundary>"
+    "<ScheduleByWeek><DaysOfWeek><Sunday/><Monday/></DaysOfWeek><WeeksInterval>2</WeeksInterval>"
+    "</ScheduleByWeek></CalendarTrigger>"
+))
+check("weekly monday-based weeks", weekly_sun.next_runs(datetime(2026, 1, 1), 4),
+      [datetime(2026, 1, 4, 9), datetime(2026, 1, 12, 9), datetime(2026, 1, 18, 9),
+       datetime(2026, 1, 26, 9)])
+
+# --------------------------------------------------------------- §3.3 monthly
+monthly = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-01T06:00:00</StartBoundary>"
+    "<ScheduleByMonth><DaysOfMonth><Day>15</Day><Day>1</Day></DaysOfMonth>"
+    "<Months><July/><January/></Months></ScheduleByMonth></CalendarTrigger>"
+))
+check("monthly model", (monthly.triggers[0].days_of_month, monthly.triggers[0].months),
+      ((1, 15), (1, 7)))
+check("monthly months filter", monthly.next_runs(datetime(2025, 12, 31), 5),
+      [datetime(2026, 1, 1, 6), datetime(2026, 1, 15, 6), datetime(2026, 7, 1, 6),
+       datetime(2026, 7, 15, 6), datetime(2027, 1, 1, 6)])
+monthly30 = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-01T06:00:00</StartBoundary>"
+    "<ScheduleByMonth><DaysOfMonth><Day>30</Day></DaysOfMonth>"
+    "<Months><January/><February/><March/></Months></ScheduleByMonth></CalendarTrigger>"
+))
+check("monthly day-30 skips february", monthly30.next_runs(datetime(2026, 1, 1), 2),
+      [datetime(2026, 1, 30, 6), datetime(2026, 3, 30, 6)])
+
+# --------------------------------------------------------------- §3.4 monthly_dow
+mdw5 = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-01T07:30:00</StartBoundary>"
+    "<ScheduleByMonthDayOfWeek><Weeks><Week>5</Week></Weeks><DaysOfWeek><Friday/></DaysOfWeek>"
+    "<Months><February/><January/></Months></ScheduleByMonthDayOfWeek></CalendarTrigger>"
+))
+check("mdow week5 model", (mdw5.triggers[0].weeks_of_month, mdw5.triggers[0].days_of_week,
+                           mdw5.triggers[0].months), ((5,), (5,), (1, 2)))
+# 2026-02 只有 28 天 -> 4 个日历周，Week=5 == 第 4 周 -> 2/27（周五）
+# 2026-01 有 31 天 -> 第 5 周为 29..31 -> 1/30（周五）
+check("mdow week5 last-week", mdw5.next_runs(datetime(2026, 1, 1), 3),
+      [datetime(2026, 1, 30, 7, 30), datetime(2026, 2, 27, 7, 30),
+       datetime(2027, 1, 29, 7, 30)])
+mdw1 = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-01T07:30:00</StartBoundary>"
+    "<ScheduleByMonthDayOfWeek><Weeks><Week>1</Week></Weeks><DaysOfWeek><Saturday/></DaysOfWeek>"
+    "<Months><February/></Months></ScheduleByMonthDayOfWeek></CalendarTrigger>"
+))
+check("mdow week1 boundary day 7", mdw1.next_runs(datetime(2026, 1, 1), 2),
+      [datetime(2026, 2, 7, 7, 30), datetime(2027, 2, 6, 7, 30)])
+mdw13 = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-01T07:30:00</StartBoundary>"
+    "<ScheduleByMonthDayOfWeek><Weeks><Week>1</Week><Week>3</Week></Weeks>"
+    "<DaysOfWeek><Friday/></DaysOfWeek><Months><January/></Months>"
+    "</ScheduleByMonthDayOfWeek></CalendarTrigger>"
+))
+check("mdow weeks 1,3", mdw13.next_runs(datetime(2026, 1, 1), 4),
+      [datetime(2026, 1, 2, 7, 30), datetime(2026, 1, 16, 7, 30),
