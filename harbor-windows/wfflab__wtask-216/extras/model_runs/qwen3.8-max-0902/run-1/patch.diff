+        wtask.Trigger(type="weekly", start=datetime(2026, 1, 1, 8), weeks_interval=2,
+                      days_of_week=(1, 3)),
+        wtask.Trigger(type="monthly", start=datetime(2026, 1, 1, 8), days_of_month=(1, 15),
+                      months=(1, 7)),
+        wtask.Trigger(type="monthly_dow", start=datetime(2026, 1, 1, 8), weeks_of_month=(1, 5),
+                      days_of_week=(5,), months=(2,),
+                      repetition=wtask.Repetition(interval=timedelta(minutes=30),
+                                                    duration=timedelta(hours=2))),
+        wtask.Trigger(type="time", start=datetime(2026, 1, 1, 8), end=datetime(2026, 1, 2, 8),
+                      enabled=False),
+    ),
+    enabled=False,
+    execution_time_limit=timedelta(hours=72),
+    random_delay=timedelta(minutes=5),
+    multiple_instances="StopExisting",
+)
+mtext = wtask.task_to_xml(manual)
+show("manual xml", mtext)
+show("manual roundtrip", wtask.parse_task_xml(mtext) == manual)
+show("manual idempotent", wtask.task_to_xml(wtask.parse_task_xml(mtext)) == mtext)
+show("manual disabled runs", manual.next_runs(datetime(2026, 1, 1), 3))
+show("manual enabled runs", wtask.next_runs(
+    wtask.Task(version="1.0", triggers=manual.triggers), datetime(2026, 1, 1), 4))
+
+# execution_time_limit=0 的手工模型也应省略
+zero_limit = wtask.Task(version="1.2", triggers=manual.triggers[:1],
+                        execution_time_limit=timedelta(0))
+ztext = wtask.task_to_xml(zero_limit)
+show("zero limit omitted", "ExecutionTimeLimit" not in ztext)
+show("zero limit roundtrip", wtask.parse_task_xml(ztext) == wtask.Task(
+    version="1.2", triggers=manual.triggers[:1]))
+
+with io.open("_verify_out.txt", "w", encoding="utf-8") as handle:
+    handle.write(OUT.getvalue())
+print(OUT.getvalue())
