+             '<Task version="1.2"><Triggers><TimeTrigger>'
+             '<StartBoundary>2026-01-01T08:00:00</StartBoundary></TimeTrigger></Triggers>'
+             '<Triggers><TimeTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+             '</TimeTrigger></Triggers></Task>')
+expect_error("unknown trigger only", "trigger", wtask.parse_task_xml,
+             '<Task version="1.2"><Triggers><LogonTrigger/></Triggers></Task>')
+expect_error("huge duration", "duration", wtask.parse_task_xml,
+             '<Task version="1.2"><Triggers><TimeTrigger>'
+             '<StartBoundary>2026-01-01T08:00:00</StartBoundary></TimeTrigger></Triggers>'
