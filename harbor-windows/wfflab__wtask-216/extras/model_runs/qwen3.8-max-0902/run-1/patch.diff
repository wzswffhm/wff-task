diff --git a/_patch.py b/_patch.py
new file mode 100644
index 0000000..e27d5a8
--- /dev/null
+++ b/_patch.py
@@ -0,0 +1,72 @@
+import io
+
+p = "_verify_spec.py"
+s = io.open(p, encoding="utf-8").read()
+
+reps = [
+    ("datetime(2026, 1, 5, 9), datetime(2026, 1, 18, 9)",
+     "datetime(2026, 1, 12, 9), datetime(2026, 1, 18, 9)"),
+    ("datetime(2026, 1, 19, 9)])", "datetime(2026, 1, 26, 9)])"),
+    ('<Duration>P3D</Duration>" in out, False', '<Duration>P3D</Duration>" in out, True'),
+    ("[datetime(2026, 1, 15, 6), datetime(2026, 7, 1, 6), datetime(2026, 7, 15, 6)])",
+     "[datetime(2026, 1, 1, 6), datetime(2026, 1, 15, 6), datetime(2026, 7, 1, 6),"
+     " datetime(2026, 7, 15, 6)])"),
+    ("datetime(2026, 1, 2, 2), datetime(2026, 1, 2, 8)])", "])"),
+    ("[datetime(2026, 1, 4, 8), datetime(2026, 1, 7, 8)])",
+     "[datetime(2026, 1, 1, 8), datetime(2026, 1, 4, 8), datetime(2026, 1, 7, 8)])"),
+    ("31 * 4 + 1", "119"),
+]
+for old, new in reps:
+    assert old in s, old
+    s = s.replace(old, new)
+
+extra = '''
+# --------------------------------------------------------------- 跨度放宽
+yearly = wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-01T05:00:00</StartBoundary>"
+    "<ScheduleByMonth><DaysOfMonth><Day>1</Day></DaysOfMonth><Months><January/></Months>"
+    "</ScheduleByMonth></CalendarTrigger>"))
+check("yearly 5 runs", yearly.next_runs(datetime(2025, 12, 31), 5),
+      [datetime(2026, 1, 1, 5), datetime(2027, 1, 1, 5), datetime(2028, 1, 1, 5),
+       datetime(2029, 1, 1, 5), datetime(2030, 1, 1, 5)])
+check("yearly plan 3y", yearly.plan_window(datetime(2026, 1, 1), datetime(2029, 1, 2)),
+      [datetime(2027, 1, 1, 5), datetime(2028, 1, 1, 5), datetime(2029, 1, 1, 5)])
+check("yearly leap feb29", wtask.parse_task_xml(xml(
+    "<CalendarTrigger><StartBoundary>2026-01-01T05:00:00</StartBoundary>"
+    "<ScheduleByMonth><DaysOfMonth><Day>29</Day></DaysOfMonth><Months><February/></Months>"
+    "</ScheduleByMonth></CalendarTrigger>")).next_runs(datetime(2026, 1, 1), 3),
+    [datetime(2028, 2, 29, 5), datetime(2032, 2, 29, 5), datetime(2036, 2, 29, 5)])
+
+spent = wtask.parse_task_xml(xml(
+    "<TimeTrigger><StartBoundary>2020-01-01T08:00:00</StartBoundary></TimeTrigger>"))
+_t1 = _time.time()
+check("spent one-shot", spent.next_runs(datetime(2026, 1, 1), 5), [])
+_spent_secs = _time.time() - _t1
+check("spent one-shot fast", _spent_secs < 0.5, True)
+spent_rep = wtask.parse_task_xml(xml(
+    "<TimeTrigger><StartBoundary>2020-01-01T08:00:00</StartBoundary>"
+    "<Repetition><Interval>P1D</Interval></Repetition></TimeTrigger>"))
+check("spent with repetition", spent_rep.next_runs(datetime(2026, 1, 1, 12), 2),
+      [datetime(2026, 1, 2, 8), datetime(2026, 1, 3, 8)])
+check("plan window 3 years", len(daily3.plan_window(datetime(2026, 1, 1), datetime(2029, 1, 1))), 366)
+_t2 = _time.time()
+check("many daily runs", len(wtask.parse_task_xml(xml(cal("<ScheduleByDay/>"))).next_runs(
+    datetime(2026, 1, 1), 3000)), 3000)
+print("3000 daily runs %.3fs" % (_time.time() - _t2))
+_far = weekly2.next_runs(datetime(2040, 6, 1), 6)
+_anchor = datetime(2026, 1, 5).date()
+check("weekly far future weekdays", sorted({(m.weekday() + 1) % 7 for m in _far}), [1, 3])
+check("weekly far future time", {m.time() for m in _far}, {weekly2.triggers[0].start.time()})
+check("weekly far future parity",
+      {((m.date() - timedelta(days=m.weekday())) - _anchor).days // 7 % 2 for m in _far}, {0})
+check("weekly far future ordered", _far, sorted(set(_far)))
+check("weekly far future after", all(m > datetime(2040, 6, 1) for m in _far), True)
+check("weekly far future count", len(_far), 6)
+'''
+
+marker = 'print("checks: %d, failures: %d" % (CHECKS[0], len(FAILS)))'
+assert marker in s
+s = s.replace(marker, extra.strip("\n") + "\n\n" + marker)
+
+io.open(p, "w", encoding="utf-8").write(s)
+print("patched ok")
