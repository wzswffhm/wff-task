+show("bytes with decl ok", wtask.parse_task_xml(
+    ('<?xml version="1.0" encoding="UTF-8"?>\n' + SAMPLE).encode("utf-8")) == task)
+
+PREFIXED = SAMPLE.replace(
+    '<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">',
+    '<t:Task version="1.2" xmlns:t="http://schemas.microsoft.com/windows/2004/02/mit/task">'
