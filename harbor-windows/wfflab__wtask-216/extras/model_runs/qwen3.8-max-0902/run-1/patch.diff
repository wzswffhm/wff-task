+
+
+SAMPLE = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <RegistrationInfo><Author>ops</Author></RegistrationInfo>
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <ScheduleByMonthDayOfWeek>
+        <Weeks><Week>5</Week><Week>1</Week></Weeks>
+        <DaysOfWeek><Friday/><Monday/></DaysOfWeek>
+        <Months><July/><January/></Months>
+      </ScheduleByMonthDayOfWeek>
+      <Repetition><Interval>PT90M</Interval><Duration>PT72H</Duration>
+        <StopAtDurationEnd>true</StopAtDurationEnd></Repetition>
+    </CalendarTrigger>
+    <CalendarTrigger>
+      <Enabled>false</Enabled>
+      <StartBoundary>2026-02-01T00:00:00</StartBoundary>
+      <ScheduleByWeek><WeeksInterval>2</WeeksInterval>
+        <DaysOfWeek><Saturday/><Sunday/></DaysOfWeek></ScheduleByWeek>
+    </CalendarTrigger>
+    <TimeTrigger>
+      <StartBoundary>2026-03-01T06:00:00</StartBoundary>
+      <EndBoundary>2026-03-02T06:00:00</EndBoundary>
+      <Repetition><Interval>PT30M</Interval></Repetition>
+    </TimeTrigger>
+  </Triggers>
+  <Settings>
+    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
+    <RandomDelay>PT0S</RandomDelay>
+    <Enabled>true</Enabled>
+    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
+    <RestartCount>3</RestartCount>
