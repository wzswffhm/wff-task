+
+def expect_error(label, kind, func, *args):
+    try:
+        func(*args)
+    except TaskDefError as exc:
+        show(label, "TaskDefError kind=%s ok=%s" % (exc.kind, exc.kind == kind))
+        return
+    except Exception as exc:  # noqa: BLE001
+        show(label, "WRONG EXC %s: %s" % (type(exc).__name__, exc))
+        return
