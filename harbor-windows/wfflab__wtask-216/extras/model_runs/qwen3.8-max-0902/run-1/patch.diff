+"""wtask.schedule —— 触发时间计算。
+
+本模块只做「给定任务与起始时刻，算出接下来的若干次运行时刻」这件事。
+所有计算都在**本地 naive 时间**上进行（不涉及时区与夏令时）。
+
+语义以 ``docs/TASKSCHEMA.md`` §3 ~ §5、§8 为准：
+
+* 每日日程锚定在 ``StartBoundary`` 的日期上（不是当月的日号）；
+* 每周日程按周一起始的周划分，并遵守 ``WeeksInterval``；
+* 每月日程同时受 ``Months`` 与 ``DaysOfMonth`` 约束；
+* ``ScheduleByMonthDayOfWeek`` 的日历周按日号划分，``Week=5`` 表示「该月最后一周」；
+* ``Repetition`` 只保留 ``k×Interval < Duration`` 的时刻，且不得越过 ``EndBoundary``；
+* 被禁用的任务 / 触发器不参与计算。
+"""
+
+import calendar
+from datetime import date, datetime, time, timedelta
+
+from .errors import TaskDefError
+
+#: 主出现扫描的初始跨度（天）。凑不够 ``count`` 次时会按倍数放宽，直到
+#: :data:`MAX_SCAN_DAYS`。
+HORIZON_DAYS = 800
+
+#: 主出现扫描的绝对跨度上限（天），约 100 年，纯防御性。
+MAX_SCAN_DAYS = 36600
+
+#: ``plan_window`` 一次最多枚举多少次运行。
+PLAN_HARD_LIMIT = 20000
+
+#: 单个主出现展开 ``<Repetition>`` 时的防御性步数上限。
+MAX_REPETITION_STEPS = 100000
+
+#: ``DaysInterval`` 允许范围
+DAYS_INTERVAL_RANGE = (1, 365)
+#: ``WeeksInterval`` 允许范围
+WEEKS_INTERVAL_RANGE = (1, 52)
+#: ``<Day>`` 允许范围
+DAY_OF_MONTH_RANGE = (1, 31)
+#: ``<Week>`` 允许范围
+WEEK_OF_MONTH_RANGE = (1, 5)
+#: 表示「该月最后一周」的 ``<Week>`` 取值
+LAST_WEEK_OF_MONTH = 5
+
+#: 已知的触发器类型
+TRIGGER_TYPES = ("time", "daily", "weekly", "monthly", "monthly_dow")
+
+_ZERO = timedelta(0)
+
+
+# ------------------------------------------------------------------ 日历工具
+
+
+def _weekday_index(day):
+    """Python 的 ``date.weekday()`` 是 Monday=0..Sunday=6；本模块统一用 Sunday=0。"""
+    return (day.weekday() + 1) % 7
+
+
+def _week_start(day):
+    """返回 ``day`` 所在周的周一（周按周一起始划分）。"""
+    return day - timedelta(days=day.weekday())
+
+
+def _week_number(day, anchor):
+    """``day`` 所在周与 ``anchor`` 所在周的周序号差（周一起始）。"""
+    return (_week_start(day) - _week_start(anchor)).days // 7
+
+
+def _week_index(day):
+    """返回 ``day`` 在本月内的「日历周」序号（1 起）。
+
+    1–7 日为第 1 周，8–14 日为第 2 周，15–21 日为第 3 周，22–28 日为第 4 周，
+    29 日及以后为第 5 周。
+    """
+    return (day.day - 1) // 7 + 1
+
+
+def _weeks_in_month(day):
+    """返回 ``day`` 所在月份共有多少个「日历周」（4 或 5）。"""
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    return (days_in_month + 6) // 7
+
+
+def _match_week(day, wanted):
+    """``<Week>`` 匹配。
+
+    1..4 表示第 n 周；**5 表示该月的最后一周**（在只有 4 个日历周的月份里，
+    例如平年 2 月，``Week=5`` 匹配第 4 周）。
+    """
+    if not wanted:
+        return False
+    index = _week_index(day)
+    last_index = _weeks_in_month(day)
+    for wanted_week in wanted:
+        if wanted_week == index:
+            return True
+        if wanted_week == LAST_WEEK_OF_MONTH and index == last_index:
+            return True
+    return False
+
+
+def _check_range(value, bounds, name):
+    low, high = bounds
+    if isinstance(value, bool) or not isinstance(value, int) or not low <= value <= high:
+        raise TaskDefError("range", "%s out of %d..%d: %r" % (name, low, high, value))
+    return value
+
+
+def _day_matches(trigger, day):
+    """``day`` 这一天是否是这个触发器的一个主出现日（不看时刻）。"""
+    if trigger.type == "daily":
+        interval = _check_range(trigger.days_interval, DAYS_INTERVAL_RANGE, "DaysInterval")
+        # 锚点是 StartBoundary 的日期，而不是当月的日号。
+        return (day - trigger.start.date()).days % interval == 0
+
+    if trigger.type == "weekly":
+        if _weekday_index(day) not in trigger.days_of_week:
+            return False
+        interval = _check_range(trigger.weeks_interval, WEEKS_INTERVAL_RANGE, "WeeksInterval")
+        # 从 StartBoundary 所在周算起第 0 周触发，之后每隔 interval 周一次。
+        return _week_number(day, trigger.start.date()) % interval == 0
+
+    if trigger.type == "monthly":
+        if trigger.months and day.month not in trigger.months:
+            return False
+        return day.day in trigger.days_of_month
+
+    if trigger.type == "monthly_dow":
+        if trigger.months and day.month not in trigger.months:
+            return False
+        if _weekday_index(day) not in trigger.days_of_week:
+            return False
+        return _match_week(day, trigger.weeks_of_month)
+
+    if trigger.type == "time":
+        return day == trigger.start.date()
+
+    raise TaskDefError("trigger", "unknown trigger type: %r" % (trigger.type,))
+
+
+def _plus_days(day, days):
+    try:
+        return day + timedelta(days=days)
+    except OverflowError:
+        return date.max if days > 0 else date.min
+
+
+# ------------------------------------------------------------------ 出现时刻
+
+
+def _primary_occurrences(trigger, first_day, last_day):
+    """产出 ``[first_day, last_day]`` 内的主出现时刻（升序）。
+
+    主出现时刻必须 ``>= StartBoundary``，并且不得晚于 ``EndBoundary``。
+    """
+    tod = trigger.start.time()
+    start = trigger.start
+    end = trigger.end
+    day = first_day
+    while day <= last_day:
+        if _day_matches(trigger, day):
+            moment = datetime.combine(day, tod)
+            if moment >= start:
+                if end is not None and moment > end:
+                    return
+                yield moment
+        day = _plus_days(day, 1)
+
+
+def _expand(trigger, occurrence, after, count, upper=None):
+    """把一次主出现展开为若干次实际运行（含 ``<Repetition>``）。
+
+    只保留满足 ``k×Interval < Duration`` 的时刻，并受 ``EndBoundary`` 与 ``upper``
+    约束；返回的时刻都严格晚于 ``after``，最多 ``count`` 个。
+    """
+    end = trigger.end
+    rep = trigger.repetition
+
+    if rep is None:
+        if occurrence <= after:
+            return []
+        if end is not None and occurrence > end:
+            return []
+        if upper is not None and occurrence > upper:
+            return []
+        return [occurrence]
+
+    interval = rep.interval
+    if not isinstance(interval, timedelta) or interval <= _ZERO:
+        raise TaskDefError("range", "repetition <Interval> must be a positive duration")
+    duration = rep.duration
+    if duration is not None and not isinstance(duration, timedelta):
+        raise TaskDefError("range", "repetition <Duration> must be a duration")
+
+    # 直接跳到第一个可能晚于 after 的步数，避免逐步扫描久远的主出现。
+    step = 0
+    if after > occurrence:
+        step = int((after - occurrence) // interval) + 1
+    runs = []
+    steps_taken = 0
+    while len(runs) < count and steps_taken < MAX_REPETITION_STEPS:
+        steps_taken += 1
+        try:
+            offset = interval * step
+        except OverflowError:
+            break
+        # 规格 §5：只保留 k×Interval < Duration 的时刻。
+        if duration is not None and offset >= duration:
+            break
+        try:
+            moment = occurrence + offset
+        except OverflowError:
+            break
+        if end is not None and moment > end:
+            break
+        if upper is not None and moment > upper:
+            break
+        if moment > after:
+            runs.append(moment)
+        step += 1
+    return runs
+
+
+def _scan_bounds(trigger, after, upper):
+    """返回主出现日扫描的 ``[first_day, limit_day]``；不可扫描时返回 ``None``。"""
+    first_day = trigger.start.date()
+    if trigger.repetition is None and after.date() > first_day:
+        # 没有重复时，早于 after 当天的主出现不可能产生运行时刻。
+        first_day = after.date()
+    anchor = max(after.date(), trigger.start.date())
+    limit_day = _plus_days(anchor, MAX_SCAN_DAYS)
+    if upper is not None and upper.date() < limit_day:
+        limit_day = upper.date()
+    if trigger.end is not None and trigger.end.date() < limit_day:
+        limit_day = trigger.end.date()
+    if trigger.type == "time":
+        # 一次性触发器只有 StartBoundary 当天这一个主出现日。
+        only = trigger.start.date()
+        if only > first_day:
+            first_day = only
+        if only < limit_day:
+            limit_day = only
+    if limit_day < first_day:
+        return None
+    return first_day, limit_day
+
+
+def _trigger_runs(trigger, after, count, upper=None):
+    """单个（已启用的）触发器在 ``after`` 之后的运行时刻。
+
+    扫描跨度从 :data:`HORIZON_DAYS` 起，凑不够 ``count`` 次时按倍数放宽，
+    直到 ``EndBoundary`` / ``upper`` / :data:`MAX_SCAN_DAYS` 为止。
+    """
+    bounds = _scan_bounds(trigger, after, upper)
+    if bounds is None:
+        return []
+    first_day, limit_day = bounds
+    tod = trigger.start.time()
+
+    runs = []
+    cutoff = None
+    span = HORIZON_DAYS
+    day = first_day
+    while day <= limit_day:
+        if cutoff is not None and datetime.combine(day, tod) > cutoff:
+            # 已经凑够 count 次，且更晚的主出现只会产生更晚的时刻。
+            break
+        last_day = _plus_days(day, span - 1)
+        if last_day > limit_day:
+            last_day = limit_day
+        stop = False
+        for occurrence in _primary_occurrences(trigger, day, last_day):
+            if upper is not None and occurrence > upper:
+                stop = True
+                break
+            if cutoff is not None and occurrence > cutoff:
+                stop = True
+                break
+            runs.extend(_expand(trigger, occurrence, after, count, upper))
+            if cutoff is None and len(runs) >= count:
+                cutoff = sorted(runs)[count - 1]
+        if stop or last_day >= limit_day:
+            break
+        day = _plus_days(last_day, 1)
+        span = min(span * 2, MAX_SCAN_DAYS)
+    return runs
+
+
+def _as_datetime(value, name):
+    if isinstance(value, datetime):
+        return value
+    if isinstance(value, date):
+        return datetime.combine(value, time.min)
+    raise TaskDefError("range", "%s must be a datetime, got %r" % (name, value))
+
+
+# ------------------------------------------------------------------ 公共 API
+
+
+def next_runs(task, after, count):
+    """返回 ``after`` 之后最近的 ``count`` 次运行时刻（升序、去重）。
+
+    * 任务被禁用（``task.enabled`` 为假）时返回空列表；
+    * 触发器被禁用（``trigger.enabled`` 为假）时跳过该触发器；
+    * 返回的时刻**严格大于** ``after``；不足 ``count`` 次时返回实际数量。
+    """
+    if not task.enabled:
+        return []
+    try:
+        wanted = int(count)
+    except (TypeError, ValueError):
+        raise TaskDefError("range", "count must be an integer, got %r" % (count,))
+    if wanted <= 0:
+        return []
+    after = _as_datetime(after, "after")
+
+    moments = set()
+    for trigger in task.triggers:
+        if not trigger.enabled:
+            continue
+        moments.update(_trigger_runs(trigger, after, wanted))
+
+    return sorted(moments)[:wanted]
+
+
+def plan_window(task, start, end):
+    """返回位于 ``(start, end]`` 区间内的全部运行时刻（升序、去重）。"""
+    if not task.enabled:
+        return []
+    start = _as_datetime(start, "start")
+    end = _as_datetime(end, "end")
+    if end < start:
+        return []
+
+    moments = set()
+    for trigger in task.triggers:
+        if not trigger.enabled:
+            continue
+        for moment in _trigger_runs(trigger, start, PLAN_HARD_LIMIT, upper=end):
+            moments.add(moment)
+            if len(moments) >= PLAN_HARD_LIMIT:
+                break
+        if len(moments) >= PLAN_HARD_LIMIT:
+            break
+
+    return sorted(moments)[:PLAN_HARD_LIMIT]
+
+
+def validate_task(task):
+    """跨字段一致性校验；不一致时抛 ``TaskDefError``。"""
+    triggers = tuple(task.triggers or ())
+    if not triggers:
+        raise TaskDefError("structure", "task has no triggers")
+
+    for trigger in triggers:
+        if trigger.end is not None and trigger.end < trigger.start:
+            raise TaskDefError(
+                "structure",
+                "EndBoundary %s is earlier than StartBoundary %s"
+                % (trigger.end.isoformat(), trigger.start.isoformat()),
+            )
+        _validate_trigger(trigger)
+
+    return task
+
+
+def _validate_trigger(trigger):
+    kind = trigger.type
+    if kind not in TRIGGER_TYPES:
+        raise TaskDefError("trigger", "unknown trigger type: %r" % (kind,))
+
+    if kind == "daily":
+        _check_range(trigger.days_interval, DAYS_INTERVAL_RANGE, "DaysInterval")
+    elif kind == "weekly":
+        _check_range(trigger.weeks_interval, WEEKS_INTERVAL_RANGE, "WeeksInterval")
+        _validate_weekdays(trigger.days_of_week)
+    elif kind == "monthly":
+        _validate_days_of_month(trigger.days_of_month)
+        _validate_months(trigger.months)
+    elif kind == "monthly_dow":
+        _validate_weeks_of_month(trigger.weeks_of_month)
+        _validate_weekdays(trigger.days_of_week)
+        _validate_months(trigger.months)
+
+    _validate_repetition(trigger.repetition)
+
+
+def _validate_weekdays(days_of_week):
+    values = tuple(days_of_week or ())
+    if not values:
+        raise TaskDefError("trigger", "<DaysOfWeek> is empty")
+    for value in values:
+        _check_range(value, (0, 6), "day of week")
+
+
+def _validate_days_of_month(days_of_month):
+    values = tuple(days_of_month or ())
+    if not values:
+        raise TaskDefError("trigger", "<DaysOfMonth> is empty")
+    for value in values:
+        _check_range(value, DAY_OF_MONTH_RANGE, "Day")
+
+
+def _validate_weeks_of_month(weeks_of_month):
+    values = tuple(weeks_of_month or ())
+    if not values:
+        raise TaskDefError("trigger", "<Weeks> is empty")
+    for value in values:
+        _check_range(value, WEEK_OF_MONTH_RANGE, "Week")
+
+
+def _validate_months(months):
+    values = tuple(months or ())
+    if not values:
+        raise TaskDefError("trigger", "<Months> is empty")
+    for value in values:
+        _check_range(value, (1, 12), "month")
+
+
+def _validate_repetition(repetition):
+    if repetition is None:
+        return
+    interval = repetition.interval
+    if not isinstance(interval, timedelta) or interval <= _ZERO:
+        raise TaskDefError("range", "repetition <Interval> must be a positive duration")
+    duration = repetition.duration
+    if duration is not None:
+        if not isinstance(duration, timedelta) or duration <= _ZERO:
+            raise TaskDefError("range", "repetition <Duration> must be a positive duration")
