@@ -0,0 +1,40 @@
+import io
+
+p = "wtask/schedule.py"
+s = io.open(p, encoding="utf-8").read()
+
+old = """    limit_day = _plus_days(after.date(), MAX_SCAN_DAYS)"""
+new = """    anchor = max(after.date(), trigger.start.date())
+    limit_day = _plus_days(anchor, MAX_SCAN_DAYS)"""
+assert old in s
+s = s.replace(old, new)
+io.open(p, "w", encoding="utf-8").write(s)
+
+p = "wtask/xmlio.py"
+s = io.open(p, encoding="utf-8").read()
+old = '''def _weekday_elements(days):
+    return "".join("<%s/>" % WEEKDAY_NAMES[day] for day in days)
+
+
+def _month_elements(months):
+    return "".join("<%s/>" % MONTH_NAMES[month - 1] for month in months)'''
+new = '''def _weekday_elements(days):
+    out = []
+    for day in days:
+        if isinstance(day, bool) or not isinstance(day, int) or not 0 <= day <= 6:
+            raise TaskDefError("range", "day of week out of 0..6: %r" % (day,))
+        out.append("<%s/>" % WEEKDAY_NAMES[day])
+    return "".join(out)
+
+
+def _month_elements(months):
+    out = []
+    for month in months:
+        if isinstance(month, bool) or not isinstance(month, int) or not 1 <= month <= 12:
+            raise TaskDefError("range", "month out of 1..12: %r" % (month,))
+        out.append("<%s/>" % MONTH_NAMES[month - 1])
+    return "".join(out)'''
+assert old in s
+s = s.replace(old, new)
+io.open(p, "w", encoding="utf-8").write(s)
+print("ok")
