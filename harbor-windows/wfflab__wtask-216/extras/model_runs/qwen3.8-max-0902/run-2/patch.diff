@@ -0,0 +1,46 @@
+import io
+from datetime import datetime
+
+from wtask import TaskDefError, next_runs, parse_task_xml, task_to_xml
+
+BODY = (
+    '<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">'
+    "<Triggers><CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+    "<ScheduleByDay><DaysInterval>2</DaysInterval></ScheduleByDay></CalendarTrigger>"
+    "</Triggers></Task>"
+)
+
+cases = {
+    "plain str": BODY,
+    "decl utf8 str": '<?xml version="1.0" encoding="UTF-8"?>' + BODY,
+    "decl noenc str": '<?xml version="1.0"?>' + BODY,
+    "bytes utf8": BODY.encode("utf-8"),
+    "bytes decl utf8": ('<?xml version="1.0" encoding="UTF-8"?>' + BODY).encode("utf-8"),
+    "bytes utf16": ('<?xml version="1.0" encoding="UTF-16"?>' + BODY).encode("utf-16"),
+    "str decl utf16": '<?xml version="1.0" encoding="UTF-16"?>' + BODY,
+    "comment in triggers": BODY.replace(
+        "<Triggers>", "<Triggers><!-- hi -->", 1
+    ),
+    "bad xml": "<Task><",
+    "empty": "",
+}
+for name, value in cases.items():
+    try:
+        task = parse_task_xml(value)
+        print("%-22s OK  runs=%s" % (name, next_runs(task, datetime(2026, 1, 1), 2)))
+    except TaskDefError as exc:
+        print("%-22s TaskDefError(%s): %s" % (name, exc.kind, exc.message))
+    except Exception as exc:  # noqa: BLE001
+        print("%-22s !!! %s: %s" % (name, type(exc).__name__, exc))
+
+# 中文/非 ASCII 内容（作者字段被忽略，但必须能解析）
+uni = BODY.replace("<Triggers>", "<Triggers>", 1)
+uni = ('<?xml version="1.0" encoding="UTF-8"?><Task version="1.2">'
+       "<RegistrationInfo><Author>值班</Author></RegistrationInfo>"
+       "<Triggers><CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+       "<ScheduleByDay/></CalendarTrigger></Triggers></Task>")
+t = parse_task_xml(uni.encode("utf-8"))
+print("unicode bytes:", t.version, next_runs(t, datetime(2026, 1, 1), 1))
+t2 = parse_task_xml(uni)
+print("unicode str  :", t2.version, next_runs(t2, datetime(2026, 1, 1), 1))
+print(task_to_xml(t2))
diff --git a/scratch_patch.py b/scratch_patch.py
new file mode 100644
index 0000000..36ea127
--- /dev/null
+++ b/scratch_patch.py
@@ -0,0 +1,32 @@
+import io
+
+p = "wtask/xmlio.py"
+s = io.open(p, encoding="utf-8").read()
+
+old = '''    try:
+        root = ET.fromstring(text)
+    except ET.ParseError as exc:
+        raise TaskDefError("xml", str(exc))
+    except ValueError as exc:
+        # 例如「带 encoding 声明的 unicode 字符串」这类解析层错误。
+        raise TaskDefError("xml", str(exc))
+'''
+
+new = '''    try:
+        root = ET.fromstring(text)
+    except ET.ParseError as exc:
+        raise TaskDefError("xml", str(exc))
+    except ValueError:
+        # str 里带 encoding 声明时 ElementTree 会拒绝，改用字节流再试一次。
+        try:
+            root = ET.fromstring(text.encode("utf-8"))
+        except Exception as exc:
+            raise TaskDefError("xml", str(exc))
+    except Exception as exc:
+        raise TaskDefError("xml", str(exc))
+'''
+
+assert old in s, "anchor not found"
+s = s.replace(old, new, 1)
+io.open(p, "w", encoding="utf-8").write(s)
+print("patched xmlio")
