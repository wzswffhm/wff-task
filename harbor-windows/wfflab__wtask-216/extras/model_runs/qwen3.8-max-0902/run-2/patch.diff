--- /dev/null
+++ b/scratch_random.py
@@ -0,0 +1,131 @@
+"""临时随机对照自检（提交前删除）。"""
+import calendar
+import random
+from datetime import datetime, timedelta
+
+from wtask import Repetition, Task, Trigger, next_runs, plan_window
+from wtask.schedule import HORIZON_DAYS
+
+FAILS = []
+
+
+def naive_runs(trigger, after, scan_end, run_cap=None):
+    """朴素参考实现：逐日逐 k 枚举。"""
+    out = set()
+    start = trigger.start
+    day = start.date()
+    tod = start.time()
+    while day <= scan_end:
+        match = False
+        if trigger.type == "daily":
+            match = (day - start.date()).days % trigger.days_interval == 0
+        elif trigger.type == "weekly":
+            wd = (day.weekday() + 1) % 7
+            if wd in trigger.days_of_week:
+                w0 = day - timedelta(days=day.weekday())
+                w1 = start.date() - timedelta(days=start.date().weekday())
+                match = ((w0 - w1).days // 7) % trigger.weeks_interval == 0
+        elif trigger.type == "monthly":
+            match = day.month in trigger.months and day.day in trigger.days_of_month
+        elif trigger.type == "monthly_dow":
+            dim = calendar.monthrange(day.year, day.month)[1]
+            last = (dim + 6) // 7
+            idx = (day.day - 1) // 7 + 1
+            idxs = {last if w == 5 else w for w in trigger.weeks_of_month}
+            match = (day.month in trigger.months
+                     and (day.weekday() + 1) % 7 in trigger.days_of_week
+                     and idx in idxs)
+        elif trigger.type == "time":
+            match = day == start.date()
+        if match:
+            moment = datetime.combine(day, tod)
+            if moment >= start and (trigger.end is None or moment <= trigger.end):
+                rep = trigger.repetition
+                k = 0
+                while True:
+                    if rep is None:
+                        out.add(moment)
+                        break
+                    off = rep.interval * k
+                    if rep.duration is not None and off >= rep.duration:
+                        break
+                    run = moment + off
+                    if trigger.end is not None and run > trigger.end:
+                        break
+                    if run_cap is not None and run > run_cap:
+                        break
+                    out.add(run)
+                    k += 1
+        day += timedelta(days=1)
+    return sorted(m for m in out if m > after)
+
+
+random.seed(20260101)
+for case in range(400):
+    start = datetime(2026, 1, 1) + timedelta(days=random.randint(0, 40),
+                                             hours=random.randint(0, 23),
+                                             minutes=random.choice([0, 15, 30, 45]))
+    kind = random.choice(["daily", "weekly", "monthly", "monthly_dow", "time"])
+    kwargs = {"type": kind, "start": start}
+    if kind == "daily":
+        kwargs["days_interval"] = random.choice([1, 2, 3, 7, 30])
+    elif kind == "weekly":
+        kwargs["weeks_interval"] = random.choice([1, 2, 3, 4])
+        kwargs["days_of_week"] = tuple(sorted(random.sample(range(7), random.randint(1, 3))))
+    elif kind == "monthly":
+        kwargs["days_of_month"] = tuple(sorted(random.sample(range(1, 32), random.randint(1, 4))))
+        kwargs["months"] = tuple(sorted(random.sample(range(1, 13), random.randint(1, 5))))
