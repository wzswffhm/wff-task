+
+
+def expect_error(name, kind, fn):
+    try:
+        fn()
+    except TaskDefError as exc:
+        if exc.kind != kind:
+            FAILS.append("%s: kind=%r want %r (%s)" % (name, exc.kind, kind, exc))
+    except Exception as exc:  # noqa: BLE001
+        FAILS.append("%s: raised %s(%s) want TaskDefError(%s)" % (name, type(exc).__name__, exc, kind))
+    else:
+        FAILS.append("%s: no error, want TaskDefError(%s)" % (name, kind))
