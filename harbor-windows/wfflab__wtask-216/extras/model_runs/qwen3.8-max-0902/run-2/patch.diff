+def last_week_fridays(year_from, year_to):
+    """独立实现：Week=5 -> 该月最后一个日历周里的周五。"""
+    out = []
+    for year in range(year_from, year_to + 1):
+        dim = calendar.monthrange(year, 2)[1]
+        weeks = (dim + 6) // 7
+        for day in range(1, dim + 1):
+            if (day - 1) // 7 + 1 == weeks and calendar.weekday(year, 2, day) == 4:
+                out.append(datetime(year, 2, day, 6))
+    return out
+
