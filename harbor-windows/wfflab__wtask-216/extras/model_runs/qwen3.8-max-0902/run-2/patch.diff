+        raise TaskDefError("trigger", "duplicate weekday in <DaysOfWeek>")
+
+
+def _validate_months(months):
+    values = tuple(months or ())
+    if not values:
+        raise TaskDefError("trigger", "<Months> is empty")
+    for value in values:
+        if not 1 <= value <= 12:
+            raise TaskDefError("range", "month %r out of 1..12" % (value,))
+    if len(set(values)) != len(values):
+        raise TaskDefError("trigger", "duplicate month in <Months>")
