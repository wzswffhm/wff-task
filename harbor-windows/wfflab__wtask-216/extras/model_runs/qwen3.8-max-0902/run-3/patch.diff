+++ b/_tmp_edge.py
@@ -0,0 +1,181 @@
+"""临时边界验证（提交前删除）。"""
+from datetime import datetime, timedelta
+
+import wtask
+from wtask import TaskDefError
+
+FAILS = []
+
+
+def check(label, got, want):
+    if got != want:
+        FAILS.append(label)
+        print("FAIL %-40s\n  got =%r\n  want=%r" % (label, got, want))
+    else:
+        print("ok   %s" % label)
+
+
+def expect_error(label, kind, fn):
+    try:
+        fn()
+    except TaskDefError as exc:
+        check(label, exc.kind, kind)
+    except Exception as exc:  # noqa
+        FAILS.append(label)
+        print("FAIL %-40s raised %r" % (label, exc))
+    else:
+        FAILS.append(label)
+        print("FAIL %-40s no error" % label)
+
+
+def T(body, settings="", version="1.2"):
+    return wtask.parse_task_xml(
+        '<Task version="%s"><Triggers>%s</Triggers>%s</Task>' % (version, body, settings))
+
+
+TIME1 = "<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary></TimeTrigger>"
+
+# 1. 超大间隔（OverflowError 防护）
+huge = T("<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+         "<Repetition><Interval>P3000000D</Interval></Repetition></TimeTrigger>")
+check("huge interval", huge.next_runs(datetime(2025, 1, 1), 3), [datetime(2026, 1, 1)])
+
+# 2. 带命名空间前缀 / 缩进 / bytes
+prefixed = (
+    '<?xml version="1.0" encoding="UTF-8"?>\n'
+    '<t:Task version="1.2" xmlns:t="http://schemas.microsoft.com/windows/2004/02/mit/task">\n'
+    "  <t:Triggers>\n"
+    "    <t:CalendarTrigger>\n"
+    "      <t:StartBoundary>2026-01-01T08:00:00</t:StartBoundary>\n"
+    "      <t:ScheduleByDay>\n        <t:DaysInterval>2</t:DaysInterval>\n      </t:ScheduleByDay>\n"
+    "    </t:CalendarTrigger>\n"
+    "  </t:Triggers>\n"
+    "  <t:Settings>\n    <t:RandomDelay>PT5M</t:RandomDelay>\n  </t:Settings>\n"
+    "</t:Task>\n")
+t = wtask.parse_task_xml(prefixed)
+check("prefixed ns", t.triggers[0].days_interval, 2)
+check("random delay", t.random_delay, timedelta(minutes=5))
+check("bytes input", wtask.parse_task_xml(prefixed.encode("utf-8")), t)
+check("random delay roundtrip", "<RandomDelay>PT5M</RandomDelay>" in wtask.task_to_xml(t), True)
+
+# 3. 多个触发器 + 重复 -> 合并去重升序
+multi = T(
+    "<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+    "<ScheduleByDay/><Repetition><Interval>PT12H</Interval><Duration>P1D</Duration></Repetition>"
+    "</CalendarTrigger>"
+    "<TimeTrigger><StartBoundary>2026-01-02T14:00:00</StartBoundary></TimeTrigger>")
+check("multi merge", multi.next_runs(datetime(2026, 1, 1, 0), 6), [
+    datetime(2026, 1, 1, 8), datetime(2026, 1, 1, 20),
+    datetime(2026, 1, 2, 8), datetime(2026, 1, 2, 14), datetime(2026, 1, 2, 20),
+    datetime(2026, 1, 3, 8)])
+check("multi duration P1D", multi.triggers[0].repetition.duration, timedelta(days=1))
+
+# 4. StopAtDurationEnd 只在为真时写出
+sae = T("<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+        "<Repetition><Interval>PT5M</Interval><StopAtDurationEnd>true</StopAtDurationEnd>"
+        "</Repetition></TimeTrigger>")
+check("stop true written", "<StopAtDurationEnd>true</StopAtDurationEnd>" in wtask.task_to_xml(sae), True)
+check("stop true parsed", sae.triggers[0].repetition.stop_at_duration_end, True)
+sae2 = T("<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+         "<Repetition><Interval>PT5M</Interval><StopAtDurationEnd>false</StopAtDurationEnd>"
+         "</Repetition></TimeTrigger>")
+check("stop false omitted", "StopAtDurationEnd" in wtask.task_to_xml(sae2), False)
+check("stop false roundtrip", wtask.parse_task_xml(wtask.task_to_xml(sae2)), sae2)
+
+# 5. Interval 规范形式回写
+canon = T("<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+          "<Repetition><Interval>PT72H</Interval><Duration>PT90M</Duration></Repetition>"
+          "</TimeTrigger>")
+x = wtask.task_to_xml(canon)
+check("interval canonical", "<Interval>P3D</Interval>" in x, True)
+check("duration canonical", "<Duration>PT1H30M</Duration>" in x, True)
+check("canonical reparsed", canon.triggers[0].repetition,
+      wtask.Repetition(interval=timedelta(days=3), duration=timedelta(hours=1, minutes=30)))
+
+# 6. 大小写布尔 / 设置默认值
+b = T("<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary><Enabled>TRUE</Enabled>"
+      "</TimeTrigger>", "<Settings><Enabled>FALSE</Enabled></Settings>")
+check("bool TRUE", b.triggers[0].enabled, True)
+check("settings FALSE", b.enabled, False)
+check("disabled -> empty", b.next_runs(datetime(2025, 1, 1), 3), [])
+check("disabled xml", "<Enabled>false</Enabled>" in wtask.task_to_xml(b), True)
+check("default policy", T(TIME1).multiple_instances, "IgnoreNew")
+check("policy kept", T(TIME1, "<Settings><MultipleInstancesPolicy>Parallel</MultipleInstancesPolicy></Settings>").multiple_instances, "Parallel")
+
+# 7. plan_window 边界
+pw = T("<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+       "<ScheduleByDay/></CalendarTrigger>")
+check("pw left exclusive", wtask.plan_window(pw, datetime(2026, 1, 1, 8), datetime(2026, 1, 3, 8)),
+      [datetime(2026, 1, 2, 8), datetime(2026, 1, 3, 8)])
+check("pw right inclusive", wtask.plan_window(pw, datetime(2026, 1, 1, 7, 59, 59),
+                                              datetime(2026, 1, 1, 8)),
+      [datetime(2026, 1, 1, 8)])
+check("pw empty", wtask.plan_window(pw, datetime(2026, 1, 1, 8, 1), datetime(2026, 1, 2, 7)), [])
+check("pw before start", wtask.plan_window(pw, datetime(2020, 1, 1), datetime(2020, 2, 1)), [])
+check("pw long span", len(wtask.plan_window(pw, datetime(2026, 1, 1), datetime(2040, 1, 1))), 5114)
+
+# 8. EndBoundary 截断日程
+eb = T("<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+       "<EndBoundary>2026-01-03T09:00:00</EndBoundary><ScheduleByDay/></CalendarTrigger>")
+check("end cuts daily", eb.next_runs(datetime(2025, 1, 1), 5), [
+    datetime(2026, 1, 1, 8), datetime(2026, 1, 2, 8), datetime(2026, 1, 3, 8)])
+check("end cuts daily after", eb.next_runs(datetime(2026, 1, 3, 8), 5), [])
+check("pw end cut", wtask.plan_window(eb, datetime(2026, 1, 1), datetime(2026, 2, 1)), [
+    datetime(2026, 1, 1, 8), datetime(2026, 1, 2, 8), datetime(2026, 1, 3, 8)])
+check("end written", "<EndBoundary>2026-01-03T09:00:00</EndBoundary>" in wtask.task_to_xml(eb), True)
+
+# 9. 忽略的根级元素不影响回写
+ign = wtask.parse_task_xml(
+    '<Task version="1.2"><RegistrationInfo><Author>a</Author></RegistrationInfo>'
+    "<Triggers>" + TIME1 + "</Triggers>"
+    "<Actions><Exec><Command>x</Command></Exec></Actions><Data>1</Data></Task>")
+once = wtask.task_to_xml(ign)
+check("ignored elements", wtask.task_to_xml(wtask.parse_task_xml(once)), once)
+check("ignored not written", "Actions" in once or "RegistrationInfo" in once, False)
+
+# 10. 错误类型
+expect_error("xml garbage", "xml", lambda: wtask.parse_task_xml("<Task version='1.2'></Task"))
+expect_error("None input", "xml", lambda: wtask.parse_task_xml(None))
+expect_error("nul in xml", "xml", lambda: wtask.parse_task_xml("<Task>\x00</Task>"))
+expect_error("dup Settings", "schema", lambda: T(TIME1, "<Settings/><Settings/>"))
+expect_error("dup Triggers", "schema", lambda: wtask.parse_task_xml(
+    '<Task version="1.2"><Triggers>' + TIME1 + "</Triggers><Triggers>" + TIME1 + "</Triggers></Task>"))
+expect_error("two schedules", "trigger", lambda: T(
+    "<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+    "<ScheduleByDay/><ScheduleByDay/></CalendarTrigger>"))
+expect_error("unknown schedule child", "trigger", lambda: T(
+    "<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+    "<ScheduleByDay><DaysInterval>1</DaysInterval><Foo/></ScheduleByDay></CalendarTrigger>"))
+expect_error("unknown month", "trigger", lambda: T(
+    "<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+    "<ScheduleByMonth><DaysOfMonth><Day>1</Day></DaysOfMonth><Months><Januar/></Months>"
+    "</ScheduleByMonth></CalendarTrigger>"))
+expect_error("unknown weekday", "trigger", lambda: T(
+    "<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+    "<ScheduleByWeek><DaysOfWeek><Mon/></DaysOfWeek></ScheduleByWeek></CalendarTrigger>"))
+expect_error("bad rep child", "trigger", lambda: T(
+    "<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+    "<Repetition><Interval>PT5M</Interval><Nope/></Repetition></TimeTrigger>"))
+expect_error("bad DaysInterval text", "range", lambda: T(
+    "<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+    "<ScheduleByDay><DaysInterval>abc</DaysInterval></ScheduleByDay></CalendarTrigger>"))
+expect_error("bad StopAtDurationEnd", "range", lambda: T(
+    "<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+    "<Repetition><Interval>PT5M</Interval><StopAtDurationEnd>maybe</StopAtDurationEnd>"
+    "</Repetition></TimeTrigger>"))
+expect_error("bad settings bool", "range", lambda: T(TIME1, "<Settings><Enabled>2</Enabled></Settings>"))
+expect_error("short datetime", "range", lambda: T(
+    "<TimeTrigger><StartBoundary>2026-01-01</StartBoundary></TimeTrigger>"))
+expect_error("bad random delay", "duration", lambda: T(TIME1, "<Settings><RandomDelay>PT</RandomDelay></Settings>"))
+expect_error("bad version", "version", lambda: T(TIME1, version="2.0"))
+
+# 11. TaskDefError 本身
+err = TaskDefError("range", "boom")
+check("kind attr", err.kind, "range")
+check("message attr", err.message, "boom")
+check("is Exception", isinstance(err, Exception), True)
+check("kinds tuple", TaskDefError.KINDS,
+      ("xml", "schema", "version", "trigger", "range", "duration", "structure"))
+
+print()
+print("FAILURES: %d %s" % (len(FAILS), FAILS))
diff --git a/_tmp_patch.py b/_tmp_patch.py
