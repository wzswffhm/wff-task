+"""临时验证（提交前删除）。"""
+from datetime import datetime, timedelta
+
+import wtask
+
+FAILS = []
+
+
+def check(label, got, want):
+    if got != want:
+        FAILS.append(label)
+        print("FAIL %-40s\n  got =%r\n  want=%r" % (label, got, want))
+    else:
+        print("ok   %s" % label)
+
+
+def T(body):
+    return wtask.parse_task_xml('<Task version="1.2"><Triggers>%s</Triggers></Task>' % body)
+
+
+# 重复窗口跨过 after
+r = T("<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+      "<ScheduleByDay/><Repetition><Interval>PT30M</Interval><Duration>PT2H</Duration>"
+      "</Repetition></CalendarTrigger>")
+check("mid-duration after", r.next_runs(datetime(2026, 1, 1, 9, 15), 5), [
+    datetime(2026, 1, 1, 9, 30),
+    datetime(2026, 1, 2, 8), datetime(2026, 1, 2, 8, 30),
+    datetime(2026, 1, 2, 9), datetime(2026, 1, 2, 9, 30)])
+check("exact occurrence after", r.next_runs(datetime(2026, 1, 1, 8), 2),
+      [datetime(2026, 1, 1, 8, 30), datetime(2026, 1, 1, 9)])
+check("plan_window rep", wtask.plan_window(r, datetime(2026, 1, 1, 0), datetime(2026, 1, 2, 0)), [
+    datetime(2026, 1, 1, 8), datetime(2026, 1, 1, 8, 30),
+    datetime(2026, 1, 1, 9), datetime(2026, 1, 1, 9, 30)])
+
+# Duration 恰好是 Interval 的整数倍
+r2 = T("<TimeTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+       "<Repetition><Interval>PT1H</Interval><Duration>PT3H</Duration></Repetition></TimeTrigger>")
+check("exact multiple", r2.next_runs(datetime(2026, 1, 1), 5), [
+    datetime(2026, 1, 1, 8), datetime(2026, 1, 1, 9), datetime(2026, 1, 1, 10)])
+
+# Duration 不是整数倍
+r3 = T("<TimeTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+       "<Repetition><Interval>PT2H</Interval><Duration>PT5H</Duration></Repetition></TimeTrigger>")
+check("non multiple", r3.next_runs(datetime(2026, 1, 1), 5), [
+    datetime(2026, 1, 1, 8), datetime(2026, 1, 1, 10), datetime(2026, 1, 1, 12)])
+
+# Duration 小于 Interval -> 只有主出现
