+    '<TimeTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary></TimeTrigger>', version="1.0")).version, "1.0")
+
+# validate_task
+expect_error("validate end<start", "structure", lambda: wtask.validate_task(wtask.model.Task(
+    version="1.2", triggers=(wtask.Trigger(type="time", start=datetime(2026, 1, 2), end=datetime(2026, 1, 1)),))))
+expect_error("validate no triggers", "structure",
+             lambda: wtask.validate_task(wtask.model.Task(version="1.2", triggers=())))
+check("validate ok", wtask.validate_task(pw), pw)
+
+print()
+print("FAILURES: %d" % len(FAILS))
+for f in FAILS:
+    print(" -", f)
