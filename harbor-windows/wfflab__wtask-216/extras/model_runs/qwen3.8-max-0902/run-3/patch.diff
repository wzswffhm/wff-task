index 0000000..1753e18
--- /dev/null
+++ b/_tmp_patch.py
@@ -0,0 +1,36 @@
+"""临时补丁脚本（提交前删除）。"""
+import io
+
+p = "wtask/schedule.py"
+s = io.open(p, encoding="utf-8").read()
+
+old_import = "from datetime import datetime, timedelta\n"
+new_import = "from datetime import date, datetime, timedelta\n"
+assert old_import in s
+s = s.replace(old_import, new_import, 1)
+
+anchor = "def _scan_bounds(trigger, after, horizon_days, hard_stop=None):"
+helper = '''def _shift_day(day, days):
+    """``date`` 平移，越界时夹到 ``date.min`` / ``date.max``（不抛 OverflowError）。"""
+    try:
+        return day + timedelta(days=days)
+    except OverflowError:
+        return date.max if days > 0 else date.min
+
+
+'''
+assert anchor in s
+s = s.replace(anchor, helper + anchor, 1)
+
+old = "    last = max(after.date(), start_day) + timedelta(days=horizon_days)\n"
+new = "    last = _shift_day(max(after.date(), start_day), horizon_days)\n"
+assert old in s
+s = s.replace(old, new, 1)
+
+old = "        first = max(start_day, after.date() - timedelta(days=lookback))\n"
+new = "        first = max(start_day, _shift_day(after.date(), -lookback))\n"
+assert old in s
+s = s.replace(old, new, 1)
+
+io.open(p, "w", encoding="utf-8", newline="").write(s)
+print("patched")
diff --git a/_tmp_perf.py b/_tmp_perf.py
new file mode 100644
index 0000000..a6824c3
--- /dev/null
+++ b/_tmp_perf.py
@@ -0,0 +1,138 @@
+"""临时性能 / 边界验证（提交前删除）。"""
+import time
+from datetime import datetime, timedelta
+
+import wtask
+
+FAILS = []
+
+
+def check(label, got, want):
+    if got != want:
+        FAILS.append(label)
+        print("FAIL %-40s got=%r want=%r" % (label, got, want))
+    else:
+        print("ok   %s" % label)
+
+
+def timed(label, fn):
+    t0 = time.time()
+    out = fn()
+    dt = time.time() - t0
+    print("%-40s %.3fs -> %s" % (label, dt, (len(out) if isinstance(out, list) else out)))
+    if dt > 2.0:
+        FAILS.append("slow: " + label)
+    return out
+
+
+def mk(body, settings=""):
+    return wtask.parse_task_xml(
+        '<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">'
+        "<Triggers>%s</Triggers>%s</Task>" % (body, settings))
+
+
+# 永不触发的日程：2 月 30 日
+never = mk("<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+           "<ScheduleByMonth><DaysOfMonth><Day>30</Day></DaysOfMonth>"
+           "<Months><February/></Months></ScheduleByMonth></CalendarTrigger>")
+timed("never-firing next_runs", lambda: never.next_runs(datetime(2026, 1, 1), 5))
+check("never-firing empty", never.next_runs(datetime(2026, 1, 1), 5), [])
+
+# 每日任务，10 年 plan_window
+daily = mk("<CalendarTrigger><StartBoundary>2020-01-01T08:00:00</StartBoundary>"
+           "<ScheduleByDay/></CalendarTrigger>")
+timed("daily plan_window 10y", lambda: wtask.plan_window(
+    daily, datetime(2026, 1, 1), datetime(2036, 1, 1)))
+check("daily plan_window 10y count", len(wtask.plan_window(
+    daily, datetime(2026, 1, 1), datetime(2036, 1, 1))), 3652)
+
+# 密集重复：PT1S / PT1H，每日
+dense = mk("<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+           "<ScheduleByDay/><Repetition><Interval>PT1S</Interval>"
+           "<Duration>PT1H</Duration></Repetition></CalendarTrigger>")
+timed("dense plan_window 1d", lambda: wtask.plan_window(
+    dense, datetime(2026, 1, 1), datetime(2026, 1, 2)))
+check("dense count 1d", len(wtask.plan_window(
+    dense, datetime(2026, 1, 1), datetime(2026, 1, 2))), 3600)
+
+# 不限时长的密集重复（退化配置）
+wild = mk("<CalendarTrigger><StartBoundary>2020-01-01T00:00:00</StartBoundary>"
+          "<ScheduleByDay/><Repetition><Interval>PT1S</Interval></Repetition></CalendarTrigger>")
+timed("wild unbounded next_runs", lambda: wild.next_runs(datetime(2026, 1, 1), 5))
+timed("wild unbounded plan_window", lambda: wtask.plan_window(
+    wild, datetime(2026, 1, 1), datetime(2026, 1, 2)))
+
+# 稀疏日程：Week=5 星期五 + 2 月
+sparse = mk("<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+            "<ScheduleByMonthDayOfWeek><Weeks><Week>5</Week></Weeks>"
+            "<DaysOfWeek><Friday/></DaysOfWeek><Months><February/></Months>"
+            "</ScheduleByMonthDayOfWeek></CalendarTrigger>")
+timed("sparse next_runs 6", lambda: sparse.next_runs(datetime(2026, 1, 1), 6))
+print("   ", sparse.next_runs(datetime(2026, 1, 1), 6))
+
+# 闰日
+leap = mk("<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+          "<ScheduleByMonth><DaysOfMonth><Day>29</Day></DaysOfMonth>"
+          "<Months><February/></Months></ScheduleByMonth></CalendarTrigger>")
+check("feb29", leap.next_runs(datetime(2026, 1, 1), 3),
+      [datetime(2028, 2, 29), datetime(2032, 2, 29), datetime(2036, 2, 29)])
+
+# 每周 WeeksInterval=2 跨月
+wk = mk("<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+        "<ScheduleByWeek><DaysOfWeek><Sunday/></DaysOfWeek>"
+        "<WeeksInterval>2</WeeksInterval></ScheduleByWeek></CalendarTrigger>")
+check("weekly2 sunday", wk.next_runs(datetime(2026, 1, 1), 4),
+      [datetime(2026, 1, 4, 8), datetime(2026, 1, 18, 8),
+       datetime(2026, 2, 1, 8), datetime(2026, 2, 15, 8)])
+
+# 31 日在短月不存在
+m31 = mk("<CalendarTrigger><StartBoundary>2026-01-01T00:00:00</StartBoundary>"
+         "<ScheduleByMonth><DaysOfMonth><Day>31</Day></DaysOfMonth>"
+         "<Months><January/><February/><March/><April/></Months></ScheduleByMonth></CalendarTrigger>")
+check("day31", m31.next_runs(datetime(2026, 1, 1), 3),
+      [datetime(2026, 1, 31), datetime(2026, 3, 31), datetime(2027, 1, 31)])
+
+# EndBoundary 已过
+past = mk("<TimeTrigger><StartBoundary>2020-01-01T08:00:00</StartBoundary>"
+          "<EndBoundary>2020-01-02T08:00:00</EndBoundary></TimeTrigger>")
+check("past end", past.next_runs(datetime(2026, 1, 1), 3), [])
+
+# EndBoundary 精确等于主出现
+edge = mk("<TimeTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+          "<EndBoundary>2026-01-01T08:00:00</EndBoundary></TimeTrigger>")
+check("end == start", edge.next_runs(datetime(2025, 1, 1), 3), [datetime(2026, 1, 1, 8)])
+
+# 确定性：同一份 XML 多次计算结果一致
+xml = wtask.task_to_xml(sparse)
+first = sparse.next_runs(datetime(2026, 1, 1), 5)
+for _ in range(3):
+    again = wtask.parse_task_xml(xml)
+    if again.next_runs(datetime(2026, 1, 1), 5) != first:
+        FAILS.append("nondeterministic")
+check("deterministic", True, True)
+check("canonical idempotent", wtask.task_to_xml(wtask.parse_task_xml(xml)), xml)
+
+# 全部四种日程的 roundtrip
+samples = [
+    "<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary><ScheduleByDay/></CalendarTrigger>",
+    "<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+    "<ScheduleByWeek><DaysOfWeek><Saturday/><Tuesday/></DaysOfWeek></ScheduleByWeek></CalendarTrigger>",
+    "<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+    "<ScheduleByMonth><DaysOfMonth><Day>15</Day><Day>1</Day></DaysOfMonth>"
+    "<Months><December/><February/></Months></ScheduleByMonth></CalendarTrigger>",
+    "<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>"
+    "<ScheduleByMonthDayOfWeek><Weeks><Week>3</Week><Week>1</Week></Weeks>"
+    "<DaysOfWeek><Friday/></DaysOfWeek><Months><November/><January/></Months>"
+    "</ScheduleByMonthDayOfWeek></CalendarTrigger>",
+    "<TimeTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary></TimeTrigger>",
+]
+for i, body in enumerate(samples):
+    t = mk(body)
+    x1 = wtask.task_to_xml(t)
+    t2 = wtask.parse_task_xml(x1)
+    x2 = wtask.task_to_xml(t2)
+    check("roundtrip %d equal" % i, t2, t)
+    check("roundtrip %d idempotent" % i, x2, x1)
+
+print()
+print("FAILURES: %d %s" % (len(FAILS), FAILS))
