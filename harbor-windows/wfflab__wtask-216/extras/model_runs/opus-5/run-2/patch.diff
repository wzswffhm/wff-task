index 0000000..1ae5276
--- /dev/null
+++ b/test_issues.py
@@ -0,0 +1,267 @@
+"""Comprehensive test for all 10 reported issues."""
+from datetime import datetime, timedelta
+from wtask import parse_task_xml, task_to_xml, TaskDefError
+
+def test_issue_1_daily_phase():
+    """Issue 1: Daily task phase anchored to StartBoundary."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+          <ScheduleByDay><DaysInterval>3</DaysInterval></ScheduleByDay>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy></Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    runs = task.next_runs(datetime(2025, 12, 31, 0, 0, 0), 5)
+    expected = [
+        datetime(2026, 1, 1, 8, 0, 0),
+        datetime(2026, 1, 4, 8, 0, 0),
+        datetime(2026, 1, 7, 8, 0, 0),
+        datetime(2026, 1, 10, 8, 0, 0),
+        datetime(2026, 1, 13, 8, 0, 0),
+    ]
+    assert runs == expected, f"Expected {expected}, got {runs}"
+    print("OK Issue 1: Daily task phase anchored correctly")
+
+
+def test_issue_2_weeks_interval():
+    """Issue 2: WeeksInterval=2 should skip weeks."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-01-05T08:00:00</StartBoundary>
+          <ScheduleByWeek>
+            <DaysOfWeek><Monday/></DaysOfWeek>
+            <WeeksInterval>2</WeeksInterval>
+          </ScheduleByWeek>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy></Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    runs = task.next_runs(datetime(2026, 1, 1, 0, 0, 0), 6)
+    expected = [
+        datetime(2026, 1, 5, 8, 0, 0),   # Week 0 (starting week)
+        datetime(2026, 1, 19, 8, 0, 0),  # Week 2
+        datetime(2026, 2, 2, 8, 0, 0),   # Week 4
+        datetime(2026, 2, 16, 8, 0, 0),  # Week 6
+        datetime(2026, 3, 2, 8, 0, 0),   # Week 8
+        datetime(2026, 3, 16, 8, 0, 0),  # Week 10
+    ]
+    assert runs == expected, f"Expected {expected}, got {runs}"
+    print("OK Issue 2: WeeksInterval=2 works correctly")
+
+
+def test_issue_3_months_filter():
+    """Issue 3: Months filter should be respected."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+          <ScheduleByMonth>
+            <DaysOfMonth><Day>15</Day></DaysOfMonth>
+            <Months><January/><July/></Months>
+          </ScheduleByMonth>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy></Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    runs = task.next_runs(datetime(2025, 12, 31, 0, 0, 0), 4)
+    expected = [
+        datetime(2026, 1, 15, 8, 0, 0),
+        datetime(2026, 7, 15, 8, 0, 0),
+        datetime(2027, 1, 15, 8, 0, 0),
+        datetime(2027, 7, 15, 8, 0, 0),
+    ]
+    assert runs == expected, f"Expected {expected}, got {runs}"
+    print("OK Issue 3: Months filter respected")
+
+
+def test_issue_4_week_5_semantics():
+    """Issue 4: Week=5 means last week of month."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-02-01T08:00:00</StartBoundary>
+          <ScheduleByMonthDayOfWeek>
+            <Weeks><Week>5</Week></Weeks>
+            <DaysOfWeek><Friday/></DaysOfWeek>
+            <Months><February/></Months>
+          </ScheduleByMonthDayOfWeek>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy></Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    runs = task.next_runs(datetime(2026, 1, 1, 0, 0, 0), 2)
+    # Feb 2026: 28 days (4 weeks), so Week 5 = Week 4 -> 2026-02-27 Friday
+    # Feb 2027: 28 days (4 weeks), so Week 5 = Week 4 -> 2027-02-26 Friday
+    # Feb 2028: 29 days (5 weeks with day 29), Week 5 exists but need to check
+    expected = [
+        datetime(2026, 2, 27, 8, 0, 0),
+        datetime(2027, 2, 26, 8, 0, 0),
+    ]
+    assert runs == expected, f"Expected {expected}, got {runs}"
+    print("OK Issue 4: Week=5 semantics correct")
+
+
+def test_issue_5_repetition_count():
+    """Issue 5: Repetition should satisfy k*Interval < Duration."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+          <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+          <Repetition>
+            <Interval>PT30M</Interval>
+            <Duration>PT1H</Duration>
+          </Repetition>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy></Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    runs = task.next_runs(datetime(2026, 1, 1, 7, 0, 0), 5)
+    # k=0: 0*30M = 0 < 60M OK -> 08:00
+    # k=1: 1*30M = 30M < 60M OK -> 08:30
+    # k=2: 2*30M = 60M NOT < 60M - skip
+    # So only 08:00 and 08:30 on Jan 1, then Jan 2
+    expected = [
+        datetime(2026, 1, 1, 8, 0, 0),
+        datetime(2026, 1, 1, 8, 30, 0),
+        datetime(2026, 1, 2, 8, 0, 0),
+        datetime(2026, 1, 2, 8, 30, 0),
+        datetime(2026, 1, 3, 8, 0, 0),
+    ]
+    assert runs == expected, f"Expected {expected}, got {runs}"
+    print("OK Issue 5: Repetition count correct (k*Interval < Duration)")
+
+
+def test_issue_6_repetition_end_boundary():
+    """Issue 6: Repetition respects EndBoundary."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+          <EndBoundary>2026-01-01T09:00:00</EndBoundary>
+          <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+          <Repetition>
+            <Interval>PT30M</Interval>
+            <Duration>PT5H</Duration>
+          </Repetition>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy></Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    runs = task.next_runs(datetime(2025, 12, 31, 0, 0, 0), 10)
+    # Should stop at EndBoundary
+    expected = [
+        datetime(2026, 1, 1, 8, 0, 0),
+        datetime(2026, 1, 1, 8, 30, 0),
+        datetime(2026, 1, 1, 9, 0, 0),
+    ]
+    assert runs == expected, f"Expected {expected}, got {runs}"
+    print("OK Issue 6: Repetition respects EndBoundary")
+
+
+def test_issue_7_disabled_trigger():
+    """Issue 7: Disabled triggers should be skipped."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+          <Enabled>false</Enabled>
+          <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy></Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    runs = task.next_runs(datetime(2025, 12, 31, 0, 0, 0), 5)
+    assert runs == [], f"Expected empty list, got {runs}"
+    print("OK Issue 7: Disabled triggers skipped")
+
+
+def test_issue_8_duration_canonical():
+    """Issue 8: Duration should be in canonical form."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+          <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings>
+        <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
+        <ExecutionTimeLimit>PT72H</ExecutionTimeLimit>
+      </Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    xml_out = task_to_xml(task)
+    # PT72H should become P3D
+    assert "P3D" in xml_out, f"Expected P3D in output, got:\n{xml_out}"
+    assert "PT72H" not in xml_out, f"Should not have PT72H, got:\n{xml_out}"
+    print("OK Issue 8: Duration canonical form (PT72H -> P3D)")
+
+
+def test_issue_9_error_types():
+    """Issue 9: Proper error classification."""
+    # Bad version
+    try:
+        parse_task_xml('<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"><Triggers><CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary><ScheduleByDay/></CalendarTrigger></Triggers></Task>')
+        assert False, "Should raise TaskDefError"
+    except TaskDefError as e:
+        assert e.kind == "version", f"Expected kind=version, got {e.kind}"
+    
+    # Out of range DaysInterval
+    try:
+        parse_task_xml('<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"><Triggers><CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary><ScheduleByDay><DaysInterval>400</DaysInterval></ScheduleByDay></CalendarTrigger></Triggers></Task>')
+        assert False, "Should raise TaskDefError"
+    except TaskDefError as e:
+        assert e.kind == "range", f"Expected kind=range, got {e.kind}"
+    
+    # Unknown trigger
+    try:
+        parse_task_xml('<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"><Triggers><BootTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary></BootTrigger></Triggers></Task>')
+        assert False, "Should raise TaskDefError"
+    except TaskDefError as e:
+        assert e.kind == "trigger", f"Expected kind=trigger, got {e.kind}"
+    
+    print("OK Issue 9: Error types correct")
+
+
+def test_issue_10_pt0s_unlimited():
+    """Issue 10: PT0S means unlimited ExecutionTimeLimit."""
+    xml = """<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+      <Triggers>
+        <CalendarTrigger>
+          <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+          <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+        </CalendarTrigger>
+      </Triggers>
+      <Settings>
+        <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
+        <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
+      </Settings>
+    </Task>"""
+    task = parse_task_xml(xml)
+    assert task.execution_time_limit is None, f"Expected None, got {task.execution_time_limit}"
+    print("OK Issue 10: PT0S means unlimited")
+
+
+if __name__ == "__main__":
+    test_issue_1_daily_phase()
+    test_issue_2_weeks_interval()
+    test_issue_3_months_filter()
+    test_issue_4_week_5_semantics()
+    test_issue_5_repetition_count()
+    test_issue_6_repetition_end_boundary()
+    test_issue_7_disabled_trigger()
+    test_issue_8_duration_canonical()
+    test_issue_9_error_types()
+    test_issue_10_pt0s_unlimited()
+    print("\nAll 10 issues fixed!")
