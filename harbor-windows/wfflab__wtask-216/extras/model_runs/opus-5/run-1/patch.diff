new file mode 100644
index 0000000..59cb167
--- /dev/null
+++ b/verify_all.py
@@ -0,0 +1,250 @@
+"""综合验证脚本，测试所有修复的问题"""
+from datetime import datetime, timedelta
+import wtask
+from wtask.errors import TaskDefError
+
+print("=" * 60)
+print("wtask 综合验证")
+print("=" * 60)
+
+# 1. 每日任务相位锚定
+print("\n1. 每日任务相位（DaysInterval=3，起点 2026-01-01）")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <ScheduleByDay><DaysInterval>3</DaysInterval></ScheduleByDay>
+    </CalendarTrigger>
+  </Triggers>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+runs = task.next_runs(datetime(2025, 12, 31), 5)
+print(f"   结果: {[r.strftime('%m/%d') for r in runs]}")
+assert [r.day for r in runs] == [1, 4, 7, 10, 13], "每日任务相位错误"
+print("   ✓ PASS")
+
+# 2. 每周任务 WeeksInterval
+print("\n2. 每周任务 WeeksInterval=2")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-05T08:00:00</StartBoundary>
+      <ScheduleByWeek>
+        <DaysOfWeek><Monday/></DaysOfWeek>
+        <WeeksInterval>2</WeeksInterval>
+      </ScheduleByWeek>
+    </CalendarTrigger>
+  </Triggers>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+runs = task.next_runs(datetime(2026, 1, 4), 4)
+expected_dates = [(1, 5), (1, 19), (2, 2), (2, 16)]
+actual_dates = [(r.month, r.day) for r in runs]
+print(f"   结果: {actual_dates}")
+assert actual_dates == expected_dates, "WeeksInterval 未生效"
+print("   ✓ PASS")
+
+# 3. 月度任务的 Months 过滤
+print("\n3. 月度任务 Months 过滤（仅1月和7月）")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <ScheduleByMonth>
+        <DaysOfMonth><Day>15</Day></DaysOfMonth>
+        <Months><January/><July/></Months>
+      </ScheduleByMonth>
+    </CalendarTrigger>
+  </Triggers>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+runs = task.next_runs(datetime(2025, 12, 31), 5)
+print(f"   结果: {[(r.month, r.day) for r in runs]}")
+assert all(r.month in [1, 7] for r in runs), "Months 过滤失效"
+assert all(r.day == 15 for r in runs), "日期不正确"
+print("   ✓ PASS")
+
+# 4. Week=5 语义（最后一周）
+print("\n4. Week=5 在只有4周的月份（2026年2月）")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <ScheduleByMonthDayOfWeek>
+        <Weeks><Week>5</Week></Weeks>
+        <DaysOfWeek><Monday/></DaysOfWeek>
+        <Months><February/></Months>
+      </ScheduleByMonthDayOfWeek>
+    </CalendarTrigger>
+  </Triggers>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+runs = task.next_runs(datetime(2025, 12, 31), 3)
+print(f"   结果: {[r.strftime('%Y-%m-%d') for r in runs]}")
+assert len(runs) >= 1, "Week=5 在2月未触发"
+assert runs[0].month == 2 and runs[0].year == 2026, "未触发2月"
+print("   ✓ PASS")
+
+# 5. 重复次数（k×Interval < Duration）
+print("\n5. 重复次数（Interval=PT30M, Duration=PT1H）")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+      <Repetition>
+        <Interval>PT30M</Interval>
+        <Duration>PT1H</Duration>
+      </Repetition>
+    </CalendarTrigger>
+  </Triggers>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+runs = task.next_runs(datetime(2025, 12, 31), 5)
+# 第一天应该只有 08:00 和 08:30
+day1 = [r for r in runs if r.date() == datetime(2026, 1, 1).date()]
+print(f"   第一天: {[r.strftime('%H:%M') for r in day1]}")
+assert len(day1) == 2, f"第一天应该触发2次，实际{len(day1)}次"
+assert day1[0].hour == 8 and day1[0].minute == 0, "第一次应该是08:00"
+assert day1[1].hour == 8 and day1[1].minute == 30, "第二次应该是08:30"
+print("   ✓ PASS")
+
+# 6. 重复受 EndBoundary 约束
+print("\n6. 重复受 EndBoundary 约束")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <EndBoundary>2026-01-01T08:45:00</EndBoundary>
+      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+      <Repetition>
+        <Interval>PT30M</Interval>
+        <Duration>PT2H</Duration>
+      </Repetition>
+    </CalendarTrigger>
+  </Triggers>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+runs = task.next_runs(datetime(2025, 12, 31), 10)
+print(f"   结果: {[r.strftime('%Y-%m-%d %H:%M') for r in runs]}")
+assert len(runs) == 2, f"应该只触发2次，实际{len(runs)}次"
+assert all(r <= datetime(2026, 1, 1, 8, 45) for r in runs), "超过 EndBoundary"
+print("   ✓ PASS")
+
+# 7. 禁用的触发器
+print("\n7. 禁用的触发器")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <Enabled>false</Enabled>
+      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+    </CalendarTrigger>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T09:00:00</StartBoundary>
+      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+    </CalendarTrigger>
+  </Triggers>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+runs = task.next_runs(datetime(2025, 12, 31), 3)
+print(f"   结果: {[r.strftime('%H:%M') for r in runs]}")
+assert all(r.hour == 9 for r in runs), "禁用的触发器仍在触发"
+print("   ✓ PASS")
+
+# 8. 时长规范化
+print("\n8. 时长规范化")
+tests = [
+    (timedelta(hours=72), "P3D"),
+    (timedelta(minutes=90), "PT1H30M"),
+    (timedelta(days=1, hours=2, minutes=3, seconds=4), "P1DT2H3M4S"),
+    (timedelta(0), "PT0S"),
+    (timedelta(hours=2), "PT2H"),
+]
+for td, expected in tests:
+    result = wtask.format_duration(td)
+    print(f"   {td} -> {result} (expected {expected})")
+    assert result == expected, f"时长格式错误: {result} != {expected}"
+print("   ✓ PASS")
+
+# 9. 错误分类
+print("\n9. 错误分类")
+tests = [
+    ('<Task version="2.0" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"><Triggers><CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary><ScheduleByDay/></CalendarTrigger></Triggers></Task>', 'version'),
+    ('<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"><Triggers><CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary><ScheduleByDay><DaysInterval>400</DaysInterval></ScheduleByDay></CalendarTrigger></Triggers></Task>', 'range'),
+    ('<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"><Triggers><BootTrigger/></Triggers></Task>', 'trigger'),
+    ('<Task><Triggers>', 'xml'),
+]
+for xml_text, expected_kind in tests:
+    try:
+        wtask.parse_task_xml(xml_text)
+        assert False, f"应该抛出 {expected_kind} 错误"
+    except TaskDefError as e:
+        print(f"   {expected_kind}: {e.kind}")
+        assert e.kind == expected_kind, f"错误类型不对: {e.kind} != {expected_kind}"
+print("   ✓ PASS")
+
+# 10. PT0S 表示不限
+print("\n10. PT0S 表示不限")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+    </CalendarTrigger>
+  </Triggers>
+  <Settings>
+    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
+  </Settings>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+print(f"   execution_time_limit: {task.execution_time_limit}")
+assert task.execution_time_limit is None, "PT0S 应该解析为 None"
+xml_out = wtask.task_to_xml(task)
+assert 'ExecutionTimeLimit' not in xml_out, "PT0S 应该在输出中省略"
+print("   ✓ PASS")
+
+# 11. 任务禁用时返回空列表
+print("\n11. 任务禁用时返回空列表")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+    </CalendarTrigger>
+  </Triggers>
+  <Settings>
+    <Enabled>false</Enabled>
+  </Settings>
+</Task>'''
+task = wtask.parse_task_xml(xml)
+runs = task.next_runs(datetime(2025, 12, 31), 3)
+print(f"   结果: {runs}")
+assert runs == [], "任务禁用时应返回空列表"
+print("   ✓ PASS")
+
+# 12. 幂等性
+print("\n12. 规范化序列化幂等性")
+xml = '''<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
+  <Triggers>
+    <CalendarTrigger>
+      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
+      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
+    </CalendarTrigger>
+  </Triggers>
+  <Settings>
+    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
+  </Settings>
+</Task>'''
+task1 = wtask.parse_task_xml(xml)
+xml_out = wtask.task_to_xml(task1)
+task2 = wtask.parse_task_xml(xml_out)
+xml_out2 = wtask.task_to_xml(task2)
+print(f"   第一次序列化 == 第二次序列化: {xml_out == xml_out2}")
+assert task1 == task2, "解析后的任务应该相等"
+assert xml_out == xml_out2, "序列化应该幂等"
+print("   ✓ PASS")
+
+print("\n" + "=" * 60)
+print("所有测试通过！✓")
+print("=" * 60)
