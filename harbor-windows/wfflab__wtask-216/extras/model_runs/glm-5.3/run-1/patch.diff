+    TaskDefError, Task, Trigger, Repetition,
+    parse_task_xml, task_to_xml, next_runs, plan_window,
+    parse_duration, format_duration, validate_task,
+)
+
+NS = 'xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"'
+FAILS = []
+
+
+def check(label, got, want):
+    if got != want:
+        FAILS.append("%s:\n   got  %r\n   want %r" % (label, got, want))
+        print("FAIL", label)
+        print("   got ", got)
+        print("   want", want)
+    else:
+        print("ok  ", label)
+
+
+def check_kind(label, fn, kind):
+    try:
+        fn()
+    except TaskDefError as exc:
+        if exc.kind != kind:
+            FAILS.append("%s: kind %r != %r (%s)" % (label, exc.kind, kind, exc))
+            print("FAIL", label, "kind", exc.kind, "!=", kind, exc)
+        else:
+            print("ok  ", label, "->", exc.kind)
+    except Exception as exc:  # noqa
+        FAILS.append("%s: wrong exception %r" % (label, exc))
+        print("FAIL", label, "wrong exception", repr(exc))
+    else:
+        FAILS.append("%s: no exception" % (label,))
+        print("FAIL", label, "no exception")
+
+
+def task(inner_triggers, settings=""):
+    return (
+        '<Task version="1.2" %s>\n  <Triggers>%s</Triggers>\n%s</Task>'
+        % (NS, inner_triggers, settings)
+    )
+
+
