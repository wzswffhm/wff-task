+# -*- coding: utf-8 -*-
+"""Second round: corrected expectations + extra edge cases (temporary)."""
+import sys
+import time
+from datetime import datetime, timedelta
+
+from wtask import (
+    TaskDefError, Task, Trigger, Repetition,
+    parse_task_xml, task_to_xml, next_runs, plan_window,
+    parse_duration, format_duration, validate_task,
+)
+
+NS = 'xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"'
+FAILS = []
+
+
+def check(label, got, want):
+    if got != want:
+        FAILS.append("%s:\n   got  %r\n   want %r" % (label, got, want))
+        print("FAIL", label)
+        print("   got ", got)
+        print("   want", want)
+    else:
+        print("ok  ", label)
+
+
+def task(inner_triggers, settings=""):
+    return (
+        '<Task version="1.2" %s>\n  <Triggers>%s</Triggers>\n%s</Task>'
+        % (NS, inner_triggers, settings)
+    )
+
+
+# --- corrected mdow expectations (verified by hand against a calendar) ------
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByMonthDayOfWeek><Weeks><Week>5</Week></Weeks>"
+    "<DaysOfWeek><Friday/></DaysOfWeek><Months><February/></Months>"
+    "</ScheduleByMonthDayOfWeek></CalendarTrigger>"))
+# 2027-02: 28 days -> week5 == week4 (22..28), Friday = 26th
+# 2028-02: 29 days -> week5 == day 29 only (Tuesday) -> no Friday
+# 2029-02: 28 days -> Friday in 22..28 = 23rd
+check("mdow week5 = last week (feb)", next_runs(t, datetime(2026, 6, 1, 0, 0, 0), 3),
+      [datetime(2027, 2, 26, 8), datetime(2029, 2, 23, 8), datetime(2030, 2, 22, 8)])
+check("mdow week5 plan_window",
+      plan_window(t, datetime(2026, 1, 1), datetime(2030, 12, 31)),
+      [datetime(2027, 2, 26, 8), datetime(2029, 2, 23, 8), datetime(2030, 2, 22, 8)])
+
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByMonthDayOfWeek><Weeks><Week>1</Week><Week>3</Week></Weeks>"
+    "<DaysOfWeek><Friday/></DaysOfWeek><Months><January/></Months>"
+    "</ScheduleByMonthDayOfWeek></CalendarTrigger>"))
+# Jan 2026 Fridays: 2, 9, 16, 23, 30 -> week1: 2, week3: 16
+check("mdow weeks 1,3 january", next_runs(t, datetime(2026, 1, 1, 9, 0, 0), 4),
+      [datetime(2026, 1, 2, 8), datetime(2026, 1, 16, 8), datetime(2027, 1, 1, 8),
+       datetime(2027, 1, 15, 8)])
+
+# week5 in a 31-day month = days 29..31
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByMonthDayOfWeek><Weeks><Week>5</Week></Weeks>"
+    "<DaysOfWeek><Tuesday/></DaysOfWeek><Months><March/></Months>"
+    "</ScheduleByMonthDayOfWeek></CalendarTrigger>"))
+check("mdow week5 in 31-day month", next_runs(t, datetime(2026, 1, 1, 0, 0, 0), 2),
+      [datetime(2026, 3, 31, 8), datetime(2027, 3, 31, 8)])
+
+# ------------------------------------------------------- repetition details
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>"
+    "<Repetition><Interval>PT30M</Interval><Duration>PT1H</Duration></Repetition>"
+    "</CalendarTrigger>"))
+check("repetition 30m/1h", next_runs(t, datetime(2026, 1, 1, 7, 0, 0), 5),
+      [datetime(2026, 1, 1, 8), datetime(2026, 1, 1, 8, 30), datetime(2026, 1, 2, 8),
+       datetime(2026, 1, 2, 8, 30), datetime(2026, 1, 3, 8)])
+
+# duration that spans the next occurrence (interleaved expansions)
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>"
+    "<Repetition><Interval>PT12H</Interval><Duration>PT30H</Duration></Repetition>"
+    "</CalendarTrigger>"))
+check("interleaved repetition", next_runs(t, datetime(2026, 1, 1, 0, 0, 0), 6),
+      [datetime(2026, 1, 1, 8), datetime(2026, 1, 1, 20), datetime(2026, 1, 2, 8),
+       datetime(2026, 1, 2, 20), datetime(2026, 1, 3, 8), datetime(2026, 1, 3, 20)])
+check("interleaved repetition mid", next_runs(t, datetime(2026, 1, 2, 10, 0, 0), 4),
+      [datetime(2026, 1, 2, 20), datetime(2026, 1, 3, 8), datetime(2026, 1, 3, 20),
+       datetime(2026, 1, 4, 8)])
+
+# finite duration reaching into a later window
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>"
+    "<Repetition><Interval>PT1H</Interval><Duration>PT25H</Duration></Repetition>"
+    "</CalendarTrigger>"))
+got = plan_window(t, datetime(2026, 1, 2, 0, 0, 0), datetime(2026, 1, 3, 0, 0, 0))
+check("stale occurrence feeds window", (len(got), got[0], got[-1]),
+      (24, datetime(2026, 1, 2, 1, 0, 0), datetime(2026, 1, 3, 0, 0, 0)))
+
+# stop-at-duration-end is preserved verbatim and does not change results
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>"
+    "<Repetition><Interval>PT1H</Interval><Duration>PT3H</Duration>"
+    "<StopAtDurationEnd>true</StopAtDurationEnd></Repetition></CalendarTrigger>"))
+check("stop flag ignored for runs", next_runs(t, datetime(2026, 1, 1, 0, 0, 0), 4),
+      [datetime(2026, 1, 1, 8), datetime(2026, 1, 1, 9), datetime(2026, 1, 1, 10),
+       datetime(2026, 1, 2, 8)])
+check("stop flag roundtrip", parse_task_xml(task_to_xml(t)), t)
+
+# plan_window is (start, end]
+t = parse_task_xml(task('<TimeTrigger><StartBoundary>2026-03-05T12:34:56'
+                        "</StartBoundary></TimeTrigger>"))
+check("window start exclusive", plan_window(t, datetime(2026, 3, 5, 12, 34, 56),
+                                            datetime(2026, 3, 6)), [])
+check("window end inclusive", plan_window(t, datetime(2026, 3, 5, 12, 34, 55),
+                                          datetime(2026, 3, 5, 12, 34, 56)),
+      [datetime(2026, 3, 5, 12, 34, 56)])
+
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByDay><DaysInterval>3</DaysInterval></ScheduleByDay></CalendarTrigger>"))
+check("plan_window daily", t.plan_window(datetime(2026, 1, 1), datetime(2026, 1, 31)),
+      [datetime(2026, 1, 1, 8), datetime(2026, 1, 4, 8), datetime(2026, 1, 7, 8),
+       datetime(2026, 1, 10, 8), datetime(2026, 1, 13, 8), datetime(2026, 1, 16, 8),
+       datetime(2026, 1, 19, 8), datetime(2026, 1, 22, 8), datetime(2026, 1, 25, 8),
+       datetime(2026, 1, 28, 8)])
+
+# ------------------------------------------------- long horizons / edge cases
+# February-only monthly task: 15 occurrences need 15 years
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-02-01T08:00:00</StartBoundary>'
+    "<ScheduleByMonth><DaysOfMonth><Day>2</Day></DaysOfMonth>"
+    "<Months><February/></Months></ScheduleByMonth></CalendarTrigger>"))
+start = time.time()
+got = next_runs(t, datetime(2026, 2, 1, 0, 0, 0), 15)
+check("long horizon monthly", [got[0], got[-1], len(got)],
+      [datetime(2026, 2, 2, 8), datetime(2040, 2, 2, 8), 15])
+print("   (took %.3fs)" % (time.time() - start))
+
+# impossible schedule must not hang
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-02-01T08:00:00</StartBoundary>'
+    "<ScheduleByMonth><DaysOfMonth><Day>31</Day></DaysOfMonth>"
+    "<Months><February/></Months></ScheduleByMonth></CalendarTrigger>"))
+start = time.time()
+check("impossible schedule", next_runs(t, datetime(2026, 1, 1, 0, 0, 0), 3), [])
+print("   (took %.3fs)" % (time.time() - start))
+
+# far-future start boundary
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2099-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByDay/></CalendarTrigger>"))
+start = time.time()
+check("far future start", next_runs(t, datetime(2026, 1, 1, 0, 0, 0), 2),
+      [datetime(2099, 1, 1, 8), datetime(2099, 1, 2, 8)])
+print("   (took %.3fs)" % (time.time() - start))
+
+# bounded task: all runs returned even if fewer than count
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<EndBoundary>2026-01-10T08:00:00</EndBoundary>"
+    "<ScheduleByDay><DaysInterval>2</DaysInterval></ScheduleByDay></CalendarTrigger>"))
+check("bounded fewer than count", next_runs(t, datetime(2026, 1, 1, 0, 0, 0), 50),
+      [datetime(2026, 1, 1, 8), datetime(2026, 1, 3, 8), datetime(2026, 1, 5, 8),
+       datetime(2026, 1, 7, 8), datetime(2026, 1, 9, 8)])
+check("bounded past end", next_runs(t, datetime(2027, 1, 1, 0, 0, 0), 5), [])
+
+# unbounded repetition with a stale start (performance sanity)
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2020-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByDay/><Repetition><Interval>PT30M</Interval></Repetition>"
+    "</CalendarTrigger>"))
+start = time.time()
+got = next_runs(t, datetime(2026, 5, 20, 12, 13, 0), 5)
+check("stale start + unlimited repetition", got,
+      [datetime(2026, 5, 20, 12, 30), datetime(2026, 5, 20, 13), datetime(2026, 5, 20, 13, 30),
+       datetime(2026, 5, 20, 14), datetime(2026, 5, 20, 14, 30)])
+print("   (took %.3fs)" % (time.time() - start))
+
+start = time.time()
+got = plan_window(t, datetime(2026, 5, 20, 0, 0, 0), datetime(2026, 5, 21, 0, 0, 0))
+check("stale start window size", len(got), 48)
+print("   (took %.3fs)" % (time.time() - start))
+
+# next_runs with a big count still works
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByDay><DaysInterval>7</DaysInterval></ScheduleByDay></CalendarTrigger>"))
+got = next_runs(t, datetime(2026, 1, 1, 0, 0, 0), 500)
+check("big count", (len(got), got[0], got[-1]),
+      (500, datetime(2026, 1, 1, 8), datetime(2035, 9, 12, 8)))
+
+# TimeTrigger with repetition
+t = parse_task_xml(task(
+    '<TimeTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<Repetition><Interval>PT15M</Interval><Duration>PT45M</Duration></Repetition>"
+    "</TimeTrigger>"))
+check("time trigger repetition", next_runs(t, datetime(2026, 1, 1, 0, 0, 0), 5),
+      [datetime(2026, 1, 1, 8), datetime(2026, 1, 1, 8, 15), datetime(2026, 1, 1, 8, 30)])
+
+# RandomDelay / ExecutionTimeLimit defaults
+t = parse_task_xml(task('<TimeTrigger><StartBoundary>2026-01-01T08:00:00'
+                        "</StartBoundary></TimeTrigger>"))
+check("defaults", (t.execution_time_limit, t.random_delay, t.multiple_instances, t.enabled),
+      (None, timedelta(0), "IgnoreNew", True))
+
+# weekly trigger crossing a year boundary / week anchoring
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2025-12-31T08:00:00</StartBoundary>'  # Wednesday
+    "<ScheduleByWeek><DaysOfWeek><Sunday/></DaysOfWeek>"
+    "<WeeksInterval>2</WeeksInterval></ScheduleByWeek></CalendarTrigger>"))
+# start week = Mon 2025-12-29; week0 Sundays: 2025-12-29... wait Sunday of that week is
+# 2025-12-28 (before the Monday) -> the week Mon 12-29..Sun 01-04 contains Sunday 2026-01-04.
+check("weekly anchored at start week", next_runs(t, datetime(2025, 12, 1, 0, 0, 0), 3),
+      [datetime(2026, 1, 4, 8), datetime(2026, 1, 18, 8), datetime(2026, 2, 1, 8)])
+
+# monthly with several months and days, dedup + ordering
+t = parse_task_xml(task(
+    '<CalendarTrigger><StartBoundary>2026-01-01T08:00:00</StartBoundary>'
+    "<ScheduleByMonth><DaysOfMonth><Day>1</Day><Day>2</Day><Day>3</Day></DaysOfMonth>"
+    "<Months><January/><February/><March/></Months></ScheduleByMonth></CalendarTrigger>"))
+check("monthly multi", plan_window(t, datetime(2026, 1, 1), datetime(2026, 4, 1)),
+      [datetime(2026, m, d, 8) for m in (1, 2, 3) for d in (1, 2, 3)])
+
+print()
+if FAILS:
+    print("=== %d FAILURES ===" % len(FAILS))
+    for f in FAILS:
+        print(f)
+    sys.exit(1)
+print("ALL CHECKS PASSED")
