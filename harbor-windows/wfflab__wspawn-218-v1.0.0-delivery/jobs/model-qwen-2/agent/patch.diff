diff --git a/wspawn/_winapi.py b/wspawn/_winapi.py
index 273b792..6a5f242 100644
--- a/wspawn/_winapi.py
+++ b/wspawn/_winapi.py
@@ -5,6 +5,7 @@ loaded lazily so that importing the package stays cheap.
 """
 
 import os
+import sys
 
 FILE_TYPE_UNKNOWN = 0x0000
 FILE_TYPE_DISK = 0x0001
@@ -12,6 +13,20 @@ FILE_TYPE_CHAR = 0x0002
 FILE_TYPE_PIPE = 0x0003
 FILE_TYPE_REMOTE = 0x8000
 
+HANDLE_FLAG_INHERIT = 0x00000001
+HANDLE_FLAG_PROTECT_FROM_CLOSE = 0x00000002
+
+# Process creation flags
+EXTENDED_STARTUPINFO_PRESENT = 0x00080000
+
+# ProcThreadAttribute constants
+PROC_THREAD_ATTRIBUTE_HANDLE_LIST = 0x00020002
+
+# Standard handle IDs
+STD_INPUT_HANDLE = -10
+STD_OUTPUT_HANDLE = -11
+STD_ERROR_HANDLE = -12
+
 _IS_WINDOWS = os.name == "nt"
 
 
@@ -22,7 +37,6 @@ def is_windows():
 
 def _kernel32():
     import ctypes
-
     return ctypes.WinDLL("kernel32", use_last_error=True)
 
 
@@ -36,4 +50,407 @@ def file_type(handle):
     func = _kernel32().GetFileType
     func.argtypes = [wintypes.HANDLE]
     func.restype = wintypes.DWORD
-    return int(func(wintypes.HANDLE(int(handle))))
+    result = func(wintypes.HANDLE(int(handle)))
+    last_error = ctypes.get_last_error()
+    # GetFileType returns FILE_TYPE_UNKNOWN (0) on failure, but also for some valid handles
+    # We need to check GetLastError to distinguish
+    if result == FILE_TYPE_UNKNOWN and last_error != 0:
+        raise OSError(last_error, "GetFileType failed")
+    return int(result)
+
+
+def get_handle_information(handle):
+    """Return flags for a handle using GetHandleInformation.
+    
+    The inheritable state is (flags & HANDLE_FLAG_INHERIT) != 0.
+    Raises OSError on failure.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("GetHandleInformation is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = _kernel32()
+    func = kernel32.GetHandleInformation
+    func.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+    func.restype = wintypes.BOOL
+    
+    flags = wintypes.DWORD()
+    success = func(wintypes.HANDLE(int(handle)), ctypes.byref(flags))
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "GetHandleInformation failed")
+    return int(flags.value)
+
+
+def set_handle_information(handle, inherit=None, protect_from_close=None):
+    """Set handle information using SetHandleInformation.
+    
+    Parameters:
+        handle: The handle to modify
+        inherit: If True/False, set/clear HANDLE_FLAG_INHERIT. If None, don't change.
+        protect_from_close: If True/False, set/clear HANDLE_FLAG_PROTECT_FROM_CLOSE. If None, don't change.
+    
+    Raises OSError on failure.
+    """
+    if not _IS_WINDOWS:
+        raise OSError("SetHandleInformation is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+
+    mask = 0
+    flags = 0
+    
+    if inherit is not None:
+        mask |= HANDLE_FLAG_INHERIT
+        if inherit:
+            flags |= HANDLE_FLAG_INHERIT
+    
+    if protect_from_close is not None:
+        mask |= HANDLE_FLAG_PROTECT_FROM_CLOSE
+        if protect_from_close:
+            flags |= HANDLE_FLAG_PROTECT_FROM_CLOSE
+    
+    kernel32 = _kernel32()
+    func = kernel32.SetHandleInformation
+    func.argtypes = [wintypes.HANDLE, wintypes.DWORD, wintypes.DWORD]
+    func.restype = wintypes.BOOL
+    
+    success = func(wintypes.HANDLE(int(handle)), wintypes.DWORD(mask), wintypes.DWORD(flags))
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "SetHandleInformation failed")
+
+
+def close_handle(handle):
+    """Close a handle using CloseHandle."""
+    if not _IS_WINDOWS:
+        raise OSError("CloseHandle is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = _kernel32()
+    func = kernel32.CloseHandle
+    func.argtypes = [wintypes.HANDLE]
+    func.restype = wintypes.BOOL
+    
+    success = func(wintypes.HANDLE(int(handle)))
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "CloseHandle failed")
+
+
+def get_std_handle(std_id):
+    """Get a standard handle (STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE)."""
+    if not _IS_WINDOWS:
+        raise OSError("GetStdHandle is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = _kernel32()
+    func = kernel32.GetStdHandle
+    func.argtypes = [wintypes.DWORD]
+    func.restype = wintypes.HANDLE
+    
+    result = func(wintypes.DWORD(std_id))
+    # On 64-bit Python, wintypes.HANDLE is c_void_p which returns an int
+    if hasattr(result, 'value'):
+        return int(result.value)
+    else:
+        return int(result)
+
+
+def create_process_with_handle_list(command_line, handle_list, stdin=None, stdout=None, stderr=None):
+    """Create a process with an explicit handle list using STARTUPINFOEX.
+    
+    This ensures that ONLY the handles in handle_list (plus std handles) are
+    inherited by the child process, and they keep the same numeric values.
+    
+    Parameters:
+        command_line: The command line string
+        handle_list: List of integer handles to pass to the child
+        stdin, stdout, stderr: Optional standard stream handles (integers or None)
+    
+    Returns:
+        (process_handle, thread_handle, pid)
+    """
+    if not _IS_WINDOWS:
+        raise OSError("create_process_with_handle_list is only available on Windows")
+    
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    
+    # Build the complete list of handles to inherit
+    all_handles = list(handle_list)
+    if stdin is not None:
+        all_handles.append(int(stdin))
+    if stdout is not None:
+        all_handles.append(int(stdout))
+    if stderr is not None:
+        all_handles.append(int(stderr))
+    
+    # Remove duplicates while preserving order
+    seen = set()
+    unique_handles = []
+    for h in all_handles:
+        if h not in seen:
+            seen.add(h)
+            unique_handles.append(h)
+    
+    # All handles must be marked as inheritable before CreateProcess
+    # We'll track which ones we changed so we can restore them
+    original_states = {}
+    for h in unique_handles:
+        try:
+            flags = get_handle_information(h)
+            was_inheritable = (flags & HANDLE_FLAG_INHERIT) != 0
+            original_states[h] = was_inheritable
+            if not was_inheritable:
+                set_handle_information(h, inherit=True)
+        except OSError:
+            # Handle might be invalid or not support this operation
+            pass
+    
+    attr_list_buffer = None
+    try:
+        # Define structures
+        class STARTUPINFOW(ctypes.Structure):
+            _fields_ = [
+                ("cb", wintypes.DWORD),
+                ("lpReserved", wintypes.LPWSTR),
+                ("lpDesktop", wintypes.LPWSTR),
+                ("lpTitle", wintypes.LPWSTR),
+                ("dwX", wintypes.DWORD),
+                ("dwY", wintypes.DWORD),
+                ("dwXSize", wintypes.DWORD),
+                ("dwYSize", wintypes.DWORD),
+                ("dwXCountChars", wintypes.DWORD),
+                ("dwYCountChars", wintypes.DWORD),
+                ("dwFillAttribute", wintypes.DWORD),
+                ("dwFlags", wintypes.DWORD),
+                ("wShowWindow", wintypes.WORD),
+                ("cbReserved2", wintypes.WORD),
+                ("lpReserved2", ctypes.POINTER(ctypes.c_byte)),
+                ("hStdInput", wintypes.HANDLE),
+                ("hStdOutput", wintypes.HANDLE),
+                ("hStdError", wintypes.HANDLE),
+            ]
+        
+        class STARTUPINFOEXW(ctypes.Structure):
+            _fields_ = [
+                ("StartupInfo", STARTUPINFOW),
+                ("lpAttributeList", ctypes.c_void_p),
+            ]
+        
+        class PROCESS_INFORMATION(ctypes.Structure):
+            _fields_ = [
+                ("hProcess", wintypes.HANDLE),
+                ("hThread", wintypes.HANDLE),
+                ("dwProcessId", wintypes.DWORD),
+                ("dwThreadId", wintypes.DWORD),
+            ]
+        
+        # Always use PROC_THREAD_ATTRIBUTE_HANDLE_LIST if we have any handles
+        # This ensures precise control over what gets inherited
+        use_handle_list = len(unique_handles) > 0
+        
+        if use_handle_list:
+            # Initialize attribute list
+            attr_list_size = ctypes.c_size_t()
+            
+            init_attr_list = kernel32.InitializeProcThreadAttributeList
+            init_attr_list.argtypes = [ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(ctypes.c_size_t)]
+            init_attr_list.restype = wintypes.BOOL
+            
+            # Get size needed
+            init_attr_list(None, 1, 0, ctypes.byref(attr_list_size))
+            
+            # Allocate memory for attribute list
+            attr_list_buffer = ctypes.create_string_buffer(attr_list_size.value)
+            
+            # Initialize the attribute list
+            success = init_attr_list(attr_list_buffer, 1, 0, ctypes.byref(attr_list_size))
+            if not success:
+                err = ctypes.get_last_error()
+                raise OSError(err, "InitializeProcThreadAttributeList failed")
+            
+            # Update the attribute list with handle list
+            update_attr_list = kernel32.UpdateProcThreadAttribute
+            update_attr_list.argtypes = [
+                ctypes.c_void_p,
+                wintypes.DWORD,
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_size_t,
+                ctypes.c_void_p,
+                ctypes.POINTER(ctypes.c_size_t),
+            ]
+            update_attr_list.restype = wintypes.BOOL
+            
+            # Create array of handles
+            handle_array = (wintypes.HANDLE * len(unique_handles))(*[wintypes.HANDLE(h) for h in unique_handles])
+            
+            success = update_attr_list(
+                attr_list_buffer,
+                0,
+                ctypes.c_void_p(PROC_THREAD_ATTRIBUTE_HANDLE_LIST),
+                ctypes.cast(handle_array, ctypes.c_void_p),
+                ctypes.sizeof(handle_array),
+                None,
+                None,
+            )
+            if not success:
+                err = ctypes.get_last_error()
+                raise OSError(err, "UpdateProcThreadAttribute failed")
+        
+        # Prepare STARTUPINFOEXW
+        startup_info_ex = STARTUPINFOEXW()
+        startup_info_ex.StartupInfo.cb = ctypes.sizeof(STARTUPINFOEXW)
+        
+        if use_handle_list:
+            startup_info_ex.lpAttributeList = ctypes.cast(attr_list_buffer, ctypes.c_void_p)
+        else:
+            startup_info_ex.lpAttributeList = None
+        
+        # Set up standard handles
+        STARTF_USESTDHANDLES = 0x00000100
+        
+        # Determine effective std handles
+        eff_stdin = stdin if stdin is not None else get_std_handle(STD_INPUT_HANDLE)
+        eff_stdout = stdout if stdout is not None else get_std_handle(STD_OUTPUT_HANDLE)
+        eff_stderr = stderr if stderr is not None else get_std_handle(STD_ERROR_HANDLE)
+        
+        startup_info_ex.StartupInfo.dwFlags |= STARTF_USESTDHANDLES
+        startup_info_ex.StartupInfo.hStdInput = wintypes.HANDLE(eff_stdin)
+        startup_info_ex.StartupInfo.hStdOutput = wintypes.HANDLE(eff_stdout)
+        startup_info_ex.StartupInfo.hStdError = wintypes.HANDLE(eff_stderr)
+        
+        # Prepare PROCESS_INFORMATION
+        proc_info = PROCESS_INFORMATION()
+        
+        # CreateProcessW
+        create_process = kernel32.CreateProcessW
+        create_process.argtypes = [
+            wintypes.LPCWSTR,
+            wintypes.LPWSTR,
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+            wintypes.BOOL,
+            wintypes.DWORD,
+            ctypes.c_void_p,
+            wintypes.LPCWSTR,
+            ctypes.c_void_p,
+            ctypes.POINTER(PROCESS_INFORMATION),
+        ]
+        create_process.restype = wintypes.BOOL
+        
+        # Convert command line to wide string
+        cmd_line_wide = ctypes.create_unicode_buffer(command_line)
+        
+        # bInheritHandles must be TRUE when using PROC_THREAD_ATTRIBUTE_HANDLE_LIST
+        # When not using it, we still need TRUE for STARTF_USESTDHANDLES to work
+        b_inherit = True
+        
+        creation_flags = EXTENDED_STARTUPINFO_PRESENT if use_handle_list else 0
+        
+        success = create_process(
+            None,
+            cmd_line_wide,
+            None,
+            None,
+            b_inherit,
+            creation_flags,
+            None,
+            None,
+            ctypes.byref(startup_info_ex),
+            ctypes.byref(proc_info),
+        )
+        
+        if not success:
+            err = ctypes.get_last_error()
+            raise OSError(err, "CreateProcessW failed")
+        
+        # Extract values - handle both int and wintypes.HANDLE cases
+        def get_handle_value(h):
+            if hasattr(h, 'value'):
+                return int(h.value)
+            return int(h)
+        
+        proc_handle = get_handle_value(proc_info.hProcess)
+        thread_handle = get_handle_value(proc_info.hThread)
+        pid = int(proc_info.dwProcessId)
+        
+        return (proc_handle, thread_handle, pid)
+        
+    finally:
+        # Restore original inheritable states
+        for h, was_inheritable in original_states.items():
+            try:
+                set_handle_information(h, inherit=was_inheritable)
+            except OSError:
+                pass
+        
+        # Delete attribute list
+        if attr_list_buffer is not None:
+            try:
+                delete_attr_list = kernel32.DeleteProcThreadAttributeList
+                delete_attr_list.argtypes = [ctypes.c_void_p]
+                delete_attr_list.restype = None
+                delete_attr_list(attr_list_buffer)
+            except Exception:
+                pass
+
+
+def wait_for_single_object(handle, timeout_ms=0xFFFFFFFF):
+    """Wait for a single object. Returns WAIT_OBJECT_0 (0) on success."""
+    if not _IS_WINDOWS:
+        raise OSError("WaitForSingleObject is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    func = kernel32.WaitForSingleObject
+    func.argtypes = [wintypes.HANDLE, wintypes.DWORD]
+    func.restype = wintypes.DWORD
+    
+    return int(func(wintypes.HANDLE(int(handle)), wintypes.DWORD(timeout_ms)))
+
+
+def get_exit_code_process(process_handle):
+    """Get the exit code of a process."""
+    if not _IS_WINDOWS:
+        raise OSError("GetExitCodeProcess is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    func = kernel32.GetExitCodeProcess
+    func.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+    func.restype = wintypes.BOOL
+    
+    exit_code = wintypes.DWORD()
+    success = func(wintypes.HANDLE(int(process_handle)), ctypes.byref(exit_code))
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "GetExitCodeProcess failed")
+    return int(exit_code.value)
+
+
+def terminate_process(process_handle, exit_code=1):
+    """Terminate a process."""
+    if not _IS_WINDOWS:
+        raise OSError("TerminateProcess is only available on Windows")
+    import ctypes
+    from ctypes import wintypes
+    
+    kernel32 = _kernel32()
+    func = kernel32.TerminateProcess
+    func.argtypes = [wintypes.HANDLE, wintypes.UINT]
+    func.restype = wintypes.BOOL
+    
+    success = func(wintypes.HANDLE(int(process_handle)), wintypes.UINT(exit_code))
+    if not success:
+        err = ctypes.get_last_error()
+        raise OSError(err, "TerminateProcess failed")
