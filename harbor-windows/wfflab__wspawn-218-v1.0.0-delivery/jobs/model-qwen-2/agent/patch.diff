+def _quote_arg(arg):
+    """Quote a command line argument for Windows CreateProcess."""
+    # Simple quoting: if it contains spaces or special chars, wrap in quotes
+    if not arg:
+        return '""'
+    
+    # Check if quoting is needed
+    needs_quote = False
+    for c in arg:
+        if c in ' \t\n\v"':
+            needs_quote = True
+            break
+    
+    if not needs_quote:
+        return arg
+    
+    # Escape backslashes before quotes and wrap in quotes
+    result = ['"']
+    num_backslashes = 0
+    for c in arg:
+        if c == '\\':
+            num_backslashes += 1
+        elif c == '"':
+            # Double the backslashes before the quote, then add escaped quote
+            result.append('\\' * (num_backslashes * 2 + 1))
+            result.append('"')
+            num_backslashes = 0
+        else:
+            # Flush any pending backslashes
+            result.append('\\' * num_backslashes)
+            result.append(c)
+            num_backslashes = 0
+    
+    # Flush remaining backslashes (before closing quote, they need to be doubled)
+    result.append('\\' * (num_backslashes * 2))
+    result.append('"')
+    return ''.join(result)
+
+
+def _build_command_line(argv):
+    """Build a Windows command line string from argv list."""
+    return ' '.join(_quote_arg(arg) for arg in argv)
+
