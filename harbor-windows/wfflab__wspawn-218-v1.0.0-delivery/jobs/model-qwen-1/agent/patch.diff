diff --git a/wspawn/_debug_check.py b/wspawn/_debug_check.py
new file mode 100644
index 0000000..8ca4915
--- /dev/null
+++ b/wspawn/_debug_check.py
@@ -0,0 +1,231 @@
+"""Comprehensive verification of wspawn acceptance criteria."""
+import os
+import sys
+import subprocess
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from wspawn import (
+    WSpawnError, spawn, set_inheritable, is_inheritable,
+    inheritable_handles, handle_kind,
+)
+from wspawn._winapi import (
+    get_handle_information, HANDLE_FLAG_INHERIT,
+    file_type, FILE_TYPE_PIPE, FILE_TYPE_DISK, FILE_TYPE_CHAR,
+)
+
+PY = sys.executable
+errors = []
+
+def check(name, condition, detail=""):
+    if condition:
+        print("  PASS: %s" % name)
+    else:
+        msg = "  FAIL: %s" % name
+        if detail:
+            msg += " -- %s" % detail
+        print(msg)
+        errors.append(name)
+
+
+print("=== Criterion C: Inheritable state controllable and observable ===")
+import msvcrt
+r_fd, w_fd = os.pipe()
+r_handle = msvcrt.get_osfhandle(r_fd)
+w_handle = msvcrt.get_osfhandle(w_fd)
+
+# Initially should not be inheritable (pipes created by os.pipe are not inheritable by default on Windows)
+try:
+    inh_before = is_inheritable(r_handle)
+    print("  Initial inheritable state of pipe read: %s" % inh_before)
+except WSpawnError as e:
+    print("  Error checking initial state: %s" % e)
+    inh_before = False
+
+set_inheritable(r_handle, True)
+check("set_inheritable(True) succeeds", True)
+
+inh_after = is_inheritable(r_handle)
+check("is_inheritable returns True after set_inheritable(True)", inh_after)
+
+# Verify with external API
+ok, flags = get_handle_information(r_handle)
+ext_inh = bool(flags & HANDLE_FLAG_INHERIT) if ok else False
+check("External GetHandleInformation agrees", ext_inh == inh_after,
+      "external=%s internal=%s" % (ext_inh, inh_after))
+
+set_inheritable(r_handle, False)
+inh_off = is_inheritable(r_handle)
+check("is_inheritable returns False after set_inheritable(False)", not inh_off)
+
+ok2, flags2 = get_handle_information(r_handle)
+ext_inh2 = bool(flags2 & HANDLE_FLAG_INHERIT) if ok2 else True
+check("External agrees after turning off", not ext_inh2)
+
+os.close(r_fd)
+os.close(w_fd)
+
+print("\n=== Criterion E: Object type identification ===")
+# Create a temp file
+tf = tempfile.NamedTemporaryFile(delete=False)
+tf.write(b"test")
+tf.flush()
+tf_handle = msvcrt.get_osfhandle(tf.file.fileno() if hasattr(tf, 'file') else tf.fileno())
+kind_file = handle_kind(tf_handle)
+check("handle_kind identifies file", kind_file == "file", "got: %s" % kind_file)
+tf.close()
+os.unlink(tf.name)
+
+# Create a pipe
+pr, pw = os.pipe()
+pr_h = msvcrt.get_osfhandle(pr)
+kind_pipe = handle_kind(pr_h)
+check("handle_kind identifies pipe", kind_pipe == "pipe", "got: %s" % kind_pipe)
+os.close(pr)
+os.close(pw)
+
+# Invalid handle
+try:
+    handle_kind(999999999)
+    check("handle_kind rejects invalid handle", False, "should have raised")
+except WSpawnError as e:
+    check("handle_kind rejects invalid handle with typed error", e.kind in WSpawnError.KINDS,
+          "kind=%s" % e.kind)
+
+print("\n=== Criterion F: Error classification ===")
+# Unsupported operation
+try:
+    set_inheritable(999999999, True)
+    check("set_inheritable on bad handle raises", False, "should have raised")
+except WSpawnError as e:
+    check("set_inheritable on bad handle has correct kind", e.kind in ("unsupported", "os"),
+          "kind=%s" % e.kind)
+
+# Bad argument
+try:
+    set_inheritable("not-a-handle", True)
+    check("set_inheritable rejects non-int", False)
+except WSpawnError as e:
+    check("set_inheritable rejects non-int with badarg", e.kind == "badarg", "kind=%s" % e.kind)
+
+print("\n=== Criterion A: Precise handover ===")
+# Create a pipe that we DON'T want to hand over
+secret_r, secret_w = os.pipe()
+secret_r_h = msvcrt.get_osfhandle(secret_r)
+secret_w_h = msvcrt.get_osfhandle(secret_w)
+set_inheritable(secret_r_h, True)
+set_inheritable(secret_w_h, True)
+
+# Create a pipe that we DO want to hand over
+hand_r, hand_w = os.pipe()
+hand_r_h = msvcrt.get_osfhandle(hand_r)
+hand_w_h = msvcrt.get_osfhandle(hand_w)
+set_inheritable(hand_r_h, True)
+set_inheritable(hand_w_h, True)
+
+# Spawn a child that checks what handles it can see
+# The child will try to use the secret handle and the handed handle
+child_code = """
+import sys, ctypes, msvcrt
+from ctypes import wintypes
+k = ctypes.WinDLL('kernel32', use_last_error=True)
+g = k.GetHandleInformation
+g.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+g.restype = wintypes.BOOL
+
+secret_h = int(sys.argv[1])
+hand_h = int(sys.argv[2])
+
+f = wintypes.DWORD()
+secret_ok = g(wintypes.HANDLE(secret_h), ctypes.byref(f))
+hand_ok = g(wintypes.HANDLE(hand_h), ctypes.byref(f))
+
+# Write results to stdout
+print("SECRET:%d" % (1 if secret_ok else 0))
+print("HAND:%d" % (1 if hand_ok else 0))
+"""
+
+helper = spawn(
+    [PY, "-c", child_code, str(secret_r_h), str(hand_r_h)],
+    inherit=[hand_r_h],
+    stdout=subprocess.PIPE,
+    stderr=subprocess.DEVNULL,
+)
+out, _ = helper.communicate() if hasattr(helper._popen, 'communicate') else (b"", b"")
+if not out:
+    # Use wait and read from pipe
+    helper.wait(timeout=30)
+
+# Read from stdout pipe
+helper2 = spawn(
+    [PY, "-c", child_code, str(secret_r_h), str(hand_r_h)],
+    inherit=[hand_r_h],
+    stdout=subprocess.PIPE,
+    stderr=subprocess.DEVNULL,
+)
+stdout_data = helper2._popen.stdout.read()
+helper2.wait(timeout=30)
+lines = stdout_data.decode().strip().split("\n")
+print("  Child output:", lines)
+
+secret_visible = False
+hand_visible = False
+for line in lines:
+    if line.startswith("SECRET:"):
+        secret_visible = line.split(":")[1] == "1"
+    elif line.startswith("HAND:"):
+        hand_visible = line.split(":")[1] == "1"
+
+check("Secret handle NOT visible in child", not secret_visible,
+      "secret_visible=%s" % secret_visible)
+check("Handed handle IS visible in child", hand_visible,
+      "hand_visible=%s" % hand_visible)
+
+# Cleanup
+os.close(secret_r)
+os.close(secret_w)
+os.close(hand_r)
+os.close(hand_w)
+
+print("\n=== Criterion B: Handed objects are usable ===")
+# Create a pipe, write data, hand read end to child
+data_r, data_w = os.pipe()
+data_r_h = msvcrt.get_osfhandle(data_r)
+data_w_h = msvcrt.get_osfhandle(data_w)
+set_inheritable(data_r_h, True)
+
+os.write(data_w, b"hello-from-parent")
+os.close(data_w)
+
+child_read_code = """
+import sys, os, msvcrt
+h = int(sys.argv[1])
+fd = msvcrt.open_osfhandle(h, os.O_RDONLY)
+data = os.read(fd, 1024)
+sys.stdout.buffer.write(data)
+"""
+
+helper3 = spawn(
+    [PY, "-c", child_read_code, str(data_r_h)],
+    inherit=[data_r_h],
+    stdout=subprocess.PIPE,
+    stderr=subprocess.DEVNULL,
+)
+read_data = helper3._popen.stdout.read()
+helper3.wait(timeout=30)
+check("Child can read data from handed pipe", read_data == b"hello-from-parent",
+      "got: %r" % read_data)
+os.close(data_r)
+
+print("\n=== Criterion D: Handle values preserved ===")
+# Already tested above - the child uses the same handle value
+check("Handle values preserved (tested in A and B)", True)
+
+print("\n=== Summary ===")
+if errors:
+    print("FAILURES: %d" % len(errors))
+    for e in errors:
+        print("  - %s" % e)
+else:
+    print("All checks passed!")
