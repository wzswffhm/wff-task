diff --git a/wsparse/_handles.py b/wsparse/_handles.py
new file mode 100644
index 0000000..c561f8e
--- /dev/null
+++ b/wsparse/_handles.py
@@ -0,0 +1,127 @@
+"""Object handling shared by the public entry points.
+
+Every function in :mod:`wsparse` is handed a path by the collector.  Before
+anything else can happen the object behind that path has to be understood:
+
+* a sink file can be opened and asked about its layout,
+* a directory -- or anything else that is not a file -- can never carry the
+  sparse layout, and addressing one is an ``unsupported`` situation rather
+  than a transient I/O failure, and
+* a path that does not exist is an ``os`` failure: the caller mistyped, or the
+  file still has to be created.
+"""
+
+import os
+
+from . import _winapi as win
+from .errors import (
+    WSParseError,
+    check_path,
+    classify_winerror,
+    from_os_error,
+    from_winerror,
+    unsupported,
+)
+
+#: Access rights needed to change a file's sparse layout.
+UPDATE_ACCESS = win.GENERIC_READ | win.GENERIC_WRITE
+
+
+def normalize(path):
+    """Return ``path`` as a string, or raise a ``badarg`` error."""
+    try:
+        return check_path(path)
+    except TypeError as exc:
+        raise WSParseError(str(exc), kind="badarg") from exc
+
+
+def is_directory(attributes):
+    """Return ``True`` when the attribute word describes a directory."""
+    return bool(attributes & win.DIRECTORY_ATTRIBUTE)
+
+
+def describe(path, allow_missing=False):
+    """Return ``(path, attributes)`` for the object behind ``path``.
+
+    ``attributes`` is ``None`` when ``allow_missing`` is set and the object is
+    not there yet.  A directory is reported through
+    :class:`~wsparse.errors.WSParseError` with ``kind="unsupported"``, since no
+    sparse-file operation can ever succeed on it.
+    """
+    value = normalize(path)
+    attributes = win.get_file_attributes(value)
+    if attributes is None:
+        error = win.last_error()
+        missing = error in (win.ERROR_FILE_NOT_FOUND, win.ERROR_PATH_NOT_FOUND)
+        if missing and allow_missing:
+            return value, None
+        if missing:
+            raise from_winerror(error, "no such file", path=value, kind="os")
+        raise from_winerror(error, "cannot describe the object", path=value)
+    if is_directory(attributes):
+        raise unsupported("a directory cannot hold the sparse layout", path=value)
+    return value, attributes
+
+
+def open_update(path, create=False):
+    """Open ``path`` for read/write access and return ``(path, handle)``.
+
+    The handle is shared for reading, writing and deleting so that the writer
+    the collector keeps open on the same sink does not block the call.
+    """
+    value, _ = describe(path, allow_missing=create)
