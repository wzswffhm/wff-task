diff --git a/probe_tmp.py b/probe_tmp.py
new file mode 100644
index 0000000..bbd1593
--- /dev/null
+++ b/probe_tmp.py
@@ -0,0 +1,125 @@
+import ctypes
+import os
+import tempfile
+from ctypes import wintypes as W
+
+k = ctypes.WinDLL("kernel32", use_last_error=True)
+k.CreateFileW.restype = ctypes.c_void_p
+k.CreateFileW.argtypes = [W.LPCWSTR, W.DWORD, W.DWORD, ctypes.c_void_p, W.DWORD, W.DWORD, ctypes.c_void_p]
+k.DeviceIoControl.restype = W.BOOL
+k.DeviceIoControl.argtypes = [ctypes.c_void_p, W.DWORD, ctypes.c_void_p, W.DWORD, ctypes.c_void_p, W.DWORD, ctypes.POINTER(W.DWORD), ctypes.c_void_p]
+k.GetCompressedFileSizeW.restype = W.DWORD
+k.GetCompressedFileSizeW.argtypes = [W.LPCWSTR, ctypes.POINTER(W.DWORD)]
+k.SetFilePointerEx.argtypes = [ctypes.c_void_p, W.LARGE_INTEGER, ctypes.POINTER(W.LARGE_INTEGER), W.DWORD]
+k.SetFilePointerEx.restype = W.BOOL
+k.SetEndOfFile.argtypes = [ctypes.c_void_p]
+k.SetEndOfFile.restype = W.BOOL
+k.FlushFileBuffers.argtypes = [ctypes.c_void_p]
+k.FlushFileBuffers.restype = W.BOOL
+
+
+class R(ctypes.Structure):
+    _fields_ = [("FileOffset", W.LARGE_INTEGER), ("Length", W.LARGE_INTEGER)]
+
+
+def compressed(p):
+    lo = W.DWORD(0)
+    v = k.GetCompressedFileSizeW(p, ctypes.byref(lo))
+    return (lo.value << 32) | v
+
+
+def ranges_of(p, length):
+    h = k.CreateFileW(p, 0x80000000, 7, None, 3, 0x80, None)
+    q = R()
+    q.FileOffset = 0
+    q.Length = length
+    out = (R * 8)()
+    ret = W.DWORD(0)
+    ok = k.DeviceIoControl(h, 0x940CF, ctypes.byref(q), ctypes.sizeof(q), out, ctypes.sizeof(out), ctypes.byref(ret), None)
+    n = ret.value // ctypes.sizeof(R)
+    res = [(out[i].FileOffset, out[i].Length) for i in range(n)]
+    k.FlushFileBuffers(h)
+    k.CloseHandle(h)
+    return ok, res
+
+
+def preallocate(p, size):
+    h = k.CreateFileW(p, 0xC0000000, 7, None, 4, 0x80, None)
+    k.DeviceIoControl(h, 0x900C4, ctypes.byref(W.BOOL(True)), 4, None, 0, ctypes.byref(W.DWORD(0)), None)
+    k.SetFilePointerEx(h, W.LARGE_INTEGER(size), None, 0)
+    k.SetEndOfFile(h)
+    k.FlushFileBuffers(h)
+    k.CloseHandle(h)
+
+
+d = tempfile.mkdtemp()
+
+for label, size, writes in (
+    ("64MiB-two-writes", 64 * 1024 * 1024, [(1024, b"payload-one"), (32 * 1024 * 1024, b"payload-two")]),
+    ("1GiB-no-writes", 1 << 30, []),
+):
+    p = os.path.join(d, label + ".bin")
+    preallocate(p, size)
+    print("[%s] pre: attrs %s size %d compressed %d ranges %s" % (label, oct(k.GetFileAttributesW(p)), os.path.getsize(p), compressed(p), ranges_of(p, size)))
+    if writes:
+        with open(p, "r+b") as f:
+            for off, data in writes:
+                f.seek(off)
+                f.write(data)
+        print("[%s] post-python-write: compressed %d ranges %s" % (label, compressed(p), ranges_of(p, size)))
+        h = k.CreateFileW(p, 0x80000000, 7, None, 3, 0x80, None)
+        k.FlushFileBuffers(h)
+        k.CloseHandle(h)
+        print("[%s] after FlushFileBuffers: compressed %d ranges %s" % (label, compressed(p), ranges_of(p, size)))
+        with open(p, "rb") as f:
+            f.seek(writes[0][0])
+            print("[%s] readback %r" % (label, f.read(len(writes[0][1]))))
+            f.seek(size - 100)
+            print("[%s] tail zeros %r" % (label, f.read(100)[:20]))
+    print()
+
+# dense 64 MiB via normal python write
+p = os.path.join(d, "dense64.bin")
+with open(p, "wb") as f:
+    f.write(b"z" * (64 * 1024 * 1024))
+print("[dense64] size", os.path.getsize(p), "compressed", compressed(p), "ranges", ranges_of(p, 64 * 1024 * 1024))
+
+# dense 1GiB via our preallocate then sparse off? (sequential semantics test)
+p = os.path.join(d, "dense_then_sparse.bin")
+with open(p, "wb") as f:
+    f.write(b"z" * (2 * 1024 * 1024))
+print("[dense->sparse] before:", os.path.getsize(p), compressed(p), oct(k.GetFileAttributesW(p)))
+h = k.CreateFileW(p, 0xC0000000, 7, None, 3, 0x80, None)
+ok = k.DeviceIoControl(h, 0x900C4, ctypes.byref(W.BOOL(True)), 4, None, 0, ctypes.byref(W.DWORD(0)), None)
+print("[dense->sparse] SET_SPARSE ok", ok, "err", ctypes.get_last_error())
+k.CloseHandle(h)
+print("[dense->sparse] after flag: attrs", oct(k.GetFileAttributesW(p)), "compressed", compressed(p), "ranges", ranges_of(p, 2 * 1024 * 1024))
+
+# clearing the sparse flag
+p2 = os.path.join(d, "clear.bin")
+preallocate(p2, 8 * 1024 * 1024)
+print("[clear] attrs", oct(k.GetFileAttributesW(p2)), "compressed", compressed(p2))
+h = k.CreateFileW(p2, 0xC0000000, 7, None, 3, 0x80, None)
+ok = k.DeviceIoControl(h, 0x900C4, ctypes.byref(W.BOOL(False)), 4, None, 0, ctypes.byref(W.DWORD(0)), None)
+print("[clear] SET_SPARSE(False) ok", ok, "err", ctypes.get_last_error())
+k.CloseHandle(h)
+print("[clear] attrs after clear", oct(k.GetFileAttributesW(p2)), "compressed", compressed(p2), "ranges", ranges_of(p2, 8 * 1024 * 1024))
+
+# SET_SPARSE on a directory
+sub = os.path.join(d, "subdir")
+os.mkdir(sub)
+h = k.CreateFileW(sub, 0xC0000000, 7, None, 3, 0x02000000, None)
+print("[dir] handle", h, "err", ctypes.get_last_error())
+if h:
+    ok = k.DeviceIoControl(h, 0x900C4, ctypes.byref(W.BOOL(True)), 4, None, 0, ctypes.byref(W.DWORD(0)), None)
+    print("[dir] SET_SPARSE ok", ok, "err", ctypes.get_last_error())
+    ret = W.DWORD(0)
+    buf = W.LARGE_INTEGER(0)
+    ok2 = k.DeviceIoControl(h, 0x900FC, None, 0, ctypes.byref(buf), 8, ctypes.byref(ret), None)
+    print("[dir] GET_COMPRESSED ok", ok2, "err", ctypes.get_last_error())
+    q = R(); q.FileOffset = 0; q.Length = 100
+    out = (R * 4)()
+    ok3 = k.DeviceIoControl(h, 0x940CF, ctypes.byref(q), ctypes.sizeof(q), out, ctypes.sizeof(out), ctypes.byref(ret), None)
+    print("[dir] QUERY_RANGES ok", ok3, "err", ctypes.get_last_error())
+    k.CloseHandle(h)
+print("[dir] attrs", oct(k.GetFileAttributesW(sub)), "compressed-api", compressed(sub), "err", ctypes.get_last_error())
