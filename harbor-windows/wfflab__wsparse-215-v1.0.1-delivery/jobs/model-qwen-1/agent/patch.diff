diff --git a/_probe_tmp.py b/_probe_tmp.py
new file mode 100644
index 0000000..e463c16
--- /dev/null
+++ b/_probe_tmp.py
@@ -0,0 +1,151 @@
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, r"C:\testbed")
+from wsparse import (preallocate, disk_usage, allocated_ranges, sparse_flag,
+                     sparse_state, WSParseError)
+
+tmp = tempfile.mkdtemp()
+MiB = 1 << 20
+GiB = 1 << 30
+
+
+def show(label, p):
+    print("%-32s size=%-11d sparse=%-5s usage=%-10d ranges=%s"
+          % (label, os.path.getsize(p), sparse_state(p), disk_usage(p),
+             allocated_ranges(p)[:4]))
+
+
+print("### dense files, various lengths")
+for n in (0, 1, 4095, 4096, 4097, 65535, 65536, 65537, MiB, MiB + 1):
+    p = os.path.join(tmp, "dense%d.bin" % n)
+    with open(p, "wb") as f:
+        f.write(b"x" * n)
+        f.flush()
+        os.fsync(f.fileno())
+    show("dense %d" % n, p)
+
+print("### criterion C: sparse 64MiB with two small writes")
+sp = os.path.join(tmp, "sparse64.bin")
+preallocate(sp, 64 * MiB)
+show("preallocated 64MiB", sp)
+with open(sp, "r+b") as f:
+    f.seek(1024)
+    f.write(b"A" * 17)
+    f.seek(32 * MiB)
+    f.write(b"B" * 17)
+    f.flush()
+    os.fsync(f.fileno())
+show("after two writes", sp)
+with open(sp, "rb") as f:
+    f.seek(1024)
+    assert f.read(17) == b"A" * 17
+    f.seek(32 * MiB)
+    assert f.read(17) == b"B" * 17
+    f.seek(50 * MiB)
+    assert f.read(4096) == b"\x00" * 4096, "hole must read as zeros"
+print("   readback + hole-zeros OK; usage < 1MiB:", disk_usage(sp) < MiB)
+
+print("### criterion A: 1GiB preallocation")
+big = os.path.join(tmp, "big1g.bin")
+import time
+t = time.time()
+preallocate(big, GiB)
+print("   took %.4fs size=%d usage=%d (<8MiB: %s) ranges=%s"
+      % (time.time() - t, os.path.getsize(big), disk_usage(big),
+         disk_usage(big) < 8 * MiB, allocated_ranges(big)))
+preallocate(big, GiB)
+print("   idempotent: size=%d usage=%d" % (os.path.getsize(big), disk_usage(big)))
+
+print("### criterion B: write into the 1GiB sink")
+with open(big, "r+b") as f:
+    f.seek(500 * MiB)
+    f.write(b"payload-xyz")
+    f.flush()
+    os.fsync(f.fileno())
+show("after one write", big)
+with open(big, "rb") as f:
+    f.seek(500 * MiB)
+    assert f.read(11) == b"payload-xyz"
+print("   readback OK")
+
+print("### criterion E: sparse flag on an already dense file")
+d = os.path.join(tmp, "denseE.bin")
+with open(d, "wb") as f:
+    f.write(b"q" * (16 * MiB))
+    f.flush()
+    os.fsync(f.fileno())
+show("dense before", d)
+print("   sparse_flag(True) ->", sparse_flag(d, True))
+show("dense after flag", d)
+assert disk_usage(d) >= 16 * MiB, "must not lie about dense occupancy"
+print("   still reports dense occupancy:", disk_usage(d))
+print("   sparse_flag(False) ->", sparse_flag(d, False))
+show("after clearing", d)
+
+print("### clearing the sparse flag on a holey file (documents NTFS behaviour)")
+c = os.path.join(tmp, "clear.bin")
+preallocate(c, 4 * MiB)
+show("preallocated", c)
+print("   sparse_flag(False) ->", sparse_flag(c, False))
+show("after clearing", c)
+
+print("### criterion F: unsupported objects")
+adir = os.path.join(tmp, "adir")
+os.makedirs(os.path.join(adir, "sub"), exist_ok=True)
+for fn, args in (("preallocate", (adir, 4096)), ("disk_usage", (adir,)),
+                 ("allocated_ranges", (adir,)), ("sparse_flag", (adir, True)),
+                 ("sparse_state", (adir,))):
+    try:
+        print("   %-16s -> %r" % (fn, globals()[fn](*args)))
+    except WSParseError as exc:
+        print("   %-16s -> WSParseError kind=%s" % (fn, exc.kind))
+    except Exception as exc:
+        print("   %-16s -> UNEXPECTED %r" % (fn, exc))
+
+print("### missing paths stay kind='os'")
+missing = os.path.join(tmp, "nope.bin")
+for fn in (disk_usage, allocated_ranges, sparse_state):
+    try:
+        fn(missing)
+        print("   ", fn.__name__, "-> NO ERROR")
+    except WSParseError as exc:
+        print("   %-16s -> kind=%s" % (fn.__name__, exc.kind))
+try:
+    sparse_flag(missing, True)
+except WSParseError as exc:
+    print("   sparse_flag      -> kind=%s" % exc.kind)
+try:
+    preallocate(missing, 4096)
+    print("   preallocate      -> created file (kind=none)")
+except WSParseError as exc:
+    print("   preallocate      -> kind=%s" % exc.kind)
+
+print("### badargs")
+for bad in (-1, 1.5, True, "10", None):
+    try:
+        preallocate(os.path.join(tmp, "bad.bin"), bad)
+        print("   %r -> NO ERROR" % (bad,))
+    except WSParseError as exc:
+        print("   %-6r -> kind=%s" % (bad, exc.kind))
+
+print("### asset comparison")
+show("assets/dense_64k.bin", r"C:\testbed\assets\dense_64k.bin")
+
+print("### many ranges")
+mr = os.path.join(tmp, "many.bin")
+preallocate(mr, 64 * MiB)
+with open(mr, "r+b") as f:
+    for i in range(0, 300):
+        f.seek(i * 200 * 1024)
+        f.write(b"%04d" % i)
+    f.flush()
+    os.fsync(f.fileno())
+r = allocated_ranges(mr)
+print("   ranges=%d usage=%d size=%d monotonic=%s disjoint=%s inside=%s"
+      % (len(r), disk_usage(mr), os.path.getsize(mr),
+         all(r[i][0] <= r[i + 1][0] for i in range(len(r) - 1)),
+         all(r[i][0] + r[i][1] <= r[i + 1][0] for i in range(len(r) - 1)),
+         all(o >= 0 and l > 0 and o + l <= os.path.getsize(mr) for o, l in r)))
+print("tmp", tmp)
