new file mode 100644
index 0000000..ab58164
--- /dev/null
+++ b/wsparse/_common.py
@@ -0,0 +1,92 @@
+"""Shared argument checking and range bookkeeping for :mod:`wsparse`.
+
+Nothing in here talks to the operating system; it is the part of the module
+that is the same no matter which platform layer ends up doing the work.
+"""
+
+import os
+
+from .errors import WSParseError
+
+
+def as_path(path):
+    """Normalise ``path`` into a string, rejecting unusable arguments."""
+    try:
+        return os.fspath(path)
+    except TypeError as exc:
+        raise WSParseError(
+            "path must be a string or os.PathLike, got %r" % (path,), kind="badarg"
+        ) from exc
+
+
+def check_size(size):
+    """Reject sizes that cannot describe a file length."""
+    if isinstance(size, bool) or not isinstance(size, int):
+        raise WSParseError("size must be an integer, got %r" % (size,), kind="badarg")
+    if size < 0:
+        raise WSParseError("size must not be negative, got %r" % (size,), kind="badarg")
+
+
+def require_existing(path):
+    """Raise a ``kind="os"`` error when ``path`` is not there at all."""
+    if not os.path.lexists(path):
+        raise WSParseError("no such file: %s" % path, kind="os", path=path)
+
+
+def require_sparse_capable_object(path):
+    """Reject objects that can never carry sparse-file semantics.
+
+    A directory is the common case: it is a perfectly valid path, it just is
+    not a stream that can have holes punched in it.  That is an
+    ``"unsupported"`` condition, not an I/O error, and it has to be reported as
+    one instead of silently succeeding.
+    """
+    if os.path.isdir(path):
+        raise WSParseError(
+            "sparse-file operations are not supported on a directory",
+            kind="unsupported",
+            path=path,
+        )
+
+
+def round_up(value, unit):
+    """Round ``value`` up to the next multiple of ``unit``."""
+    if unit <= 0 or value <= 0:
+        return max(value, 0)
+    remainder = value % unit
+    if remainder == 0:
+        return value
+    return value + (unit - remainder)
+
+
+def normalize_ranges(ranges, size):
+    """Clean up the raw ranges reported by the platform layer.
+
+    The result is ordered by offset, free of overlaps and of empty entries, and
+    entirely inside ``size``.  Ranges that touch are merged so that a dense
+    file comes back as a single range covering the whole file.
+    """
+    if size <= 0:
+        return []
+    clipped = []
+    for offset, length in ranges:
+        offset = int(offset)
+        length = int(length)
+        if length <= 0:
+            continue
+        start = max(offset, 0)
+        end = min(offset + length, size)
+        if end <= start:
+            continue
+        clipped.append((start, end))
+    clipped.sort()
+
+    merged = []
+    for start, end in clipped:
+        if merged and start <= merged[-1][1]:
+            previous_start, previous_end = merged[-1]
+            if end > previous_end:
+                merged[-1] = (previous_start, end)
+        else:
+            merged.append((start, end))
+    return [(start, end - start) for start, end in merged]
diff --git a/wsparse/_posix.py b/wsparse/_posix.py
new file mode 100644
index 0000000..7ac50bb
--- /dev/null
+++ b/wsparse/_posix.py
@@ -0,0 +1,85 @@
+"""Development-time fallback for platforms that are not Windows.
+
+The target platform of :mod:`wsparse` is Windows on NTFS, and the acceptance
+criteria are stated in terms of NTFS cluster allocation.  This module exists
+only so that the module can be imported and smoke-tested on a developer
+workstation that is not Windows; it is *not* an alternative implementation of
+the contract and it is never reached on the target platform.
+"""
+
+import os
+
+from ._common import normalize_ranges, round_up
+
+#: st_blocks is reported in 512-byte units by POSIX, regardless of the real
+#: block size of the file system.
+_STAT_BLOCK = 512
+
+_DEFAULT_CLUSTER = 4096
+
+
+def cluster_size(path):
+    try:
+        info = os.statvfs(path if os.path.exists(path) else os.path.dirname(path) or ".")
+    except (OSError, AttributeError):
+        return _DEFAULT_CLUSTER
+    size = getattr(info, "f_frsize", 0) or getattr(info, "f_bsize", 0)
+    return size or _DEFAULT_CLUSTER
+
+
+def preallocate(path, size):
+    flags = os.O_RDWR | os.O_CREAT
+    fd = os.open(path, flags, 0o666)
+    try:
+        current = os.fstat(fd).st_size
+        if size > current:
+            os.ftruncate(fd, size)
+            current = size
+        return current
+    finally:
+        os.close(fd)
+
+
+def disk_usage(path):
+    info = os.stat(path)
+    used = int(getattr(info, "st_blocks", 0)) * _STAT_BLOCK
+    if used == 0 and info.st_size > 0:
+        used = round_up(info.st_size, cluster_size(path))
+    return used
+
+
+def allocated_ranges(path):
+    size = os.path.getsize(path)
+    if size == 0:
+        return []
+    seek_data = getattr(os, "SEEK_DATA", None)
+    seek_hole = getattr(os, "SEEK_HOLE", None)
+    if seek_data is None or seek_hole is None:
+        return [(0, size)]
+    found = []
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        cursor = 0
+        while cursor < size:
+            try:
+                start = os.lseek(fd, cursor, seek_data)
+            except OSError:
+                break
+            if start >= size:
+                break
+            end = os.lseek(fd, start, seek_hole)
+            if end <= start:
+                break
+            found.append((start, min(end, size) - start))
+            cursor = end
+    finally:
+        os.close(fd)
+    return normalize_ranges(found, size)
+
+
+def sparse_state(path):
+    info = os.stat(path)
+    if info.st_size == 0:
+        return False
+    allocated = int(getattr(info, "st_blocks", 0)) * _STAT_BLOCK
+    return allocated < round_up(info.st_size, cluster_size(path))
