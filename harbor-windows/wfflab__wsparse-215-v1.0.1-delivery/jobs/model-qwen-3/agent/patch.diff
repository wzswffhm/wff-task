diff --git a/_probe3_tmp.py b/_probe3_tmp.py
new file mode 100644
index 0000000..ea2cb16
--- /dev/null
+++ b/_probe3_tmp.py
@@ -0,0 +1,81 @@
+"""Probe 3: non-sparse files extended via SetEndOfFile, cluster granularity."""
+import ctypes
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, r"C:\testbed")
+from wsparse import _winapi as w  # noqa: E402
+
+root = tempfile.mkdtemp(prefix="probe3-")
+
+
+def ranges_of(path):
+    h = w.open_file(path)
+    try:
+        return w.query_allocated_ranges(h)
+    finally:
+        w._load().CloseHandle(h)
+
+
+try:
+    a = os.path.join(root, "a.bin")
+    open(a, "wb").close()
+    with w.open_handle(a, write=True) as h:
+        w.set_end_of_file(h.handle, 4 << 20)
+    print("dense SetEndOfFile 4MiB -> size", os.path.getsize(a), "ranges", ranges_of(a),
+          "compressed", w.get_compressed_file_size(a))
+
+    b = os.path.join(root, "b.bin")
+    with open(b, "wb") as fh:
+        fh.truncate(4 << 20)
+    print("python truncate 4MiB -> size", os.path.getsize(b), "ranges", ranges_of(b),
+          "compressed", w.get_compressed_file_size(b))
+
+    c = os.path.join(root, "c.bin")
+    open(c, "wb").close()
+    with w.open_handle(c, write=True) as h:
+        w.set_sparse(h.handle, True)
+        w.set_end_of_file(h.handle, 1 << 20)
+        w.set_zero_data(h.handle, 0, 1 << 20)
+    with open(c, "r+b") as fh:
+        fh.seek((1 << 20) - 100)
+        fh.write(b"t" * 100)
+    rc = ranges_of(c)
+    print("sparse tail write ->", rc, "sum", sum(e - s for s, e in rc))
+
+    k = w._load()
+    k.GetDiskFreeSpaceW.restype = ctypes.c_int
+    k.GetDiskFreeSpaceW.argtypes = [
+        ctypes.c_wchar_p,
+        ctypes.POINTER(ctypes.c_uint32),
+        ctypes.POINTER(ctypes.c_uint32),
+        ctypes.POINTER(ctypes.c_uint32),
+        ctypes.POINTER(ctypes.c_uint32),
+    ]
+    spc = ctypes.c_uint32(0)
+    bps = ctypes.c_uint32(0)
+    nfc = ctypes.c_uint32(0)
+    tnc = ctypes.c_uint32(0)
+    ok = k.GetDiskFreeSpaceW(w.volume_root(root), ctypes.byref(spc), ctypes.byref(bps),
+                             ctypes.byref(nfc), ctypes.byref(tnc))
+    print("GetDiskFreeSpaceW ok:", ok, "cluster", spc.value * bps.value)
+
+    d = os.path.join(root, "d.bin")
+    with open(d, "wb") as fh:
+        fh.write(b"x" * (1 << 20))
+    print("before sparse_flag:", ranges_of(d), "compressed", w.get_compressed_file_size(d))
+    with w.open_handle(d, write=True) as h:
+        w.set_sparse(h.handle, True)
+    print("after sparse_flag :", ranges_of(d), "compressed", w.get_compressed_file_size(d))
+    with w.open_handle(d, write=True) as h:
+        w.set_zero_data(h.handle, 4096, (1 << 20) - 4096)
+    print("after punch middle:", ranges_of(d), "compressed", w.get_compressed_file_size(d))
+    with open(d, "rb") as fh:
+        fh.seek(4096)
+        print("middle reads zeros:", fh.read(100) == b"\x00" * 100)
+        fh.seek(0)
+        print("head kept:", fh.read(10))
+finally:
+    shutil.rmtree(root, ignore_errors=True)
diff --git a/_probe4_tmp.py b/_probe4_tmp.py
new file mode 100644
index 0000000..1c0f6b5
--- /dev/null
+++ b/_probe4_tmp.py
@@ -0,0 +1,96 @@
+"""Probe 4: granularity of QUERY_ALLOCATED_RANGES on this volume."""
+import ctypes
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, r"C:\testbed")
+from wsparse import _winapi as w  # noqa: E402
+
+root = tempfile.mkdtemp(prefix="probe4-")
+
+
+def ranges_of(path):
+    h = w.open_file(path)
+    try:
+        return w.query_allocated_ranges(h)
+    finally:
+        w._load().CloseHandle(h)
+
+
+def make_sparse(path, size):
+    open(path, "wb").close()
+    with w.open_handle(path, write=True) as h:
+        w.set_sparse(h.handle, True)
+        w.set_end_of_file(h.handle, size)
+        w.set_zero_data(h.handle, 0, size)
+
+
+try:
+    for offset, count in ((0, 1), (0, 100), (4096, 1), (1 << 20, 4096), (1 << 20, 1),
+                          (3 << 20, 8192), ((1 << 20) + 1, 4096)):
+        p = os.path.join(root, "g_%d_%d.bin" % (offset, count))
+        make_sparse(p, 8 << 20)
+        with open(p, "r+b") as fh:
+            fh.seek(offset)
+            fh.write(b"x" * count)
+        r = ranges_of(p)
+        print("write %6d bytes @ %-9d -> %s (sum %d)" % (count, offset, r,
+                                                         sum(e - s for s, e in r)))
+
+    # two far apart writes
+    p = os.path.join(root, "two.bin")
+    make_sparse(p, 8 << 20)
+    with open(p, "r+b") as fh:
+        fh.seek(1 << 20)
+        fh.write(b"x" * 4096)
+        fh.seek(5 << 20)
+        fh.write(b"y" * 4096)
+    print("two writes:", ranges_of(p))
+
+    # non-sparse file written with python
+    p = os.path.join(root, "dense.bin")
+    with open(p, "wb") as fh:
+        fh.write(b"x" * 1000)
+    print("dense 1000:", ranges_of(p), "compressed", w.get_compressed_file_size(p))
+
+    # cluster size
+    k = w._load()
+    k.GetDiskFreeSpaceW.restype = ctypes.c_int
+    k.GetDiskFreeSpaceW.argtypes = [
+        ctypes.c_wchar_p,
+        ctypes.POINTER(ctypes.c_uint32),
+        ctypes.POINTER(ctypes.c_uint32),
+        ctypes.POINTER(ctypes.c_uint32),
+        ctypes.POINTER(ctypes.c_uint32),
+    ]
+    spc, bps, nfc, tnc = (ctypes.c_uint32(0) for _ in range(4))
+    ok = k.GetDiskFreeSpaceW(w.volume_root(root), ctypes.byref(spc), ctypes.byref(bps),
+                             ctypes.byref(nfc), ctypes.byref(tnc))
+    print("cluster bytes:", spc.value * bps.value if ok else "unknown")
+
+    # free-space delta measurement for a 1 GiB preallocation
+    def free_bytes():
+        k.GetDiskFreeSpaceExW.restype = ctypes.c_int
+        k.GetDiskFreeSpaceExW.argtypes = [
+            ctypes.c_wchar_p,
+            ctypes.POINTER(ctypes.c_ulonglong),
+            ctypes.POINTER(ctypes.c_ulonglong),
+            ctypes.POINTER(ctypes.c_ulonglong),
+        ]
+        free = ctypes.c_ulonglong(0)
+        k.GetDiskFreeSpaceExW(root, None, ctypes.byref(free), None)
+        return free.value
+
+    before = free_bytes()
+    p = os.path.join(root, "gig.bin")
+    sys.path.insert(0, r"C:\testbed")
+    from wsparse import preallocate  # noqa: E402
+
+    preallocate(p, 1 << 30)
+    after = free_bytes()
+    print("free-space delta for 1GiB preallocate:", before - after)
+    print("gig ranges:", ranges_of(p), "compressed", w.get_compressed_file_size(p))
+finally:
+    shutil.rmtree(root, ignore_errors=True)
