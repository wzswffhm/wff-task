 import os
 
+from . import _winapi
+from ._common import check_object, classify_open_error, os_error
+from ._winapi import SPARSE_ATTRIBUTE
 from .errors import WSParseError
 
+#: Cluster size assumed when the volume will not tell us one.
+_DEFAULT_CLUSTER = 4096
+
+
+def _align_up(value, cluster):
+    """Round ``value`` up to a whole number of clusters."""
+    if cluster <= 1:
+        return int(value)
+    remainder = value % cluster
+    if remainder:
+        value += cluster - remainder
+    return int(value)
+
 
