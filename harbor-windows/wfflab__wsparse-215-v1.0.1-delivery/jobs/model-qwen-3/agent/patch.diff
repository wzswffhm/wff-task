diff --git a/wsparse/_common.py b/wsparse/_common.py
new file mode 100644
index 0000000..7deb0f8
--- /dev/null
+++ b/wsparse/_common.py
@@ -0,0 +1,93 @@
+"""Shared plumbing for the space-accounting entry points.
+
+Every public function of :mod:`wsparse` starts by turning the caller's path
+into a concrete NTFS file and by classifying the object it names.  Doing that in
+one place keeps the error taxonomy consistent:
+
+``WSParseError(kind="os")``
+    the object is missing, or could not be opened / read at all,
+``WSParseError(kind="unsupported")``
+    the object is not something the file system can hold a sparse range in --
+    a directory, a named pipe, a device -- or the volume does not support
+    sparse files at all.
+"""
+
+import os
+
+from . import _winapi
+from ._winapi import is_windows
+from .errors import WSParseError
+
+_UNSUPPORTED_MESSAGE = "sparse files are not supported on this object"
+
+
+def normalize(path):
+    """Return the caller's path as a string, unchanged in every other respect."""
+    return os.fspath(path)
+
+
+def check_object(path, need_sparse_volume=True):
+    """Make sure ``path`` is a plain file we can run the sparse queries against.
+
+    Raises :class:`~wsparse.errors.WSParseError` with a classified ``kind``.
+    """
+    if not is_windows():
+        raise WSParseError(
+            "sparse-file space accounting is a Windows/NTFS operation",
+            kind="unsupported",
+            path=path,
+        )
+
+    if not os.path.lexists(path):
+        raise WSParseError("no such file: %s" % path, kind="os", path=path)
+
+    # A directory (or a reparse point standing for one) has no byte ranges at
+    # all: this is the "the object does not support sparse files" case.
+    try:
+        directory = _winapi.is_directory(path)
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+    if directory:
+        raise WSParseError(_UNSUPPORTED_MESSAGE, kind="unsupported", path=path)
+
+    try:
+        is_regular = os.path.isfile(path)
+    except OSError as exc:
+        raise WSParseError(str(exc), kind="os", path=path) from exc
+    if not is_regular:
+        raise WSParseError(_UNSUPPORTED_MESSAGE, kind="unsupported", path=path)
+
+    if need_sparse_volume:
+        try:
+            supported = _winapi.volume_supports_sparse(path)
+        except OSError as exc:
+            raise WSParseError(str(exc), kind="os", path=path) from exc
+        if not supported:
+            raise WSParseError(
+                "the volume does not support sparse files",
+                kind="unsupported",
+                path=path,
+            )
+
+
+def unsupported(path):
+    """Return the canonical "this object cannot be sparse" error."""
+    return WSParseError(_UNSUPPORTED_MESSAGE, kind="unsupported", path=path)
+
+
+def os_error(exc, path):
+    """Wrap an :class:`OSError` as ``WSParseError(kind="os")``."""
+    return WSParseError(str(exc), kind="os", path=path)
+
+
+def classify_open_error(exc, path):
+    """Turn an :class:`OSError` raised while opening ``path`` into a
+    :class:`~wsparse.errors.WSParseError` with the right ``kind``."""
+    code = getattr(exc, "winerror", None)
+    if code is None:
+        code = getattr(exc, "errno", None)
+    if code in (2, 3):  # FILE_NOT_FOUND / PATH_NOT_FOUND
+        return WSParseError(str(exc), kind="os", path=path)
+    if code == 267 or _winapi.is_unsupported(exc):  # ERROR_DIRECTORY
+        return unsupported(path)
+    return WSParseError(str(exc), kind="os", path=path)
diff --git a/wsparse/_winapi.py b/wsparse/_winapi.py
index d16a526..75ad708 100644
--- a/wsparse/_winapi.py
+++ b/wsparse/_winapi.py
@@ -1,24 +1,497 @@
 """Thin ctypes bindings for the Win32 calls that :mod:`wsparse` needs.
 
-Only the calls the current implementation actually uses are bound here. The
-module is written so that importing it on a non-Windows platform stays cheap:
-the DLL is loaded lazily, on first use.
+Everything the package does is described in terms of the NTFS file system:
+
+* ``FSCTL_SET_SPARSE`` marks a file sparse, which is what makes the rest of the
+  space accounting meaningful,
+* ``SetEndOfFile`` grows a sparse file without allocating a single cluster,
+* ``FSCTL_SET_ZERO_DATA`` turns a byte range back into a hole,
+* ``FSCTL_QUERY_ALLOCATED_RANGES`` reports the byte ranges that really are
+  backed by clusters, and
+* ``GetCompressedFileSizeW`` reports the clusters a file occupies on disk.
+
+The DLL is loaded lazily, on first use, so that importing :mod:`wsparse` stays
+cheap.  All helpers raise :class:`OSError` carrying the Win32 error code when a
+call fails; the modules on top of this one classify that into a
+:class:`~wsparse.errors.WSParseError`.
 """
 
+import ctypes
 import os
 
-# FILE_ATTRIBUTE_SPARSE_FILE
+#: FILE_ATTRIBUTE_SPARSE_FILE
 SPARSE_ATTRIBUTE = 0x00000200
+#: FILE_ATTRIBUTE_DIRECTORY
