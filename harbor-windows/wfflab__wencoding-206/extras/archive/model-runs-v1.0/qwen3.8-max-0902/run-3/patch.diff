+def codec_name(name):
+    """返回 ``name``（可含别名）对应的标准编解码器名称。
+
+    用于比较两个编码名是否等价，例如 ``"UTF_8_SIG"`` 与 ``"utf-8-sig"``。
+    无法识别时原样返回 ``name`` 的字符串形式。
+    """
