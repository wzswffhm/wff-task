+* 换行固定为 CRLF。换行翻译在这里自己做，不交给 ``open()``：
+  ``open(..., newline="\\r\\n")`` 会把文本中每一个 ``\\n`` 都翻译成 ``\\r\\n``，
+  本来就是 ``\\r\\n`` 的行尾于是被写成 ``\\r\\r\\n``。
+"""
+
+import os
+
+from .codec import BOM_ENCODING, codec_name, encoding_for
+
+#: ``open()`` 接受的 ``newline`` 取值。
+_LEGAL_NEWLINES = ("", "\n", "\r", "\r\n")
+
+
+def _translate_newlines(text, newline):
+    """按 ``newline`` 统一换行，返回 ``(落盘文本, 传给 open() 的 newline)``。
+
+    先把已有的 ``\\r\\n`` / ``\\r`` 归一成 ``\\n``，再统一替换成目标换行，
+    这样重复写入、追加写入都不会累积出多余的 ``\\r``。返回的 ``open()``
+    换行参数为 ``""``（不翻译）或 ``"\\n"``（同样不翻译），翻译由本函数完成。
+    """
+    if newline is None:
+        # 沿用 open() 的历史语义：按平台换行符翻译。
+        newline = os.linesep
+    if newline not in _LEGAL_NEWLINES:
+        raise ValueError("illegal newline value {0!r}".format(newline))
+    if newline in ("", "\n"):
+        # 这两种取值下 open() 不做任何翻译，文本原样落盘。
+        return text, newline
+    unified = text.replace("\r\n", "\n").replace("\r", "\n")
+    return unified.replace("\n", newline), ""
+
+
+def _has_content(path):
+    """文件已存在且非空时返回 ``True``。"""
+    try:
+        return os.path.getsize(path) > 0
+    except (OSError, ValueError):
+        return False
 
 
