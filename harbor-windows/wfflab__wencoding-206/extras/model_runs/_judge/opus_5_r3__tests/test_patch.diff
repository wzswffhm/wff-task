+"""文本编码策略的行为验证。
+
+覆盖三类只在「系统默认编码不是 UTF-8」的平台上暴露的问题：
+按平台默认值写非 ASCII 文本会失败或落成别的字节、按平台默认值读 UTF-8
+文本会解错、以及带 BOM 的 UTF-8 需要显式选择变体。
+v2.0 扩展：编码别名归一化、``encoding_for`` 的映射语义、
+BOM 写读的逐字节与 U+FEFF 语义、``write_lines``/``read_lines`` 的编码与换行。
+"""
+
+import pytest
+
+from wtextio import (
+    append_text,
+    detect_bom,
+    encoding_for,
+    read_lines,
+    read_text,
+    system_encoding,
+    write_lines,
+    write_text,
+)
+
+CJK = "中文内容"
+ACCENTED = "café résumé naïve"
+
+
+# --- 核心回归（base 上失败） ------------------------------------------------
+
+
+def test_write_cjk_with_default_encoding_does_not_fail(tmp_path):
+    path = tmp_path / "cjk.txt"
+    write_text(str(path), CJK)
+    assert path.is_file()
+
+
+def test_write_cjk_produces_utf8_bytes(tmp_path):
+    path = tmp_path / "cjk2.txt"
+    write_text(str(path), CJK)
+    assert path.read_bytes() == CJK.encode("utf-8")
+
+
+def test_roundtrip_cjk_with_default_encoding(tmp_path):
+    path = tmp_path / "cjk3.txt"
+    write_text(str(path), CJK)
+    assert read_text(str(path)) == CJK
+
+
+def test_read_utf8_file_with_default_encoding(tmp_path):
+    path = tmp_path / "external.txt"
+    path.write_bytes(CJK.encode("utf-8"))
+    assert read_text(str(path)) == CJK
+
+
+def test_write_accented_text_produces_utf8_bytes(tmp_path):
+    path = tmp_path / "acc.txt"
+    write_text(str(path), ACCENTED)
+    assert path.read_bytes() == ACCENTED.encode("utf-8")
+
+
+def test_bom_encoding_writes_byte_order_mark(tmp_path):
+    path = tmp_path / "bom.txt"
+    write_text(str(path), "with bom", encoding="utf-8-bom")
+    assert detect_bom(str(path)) == "utf-8"
+
+
+def test_append_cjk_with_default_encoding(tmp_path):
+    path = tmp_path / "app.txt"
+    write_text(str(path), CJK)
+    append_text(str(path), CJK)
+    assert path.read_bytes() == (CJK + CJK).encode("utf-8")
+
+
+def test_encoding_for_maps_default_family_to_utf8():
+    """默认族别名必须固定解析到 UTF-8，而不是交给平台默认值。"""
+    assert encoding_for("default") == "utf-8"
+    assert encoding_for(None) == "utf-8"
+    assert encoding_for("utf8") == "utf-8"
+    assert encoding_for("utf-8") == "utf-8"
+
+
+def test_encoding_for_maps_bom_family_to_utf8_sig():
+    """BOM 族别名必须解析到带 BOM 的 UTF-8 变体，而不是普通 UTF-8。"""
+    assert encoding_for("utf-8-bom") == "utf-8-sig"
+    assert encoding_for("utf-8-sig") == "utf-8-sig"
+
+
+def test_encoding_for_normalises_alias_separators():
+    """别名的大小写与 ``-``/``_``/无分隔符写法必须归一化后识别。"""
+    assert encoding_for("utf8bom") == "utf-8-sig"
+    assert encoding_for("UTF_8_BOM") == "utf-8-sig"
+    assert encoding_for("utf8sig") == "utf-8-sig"
+
+
+def test_write_with_uppercase_bom_alias_emits_bom(tmp_path):
+    path = tmp_path / "upbom.txt"
+    write_text(str(path), "x", encoding="UTF_8_BOM")
+    assert detect_bom(str(path)) == "utf-8"
+
+
+def test_bom_write_bytes_are_exact(tmp_path):
+    path = tmp_path / "exact.txt"
+    write_text(str(path), CJK, encoding="utf-8-bom")
+    assert path.read_bytes() == b"\xef\xbb\xbf" + CJK.encode("utf-8")
+
+
+def test_default_read_of_bom_file_keeps_ufeff(tmp_path):
+    """``utf-8``（默认）读取带 BOM 文件时保留开头的 U+FEFF 字符。"""
+    path = tmp_path / "keep.txt"
+    write_text(str(path), CJK, encoding="utf-8-bom")
+    assert read_text(str(path)) == "\ufeff" + CJK
+
+
+def test_sig_read_strips_bom(tmp_path):
+    """``utf-8-sig`` 读取带 BOM 文件时剥离 BOM。"""
+    path = tmp_path / "strip.txt"
+    write_text(str(path), CJK, encoding="utf-8-bom")
+    assert detect_bom(str(path)) == "utf-8"
+    assert read_text(str(path), encoding="utf-8-sig") == CJK
+
+
+def test_existing_crlf_is_not_doubled(tmp_path):
+    """文本中已有的 CRLF 落盘时必须是单个 CRLF，不得被再次翻译。"""
+    path = tmp_path / "crlf2.txt"
+    write_text(str(path), "one\r\n")
+    assert path.read_bytes() == b"one\r\n"
+
+
+def test_append_existing_crlf_is_not_doubled(tmp_path):
+    """追加文本中已有的 CRLF 同样不得翻倍，读回按行切分正确。"""
+    path = tmp_path / "crlf3.txt"
+    write_text(str(path), "one\r\n")
+    append_text(str(path), "two\r\n")
+    assert read_lines(str(path)) == ["one", "two"]
+
+
+# --- 回归保护（base 与参考解上都必须通过） ----------------------------------
+
+
+def test_ascii_roundtrip_with_default_encoding(tmp_path):
+    path = tmp_path / "ascii.txt"
+    write_text(str(path), "plain ascii")
+    assert read_text(str(path)) == "plain ascii"
+
+
+def test_explicit_utf8_alias_is_honoured(tmp_path):
+    path = tmp_path / "alias.txt"
+    write_text(str(path), "ascii only", encoding="utf8")
+    assert read_text(str(path), encoding="utf8") == "ascii only"
+
+
+def test_thousands_of_characters_stay_intact(tmp_path):
+    path = tmp_path / "long.txt"
+    write_text(str(path), "x" * 5000)
+    assert len(read_text(str(path))) == 5000
+
+
+def test_crlf_newline_policy(tmp_path):
+    path = tmp_path / "nl.txt"
+    write_text(str(path), "a\nb")
+    assert path.read_bytes() == b"a\r\nb"
+
+
+def test_unknown_encoding_is_passed_through(tmp_path):
+    assert encoding_for("latin-1") == "latin-1"
+
+
+def test_system_encoding_is_reported():
+    assert isinstance(system_encoding(), str) and system_encoding()
+
+
+def test_detect_bom_none_for_plain_utf8(tmp_path):
+    path = tmp_path / "nb.txt"
+    path.write_bytes(CJK.encode("utf-8"))
+    assert detect_bom(str(path)) is None
+
+
+def test_write_lines_joins_with_crlf(tmp_path):
+    path = tmp_path / "wl.txt"
+    write_lines(str(path), ["a", "b"])
+    assert path.read_bytes() == b"a\r\nb\r\n"
+
+
+def test_write_lines_empty_list_writes_empty_file(tmp_path):
+    path = tmp_path / "empty.txt"
+    write_lines(str(path), [])
+    assert path.read_bytes() == b""
+    assert read_lines(str(path)) == []
+
+
+def test_read_lines_external_crlf_file(tmp_path):
+    path = tmp_path / "ext.txt"
+    path.write_bytes(b"a\r\nb\r\n")
+    assert read_lines(str(path)) == ["a", "b"]
+
+
+def test_write_lines_cjk_roundtrip(tmp_path):
+    path = tmp_path / "wlcjk.txt"
+    lines = [CJK, ACCENTED]
+    write_lines(str(path), lines)
+    assert read_lines(str(path)) == lines
