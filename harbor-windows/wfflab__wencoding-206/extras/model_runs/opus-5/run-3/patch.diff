diff --git a/wtextio/codec.py b/wtextio/codec.py
index b29ef63..dd1506d 100644
--- a/wtextio/codec.py
+++ b/wtextio/codec.py
@@ -16,11 +16,11 @@ BOM_ENCODING = "utf-8-sig"
 
 #: 编码别名到 ``open()`` 可接受名称的映射。
 ALIASES = {
-    "default": None,
-    "utf8": None,
-    "utf-8": None,
-    "utf-8-bom": "utf-8",
-    "utf-8-sig": "utf-8",
+    "default": "utf-8",
+    "utf8": "utf-8",
+    "utf-8": "utf-8",
+    "utf-8-bom": "utf-8-sig",
+    "utf-8-sig": "utf-8-sig",
     "ansi": "mbcs",
     "latin-1": "latin-1",
     "cp1252": "cp1252",
@@ -32,14 +32,32 @@ def system_encoding():
     return locale.getpreferredencoding(False)
 
 
+def _normalize_encoding_name(name):
+    """归一化编码名：移除分隔符并转小写。"""
+    return name.lower().replace('-', '').replace('_', '')
+
+
 def encoding_for(name):
     """返回写读文件时应当交给 ``open()`` 的编码名。
 
     ``None`` 表示交给 ``open()`` 使用平台默认值。
     """
-    key = (name or "default").lower()
+    if name is None:
+        name = "default"
+    
+    key = name.lower()
+    
+    # 直接查找
     if key in ALIASES:
         return ALIASES[key]
+    
+    # 归一化查找（处理 utf_8_bom, utf8bom 等变体）
+    normalized = _normalize_encoding_name(key)
+    for alias_key, alias_value in ALIASES.items():
+        if _normalize_encoding_name(alias_key) == normalized:
+            return alias_value
+    
+    # 未命中，原样透传
     return name
 
 
diff --git a/wtextio/writer.py b/wtextio/writer.py
index b434479..bf8a79d 100644
--- a/wtextio/writer.py
+++ b/wtextio/writer.py
@@ -3,22 +3,50 @@
 from .codec import encoding_for
 
 
+def _normalize_newlines(text):
+    """归一化换行符：将 CRLF / LF / CR 统一转换为 LF。"""
+    # 先将 CRLF 转为 LF，避免后续处理时重复
+    text = text.replace("\r\n", "\n")
+    # 再将单独的 CR 转为 LF
+    text = text.replace("\r", "\n")
+    return text
+
+
 def write_text(path, text, encoding="default", newline="\r\n"):
     """把 ``text`` 写入 ``path``，返回写入的字符数。"""
-    with open(path, "w", encoding=encoding_for(encoding), newline=newline) as fh:
-        fh.write(text)
+    # 归一化换行符
+    normalized = _normalize_newlines(text)
+    # 替换为目标换行符
+    output = normalized.replace("\n", newline)
+    
+    # 使用 newline="" 禁用 Python 的自动换行转换，我们自己控制
+    with open(path, "w", encoding=encoding_for(encoding), newline="") as fh:
+        fh.write(output)
     return len(text)
 
 
 def append_text(path, text, encoding="default"):
     """在 ``path`` 末尾追加 ``text``，返回追加的字符数。"""
-    with open(path, "a", encoding=encoding_for(encoding), newline="\r\n") as fh:
-        fh.write(text)
+    # 归一化换行符并替换为 CRLF
+    normalized = _normalize_newlines(text)
+    output = normalized.replace("\n", "\r\n")
+    
