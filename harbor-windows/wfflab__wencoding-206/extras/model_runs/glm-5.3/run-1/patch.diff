@@ -16,17 +16,30 @@ BOM_ENCODING = "utf-8-sig"
 
 #: 编码别名到 ``open()`` 可接受名称的映射。
 ALIASES = {
-    "default": None,
-    "utf8": None,
-    "utf-8": None,
-    "utf-8-bom": "utf-8",
-    "utf-8-sig": "utf-8",
+    "default": "utf-8",
+    "utf8": "utf-8",
+    "utf-8": "utf-8",
+    "utf-8-bom": "utf-8-sig",
+    "utf-8-sig": "utf-8-sig",
     "ansi": "mbcs",
     "latin-1": "latin-1",
     "cp1252": "cp1252",
 }
 
 
+def _normalize_alias(name):
+    """把别名归一化：转为小写，并去掉 ``-`` / ``_`` 分隔符。
+
+    这样 ``utf-8-bom``、``utf_8_bom``、``utf8bom``、``UTF_8_BOM`` 都能命中
+    同一个条目。
+    """
+    return name.lower().replace("-", "").replace("_", "")
+
+
+#: 归一化后的别名 -> 目标编码，供 ``encoding_for`` 查表。
+_LOOKUP = {_normalize_alias(alias): target for alias, target in ALIASES.items()}
+
+
 def system_encoding():
     """返回当前平台的系统默认文本编码。"""
     return locale.getpreferredencoding(False)
