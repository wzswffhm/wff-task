diff --git a/wtextio/reader.py b/wtextio/reader.py
index 0524d8d..a0a6b7f 100644
--- a/wtextio/reader.py
+++ b/wtextio/reader.py
@@ -1,10 +1,19 @@
-"""从文件读回文本。"""
+"""从文件读回文本。
+
+读取用的默认编码与写入完全一致（UTF-8，见 :mod:`wtextio.codec`），所以同一份
+文件在写它的那台机器和读它的那台机器上解出来的内容一样，不会因为读侧落到系统
+ANSI 代码页而变成乱码。
+"""
 
 from .codec import encoding_for
 
 
 def read_text(path, encoding="default"):
-    """读回整个文件。"""
+    """读回整个文件。
+
+    ``encoding`` 默认解析成 UTF-8；文件内容原样返回，不做换行翻译，因此写进去
+    的 CRLF 读出来还是 CRLF。需要剥掉字节序标记时用 ``encoding="utf-8-bom"``。
+    """
     with open(path, "r", encoding=encoding_for(encoding), newline="") as fh:
         return fh.read()
 
diff --git a/wtextio/writer.py b/wtextio/writer.py
index b434479..2bef2d0 100644
--- a/wtextio/writer.py
+++ b/wtextio/writer.py
@@ -1,19 +1,34 @@
-"""把文本写入文件。"""
+"""把文本写入文件。
+
+编码由 :mod:`wtextio.codec` 决定（默认 UTF-8，与平台无关），换行同样统一：
+落盘的换行固定是 CRLF，不会因为是 Windows 就多出一个 CR。
+"""
 
 from .codec import encoding_for
 
 
+def _collapse_crlf(text):
+    """把文本里已有的 CRLF 折叠成 LF，再交给 ``open()`` 展开。
+
+    ``open(..., newline="\\r\\n")`` 只把 ``\\n`` 翻译成 ``\\r\\n``；如果文本本身
+    已经带着 CRLF（例如 ``write_lines`` 拼出来的内容，或调用方从别处读来的
+    Windows 文本），直接写下去就变成 CR CR LF。先折叠再展开，落盘的换行才恰好
+    是一个 CRLF。
+    """
+    return text.replace("\r\n", "\n")
+
+
 def write_text(path, text, encoding="default", newline="\r\n"):
     """把 ``text`` 写入 ``path``，返回写入的字符数。"""
     with open(path, "w", encoding=encoding_for(encoding), newline=newline) as fh:
-        fh.write(text)
+        fh.write(_collapse_crlf(text))
     return len(text)
 
 
 def append_text(path, text, encoding="default"):
     """在 ``path`` 末尾追加 ``text``，返回追加的字符数。"""
     with open(path, "a", encoding=encoding_for(encoding), newline="\r\n") as fh:
-        fh.write(text)
+        fh.write(_collapse_crlf(text))
     return len(text)
 
 
