+    调用方显式要求不翻译时（``newline`` 为 ``""`` 或 ``"\\n"``）原样写入，
+    不动文本里的任何字符。
+    """
+    if newline in _NO_TRANSLATION:
+        return text
+    return text.replace("\r\n", "\n")
