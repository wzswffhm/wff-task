diff --git a/wtextio/codec.py b/wtextio/codec.py
index b29ef63..5eaee55 100644
--- a/wtextio/codec.py
+++ b/wtextio/codec.py
@@ -4,9 +4,13 @@
 是当前 ANSI 代码页（英文系统上通常是 cp1252），而 Linux 上是 UTF-8；
 同一个程序在两个平台上按默认值写文件，落盘的字节并不一样。
 所以对需要跨平台交换的文本，必须显式选定编码。
+
+本库的默认编码固定为 UTF-8，不随平台变化；需要字节序标记时使用
+带 BOM 的 UTF-8 变体（``utf-8-sig``）。
 """
 
 import locale
+import re
 
 #: 本库在「默认」情形下应当使用的编码。
 DEFAULT_ENCODING = "utf-8"
@@ -15,17 +19,46 @@ DEFAULT_ENCODING = "utf-8"
 BOM_ENCODING = "utf-8-sig"
 
 #: 编码别名到 ``open()`` 可接受名称的映射。
+#:
