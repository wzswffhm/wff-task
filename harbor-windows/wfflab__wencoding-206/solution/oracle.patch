 def encoding_for(name):
     """返回写读文件时应当交给 ``open()`` 的编码名。
 
-    ``None`` 表示交给 ``open()`` 使用平台默认值。
+    默认值随平台变化的做法会让同一份输入在两个平台上落成不同的字节，
+    因此默认族别名固定返回 UTF-8；BOM 族别名固定返回带 BOM 的变体；
+    其余别名先做分隔符归一化再查表，都未命中时原样透传。
     """
     key = (name or "default").lower()
+    compact = key.replace("_", "").replace("-", "").replace(" ", "")
+    if compact in _COMPACT_ALIASES:
+        return _COMPACT_ALIASES[compact]
     if key in ALIASES:
         return ALIASES[key]
     return name
