  14| def _build_table():
  15|     table = []
  16|     for index in range(256):
  17|         crc = index
  18|         for _ in range(8):
  19|             crc = (crc >> 1) ^ (_POLY if crc & 1 else 0)
  20|         table.append(crc)
  21|     return table
  22| 
  23| 
  24| _TABLE = _build_table()
  25| 
  26| 
  27| def compute_crc(data):
  28|     """返回 ``data`` 的 32 位校验和。"""
  29|     crc = 0xFFFFFFFF
  30|     for byte in data:
  31|         crc = (crc >> 8) ^ _TABLE[(crc ^ byte) & 0xFF]
  32|     return crc & 0xFFFFFFFF
  33| 
  34| 
  35| def pack_crc(value):
