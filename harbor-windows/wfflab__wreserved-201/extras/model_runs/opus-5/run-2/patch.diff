diff --git a/wsafename/rules.py b/wsafename/rules.py
index c480514..fed7a51 100644
--- a/wsafename/rules.py
+++ b/wsafename/rules.py
@@ -27,8 +27,24 @@ def has_illegal_chars(name):
 
 
 def is_reserved(name):
-    """``name`` 是否是 Windows 保留设备名。"""
-    return name.strip().upper() in RESERVED_BASE_NAMES
+    """``name`` 是否是 Windows 保留设备名。
+    
+    Windows 只检查第一个点之前的基名，所以 CON、CON.txt、CON.tar.gz
+    都被视为保留设备名 CON。
+    """
+    # 先去掉首尾空白
+    cleaned = name.strip()
+    if not cleaned:
+        return False
+    
+    # 提取第一个点之前的部分作为基名
+    base_name = cleaned.split('.')[0]
+    
+    # 再次去掉基名的首尾空白（虽然通常不会有）
+    base_name = base_name.strip()
+    
+    # 转大写后检查是否在保留名称集合中
+    return base_name.upper() in RESERVED_BASE_NAMES
 
 
 def is_valid(name):
@@ -39,4 +55,15 @@ def is_valid(name):
         return False
     if has_illegal_chars(name):
         return False
-    return not is_reserved(name)
+    if is_reserved(name):
+        return False
+    
+    # 检查是否有尾部点或空格（Windows 会静默丢弃它们，导致不确定性）
+    if name.rstrip(TRAILING_CHARS) != name:
+        return False
+    
+    # 确保去掉尾部字符后不会变成空名称
+    if not name.rstrip(TRAILING_CHARS):
+        return False
+    
+    return True
