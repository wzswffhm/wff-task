 def is_reserved(name):
-    """``name`` 是否是 Windows 保留设备名。"""
-    return name.strip().upper() in RESERVED_BASE_NAMES
+    """``name`` 是否是 Windows 保留设备名。
+    
+    按 Win32 规则，只检查第一个点之前的部分（base name）。
+    例如：CON、CON.txt、con.tar.gz 都是保留名，
+    但 console.txt、mycon、com10.log 不是。
+    """
+    # 先去除首尾空白和尾部的点与空格
+    cleaned = name.strip().rstrip(TRAILING_CHARS)
+    if not cleaned:
+        return False
+    
+    # 提取第一个点之前的部分作为 base name
+    base_name = cleaned.split('.')[0].upper()
+    
+    return base_name in RESERVED_BASE_NAMES
 
 
