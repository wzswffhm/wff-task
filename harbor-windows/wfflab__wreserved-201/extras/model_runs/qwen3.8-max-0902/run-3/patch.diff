diff --git a/wsafename/rules.py b/wsafename/rules.py
index c480514..fc2a5c3 100644
--- a/wsafename/rules.py
+++ b/wsafename/rules.py
@@ -26,9 +26,33 @@ def has_illegal_chars(name):
     return any(ch in ILLEGAL_CHARS for ch in name)
 
 
+def has_trailing_chars(name):
+    """``name`` 是否以 Windows 会静默丢弃的字符（点或空格）结尾。
+
+    这类名称落盘时会变成另一个名字（``report.`` -> ``report``），
+    因此不能直接交给文件系统使用。
+    """
+    return bool(name) and name[-1] in TRAILING_CHARS
+
+
+def device_base_name(name):
+    """返回 Win32 判定保留设备名时实际比较的那一段。
+
+    Win32 只看**第一个点之前**的基名（并忽略其首尾空白），后面的扩展名
+    一概不参与判定，所以 ``CON``、``CON.txt``、``con.tar.gz`` 的基名都是
+    ``CON``；而 ``console.txt`` 的基名是 ``console``，``com10.log`` 的基名
+    是 ``com10``，两者都不是保留名。
+    """
+    return name.split(".", 1)[0].strip()
+
+
 def is_reserved(name):
-    """``name`` 是否是 Windows 保留设备名。"""
-    return name.strip().upper() in RESERVED_BASE_NAMES
+    """``name`` 是否是 Windows 保留设备名。
+
+    判定规则与 Win32 一致：取第一个点之前的那一段，忽略大小写后与
+    :data:`RESERVED_BASE_NAMES` 比较。
+    """
+    return device_base_name(name).upper() in RESERVED_BASE_NAMES
 
 
 def is_valid(name):
@@ -39,4 +63,6 @@ def is_valid(name):
         return False
     if has_illegal_chars(name):
         return False
+    if has_trailing_chars(name):
+        return False
     return not is_reserved(name)
