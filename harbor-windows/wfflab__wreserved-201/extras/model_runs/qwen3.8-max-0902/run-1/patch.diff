--- a/wsafename/__init__.py
+++ b/wsafename/__init__.py
@@ -2,6 +2,9 @@
 
 上传服务收到用户提交的名称后，先用 :func:`~wsafename.sanitize.sanitize`
 把它转换成安全名称，再通过 :class:`~wsafename.store.FileStore` 落盘。
+
+不可用的名称（保留设备名、净化后什么都不剩的名称）会在净化阶段就抛
+:class:`InvalidNameError`，不会把底层 ``OSError`` 透传给调用方。
 """
 
 from .errors import (
@@ -14,9 +17,12 @@ from .rules import (
     ILLEGAL_CHARS,
     MAX_SEGMENT_LENGTH,
     RESERVED_BASE_NAMES,
+    TRAILING_CHARS,
     has_illegal_chars,
     is_reserved,
     is_valid,
+    reserved_stem,
+    strip_trailing,
 )
 from .sanitize import REPLACEMENT, sanitize
 from .store import FileStore
@@ -32,9 +38,12 @@ __all__ = [
     "NameTooLongError",
     "REPLACEMENT",
     "RESERVED_BASE_NAMES",
+    "TRAILING_CHARS",
     "WSafeNameError",
     "has_illegal_chars",
     "is_reserved",
     "is_valid",
+    "reserved_stem",
     "sanitize",
+    "strip_trailing",
 ]
