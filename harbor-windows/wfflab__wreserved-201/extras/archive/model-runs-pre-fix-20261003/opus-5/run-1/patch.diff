 def is_reserved(name):
-    """``name`` 是否是 Windows 保留设备名。"""
-    return name.strip().upper() in RESERVED_BASE_NAMES
+    """``name`` 是否是 Windows 保留设备名。
+    
+    Windows 只检查第一个点之前的基名，且不区分大小写。
+    例如：CON、CON.txt、con.tar.gz 都是保留名称，
+    但 console.txt、mycon、com10.log 不是。
+    """
+    stripped = name.strip()
+    if not stripped:
+        return False
+    
+    # 取第一个点之前的部分作为基名
+    base_name = stripped.split('.')[0]
+    return base_name.upper() in RESERVED_BASE_NAMES
 
 
