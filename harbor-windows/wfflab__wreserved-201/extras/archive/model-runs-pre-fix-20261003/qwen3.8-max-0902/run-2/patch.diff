diff --git a/wsafename/rules.py b/wsafename/rules.py
index c480514..4e2996c 100644
--- a/wsafename/rules.py
+++ b/wsafename/rules.py
@@ -26,9 +26,29 @@ def has_illegal_chars(name):
     return any(ch in ILLEGAL_CHARS for ch in name)
 
 
+def device_base_name(name):
+    """返回 Win32 判定保留设备名时真正比对的那一段。
+
+    Win32 只取**第一个点之前**的部分，并忽略其首尾空白与大小写：
+    ``CON``、``CON.txt``、``con.tar.gz`` 都会归一到 ``CON``，而
+    ``console.txt``、``mycon``、``com10.log`` 归一后不在保留名集合里。
+    """
+    if not name:
+        return ""
+    return name.split(".", 1)[0].strip().upper()
+
+
 def is_reserved(name):
     """``name`` 是否是 Windows 保留设备名。"""
-    return name.strip().upper() in RESERVED_BASE_NAMES
+    return device_base_name(name) in RESERVED_BASE_NAMES
+
+
+def has_trailing_junk(name):
+    """``name`` 是否以 Windows 会静默丢弃的点或空格结尾。
+
+    这类名称在磁盘上落到的是去掉尾部之后的条目，因此不能直接使用。
+    """
+    return bool(name) and name != name.rstrip(TRAILING_CHARS)
 
 
 def is_valid(name):
@@ -39,4 +59,6 @@ def is_valid(name):
         return False
     if has_illegal_chars(name):
         return False
+    if has_trailing_junk(name):
+        return False
     return not is_reserved(name)
diff --git a/wsafename/sanitize.py b/wsafename/sanitize.py
index 400d136..c23836f 100644
--- a/wsafename/sanitize.py
+++ b/wsafename/sanitize.py
@@ -1,7 +1,13 @@
 """把用户提供的名称转换成可以安全落盘的名称。"""
 
 from .errors import InvalidNameError
-from .rules import ILLEGAL_CHARS, MAX_SEGMENT_LENGTH
+from .rules import (
+    ILLEGAL_CHARS,
+    MAX_SEGMENT_LENGTH,
+    TRAILING_CHARS,
+    device_base_name,
+    is_reserved,
+)
 
 #: 替换非法字符时使用的字符。
 REPLACEMENT = "_"
@@ -14,23 +20,37 @@ def sanitize(name, replacement=REPLACEMENT):
 
     1. 去掉首尾空白
     2. 把非法字符替换为 ``replacement``
-    3. 截断到 :data:`wsafename.rules.MAX_SEGMENT_LENGTH`
+    3. 去掉 Windows 会静默丢弃的尾部点与空格
+    4. 截断到 :data:`wsafename.rules.MAX_SEGMENT_LENGTH`（截断后可能又出现
+       新的尾部点或空格，因此再清理一次）
 
-    返回净化后的名称。``name`` 不是字符串时抛 ``TypeError``；
-    净化结果不可用时抛 :class:`InvalidNameError`。
+    返回净化后的名称。净化结果是确定的：``report.`` 与 ``report`` 得到
+    同一个落盘名，对应同一个磁盘条目。
+
+    ``name`` 不是字符串时抛 ``TypeError``；净化后不再剩下可用字符，或
+    净化结果是 Win32 保留设备名（``CON``、``CON.txt``、``lpt1.tar.gz``
+    等，只看第一个点之前那一段）时抛 :class:`InvalidNameError`，不会把
+    底层 :class:`OSError` 透传给调用方。
     """
     if not isinstance(name, str):
         raise TypeError("name must be str, got %s" % type(name).__name__)
 
     cleaned = name.strip()
 
-    out = [replacement if ch in ILLEGAL_CHARS else ch for ch in cleaned]
-    cleaned = "".join(out)
+    cleaned = "".join(replacement if ch in ILLEGAL_CHARS else ch for ch in cleaned)
+
+    cleaned = cleaned.rstrip(TRAILING_CHARS)
 
     if len(cleaned) > MAX_SEGMENT_LENGTH:
-        cleaned = cleaned[:MAX_SEGMENT_LENGTH]
+        cleaned = cleaned[:MAX_SEGMENT_LENGTH].rstrip(TRAILING_CHARS)
 
     if not cleaned:
         raise InvalidNameError("name is empty after sanitizing: %r" % (name,))
 
+    if is_reserved(cleaned):
+        raise InvalidNameError(
+            "%r sanitizes to the reserved device name %r"
+            % (name, device_base_name(cleaned))
+        )
+
     return cleaned
