diff --git a/wsafename/rules.py b/wsafename/rules.py
index c480514..0482cb9 100644
--- a/wsafename/rules.py
+++ b/wsafename/rules.py
@@ -26,9 +26,24 @@ def has_illegal_chars(name):
     return any(ch in ILLEGAL_CHARS for ch in name)
 
 
+def base_of(name):
+    """返回设备名判定所依据的基名。
+
+    Win32 只用**第一个点之前**的那一段来匹配保留设备名，因此
+    ``CON``、``CON.txt`` 与 ``con.tar.gz`` 都是保留名，而 ``my.con``
+    与 ``console.txt`` 都不是。
+    """
+    return name.strip().split(".", 1)[0]
+
+
+def strip_trailing(name):
+    """去掉 Windows 会在交给底层 API 前静默丢弃的尾部点与空格。"""
+    return name.strip().rstrip(TRAILING_CHARS)
+
+
 def is_reserved(name):
     """``name`` 是否是 Windows 保留设备名。"""
-    return name.strip().upper() in RESERVED_BASE_NAMES
+    return base_of(name).upper() in RESERVED_BASE_NAMES
 
 
 def is_valid(name):
@@ -39,4 +54,6 @@ def is_valid(name):
         return False
     if has_illegal_chars(name):
         return False
+    if not strip_trailing(name):
+        return False
     return not is_reserved(name)
