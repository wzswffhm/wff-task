diff --git a/wvas/_paths.py b/wvas/_paths.py
new file mode 100644
index 0000000..375c6a0
--- /dev/null
+++ b/wvas/_paths.py
@@ -0,0 +1,247 @@
+"""Turn the kernel's own names for files into paths the caller can open.
+
+Everything the address space APIs hand back about a file is a *device* path:
+``GetMappedFileNameW`` reports ``\\Device\\HarddiskVolume3\\dir\\thing.dll`` and
+``GetModuleFileNameExW`` may report ``\\Device\\Mup\\server\\share\\thing.dll``.
+Neither can be pasted into a ticket, opened from Explorer or handed to
+:func:`open`, so this module translates them into a DOS drive path
+(``C:\\dir\\thing.dll``) or a UNC path (``\\\\server\\share\\thing.dll``).
+
+When no translation exists -- the volume is not mounted under a drive letter,
