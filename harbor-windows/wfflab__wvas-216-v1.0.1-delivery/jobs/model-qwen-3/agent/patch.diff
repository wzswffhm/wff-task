+    while address <= highest:
+        if not _query_region(handle, address, mbi):
+            break
+        base = mbi.BaseAddress
+        size = int(mbi.RegionSize or 0)
+        if base is None or not size:
+            break
+        base = int(base)
+        committed = mbi.State == w.MEM_COMMIT
+        if committed or include_reserved:
+            found.append({
+                "base": base,
+                "size": size,
+                "state": "commit" if committed else "reserve",
+                "type": type_name(mbi.Type),
+                "protect": _region_protect(mbi),
+                "path": _region_path(handle, mbi),
+                "image": bool(committed and mbi.Type == w.MEM_IMAGE),
+            })
+        address = base + size
+        if address <= base:
+            break
+    return found
+
+
+def _scan_image_allocations(handle):
+    """``allocation base -> {"size": ..., "path": ...}`` for every image.
+
+    Measured from the address space itself, so an image is found even when the
+    process manager will not enumerate it (a cross bitness target, for one).
+    """
+    images = {}
+    lowest, highest = _address_space_bounds(handle)
+    mbi = w.MEMORY_BASIC_INFORMATION()
+    address = lowest
+    while address <= highest:
+        if not _query_region(handle, address, mbi):
+            break
+        base = mbi.BaseAddress
+        size = int(mbi.RegionSize or 0)
+        if base is None or not size:
+            break
+        base = int(base)
+        if mbi.State == w.MEM_COMMIT and mbi.Type == w.MEM_IMAGE:
+            allocation = mbi.AllocationBase or base
+            record = images.setdefault(
+                int(allocation), {"size": 0, "path": None}
+            )
+            record["size"] += size
+            if record["path"] is None:
+                record["path"] = mapped_file_name(handle, base)
+        address = base + size
+        if address <= base:
+            break
+    return images
+
+
+# ---------------------------------------------------------------------------
+# loaded images
+# ---------------------------------------------------------------------------
+
+def _enum_module_handles(handle):
+    """The image handles the process manager will name for this process."""
+    if w.EnumProcessModulesEx is not None:
+        def enumerate_into(buffer):
+            required = wt.DWORD(0)
+            ok = w.EnumProcessModulesEx(
+                handle, buffer, ctypes.sizeof(buffer), ctypes.byref(required),
+                w.LIST_MODULES_ALL,
+            )
+            return ok, required.value, w.last_error()
+    elif w.EnumProcessModules is not None:
+        def enumerate_into(buffer):
+            required = wt.DWORD(0)
+            ok = w.EnumProcessModules(
+                handle, buffer, ctypes.sizeof(buffer), ctypes.byref(required)
+            )
+            return ok, required.value, w.last_error()
+    else:
+        return None
+
+    buffer = (wt.HMODULE * 256)()
+    ok, needed, error = enumerate_into(buffer)
+    if not ok and error not in (w.ERROR_BAD_LENGTH, w.ERROR_INSUFFICIENT_BUFFER):
+        return None
+    count = needed // ctypes.sizeof(wt.HMODULE)
+    if count > len(buffer):
+        buffer = (wt.HMODULE * (count + 32))()
+        ok, needed, _error = enumerate_into(buffer)
+        count = needed // ctypes.sizeof(wt.HMODULE)
+
+    handles = []
+    for index in range(min(count, len(buffer))):
+        if buffer[index]:
+            handles.append(buffer[index])
+    return handles
+
+
+def _module_info(handle, module):
+    """``(base, size of image, openable path)`` for one module handle."""
+    base = None
+    size = 0
+    if w.GetModuleInformation is not None:
+        info = w.MODULEINFO()
+        if w.GetModuleInformation(
+                handle, module, ctypes.byref(info), ctypes.sizeof(info)):
+            if info.lpBaseOfDll is not None:
+                base = int(info.lpBaseOfDll)
+            size = int(info.SizeOfImage or 0)
+    if base is None:
+        base = int(module or 0) or None
+    path = None
+    if w.GetModuleFileNameExW is not None:
+        buffer = ctypes.create_unicode_buffer(PATH_BUFFER_CHARS)
+        written = w.GetModuleFileNameExW(handle, module, buffer, PATH_BUFFER_CHARS)
+        if written:
+            path = to_openable_path(buffer.value)
+    return base, size, path
+
+
+def _module_table(handle):
+    """``image base -> {"size": ..., "path": ...}``, one entry per image."""
+    handles = _enum_module_handles(handle)
+    if not handles:
+        return {}
+    table = {}
+    for module in handles:
+        base, size, path = _module_info(handle, module)
+        if base is None:
+            continue
+        entry = table.get(base)
+        if entry is None:
+            table[base] = {"size": size, "path": path}
+            continue
+        if not entry["size"]:
+            entry["size"] = size
+        if path and not entry["path"]:
+            entry["path"] = path
+    return table
+
+
+def _image_size_from_regions(handle, base):
+    """Size of an image, measured from the address space walk."""
+    mbi = w.MEMORY_BASIC_INFORMATION()
+    if not _query_region(handle, base, mbi):
+        return 0
+    allocation = int(mbi.AllocationBase or base)
+    if allocation != int(base):
+        return int(mbi.RegionSize or 0)
+    total = int(mbi.RegionSize or 0)
+    address = base + total
+    while True:
+        if not _query_region(handle, address, mbi):
+            break
+        if mbi.State != w.MEM_COMMIT or mbi.Type != w.MEM_IMAGE:
+            break
+        if int(mbi.AllocationBase or 0) != allocation:
+            break
+        size = int(mbi.RegionSize or 0)
+        if not size:
+            break
+        total += size
+        address = int(mbi.BaseAddress or 0) + size
+        if address <= base:
+            break
+    return total
+
+
+def _collect_modules(handle, pid):
+    """Every loaded image of the process, exactly once, ascending by base."""
+    table = _module_table(handle)
+    scanned = _scan_image_allocations(handle)
+    main_image = process_image_name(handle)
+
+    collected = {}
+    for base, record in scanned.items():
+        entry = table.get(base)
+        path = None
+        size = 0
+        if entry:
+            path = entry.get("path")
+            size = entry.get("size") or 0
+        if not path:
+            path = record.get("path")
+        if not size:
+            size = record.get("size") or 0
+        collected[base] = {"path": path, "size": size}
+    for base, entry in table.items():
+        if base in collected:
+            continue
+        collected[base] = {"path": entry.get("path"), "size": entry.get("size") or 0}
+
+    if not collected:
+        _fail("cannot list the loaded images", pid)
+
+    lowest = min(collected) if collected else None
+    result = []
+    for base in sorted(collected):
+        entry = collected[base]
+        path = entry.get("path")
+        if path is None and main_image and base == lowest:
+            # The process manager named no file for this image. The lowest
+            # image of a process is its executable, which the system can still
+            # name for us; better an exact answer for that one than nothing.
+            path = main_image
+        size = entry.get("size") or 0
+        if not size:
+            size = _image_size_from_regions(handle, base)
+        result.append({"path": path, "base": int(base), "size": int(size)})
+    return result
+
