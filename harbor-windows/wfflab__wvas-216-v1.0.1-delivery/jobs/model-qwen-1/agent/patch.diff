@@ -0,0 +1,54 @@
+"""Experiment: probe availability of the Win32 helpers we plan to use."""
+import ctypes
+import ctypes.wintypes as wt
+import os
+
+kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+psapi = ctypes.WinDLL("psapi", use_last_error=True)
+
+for name in [
+    "VirtualQueryEx", "OpenProcess", "GetMappedFileNameW", "CreateFileMappingW",
+    "K32GetMappedFileNameW", "K32QueryWorkingSetEx", "QueryWorkingSetEx",
+    "GetProcessInformation", "QueryFullProcessImageNameW", "GetProcessMemoryInfo",
+    "K32GetProcessMemoryInfo", "EnumProcessModulesEx", "K32EnumProcessModulesEx",
+    "GetModuleFileNameExW", "K32GetModuleFileNameExW", "Wow64GetProcessInformation",
+    "GetFinalPathNameByHandleW", "CreateFileW",
+]:
+    found = None
+    for libname, lib in (("kernel32", kernel32), ("psapi", psapi)):
+        try:
+            getattr(lib, name)
+            found = libname
+            break
+        except AttributeError:
+            pass
+    print("%-34s %s" % (name, found or "MISSING"))
+
+src = r"C:\Windows\System32\kernel32.dll"
+GENERIC_READ = 0x80000000
+FILE_SHARE_READ = 1
+OPEN_EXISTING = 3
+PAGE_READONLY = 0x02
+kernel32.CreateFileW.restype = wt.HANDLE
+h = kernel32.CreateFileW(src, GENERIC_READ, FILE_SHARE_READ, None, OPEN_EXISTING, 0, None)
+print("CreateFileW handle", h, ctypes.get_last_error())
+mapname = "wvas_exp_mapping_%d" % os.getpid()
+kernel32.CreateFileMappingW.restype = wt.HANDLE
+hm = kernel32.CreateFileMappingW(wt.HANDLE(h), None, PAGE_READONLY, wt.DWORD(0), wt.DWORD(0), wt.LPCWSTR(mapname))
+print("CreateFileMappingW handle", hm, ctypes.get_last_error())
+kernel32.GetMappedFileNameW.restype = wt.DWORD
+kernel32.GetMappedFileNameW.argtypes = [wt.HANDLE, wt.LPVOID, wt.LPWSTR, wt.DWORD]
+buf = ctypes.create_unicode_buffer(260)
+n = kernel32.GetMappedFileNameW(wt.HANDLE(hm), None, buf, 260)
+print("GetMappedFileNameW(section handle)", n, repr(buf.value), ctypes.get_last_error())
+n = kernel32.GetMappedFileNameW(wt.HANDLE(-1), None, buf, 260)
+print("GetMappedFileNameW(-1)", n, repr(buf.value), ctypes.get_last_error())
+kernel32.CloseHandle(hm)
+kernel32.CloseHandle(h)
+
+h2 = kernel32.CreateFileMappingW(wt.HANDLE(-1), None, PAGE_READONLY, wt.DWORD(0), wt.DWORD(0x1000), None)
+print("anon mapping handle", h2, ctypes.get_last_error())
+buf2 = ctypes.create_unicode_buffer(260)
+n = kernel32.GetMappedFileNameW(wt.HANDLE(h2), None, buf2, 260)
+print("GetMappedFileNameW(anon)", n, repr(buf2.value), ctypes.get_last_error())
+kernel32.CloseHandle(h2)
