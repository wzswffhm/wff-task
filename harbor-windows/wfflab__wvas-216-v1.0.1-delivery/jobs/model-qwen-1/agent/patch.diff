+    info = MODULEINFO()
+    psapi.GetModuleInformation(h, mods[i], ctypes.byref(info), ctypes.sizeof(info))
+    modmap[info.lpBaseOfDll or (mods[i] or 0)] = buf.value
+print("modules:", len(modmap))
+
+mbi = MBI()
+addr = 0
+alloc_bases = {}
+image_region_count = 0
+unmatched = []
+while addr < 0x7FFFFFFEFFFF:
+    r = kernel32.VirtualQueryEx(h, wt.LPCVOID(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not r:
+        break
+    if mbi.State == 0x1000 and mbi.Type == 0x1000000:
+        image_region_count += 1
+        ab = mbi.AllocationBase or 0
+        alloc_bases.setdefault(ab, 0)
+        alloc_bases[ab] += 1
+        if ab not in modmap:
+            nb = ctypes.create_unicode_buffer(2048)
+            psapi.GetMappedFileNameW(h, wt.LPVOID(mbi.BaseAddress), nb, 2048)
+            unmatched.append((mbi.BaseAddress, ab, nb.value))
+    nxt = (mbi.BaseAddress or 0) + mbi.RegionSize
+    if nxt <= addr:
+        break
+    addr = nxt
+
+print("image regions:", image_region_count, "distinct allocation bases:", len(alloc_bases))
+print("module bases not seen as image allocation bases:",
+      [hex(b) for b in modmap if b not in alloc_bases])
+print("allocation bases not in module map:", len(unmatched))
+for base, ab, name in unmatched:
+    print("   region %016x allocbase %016x %r" % (base, ab, name))
+print("max regions per module:", max(alloc_bases.values()) if alloc_bases else 0)
