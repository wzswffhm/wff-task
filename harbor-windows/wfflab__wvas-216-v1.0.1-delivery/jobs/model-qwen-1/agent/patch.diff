+++ b/_exp3.py
@@ -0,0 +1,77 @@
+import ctypes
+import ctypes.wintypes as wt
+import os
+
+kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+psapi = ctypes.WinDLL("psapi", use_last_error=True)
+
+kernel32.CreateFileW.restype = wt.HANDLE
+kernel32.CreateFileMappingW.restype = wt.HANDLE
+kernel32.MapViewOfFile.restype = wt.LPVOID
+kernel32.VirtualAlloc.restype = wt.LPVOID
+psapi.GetMappedFileNameW.restype = wt.DWORD
+psapi.GetMappedFileNameW.argtypes = [wt.HANDLE, wt.LPVOID, wt.LPWSTR, wt.DWORD]
+
+src = r"C:\Windows\System32\kernel32.dll"
+GENERIC_READ = 0x80000000
+FILE_SHARE_READ = 1
+OPEN_EXISTING = 3
+PAGE_READONLY = 0x02
+FILE_MAP_READ = 4
+h = kernel32.CreateFileW(src, GENERIC_READ, FILE_SHARE_READ, None, OPEN_EXISTING, 0, None)
+hm = kernel32.CreateFileMappingW(wt.HANDLE(h), None, PAGE_READONLY, wt.DWORD(0), wt.DWORD(0), None)
+view = kernel32.MapViewOfFile(wt.HANDLE(hm), FILE_MAP_READ, wt.DWORD(0), wt.DWORD(0), ctypes.c_size_t(0))
+print("view", hex(view), ctypes.get_last_error())
+buf = ctypes.create_unicode_buffer(1024)
+n = psapi.GetMappedFileNameW(wt.HANDLE(-1), wt.LPVOID(view), buf, 1024)
+print("mapped view name ->", n, repr(buf.value), ctypes.get_last_error())
+
+# anonymous mapping
+h2 = kernel32.CreateFileMappingW(wt.HANDLE(-1), None, 0x04, wt.DWORD(0), wt.DWORD(0x10000), None)
+view2 = kernel32.MapViewOfFile(wt.HANDLE(h2), 0x0004, wt.DWORD(0), wt.DWORD(0), ctypes.c_size_t(0))
+print("anon view", hex(view2), ctypes.get_last_error())
+buf = ctypes.create_unicode_buffer(1024)
+n = psapi.GetMappedFileNameW(wt.HANDLE(-1), wt.LPVOID(view2), buf, 1024)
+print("anon view name ->", n, repr(buf.value), ctypes.get_last_error())
+
+# 6 GiB reservation
+SIXGB = 6 * 1024 * 1024 * 1024
+res = kernel32.VirtualAlloc(None, ctypes.c_size_t(SIXGB), 0x2000, 0x01)
+print("reserve", hex(res) if res else None, ctypes.get_last_error())
+
+# walk own address space and print the interesting bits
+class MBI(ctypes.Structure):
+    _fields_ = [
+        ("BaseAddress", ctypes.c_uint64),
+        ("AllocationBase", ctypes.c_uint64),
+        ("AllocationProtect", wt.DWORD),
+        ("PartitionId", wt.WORD),
+        ("RegionSize", ctypes.c_uint64),
+        ("State", wt.DWORD),
+        ("Protect", wt.DWORD),
+        ("Type", wt.DWORD),
+    ]
+print("sizeof MBI", ctypes.sizeof(MBI()))
+kernel32.VirtualQueryEx.argtypes = [wt.HANDLE, wt.LPCVOID, ctypes.POINTER(MBI), ctypes.c_size_t]
+kernel32.VirtualQueryEx.restype = ctypes.c_size_t
+
+mbi = MBI()
+addr = 0
+count = 0
+interesting = []
+LIMIT = 0x7FFFFFFF0000
+while addr < LIMIT:
+    r = kernel32.VirtualQueryEx(wt.HANDLE(-1), wt.LPCVOID(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not r:
+        print("query failed at", hex(addr), ctypes.get_last_error())
+        break
+    if mbi.State != 0x10000:
+        interesting.append((mbi.BaseAddress, mbi.RegionSize, mbi.State, mbi.Type))
+    nxt = mbi.BaseAddress + mbi.RegionSize
+    if nxt <= addr:
+        break
+    addr = nxt
+    count += 1
+print("total queries", count, "non-free regions", len(interesting))
+for base, size, state, typ in interesting:
+    print(hex(base), size, hex(size), "state=%x" % state, "type=%x" % typ)
diff --git a/_exp4.py b/_exp4.py
new file mode 100644
index 0000000..61ee76a
--- /dev/null
+++ b/_exp4.py
@@ -0,0 +1,130 @@
+import ctypes
+import ctypes.wintypes as wt
+import os
+import tempfile
+
+kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+psapi = ctypes.WinDLL("psapi", use_last_error=True)
+
+kernel32.CreateFileW.restype = wt.HANDLE
+kernel32.CreateFileMappingW.restype = wt.HANDLE
+kernel32.MapViewOfFile.restype = wt.LPVOID
+kernel32.GetFinalPathNameByHandleW.restype = wt.DWORD
+kernel32.GetFinalPathNameByHandleW.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD, wt.DWORD]
+psapi.GetMappedFileNameW.restype = wt.DWORD
+psapi.GetMappedFileNameW.argtypes = [wt.HANDLE, wt.LPVOID, wt.LPWSTR, wt.DWORD]
+kernel32.QueryDosDeviceW.restype = wt.DWORD
+kernel32.QueryDosDeviceW.argtypes = [wt.LPCWSTR, wt.LPWSTR, wt.DWORD]
+
+# multi-sz of all dos devices
+SIZE = 1 << 16
+wbuf = (ctypes.c_wchar * SIZE)()
+n = kernel32.QueryDosDeviceW(None, wbuf, SIZE)
+print("QueryDosDeviceW ->", n, ctypes.get_last_error())
+data = ctypes.wstring_at(wbuf, n)
+entries = [e for e in data.split("\x00") if e]
+print("devices:", entries)
+table = []
+for letter in entries:
+    tgt = ctypes.create_unicode_buffer(1024)
+    kernel32.QueryDosDeviceW(letter, tgt, 1024)
+    print("  ", letter, "->", tgt.value)
+    if tgt.value:
+        table.append((tgt.value.lower(), letter))
+table.sort(key=lambda kv: -len(kv[0]))
+
+
+def convert(p):
+    low = p.lower()
+    for dev, letter in table:
+        if low == dev:
+            return letter + "\\"
+        if low.startswith(dev + "\\"):
+            return letter + p[len(dev):]
+    return None
+
+
+fd, path = tempfile.mkstemp(prefix="wvas_exp_", suffix=".bin")
+with os.fdopen(fd, "wb") as fh:
+    fh.write(b"hello wvas" * 100)
+print("temp file:", path)
+print("realpath:", os.path.realpath(path))
+
+GENERIC_READ = 0x80000000
+GENERIC_WRITE = 0x40000000
+OPEN_EXISTING = 3
+PAGE_READWRITE = 0x04
+FILE_MAP_WRITE = 0x0002
+h = kernel32.CreateFileW(path, GENERIC_READ | GENERIC_WRITE, 3, None, OPEN_EXISTING, 0, None)
+hm = kernel32.CreateFileMappingW(wt.HANDLE(h), None, PAGE_READWRITE, wt.DWORD(0), wt.DWORD(0), None)
+view = kernel32.MapViewOfFile(wt.HANDLE(hm), FILE_MAP_WRITE, wt.DWORD(0), wt.DWORD(0), ctypes.c_size_t(0))
+print("view", hex(view))
+nb = ctypes.create_unicode_buffer(2048)
+n = psapi.GetMappedFileNameW(wt.HANDLE(-1), wt.LPVOID(view), nb, 2048)
+dev = nb.value
+print("GetMappedFileNameW ->", n, repr(dev))
+conv = convert(dev)
+print("converted ->", repr(conv))
+print("converted exists ->", conv is not None and os.path.exists(conv))
+print("samefile ->", conv is not None and os.path.exists(conv) and os.path.samefile(conv, path))
+
+for flag, name in ((0, "VOLUME_NAME_DOS"), (1, "VOLUME_NAME_GUID"), (2, "VOLUME_NAME_NONE"), (4, "FILE_NAME_NORMALIZED"), (8, "FILE_NAME_OPENED")):
+    nb2 = ctypes.create_unicode_buffer(2048)
+    n2 = kernel32.GetFinalPathNameByHandleW(wt.HANDLE(hm), nb2, 2048, flag)
+    print("GetFinalPathNameByHandleW(section, %s) ->" % name, n2, repr(nb2.value), ctypes.get_last_error())
+nb4 = ctypes.create_unicode_buffer(2048)
+n4 = kernel32.GetFinalPathNameByHandleW(wt.HANDLE(h), nb4, 2048, 0)
+print("GetFinalPathNameByHandleW(file) ->", n4, repr(nb4.value))
+print("samefile(final) ->", os.path.samefile(nb4.value[4:], path))
+
+# image region names
+class MBI(ctypes.Structure):
+    _fields_ = [
+        ("BaseAddress", ctypes.c_uint64),
+        ("AllocationBase", ctypes.c_uint64),
+        ("AllocationProtect", wt.DWORD),
+        ("PartitionId", wt.WORD),
+        ("RegionSize", ctypes.c_uint64),
+        ("State", wt.DWORD),
+        ("Protect", wt.DWORD),
+        ("Type", wt.DWORD),
+    ]
+
+
+kernel32.VirtualQueryEx.argtypes = [wt.HANDLE, wt.LPCVOID, ctypes.POINTER(MBI), ctypes.c_size_t]
+kernel32.VirtualQueryEx.restype = ctypes.c_size_t
+mbi = MBI()
+addr = 0
+seen = {}
+mapped_seen = {}
+while addr < 0x7FFFFFFF0000:
+    r = kernel32.VirtualQueryEx(wt.HANDLE(-1), wt.LPCVOID(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not r:
+        break
+    if mbi.State == 0x1000:
+        nb6 = ctypes.create_unicode_buffer(2048)
+        n6 = psapi.GetMappedFileNameW(wt.HANDLE(-1), wt.LPVOID(mbi.BaseAddress), nb6, 2048)
+        if n6:
+            if mbi.Type == 0x1000000:
+                seen.setdefault(nb6.value, mbi.AllocationBase)
+            elif mbi.Type == 0x40000:
+                mapped_seen.setdefault(nb6.value, mbi.BaseAddress)
+    nxt = mbi.BaseAddress + mbi.RegionSize
+    if nxt <= addr:
+        break
+    addr = nxt
+print("distinct image files:", len(seen))
+missing = 0
+for name, base in sorted(seen.items(), key=lambda kv: kv[1]):
+    conv = convert(name)
+    ex = bool(conv) and os.path.exists(conv)
+    if not ex:
+        missing += 1
+        print("  NOT FOUND:", repr(name), "->", repr(conv))
+print("images whose converted path does not exist:", missing)
+print("distinct mapped files:", len(mapped_seen))
+for name, base in mapped_seen.items():
+    print("  mapped", hex(base), repr(name), "->", repr(convert(name)))
+kernel32.CloseHandle(hm)
+kernel32.CloseHandle(h)
+os.remove(path)
