new file mode 100644
index 0000000..0ac87a4
--- /dev/null
+++ b/_exp9.py
@@ -0,0 +1,63 @@
+import ctypes
+import ctypes.wintypes as wt
+import os
+
+kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+kernel32.CreateFileW.restype = wt.HANDLE
+kernel32.GetFinalPathNameByHandleW.restype = wt.DWORD
+kernel32.GetFinalPathNameByHandleW.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD, wt.DWORD]
+kernel32.FindFirstVolumeW.restype = wt.HANDLE
+kernel32.FindFirstVolumeW.argtypes = [wt.LPWSTR, wt.DWORD]
+kernel32.FindNextVolumeW.restype = wt.BOOL
+kernel32.FindNextVolumeW.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD]
+kernel32.FindVolumeClose.restype = wt.BOOL
+kernel32.FindVolumeClose.argtypes = [wt.HANDLE]
+kernel32.GetVolumePathNamesForVolumeNameW.restype = wt.BOOL
+kernel32.GetVolumePathNamesForVolumeNameW.argtypes = [wt.LPCWSTR, wt.LPWSTR, wt.DWORD, ctypes.POINTER(wt.DWORD)]
+
+INVALID_HANDLE_VALUE = wt.HANDLE(-1)
+GENERIC_READ = 0x80000000
+FILE_SHARE_READ = 1
+OPEN_EXISTING = 3
+
+vol = ctypes.create_unicode_buffer(256)
+h = kernel32.FindFirstVolumeW(vol, 256)
+print("FindFirstVolume", h, ctypes.get_last_error(), repr(vol.value))
+vols = []
+if h and h != INVALID_HANDLE_VALUE.value:
+    vols.append(vol.value)
+    while kernel32.FindNextVolumeW(wt.HANDLE(h), vol, 256):
+        vols.append(vol.value)
+    kernel32.FindVolumeClose(wt.HANDLE(h))
+for v in vols:
+    names = ctypes.create_unicode_buffer(4096)
+    retlen = wt.DWORD(0)
+    ok = kernel32.GetVolumePathNamesForVolumeNameW(v, names, 4096, ctypes.byref(retlen))
+    data = ctypes.wstring_at(names, retlen.value) if ok else ""
+    print("  ", v, "err", ctypes.get_last_error(), "->", [x for x in data.split("\x00") if x])
+
+DEVS = [
+    "\\Device\\HarddiskVolume1\\Windows\\System32\\ntdll.dll",
+    "\\Device\\VhdHardDisk{e80537cd-ec89-40cf-981e-6384a8a5a99e}\\Windows\\System32\\kernel32.dll",
+]
+PREFIXES = [
+    "\\\\?\\",
+    "\\\\.\\",
+    "\\\\.\\GLOBALROOT\\",
+    "\\\\?\\GLOBALROOT\\",
+    "\\\\??\\",
+    "\\GLOBAL??\\",
+    "",
+]
+for dev in DEVS:
+    for prefix in PREFIXES:
+        full = prefix + dev
+        hh = kernel32.CreateFileW(full, GENERIC_READ, FILE_SHARE_READ, None, OPEN_EXISTING, 0, None)
+        err = ctypes.get_last_error()
+        ok = bool(hh) and hh != INVALID_HANDLE_VALUE.value
+        print("CreateFileW(%r) -> %s ok=%s err=%s" % (full, hh, ok, err))
+        if ok:
+            out = ctypes.create_unicode_buffer(2048)
+            n = kernel32.GetFinalPathNameByHandleW(wt.HANDLE(hh), out, 2048, 0)
+            print("    GetFinalPathNameByHandleW ->", n, repr(out.value), ctypes.get_last_error())
+            kernel32.CloseHandle(wt.HANDLE(hh))
