+    need = wt.DWORD(0)
+    psapi.EnumProcessModulesEx(ch, None, 0, ctypes.byref(need), 0x03)
+    cnt = need.value // 8
+    arr = (wt.HMODULE * cnt)()
+    ok = psapi.EnumProcessModulesEx(ch, arr, need, ctypes.byref(need), 0x03)
+    print("  EnumProcessModulesEx ok=%d cnt=%d err=%d" % (ok, cnt, ctypes.get_last_error()))
+    nb = ctypes.create_unicode_buffer(4096)
+    for i in range(min(cnt, 4)):
+        psapi.GetModuleFileNameExW(ch, arr[i], nb, 4096)
+        print("    %#x %s" % (arr[i], nb.value))
+    # mapped file name of child's file view
+    for key in ("view", "anon", "big"):
+        addr = int(info.get(key, "0"), 16)
+        if not addr:
+            continue
+        b = ctypes.create_unicode_buffer(4096)
+        r = psapi.GetMappedFileNameW(ch, ctypes.c_void_p(addr), b, 4096)
+        print("  GetMappedFileNameW(%s=%#x) -> %r err=%d" % (key, addr, b.value if r else None, ctypes.get_last_error()))
+        mbi = MBI()
+        k32.VirtualQueryEx(ch, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+        print("     base=%#x allocbase=%#x size=%#x state=%#x type=%#x prot=%#x" %
