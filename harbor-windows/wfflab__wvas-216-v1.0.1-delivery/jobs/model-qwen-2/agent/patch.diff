+    q = ctypes.create_unicode_buffer(4096)
+    sz = wt.DWORD(4096)
+    r = k32.QueryFullProcessImageNameW(ch, 0, q, ctypes.byref(sz))
+    print("  QueryFullProcessImageNameW -> %r ok=%d" % (q.value, r))
