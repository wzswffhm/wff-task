index 0000000..28db2f1
--- /dev/null
+++ b/_tmp_probe7.py
@@ -0,0 +1,113 @@
+import ctypes, ctypes.wintypes as wt, os, subprocess, sys, time
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+psapi = ctypes.WinDLL("psapi", use_last_error=True)
+
+k32.OpenProcess.argtypes = [wt.DWORD, wt.BOOL, wt.DWORD]
+k32.OpenProcess.restype = wt.HANDLE
+k32.CloseHandle.argtypes = [wt.HANDLE]
+psapi.EnumProcessModulesEx.argtypes = [wt.HANDLE, ctypes.POINTER(wt.HMODULE), wt.DWORD, ctypes.POINTER(wt.DWORD), wt.DWORD]
+psapi.EnumProcessModulesEx.restype = wt.BOOL
+psapi.GetModuleFileNameExW.argtypes = [wt.HANDLE, wt.HMODULE, wt.LPWSTR, wt.DWORD]
+psapi.GetModuleFileNameExW.restype = wt.DWORD
+psapi.GetModuleBaseNameW.argtypes = [wt.HANDLE, wt.HMODULE, wt.LPWSTR, wt.DWORD]
+psapi.GetModuleBaseNameW.restype = wt.DWORD
+
+
+class MODULEINFO(ctypes.Structure):
+    _fields_ = [("lpBaseOfDll", ctypes.c_void_p), ("SizeOfImage", wt.DWORD),
+                ("EntryPoint", ctypes.c_void_p)]
+
+
+psapi.GetModuleInformation.argtypes = [wt.HANDLE, wt.HMODULE, ctypes.POINTER(MODULEINFO), wt.DWORD]
+psapi.GetModuleInformation.restype = wt.BOOL
+
+
+class MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+                ("AllocationProtect", wt.DWORD), ("RegionSize", ctypes.c_size_t),
+                ("State", wt.DWORD), ("Protect", wt.DWORD), ("Type", wt.DWORD)]
+
+
+k32.VirtualQueryEx.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.POINTER(MBI), ctypes.c_size_t]
+k32.VirtualQueryEx.restype = ctypes.c_size_t
+
+
+def analyse(pid, label):
+    h = k32.OpenProcess(0x0400 | 0x0010, False, pid)
+    print("== %s pid=%d handle=%#x" % (label, pid, h or 0))
+    if not h:
+        return
+    sums = {}
+    counts = {}
+    prots = {}
+    mbi = MBI()
+    addr = 0
+    while addr < 0x7FFFFFFFF000:
+        w = k32.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+        if not w:
+            break
+        base = mbi.BaseAddress or 0
+        if mbi.Type == 0x1000000:
+            ab = mbi.AllocationBase or 0
+            sums[ab] = sums.get(ab, 0) + mbi.RegionSize
+            counts[ab] = counts.get(ab, 0) + 1
+            prots.setdefault(ab, []).append((mbi.Protect, mbi.State, mbi.RegionSize))
+        addr = base + mbi.RegionSize
+
+    need = wt.DWORD(0)
+    psapi.EnumProcessModulesEx(h, None, 0, ctypes.byref(need), 0x03)
+    cnt = need.value // 8
+    arr = (wt.HMODULE * cnt)()
+    psapi.EnumProcessModulesEx(h, arr, need, ctypes.byref(need), 0x03)
+    nb = ctypes.create_unicode_buffer(4096)
+    mi = MODULEINFO()
+    mismatch = 0
+    for i in range(cnt):
+        ok = psapi.GetModuleInformation(h, arr[i], ctypes.byref(mi), ctypes.sizeof(mi))
+        base = mi.lpBaseOfDll or (arr[i] or 0)
+        soi = mi.SizeOfImage if ok else None
+        s = sums.get(base)
+        flag = "" if s == soi else "   <<< MISMATCH"
+        if s != soi:
+            mismatch += 1
+        if i < 8 or flag:
+            print("  %-46s base=%#x SizeOfImage=%#x regionsum=%s n=%d%s" %
+                  (nb.value and "" or "", base, soi or 0,
+                   hex(s) if s is not None else None, counts.get(base, 0), flag))
+    print("  modules=%d image-allocations=%d mismatches=%d" % (cnt, len(sums), mismatch))
+    # image allocations that have no module entry
+    modbases = set()
+    for i in range(cnt):
+        ok = psapi.GetModuleInformation(h, arr[i], ctypes.byref(mi), ctypes.sizeof(mi))
+        modbases.add(mi.lpBaseOfDll or (arr[i] or 0))
+    print("  image allocations not in module list:", [hex(x) for x in sorted(sums) if x not in modbases])
+    print("  module list entries with no image regions:", [hex(x) for x in sorted(modbases) if x not in sums])
+    # name resolution for module entries
+    names = {}
+    for i in range(cnt):
+        r = psapi.GetModuleFileNameExW(h, arr[i], nb, 4096)
+        names[arr[i]] = nb.value if r else "<err %d>" % ctypes.get_last_error()
+    print("  sample names:", list(names.items())[:3])
+    k32.CloseHandle(h)
+
+
+analyse(os.getpid(), "self")
+proc = subprocess.Popen([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "_tmp_child.py"), "20"],
+                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+info = {}
+t0 = time.time()
+while time.time() - t0 < 12 and "committed" not in info:
+    line = proc.stdout.readline()
+    if not line:
+        break
+    for tok in line.strip().replace("CHILD ", "").split():
+        if "=" in tok:
+            k, v = tok.split("=", 1)
+            info[k] = v
+time.sleep(0.5)
+analyse(int(info["pid"]), "child")
+k32.TerminateProcess.argtypes = [wt.HANDLE, wt.UINT]
+proc.kill()
+proc.wait()
+print("done")
