--- /dev/null
+++ b/_tmp_probe5.py
@@ -0,0 +1,87 @@
+import ctypes, ctypes.wintypes as wt, os, subprocess, sys, time
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+psapi = ctypes.WinDLL("psapi", use_last_error=True)
+
+k32.OpenProcess.argtypes = [wt.DWORD, wt.BOOL, wt.DWORD]
+k32.OpenProcess.restype = wt.HANDLE
+k32.CloseHandle.argtypes = [wt.HANDLE]
+psapi.GetMappedFileNameW.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.LPWSTR, wt.DWORD]
+psapi.GetMappedFileNameW.restype = wt.DWORD
+psapi.EnumProcessModulesEx.argtypes = [wt.HANDLE, ctypes.POINTER(wt.HMODULE), wt.DWORD, ctypes.POINTER(wt.DWORD), wt.DWORD]
+psapi.EnumProcessModulesEx.restype = wt.BOOL
+psapi.GetModuleFileNameExW.argtypes = [wt.HANDLE, wt.HMODULE, wt.LPWSTR, wt.DWORD]
+psapi.GetModuleFileNameExW.restype = wt.DWORD
+
+class MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+                ("AllocationProtect", wt.DWORD), ("RegionSize", ctypes.c_size_t),
+                ("State", wt.DWORD), ("Protect", wt.DWORD), ("Type", wt.DWORD)]
+
+k32.VirtualQueryEx.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.POINTER(MBI), ctypes.c_size_t]
+k32.VirtualQueryEx.restype = ctypes.c_size_t
+
+proc = subprocess.Popen([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "_tmp_child.py"), "20"],
+                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+info = {}
+t0 = time.time()
+while time.time() - t0 < 12 and len(info) < 3:
+    line = proc.stdout.readline()
+    if not line:
+        break
+    line = line.strip()
+    print("child:", line)
+    for tok in line.replace("CHILD ", "").split():
+        if "=" in tok:
+            k, v = tok.split("=", 1)
+            info[k] = v
+cpid = int(info["pid"])
+print("child pid", cpid, "info", info)
+ch = k32.OpenProcess(0x0400 | 0x0010, False, cpid)
+print("OpenProcess(child) -> %#x err=%d" % (ch or 0, ctypes.get_last_error()))
+if ch:
+    need = wt.DWORD(0)
+    ok = psapi.EnumProcessModulesEx(ch, None, 0, ctypes.byref(need), 0x03)
+    print("EnumProcessModulesEx sizing ok=%d need=%d err=%d" % (ok, need.value, ctypes.get_last_error()))
+    cnt = need.value // 8
+    arr = (wt.HMODULE * cnt)()
+    ok = psapi.EnumProcessModulesEx(ch, arr, need, ctypes.byref(need), 0x03)
+    print("EnumProcessModulesEx ok=%d cnt=%d" % (ok, cnt))
+    nb = ctypes.create_unicode_buffer(4096)
+    names = {}
+    for i in range(cnt):
+        r = psapi.GetModuleFileNameExW(ch, arr[i], nb, 4096)
+        key = nb.value if r else None
+        names.setdefault(key, []).append(arr[i])
+    print("unique module names:", len(names))
+    for nm, hs in sorted(names.items(), key=lambda kv: str(kv[0])):
+        print("   %-50s x%d" % (nm, len(hs)))
+
+    for key in ("view", "anon", "big", "small", "committed"):
+        addr = int(info.get(key, "0"), 16)
+        if not addr:
+            continue
+        b = ctypes.create_unicode_buffer(4096)
+        r = psapi.GetMappedFileNameW(ch, ctypes.c_void_p(addr), b, 4096)
+        print("  GetMappedFileNameW(%s=%#x) -> %r err=%d" % (key, addr, b.value if r else None, ctypes.get_last_error()))
+        mbi = MBI()
+        k32.VirtualQueryEx(ch, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+        print("     base=%#x allocbase=%#x size=%#x state=%#x type=%#x prot=%#x" %
+              (mbi.BaseAddress or 0, mbi.AllocationBase or 0, mbi.RegionSize, mbi.State, mbi.Type, mbi.Protect))
+
+    mbi = MBI()
+    addr = 0
+    kinds = {}
+    while addr < 0x7FFFFFFF0000:
+        w = k32.VirtualQueryEx(ch, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+        if not w:
+            break
+        base = mbi.BaseAddress or 0
+        k = (mbi.State, mbi.Type)
+        kinds[k] = kinds.get(k, 0) + 1
+        addr = base + mbi.RegionSize
+    print("child region kinds:", {("%#x" % a, "%#x" % b): c for (a, b), c in sorted(kinds.items())})
+    k32.CloseHandle(ch)
+proc.kill()
+proc.wait()
+print("done")
