+    h = k32.OpenProcess(0x0400 | 0x0010, False, pid)
+    e1 = ctypes.get_last_error()
+    h2 = k32.OpenProcess(0x1000, False, pid)
+    e2 = ctypes.get_last_error()
+    print("  pid=%-12d full=%#x err=%d   limited=%#x err=%d" % (pid, h or 0, e1, h2 or 0, e2))
+    if h: k32.CloseHandle(h)
+    if h2: k32.CloseHandle(h2)
+
+print("=== volumes + mounts ===")
+buf = ctypes.create_unicode_buffer(260)
+h = k32.FindFirstVolumeW(buf, 260)
+if h and h != INVALID_HANDLE_VALUE:
+    while True:
+        v = buf.value
+        pn = ctypes.create_unicode_buffer(4096)
+        ret = wt.DWORD(0)
+        ok = k32.GetVolumePathNamesForVolumeNameW(v, pn, 4096, ctypes.byref(ret))
+        print("  %r mounts=%r" % (v, [x for x in pn.value.split("\0") if x] if ok else ctypes.get_last_error()))
+        if not k32.FindNextVolumeW(h, buf, 260):
+            break
+    k32.FindVolumeClose(h)
