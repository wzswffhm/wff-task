diff --git a/_tmp_accept.py b/_tmp_accept.py
new file mode 100644
index 0000000..2c3688e
--- /dev/null
+++ b/_tmp_accept.py
@@ -0,0 +1,274 @@
+"""Acceptance harness: measures the target independently of wvas."""
+import ctypes, ctypes.wintypes as wt, os, subprocess, sys, tempfile, time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import wvas
+
+FAIL = []
+
+
+def check(label, cond, detail=""):
+    print(("PASS  " if cond else "FAIL  ") + label + ((" :: " + str(detail)) if detail else ""))
+    if not cond:
+        FAIL.append(label)
+
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.OpenProcess.argtypes = [wt.DWORD, wt.BOOL, wt.DWORD]
+k32.OpenProcess.restype = wt.HANDLE
+k32.CloseHandle.argtypes = [wt.HANDLE]
+
+
+class MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+                ("AllocationProtect", wt.DWORD), ("RegionSize", ctypes.c_size_t),
+                ("State", wt.DWORD), ("Protect", wt.DWORD), ("Type", wt.DWORD)]
+
+
+k32.VirtualQueryEx.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.POINTER(MBI), ctypes.c_size_t]
+k32.VirtualQueryEx.restype = ctypes.c_size_t
+
+
+def ground_truth(pid, include_reserved=True):
+    h = k32.OpenProcess(0x0400 | 0x0010, False, pid)
+    assert h, ctypes.get_last_error()
+    out = []
+    mbi = MBI()
+    addr = 0x10000
+    while addr <= 0x7FFFFFFEFFFF:
+        n = k32.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+        if not n:
+            break
+        base = mbi.BaseAddress or 0
+        size = mbi.RegionSize or 0
+        if size <= 0:
+            break
+        if mbi.State == 0x1000 or (include_reserved and mbi.State == 0x2000):
+            out.append((base, size, mbi.State))
+        addr = base + size
+    k32.CloseHandle(h)
+    out.sort()
+    return out
+
+
+def is_openable(p):
+    if p is None:
+        return True
+    if p == "":
+        return False
+    low = p.lower()
+    for bad in ("\\device\\", "\\??\\"):
+        if low.startswith(bad):
+            return False
+    if p.startswith("\\\\?\\"):
+        return False
+    if len(p) >= 3 and p[1] == ":" and p[2] == "\\" and p[0].isalpha():
+        return True
+    if p.startswith("\\\\") and p[3:4] not in ("", "\\"):
+        return True
+    return False
+
+
+# ---- spawn the target -------------------------------------------------------
+here = os.path.dirname(os.path.abspath(__file__))
+proc = subprocess.Popen([sys.executable, os.path.join(here, "_tmp_child.py"), "40"],
+                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+info = {}
+t0 = time.time()
+while time.time() - t0 < 20 and "anon" not in info:
+    line = proc.stdout.readline()
+    if not line:
+        break
+    for tok in line.strip().replace("CHILD ", "").split():
+        if "=" in tok:
+            k, v = tok.split("=", 1)
+            info[k] = v
+cpid = int(info["pid"])
+print("target pid", cpid, info)
+time.sleep(0.4)
+
+try:
+    # ---- A: regions --------------------------------------------------------
+    regs = wvas.regions(cpid)
+    check("A regions returns list", isinstance(regs, list) and regs)
+    keys = {"base", "size", "state", "type", "protect", "path", "image"}
+    check("A keys exact", all(set(r) == keys for r in regs))
+    bases = [r["base"] for r in regs]
+    check("A ascending", bases == sorted(bases))
+    check("A state values", all(r["state"] in ("commit", "reserve") for r in regs))
+    check("A type values", all(r["type"] in ("image", "mapped", "private") for r in regs))
+    check("A protect str", all(isinstance(r["protect"], str) for r in regs))
+    check("A image bool", all(isinstance(r["image"], bool) for r in regs))
+    check("A base int>0", all(isinstance(r["base"], int) and r["base"] > 0 for r in regs))
+    check("A size int>0", all(isinstance(r["size"], int) and r["size"] > 0 for r in regs))
+    check("A path None or str", all(r["path"] is None or isinstance(r["path"], str) for r in regs))
+
+    gt = ground_truth(cpid)
+    got = sorted((r["base"], r["size"]) for r in regs)
+    gtp = [(b, s) for b, s, st in gt]
+    check("A base/size match VirtualQueryEx", got == gtp,
+          "len got=%d truth=%d; first diff %s" % (
+              len(got), len(gtp),
+              next((x for x in zip(got, gtp) if x[0] != x[1]), "lengths differ")))
+    check("A high addresses not truncated", all(r["base"] <= 0xFFFFFFFF or True for r in regs) and
+          any(r["base"] > 0xFFFFFFFF for r in regs),
+          "max base %#x" % max(r["base"] for r in regs))
+
+    # 6 GiB reservation
+    big = int(info["big"], 16)
+    hit = [r for r in regs if r["base"] == big]
+    check("A2 6GiB reservation reported", bool(hit))
+    if hit:
+        check("A2 6GiB size correct", hit[0]["size"] == 6 * 1024 ** 3,
+              "reported %#x (%d)" % (hit[0]["size"], hit[0]["size"]))
+        check("A2 6GiB state reserve", hit[0]["state"] == "reserve")
+
+    # A3 reserved
+    res = [r for r in regs if r["state"] == "reserve"]
+    check("A3 include_reserved reports reserves", bool(res), "count=%d" % len(res))
+    nores = wvas.regions(cpid, include_reserved=False)
+    check("A3 include_reserved=False only commit", all(r["state"] == "commit" for r in nores))
+    check("A3 commit subset consistent",
+          sorted((r["base"], r["size"]) for r in nores) ==
+          sorted((r["base"], r["size"]) for r in regs if r["state"] == "commit"))
+
+    # ---- B: paths ----------------------------------------------------------
+    check("B1 all paths openable", all(is_openable(r["path"]) for r in regs),
+          [r["path"] for r in regs if not is_openable(r["path"])][:3])
+    view = int(info["view"], 16)
+    hit = [r for r in regs if r["base"] == view]
+    check("B2 mapped file region found", bool(hit))
+    if hit:
+        real = os.path.realpath(info["file"])
+        check("B2 mapped path equals real disk path",
+              hit[0]["path"] is not None and
+              os.path.realpath(hit[0]["path"]) == real,
+              "reported=%r real=%r" % (hit[0]["path"], real))
+        check("B2 mapped path exists", hit[0]["path"] and os.path.exists(hit[0]["path"]), hit[0]["path"])
+    anon = int(info["anon"], 16)
+    hit = [r for r in regs if r["base"] == anon]
+    check("B3 anonymous mapping found", bool(hit))
+    if hit:
+        check("B3 anonymous path is None", hit[0]["path"] is None, repr(hit[0]["path"]))
+    private = [r for r in regs if r["type"] == "private"]
+    check("B3 private regions path None", all(r["path"] is None for r in private))
+    reserved = [r for r in regs if r["state"] == "reserve"]
+    check("B3 reserved regions path None", all(r["path"] is None for r in reserved))
+    fb = wvas.file_backed_regions(cpid)
+    expect = [r for r in regs if r["path"] is not None]
+    check("B4 file_backed subset & order",
+          [(r["base"], r["size"], r["path"]) for r in fb] ==
+          [(r["base"], r["size"], r["path"]) for r in expect],
+          "len fb=%d expect=%d" % (len(fb), len(expect)))
+    check("B4 all fb have path", all(r["path"] is not None for r in fb))
+
+    # ---- C: modules --------------------------------------------------------
+    mods = wvas.modules(cpid)
+    check("C modules non-empty list", isinstance(mods, list) and mods)
+    check("C module keys", all(set(m) == {"base", "size", "path"} for m in mods),
+          [set(m) for m in mods][:1])
+    mbases = [m["base"] for m in mods]
+    check("C modules ascending", mbases == sorted(mbases))
+    check("C modules unique bases", len(mbases) == len(set(mbases)))
+    paths = [m["path"] for m in mods if m["path"] is not None]
+    check("C modules unique paths", len(paths) == len(set(p.lower() for p in paths)),
+          "n=%d unique=%d" % (len(paths), len(set(p.lower() for p in paths))))
+    check("C module paths openable", all(is_openable(p) for p in paths))
+    check("C module paths exist on disk", all(os.path.exists(p) for p in paths),
+          [p for p in paths if not os.path.exists(p)][:3])
+    # completeness: every MEM_IMAGE allocation base in the truth walk
+    h = k32.OpenProcess(0x0400 | 0x0010, False, cpid)
+    mbi = MBI()
+    addr = 0x10000
+    image_bases = {}
+    while addr <= 0x7FFFFFFEFFFF:
+        n = k32.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+        if not n:
+            break
+        base = mbi.BaseAddress or 0
+        size = mbi.RegionSize or 0
+        if size <= 0:
+            break
+        if mbi.Type == 0x1000000 and mbi.State == 0x1000:
+            image_bases[mbi.AllocationBase or base] = image_bases.get(mbi.AllocationBase or base, 0) + size
+        addr = base + size
+    k32.CloseHandle(h)
+    missing = [hex(b) for b in image_bases if b not in set(mbases)]
+    check("C complete: every image allocation present", not missing, "missing=%s" % missing[:5])
+    print("   image allocations=%d modules=%d" % (len(image_bases), len(mods)))
+    sizes_ok = all(m["size"] == image_bases.get(m["base"], m["size"]) for m in mods)
+    check("C module size == sum of image region sizes", sizes_ok,
+          [(hex(m["base"]), m["size"], image_bases.get(m["base"])) for m in mods
+           if m["size"] != image_bases.get(m["base"], m["size"])][:3])
+    # image regions of regions() agree with modules()
+    img_regions = [r for r in regs if r["image"]]
+    check("A image regions have path", all(r["path"] is not None for r in img_regions),
+          [(hex(r["base"]), r["path"]) for r in img_regions if r["path"] is None][:3])
+    ab_of = {}
+    check("C module bases match image regions",
+          set(mbases) >= set(image_bases), "mods=%d truth=%d" % (len(mbases), len(image_bases)))
+
+    # ---- D: errors ---------------------------------------------------------
+    for bad in (-1, 0, -99, 2 ** 32):
+        try:
+            wvas.regions(bad)
+            check("D badarg pid=%r" % bad, False, "no raise")
+        except wvas.WVasError as e:
+            check("D badarg pid=%r" % bad, e.kind == "badarg", e.kind)
+        except OSError as e:
+            check("D badarg pid=%r leaks OSError" % bad, False, e)
+    for bad in ("abc", None, 3.5, True):
+        try:
+            wvas.regions(bad)
+            check("D badarg pid=%r" % bad, False, "no raise")
+        except wvas.WVasError as e:
+            check("D badarg pid=%r" % bad, e.kind == "badarg", e.kind)
+        except OSError as e:
+            check("D badarg pid=%r leaks OSError" % bad, False, e)
+    for gone in (999999, 12345678, 0xFFFFFFFE):
+        for fn, name in ((wvas.regions, "regions"), (wvas.file_backed_regions, "file_backed_regions"),
+                         (wvas.modules, "modules")):
+            try:
+                fn(gone)
+                check("D no-such-process %s(%d)" % (name, gone), False, "no raise")
+            except wvas.WVasError as e:
+                check("D no-such-process %s(%d)" % (name, gone), e.kind == "no-such-process",
+                      "%s pid=%s" % (e.kind, e.pid))
+            except OSError as e:
+                check("D no-such-process %s leaks OSError" % name, False, e)
+    for prot in (4, 5):
+        try:
+            wvas.regions(prot)
+            check("D access-denied pid=%d" % prot, False, "no raise")
+        except wvas.WVasError as e:
+            check("D access-denied pid=%d" % prot, e.kind == "access-denied", e.kind)
+        except OSError as e:
+            check("D access-denied pid=%d leaks OSError" % prot, False, e)
+
+    # ---- E: purity + self process -----------------------------------------
+    check("E protection_name pure", wvas.protection_name(0x04) == "rw" and
+          wvas.protection_name(0x20) == "xr" and wvas.protection_name(0x404) == "rw")
+    check("E type_name pure", wvas.type_name(0x1000000) == "image" and
+          wvas.type_name(0x40000) == "mapped" and wvas.type_name(0x20000) == "private")
+    self_regs = wvas.regions(os.getpid())
+    sgt = ground_truth(os.getpid())
+    check("E self process matches", sorted((r["base"], r["size"]) for r in self_regs) ==
+          [(b, s) for b, s, st in sgt],
+          "%d vs %d" % (len(self_regs), len(sgt)))
+    selfmods = wvas.modules(os.getpid())
+    check("E self modules unique", len(set(m["path"].lower() for m in selfmods if m["path"])) ==
+          len([m for m in selfmods if m["path"]]))
+    check("E self modules count sane", len(selfmods) < 200, len(selfmods))
+    print("   self modules=%d" % len(selfmods))
+    # timing: two calls give same answer while the process is idle
+    a = wvas.regions(cpid)
+    b = wvas.regions(cpid)
+    check("A stable across calls", [(r["base"], r["size"]) for r in a] == [(r["base"], r["size"]) for r in b])
+finally:
+    proc.kill()
+    proc.wait()
+
+print()
+print("FAILURES:", len(FAIL))
+for f in FAIL:
+    print("  -", f)
diff --git a/_tmp_child.py b/_tmp_child.py
new file mode 100644
index 0000000..ff18b2d
--- /dev/null
+++ b/_tmp_child.py
@@ -0,0 +1,33 @@
+"""Child target process: reserve 6 GiB, map a file, map anonymous memory."""
+import ctypes, ctypes.wintypes as wt, os, sys, tempfile, time
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.VirtualAlloc.argtypes = [wt.LPVOID, ctypes.c_size_t, wt.DWORD, wt.DWORD]
+k32.VirtualAlloc.restype = wt.LPVOID
+k32.CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, wt.LPVOID, wt.DWORD, wt.DWORD, wt.HANDLE]
+k32.CreateFileW.restype = wt.HANDLE
+k32.CreateFileMappingW.argtypes = [wt.HANDLE, wt.LPVOID, wt.DWORD, wt.DWORD, wt.DWORD, wt.LPCWSTR]
+k32.CreateFileMappingW.restype = wt.HANDLE
+k32.MapViewOfFile.argtypes = [wt.HANDLE, wt.DWORD, wt.DWORD, wt.DWORD, ctypes.c_size_t]
+k32.MapViewOfFile.restype = wt.LPVOID
+
+big = k32.VirtualAlloc(None, ctypes.c_size_t(6 * 1024 * 1024 * 1024), 0x2000, 0x01)
+small = k32.VirtualAlloc(None, ctypes.c_size_t(0x100000), 0x2000, 0x01)
+committed = k32.VirtualAlloc(None, ctypes.c_size_t(0x200000), 0x3000, 0x04)
+
+tmp = os.path.join(tempfile.gettempdir(), "wvas_target_mapped.bin")
+with open(tmp, "wb") as fh:
+    fh.write(b"y" * (1024 * 1024))
+
+hf = k32.CreateFileW(tmp, 0x80000000, 0x3, None, 3, 0, None)
+hm = k32.CreateFileMappingW(hf, None, 0x02, 0, 0, None)
+view = k32.MapViewOfFile(hm, 0x0004, 0, 0, 0)
+
+hfa = k32.CreateFileMappingW(wt.HANDLE(-1), None, 0x04, 0, 65536, None)
+viewa = k32.MapViewOfFile(hfa, 0x0004, 0, 0, 0)
+
+print("CHILD pid=%d" % os.getpid(), flush=True)
+print("CHILD big=%#x small=%#x committed=%#x" % (big or 0, small or 0, committed or 0), flush=True)
+print("CHILD file=%s view=%#x anon=%#x" % (tmp, view or 0, viewa or 0), flush=True)
+sys.stdout.flush()
+time.sleep(float(sys.argv[1]) if len(sys.argv) > 1 else 20)
diff --git a/_tmp_probe.py b/_tmp_probe.py
new file mode 100644
index 0000000..c1d06c6
--- /dev/null
+++ b/_tmp_probe.py
@@ -0,0 +1,132 @@
+import ctypes, ctypes.wintypes as wt, os, sys
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+psapi = ctypes.WinDLL("psapi", use_last_error=True)
+INVALID_HANDLE_VALUE = 0xFFFFFFFFFFFFFFFF
+
+k32.GetCurrentProcess.restype = wt.HANDLE
+k32.VirtualAlloc.argtypes = [wt.LPVOID, ctypes.c_size_t, wt.DWORD, wt.DWORD]
+k32.VirtualAlloc.restype = wt.LPVOID
+k32.OpenProcess.argtypes = [wt.DWORD, wt.BOOL, wt.DWORD]
+k32.OpenProcess.restype = wt.HANDLE
+k32.QueryDosDeviceW.argtypes = [wt.LPCWSTR, wt.LPWSTR, wt.DWORD]
+k32.QueryDosDeviceW.restype = wt.DWORD
+k32.QueryFullProcessImageNameW.argtypes = [wt.HANDLE, wt.DWORD, wt.LPWSTR, ctypes.POINTER(wt.DWORD)]
+k32.QueryFullProcessImageNameW.restype = wt.BOOL
+k32.CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, wt.LPVOID, wt.DWORD, wt.DWORD, wt.HANDLE]
+k32.CreateFileW.restype = wt.HANDLE
+k32.CreateFileMappingW.argtypes = [wt.HANDLE, wt.LPVOID, wt.DWORD, wt.DWORD, wt.DWORD, wt.LPCWSTR]
+k32.CreateFileMappingW.restype = wt.HANDLE
+k32.MapViewOfFile.argtypes = [wt.HANDLE, wt.DWORD, wt.DWORD, wt.DWORD, ctypes.c_size_t]
+k32.MapViewOfFile.restype = wt.LPVOID
+k32.CloseHandle.argtypes = [wt.HANDLE]
+
+class MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+                ("AllocationProtect", wt.DWORD), ("RegionSize", ctypes.c_size_t),
+                ("State", wt.DWORD), ("Protect", wt.DWORD), ("Type", wt.DWORD)]
+
+k32.VirtualQueryEx.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.POINTER(MBI), ctypes.c_size_t]
+k32.VirtualQueryEx.restype = ctypes.c_size_t
+psapi.GetMappedFileNameW.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.LPWSTR, wt.DWORD]
+psapi.GetMappedFileNameW.restype = wt.DWORD
+psapi.EnumProcessModulesEx.argtypes = [wt.HANDLE, ctypes.POINTER(wt.HMODULE), wt.DWORD, ctypes.POINTER(wt.DWORD), wt.DWORD]
+psapi.EnumProcessModulesEx.restype = wt.BOOL
+psapi.GetModuleFileNameExW.argtypes = [wt.HANDLE, wt.HMODULE, wt.LPWSTR, wt.DWORD]
+psapi.GetModuleFileNameExW.restype = wt.DWORD
+
+print("pid", os.getpid(), "exe", sys.executable)
+ph = k32.GetCurrentProcess()
+print("ph %#x" % ph)
+
+big = k32.VirtualAlloc(None, ctypes.c_size_t(6 * 1024 * 1024 * 1024), 0x2000, 0x01)
+print("VirtualAlloc 6GiB -> %#x err=%d" % (big or 0, ctypes.get_last_error()))
+
+hf = k32.CreateFileW(sys.executable, 0x80000000, 0x3, None, 3, 0, None)
+print("CreateFileW exe -> %#x err=%d" % (hf or 0, ctypes.get_last_error()))
+view = None
+if hf and hf != INVALID_HANDLE_VALUE:
+    hm = k32.CreateFileMappingW(hf, None, 0x02, 0, 0, None)
+    print("CreateFileMappingW file -> %s err=%d" % (hm, ctypes.get_last_error()))
+    if hm:
+        view = k32.MapViewOfFile(hm, 0x0004, 0, 0, 0)
+        print("MapViewOfFile file -> %#x" % (view or 0))
+
+hfa = k32.CreateFileMappingW(wt.HANDLE(-1), None, 0x04, 0, 65536, None)
+print("CreateFileMappingW anon -> %s err=%d" % (hfa, ctypes.get_last_error()))
+viewa = k32.MapViewOfFile(hfa, 0x0004, 0, 0, 0) if hfa else 0
+print("MapViewOfFile anon -> %#x" % (viewa or 0))
+
+mbi = MBI()
+addr = 0
+seen = {}
+total = 0
+while addr < 0x7FFFFFFF0000:
+    w = k32.VirtualQueryEx(ph, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    if not w:
+        print("walk end at %#x err=%d" % (addr, ctypes.get_last_error()))
+        break
+    total += 1
+    base = mbi.BaseAddress or 0
+    key = (mbi.State, mbi.Type)
+    nm = None
+    if mbi.Type in (0x1000000, 0x40000):
+        b2 = ctypes.create_unicode_buffer(1024)
+        r = psapi.GetMappedFileNameW(ph, ctypes.c_void_p(base), b2, 1024)
+        nm = b2.value if r else "<none:%d>" % ctypes.get_last_error()
+    if key not in seen or seen[key][2] is None:
+        seen[key] = (base, mbi.RegionSize, nm, mbi.Protect)
+    addr = base + mbi.RegionSize
+print("total regions:", total)
+for k in sorted(seen):
+    base, size, nm, prot = seen[k]
+    print("  state=%#x type=%#x prot=%#x base=%#x size=%#x (%.2f GiB) name=%r" %
+          (k[0], k[1], prot, base, size, size / 2.0**30, nm))
+
+if big:
+    k32.VirtualQueryEx(ph, ctypes.c_void_p(big), ctypes.byref(mbi), ctypes.sizeof(mbi))
+    print("6GiB: base=%#x size=%#x state=%#x type=%#x" % (mbi.BaseAddress, mbi.RegionSize, mbi.State, mbi.Type))
+if viewa:
+    b2 = ctypes.create_unicode_buffer(1024)
+    r = psapi.GetMappedFileNameW(ph, ctypes.c_void_p(viewa), b2, 1024)
+    print("anon GetMappedFileNameW ->", r, repr(b2.value), "err", ctypes.get_last_error())
+if view:
+    b2 = ctypes.create_unicode_buffer(1024)
+    r = psapi.GetMappedFileNameW(ph, ctypes.c_void_p(view), b2, 1024)
+    print("file GetMappedFileNameW ->", r, repr(b2.value), "err", ctypes.get_last_error())
+
+q = ctypes.create_unicode_buffer(4096)
+sz = wt.DWORD(4096)
+r = k32.QueryFullProcessImageNameW(ph, 0, q, ctypes.byref(sz))
+print("QueryFullProcessImageNameW:", r, repr(q.value), "err", ctypes.get_last_error())
+
+need = wt.DWORD(0)
+psapi.EnumProcessModulesEx(ph, None, 0, ctypes.byref(need), 0x03)
+count = need.value // ctypes.sizeof(ctypes.c_void_p)
+arr = (wt.HMODULE * count)()
+ok = psapi.EnumProcessModulesEx(ph, arr, need, ctypes.byref(need), 0x03)
+print("EnumProcessModulesEx ok", ok, "handles", count, "err", ctypes.get_last_error())
+buf = ctypes.create_unicode_buffer(4096)
+names = {}
+for i in range(count):
+    r = psapi.GetModuleFileNameExW(ph, arr[i], buf, 4096)
+    key = buf.value if r else None
+    names.setdefault(key, []).append(arr[i])
+print("unique module names:", len(names))
