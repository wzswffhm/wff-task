@@ -0,0 +1,96 @@
+import ctypes, ctypes.wintypes as wt, os
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+INVALID_HANDLE_VALUE = 0xFFFFFFFFFFFFFFFF
+
+k32.FindFirstVolumeW.argtypes = [wt.LPWSTR, wt.DWORD]
+k32.FindFirstVolumeW.restype = wt.HANDLE
+k32.FindNextVolumeW.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD]
+k32.FindNextVolumeW.restype = wt.BOOL
+k32.FindVolumeClose.argtypes = [wt.HANDLE]
+k32.FindVolumeClose.restype = wt.BOOL
+k32.CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, wt.LPVOID, wt.DWORD, wt.DWORD, wt.HANDLE]
+k32.CreateFileW.restype = wt.HANDLE
+k32.GetFinalPathNameByHandleW.argtypes = [wt.HANDLE, wt.LPWSTR, wt.DWORD, wt.DWORD]
+k32.GetFinalPathNameByHandleW.restype = wt.DWORD
+k32.GetVolumePathNamesForVolumeNameW.argtypes = [wt.LPCWSTR, wt.LPWSTR, wt.DWORD, ctypes.POINTER(wt.DWORD)]
+k32.GetVolumePathNamesForVolumeNameW.restype = wt.BOOL
+k32.QueryDosDeviceW.argtypes = [wt.LPCWSTR, wt.LPWSTR, wt.DWORD]
+k32.QueryDosDeviceW.restype = wt.DWORD
+
+buf = ctypes.create_unicode_buffer(260)
+h = k32.FindFirstVolumeW(buf, 260)
+vols = []
+if h and h != INVALID_HANDLE_VALUE:
+    vols.append(buf.value)
+    while k32.FindNextVolumeW(h, buf, 260):
+        vols.append(buf.value)
+    k32.FindVolumeClose(h)
+print("volumes:", vols)
+
+for v in vols:
+    print("---", v)
+    pn = ctypes.create_unicode_buffer(4096)
+    ret = wt.DWORD(0)
+    ok = k32.GetVolumePathNamesForVolumeNameW(v, pn, 4096, ctypes.byref(ret))
+    print("   mounts:", [x for x in pn.value.split("\0") if x] if ok else ctypes.get_last_error())
+    hv = k32.CreateFileW(v.rstrip("\\"), 0, 0x1 | 0x2, None, 3, 0, None)
+    print("   handle %#x err=%d" % (hv or 0, ctypes.get_last_error()))
+    if hv and hv != INVALID_HANDLE_VALUE:
+        fp = ctypes.create_unicode_buffer(4096)
+        for flag, label in ((0, "VOLUME_NAME_DOS"), (1, "VOLUME_NAME_GUID"), (2, "VOLUME_NAME_NT"), (4, "VOLUME_NAME_NONE")):
+            r = k32.GetFinalPathNameByHandleW(hv, fp, 4096, flag)
+            print("   %-16s -> %r" % (label, fp.value if r else ctypes.get_last_error()))
+        k32.CloseHandle(hv)
+    b = ctypes.create_unicode_buffer(4096)
+    r = k32.QueryDosDeviceW(v.rstrip("\\"), b, 4096)
+    print("   QueryDosDevice(volume) ->", [x for x in b.value.split("\0") if x] if r else ctypes.get_last_error())
+
+print("=== sizeof MBI ===")
+class MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+                ("AllocationProtect", wt.DWORD), ("RegionSize", ctypes.c_size_t),
+                ("State", wt.DWORD), ("Protect", wt.DWORD), ("Type", wt.DWORD)]
+print("size:", ctypes.sizeof(MBI))
+
+print("=== GetNativeSystemInfo ===")
+class SYSTEM_INFO(ctypes.Structure):
+    _fields_ = [("wProcessorArchitecture", wt.WORD), ("wReserved", wt.WORD), ("dwPageSize", wt.DWORD),
+                ("lpMinimumApplicationAddress", ctypes.c_void_p), ("lpMaximumApplicationAddress", ctypes.c_void_p),
+                ("dwActiveProcessorMask", ctypes.POINTER(ctypes.c_ulong)), ("dwNumberOfProcessors", wt.DWORD),
+                ("dwProcessorType", wt.DWORD), ("dwAllocationGranularity", wt.DWORD),
+                ("wProcessorLevel", wt.WORD), ("wProcessorRevision", wt.WORD)]
+si = SYSTEM_INFO()
+k32.GetNativeSystemInfo(ctypes.byref(si))
+print("arch=%#x min=%#x max=%#x page=%#x gran=%#x" % (si.wProcessorArchitecture, si.lpMinimumApplicationAddress or 0,
+                                                      si.lpMaximumApplicationAddress or 0, si.dwPageSize,
+                                                      si.dwAllocationGranularity))
+k32.GetSystemInfo(ctypes.byref(si))
+print("GetSystemInfo arch=%#x min=%#x max=%#x" % (si.wProcessorArchitecture, si.lpMinimumApplicationAddress or 0,
+                                                  si.lpMaximumApplicationAddress or 0))
+
+print("=== toolhelp process snapshot ===")
+class PROCESSENTRY32W(ctypes.Structure):
+    _fields_ = [("dwSize", wt.DWORD), ("cntUsage", wt.DWORD), ("th32ProcessID", wt.DWORD),
+                ("th32DefaultHeapID", ctypes.POINTER(ctypes.c_ulong)), ("th32ModuleID", wt.DWORD),
+                ("cntThreads", wt.DWORD), ("th32ParentProcessID", wt.DWORD), ("pcPriClassBase", ctypes.c_long),
+                ("dwFlags", wt.DWORD), ("szExeFile", wt.WCHAR * 260)]
+k32.CreateToolhelp32Snapshot.argtypes = [wt.DWORD, wt.DWORD]
+k32.CreateToolhelp32Snapshot.restype = wt.HANDLE
+k32.Process32FirstW.argtypes = [wt.HANDLE, ctypes.POINTER(PROCESSENTRY32W)]
+k32.Process32FirstW.restype = wt.BOOL
+k32.Process32NextW.argtypes = [wt.HANDLE, ctypes.POINTER(PROCESSENTRY32W)]
+k32.Process32NextW.restype = wt.BOOL
+snap = k32.CreateToolhelp32Snapshot(0x02, 0)
+print("snap %#x err=%d" % (snap or 0, ctypes.get_last_error()))
+pids = []
+if snap and snap != INVALID_HANDLE_VALUE:
+    pe = PROCESSENTRY32W(); pe.dwSize = ctypes.sizeof(PROCESSENTRY32W)
+    if k32.Process32FirstW(snap, ctypes.byref(pe)):
+        while True:
+            pids.append((pe.th32ProcessID, pe.szExeFile))
+            pe = PROCESSENTRY32W(); pe.dwSize = ctypes.sizeof(PROCESSENTRY32W)
+            if not k32.Process32NextW(snap, ctypes.byref(pe)):
+                break
+    k32.CloseHandle(snap)
+print("pids:", pids)
