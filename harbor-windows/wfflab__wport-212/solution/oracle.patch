diff --git a/wportalloc/health.py b/wportalloc/health.py
index e72c0d5..7bc7a2d 100644
--- a/wportalloc/health.py
+++ b/wportalloc/health.py
@@ -6,16 +6,23 @@ __all__ = ["check_service"]
 
 
 def check_service(host, port, timeout=1.0):
-    """探测 ``host:port`` 上是否有服务在监听，返回 True/False。"""
-    family, stype, proto, _cname, addr = socket.getaddrinfo(
-        host, port, type=socket.SOCK_STREAM
-    )[0]
-    s = socket.socket(family, stype, proto)
-    s.settimeout(timeout)
+    """按 getaddrinfo 返回顺序逐地址探测 ``host:port``。
+
+    Windows 上 ``localhost`` 先解析为 ``::1``；对仅监听 IPv4 的服务，
+    ``::1`` 上的连接尝试会超时而不是立即拒绝，因此必须逐地址回退。
+    """
     try:
-        s.connect(addr)
-        return True
-    except OSError:
+        infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
+    except socket.gaierror:
         return False
-    finally:
-        s.close()
+    for family, stype, proto, _cname, addr in infos:
+        s = socket.socket(family, stype, proto)
+        s.settimeout(timeout)
+        try:
+            s.connect(addr)
+            return True
+        except OSError:
+            continue
+        finally:
+            s.close()
