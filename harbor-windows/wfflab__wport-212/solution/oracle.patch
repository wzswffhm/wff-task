diff --git a/wportalloc/listener.py b/wportalloc/listener.py
index 0e65e1d..65fce95 100644
--- a/wportalloc/listener.py
+++ b/wportalloc/listener.py
@@ -2,13 +2,27 @@
 
 import socket
 
+from .errors import PortInUseError
+
 __all__ = ["allocate"]
 
+# 绑定失败时抛 PortInUseError 的 Win32 错误码：
+#   WSAEADDRINUSE(10048) / WSAEACCES(10013)
+_BUSY_WINERRORS = (10048, 10013)
+
 
 def allocate(port, host="127.0.0.1", backlog=16):
-    """创建监听 socket 并绑定到 ``host:port``，返回已 listen 的 socket。"""
+    """创建独占监听 socket 并绑定到 ``host:port``，返回已 listen 的 socket。"""
     s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
-    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
-    s.bind((host, port))
+    # Windows 上 SO_EXCLUSIVEADDRUSE 是「独占」的正确表达：其他进程的任何
+    # 绑定（包括 SO_REUSEADDR 的）都会失败，监听不可被劫持。
+    s.setsockopt(socket.SOL_SOCKET, socket.SO_EXCLUSIVEADDRUSE, 1)
+    try:
+        s.bind((host, port))
+    except OSError as exc:
+        s.close()
+        if exc.winerror in _BUSY_WINERRORS:
+            raise PortInUseError(port=port, host=host) from exc
+        raise
     s.listen(backlog)
     return s
diff --git a/wportalloc/probe.py b/wportalloc/probe.py
index caea2d0..db80d79 100644
--- a/wportalloc/probe.py
+++ b/wportalloc/probe.py
@@ -2,18 +2,28 @@
 
 import socket
 
+from .errors import WPortAllocError
+
 __all__ = ["is_port_free"]
 
+# 绑定失败时视为「端口被占」的 Win32 错误码：
+#   WSAEADDRINUSE(10048) / WSAEACCES(10013)
+_BUSY_WINERRORS = (10048, 10013)
+
 
 def is_port_free(port, host="127.0.0.1"):
-    """试探绑定 ``host:port``，返回端口是否空闲。"""
+    """排他试探绑定 ``host:port``，返回端口是否空闲。"""
     s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
     try:
-        # 跨平台资料里最常见的写法：探测前设置 SO_REUSEADDR
-        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        # Windows 上只有 SO_EXCLUSIVEADDRUSE 能让绑定结果真实反映占用状态：
+        # 若用 SO_REUSEADDR，遇到同样设置 SO_REUSEADDR 的存量监听会绑定
+        # 「成功」（静默共存），探测因此失真。
+        s.setsockopt(socket.SOL_SOCKET, socket.SO_EXCLUSIVEADDRUSE, 1)
         s.bind((host, port))
         return True
-    except OSError:
-        return False
+    except OSError as exc:
+        if exc.winerror in _BUSY_WINERRORS:
+            return False
+        raise WPortAllocError("probe", port=port, host=host) from exc
     finally:
         s.close()
