@@ -0,0 +1,204 @@
+"""Windows 进程树语义验证（新增测试，不改动既有测试）。
+
+覆盖三类真实故障状态：
+1. 超时后整棵进程树必须停止；
+2. 超时返回必须带着截止之前已经写出的输出（含大输出）；
+3. 直接子进程退出后 run() 立即返回，不为持有管道的后代等到预算耗尽。
+"""
+
+from __future__ import annotations
+
+import os
+import signal
+import sys
+import time
+
+import pytest
+
+from wproc import CommandFailed, CommandTimedOut, run
+
+PY = sys.executable
+
+pytestmark = pytest.mark.skipif(os.name != "nt", reason="Windows 专属语义")
+
+
+def _write(tmp_path, name, body):
+    p = tmp_path / name
+    p.write_text(body, encoding="utf-8")
+    return str(p)
+
+
+def _cleanup_pidfile(pidfile):
+    """最佳努力地结束后台孙进程：它把自己的 PID 写进了 pidfile。"""
+    try:
+        pid = int(open(pidfile).read().strip())
+    except (OSError, ValueError):
+        return
+    try:
+        os.kill(pid, signal.SIGTERM)
+    except OSError:
+        pass
+
+
+def test_timeout_kills_the_whole_process_tree(tmp_path):
+    marker = tmp_path / "grandchild_alive.txt"
+    grandchild = _write(
+        tmp_path,
+        "grandchild.py",
+        "import time\n"
+        "f = open(%r, 'w')\n"
+        "for _ in range(600):\n"
+        "    time.sleep(1)\n"
+        "    f.write('x')\n"
+        "    f.flush()\n" % str(marker),
+    )
+    # python -> cmd /c -> 真正干活的孙进程
+    child = _write(
+        tmp_path,
+        "child.py",
+        "import subprocess, sys\n"
+        "subprocess.run(['cmd', '/c', sys.executable, %r])\n" % grandchild,
+    )
+
+    t0 = time.monotonic()
+    result = run([PY, child], timeout=3)
+    elapsed = time.monotonic() - t0
+
+    assert result.timed_out is True
+    assert elapsed < 15
+
+    size1 = marker.stat().st_size if marker.exists() else 0
+    time.sleep(4)
+    size2 = marker.stat().st_size if marker.exists() else 0
+    assert size1 == size2, "超时返回后后代进程仍在活动"
+
+
+def test_timeout_does_not_touch_unrelated_processes(tmp_path):
+    # 一个与本次运行完全无关、但命令行长得很像的进程
+    bystander_pid = tmp_path / "bystander_pid.txt"
+    bystander = _write(
+        tmp_path,
+        "bystander.py",
+        "import os, time\n"
+        "open(%r, 'w').write(str(os.getpid()))\n"
+        "time.sleep(120)\n" % str(bystander_pid),
+    )
+    import subprocess
+
+    proc = subprocess.Popen([PY, bystander])
+    try:
+        sleeper = _write(tmp_path, "sleeper.py", "import time\ntime.sleep(300)\n")
+        result = run([PY, sleeper], timeout=3)
+        assert result.timed_out is True
+        time.sleep(1)
+        assert proc.poll() is None, "无关进程被误伤"
+    finally:
+        proc.kill()
+        proc.wait()
+
+
+def test_timeout_preserves_output_written_so_far():
+    code = (
+        "import sys, time\n"
+        "sys.stdout.write('BEFORE-TIMEOUT-MARK\\n')\n"
+        "sys.stdout.flush()\n"
+        "sys.stderr.write('STDERR-MARK\\n')\n"
+        "sys.stderr.flush()\n"
+        "time.sleep(300)\n"
+    )
+    result = run([PY, "-c", code], timeout=3)
+    assert result.timed_out is True
+    text = result.text()
+    assert "BEFORE-TIMEOUT-MARK" in text
+    assert "STDERR-MARK" in text
+
+
+def test_timeout_preserves_large_output():
+    code = (
+        "import sys, time\n"
+        "chunk = 'y' * 4096\n"
+        "sys.stdout.write('HEAD')\n"
+        "for _ in range(96):\n"  # 384 KiB，远超管道缓冲区
+        "    sys.stdout.write(chunk)\n"
+        "sys.stdout.flush()\n"
+        "time.sleep(300)\n"
+    )
+    result = run([PY, "-c", code], timeout=5)
+    assert result.timed_out is True
+    assert result.output.count(b"y") == 4096 * 96
+    assert b"HEAD" in result.output
+
+
+def test_finished_child_with_living_grandchild_returns_immediately(tmp_path):
+    pidfile = tmp_path / "grandchild_pid.txt"
+    grandchild = _write(
+        tmp_path,
+        "grandchild.py",
+        "import os, time\n"
+        "open(%r, 'w').write(str(os.getpid()))\n"
+        "time.sleep(300)\n" % str(pidfile),
+    )
+    # 子进程打印输出、启动继承输出管道的后台后代，然后立刻以退出码 0 退出
+    child = _write(
+        tmp_path,
+        "child.py",
+        "import subprocess, sys\n"
+        "print('CHILD-OUTPUT')\n"
+        "sys.stdout.flush()\n"
+        "subprocess.Popen([sys.executable, %r])\n" % grandchild,
+    )
+
+    try:
+        t0 = time.monotonic()
+        result = run([PY, child], timeout=30)
+        elapsed = time.monotonic() - t0
+
+        assert result.timed_out is False
+        assert result.returncode == 0
+        assert result.ok
+        assert "CHILD-OUTPUT" in result.text()
+        assert elapsed < 15, "为等待后代释放管道而拖慢了返回"
+    finally:
+        _cleanup_pidfile(str(pidfile))
+
+
+def test_nonzero_exit_with_living_grandchild(tmp_path):
+    pidfile = tmp_path / "grandchild_pid.txt"
+    grandchild = _write(
+        tmp_path,
+        "grandchild.py",
+        "import os, time\n"
+        "open(%r, 'w').write(str(os.getpid()))\n"
+        "time.sleep(300)\n" % str(pidfile),
+    )
+    child = _write(
+        tmp_path,
+        "child.py",
+        "import subprocess, sys\n"
+        "subprocess.Popen([sys.executable, %r])\n"
+        "sys.exit(7)\n" % grandchild,
+    )
+    try:
+        t0 = time.monotonic()
+        result = run([PY, child], timeout=30)
+        elapsed = time.monotonic() - t0
+        assert result.timed_out is False
+        assert result.returncode == 7
+        assert not result.ok
+        assert elapsed < 15
+    finally:
+        _cleanup_pidfile(str(pidfile))
+
+
+def test_check_timeout_raises_with_full_result():
+    code = "import sys, time\nprint('partial')\nsys.stdout.flush()\ntime.sleep(300)\n"
+    with pytest.raises(CommandTimedOut) as excinfo:
+        run([PY, "-c", code], timeout=3, check=True)
+    assert excinfo.value.result.timed_out is True
+    assert "partial" in excinfo.value.result.text()
+
+
+def test_check_failure_raises_with_result():
+    with pytest.raises(CommandFailed) as excinfo:
+        run([PY, "-c", "import sys; sys.exit(5)"], timeout=30, check=True)
+    assert excinfo.value.result.returncode == 5
