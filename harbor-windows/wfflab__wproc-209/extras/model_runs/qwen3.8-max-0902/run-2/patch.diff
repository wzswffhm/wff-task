+"""临时验证脚本 2：更多真实 Windows 场景。用完即删。"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+from wproc import CommandFailed, CommandNotStarted, CommandTimedOut, run
+from wproc import _win32
+
+PY = sys.executable
+FAILURES = []
+
+
+def check(name, cond, extra=""):
+    if cond:
+        print("PASS %s %s" % (name, extra), flush=True)
+    else:
+        print("FAIL %s %s" % (name, extra), flush=True)
+        FAILURES.append(name)
+
+
+def write(path, text):
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write(text)
+
+
+def pids_in(text):
+    out = []
+    for line in text.splitlines():
+        line = line.strip()
+        if line.startswith("PID "):
+            try:
+                out.append(int(line.split()[1]))
+            except (IndexError, ValueError):
+                pass
+    return out
+
+
+def alive(pid):
+    return _win32.is_alive(pid)
+
+
+def main():
+    work = tempfile.mkdtemp(prefix="wproc-check2-")
+
+    # ---- A：分块写 5 MiB 然后卡住（管道只有 8 KiB，考验不会死锁） ----
+    flood = os.path.join(work, "flood.py")
+    write(
+        flood,
+        "import sys, time\n"
+        "chunk = 'x' * 4096\n"
+        "for i in range(1280):\n"
+        "    sys.stdout.write(chunk)\n"
+        "sys.stdout.flush()\n"
+        "print('FLOOD-DONE', flush=True)\n"
+        "time.sleep(180)\n",
+    )
+    started = time.monotonic()
+    result = run([PY, flood], timeout=6)
+    elapsed = time.monotonic() - started
+    check("flood-timeout", result.timed_out is True, "(%.2fs)" % elapsed)
+    check("flood-size", result.output.count(b"x") == 4096 * 1280, str(result.output.count(b"x")))
+    check("flood-tail", b"FLOOD-DONE" in result.output)
+    check("flood-fast", elapsed < 25, "(%.2fs)" % elapsed)
+
+    # ---- B：分块写 5 MiB 后正常退出，不给 timeout ----
+    flood2 = os.path.join(work, "flood2.py")
+    write(
+        flood2,
+        "import sys\n"
+        "chunk = 'x' * 4096\n"
+        "for i in range(1280):\n"
+        "    sys.stdout.write(chunk)\n"
+        "print('END', flush=True)\n",
+    )
+    started = time.monotonic()
+    result = run([PY, flood2])
+    elapsed = time.monotonic() - started
+    check("flood2-ok", result.ok and not result.timed_out, "(%.2fs)" % elapsed)
+    check("flood2-size", result.output.count(b"x") == 4096 * 1280, str(result.output.count(b"x")))
+    check("flood2-end", b"END" in result.output)
+
+    # ---- C：子进程自己关掉 stdout，之后继续跑 ----
+    closer = os.path.join(work, "closer.py")
+    write(
+        closer,
+        "import sys, time\n"
+        "print('BEFORE-CLOSE', flush=True)\n"
+        "sys.stdout.close()\n"
+        "time.sleep(1)\n"
+        "sys.exit(5)\n",
+    )
+    started = time.monotonic()
+    result = run([PY, closer], timeout=30)
+    elapsed = time.monotonic() - started
+    check("closer-rc", result.returncode == 5 and not result.timed_out, repr(result.returncode))
+    check("closer-fast", elapsed < 10, "(%.2fs)" % elapsed)
+    check("closer-output", b"BEFORE-CLOSE" in result.output)
+
+    # 关掉 stdout 之后一直不退出 -> 必须超时
+    closer2 = os.path.join(work, "closer2.py")
+    write(
+        closer2,
+        "import sys, time\n"
+        "print('BEFORE-CLOSE', flush=True)\n"
+        "sys.stdout.close()\n"
+        "time.sleep(180)\n",
+    )
+    started = time.monotonic()
+    result = run([PY, closer2], timeout=3)
+    elapsed = time.monotonic() - started
+    check("closer2-timeout", result.timed_out is True, "(%.2fs)" % elapsed)
+    check("closer2-fast", elapsed < 20, "(%.2fs)" % elapsed)
+    check("closer2-output", b"BEFORE-CLOSE" in result.output)
+
+    # ---- D：四层进程链 + 会不断重启后代的中间层 ----
+    leaf = os.path.join(work, "leaf.py")
+    write(leaf, "import os, time\nprint('PID', os.getpid(), flush=True)\ntime.sleep(180)\n")
+    supervisor = os.path.join(work, "supervisor.py")
+    write(
+        supervisor,
+        "import os, subprocess, sys, time\n"
+        "print('PID', os.getpid(), flush=True)\n"
+        "while True:\n"
+        "    p = subprocess.Popen([sys.executable, r'%s'])\n"
+        "    print('PID', p.pid, flush=True)\n"
+        "    time.sleep(0.2)\n" % leaf,
+    )
+    middle = os.path.join(work, "middle.py")
+    write(
+        middle,
+        "import os, subprocess, sys, time\n"
+        "print('PID', os.getpid(), flush=True)\n"
+        "p = subprocess.Popen([os.environ.get('ComSpec', 'cmd.exe'), '/c', sys.executable, r'%s'])\n"
+        "print('PID', p.pid, flush=True)\n"
+        "time.sleep(180)\n" % supervisor,
+    )
+    top = os.path.join(work, "top2.py")
+    write(
+        top,
+        "import os, subprocess, sys, time\n"
+        "print('PID', os.getpid(), flush=True)\n"
+        "p = subprocess.Popen([sys.executable, r'%s'])\n"
+        "print('PID', p.pid, flush=True)\n"
+        "time.sleep(180)\n" % middle,
+    )
+    started = time.monotonic()
+    result = run([PY, top], timeout=5)
+    elapsed = time.monotonic() - started
+    check("deep-timeout", result.timed_out is True, "(%.2fs)" % elapsed)
+    pids = pids_in(result.text())
+    check("deep-saw-pids", len(pids) >= 4, str(pids))
+    time.sleep(4)
+    survivors = [p for p in pids if alive(p)]
+    check("deep-tree-dead", not survivors, str(survivors))
+    # 顺手确认没有留下孤儿 python
+    for p in survivors:
+        _win32.terminate_pid(p)
+
+    # ---- E：timeout=None 时，子进程结束但后代握着管道 ----
+    daemon = os.path.join(work, "daemon.py")
+    write(daemon, "import os, time\nprint('PID', os.getpid(), flush=True)\ntime.sleep(60)\n")
+    parent = os.path.join(work, "parent2.py")
+    write(
+        parent,
+        "import subprocess, sys\n"
+        "p = subprocess.Popen([sys.executable, r'%s'])\n"
+        "print('PID', p.pid, flush=True)\n"
+        "print('PARENT-DONE', flush=True)\n"
+        "sys.exit(0)\n" % daemon,
+    )
+    started = time.monotonic()
+    result = run([PY, parent])
+    elapsed = time.monotonic() - started
+    check("notimeout-daemon-fast", elapsed < 5, "(%.2fs)" % elapsed)
+    check("notimeout-daemon-ok", result.ok and b"PARENT-DONE" in result.output)
+    dpids = pids_in(result.text())
+    check("notimeout-daemon-alive", bool(dpids) and alive(dpids[-1]), str(dpids))
+    for p in dpids:
+        _win32.terminate_pid(p)
+
+    # ---- F：并发两次 run，互不干扰 ----
+    unrelated = subprocess.Popen([PY, "-c", "import time; time.sleep(45)"])
+    results = {}
+
+    def worker(key, cmd, to):
+        results[key] = run(cmd, timeout=to)
+
+    threads = [
+        threading.Thread(target=worker, args=("a", [PY, top], 4)),
+        threading.Thread(target=worker, args=("b", [PY, "-c", "print('B-OK')"], 30)),
+        threading.Thread(target=worker, args=("c", [PY, top], 6)),
+    ]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    check("concurrent-a", results["a"].timed_out is True)
+    check("concurrent-b", results["b"].ok and b"B-OK" in results["b"].output)
+    check("concurrent-c", results["c"].timed_out is True)
+    time.sleep(2)
+    check("concurrent-unrelated", unrelated.poll() is None)
+    leftovers = []
+    for key in ("a", "c"):
+        leftovers += [p for p in pids_in(results[key].text()) if alive(p)]
+    check("concurrent-clean", not leftovers, str(leftovers))
+    for p in leftovers:
+        _win32.terminate_pid(p)
+    unrelated.kill()
+    unrelated.wait()
+
+    # ---- G：直接子进程就是 cmd.exe ----
+    batch = os.path.join(work, "job.bat")
+    write(batch, "@echo off\r\necho BATCH-START\r\n%SystemRoot%\\System32\\ping.exe -n 60 127.0.0.1 > nul\r\n")
+    started = time.monotonic()
+    result = run([os.environ.get("ComSpec", "cmd.exe"), "/c", batch], timeout=3)
+    elapsed = time.monotonic() - started
+    check("batch-timeout", result.timed_out is True, "(%.2fs)" % elapsed)
+    check("batch-output", b"BATCH-START" in result.output, repr(result.text()[:60]))
+    time.sleep(2)
+    ping = subprocess.run(
+        ["tasklist", "/FI", "IMAGENAME eq ping.exe", "/FO", "CSV"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.DEVNULL,
+        creationflags=0x08000000,
+    ).stdout.decode("utf-8", "replace")
+    check("batch-ping-gone", "ping.exe" not in ping, ping.strip().splitlines()[-1:])
+
+    # ---- H：命令不存在 ----
+    try:
+        run(["definitely-not-a-real-command-xyz"], timeout=5)
+        check("not-started", False)
+    except CommandNotStarted:
+        check("not-started", True)
+
+    # ---- I：cwd / env 仍然有效 ----
+    sub = os.path.join(work, "sub")
+    os.makedirs(sub, exist_ok=True)
+    result = run([PY, "-c", "import os; print(os.getcwd())"], cwd=sub, timeout=20)
+    check("cwd", os.path.normcase(sub) in os.path.normcase(result.text().strip()), result.text().strip())
+    result = run(
+        [PY, "-c", "import os; print(os.environ.get('WPROC_ONLY', 'missing'))"],
+        env={"SystemRoot": os.environ.get("SystemRoot", r"C:\Windows"), "WPROC_ONLY": "here"},
+        timeout=20,
+    )
+    check("env", "here" in result.text(), result.text().strip())
+
+    # ---- J：check=True 的两条路 ----
+    try:
+        run([PY, "-c", "import sys; print('x'); sys.exit(2)"], timeout=10, check=True)
+        check("check-failed", False)
+    except CommandFailed as exc:
+        check("check-failed", exc.result.returncode == 2 and not exc.result.timed_out)
+    try:
+        run([PY, "-c", "import time; time.sleep(60)"], timeout=2, check=True)
+        check("check-timeout", False)
+    except CommandTimedOut as exc:
+        check("check-timeout", exc.result.timed_out is True and exc.timeout == 2)
+
+    print()
+    print("FAILURES:", FAILURES)
+    return 1 if FAILURES else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
