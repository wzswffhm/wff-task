+"""临时探针 2：管道缓冲区到底多大、子进程何时退出。用完即删。"""
+
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+from wproc import _win32
+
+PY = sys.executable
+work = tempfile.mkdtemp(prefix="wproc-probe2-")
+progress = os.path.join(work, "progress.txt")
+
+child = (
+    "import os, sys, time\n"
+    "log = open(r'%s', 'w', buffering=1)\n"
+    "log.write('start %%.3f' %% time.time())\n"
+    "data = 'y' * 100000\n"
+    "for i in range(0, 100000, 4096):\n"
+    "    sys.stdout.write(data[i:i+4096])\n"
+    "    log.write('\\nwrote %%d %%.3f' %% (i + 4096, time.time()))\n"
+    "sys.stdout.flush()\n"
+    "log.write('\\nflushed %%.3f' %% time.time())\n"
+    "log.close()\n" % progress
+)
+
+started = time.monotonic()
+p = subprocess.Popen([PY, "-c", child], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+handle = _win32.handle_of(p.stdout)
+for i in range(12):
+    time.sleep(0.5)
+    alive = p.poll() is None
+    avail = _win32.peek_available(handle)
+    print("t=%.1f alive=%r avail=%r" % (time.monotonic() - started, alive, avail), flush=True)
+    if os.path.exists(progress):
+        with open(progress, encoding="utf-8") as fh:
+            tail = fh.read().replace("\n", "|")[-110:]
+        print("    progress: %s" % tail, flush=True)
+    if not alive and i > 1:
+        break
+
+print("draining...")
+total = b""
+while True:
+    n = _win32.peek_available(handle)
+    if n < 0:
+        print("EOF, total=%d" % len(total))
+        break
+    if n == 0:
+        print("no data, total=%d, alive=%r" % (len(total), p.poll() is None))
+        break
+    total += os.read(p.stdout.fileno(), n)
+print("exit=%r after %.2fs" % (p.poll(), time.monotonic() - started))
+p.stdout.close()
