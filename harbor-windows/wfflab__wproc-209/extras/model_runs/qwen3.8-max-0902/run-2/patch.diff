@@ -0,0 +1,74 @@
+"""临时探针：确认 PeekNamedPipe 在写端关闭后的语义。用完即删。"""
+
+import os
+import subprocess
+import sys
+import time
+
+from wproc import _win32
+
+PY = sys.executable
+
+
+def probe(size):
+    p = subprocess.Popen(
+        [PY, "-c", "import sys;sys.stdout.write('y'*%d);sys.stdout.flush()" % size],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+    )
+    # 等子进程自己退出
+    deadline = time.monotonic() + 20
+    while p.poll() is None and time.monotonic() < deadline:
+        time.sleep(0.05)
+    print("size=%d poll=%r" % (size, p.returncode))
+    handle = _win32.handle_of(p.stdout)
+    print("  peek right after exit:", _win32.peek_available(handle))
+    total = b""
+    rounds = 0
+    while rounds < 100:
+        rounds += 1
+        n = _win32.peek_available(handle)
+        if n < 0:
+            print("  EOF after %d rounds, got %d bytes" % (rounds, len(total)))
+            break
+        if n == 0:
+            print("  0 available after %d rounds, got %d bytes" % (rounds, len(total)))
+            break
+        total += os.read(p.stdout.fileno(), n)
+    p.stdout.close()
+
+
+def probe_blocked(size):
+    """子进程写满管道后会不会阻塞（管道缓冲区有多大）。"""
+    p = subprocess.Popen(
+        [
+            PY,
+            "-c",
+            "import sys;sys.stdout.write('y'*%d);sys.stdout.flush();print('DONE')" % size,
+        ],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+    )
+    time.sleep(1.0)
+    handle = _win32.handle_of(p.stdout)
+    print("blocked-probe size=%d alive=%r avail=%r" % (size, p.poll() is None, _win32.peek_available(handle)))
+    total = b""
+    while True:
+        n = _win32.peek_available(handle)
+        if n <= 0:
+            if p.poll() is not None and n < 0:
+                break
+            if n == 0 and p.poll() is not None:
+                break
+            time.sleep(0.01)
+            continue
+        total += os.read(p.stdout.fileno(), n)
+    p.wait()
+    print("  drained %d bytes, DONE=%r" % (len(total), b"DONE" in total))
+    p.stdout.close()
+
+
+probe(100)
+probe(100000)
+probe_blocked(100000)
+probe_blocked(4096)
