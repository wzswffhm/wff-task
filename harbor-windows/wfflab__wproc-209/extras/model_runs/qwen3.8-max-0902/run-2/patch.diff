@@ -0,0 +1,211 @@
+"""临时验证脚本：真实 Windows 场景。用完即删。"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+from wproc import CommandFailed, CommandTimedOut, run
+from wproc import _win32
+
+PY = sys.executable
+FAILURES = []
+
+
+def check(name, cond, extra=""):
+    if cond:
+        print("PASS %s %s" % (name, extra))
+    else:
+        print("FAIL %s %s" % (name, extra))
+        FAILURES.append(name)
+
+
+def write(path, text):
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write(text)
+
+
+def pids_in(text):
+    out = []
+    for line in text.splitlines():
+        line = line.strip()
+        if line.startswith("PID "):
+            try:
+                out.append(int(line.split()[1]))
+            except (IndexError, ValueError):
+                pass
+    return out
+
+
+def alive(pid):
+    return _win32.is_alive(pid)
+
+
+def main():
+    work = tempfile.mkdtemp(prefix="wproc-check-")
+
+    leaf = os.path.join(work, "leaf.py")
+    write(
+        leaf,
+        "import sys, time\n"
+        "print('PID', __import__('os').getpid(), flush=True)\n"
+        "time.sleep(180)\n",
+    )
+
+    mid = os.path.join(work, "mid.py")
+    write(
+        mid,
+        "import os, subprocess, sys, time\n"
+        "print('PID', os.getpid(), flush=True)\n"
+        # 经过 cmd /c 再起一层，模拟真实的构建链条
+        "p = subprocess.Popen([os.environ.get('ComSpec', 'cmd.exe'), '/c', sys.executable, r'%s'])\n"
+        "time.sleep(180)\n" % leaf,
+    )
+
+    top = os.path.join(work, "top.py")
+    write(
+        top,
+        "import os, subprocess, sys, time\n"
+        "print('PID', os.getpid(), flush=True)\n"
+        "p = subprocess.Popen([sys.executable, r'%s'])\n"
+        "print('PID', p.pid, flush=True)\n"
+        "time.sleep(180)\n" % mid,
+    )
+
+    # ---- 场景 1：超时之后整棵进程树都要停 ----
+    started = time.monotonic()
+    result = run([PY, top], timeout=4)
+    elapsed = time.monotonic() - started
+    check("timeout-flag", result.timed_out is True)
+    check("timeout-fast", elapsed < 20, "(%.2fs)" % elapsed)
+    pids = pids_in(result.text())
+    check("saw-tree", len(pids) >= 3, str(pids))
+    time.sleep(3)
+    survivors = [p for p in pids if alive(p)]
+    check("tree-dead", not survivors, str(survivors))
+    for p in survivors:
+        _win32.terminate_pid(p)
+
+    # ---- 场景 2：超时也要保住已经写出来的输出（含几百 KiB） ----
+    noisy = os.path.join(work, "noisy.py")
+    write(
+        noisy,
+        "import sys, time\n"
+        "sys.stdout.write('EARLY-MARKER\\n')\n"
+        "sys.stderr.write('EARLY-ERR\\n')\n"
+        "chunk = 'x' * 4096\n"
+        "for i in range(150):\n"
+        "    sys.stdout.write(chunk)\n"
+        "sys.stdout.write('TAIL-MARKER\\n')\n"
+        "sys.stdout.flush()\n"
+        "time.sleep(180)\n",
+    )
+    started = time.monotonic()
+    result = run([PY, noisy], timeout=5)
+    elapsed = time.monotonic() - started
+    check("noisy-timeout", result.timed_out is True, "(%.2fs)" % elapsed)
+    check("noisy-early", b"EARLY-MARKER" in result.output)
+    check("noisy-stderr", b"EARLY-ERR" in result.output)
+    check("noisy-size", result.output.count(b"x") == 4096 * 150, str(result.output.count(b"x")))
+    check("noisy-tail", b"TAIL-MARKER" in result.output)
+
+    # ---- 场景 3：子进程自己结束，后代还握着管道 ----
+    daemon = os.path.join(work, "daemon.py")
+    write(daemon, "import time\nprint('DAEMON-UP', flush=True)\ntime.sleep(90)\n")
+    parent = os.path.join(work, "parent.py")
+    write(
+        parent,
+        "import subprocess, sys, time\n"
+        "p = subprocess.Popen([sys.executable, r'%s'])\n"
+        "print('PID', p.pid, flush=True)\n"
+        "sys.stdout.write('PARENT-DONE\\n')\n"
+        "sys.stdout.flush()\n"
+        "sys.exit(7)\n" % daemon,
+    )
+    started = time.monotonic()
+    result = run([PY, parent], timeout=30)
+    elapsed = time.monotonic() - started
+    check("daemon-fast", elapsed < 5, "(%.2fs)" % elapsed)
+    check("daemon-not-timeout", result.timed_out is False)
+    check("daemon-rc", result.returncode == 7, repr(result.returncode))
+    check("daemon-output", "PARENT-DONE" in result.text(), repr(result.text()[:120]))
+    dpids = pids_in(result.text())
+    check("daemon-alive", bool(dpids) and alive(dpids[0]), str(dpids))
+    for p in dpids:
+        _win32.terminate_pid(p)
+
+    # ---- 场景 3b：子进程结束前写了几百 KiB，后代握着管道 ----
+    bigparent = os.path.join(work, "bigparent.py")
+    write(
+        bigparent,
+        "import subprocess, sys\n"
+        "p = subprocess.Popen([sys.executable, r'%s'])\n"
+        "sys.stdout.write('x' * 4096 * 150)\n"
+        "sys.stdout.write('BIG-DONE\\n')\n"
+        "sys.stdout.flush()\n"
+        "sys.exit(0)\n" % daemon,
+    )
+    started = time.monotonic()
+    result = run([PY, bigparent], timeout=30)
+    elapsed = time.monotonic() - started
+    check("big-fast", elapsed < 5, "(%.2fs)" % elapsed)
+    check("big-not-timeout", result.timed_out is False)
+    check("big-size", result.output.count(b"x") == 4096 * 150, str(result.output.count(b"x")))
+    check("big-tail", b"BIG-DONE" in result.output)
+    for p in pids_in(result.text()):
+        _win32.terminate_pid(p)
+
+    # ---- 场景 4：不得波及无关进程 ----
+    unrelated = subprocess.Popen([PY, "-c", "import time; time.sleep(60)"])
+    result = run([PY, top], timeout=3)
+    time.sleep(2)
+    check("unrelated-alive", unrelated.poll() is None)
+    check("run2-timeout", result.timed_out is True)
+    for p in pids_in(result.text()):
+        if alive(p):
+            _win32.terminate_pid(p)
+    unrelated.kill()
+    unrelated.wait()
+
+    # ---- 场景 5：非零退出码原样返回 ----
+    result = run([PY, "-c", "import sys; print('bye'); sys.exit(9)"], timeout=20)
+    check("rc9", result.returncode == 9 and result.timed_out is False and b"bye" in result.output)
+
+    # ---- 场景 6：check=True ----
+    try:
+        run([PY, "-c", "import sys; print('boom'); sys.exit(4)"], timeout=20, check=True)
+        check("check-failed", False)
+    except CommandFailed as exc:
+        check("check-failed", exc.result.returncode == 4 and b"boom" in exc.result.output)
+    try:
+        run([PY, "-c", "import time; time.sleep(60)"], timeout=2, check=True)
+        check("check-timeout", False)
+    except CommandTimedOut as exc:
+        check("check-timeout", exc.result.timed_out is True and exc.timeout == 2)
+
+    # ---- 场景 7：超时前已经输出了报错信息 ----
+    late = os.path.join(work, "late.py")
+    write(
+        late,
+        "import sys, time\n"
+        "sys.stderr.write('BUILD-ERROR-42\\n')\n"
+        "sys.stderr.flush()\n"
+        "time.sleep(180)\n",
+    )
+    result = run([PY, late], timeout=3)
+    check("late-error", result.timed_out is True and b"BUILD-ERROR-42" in result.output)
+
+    # ---- 场景 8：无 timeout 的正常命令 ----
+    result = run([PY, "-c", "print('no-timeout-ok')"])
+    check("no-timeout", result.ok and b"no-timeout-ok" in result.output)
+
+    print()
+    print("FAILURES:", FAILURES)
+    return 1 if FAILURES else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
