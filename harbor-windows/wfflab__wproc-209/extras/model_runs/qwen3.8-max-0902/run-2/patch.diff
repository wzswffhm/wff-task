+"""临时探针 4：分块写入时管道容量到底多大。用完即删。"""
+
+import os
+import subprocess
+import sys
+import time
+
+from wproc import _win32
+
+PY = sys.executable
+
+
+def chunked(total, chunk):
+    child = (
+        "import os, time\n"
+        "data = b'y' * %d\n"
+        "n = 0\n"
+        "while n < len(data):\n"
+        "    n += os.write(1, data[n:n+%d])\n"
+        "time.sleep(5)\n" % (total, chunk)
+    )
+    p = subprocess.Popen([PY, "-c", child], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    handle = _win32.handle_of(p.stdout)
+    peak = 0
+    for _ in range(30):
+        time.sleep(0.1)
+        avail = _win32.peek_available(handle)
+        peak = max(peak, avail)
+        if p.poll() is not None:
+            break
+    print("total=%d chunk=%d alive=%r peak_avail=%d" % (total, chunk, p.poll() is None, peak), flush=True)
+    subprocess.Popen(["taskkill", "/F", "/T", "/PID", str(p.pid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).wait()
+    p.stdout.close()
+
+
+chunked(600000, 4096)
+chunked(600000, 600000)
+chunked(1000000, 8192)
