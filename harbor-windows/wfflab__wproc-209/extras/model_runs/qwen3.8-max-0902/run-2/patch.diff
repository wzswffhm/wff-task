+"""临时探针 3：管道容量与 PeekNamedPipe 的准确性。用完即删。"""
+
+import os
+import subprocess
+import sys
+import time
+
+from wproc import _win32
+
+PY = sys.executable
+
+
+def capacity(size):
+    child = (
+        "import sys, time\n"
+        "sys.stdout.write('y' * %d)\n"
+        "sys.stdout.flush()\n"
+        "time.sleep(5)\n" % size
+    )
+    p = subprocess.Popen([PY, "-c", child], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    handle = _win32.handle_of(p.stdout)
+    time.sleep(1.5)
+    samples = [_win32.peek_available(handle) for _ in range(3)]
+    print("write=%7d alive=%r avail=%r" % (size, p.poll() is None, samples), flush=True)
+    # 读一次，看看是否会被阻塞住（请求量远大于实际可用量）
+    started = time.monotonic()
+    got = os.read(p.stdout.fileno(), 10 ** 7)
+    took = time.monotonic() - started
+    print("    big os.read returned %d bytes in %.3fs" % (len(got), took), flush=True)
+    time.sleep(0.2)
+    print("    after read avail=%r alive=%r" % (_win32.peek_available(handle), p.poll() is None), flush=True)
+    subprocess.Popen(["taskkill", "/F", "/T", "/PID", str(p.pid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).wait()
+    p.stdout.close()
+
+
+for n in (1000, 4096, 8192, 8193, 20000, 100000, 600000):
+    capacity(n)
