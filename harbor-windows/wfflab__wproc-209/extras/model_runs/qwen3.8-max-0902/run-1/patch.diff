+"""Ad-hoc verification of the Windows process-tree semantics.
+
+TEMPORARY - deleted right after running; must not end up in the final patch.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import os
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wproc import CommandFailed, CommandNotStarted, CommandTimedOut, run
+from wproc import processes
+
+PY = sys.executable
+TMP = tempfile.mkdtemp(prefix="wproc-verify-")
+STILL_ACTIVE = 259
+FAILURES = []
+
+
+def check(name, cond, extra=""):
+    mark = "PASS  " if cond else "FAIL  "
+    tail = ("   -> " + repr(extra)) if extra != "" else ""
+    print(mark + name + tail)
+    if not cond:
+        FAILURES.append(name)
+
+
+def alive(pid):
+    k = ctypes.windll.kernel32
+    h = k.OpenProcess(0x1000, False, int(pid))
+    if not h:
+        return False
+    code = ctypes.c_ulong()
+    ok = k.GetExitCodeProcess(h, ctypes.byref(code))
+    k.CloseHandle(h)
+    return bool(ok) and code.value == STILL_ACTIVE
+
+
+def script(name, body):
+    path = os.path.join(TMP, name)
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write(body)
+    return path
+
+
+def pids_of(result):
+    text = result.text()
+    if "PIDS=" not in text:
+        return []
+    return [int(x) for x in text.split("PIDS=")[1].split()[0].split(",")]
+
+
+def size_of(path):
+    return os.path.getsize(path) if os.path.exists(path) else -1
+
+
+HEARTBEAT = script(
+    "heartbeat.py",
+    "import sys, time\n"
+    "end = time.time() + float(sys.argv[2])\n"
+    "fh = open(sys.argv[1], 'a')\n"
+    "while time.time() < end:\n"
+    "    fh.write('beat\\n')\n"
+    "    fh.flush()\n"
+    "    time.sleep(0.2)\n",
+)
+HB = repr(HEARTBEAT)
+
+SLEEPER = script("sleeper.py", "import sys, time\ntime.sleep(float(sys.argv[1]))\n")
+SL = repr(SLEEPER)
+
+CHAIN = script(
+    "chain.py",
+    "import subprocess, sys, time\n"
+    "heart = sys.argv[1]\n"
+    "pids = []\n"
+    "pids.append(subprocess.Popen([sys.executable, " + HB + ", heart, '120'], close_fds=False).pid)\n"
+    "pids.append(subprocess.Popen([sys.executable, " + SL + ", '120']).pid)\n"
+    "pids.append(subprocess.Popen(['cmd', '/c', sys.executable, " + SL + ", '120']).pid)\n"
+    "print('PIDS=' + ','.join(str(p) for p in pids), flush=True)\n"
+    "time.sleep(120)\n",
+)
+
+MID = script(
+    "mid.py",
+    "import subprocess, sys, time\n"
+    "p = subprocess.Popen([sys.executable, " + HB + ", sys.argv[1], '120'], close_fds=False)\n"
+    "print('PIDS=' + str(p.pid), flush=True)\n"
+    "time.sleep(120)\n",
+)
+MIDR = repr(MID)
+
+DEEP = script(
+    "deep.py",
+    "import subprocess, sys, time\n"
+    "inner = subprocess.Popen(['cmd', '/c', sys.executable, " + MIDR + ", sys.argv[1]],\n"
+    "                         close_fds=False, stdout=subprocess.PIPE, text=True)\n"
+    "print(inner.stdout.readline().strip(), flush=True)\n"
+    "time.sleep(120)\n",
+)
+
+LINGER = script(
+    "linger.py",
+    "import subprocess, sys\n"
+    "p = subprocess.Popen([sys.executable, " + HB + ", sys.argv[1], '20'], close_fds=False)\n"
+    "print('child-done')\n"
+    "sys.exit(int(sys.argv[2]))\n",
+)
+
+BIG = script(
+    "big.py",
+    "import sys, time\n"
+    "sys.stderr.write('early-stderr\\n')\n"
+    "sys.stderr.flush()\n"
+    "sys.stdout.write('BEGIN\\n')\n"
+    "sys.stdout.write('x' * (4096 * 128))\n"
+    "sys.stdout.write('\\nEND\\n')\n"
+    "sys.stdout.flush()\n"
+    "time.sleep(120)\n",
+)
+
+BIGLINGER = script(
+    "biglinger.py",
+    "import subprocess, sys\n"
+    "p = subprocess.Popen([sys.executable, " + HB + ", sys.argv[1], '20'], close_fds=False)\n"
+    "sys.stdout.write('HEAD' + 'y' * (4096 * 100) + 'TAIL')\n"
+    "sys.stdout.flush()\n",
+)
+
+FAILSCRIPT = script("fail.py", "import sys\nprint('about-to-fail')\nsys.exit(7)\n")
+
+print("=" * 72)
+print("1. timeout must stop the whole tree (and nothing else)")
+print("=" * 72)
+bystander = subprocess.Popen([PY, SLEEPER, "60"])
+heart = os.path.join(TMP, "heart-1.txt")
+started = time.monotonic()
+res = run([PY, CHAIN, heart], timeout=3)
+elapsed = time.monotonic() - started
+pids = pids_of(res)
+size_a = size_of(heart)
+time.sleep(2.0)
+size_b = size_of(heart)
+check("timed_out is True", res.timed_out is True, res)
+check("returned right after the budget", 2.5 <= elapsed <= 6.0, elapsed)
+check("descendants are dead", pids and all(not alive(p) for p in pids), pids)
+check("heartbeat stopped growing", size_a == size_b and size_a > 0, (size_a, size_b))
+check("unrelated bystander untouched", alive(bystander.pid), bystander.pid)
+bystander.kill()
+bystander.wait()
+
+print()
+print("1b. deep chain python -> cmd -> python -> python, timeout")
+heart1b = os.path.join(TMP, "heart-1b.txt")
+res = run([PY, DEEP, heart1b], timeout=4)
+pids = pids_of(res)
+size_a = size_of(heart1b)
+time.sleep(1.5)
+size_b = size_of(heart1b)
+check("timed_out", res.timed_out is True, res)
+check("great-grandchild reported", bool(pids), res.text()[:200])
+check("deep descendants dead", pids and all(not alive(p) for p in pids), pids)
+check("deep heartbeat stopped", size_a == size_b and size_a > 0, (size_a, size_b))
+
+print()
+print("1c. same, but job objects unavailable -> taskkill/sweep fallback")
+original_prepare = processes._prepare_job
+processes._prepare_job = lambda popen: None
+try:
+    bystander2 = subprocess.Popen([PY, SLEEPER, "60"])
+    heart1c = os.path.join(TMP, "heart-1c.txt")
+    res = run([PY, CHAIN, heart1c], timeout=3)
+    pids = pids_of(res)
+    size_a = size_of(heart1c)
+    time.sleep(1.5)
+    size_b = size_of(heart1c)
+    check("timed_out", res.timed_out is True, res)
+    check("fallback killed descendants", pids and all(not alive(p) for p in pids), pids)
+    check("fallback stopped the heartbeat", size_a == size_b and size_a > 0, (size_a, size_b))
+    check("bystander untouched (fallback)", alive(bystander2.pid), bystander2.pid)
+    bystander2.kill()
+    bystander2.wait()
+finally:
+    processes._prepare_job = original_prepare
+
+print()
+print("=" * 72)
+print("2. output written before the kill must survive (hundreds of KiB)")
+print("=" * 72)
+res = run([PY, BIG], timeout=3)
+check("timed_out is True", res.timed_out is True, res)
+check("stdout kept in full", res.output.count(b"x") == 4096 * 128, len(res.output))
+check("BEGIN kept", b"BEGIN" in res.output)
+check("END kept", b"END" in res.output)
+check("stderr kept", b"early-stderr" in res.output)
+
+print()
+print("=" * 72)
+print("3. child exits while a descendant keeps the pipe open")
+print("=" * 72)
+heart3 = os.path.join(TMP, "heart-3.txt")
+started = time.monotonic()
+res = run([PY, LINGER, heart3, "0"], timeout=25)
+elapsed = time.monotonic() - started
+check("timed_out is False", res.timed_out is False, res)
+check("returncode is the real one", res.returncode == 0, res.returncode)
+check("output collected", "child-done" in res.text(), res.text()[:80])
+check("returned immediately, not at the budget", elapsed < 4.0, elapsed)
+check("ok is True", res.ok is True)
+check("lingering grandchild survived", size_of(heart3) > 0)
+
+print()
+print("3b. same, but the child exits non-zero")
+res = run([PY, LINGER, os.path.join(TMP, "heart-3b.txt"), "9"], timeout=25)
+check("timed_out is False", res.timed_out is False, res)
+check("non-zero returncode kept", res.returncode == 9, res.returncode)
+check("output kept", "child-done" in res.text(), res.text()[:80])
+
+print()
+print("3c. child writes 400 KiB, exits, descendant holds the pipe")
+res = run([PY, BIGLINGER, os.path.join(TMP, "heart-3c.txt")], timeout=25)
+check("timed_out is False", res.timed_out is False, res)
+check("returncode 0", res.returncode == 0, res.returncode)
+check("all 400 KiB kept", res.output.count(b"y") == 4096 * 100, len(res.output))
+check("HEAD/TAIL kept", b"HEAD" in res.output and b"TAIL" in res.output)
+
+print()
+print("=" * 72)
+print("4. non-zero exit code and check=True")
+print("=" * 72)
+res = run([PY, FAILSCRIPT], timeout=20)
+check("returncode preserved", res.returncode == 7, res.returncode)
+check("timed_out is False", res.timed_out is False)
+check("ok is False", res.ok is False)
+check("output present", "about-to-fail" in res.text())
+try:
+    run([PY, FAILSCRIPT], timeout=20, check=True)
+    check("CommandFailed raised", False)
+except CommandFailed as exc:
+    check("CommandFailed raised", True)
+    check(
+        "CommandFailed carries result",
+        exc.result.returncode == 7 and "about-to-fail" in exc.result.text(),
+    )
+try:
+    run([PY, SLEEPER, "60"], timeout=2, check=True)
+    check("CommandTimedOut raised", False)
+except CommandTimedOut as exc:
+    check("CommandTimedOut raised", True)
+    check("CommandTimedOut carries result", exc.result is not None and exc.result.timed_out is True)
+    check("CommandTimedOut carries timeout", exc.timeout == 2, exc.timeout)
+try:
+    run([PY, CHAIN, os.path.join(TMP, "heart-4.txt")], timeout=2, check=True)
+    check("CommandTimedOut on a tree", False)
+except CommandTimedOut as exc:
+    check("CommandTimedOut on a tree", True)
+    check("timed-out result keeps output", "PIDS=" in exc.result.text(), exc.result.text()[:60])
+
+print()
+print("=" * 72)
+print("5. no timeout at all")
+print("=" * 72)
+res = run([PY, "-c", "print('plain')"])
+check("plain run", res.returncode == 0 and "plain" in res.text() and res.timed_out is False, res)
+started = time.monotonic()
+res = run([PY, LINGER, os.path.join(TMP, "heart-5.txt"), "0"])
+took = time.monotonic() - started
+check("no-budget run returns fast", took < 4.0, took)
+check("no-budget run correct", res.timed_out is False and res.returncode == 0, res)
+
+print()
+print("5b. tiny / zero timeout")
+started = time.monotonic()
+res = run([PY, SLEEPER, "30"], timeout=0)
+took = time.monotonic() - started
+check("timeout=0 -> timed_out", res.timed_out is True, res)
+check("timeout=0 is immediate", took < 2.0, took)
+res = run([PY, SLEEPER, "30"], timeout=0.2)
+check("timeout=0.2 -> timed_out", res.timed_out is True, res)
+
+print()
+print("=" * 72)
+print("6. argument validation and CommandNotStarted")
+print("=" * 72)
+try:
+    run(["definitely-not-a-real-command-xyz"], timeout=5)
+    check("CommandNotStarted raised", False)
+except CommandNotStarted:
+    check("CommandNotStarted raised", True)
+try:
+    run("python -c print(1)", timeout=5)
+    check("string command rejected", False)
+except TypeError:
+    check("string command rejected", True)
+try:
+    run([], timeout=5)
+    check("empty command rejected", False)
+except ValueError:
+    check("empty command rejected", True)
+
+print()
+print("=" * 72)
+print("7. legacy processes.start_process / terminate_process kills the tree")
+print("=" * 72)
+heart7 = os.path.join(TMP, "heart-7.txt")
+proc = processes.start_process([PY, CHAIN, heart7])
+time.sleep(2.5)
+processes.terminate_process(proc)
+check("legacy returncode available", proc.returncode is not None, proc.returncode)
+time.sleep(1.0)
+size_a = size_of(heart7)
+time.sleep(1.5)
+size_b = size_of(heart7)
+check("legacy terminate stopped the heartbeat", size_a == size_b and size_a > 0, (size_a, size_b))
+
+print()
+print("=" * 72)
+print("8. concurrent runs do not interfere")
+print("=" * 72)
+results = {}
+
+
+def worker(idx):
+    heart = os.path.join(TMP, "heart-8-" + str(idx) + ".txt")
+    if idx % 2 == 0:
+        results[idx] = run([PY, CHAIN, heart], timeout=3)
+    else:
+        results[idx] = run([PY, "-c", "print('fast-" + str(idx) + "')"], timeout=30)
+
+
+threads = [threading.Thread(target=worker, args=(i,)) for i in range(6)]
+for t in threads:
+    t.start()
+for t in threads:
+    t.join()
+check("all concurrent runs finished", len(results) == 6, sorted(results))
+check(
+    "odd runs are clean",
+    all(results[i].returncode == 0 and not results[i].timed_out for i in (1, 3, 5)),
+)
+check("even runs timed out", all(results[i].timed_out for i in (0, 2, 4)))
+time.sleep(1.0)
+leftover = [p for i in (0, 2, 4) for p in pids_of(results[i]) if alive(p)]
+check("no concurrent descendant survived", not leftover, leftover)
+check("no stray reader threads", threading.active_count() < 12, threading.active_count())
+
+print()
+print("=" * 72)
+if FAILURES:
+    print("FAILURES:", FAILURES)
+    sys.exit(1)
+print("ALL CHECKS PASSED")
