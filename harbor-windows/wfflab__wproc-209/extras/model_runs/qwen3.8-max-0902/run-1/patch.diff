+"""Extra ad-hoc checks. TEMPORARY - deleted right after running."""
+
+from __future__ import annotations
+
+import ctypes
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wproc import run
+
+PY = sys.executable
+TMP = tempfile.mkdtemp(prefix="wproc-verify2-")
+STILL_ACTIVE = 259
+FAILURES = []
+
+
+def check(name, cond, extra=""):
+    print(("PASS  " if cond else "FAIL  ") + name + (("   -> " + repr(extra)) if extra != "" else ""))
+    if not cond:
+        FAILURES.append(name)
+
+
+def alive(pid):
+    k = ctypes.windll.kernel32
+    h = k.OpenProcess(0x1000, False, int(pid))
+    if not h:
+        return False
+    code = ctypes.c_ulong()
+    ok = k.GetExitCodeProcess(h, ctypes.byref(code))
+    k.CloseHandle(h)
+    return bool(ok) and code.value == STILL_ACTIVE
+
+
+def script(name, body):
+    path = os.path.join(TMP, name)
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write(body)
+    return path
+
+
+HEARTBEAT = script(
+    "heartbeat.py",
+    "import sys, time\n"
+    "end = time.time() + float(sys.argv[2])\n"
+    "fh = open(sys.argv[1], 'a')\n"
+    "while time.time() < end:\n"
+    "    fh.write('beat\\n')\n"
+    "    fh.flush()\n"
+    "    time.sleep(0.2)\n",
+)
+HB = repr(HEARTBEAT)
+
+print("9a. cmd /c start /b <worker>")
+START = script(
+    "starter.py",
+    "import subprocess, sys, time\n"
+    "p = subprocess.Popen(['cmd', '/c', 'start', '/b', '', sys.executable, " + HB + ", sys.argv[1], '120'])\n"
+    "print('started', flush=True)\n"
+    "time.sleep(120)\n",
+)
+heart = os.path.join(TMP, "h-9a.txt")
+res = run([PY, START, heart], timeout=3)
+time.sleep(1.5)
+a, b = (os.path.getsize(heart) if os.path.exists(heart) else -1,) * 2
+size_a = os.path.getsize(heart) if os.path.exists(heart) else -1
+time.sleep(1.5)
+size_b = os.path.getsize(heart) if os.path.exists(heart) else -1
+check("timed_out", res.timed_out is True, res)
+check("start /b worker stopped", size_a == size_b and size_a > 0, (size_a, size_b))
+
+print()
+print("9b. detached / new-process-group grandchild")
+DETACHED = script(
+    "detached.py",
+    "import subprocess, sys, time\n"
+    "flags = 0x00000008 | 0x00000200  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP\n"
+    "p = subprocess.Popen([sys.executable, " + HB + ", sys.argv[1], '120'], creationflags=flags)\n"
+    "print('PIDS=' + str(p.pid), flush=True)\n"
+    "time.sleep(120)\n",
+)
+heart9b = os.path.join(TMP, "h-9b.txt")
+res = run([PY, DETACHED, heart9b], timeout=3)
+pids = []
+if "PIDS=" in res.text():
+    pids = [int(x) for x in res.text().split("PIDS=")[1].split()[0].split(",")]
+time.sleep(1.0)
+check("timed_out", res.timed_out is True, res)
+check("detached grandchild dead", pids and all(not alive(p) for p in pids), (pids, res.text()[:120]))
+
+print()
+print("9c. stdout/stderr keep their interleaving")
+res = run([PY, "-c", "import sys;sys.stdout.write('A\\n');sys.stdout.flush();"
+                     "sys.stderr.write('B\\n');sys.stderr.flush();"
+                     "sys.stdout.write('C\\n')"], timeout=20)
+check("interleaved order", res.text().replace("\r\n", "\n") == "A\nB\nC\n", res.text())
+
+print()
+print("9d. a command that produces no output at all")
+res = run([PY, "-c", "pass"], timeout=20)
+check("empty output", res.output == b"" and res.returncode == 0 and res.timed_out is False, res)
+
+print()
+print("9e. cwd + env still honoured together with the job object")
+work = os.path.join(TMP, "wd")
+os.makedirs(work)
+env = {"SystemRoot": os.environ.get("SystemRoot", r"C:\Windows"), "WPROC_MARK": "yes"}
+res = run(
+    [PY, "-c", "import os;print(os.getcwd());print(os.environ.get('WPROC_MARK','<missing>'));"
+               "print('parent=' + ('present' if 'WPROC_ONLY' in os.environ else 'absent'))"],
+    cwd=work,
+    env=env,
+    timeout=20,
+)
+text = res.text()
+check("cwd honoured", work.lower() in text.lower(), text)
+check("env honoured", "yes" in text, text)
+
+print()
+print("9f. many short runs in a row do not leak handles")
+import ctypes.wintypes  # noqa: F401
+
+before = ctypes.windll.kernel32.GetProcessHandleCount if False else None
+k = ctypes.windll.kernel32
+h_before = ctypes.c_ulong()
+k.GetProcessHandleCount(k.GetCurrentProcess(), ctypes.byref(h_before))
+for _ in range(40):
+    run([PY, "-c", "print('x')"], timeout=20)
+h_after = ctypes.c_ulong()
+k.GetProcessHandleCount(k.GetCurrentProcess(), ctypes.byref(h_after))
+check("handle count stable", h_after.value - h_before.value < 20, (h_before.value, h_after.value))
+
+print()
+print("=" * 72)
+if FAILURES:
+    print("FAILURES:", FAILURES)
+    sys.exit(1)
+print("ALL EXTRA CHECKS PASSED")
