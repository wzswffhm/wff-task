@@ -0,0 +1,320 @@
+"""Windows 原语：进程句柄、进程树枚举、Job Object 与输出管道。
+
+只使用标准库（``_winapi`` + ``ctypes``），不联网，也不依赖任何第三方库。
+
+这里所有函数遵守同一条纪律：**失败时返回一个可用的退化值，而不是抛
+异常**。监督子进程的逻辑绝不能因为单个系统调用失败就把异常抛给
+``run()`` 的调用方。
+"""
+
+from __future__ import annotations
+
+import ctypes
+import sys
+
+if sys.platform != "win32":  # pragma: no cover - 只在 Windows 上可用
+    raise ImportError("wproc._win32 is Windows-only")
+
+import _winapi
+import msvcrt
+
+__all__ = [
+    "SYNCHRONIZE",
+    "PROCESS_TERMINATE",
+    "PROCESS_SET_QUOTA",
+    "WAIT_OBJECT_0",
+    "JobObject",
+    "close_handle",
+    "create_pipe",
+    "descendant_pids",
+    "fd_from_handle",
+    "handle_alive",
+    "open_process",
+    "peek_pipe",
+    "pipe_handle_of",
+    "process_pairs",
+    "read_pipe",
+    "terminate_process",
+    "wait_process",
+]
+
+# ---- 访问权限 / 等待状态 ----
+SYNCHRONIZE = 0x00100000
+PROCESS_TERMINATE = 0x0001
+PROCESS_SET_QUOTA = 0x0100
+
+WAIT_OBJECT_0 = 0x00000000
+
+# ---- Toolhelp32 进程快照 ----
+_TH32CS_SNAPPROCESS = 0x00000002
+
+# ---- Job Object ----
+_JOB_OBJECT_BASIC_PROCESS_ID_LIST = 3
+
+_kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+_kernel32.CreateToolhelp32Snapshot.restype = ctypes.c_void_p
+_kernel32.CreateToolhelp32Snapshot.argtypes = [ctypes.c_ulong, ctypes.c_ulong]
+
+_kernel32.CloseHandle.restype = ctypes.c_int
+_kernel32.CloseHandle.argtypes = [ctypes.c_void_p]
+
+_kernel32.CreateJobObjectW.restype = ctypes.c_void_p
+_kernel32.CreateJobObjectW.argtypes = [ctypes.c_void_p, ctypes.c_wchar_p]
+
+_kernel32.AssignProcessToJobObject.restype = ctypes.c_int
+_kernel32.AssignProcessToJobObject.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
+
+_kernel32.TerminateJobObject.restype = ctypes.c_int
+_kernel32.TerminateJobObject.argtypes = [ctypes.c_void_p, ctypes.c_uint]
+
+_kernel32.QueryInformationJobObject.restype = ctypes.c_int
+_kernel32.QueryInformationJobObject.argtypes = [
+    ctypes.c_void_p,                    # hJob
+    ctypes.c_int,                       # JobObjectInformationClass
+    ctypes.c_void_p,                    # lpJobObjectInformation
+    ctypes.c_ulong,                     # cbJobObjectInformationLength
+    ctypes.POINTER(ctypes.c_ulong),     # lpReturnLength
+]
+
+
+# ---------------------------------------------------------------- 句柄与进程
+
+
+def open_process(pid, access) -> "int | None":
+    """按 PID 打开进程句柄；失败（含进程已退出）返回 ``None``。"""
+    if pid is None:
+        return None
+    try:
+        return _winapi.OpenProcess(int(access), False, int(pid))
+    except OSError:
+        return None
+
+
