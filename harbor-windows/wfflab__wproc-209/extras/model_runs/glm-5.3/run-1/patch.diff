new file mode 100644
index 0000000..d5e36dd
--- /dev/null
+++ b/_scratch/exp4.py
@@ -0,0 +1,44 @@
+import subprocess
+import sys
+import time
+import msvcrt
+import _winapi
+
+# Child writes 2 MiB to the pipe in 4 KiB chunks (unbuffered), parent does not read.
+child = (
+    "import os,sys\n"
+    "n=0\n"
+    "chunk=b'x'*4096\n"
+    "for i in range(512):\n"
+    "    os.write(1, chunk)\n"
+    "    n+=len(chunk)\n"
+    "open(sys.argv[1],'w').write(str(n))\n"
+    "os.write(1, b'DONE')\n"
+)
+import tempfile, os
+tmp = os.path.join(tempfile.gettempdir(), "wproc_exp4.txt")
+p = subprocess.Popen(
+    [sys.executable, "-u", "-c", child, tmp],
+    stdout=subprocess.PIPE,
+    stderr=subprocess.STDOUT,
+    stdin=subprocess.DEVNULL,
+    bufsize=0,
+)
+h = msvcrt.get_osfhandle(p.stdout.fileno())
+time.sleep(2.0)
+avail = _winapi.PeekNamedPipe(h, 0)[0]
+print("avail after 2s without reading:", avail)
+print("child still running:", p.poll() is None)
+# now drain
+total = 0
+t0 = time.time()
+while True:
+    a = _winapi.PeekNamedPipe(h, 0)[0]
+    if a == 0:
+        break
+    data = _winapi.ReadFile(h, 1 << 20)[0]
+    total += len(data)
+print("drained", total, "bytes in %.3fs" % (time.time() - t0))
+print("progress file:", open(tmp).read())
+p.wait(timeout=10)
+print("child rc:", p.returncode)
diff --git a/_scratch/exp5.py b/_scratch/exp5.py
new file mode 100644
index 0000000..27fa216
--- /dev/null
+++ b/_scratch/exp5.py
@@ -0,0 +1,152 @@
+import _winapi
+import ctypes
+import ctypes.wintypes as wt
+import msvcrt
+import os
+import subprocess
+import sys
+import time
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+# ---- pipe with big buffer ----
+rh, wh = _winapi.CreatePipe(None, 1 << 20)
+print("pipe handles:", rh, wh, flush=True)
+wfd = msvcrt.open_osfhandle(wh, 0)
+
+child_code = (
+    "import os, sys, time\n"
+    "os.write(1, b'started pid=' + str(os.getpid()).encode() + b'\\n')\n"
+    "import subprocess\n"
+    "subprocess.Popen([sys.executable, '-c', "
+    "\"import os,time;os.write(1,b'grand ' + str(os.getpid()).encode() + b'\\n');time.sleep(60)\"])\n"
+    "time.sleep(60)\n"
+)
+p = subprocess.Popen(
+    [sys.executable, "-u", "-c", child_code],
+    stdout=wfd,
+    stderr=subprocess.STDOUT,
+    stdin=subprocess.DEVNULL,
+    close_fds=True,
+)
+os.close(wfd)  # close parent's copy of the write end
+
+# ---- job object ----
+job = k32.CreateJobObjectW(None, None)
+print("job handle:", job, flush=True)
+
+class IO_COUNTERS(ctypes.Structure):
+    _fields_ = [(n, ctypes.c_ulonglong) for n in
+                ("ReadOperationCount", "WriteOperationCount", "OtherOperationCount",
+                 "ReadTransferCount", "WriteTransferCount", "OtherTransferCount")]
+
+class JOBOBJECT_BASIC_LIMIT_INFORMATION(ctypes.Structure):
+    _fields_ = [
+        ("PerProcessUserTimeLimit", ctypes.c_longlong),
+        ("PerJobUserTimeLimit", ctypes.c_longlong),
+        ("LimitFlags", ctypes.c_ulong),
+        ("MinimumWorkingSetSize", ctypes.c_size_t),
+        ("MaximumWorkingSetSize", ctypes.c_size_t),
+        ("ActiveProcessLimit", ctypes.c_ulong),
+        ("Affinity", ctypes.c_size_t),
+        ("PriorityClass", ctypes.c_ulong),
+        ("SchedulingClass", ctypes.c_ulong),
+    ]
+
+class JOBOBJECT_EXTENDED_LIMIT_INFORMATION(ctypes.Structure):
+    _fields_ = [
+        ("BasicLimitInformation", JOBOBJECT_BASIC_LIMIT_INFORMATION),
+        ("IoInfo", IO_COUNTERS),
+        ("ProcessMemoryLimit", ctypes.c_size_t),
+        ("JobMemoryLimit", ctypes.c_size_t),
+        ("PeakProcessMemoryUsed", ctypes.c_size_t),
+        ("PeakJobMemoryUsed", ctypes.c_size_t),
+    ]
+
+info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION()
+info.BasicLimitInformation.LimitFlags = 0  # no limits at all
+ok = k32.SetInformationJobObject(job, 9, ctypes.byref(info), ctypes.sizeof(info))
+print("SetInformationJobObject:", ok, ctypes.get_last_error(), flush=True)
+
+# open the child process
+PROC_SET_QUOTA = 0x0100
+PROC_TERMINATE = 0x0001
+SYNCHRONIZE = 0x00100000
+hproc = _winapi.OpenProcess(PROC_SET_QUOTA | PROC_TERMINATE | SYNCHRONIZE, False, p.pid)
+print("child handle:", hproc, flush=True)
+ok = k32.AssignProcessToJobObject(job, hproc)
+print("AssignProcessToJobObject:", ok, ctypes.get_last_error(), flush=True)
+
+# ---- read output ----
+def drain(t=2.0):
+    end = time.time() + t
+    out = b""
+    while time.time() < end:
+        try:
+            avail = _winapi.PeekNamedPipe(rh, 0)[0]
+        except OSError as e:
+            print("peek err:", e, flush=True)
+            break
+        if avail:
+            out += _winapi.ReadFile(rh, 1 << 16)[0]
+        else:
+            time.sleep(0.05)
+    return out
+
+out = drain(2.0)
+print("output:", out, flush=True)
+pids = [int(x.split(b"pid=")[1]) for x in out.split(b"\n") if b"pid=" in x]
+print("pids:", pids, flush=True)
+
+# ---- query job process list ----
+class JOBOBJECT_BASIC_PROCESS_ID_LIST(ctypes.Structure):
+    _fields_ = [
+        ("NumberOfAssignedProcesses", ctypes.c_ulong),
+        ("NumberOfProcessIdsInList", ctypes.c_ulong),
+        ("ProcessIdList", ctypes.c_size_t * 64),
+    ]
+
+def job_pids(job):
+    buf = JOBOBJECT_BASIC_PROCESS_ID_LIST()
+    ret = ctypes.c_ulong(0)
+    ok = k32.QueryInformationJobObject(
+        ctypes.c_void_p(job), 3, ctypes.byref(buf), ctypes.sizeof(buf), ctypes.byref(ret))
+    if not ok:
+        print("QueryInformationJobObject failed:", ctypes.get_last_error(), flush=True)
+        return None
+    n = buf.NumberOfProcessIdsInList
+    return [buf.ProcessIdList[i] for i in range(n)]
+
+print("job pids before kill:", job_pids(job), flush=True)
+
+# ---- terminate job ----
+ok = k32.TerminateJobObject(ctypes.c_void_p(job), 1)
+print("TerminateJobObject:", ok, flush=True)
+
+# wait for root to be dead
+st = _winapi.WaitForSingleObject(hproc, 5000)
+print("root wait status:", st, "(0 = signaled)", flush=True)
+
+for i in range(10):
+    lp = job_pids(job)
+    print("job pids after kill %d:" % i, lp, flush=True)
+    if not lp:
+        break
+    # check whether they are actually alive
+    for pid in lp:
+        try:
+            h = _winapi.OpenProcess(SYNCHRONIZE, False, pid)
+            if h:
+                s = _winapi.WaitForSingleObject(h, 0)
+                print("  pid", pid, "wait0 status:", s, flush=True)
+                _winapi.CloseHandle(h)
+        except OSError as e:
+            print("  pid", pid, "open failed:", e, flush=True)
+    time.sleep(0.3)
+
+print("child poll:", p.poll(), flush=True)
+out = drain(1.0)
+print("final output:", out, flush=True)
+k32.CloseHandle(ctypes.c_void_p(job))
+_winapi.CloseHandle(hproc)
+_winapi.CloseHandle(rh)
diff --git a/_scratch/exp6.py b/_scratch/exp6.py
new file mode 100644
index 0000000..da8399a
--- /dev/null
+++ b/_scratch/exp6.py
@@ -0,0 +1,105 @@
+import _winapi
+import ctypes
+import msvcrt
+import os
+import subprocess
+import sys
+import time
+import tempfile
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+# Write the grandchild script and the child script to temp files to avoid quoting hell.
+tmpdir = tempfile.mkdtemp(prefix="wproc_exp6_")
+grand = os.path.join(tmpdir, "grand.py")
+child = os.path.join(tmpdir, "child.py")
+with open(grand, "w") as f:
+    f.write(
+        "import os, sys, time\n"
+        "os.write(1, b'grandchild pid=' + str(os.getpid()).encode() + b'\\n')\n"
+        "os.write(2, b'to-stderr\\n')\n"
+        "for i in range(300):\n"
+        "    os.write(1, b'beat %d\\n' % i)\n"
+        "    time.sleep(0.1)\n"
+    )
+with open(child, "w") as f:
+    f.write(
+        "import os, sys, time, subprocess\n"
+        "os.write(1, b'child pid=' + str(os.getpid()).encode() + b'\\n')\n"
+        "subprocess.Popen([sys.executable, '-u', %r])\n" % grand +
+        "time.sleep(120)\n"
+    )
+
+rh, wh = _winapi.CreatePipe(None, 1 << 20)
+wfd = msvcrt.open_osfhandle(wh, 0)
+p = subprocess.Popen(
+    [sys.executable, "-u", child],
+    stdout=wfd,
+    stderr=subprocess.STDOUT,
+    stdin=subprocess.DEVNULL,
+    close_fds=True,
+)
+os.close(wfd)
+
+job = k32.CreateJobObjectW(None, None)
+hproc = _winapi.OpenProcess(0x0100 | 0x0001 | 0x00100000, False, p.pid)
+ok = k32.AssignProcessToJobObject(job, hproc)
+print("assign:", ok, flush=True)
+
+
+class PIDLIST(ctypes.Structure):
+    _fields_ = [
+        ("NumberOfAssignedProcesses", ctypes.c_ulong),
+        ("NumberOfProcessIdsInList", ctypes.c_ulong),
+        ("ProcessIdList", ctypes.c_size_t * 64),
+    ]
+
+
+def job_pids():
+    buf = PIDLIST()
+    ret = ctypes.c_ulong(0)
+    ok = k32.QueryInformationJobObject(
+        ctypes.c_void_p(job), 3, ctypes.byref(buf), ctypes.sizeof(buf), ctypes.byref(ret))
+    if not ok:
+        return None
+    return [buf.ProcessIdList[i] for i in range(buf.NumberOfProcessIdsInList)]
+
+
+def drain(t=0.5):
+    out = b""
+    end = time.time() + t
+    while time.time() < end:
+        try:
+            avail = _winapi.PeekNamedPipe(rh, 0)[0]
+        except OSError as e:
+            print("[peek: %s]" % e, flush=True)
+            return out, True
+        if avail:
+            out += _winapi.ReadFile(rh, 1 << 16)[0]
+        else:
+            time.sleep(0.02)
+    return out, False
+
+
+out, eof = drain(3.0)
+print("output so far:", out.decode("mbcs", "replace")[:400], flush=True)
+print("job pids before kill:", job_pids(), flush=True)
+
+k32.TerminateJobObject(ctypes.c_void_p(job), 1)
+st = _winapi.WaitForSingleObject(hproc, 5000)
+print("root wait:", st, flush=True)
+for i in range(8):
+    lp = job_pids()
+    print("job pids after kill %d:" % i, lp, flush=True)
+    if not lp:
+        break
+    time.sleep(0.25)
+
+out2, eof = drain(1.5)
+print("post-kill output:", out2.decode("mbcs", "replace")[:400], flush=True)
+print("eof seen:", eof, flush=True)
+print("total beats:", (out + out2).count(b"beat "), flush=True)
+print("child returncode:", p.poll(), flush=True)
+k32.CloseHandle(ctypes.c_void_p(job))
+_winapi.CloseHandle(hproc)
+_winapi.CloseHandle(rh)
diff --git a/_scratch/exp7.py b/_scratch/exp7.py
new file mode 100644
index 0000000..093f931
--- /dev/null
+++ b/_scratch/exp7.py
@@ -0,0 +1,65 @@
+import _winapi
+import io
+import msvcrt
+import os
+import subprocess
+import sys
+import time
+
+# --- 1) does os.close(fd) close the underlying OS handle? ---
+rh, wh = _winapi.CreatePipe(None, 4096)
+wfd = msvcrt.open_osfhandle(wh, 0)
+os.close(wfd)
+try:
+    r = _winapi.PeekNamedPipe(wh, 0)
+    print("after os.close(wfd): peek on raw handle STILL WORKS ->", r, flush=True)
+except OSError as e:
+    print("after os.close(wfd): peek on raw handle FAILED ->", e, flush=True)
+
+# --- 2) does FileIO.close() close the underlying handle? ---
+rfd = msvcrt.open_osfhandle(rh, 0)
+f = io.open(rfd, "rb", buffering=0)
+f.close()
+try:
+    r = _winapi.PeekNamedPipe(rh, 0)
+    print("after file.close(): peek on raw handle STILL WORKS ->", r, flush=True)
+except OSError as e:
+    print("after file.close(): peek on raw handle FAILED ->", e, flush=True)
+
+# --- 3) binary integrity through FileIO and through ReadFile ---
+rh2, wh2 = _winapi.CreatePipe(None, 1 << 16)
+_winapi.WriteFile(wh2, b"A\r\nB\x1aC\x00\xff")
+wfd2 = msvcrt.open_osfhandle(wh2, 0)
+os.close(wfd2)
+rfd2 = msvcrt.open_osfhandle(rh2, 0)
+f2 = io.open(rfd2, "rb", buffering=0)
+print("FileIO read:", f2.read(), flush=True)
+f2.close()
+
+rh3, wh3 = _winapi.CreatePipe(None, 1 << 16)
+_winapi.WriteFile(wh3, b"A\r\nB\x1aC\x00\xff")
+_winapi.CloseHandle(wh3)
+print("ReadFile read:", _winapi.ReadFile(rh3, 100), flush=True)
+_winapi.CloseHandle(rh3)
+
+# --- 4) end to end: child inherits pipe via fd; child exits; EOF must arrive ---
+rh4, wh4 = _winapi.CreatePipe(None, 1 << 20)
+wfd4 = msvcrt.open_osfhandle(wh4, 0)
+p = subprocess.Popen(
+    [sys.executable, "-u", "-c", "import os; os.write(1, b'bye\\r\\n'); os.write(2, b'err\\n')"],
+    stdout=wfd4, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
+os.close(wfd4)
+p.wait()
+for i in range(20):
+    try:
+        avail = _winapi.PeekNamedPipe(rh4, 0)
+        print("t=%.2f peek:" % (i * 0.1), avail, flush=True)
+        if avail[0]:
+            print("   data:", _winapi.ReadFile(rh4, 100), flush=True)
+        if i > 3 and avail[0] == 0:
+            break
+    except OSError as e:
+        print("t=%.2f peek raised:" % (i * 0.1), e, flush=True)
+        break
+    time.sleep(0.1)
+_winapi.CloseHandle(rh4)
diff --git a/_scratch/exp8.py b/_scratch/exp8.py
new file mode 100644
index 0000000..97877bd
--- /dev/null
+++ b/_scratch/exp8.py
@@ -0,0 +1,27 @@
+import subprocess
+import sys
+import tempfile
+import os
+
+PY = sys.executable
+tmp = tempfile.mkdtemp()
+marker = os.path.join(tmp, "ok.txt")
+worker = os.path.join(tmp, "worker.py")
+with open(worker, "w") as f:
+    f.write("import sys, os\nopen(sys.argv[1], 'w').write('ran ' + str(os.getpid()))\n")
+
+# form 1: unquoted (paths without spaces)
+cmd1 = "cmd /c %s %s %s" % (PY.replace("\\", "/"), worker.replace("\\", "/"), marker.replace("\\", "/"))
+p = subprocess.Popen(cmd1)
+print("form1 rc:", p.wait(), "marker:", os.path.exists(marker))
+
+# form 2: full-string with nested quotes
+os.remove(marker)
+cmd2 = 'cmd /c ""%s" "%s" "%s""' % (PY, worker, marker)
+p = subprocess.Popen(cmd2)
+print("form2 rc:", p.wait(), "marker:", os.path.exists(marker))
+
+# form 3: list form
+os.remove(marker)
+p = subprocess.Popen(["cmd", "/c", "%s %s %s" % (PY.replace("\\", "/"), worker.replace("\\", "/"), marker.replace("\\", "/"))])
+print("form3 rc:", p.wait(), "marker:", os.path.exists(marker))
diff --git a/_scratch/test_edges.py b/_scratch/test_edges.py
new file mode 100644
index 0000000..105143d
--- /dev/null
+++ b/_scratch/test_edges.py
@@ -0,0 +1,276 @@
+"""wproc 的边界与压力场景（本地验证用，不属于交付内容）。"""
+from __future__ import annotations
+
+import ctypes
+import os
+import subprocess
+import sys
+import threading
+import time
+
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from wproc import run  # noqa: E402
+from wproc import _win32  # noqa: E402
+
+KT = ctypes.windll.kernellt if False else ctypes.windll.kernel32
+
+
+def fwd(path):
+    return str(path).replace("\\", "/")
+
+
+def write(path, text):
+    with open(str(path), "w") as f:
+        f.write(text)
+    return fwd(path)
+
+
+def py_arg():
+    return fwd(sys.executable)
+
+
+def is_dead(pid, wait_ms=3000):
+    SYNCHRONIZE = 0x00100000
+    h = KT.OpenProcess(SYNCHRONIZE, False, int(pid))
+    if not h:
+        return True
+    try:
+        return KT.WaitForSingleObject(ctypes.c_void_p(h), wait_ms) == 0
+    finally:
+        KT.CloseHandle(ctypes.c_void_p(h))
+
+
+def worker_pid_of(path):
+    with open(str(path)) as f:
+        return int(f.readline().split()[1])
+
+
+def heartbeat_worker(tmp, name="worker.py", beat=0.05, total=600):
+    """向心跳文件持续追加行并打印自身 PID 的后台进程。"""
+    return write(
+        os.path.join(tmp, name),
+        "import os, sys, time\n"
+        "hb = open(sys.argv[1], 'a')\n"
+        "hb.write('PID ' + str(os.getpid()) + '\\n'); hb.flush()\n"
+        "for i in range(" + str(total) + "):\n"
+        "    hb.write('beat ' + str(i) + '\\n'); hb.flush()\n"
+        "    time.sleep(" + repr(beat) + ")\n",
+    )
+
+
+# ---------------------------------------------------------------------------
+# start /b 与 start（分离式后台进程）
+# ---------------------------------------------------------------------------
+
+
+def test_timeout_kills_start_b_process(tmp_path):
+    """`cmd /c start /b ...` 拉起的进程也必须被终止。"""
+    hb = tmp_path / "hb_startb.log"
+    worker = heartbeat_worker(tmp)
+    root = write(
+        os.path.join(tmp_path, "root.py"),
+        "import subprocess, time\n"
+        "subprocess.Popen(['cmd', '/c', 'start /b %s %s %s'])\n"
+        "time.sleep(600)\n" % (py_arg(), worker, fwd(hb)),
+    )
+    result = run([sys.executable, "-u", root], timeout=3)
+    assert result.timed_out is True
+    time.sleep(1.2)
+    assert is_dead(worker_pid_of(hb)), "start /b worker still alive"
+
+
+def test_timeout_kills_start_new_console_process(tmp_path):
+    """`start`（新控制台）拉起的进程也必须被终止。"""
+    hb = tmp_path / "hb_start.log"
+    worker = heartbeat_worker(tmp)
+    root = write(
+        os.path.join(tmp_path, "root.py"),
+        "import subprocess, time\n"
+        "subprocess.Popen(['cmd', '/c', 'start %s %s %s'])\n"
+        "time.sleep(600)\n" % (py_arg(), worker, fwd(hb)),
+    )
+    result = run([sys.executable, "-u", root], timeout=3)
+    assert result.timed_out is True
+    time.sleep(1.2)
+    assert is_dead(worker_pid_of(hb)), "start (new console) worker still alive"
+
+
+# ---------------------------------------------------------------------------
+# 批处理文件作为命令
+# ---------------------------------------------------------------------------
+
+
+def test_timeout_kills_batch_spawned_children(tmp_path):
+    hb = tmp_path / "hb_batch.log"
+    worker = heartbeat_worker(tmp)
+    bat = write(
+        os.path.join(tmp_path, "run.bat"),
+        "@echo off\r\n"
+        "%s %s %s\r\n" % (py_arg(), worker, fwd(hb)),
+    )
+    result = run(["cmd", "/c", bat], timeout=3)
+    assert result.timed_out is True
+    time.sleep(1.2)
+    assert is_dead(worker_pid_of(hb)), "batch worker still alive"
+
+
+# ---------------------------------------------------------------------------
+# 大量后代
+# ---------------------------------------------------------------------------
+
+
+def test_timeout_kills_many_descendants(tmp_path):
+    hb_dir = tmp_path / "fanout"
+    hb_dir.mkdir()
+    root = write(
+        os.path.join(tmp_path, "fanout.py"),
+        "import subprocess, sys, time\n"
+        "py, worker, hb = sys.argv[1], sys.argv[2], sys.argv[3]\n"
+        "for i in range(30):\n"
+        "    subprocess.Popen([py, '-u', worker, hb + '/hb%d.log' % i])\n"
+        "time.sleep(600)\n" % (),
+    )
+    worker = heartbeat_worker(tmp)
+    result = run([sys.executable, "-u", root, py_arg(), worker, fwd(hb_dir)], timeout=4)
+    assert result.timed_out is True
+    pids = []
+    for i in range(30):
+        pids.append(worker_pid_of(hb_dir / ("hb%d.log" % i)))
+    time.sleep(1.5)
+    for pid in pids:
+        assert is_dead(pid, wait_ms=1000), "fanout worker %d still alive" % pid
+
+
+# ---------------------------------------------------------------------------
+# 并发（线程）运行
+# ---------------------------------------------------------------------------
+
+
+def test_concurrent_runs():
+    results = {}
+    errors = []
+
+    def worker(i):
+        try:
+            if i % 2:
+                results[i] = run(
+                    [sys.executable, "-c",
+                     "import time; time.sleep(0.5); print('ok%d')" % i],
+                    timeout=30)
+            else:
+                results[i] = run(
+                    [sys.executable, "-c",
+                     "import time; time.sleep(600)"], timeout=2)
+        except Exception as exc:  # pragma: no cover
+            errors.append(exc)
+
+    threads = [threading.Thread(target=worker, args=(i,)) for i in range(6)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert not errors
+    for i in range(6):
+        r = results[i]
+        if i % 2:
+            assert r.returncode == 0 and ("ok%d" % i).encode() in r.output
+        else:
+            assert r.timed_out is True
+
+
+# ---------------------------------------------------------------------------
+# 超时边界的竞态：结果必须自洽，不抛异常
+# ---------------------------------------------------------------------------
+
+
+def test_deadline_race_is_consistent():
+    for i in range(12):
+        # 命令恰好在预算附近退出：结果要么超时、要么正常，但不允许异常
+        result = run([sys.executable, "-c",
+                      "import time; time.sleep(1.0); print('x')"], timeout=1.0)
+        assert result.output is not None
+        if result.timed_out:
+            assert result.returncode is not None
+        else:
+            assert result.returncode == 0
+
+
+# ---------------------------------------------------------------------------
+# 资源（句柄）回收
+# ---------------------------------------------------------------------------
+
+
+def _handle_count():
+    class _PCR(ctypes.Structure):
+        _fields_ = [("Count", ctypes.c_ulong)]
+    pcr = _PCR()
+    PSAPI = ctypes.WinDLL("psapi")
+    PSAPI.GetProcessHandleCount(ctypes.c_void_p(KT.GetCurrentProcess()),
+                                ctypes.byref(pcr))
+    return pcr.Count
+
+
+def test_no_handle_leak_over_many_runs():
+    run([sys.executable, "-c", "print('warm')"], timeout=30)
+    before = _handle_count()
+    for i in range(40):
+        result = run([sys.executable, "-c", "print(%d)" % i], timeout=30)
+        assert result.returncode == 0
+    time.sleep(0.5)
+    after = _handle_count()
+    assert after <= before + 10, "handle leak: %d -> %d" % (before, after)
+
+
+def test_no_handle_leak_over_many_timeouts():
+    before = _handle_count()
+    for i in range(15):
+        result = run([sys.executable, "-c", "import time; time.sleep(60)"],
+                     timeout=1.5)
+        assert result.timed_out is True
+    time.sleep(0.5)
+    after = _handle_count()
+    assert after <= before + 10, "handle leak: %d -> %d" % (before, after)
+
+
+# ---------------------------------------------------------------------------
+# 兼容：start_process + communicate
+# ---------------------------------------------------------------------------
+
+
+def test_start_process_and_communicate_compat():
+    from wproc import processes
+
+    proc = processes.start_process(
+        [sys.executable, "-c", "import sys; print('compat'); sys.stderr.write('err')"])
+    out, _ = proc.communicate(timeout=30)
+    assert proc.returncode == 0
+    assert b"compat" in out
+    assert b"err" in out
+
+
+def test_terminate_process_is_idempotent():
+    from wproc import processes
+
+    proc = processes.start_process([sys.executable, "-c", "print('done')"])
+    proc.wait()
+    processes.terminate_process(proc)   # 已结束：不得抛异常、不得误伤
+    assert proc.returncode == 0
+
+
+# ---------------------------------------------------------------------------
+# timeout=0 与极小预算
+# ---------------------------------------------------------------------------
+
+
+def test_zero_timeout_terminates():
+    result = run([sys.executable, "-c", "import time; time.sleep(60)"], timeout=0)
+    assert result.timed_out is True
+    assert result.returncode is not None
+
+
+def test_tiny_timeout_terminates():
+    result = run([sys.executable, "-c", "import time; time.sleep(60)"], timeout=0.05)
+    assert result.timed_out is True
