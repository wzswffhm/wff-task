index 0000000..e102be2
--- /dev/null
+++ b/_scratch/exp1.py
@@ -0,0 +1,34 @@
+import _winapi
+import subprocess
+import sys
+import time
+import msvcrt
+
+p = subprocess.Popen(
+    [sys.executable, "-c",
+     "import sys; sys.stdout.write(b'hello'*10); sys.stdout.flush(); import time; time.sleep(30)"],
+    stdout=subprocess.PIPE,
+    stderr=subprocess.STDOUT,
+    stdin=subprocess.DEVNULL,
+    bufsize=0,
+)
+h = msvcrt.get_osfhandle(p.stdout.fileno())
+print("handle", h, flush=True)
+time.sleep(1.0)
+print("peek(0):", _winapi.PeekNamedPipe(h, 0), flush=True)
+print("peek(4):", _winapi.PeekNamedPipe(h, 4), flush=True)
+print("read(100):", _winapi.ReadFile(h, 100), flush=True)
+print("peek after read:", _winapi.PeekNamedPipe(h, 0), flush=True)
+p.kill()
+p.wait()
+# after process death, pipe should be broken eventually
+time.sleep(0.5)
+try:
+    print("peek after kill:", _winapi.PeekNamedPipe(h, 0), flush=True)
+except OSError as e:
+    print("peek after kill raised:", e, flush=True)
+try:
+    print("read after kill:", _winapi.ReadFile(h, 100), flush=True)
+except OSError as e:
+    print("read after kill raised:", e, flush=True)
+_winapi.CloseHandle(h)
