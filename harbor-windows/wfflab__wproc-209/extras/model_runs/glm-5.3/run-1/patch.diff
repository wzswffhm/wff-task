+                    except Exception:
+                        pass
+                    break
+            except Exception:
+                break
+
+    # ------------------------------------------------------------------ 收尾
+
+    def close(self, close_output: bool = True) -> None:
+        """释放监督所占的资源；不影响任何进程。"""
+        if self._closed:
+            return
+        self._closed = True
+        if close_output:
+            stdout = getattr(self.proc, "stdout", None)
+            if stdout is not None:
+                try:
+                    stdout.close()
+                except Exception:
+                    pass
+        if self._child_handle is not None:
+            _win32.close_handle(self._child_handle)
+            self._child_handle = None
+        if self._job is not None:
+            self._job.close()
+            self._job = None
