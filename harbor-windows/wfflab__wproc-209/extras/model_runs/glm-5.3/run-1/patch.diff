@@ -0,0 +1,336 @@
+"""wproc 的现场场景验收测试（对应任务里的验收标准 1-7）。
+
+放在 _scratch/ 下仅用于本地验证，不属于交付内容。
+"""
+from __future__ import annotations
+
+import ctypes
+import os
+import subprocess
+import sys
+import time
+
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from wproc import CommandFailed, CommandNotStarted, CommandTimedOut, run  # noqa: E402
+from wproc import _win32  # noqa: E402
+
+KT = ctypes.windll.kernel32
+
+
+def fwd(path):
+    return str(path).replace("\\", "/")
+
+
+def write(path, text):
+    with open(str(path), "w") as f:
+        f.write(text)
+    return fwd(path)
+
+
+def py_arg():
+    """当前 Python 解释器路径（正斜杠，用于生成的脚本）。"""
+    return fwd(sys.executable)
+
+
+def worker_script(tmp, beat=0.05, total=600):
+    """后台工作进程：不断向心跳文件追加行，持续占着输出目录。"""
+    return write(
+        os.path.join(tmp, "worker.py"),
+        "import os, sys, time\n"
+        "hb = open(sys.argv[1], 'a')\n"
+        "hb.write('PID ' + str(os.getpid()) + '\\n'); hb.flush()\n"
+        "os.write(1, b'worker-started\\n')\n"
+        "for i in range(" + str(total) + "):\n"
+        "    hb.write('beat ' + str(i) + '\\n'); hb.flush()\n"
+        "    time.sleep(" + repr(beat) + ")\n"
+        "hb.write('worker-done\\n'); hb.flush()\n",
+    )
+
+
+def chain_script(tmp, worker, hb):
+    """根进程：python -> cmd /c -> worker（心跳）。"""
+    return write(
+        os.path.join(tmp, "chain.py"),
+        "import subprocess, time\n"
+        "hb = " + repr(fwd(hb)) + "\n"
+        "cmd = ['cmd', '/c', '%s %s ' + hb]\n"
+        "subprocess.Popen(cmd)\n"
+        "time.sleep(600)\n" % (py_arg(), worker),
+    )
+
+
+def is_dead(pid, wait_ms=3000):
+    SYNCHRONIZE = 0x00100000
+    h = KT.OpenProcess(SYNCHRONIZE, False, int(pid))
+    if not h:
+        return True
+    try:
+        return KT.WaitForSingleObject(ctypes.c_void_p(h), wait_ms) == 0
+    finally:
+        KT.CloseHandle(ctypes.c_void_p(h))
+
+
+def heartbeat_size(path):
+    try:
+        return os.path.getsize(str(path))
+    except OSError:
+        return -1
+
+
+def worker_pid_of(path):
+    with open(str(path)) as f:
+        return int(f.readline().split()[1])
+
+
+# ---------------------------------------------------------------------------
+# 验收 1：超时被终止后，整棵进程树（含后台后代）都停止
+# ---------------------------------------------------------------------------
+
+
+def test_timeout_kills_cmd_chain_tree(tmp_path):
+    hb = tmp_path / "heartbeat.log"
+    chain = write(
+        os.path.join(tmp_path, "chain.py"),
+        "import subprocess, time\n"
+        "# python -> cmd /c -> cmd /c -> worker\n"
+        "inner = 'cmd /c %s %s %s'\n" % (py_arg(), worker_script(tmp_path), fwd(hb))
+        + "subprocess.Popen(['cmd', '/c', 'cmd /c ' + inner])\n"
+        "time.sleep(600)\n",
+    )
+    result = run([sys.executable, "-u", chain], timeout=3)
+    assert result.timed_out is True
+    # run() 返回后，观察一段时间：不得再有任何活动
+    size1 = heartbeat_size(hb)
+    time.sleep(1.5)
+    size2 = heartbeat_size(hb)
+    assert size1 == size2 > 0, "heartbeat missing or still growing after run() returned"
+    # 工作进程必须已经死掉
+    assert is_dead(worker_pid_of(hb)), "worker still alive"
+    # 输出目录里的锁也该释放了：目录可改名
+    os.rename(str(tmp_path), str(tmp_path) + "-renamed")
+
+
+def test_timeout_kills_tree_with_dead_middle(tmp_path):
+    """中间进程已经退出、按父子关系追不到的后代，也必须被终止。"""
+    hb = tmp_path / "heartbeat.log"
+    root = write(
+        os.path.join(tmp_path, "root.py"),
+        "import subprocess, time\n"
+        "middle = 'import subprocess, sys\\n"
+        "subprocess.Popen([sys.executable, \"-u\", sys.argv[1], sys.argv[2]])\\n'\n"
+        "subprocess.Popen(['%s', '-c', middle, '%s', '%s'])\n"
+        "time.sleep(600)\n" % (py_arg(), worker_script(tmp_path), fwd(hb)),
+    )
+    result = run([sys.executable, "-u", root], timeout=3)
+    assert result.timed_out is True
+    time.sleep(1.2)
+    assert is_dead(worker_pid_of(hb)), "orphaned worker still alive"
+
+
+# ---------------------------------------------------------------------------
+# 验收 2：终止不会影响无关进程
+# ---------------------------------------------------------------------------
+
+
+def test_unrelated_process_is_untouched(tmp_path):
+    unrelated = subprocess.Popen(
+        [sys.executable, "-c", "import time; time.sleep(120)"],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        stdin=subprocess.DEVNULL,
+    )
+    hb = tmp_path / "heartbeat.log"
+    chain = chain_script(tmp_path, worker_script(tmp_path), hb)
+    result = run([sys.executable, "-u", chain], timeout=2)
+    assert result.timed_out is True
+    # 无关进程必须毫发无损
+    assert is_dead(unrelated.pid, wait_ms=0) is False
+    unrelated.kill()
+    unrelated.wait()
+
+
+# ---------------------------------------------------------------------------
+# 验收 3：超时返回的输出包含截止之前写到 stdout/stderr 的全部内容
+# ---------------------------------------------------------------------------
+
+
+def test_timeout_preserves_large_output(tmp_path):
+    code = (
+        "import os, time\n"
+        "os.write(1, b'BEGIN\\n')\n"
+        "chunk = ('x' * 8192 + '\\n').encode()\n"
+        "for i in range(80): os.write(1, chunk)\n"   # ~660 KiB
+        "os.write(2, b'TO-STDERR\\n')\n"
+        "os.write(1, b'END\\n')\n"
+        "time.sleep(600)\n"
+    )
+    path = write(os.path.join(tmp_path, "big.py"), code)
+    result = run([sys.executable, "-u", path], timeout=3)
+    assert result.timed_out is True
+    assert result.output.count(b"x") == 8192 * 80
+    assert b"BEGIN" in result.output
+    assert b"TO-STDERR" in result.output
+    assert b"END" in result.output
+
+
+def test_timeout_preserves_output_larger_than_pipe(tmp_path):
+    """输出超过管道容量：等待期间必须持续收走，超时后内容完整。"""
+    code = (
+        "import os, time\n"
+        "chunk = ('y' * 4096 + '\\n').encode()\n"
+        "for i in range(1024): os.write(1, chunk)\n"  # ~4 MiB
+        "os.write(1, b'ALL-WRITTEN\\n')\n"
+        "time.sleep(600)\n"
+    )
+    path = write(os.path.join(tmp_path, "huge.py"), code)
+    result = run([sys.executable, "-u", path], timeout=8)
+    assert result.timed_out is True
+    assert result.output.count(b"y") == 4096 * 1024
+    assert b"ALL-WRITTEN" in result.output
+
+
+# ---------------------------------------------------------------------------
+# 验收 4：直接子进程退出即结束，不等它的后台后代
+# ---------------------------------------------------------------------------
+
+
+def test_returns_promptly_when_child_exits_but_grandchild_holds_pipe(tmp_path):
+    code = (
+        "import os, sys, subprocess, time\n"
+        "bg = 'import os, time\\n"
+        "os.write(1, b\"bg-alive\\\\n\")\\n"
+        "for i in range(200):\\n"
+        "    time.sleep(0.2)\\n'\n"
+        "subprocess.Popen([sys.executable, '-u', '-c', bg])\n"
+        "time.sleep(1.5)\n"          # 让后台进程先跑起来、握住输出管道
+        "os.write(1, b'MARKER-BEFORE-EXIT\\n')\n"
+        "sys.exit(7)\n"
+    )
+    path = write(os.path.join(tmp_path, "parent.py"), code)
+    started = time.monotonic()
+    result = run([sys.executable, "-u", path], timeout=60)
+    elapsed = time.monotonic() - started
+    assert elapsed < 15, "run() waited for the background descendant: %.1fs" % elapsed
+    assert result.timed_out is False
+    assert result.returncode == 7
+    assert b"MARKER-BEFORE-EXIT" in result.output
+    # 后台进程在直接子进程退出之前的输出也必须已经在结果里
+    assert b"bg-alive" in result.output
+
+
+def test_returns_promptly_when_child_exits_zero(tmp_path):
+    code = (
+        "import os, sys, subprocess\n"
+        "subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(600)'])\n"
+        "os.write(1, b'DONE-0\\n')\n"
+        "sys.exit(0)\n"
+    )
+    path = write(os.path.join(tmp_path, "parent0.py"), code)
+    started = time.monotonic()
+    result = run([sys.executable, "-u", path], timeout=60)
+    elapsed = time.monotonic() - started
+    assert elapsed < 15
+    assert result.timed_out is False
+    assert result.returncode == 0
+    assert result.ok is True
+    assert b"DONE-0" in result.output
+
+
+# ---------------------------------------------------------------------------
+# 验收 5：非零退出码原样返回
+# ---------------------------------------------------------------------------
+
+
+def test_nonzero_exit_via_cmd_chain():
+    result = run(["cmd", "/c", "exit /b 5"], timeout=30)
+    assert result.timed_out is False
+    assert result.returncode == 5
+    assert result.ok is False
+
+
+# ---------------------------------------------------------------------------
+# 验收 6：check=True 的两种异常都带完整结果
+# ---------------------------------------------------------------------------
+
+
+def test_check_raises_with_full_result(tmp_path):
+    code = (
+        "import os, sys, subprocess\n"
+        "subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(600)'])\n"
+        "os.write(1, b'boom-output\\n')\n"
+        "os.write(2, b'boom-error\\n')\n"
+        "sys.exit(4)\n"
+    )
+    path = write(os.path.join(tmp_path, "fail.py"), code)
+    with pytest.raises(CommandFailed) as excinfo:
+        run([sys.executable, "-u", path], timeout=60, check=True)
+    assert excinfo.value.result.returncode == 4
+    assert excinfo.value.result.timed_out is False
+    assert b"boom-output" in excinfo.value.result.output
+    assert b"boom-error" in excinfo.value.result.output
+
+    with pytest.raises(CommandTimedOut) as excinfo:
+        run([sys.executable, "-c",
+             "import os,time;os.write(1,b'partial\\n');time.sleep(600)"],
+            timeout=2, check=True)
+    assert excinfo.value.result.timed_out is True
+    assert b"partial" in excinfo.value.result.output
+
+
+# ---------------------------------------------------------------------------
+# 验收 7：不抛与子进程行为无关的异常 + 基本回归
+# ---------------------------------------------------------------------------
+
+
+def test_repeated_runs_are_stable():
+    for i in range(15):
+        result = run([sys.executable, "-c", "print(%d)" % i], timeout=30)
+        assert result.returncode == 0
+        assert str(i).encode() in result.output
+
+
+def test_no_timeout_runs_to_completion():
+    result = run([sys.executable, "-c",
+                  "import time; time.sleep(1.2); print('slept')"], timeout=None)
+    assert result.returncode == 0
+    assert b"slept" in result.output
+
+
+def test_missing_executable_raises_command_not_started():
+    with pytest.raises(CommandNotStarted):
+        run([r"C:\definitely\not\an\executable.exe"], timeout=10)
+
+
+# ---------------------------------------------------------------------------
+# 兼容入口：processes.terminate_process
+# ---------------------------------------------------------------------------
+
+
+def test_terminate_process_kills_tree(tmp_path):
+    from wproc import processes
+
+    hb = tmp_path / "heartbeat.log"
+    chain = chain_script(tmp_path, worker_script(tmp_path), hb)
+    proc = subprocess.Popen([sys.executable, "-u", chain])
+    time.sleep(2.0)
+    processes.terminate_process(proc)
+    assert proc.returncode is not None
+    assert is_dead(worker_pid_of(hb))
+
+
+def test_descendant_pids_finds_tree(tmp_path):
+    hb = tmp_path / "heartbeat.log"
+    chain = chain_script(tmp_path, worker_script(tmp_path), hb)
+    proc = subprocess.Popen([sys.executable, "-u", chain])
+    try:
+        time.sleep(2.0)
+        pids = _win32.descendant_pids(proc.pid)
+        assert proc.pid in pids
+        assert len(pids) >= 3  # root + cmd + worker
+    finally:
+        proc.kill()
+        proc.wait()
+        time.sleep(0.3)
