+def _start_process_windows(
+    command: Command,
+    cwd: Optional[str] = None,
+    env: Optional[Mapping[str, str]] = None,
+) -> ProcessHandle:
+    """Windows 版本：创建 Job Object 并把子进程加入其中。"""
+    job_handle = None
+    
+    try:
+        # 创建 Job Object
+        job_handle = kernel32.CreateJobObjectW(None, None)
+        if not job_handle:
+            raise OSError("Failed to create job object")
+
+        # 配置 Job：关闭 Job 时终止所有进程
+        info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION()
+        info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+
+        result = kernel32.SetInformationJobObject(
+            job_handle,
+            9,  # JobObjectExtendedLimitInformation
+            ctypes.byref(info),
+            ctypes.sizeof(info),
+        )
+
+        if not result:
+            raise OSError("Failed to configure job object")
+
+        # 启动子进程（不使用特殊的 creation flags）
+        proc = subprocess.Popen(
+            [str(item) for item in command],
+            cwd=cwd,
+            env=dict(env) if env is not None else None,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+        )
+
+        # 把进程加入 Job
+        process_handle = int(proc._handle)
+        result = kernel32.AssignProcessToJobObject(job_handle, process_handle)
