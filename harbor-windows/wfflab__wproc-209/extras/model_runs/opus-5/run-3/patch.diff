+def _terminate_process_tree_windows(pid: int) -> None:
+    """在 Windows 上终止整个进程树。
+    
+    使用 taskkill /F /T 命令强制终止进程及其所有子进程。
+    """
+    try:
+        # /F: 强制终止
+        # /T: 终止进程树（包括所有子进程）
+        # /PID: 指定进程 ID
+        subprocess.run(
+            ["taskkill", "/F", "/T", "/PID", str(pid)],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            timeout=10,
+            check=False,  # 进程可能已经退出，忽略错误
+        )
+    except (subprocess.TimeoutExpired, OSError):
+        # taskkill 失败时静默处理，后续的 kill() 会兜底
+        pass
