+def _run_windows(
+    proc: subprocess.Popen,
+    timeout: Optional[float],
+    check: bool,
+) -> RunResult:
+    """Windows 专用：异步收集输出，直接子进程退出后立即返回。
+    
+    关键行为：
+    1. 使用线程异步读取输出，避免阻塞
+    2. 直接子进程退出后立即返回，不等待管道关闭
+    3. 超时时收集已读取的输出
+    """
+    output_chunks = []
+    output_lock = threading.Lock()
+    reader_done = threading.Event()
+
+    def read_output():
+        """在后台线程中读取输出。"""
+        try:
+            while True:
+                chunk = proc.stdout.read(4096)
+                if not chunk:
+                    break
+                with output_lock:
+                    output_chunks.append(chunk)
+        except Exception:
+            # 管道关闭或其他读取错误，静默退出
+            pass
+        finally:
+            reader_done.set()
+
+    # 启动输出读取线程
+    reader = threading.Thread(target=read_output, daemon=True)
+    reader.start()
+
+    start_time = time.time()
+    timed_out = False
+
+    # 轮询直接子进程状态
+    while True:
+        returncode = proc.poll()
+        
+        if returncode is not None:
+            # 直接子进程已退出，立即返回
+            # 给读取线程一点时间收集剩余输出
+            reader_done.wait(timeout=0.5)
+            break
+        
+        # 检查超时
+        if timeout is not None:
+            elapsed = time.time() - start_time
+            if elapsed >= timeout:
+                timed_out = True
+                processes.terminate_process(proc)
+                # 给读取线程一点时间收集输出
+                reader_done.wait(timeout=0.5)
+                break
+        
+        # 短暂休眠避免忙等
+        time.sleep(0.05)
+
+    # 收集所有输出
+    with output_lock:
+        output = b"".join(output_chunks)
+
+    if timed_out:
+        result = RunResult(
+            returncode=proc.returncode,
+            output=output,
+            timed_out=True
+        )
+        if check:
+            raise CommandTimedOut(timeout, result)
+        return result
+
+    result = RunResult(returncode=proc.returncode, output=output)
+    if check and result.returncode != 0:
+        raise CommandFailed(result)
+    return result
