+#: 直接子进程结束后，等待读者线程把「已经在路上」的数据搬完的上限（秒）。
+_DRAIN_GRACE_SEC = 0.5
+#: 每次从管道里取的字节数。
+_CHUNK = 65536
+
+
+def _drain(proc, sink: bytearray, finished: threading.Event) -> None:
+    """把子进程的输出持续读进 ``sink``；管道 EOF 或出错时结束。"""
+    try:
+        stream = proc.stdout
+        if stream is None:
+            return
+        while True:
+            chunk = stream.read1(_CHUNK)
+            if not chunk:
+                break
+            sink.extend(chunk)
+    except (OSError, ValueError):
+        pass
+    finally:
+        finished.set()
+
+
+def _wait_for_drain(finished: threading.Event, grace: float) -> None:
+    deadline = time.time() + grace
+    while time.time() < deadline:
+        if finished.wait(0.02):
+            return
+
 
