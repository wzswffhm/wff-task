+"""临时验证脚本 2（不入库，跑完即删）。"""
+
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wstamp import sync_tree, copy_stamp, stamp_file, snapshot_times  # noqa: E402
+from wstamp.attributes import get_attributes, set_attributes  # noqa: E402
+
+RO, HID, ARCH = 0x01, 0x02, 0x20
+DAY = 86400 * 10 ** 9
+FAILS = []
+N = [0]
+
+
+def check(name, cond, extra=""):
+    N[0] += 1
+    print(("  ok   " if cond else "  FAIL ") + name + ("" if cond else " %r" % (extra,)))
+    if not cond:
+        FAILS.append(name)
+
+
+def mkfile(path, data, mtime_ns=None, atime_ns=None, attrs=None):
+    d = os.path.dirname(path)
+    if d and not os.path.isdir(d):
+        os.makedirs(d)
+    with open(path, "wb") as fh:
+        fh.write(data)
+    st = os.stat(path)
+    os.utime(path, ns=(st.st_atime_ns if atime_ns is None else atime_ns,
+                       st.st_mtime_ns if mtime_ns is None else mtime_ns))
+    if attrs is not None:
+        set_attributes(path, attrs)
+    return path
+
+
+def rmtree_force(path):
+    def fix(func, p, exc):
+        try:
+            set_attributes(p, get_attributes(p) & ~RO)
+        except OSError:
+            pass
+        func(p)
+
+    shutil.rmtree(path, onexc=fix)
+
+
+base = tempfile.mkdtemp()
+src = os.path.join(base, "src")
+dst = os.path.join(base, "dst")
+os.makedirs(src)
+
+print("[A] 只读源文件：created -> 幂等 -> restamped -> updated -> deleted")
+T1 = 1600000000123456700
+T2 = 1600000999888888700
+mkfile(os.path.join(src, "ro.txt"), b"one", mtime_ns=T1, attrs=ARCH | RO | HID)
+r = sync_tree(src, dst)
+check("created", r.created == ["ro.txt"], r.created)
+check("dst readonly", bool(get_attributes(os.path.join(dst, "ro.txt")) & RO))
+check("dst hidden", bool(get_attributes(os.path.join(dst, "ro.txt")) & HID))
+check("dst mtime", os.stat(os.path.join(dst, "ro.txt")).st_mtime_ns == T1)
+r = sync_tree(src, dst)
+check("idempotent", (r.created, r.updated, r.restamped, r.deleted, r.failed) == ([], [], [], [], []), vars(r))
+# 只读目标 mtime 落后 -> restamped
+os.utime(os.path.join(dst, "ro.txt"), ns=(T1 - DAY, T1 - 2 * DAY))
+atime_before = os.stat(os.path.join(dst, "ro.txt")).st_atime_ns
+r = sync_tree(src, dst)
+check("ro restamped", r.restamped == ["ro.txt"], (r.restamped, r.failed))
+check("ro restamped mtime", os.stat(os.path.join(dst, "ro.txt")).st_mtime_ns == T1)
+check("ro restamped atime", os.stat(os.path.join(dst, "ro.txt")).st_atime_ns == atime_before,
+      (os.stat(os.path.join(dst, "ro.txt")).st_atime_ns, atime_before))
+check("ro still readonly", bool(get_attributes(os.path.join(dst, "ro.txt")) & RO))
+# 内容变化 -> updated
+set_attributes(os.path.join(src, "ro.txt"), ARCH)
+mkfile(os.path.join(src, "ro.txt"), b"two-longer", mtime_ns=T2, attrs=ARCH | RO | HID)
+r = sync_tree(src, dst)
+check("ro updated", r.updated == ["ro.txt"], (r.updated, r.failed))
+check("ro updated bytes", open(os.path.join(dst, "ro.txt"), "rb").read() == b"two-longer")
+check("ro updated mtime", os.stat(os.path.join(dst, "ro.txt")).st_mtime_ns == T2)
+check("ro updated attrs", get_attributes(os.path.join(dst, "ro.txt")) & (RO | HID) == RO | HID)
+# 源里删掉 -> deleted（目标是只读）
+os.remove(os.path.join(src, "ro.txt")) if not get_attributes(os.path.join(src, "ro.txt")) & RO else (
+    set_attributes(os.path.join(src, "ro.txt"), ARCH), os.remove(os.path.join(src, "ro.txt")))
+r = sync_tree(src, dst)
+check("ro deleted", r.deleted == ["ro.txt"], (r.deleted, r.failed))
+check("ro gone", not os.path.exists(os.path.join(dst, "ro.txt")))
+
+print("[B] 深层只读目录整体删除 + 目录时间戳")
+mkfile(os.path.join(src, "keep.txt"), b"k", mtime_ns=T1)
+mkfile(os.path.join(dst, "x", "y", "z.txt"), b"z", attrs=ARCH | RO)
+mkfile(os.path.join(dst, "x", "w.txt"), b"w", attrs=ARCH | RO)
+set_attributes(os.path.join(dst, "x", "y"), 0x11)  # DIRECTORY | READONLY
+D_X = 1500000300400000000
+os.utime(os.path.join(src), ns=(D_X, D_X))
+r = sync_tree(src, dst)
+check("deleted nested ro tree", r.deleted == ["x"], (r.deleted, r.failed))
+check("x gone", not os.path.exists(os.path.join(dst, "x")))
+check("keep created", r.created == ["keep.txt"], r.created)
+check("root dir mtime restored", os.stat(dst).st_mtime_ns == D_X, os.stat(dst).st_mtime_ns)
+
+print("[C] 空目录 / 空树")
+os.makedirs(os.path.join(src, "empty"))
+os.utime(os.path.join(src, "empty"), ns=(D_X - 100, D_X - 100))
+r = sync_tree(src, dst)
+check("empty dir created", os.path.isdir(os.path.join(dst, "empty")))
+check("empty dir not in created", r.created == [], r.created)
+check("empty dir mtime", os.stat(os.path.join(dst, "empty")).st_mtime_ns == D_X - 100)
+
+print("[D] dst 不存在 / src 为空")
+dst2 = os.path.join(base, "d2")
+r = sync_tree(src, dst2)
+check("dst auto-created", os.path.isdir(dst2))
+check("all created", sorted(r.created) == ["empty", "keep.txt"] or sorted(r.created) == ["keep.txt"], r.created)
+rmtree_force(dst2)
+empty_src = os.path.join(base, "empty_src")
+os.makedirs(empty_src)
+dst3 = os.path.join(base, "d3")
+os.makedirs(dst3)
+mkfile(os.path.join(dst3, "stale.txt"), b"s")
+r = sync_tree(empty_src, dst3)
+check("empty src prunes", r.deleted == ["stale.txt"], r.deleted)
+
+print("[E] dry_run 与真实运行报告一致（含 restamped/failed）")
+dst4 = os.path.join(base, "d4")
+os.makedirs(dst4)
+mkfile(os.path.join(dst4, "keep.txt"), b"k", mtime_ns=T1 - 9 * DAY)
+mkfile(os.path.join(dst4, "stale.txt"), b"s", attrs=ARCH | RO)
+os.makedirs(os.path.join(dst4, "empty", "nested"))
+dry = sync_tree(src, dst4, dry_run=True)
+real = sync_tree(src, dst4)
+for field in ("created", "updated", "restamped", "deleted", "failed"):
+    check("dry==real %s" % field, sorted(getattr(dry, field)) == sorted(getattr(real, field)),
+          (getattr(dry, field), getattr(real, field)))
+check("real restamped keep", os.stat(os.path.join(dst4, "keep.txt")).st_mtime_ns == T1)
+
+print("[F] 缺源目录应抛错，而不是静默空报告")
+try:
+    sync_tree(os.path.join(base, "nope"), os.path.join(base, "d5"))
+    check("missing src raises", False)
+except OSError as exc:
+    check("missing src raises", True, exc)
+check("d5 not created", not os.path.exists(os.path.join(base, "d5")))
+
+print("[G] stamp_file 对目录 / 缺失路径")
+try:
+    stamp_file(os.path.join(base, "missing.txt"), T1)
+    check("missing stamp raises", False)
+except OSError as exc:
+    check("missing stamp raises", type(exc).__name__, type(exc).__name__)
+stamp_file(dst4, T2)
+check("dir stamp", os.stat(dst4).st_mtime_ns == T2)
+
+rmtree_force(base)
+print()
+print("checks=%d fails=%d" % (N[0], len(FAILS)))
+sys.exit(1 if FAILS else 0)
diff --git a/verify_tmp3.py b/verify_tmp3.py
new file mode 100644
index 0000000..a1dc451
--- /dev/null
+++ b/verify_tmp3.py
@@ -0,0 +1,159 @@
+"""临时验证脚本 3（不入库，跑完即删）。"""
+
+import os
+import shutil
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wstamp import sync_tree, snapshot_times, stamp_file  # noqa: E402
+from wstamp.attributes import get_attributes, set_attributes  # noqa: E402
+
+RO, HID, ARCH, DIR = 0x01, 0x02, 0x20, 0x10
+DAY = 86400 * 10 ** 9
+FAILS = []
+N = [0]
+
+
+def check(name, cond, extra=""):
+    N[0] += 1
+    print(("  ok   " if cond else "  FAIL ") + name + ("" if cond else " %r" % (extra,)))
+    if not cond:
+        FAILS.append(name)
+
+
+def mkfile(path, data, mtime_ns=None, attrs=None):
+    d = os.path.dirname(path)
+    if d and not os.path.isdir(d):
+        os.makedirs(d)
+    with open(path, "wb") as fh:
+        fh.write(data)
+    st = os.stat(path)
+    os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns if mtime_ns is None else mtime_ns))
+    if attrs is not None:
+        set_attributes(path, attrs)
+    return path
+
+
+def rmtree_force(path):
+    def fix(func, p, exc):
+        try:
+            set_attributes(p, get_attributes(p) & ~RO)
+        except OSError:
+            pass
+        func(p)
+
+    shutil.rmtree(path, onexc=fix)
+
+
+base = tempfile.mkdtemp()
+src = os.path.join(base, "src")
+dst = os.path.join(base, "dst")
+os.makedirs(src)
+
+print("[H] prune 递归：公共子目录里的多余只读/隐藏条目")
+T = time.time_ns() - 2 * DAY
+T = T - T % 100
+mkfile(os.path.join(src, "keep", "a.txt"), b"A", mtime_ns=T)
+mkfile(os.path.join(dst, "keep", "a.txt"), b"A", mtime_ns=T)
+mkfile(os.path.join(dst, "keep", "extra_ro.txt"), b"X", attrs=ARCH | RO)
+mkfile(os.path.join(dst, "keep", "extra_hid.txt"), b"X", attrs=ARCH | HID)
+mkfile(os.path.join(dst, "keep", "deep", "extra.txt"), b"X", attrs=ARCH | RO)
+mkfile(os.path.join(dst, "keep", "empty_dir", ".keep"), b"")
+r = sync_tree(src, dst)
+check("deleted nested extras", sorted(r.deleted) == [
+    os.path.join("keep", "deep"),
+    os.path.join("keep", "empty_dir"),
+    os.path.join("keep", "extra_hid.txt"),
+    os.path.join("keep", "extra_ro.txt"),
+], r.deleted)
+check("extras gone", not os.path.exists(os.path.join(dst, "keep", "extra_ro.txt"))
+      and not os.path.exists(os.path.join(dst, "keep", "extra_hid.txt"))
+      and not os.path.exists(os.path.join(dst, "keep", "deep"))
+      and not os.path.exists(os.path.join(dst, "keep", "empty_dir")))
+check("nothing else touched", (r.created, r.updated, r.restamped, r.failed) == ([], [], [], []),
+      (r.created, r.updated, r.restamped, r.failed))
+
+print("[I] 源目录 vs 目标同名文件 -> failed，不中断")
+mkfile(os.path.join(src, "conf", "inner.txt"), b"i", mtime_ns=T)
+mkfile(os.path.join(dst, "conf"), b"i am a file", mtime_ns=T)
+mkfile(os.path.join(src, "ok.txt"), b"ok", mtime_ns=T)
+r = sync_tree(src, dst)
+check("conf failed", r.failed == ["conf"], r.failed)
+check("others still synced", sorted(r.created) == ["ok.txt"], r.created)
+check("conf file untouched", open(os.path.join(dst, "conf"), "rb").read() == b"i am a file")
+# 反向：源文件 vs 目标同名目录
+os.remove(os.path.join(src, "conf", "inner.txt")) if False else None
+rmtree_force(os.path.join(src, "conf"))
+os.remove(os.path.join(dst, "conf"))
+mkfile(os.path.join(src, "conf"), b"file", mtime_ns=T)
+os.makedirs(os.path.join(dst, "conf"))
+r = sync_tree(src, dst)
+check("reverse conf failed", r.failed == ["conf"], r.failed)
+check("reverse conf dir kept", os.path.isdir(os.path.join(dst, "conf")))
+
+print("[J] 深层目录时间戳逐层对齐")
+base3 = tempfile.mkdtemp()
+s3 = os.path.join(base3, "s")
+d3 = os.path.join(base3, "d")
+os.makedirs(s3)
+depths = {}
+p = s3
+for i in range(5):
+    p = os.path.join(p, "lvl%d" % i)
+    os.makedirs(p)
+    mkfile(os.path.join(p, "f.txt"), b"x" * (i + 1), mtime_ns=T + i * 1000)
+    v = T - (i + 1) * 10 * DAY
+    os.utime(p, ns=(v, v))
+    depths[os.path.relpath(p, s3)] = v
+v = T - 99 * DAY
+os.utime(s3, ns=(v, v))
+depths[""] = v
+r = sync_tree(s3, d3)
+check("deep created", len(r.created) == 5, r.created)
+bad = []
+for rel in depths:
+    got = os.stat(os.path.join(d3, rel) if rel else d3).st_mtime_ns
+    want = os.stat(os.path.join(s3, rel) if rel else s3).st_mtime_ns
+    if got != want:
+        bad.append((rel, got, want))
+check("all dir mtimes aligned", not bad, bad)
+files = [os.path.join(*["lvl%d" % k for k in range(i + 1)], "f.txt") for i in range(5)]
+check("file mtimes aligned", all(
+    os.stat(os.path.join(d3, x)).st_mtime_ns == os.stat(os.path.join(s3, x)).st_mtime_ns
+    for x in files), files)
+check("second run empty", all(
+    not getattr(sync_tree(s3, d3), f) for f in ("created", "updated", "restamped", "deleted", "failed")))
+
+print("[K] issue #211：内容相同但 mtime 落后 -> 全部 restamped")
+base4 = tempfile.mkdtemp()
+s4 = os.path.join(base4, "s")
+d4 = os.path.join(base4, "d")
+os.makedirs(s4)
+names = ["one.txt", "two.txt", os.path.join("sub", "three.txt")]
+for i, name in enumerate(names):
+    mkfile(os.path.join(s4, name), b"payload-%d" % i, mtime_ns=T + i * 1000)
+    mkfile(os.path.join(d4, name), b"payload-%d" % i, mtime_ns=T - 5 * DAY + i * 1000)
+before_atime = {n: os.stat(os.path.join(d4, n)).st_atime_ns for n in names}
+r = sync_tree(s4, d4)
+check("all restamped", sorted(r.restamped) == sorted(names), r.restamped)
+check("nothing else", (r.created, r.updated, r.deleted, r.failed) == ([], [], [], []),
+      (r.created, r.updated, r.deleted, r.failed))
+check("mtimes now match src", all(
+    os.stat(os.path.join(d4, n)).st_mtime_ns == os.stat(os.path.join(s4, n)).st_mtime_ns
+    for n in names))
+check("atime preserved", all(
+    os.stat(os.path.join(d4, n)).st_atime_ns == before_atime[n] for n in names),
+    {n: (os.stat(os.path.join(d4, n)).st_atime_ns, before_atime[n]) for n in names})
+check("stamp_file matches snapshot", snapshot_times(os.path.join(d4, names[0]))["mtime_ns"]
+      == snapshot_times(os.path.join(s4, names[0]))["mtime_ns"])
+stamp_file(os.path.join(d4, names[0]), T)
+check("stamp_file roundtrip", os.stat(os.path.join(d4, names[0])).st_mtime_ns == T)
+
+for b in (base, base3, base4):
+    rmtree_force(b)
+print()
+print("checks=%d fails=%d" % (N[0], len(FAILS)))
+sys.exit(1 if FAILS else 0)
