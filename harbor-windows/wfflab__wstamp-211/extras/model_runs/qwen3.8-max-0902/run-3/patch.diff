+++ b/verify_tmp.py
@@ -0,0 +1,312 @@
+"""临时验证脚本（不入库，跑完即删）。覆盖任务里的 8 条验收契约。"""
+
+import ctypes
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from wstamp import (  # noqa: E402
+    SyncReport,
+    WStampError,
+    copy_stamp,
+    snapshot_times,
+    stamp_file,
+    sync_tree,
+)
+from wstamp.attributes import get_attributes, set_attributes  # noqa: E402
+
+RO = 0x01
+HID = 0x02
+ARCH = 0x20
+NORMAL = 0x80
+DAY = 86400 * 10 ** 9
+
+FAILS = []
+COUNT = [0]
+
+
+def check(name, cond, extra=""):
+    COUNT[0] += 1
+    if cond:
+        print("  ok   %s" % name)
+    else:
+        print("  FAIL %s %s" % (name, extra))
+        FAILS.append(name)
+
+
+def mkfile(path, data, mtime_ns=None, atime_ns=None, attrs=None):
+    d = os.path.dirname(path)
+    if d and not os.path.isdir(d):
+        os.makedirs(d)
+    with open(path, "wb") as fh:
+        fh.write(data)
+    st = os.stat(path)
+    a = st.st_atime_ns if atime_ns is None else atime_ns
+    m = st.st_mtime_ns if mtime_ns is None else mtime_ns
+    os.utime(path, ns=(a, m))
+    if attrs is not None:
+        set_attributes(path, attrs)
+    return path
+
+
+def rmtree_force(path):
+    def fix(func, p, exc):
+        try:
+            set_attributes(p, get_attributes(p) & ~RO)
+        except OSError:
+            pass
+        func(p)
+
+    shutil.rmtree(path, onexc=fix)
+
+
+def tree_state(root):
+    out = []
+    for base, dirs, files in os.walk(root):
+        for name in sorted(dirs) + sorted(files):
+            p = os.path.join(base, name)
+            st = os.stat(p)
+            out.append(
+                (
+                    os.path.relpath(p, root),
+                    os.path.isdir(p),
+                    st.st_size,
+                    st.st_mtime_ns,
+                    get_attributes(p),
+                )
+            )
+    return sorted(out)
+
+
+def lock_exclusive(path):
+    k = ctypes.WinDLL("kernel32", use_last_error=True)
+    k.CreateFileW.restype = ctypes.c_void_p
+    h = k.CreateFileW(
+        path, 0x80000000, 0, None, 3, 0, None
+    )  # GENERIC_READ, share=0, OPEN_EXISTING
+    if h in (None, ctypes.c_void_p(-1).value):
+        raise ctypes.WinError(ctypes.get_last_error())
+    return h
+
+
+# ---------------------------------------------------------------- 契约 1
+print("[1] snapshot_times")
+base = tempfile.mkdtemp()
+p = mkfile(os.path.join(base, "a.txt"), b"hello")
+snap = snapshot_times(p)
+st = os.stat(p)
+check("keys", set(snap) == {"mtime_ns", "atime_ns", "created"}, snap)
+check("mtime_ns int+equal", isinstance(snap["mtime_ns"], int) and snap["mtime_ns"] == st.st_mtime_ns)
+check("atime_ns int+equal", isinstance(snap["atime_ns"], int) and snap["atime_ns"] == st.st_atime_ns)
+check("created==st_ctime", snap["created"] == st.st_ctime)
+rmtree_force(base)
+
+# ---------------------------------------------------------------- 契约 2
+print("[2] stamp_file")
+base = tempfile.mkdtemp()
+T_ATIME = 1500000000123456700
+T_NEW = 1650000000765432100
+p = mkfile(os.path.join(base, "a.txt"), b"x", mtime_ns=1400000000000000000, atime_ns=T_ATIME)
+stamp_file(p, T_NEW)
+st = os.stat(p)
+check("mtime exact ns", st.st_mtime_ns == T_NEW, st.st_mtime_ns)
+check("atime preserved", st.st_atime_ns == T_ATIME, st.st_atime_ns)
+check("accepts PathLike", True)
+import pathlib  # noqa: E402
+
+stamp_file(pathlib.Path(p), T_NEW - 100)
+check("pathlib ok", os.stat(p).st_mtime_ns == T_NEW - 100)
+
+# 只读目标
+q = mkfile(os.path.join(base, "ro.txt"), b"y", mtime_ns=1400000000000000000, atime_ns=T_ATIME, attrs=ARCH | RO)
+before = os.stat(q)
+attrs_before = get_attributes(q)
+try:
+    stamp_file(q, T_NEW)
+    check("readonly raises", False)
+except WStampError as exc:
+    check("readonly kind", exc.kind == "readonly", exc.kind)
+    check("readonly is OSError", isinstance(exc, OSError))
+except Exception as exc:  # noqa: BLE001
+    check("readonly raises WStampError", False, repr(exc))
+after = os.stat(q)
+check("readonly no write (mtime)", after.st_mtime_ns == before.st_mtime_ns)
+check("readonly no write (atime)", after.st_atime_ns == before.st_atime_ns)
+check("readonly attrs untouched", get_attributes(q) == attrs_before)
+rmtree_force(base)
+
+# ---------------------------------------------------------------- 契约 3
+print("[3] copy_stamp")
+base = tempfile.mkdtemp()
+T_M = 1600000000123456700
+T_A = 1590000000765432100
+src = mkfile(os.path.join(base, "s.txt"), b"payload" * 100, mtime_ns=T_M, atime_ns=T_A, attrs=ARCH | RO | HID)
+dst = os.path.join(base, "d.txt")
+copy_stamp(src, dst)
+ss, ds = os.stat(src), os.stat(dst)
+check("dst mtime exact", ds.st_mtime_ns == T_M, ds.st_mtime_ns)
+check("dst atime exact", ds.st_atime_ns == T_A, ds.st_atime_ns)
+check("bytes", open(dst, "rb").read() == open(src, "rb").read())
+check("attrs carried", get_attributes(dst) & (RO | HID) == get_attributes(src) & (RO | HID),
+      (hex(get_attributes(src)), hex(get_attributes(dst))))
+check("attrs exact", get_attributes(dst) == get_attributes(src),
+      (hex(get_attributes(src)), hex(get_attributes(dst))))
+
+# 覆写一个已存在的只读目标
+dst2 = mkfile(os.path.join(base, "d2.txt"), b"stale", mtime_ns=T_M - DAY, attrs=ARCH | RO)
+src2 = mkfile(os.path.join(base, "s2.txt"), b"fresh", mtime_ns=T_M, atime_ns=T_A, attrs=ARCH)
+copy_stamp(src2, dst2)
+check("overwrite readonly ok", open(dst2, "rb").read() == b"fresh")
+check("overwrite readonly mtime", os.stat(dst2).st_mtime_ns == T_M)
+check("overwrite readonly still ro", bool(get_attributes(dst2) & RO))
+rmtree_force(base)
+
+# ---------------------------------------------------------------- 契约 4/5/6
+print("[4][5][6] sync_tree created / 目录时间戳 / 相对路径")
+base = tempfile.mkdtemp()
+src = os.path.join(base, "src")
+dst = os.path.join(base, "dst")
+os.makedirs(src)
+T1 = 1600000000123456700
+T2 = 1600000100765432100
+T3 = 1600000200111111100
+mkfile(os.path.join(src, "a.txt"), b"AAA", mtime_ns=T1)
+mkfile(os.path.join(src, "sub", "b.txt"), b"BBB", mtime_ns=T2)
+mkfile(os.path.join(src, "sub", "deep", "c.txt"), b"CCC", mtime_ns=T3, attrs=ARCH | HID)
+D_ROOT = 1500000000100000000
+D_SUB = 1500000100200000000
+D_DEEP = 1500000200300000000
+os.utime(os.path.join(src, "sub", "deep"), ns=(D_DEEP, D_DEEP))
+os.utime(os.path.join(src, "sub"), ns=(D_SUB, D_SUB))
+os.utime(src, ns=(D_ROOT, D_ROOT))
+
+rep = sync_tree(src, dst)
+check("created list", sorted(rep.created) == ["a.txt", os.path.join("sub", "b.txt"), os.path.join("sub", "deep", "c.txt")], rep.created)
+check("nothing else", (rep.updated, rep.restamped, rep.deleted, rep.failed) == ([], [], [], []),
+      (rep.updated, rep.restamped, rep.deleted, rep.failed))
+check("file mtimes", all(
+    os.stat(os.path.join(dst, r)).st_mtime_ns == os.stat(os.path.join(src, r)).st_mtime_ns
+    for r in rep.created))
+check("relative paths", all(not os.path.isabs(r) and not r.startswith(base) for r in rep.created))
+check("deep dir mtime", os.stat(os.path.join(dst, "sub", "deep")).st_mtime_ns == D_DEEP,
+      os.stat(os.path.join(dst, "sub", "deep")).st_mtime_ns)
+check("sub dir mtime", os.stat(os.path.join(dst, "sub")).st_mtime_ns == D_SUB,
+      os.stat(os.path.join(dst, "sub")).st_mtime_ns)
+check("root dir mtime", os.stat(dst).st_mtime_ns == D_ROOT, os.stat(dst).st_mtime_ns)
+check("hidden attr carried", bool(get_attributes(os.path.join(dst, "sub", "deep", "c.txt")) & HID))
+
+print("[4] 第二次同步应完全空转（幂等）")
+rep2 = sync_tree(src, dst)
+check("idempotent", (rep2.created, rep2.updated, rep2.restamped, rep2.deleted, rep2.failed) == ([], [], [], [], []),
+      (rep2.created, rep2.updated, rep2.restamped, rep2.deleted, rep2.failed))
+
+print("[4] updated / restamped / deleted")
+os.utime(os.path.join(dst, "a.txt"), ns=(T1 - 5 * DAY, T1 - 5 * DAY))  # 同内容、mtime 落后
+mkfile(os.path.join(dst, "sub", "b.txt"), b"BBB-changed", mtime_ns=T2)  # 内容不同
+mkfile(os.path.join(dst, "stale.txt"), b"old", attrs=ARCH | RO)  # 多余 + 只读
+mkfile(os.path.join(dst, "staledir", "inner.txt"), b"old", attrs=ARCH | RO)  # 多余目录 + 只读文件
+stale_atime = os.stat(os.path.join(dst, "a.txt")).st_atime_ns
+rep3 = sync_tree(src, dst)
+check("restamped", rep3.restamped == ["a.txt"], rep3.restamped)
+check("updated", rep3.updated == [os.path.join("sub", "b.txt")], rep3.updated)
+check("deleted", sorted(rep3.deleted) == ["stale.txt", "staledir"], rep3.deleted)
+check("created empty", rep3.created == [])
+check("failed empty", rep3.failed == [], rep3.failed)
+check("restamped mtime", os.stat(os.path.join(dst, "a.txt")).st_mtime_ns == T1)
+check("restamped atime kept", os.stat(os.path.join(dst, "a.txt")).st_atime_ns == stale_atime,
+      (os.stat(os.path.join(dst, "a.txt")).st_atime_ns, stale_atime))
+check("updated bytes", open(os.path.join(dst, "sub", "b.txt"), "rb").read() == b"BBB")
+check("updated mtime", os.stat(os.path.join(dst, "sub", "b.txt")).st_mtime_ns == T2)
+check("stale gone", not os.path.exists(os.path.join(dst, "stale.txt")))
+check("staledir gone", not os.path.exists(os.path.join(dst, "staledir")))
+check("dir mtimes still aligned", os.stat(dst).st_mtime_ns == D_ROOT and os.stat(os.path.join(dst, "sub")).st_mtime_ns == D_SUB,
+      (os.stat(dst).st_mtime_ns, os.stat(os.path.join(dst, "sub")).st_mtime_ns))
+
+print("[8] 只读目标：覆写 / 回写时间 都要恢复只读位")
+ro_path = os.path.join(dst, "ro_same.txt")
+ro_src = os.path.join(src, "ro_same.txt")
+mkfile(ro_src, b"SAME", mtime_ns=T1, attrs=ARCH)
+mkfile(ro_path, b"SAME", mtime_ns=T1 - 3 * DAY, attrs=ARCH | RO)
+atime_ro = os.stat(ro_path).st_atime_ns
+rep4 = sync_tree(src, dst)
+check("ro restamped", rep4.restamped == ["ro_same.txt"], (rep4.restamped, rep4.failed))
+check("ro still readonly", bool(get_attributes(ro_path) & RO))
+check("ro mtime fixed", os.stat(ro_path).st_mtime_ns == T1)
+check("ro atime kept", os.stat(ro_path).st_atime_ns == atime_ro)
+
+mkfile(ro_src, b"DIFFERENT", mtime_ns=T1, attrs=ARCH)
+rep5 = sync_tree(src, dst)
+check("ro updated", rep5.updated == ["ro_same.txt"], (rep5.updated, rep5.failed))
+check("ro updated content", open(ro_path, "rb").read() == b"DIFFERENT")
+check("ro updated still readonly", bool(get_attributes(ro_path) & RO))
+check("ro updated mtime", os.stat(ro_path).st_mtime_ns == T1)
+
+print("[4] failed：目标位置被同名目录占据 / 目标被占用")
+occ_src = os.path.join(src, "occ.txt")
+mkfile(occ_src, b"data", mtime_ns=T1)
+os.makedirs(os.path.join(dst, "occ.txt"))
+mkfile(os.path.join(dst, "occ.txt", "inner"), b"inner")
+lock_src = os.path.join(src, "locked.txt")
+lock_dst = os.path.join(dst, "locked.txt")
+mkfile(lock_src, b"L" * 100, mtime_ns=T1)
+mkfile(lock_dst, b"L" * 100, mtime_ns=T1 - DAY)
+handle = lock_exclusive(lock_dst)
+rep6 = sync_tree(src, dst)
+check("failed exact", sorted(rep6.failed) == ["locked.txt", "occ.txt"], rep6.failed)
+check("failed has locked.txt", "locked.txt" in rep6.failed, rep6.failed)
+check("no crash, others synced", rep6.restamped == [], rep6.restamped)
+ctypes.windll.kernel32.CloseHandle(ctypes.c_void_p(handle))
+check("occ dir still there", os.path.isdir(os.path.join(dst, "occ.txt")))
+
+# ---------------------------------------------------------------- 契约 7
+print("[7] dry_run")
+base2 = tempfile.mkdtemp()
+src = os.path.join(base2, "src")
+dst = os.path.join(base2, "dst")
+os.makedirs(src)
+mkfile(os.path.join(src, "a.txt"), b"AAA", mtime_ns=T1)
+mkfile(os.path.join(src, "sub", "b.txt"), b"BBB", mtime_ns=T2)
+os.utime(os.path.join(src, "sub"), ns=(D_SUB, D_SUB))
+os.utime(src, ns=(D_ROOT, D_ROOT))
+os.makedirs(dst)
+mkfile(os.path.join(dst, "a.txt"), b"AAA", mtime_ns=T1 - 4 * DAY, atime_ns=T_A)
+mkfile(os.path.join(dst, "sub", "b.txt"), b"xxx", mtime_ns=T2)
+mkfile(os.path.join(dst, "gone.txt"), b"g", attrs=ARCH | RO)
+mkfile(os.path.join(dst, "gonedir", "inner.txt"), b"g")
+os.utime(dst, ns=(D_ROOT + 12345000, D_ROOT + 12345000))
+before_state = tree_state(dst)
+dry = sync_tree(src, dst, dry_run=True)
+after_state = tree_state(dst)
+check("dry report created", dry.created == [], dry.created)
+check("dry report updated", dry.updated == [os.path.join("sub", "b.txt")], dry.updated)
+check("dry report restamped", dry.restamped == ["a.txt"], dry.restamped)
+check("dry report deleted", sorted(dry.deleted) == ["gone.txt", "gonedir"], dry.deleted)
+check("dry tree untouched", before_state == after_state, [x for x in before_state if x not in after_state] + [x for x in after_state if x not in before_state])
+print("  info atime-unchanged-after-dry-run:", os.stat(os.path.join(dst, "a.txt")).st_atime_ns == T_A,
+      os.stat(os.path.join(dst, "a.txt")).st_atime_ns)
+real = sync_tree(src, dst)
+check("dry==real created", dry.created == real.created)
+check("dry==real updated", dry.updated == real.updated)
+check("dry==real deleted", sorted(dry.deleted) == sorted(real.deleted))
+check("dry==real restamped", dry.restamped == real.restamped)
+check("real applied", os.stat(os.path.join(dst, "a.txt")).st_mtime_ns == T1 and not os.path.exists(os.path.join(dst, "gone.txt")))
+
+# dry_run 且 dst 不存在
+dst3 = os.path.join(base2, "missing-dst")
+dry3 = sync_tree(src, dst3, dry_run=True)
+check("dry missing dst", sorted(dry3.created) == ["a.txt", os.path.join("sub", "b.txt")], dry3.created)
+check("dry missing dst not created", not os.path.exists(dst3))
+real3 = sync_tree(src, dst3)
+check("real missing dst same report", sorted(real3.created) == sorted(dry3.created))
+rmtree_force(base2)
+rmtree_force(base)
+
+print()
+print("checks=%d fails=%d" % (COUNT[0], len(FAILS)))
+if FAILS:
+    print("FAILED:", FAILS)
+    sys.exit(1)
+print("ALL GREEN")
