+"""TEMPORARY probe 7 - replicate the failing verification case. Deleted before submit."""
+import os
+import tempfile
+import time
+from pathlib import Path
+
+from wstamp import copy_stamp, snapshot_times
+from wstamp.attributes import get_attributes, set_attributes
+
+
+def mkfile(p, data=b"data", mtime_ns=None, at=None):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with open(str(p), "wb") as fh:
+        fh.write(data)
+    if mtime_ns is not None:
+        a = at if at is not None else os.stat(str(p)).st_atime_ns
+        os.utime(str(p), ns=(a, mtime_ns))
+    return p
+
+
+for trial in range(4):
+    t = Path(tempfile.mkdtemp(prefix="wsexp7"))
+    src = mkfile(t / "s.txt", b"new")
+    dst = mkfile(t / "d.txt", b"old-old-old")
+    set_attributes(str(dst), get_attributes(str(dst)) | 0x01)
+    snap = snapshot_times(str(src))
+    inner_before = snapshot_times(str(src))
+    copy_stamp(str(src), str(dst))
+    got = snapshot_times(str(dst))
+    print("trial", trial)
+    print("  snap     atime", snap["atime_ns"], "mtime", snap["mtime_ns"])
+    print("  inner    atime", inner_before["atime_ns"], "delta", inner_before["atime_ns"] - snap["atime_ns"])
+    print("  dst      atime", got["atime_ns"], "delta-vs-snap", got["atime_ns"] - snap["atime_ns"])
+    print("  dst mtime ok:", got["mtime_ns"] == snap["mtime_ns"])
