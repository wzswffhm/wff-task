+    mkfile(dst / "a.txt", b"ALPHA-DIFFERENT")                        # updated
+    mkfile(dst / "sub" / "b.txt", b"beta", mtime_ns=OLD)             # restamped
+    src_c = snapshot_times(str(src / "sub" / "deep" / "c.txt"))
+    mkfile(dst / "sub" / "deep" / "c.txt", b"gamma", mtime_ns=src_c["mtime_ns"],
+           at=src_c["atime_ns"])                                      # in sync
+
+    report = sync_tree(str(src), str(dst))
+    assert report.created == [], report.created
+    assert report.updated == ["a.txt"], report.updated
+    assert report.restamped == [os.path.join("sub", "b.txt")], report.restamped
+    assert report.deleted == ["old.txt"], report.deleted
+    assert report.failed == [], report.failed
+    assert os.path.sep == "\\" and "\\" in report.restamped[0]
+    for rel in ("a.txt", os.path.join("sub", "b.txt"), os.path.join("sub", "deep", "c.txt")):
+        s = snapshot_times(os.path.join(str(src), rel))
+        d = snapshot_times(os.path.join(str(dst), rel))
+        assert s["mtime_ns"] == d["mtime_ns"], rel
+        assert open(os.path.join(str(src), rel), "rb").read() == open(
+            os.path.join(str(dst), rel), "rb").read()
+    assert not (dst / "old.txt").exists()
+
+
+@test
