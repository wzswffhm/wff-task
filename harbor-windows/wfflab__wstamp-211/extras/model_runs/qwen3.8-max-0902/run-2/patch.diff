+def _restore_dir_times(dir_times, report):
+    """把目录 mtime 从源恢复回去（先深层后浅层）。
+
+    前序遍历的逆序天然满足「子目录先于父目录」，所以父目录的时间戳总是最后
+    写，不会被后续动作再刷掉。目录的 atime 保持目标自己的值。
+    """
+    for dst_dir, rel, mtime_ns in reversed(dir_times):
+        if not os.path.isdir(dst_dir):
+            continue
+        try:
+            _write_times(dst_dir, os.stat(dst_dir).st_atime_ns, mtime_ns)
+        except Exception as exc:
+            _record_failed(report, rel, exc)
+
+
+def _write_times(path, atime_ns, mtime_ns):
+    """写时间戳；目标带只读属性时先清掉、写完恢复原属性位。"""
+    attrs = clear_readonly(path)
+    try:
+        os.utime(path, ns=(int(atime_ns), int(mtime_ns)))
+    finally:
+        if attrs & FILE_ATTRIBUTE_READONLY:
+            set_attributes(path, attrs)
+
+
+def _restore_atime(path, atime_ns):
+    """把比较读取时被刷新的 atime 还原（尽力而为，不产生报告条目）。"""
+    try:
+        st = os.stat(path)
+        if st.st_atime_ns == int(atime_ns):
+            return
+        _write_times(path, atime_ns, st.st_mtime_ns)
+    except OSError as exc:
+        _LOG.debug("wstamp: keep atime of %s failed (%s)", path, exc)
+
+
+def _remove(path):
+    """删除文件或整棵目录树；只读条目先清除属性再删。"""
+    if os.path.isdir(path) and not os.path.islink(path):
+        for name in sorted(os.listdir(path)):
+            _remove(os.path.join(path, name))
+        clear_readonly(path)
+        os.rmdir(path)
+    else:
+        clear_readonly(path)
+        os.remove(path)
