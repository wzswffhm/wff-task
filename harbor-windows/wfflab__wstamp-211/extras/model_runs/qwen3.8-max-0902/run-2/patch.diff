@@ -0,0 +1,48 @@
+"""TEMPORARY probe 6 - why dst atime drifts after copy_stamp. Deleted before submit."""
+import os
+import tempfile
+import time
+from pathlib import Path
+
+from wstamp import copy_stamp, snapshot_times
+from wstamp.attributes import get_attributes, set_attributes
+
+root = Path(tempfile.mkdtemp(prefix="wsexp6"))
+try:
+    for trial in range(3):
+        src = root / ("s%d.txt" % trial)
+        dst = root / ("d%d.txt" % trial)
+        with open(str(src), "wb") as fh:
+            fh.write(b"new")
+        with open(str(dst), "wb") as fh:
+            fh.write(b"old-old-old")
+        if trial:
+            set_attributes(str(dst), get_attributes(str(dst)) | 0x01)
+        snap = snapshot_times(str(src))
+        t0 = time.perf_counter_ns()
+        copy_stamp(str(src), str(dst))
+        t1 = time.perf_counter_ns()
+        got = snapshot_times(str(dst))
+        src_after = snapshot_times(str(src))
+        print("trial", trial, "readonly-dst", bool(trial))
+        print("  src snap atime", snap["atime_ns"], "mtime", snap["mtime_ns"])
+        print("  dst got  atime", got["atime_ns"], "mtime", got["mtime_ns"])
+        print("  atime equal:", got["atime_ns"] == snap["atime_ns"],
+              "delta:", got["atime_ns"] - snap["atime_ns"])
+        print("  mtime equal:", got["mtime_ns"] == snap["mtime_ns"])
+        print("  src atime after copy:", src_after["atime_ns"] - snap["atime_ns"])
+        print("  copy took us:", (t1 - t0) / 1000.0)
+        time.sleep(0.05)
+        again = snapshot_times(str(dst))
+        print("  dst atime 50ms later delta:", again["atime_ns"] - got["atime_ns"])
+        time.sleep(0.05)
+finally:
+    import shutil
+    for base, dirs, files in os.walk(str(root)):
+        for name in dirs + files:
+            try:
+                set_attributes(os.path.join(base, name), 0x80)
+            except OSError:
+                pass
+    shutil.rmtree(str(root), ignore_errors=True)
+    print("cleaned:", not root.exists())
