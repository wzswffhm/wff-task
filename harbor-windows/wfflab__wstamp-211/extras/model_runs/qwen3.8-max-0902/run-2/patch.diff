+        ["a.txt", os.path.join("sub", "b.txt"), os.path.join("sub", "deep", "c.txt")]), report.created
+    assert (report.updated, report.restamped, report.deleted, report.failed) == ([], [], [], [])
+    assert (dst / "sub" / "deep" / "c.txt").read_bytes() == b"gamma"
