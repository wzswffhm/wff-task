+# --------------------------------------------------------------------- 4 sync
+def build_tree(root):
+    root.mkdir(parents=True, exist_ok=True)
+    mkfile(root / "a.txt", b"alpha")
+    mkfile(root / "sub" / "b.txt", b"beta")
+    mkfile(root / "sub" / "deep" / "c.txt", b"gamma")
