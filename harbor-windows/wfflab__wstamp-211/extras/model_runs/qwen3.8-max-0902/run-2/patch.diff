@@ -0,0 +1,116 @@
+"""TEMPORARY probe 2 - will be deleted."""
+import ctypes
+import os
+import shutil
+import tempfile
+import time
+from ctypes import wintypes
+
+RO = 0x01
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.GetFileAttributesW.argtypes = [wintypes.LPCWSTR]
+k32.GetFileAttributesW.restype = wintypes.DWORD
+k32.SetFileAttributesW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD]
+k32.SetFileAttributesW.restype = wintypes.BOOL
+
+
+def ga(p):
+    v = k32.GetFileAttributesW(str(p))
+    if v == 0xFFFFFFFF:
+        raise ctypes.WinError(ctypes.get_last_error())
+    return v
+
+
+def sa(p, v):
+    if not k32.SetFileAttributesW(str(p), v):
+        raise ctypes.WinError(ctypes.get_last_error())
+
+
+root = tempfile.mkdtemp(prefix="wsexp2")
+try:
+    f = os.path.join(root, "ro.txt")
+    with open(f, "wb") as fh:
+        fh.write(b"x")
+    old = os.stat(f).st_mtime_ns
+    sa(f, ga(f) | RO)
+    new = old - 5_000_000_000
+    try:
+        os.utime(f, ns=(os.stat(f).st_atime_ns, new))
+        got = os.stat(f).st_mtime_ns
+        print("utime on readonly file -> applied:", got == new, "got", got, "want", new)
+    except OSError as e:
+        print("utime readonly raised:", type(e).__name__, e.winerror, e.errno)
+
+    # restore readonly after stamping: does it perturb mtime?
+    sa(f, ga(f) & ~RO)
+    os.utime(f, ns=(os.stat(f).st_atime_ns, new))
+    sa(f, ga(f) | RO)
+    print("mtime after re-readonly:", os.stat(f).st_mtime_ns == new, "attrs", hex(ga(f)))
+
+    # does copyfile touch src atime?
+    src = os.path.join(root, "s.txt")
+    dst = os.path.join(root, "d.txt")
+    with open(src, "wb") as fh:
+        fh.write(b"hello")
+    a0 = os.stat(src).st_atime_ns
+    shutil.copyfile(src, dst)
+    a1 = os.stat(src).st_atime_ns
+    print("src atime changed by copyfile:", a0 != a1)
+    print("dst attrs:", hex(ga(dst)), "src attrs:", hex(ga(src)))
+    print("dst mtime == src mtime:", os.stat(dst).st_mtime_ns == os.stat(src).st_mtime_ns)
+
+    # copy2 behaviour
+    dst2 = os.path.join(root, "d2.txt")
+    shutil.copy2(src, dst2)
+    print("copy2 dst mtime equal:", os.stat(dst2).st_mtime_ns == os.stat(src).st_mtime_ns)
+    print("copy2 dst atime equal:", os.stat(dst2).st_atime_ns == os.stat(src).st_atime_ns)
+
+    # setting attributes to exactly 0x80 / 0 and to 0x21
+    sa(dst, 0)
+    print("attrs after set 0:", hex(ga(dst)))
+    sa(dst, 0x21)
+    print("attrs after set 0x21:", hex(ga(dst)))
+
+    # exclusive lock simulation: does opening with msvcrt lock block copyfile?
+    lk = os.path.join(root, "lk.txt")
+    with open(lk, "wb") as fh:
+        fh.write(b"data")
+    fh = os.open(lk, os.O_RDWR)
+    import msvcrt
+    msvcrt.locking(fh, msvcrt.LK_NBLCK, 1)
+    try:
+        shutil.copyfile(src, lk)
+        print("copyfile over byte-locked file: OK")
+    except OSError as e:
+        print("copyfile over byte-locked file FAILED:", type(e).__name__, e.winerror, e.errno)
+    msvcrt.locking(fh, msvcrt.LK_UNLCK, 1)
+    os.close(fh)
+
+    # share-mode-none lock via CreateFileW
+    lk2 = os.path.join(root, "lk2.txt")
+    with open(lk2, "wb") as fh:
+        fh.write(b"data")
+    GENERIC_WRITE = 0x40000000
+    h = k32.CreateFileW(lk2, GENERIC_WRITE, 0, None, 3, 0, None)
+    print("CreateFileW handle:", h)
+    try:
+        with open(lk2, "rb") as fh:
+            fh.read()
+        print("read share-locked file: OK")
+    except OSError as e:
+        print("read share-locked file FAILED:", type(e).__name__, e.winerror, e.errno)
+    try:
+        os.utime(lk2, ns=(1700000000000000000, 1700000000000000000))
+        print("utime share-locked file: OK")
+    except OSError as e:
+        print("utime share-locked file FAILED:", type(e).__name__, e.winerror, e.errno)
+    k32.CloseHandle(h)
+finally:
+    for base, dirs, files in os.walk(root):
+        for name in dirs + files:
+            try:
+                sa(os.path.join(base, name), 0x80)
+            except OSError:
+                pass
+    shutil.rmtree(root, ignore_errors=True)
+    print("cleaned:", not os.path.exists(root))
