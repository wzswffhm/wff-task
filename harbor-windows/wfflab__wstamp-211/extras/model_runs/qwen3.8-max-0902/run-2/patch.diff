+"""TEMPORARY verification script (deleted before submit)."""
+
+import ctypes
+import os
+import shutil
+import sys
+import tempfile
+import time
+import traceback
+from ctypes import wintypes
+from pathlib import Path
+
+from wstamp import (
+    SyncReport,
+    WStampError,
+    copy_stamp,
+    snapshot_times,
+    stamp_file,
+    sync_tree,
+)
+from wstamp.stamps import set_times
+
+RO = 0x01
+HIDDEN = 0x02
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.GetFileAttributesW.argtypes = [wintypes.LPCWSTR]
+k32.GetFileAttributesW.restype = wintypes.DWORD
+k32.SetFileAttributesW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD]
+k32.SetFileAttributesW.restype = wintypes.BOOL
+k32.CreateFileW.restype = wintypes.HANDLE
+k32.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                            ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+
+TESTS = []
+
+
+def test(fn):
+    TESTS.append(fn)
+    return fn
+
+
+def attrs(p):
+    v = k32.GetFileAttributesW(str(p))
+    assert v != 0xFFFFFFFF, "missing path %s" % p
+    return v
+
+
+def setattrs(p, v):
+    assert k32.SetFileAttributesW(str(p), v), "setattr failed on %s" % p
+
+
+def mkfile(p, data=b"data", mtime_ns=None, at=None):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with open(str(p), "wb") as fh:
+        fh.write(data)
+    if mtime_ns is not None:
+        a = at if at is not None else os.stat(str(p)).st_atime_ns
+        os.utime(str(p), ns=(a, mtime_ns))
+    return p
+
+
+def raises(exc_type, fn, *a, **kw):
+    try:
+        fn(*a, **kw)
+    except exc_type as exc:
+        return exc
+    raise AssertionError("expected %s, nothing raised" % exc_type.__name__)
+
+
+DAY = 86400 * 10**9
+OLD = ((time.time_ns() - 3 * DAY) // 100) * 100
+
+
+# ---------------------------------------------------------------- 1 snapshot
+@test
+def snapshot_fields(t):
+    p = mkfile(t / "a.txt")
+    snap = snapshot_times(str(p))
+    st = os.stat(str(p))
+    assert snap["mtime_ns"] == st.st_mtime_ns
+    assert snap["atime_ns"] == st.st_atime_ns
+    assert snap["created"] == st.st_ctime
+    assert isinstance(snap["mtime_ns"], int) and isinstance(snap["atime_ns"], int)
+    assert isinstance(snap["created"], float)
+    assert snap["mtime_ns"] % 100 == 0
+
+
+# ----------------------------------------------------------------- 2 stamping
+@test
+def stamp_file_exact_ns_and_keeps_atime(t):
+    p = mkfile(t / "a.txt")
+    before = snapshot_times(str(p))
+    target = ((before["mtime_ns"] - DAY) // 100) * 100
+    assert target % 100 == 0
+    stamp_file(str(p), target)
+    after = snapshot_times(str(p))
+    assert after["mtime_ns"] == target, (after["mtime_ns"], target)
+    assert after["atime_ns"] == before["atime_ns"], (after["atime_ns"], before["atime_ns"])
+    assert after["created"] == before["created"]
+    assert attrs(str(p)) == attrs(str(p))
+
+
+@test
+def stamp_file_accepts_pathlike(t):
+    p = mkfile(t / "a.txt")
+    before = snapshot_times(str(p))
+    stamp_file(p, before["mtime_ns"] - 1000)
+    after = snapshot_times(str(p))
+    assert after["mtime_ns"] == before["mtime_ns"] - 1000
+    assert after["atime_ns"] == before["atime_ns"]
+
+
+@test
+def stamp_file_readonly_raises_and_writes_nothing(t):
+    p = mkfile(t / "ro.txt")
+    before = snapshot_times(str(p))
+    setattrs(str(p), attrs(str(p)) | RO)
+    exc = raises(WStampError, stamp_file, str(p), before["mtime_ns"] - 10**9)
+    assert exc.kind == "readonly", exc.kind
+    assert isinstance(exc, OSError)
+    after = snapshot_times(str(p))
+    assert after["mtime_ns"] == before["mtime_ns"], "must not write"
+    assert after["atime_ns"] == before["atime_ns"]
+    assert attrs(str(p)) & RO
+
+
+@test
+def stamp_file_missing_path(t):
+    raises(OSError, stamp_file, str(t / "nope.txt"), OLD)
+
+
+@test
+def set_times_helper(t):
+    p = mkfile(t / "a.txt")
+    tgt = ((time.time_ns() - DAY) // 100) * 100
+    set_times(str(p), tgt + 100, tgt)
+    snap = snapshot_times(str(p))
+    assert snap["mtime_ns"] == tgt and snap["atime_ns"] == tgt + 100
+    setattrs(str(p), attrs(str(p)) | RO)
+    exc = raises(WStampError, set_times, str(p), tgt, tgt)
+    assert exc.kind == "readonly"
+
+
+# ------------------------------------------------------------------- 3 copying
+@test
+def copy_stamp_times_and_attrs(t):
+    src = mkfile(t / "s.txt", b"payload")
+    os.utime(str(src), ns=(OLD + 500, OLD))
+    setattrs(str(src), attrs(str(src)) | RO | HIDDEN)
+    snap = snapshot_times(str(src))
+    dst = t / "d.txt"
+    copy_stamp(str(src), str(dst))
+    got = snapshot_times(str(dst))
+    assert got["mtime_ns"] == snap["mtime_ns"], (got["mtime_ns"], snap["mtime_ns"])
+    assert got["atime_ns"] == snap["atime_ns"], (got["atime_ns"], snap["atime_ns"])
+    assert attrs(str(dst)) == attrs(str(src)), (hex(attrs(str(dst))), hex(attrs(str(src))))
+    assert attrs(str(dst)) & RO and attrs(str(dst)) & HIDDEN
+    assert dst.read_bytes() == b"payload"
+
+
+@test
+def copy_stamp_overwrites_readonly_dst(t):
+    src = mkfile(t / "s.txt", b"new")
+    dst = mkfile(t / "d.txt", b"old-old-old")
+    setattrs(str(dst), attrs(str(dst)) | RO)
+    snap = snapshot_times(str(src))
