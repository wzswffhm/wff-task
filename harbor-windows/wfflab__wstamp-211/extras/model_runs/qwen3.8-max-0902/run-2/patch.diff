@@ -0,0 +1,38 @@
+"""TEMPORARY probe 4 - atime bump rule. Will be deleted."""
+import os
+import tempfile
+import time
+
+HOUR = 3600 * 10**9
+root = tempfile.mkdtemp(prefix="wsexp4")
+try:
+    p = os.path.join(root, "f.txt")
+    with open(p, "wb") as fh:
+        fh.write(b"hello world")
+    now = time.time_ns()
+    for label, back in (("2h", 2 * HOUR), ("30m", 30 * 60 * 10**9), ("1min", 60 * 10**9), ("0", 0)):
+        target = ((now - back) // 100) * 100
+        os.utime(p, ns=(target, target))
+        before = os.stat(p).st_atime_ns
+        time.sleep(0.02)
+        with open(p, "rb") as fh:
+            fh.read()
+        after = os.stat(p).st_atime_ns
+        print("atime %s old -> bumped: %s (delta %d ns)" % (label, before != after, after - before))
+
+    # does merely os.stat'ing many times bump? no (checked). does open for write bump mtime only?
+    p2 = os.path.join(root, "g.txt")
+    with open(p2, "wb") as fh:
+        fh.write(b"x")
+    a = os.stat(p2).st_atime_ns
+    with open(p2, "rb") as fh:
+        fh.read()
+    b = os.stat(p2).st_atime_ns
+    with open(p2, "rb") as fh:
+        fh.read()
+    c = os.stat(p2).st_atime_ns
+    print("fresh file: read1 bump", a != b, "read2 bump", b != c, "delta1", b - a, "delta2", c - b)
+finally:
+    import shutil
+    shutil.rmtree(root, ignore_errors=True)
+    print("cleaned:", not os.path.exists(root))
