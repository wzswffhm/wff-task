@@ -0,0 +1,128 @@
+"""TEMPORARY probe - will be deleted."""
+import ctypes
+import os
+import shutil
+import sys
+import tempfile
+
+RO = 0x01
+HIDDEN = 0x02
+k32 = ctypes.windll.kernel32
+
+
+def ga(p):
+    return k32.GetFileAttributesW(str(p))
+
+
+def sa(p, v):
+    if not k32.SetFileAttributesW(str(p), v):
+        raise ctypes.WinError()
+
+
+root = tempfile.mkdtemp(prefix="wsexp")
+try:
+    f = os.path.join(root, "ro.txt")
+    open(f, "wb").write(b"x")
+    print("attrs fresh file:", hex(ga(f)))
+    sa(f, ga(f) | RO)
+    print("attrs after RO:", hex(ga(f)))
+    st = os.stat(f)
+    print("mtime%100", st.st_mtime_ns % 100, "atime%100", st.st_atime_ns % 100)
+    try:
+        os.utime(f, ns=(st.st_atime_ns, st.st_mtime_ns - 1000000))
+        print("utime readonly file: OK (unexpected)")
+    except OSError as e:
+        print("utime readonly file FAILED:", type(e).__name__, e.winerror)
+
+    d = os.path.join(root, "rodir")
+    os.makedirs(d)
+    sa(d, ga(d) | RO)
+    print("dir attrs:", hex(ga(d)))
+    std = os.stat(d)
+    try:
+        os.utime(d, ns=(std.st_atime_ns, std.st_mtime_ns - 1000000))
+        print("utime readonly dir: OK")
+    except OSError as e:
+        print("utime readonly dir FAILED:", type(e).__name__, e.winerror)
+
+    child = os.path.join(d, "child.txt")
+    try:
+        open(child, "wb").write(b"y")
+        print("create file inside readonly dir: OK")
+    except OSError as e:
+        print("create inside readonly dir FAILED:", type(e).__name__, e.winerror)
+    try:
+        os.remove(child)
+        print("remove file inside readonly dir: OK")
+    except OSError as e:
+        print("remove inside readonly dir FAILED:", type(e).__name__, e.winerror)
+
+    f2 = os.path.join(root, "ro2.txt")
+    open(f2, "wb").write(b"z")
+    sa(f2, ga(f2) | RO)
+    try:
+        os.remove(f2)
+        print("remove readonly file: OK (unexpected)")
+    except OSError as e:
+        print("remove readonly file FAILED:", type(e).__name__, e.winerror)
+    try:
+        shutil.rmtree(d)
+        print("rmtree readonly dir: OK")
+    except OSError as e:
+        print("rmtree readonly dir FAILED:", type(e).__name__, e.winerror)
+    try:
+        os.rmdir(d)
+        print("rmdir readonly dir: OK")
+    except OSError as e:
+        print("rmdir readonly dir FAILED:", type(e).__name__, e.winerror)
+
+    missing = os.path.join(root, "nope.txt")
+    print("GA on missing (default restype):", ga(missing), "eq 0xFFFFFFFF:", ga(missing) == 0xFFFFFFFF)
+    k32.GetFileAttributesW.restype = ctypes.c_uint
+    print("GA on missing (DWORD restype):", hex(ga(missing)), "err:", ctypes.GetLastError())
+
+    try:
+        open(root, "rb").read()
+        print("open dir read: OK (unexpected)")
+    except OSError as e:
+        print("open dir read FAILED:", type(e).__name__, e.winerror)
+
+    srcf = os.path.join(root, "src.txt")
+    dstf = os.path.join(root, "dst.txt")
+    open(srcf, "wb").write(b"aaa")
+    open(dstf, "wb").write(b"bbb")
+    sa(dstf, ga(dstf) | RO)
+    try:
+        shutil.copyfile(srcf, dstf)
+        print("copyfile onto readonly dst: OK (unexpected)")
+    except OSError as e:
+        print("copyfile onto readonly dst FAILED:", type(e).__name__, e.winerror)
+
+    tf = os.path.join(root, "ns.txt")
+    open(tf, "wb").write(b"n")
+    t = 1700000000123456700
+    os.utime(tf, ns=(t, t))
+    print("exact 100-multiple roundtrip:", os.stat(tf).st_mtime_ns == t)
+    t2 = 1700000000123456789
+    os.utime(tf, ns=(t2, t2))
+    print("non-multiple:", t2, "->", os.stat(tf).st_mtime_ns, "truncated:", t2 - os.stat(tf).st_mtime_ns)
+
+    pdir = os.path.join(root, "pdir")
+    os.makedirs(os.path.join(pdir, "sub"))
+    sub = os.path.join(pdir, "sub")
+    b = os.stat(pdir).st_mtime_ns
+    sa(sub, ga(sub) | HIDDEN)
+    print("parent mtime changed by child SetFileAttributes:", b != os.stat(pdir).st_mtime_ns)
+    b = os.stat(pdir).st_mtime_ns
+    os.utime(sub, ns=(b, b - 500000000))
+    print("parent mtime changed by child utime:", b != os.stat(pdir).st_mtime_ns)
+finally:
+    for base, dirs, files in os.walk(root):
+        for name in dirs + files:
+            try:
+                sa(os.path.join(base, name), 0x80)
+            except OSError:
+                pass
+    shutil.rmtree(root, ignore_errors=True)
+    print("cleaned:", not os.path.exists(root))
+print(sys.version)
