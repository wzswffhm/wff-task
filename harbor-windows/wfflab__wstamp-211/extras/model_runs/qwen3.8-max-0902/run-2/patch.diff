+"""TEMPORARY probe 3 - atime update behaviour. Will be deleted."""
+import ctypes
+import os
+import shutil
+import tempfile
+import time
+from ctypes import wintypes
+
+root = tempfile.mkdtemp(prefix="wsexp3")
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.SetFileAttributesW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD]
+k32.SetFileAttributesW.restype = wintypes.BOOL
+k32.GetFileAttributesW.argtypes = [wintypes.LPCWSTR]
+k32.GetFileAttributesW.restype = wintypes.DWORD
+try:
+    p = os.path.join(root, "f.txt")
+    with open(p, "wb") as fh:
+        fh.write(b"hello world")
+    a0 = os.stat(p).st_atime_ns
+    m0 = os.stat(p).st_mtime_ns
+    time.sleep(0.05)
+    with open(p, "rb") as fh:
+        fh.read()
+    a1 = os.stat(p).st_atime_ns
+    time.sleep(0.05)
+    a2 = os.stat(p).st_atime_ns
+    time.sleep(0.05)
+    with open(p, "rb") as fh:
+        fh.read()
+    a3 = os.stat(p).st_atime_ns
+    print("read bumped:", a1 != a0, "| stat bumped:", a2 != a1, "| read2 bumped:", a3 != a2)
+    print("deltas:", a1 - a0, a3 - a2)
+    print("mtime stable:", os.stat(p).st_mtime_ns == m0)
+    print("multiples of 100:", all(x % 100 == 0 for x in (a0, a1, a2, a3, m0)))
+
+    cap = os.stat(p).st_atime_ns
+    with open(p, "rb") as fh:
+        fh.read()
+    bumped = os.stat(p).st_atime_ns != cap
+    os.utime(p, ns=(cap, os.stat(p).st_mtime_ns))
+    print("read bumped again:", bumped, "| atime restored exactly:", os.stat(p).st_atime_ns == cap)
+
+    s = os.path.join(root, "s.txt")
+    with open(s, "wb") as fh:
+        fh.write(b"abc")
+    k32.SetFileAttributesW(s, 0x21)
+    d = os.path.join(root, "d.txt")
+    snap = os.stat(s)
+    shutil.copyfile(s, d)
+    os.utime(d, ns=(snap.st_atime_ns, snap.st_mtime_ns))
+    k32.SetFileAttributesW(d, k32.GetFileAttributesW(s))
+    sd = os.stat(d)
+    print("copy: mtime equal:", sd.st_mtime_ns == snap.st_mtime_ns,
+          "| atime equal:", sd.st_atime_ns == snap.st_atime_ns,
+          "| attrs:", hex(k32.GetFileAttributesW(d)), hex(k32.GetFileAttributesW(s)))
+    print("src atime bumped by copy:", os.stat(s).st_atime_ns != snap.st_atime_ns)
+
+    # directory atime bump when listing?
+    dd = os.path.join(root, "dd")
+    os.makedirs(dd)
+    da = os.stat(dd).st_atime_ns
+    dm = os.stat(dd).st_mtime_ns
+    os.listdir(dd)
+    print("dir atime bumped by listdir:", os.stat(dd).st_atime_ns != da,
+          "| dir mtime bumped:", os.stat(dd).st_mtime_ns != dm)
+
+    # makedirs in an existing dir bumps parent mtime?
+    before = os.stat(root).st_mtime_ns
+    os.makedirs(os.path.join(root, "newsub"))
+    print("parent mtime bumped by mkdir:", os.stat(root).st_mtime_ns != before)
+finally:
+    for base, dirs, files in os.walk(root):
+        for name in dirs + files:
+            try:
+                k32.SetFileAttributesW(os.path.join(base, name), 0x80)
+            except OSError:
+                pass
+    shutil.rmtree(root, ignore_errors=True)
+    print("cleaned:", not os.path.exists(root))
