+"""TEMPORARY probe 5 - atime stability right after a write. Deleted before submit."""
+import os
+import shutil
+import tempfile
+import time
+
+root = tempfile.mkdtemp(prefix="wsexp5")
+try:
+    p = os.path.join(root, "a.txt")
+    with open(p, "wb") as fh:
+        fh.write(b"new")
+    vals = []
+    for i in range(12):
+        vals.append(os.stat(p).st_atime_ns)
+        time.sleep(0.005)
+    print("atime samples after write (deltas):", [vals[i + 1] - vals[i] for i in range(len(vals) - 1)])
+    m = [os.stat(p).st_mtime_ns for _ in range(3)]
+    print("mtime stable:", len(set(m)) == 1)
+
+    # now the exact failing sequence
+    q = os.path.join(root, "b.txt")
+    with open(q, "wb") as fh:
+        fh.write(b"other")
+    with open(p, "wb") as fh:
+        fh.write(b"new2")
+    a0 = os.stat(p).st_atime_ns
+    with open(q, "wb") as fh:
+        fh.write(b"xxxxx")
+    a1 = os.stat(p).st_atime_ns
+    shutil.copyfile(p, os.path.join(root, "c.txt"))
+    a2 = os.stat(p).st_atime_ns
+    print("a0", a0, "a1", a1, "a2", a2, "| a1-a0", a1 - a0, "| a2-a1", a2 - a1)
+
+    # does copyfile itself bump src atime when src was just written?
+    r = os.path.join(root, "d.txt")
+    with open(r, "wb") as fh:
+        fh.write(b"z")
+    b0 = os.stat(r).st_atime_ns
+    shutil.copyfile(r, os.path.join(root, "e.txt"))
+    b1 = os.stat(r).st_atime_ns
+    print("copyfile bump on fresh src:", b1 - b0)
+
+    # same but with a 5ms gap between write and snapshot
+    s = os.path.join(root, "f.txt")
+    with open(s, "wb") as fh:
+        fh.write(b"z")
+    time.sleep(0.02)
+    c0 = os.stat(s).st_atime_ns
+    time.sleep(0.02)
+    shutil.copyfile(s, os.path.join(root, "g.txt"))
+    c1 = os.stat(s).st_atime_ns
+    print("copyfile bump after 20ms gap:", c1 - c0)
+finally:
+    shutil.rmtree(root, ignore_errors=True)
+    print("cleaned:", not os.path.exists(root))
