   5| from .errors import WChunkError
   6| 
   7| VARINT_MAX_BYTES = 10  # u64 的 LEB128 上限
   8| 
   9| 
  10| def encode_varint(value: int) -> bytes:
  11|     """把非负整数编码为 LEB128 字节串。"""
  12|     if not isinstance(value, int) or value < 0:
  13|         raise WChunkError("structure", f"varint value {value!r} must be a non-negative int")
  14|     out = bytearray()
  15|     while True:
  16|         byte = value & 0x7F
  17|         value >>= 7
  18|         if value:
  19|             out.append(byte | 0x80)
  20|         else:
  21|             out.append(byte)
  22|             return bytes(out)
  23| 
  24| 
  25| def decode_varint(data: bytes, offset: int) -> tuple[int, int]:
  26|     """从 data[offset:] 解出 LEB128，返回 (value, new_offset)。"""
  27|     result = 0
  28|     shift = 0
  29|     pos = offset
  30|     while True:
  31|         if pos >= len(data):
  32|             raise WChunkError("truncated", "varint runs past end of data")
  33|         byte = data[pos]
  34|         pos += 1
  35|         result |= (byte & 0x7F) << shift
  36|         if not (byte & 0x80):
  37|             return result, pos
  38|         shift += 7
  39|         if shift >= VARINT_MAX_BYTES * 7:
  40|             raise WChunkError("varint", "varint is too long to be valid")
