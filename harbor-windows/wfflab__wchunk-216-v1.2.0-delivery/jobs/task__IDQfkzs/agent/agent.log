```
def unpack(data):
    if not bytes-like: raise structure
    data = bytes(data)
    if len(data) < HEADER_SIZE + FOOTER_SIZE:  # 18
        # but we want to distinguish magic/version errors even for short data?
        raise truncated
    version, count = parse_header(data)  # checks magic, version, reserved
    limit = len(data) - FOOTER_SIZE
    pos = HEADER_SIZE
    records = []
    tag_sum = 0
    for index in range(count):
        if pos + 4 > limit:
            raise truncated (record header incomplete)
        tag, size = struct.unpack_from("<HH", data, pos)
        pos += 4
        if pos + size > limit:
            raise truncated (payload incomplete)
        payload = data[pos:pos+size]
        pos += size
        pad = (-(4 + size)) % 8
        if pos + pad > limit:
            raise truncated (padding incomplete)
        pos += pad
        records.append((tag, payload))
        tag_sum = (tag_sum + tag) & 0xFFFF
