  10| VERSION = 0x02
  11| HEADER_SIZE = 12
  12| 
  13| 
  14| def build_header(record_count: int) -> bytes:
  15|     if record_count < 0:
  16|         raise WChunkError("structure", "record_count must be non-negative")
  17|     return MAGIC + bytes([VERSION]) + struct.pack(">I", record_count) + b"\x00\x00\x00"
  18| 
  19| 
  20| def parse_header(data: bytes) -> tuple[int, int]:
  21|     """校验并解析文件头，返回 (version, record_count)。"""
  22|     if len(data) < HEADER_SIZE:
  23|         raise WChunkError("truncated", f"header needs {HEADER_SIZE} bytes, got {len(data)}")
  24|     if data[:4] != MAGIC:
  25|         raise WChunkError("magic", f"bad magic {data[:4]!r}, expected {MAGIC!r}")
  26|     version = data[4]
