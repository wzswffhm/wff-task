  15| 
  16| 
  17| def _read_exact(fileobj, size: int) -> bytes:
  18|     """按固定大小分块取满 size 字节；读不满则视为截断。"""
  19|     if size <= 0:
  20|         return b""
  21|     chunks = []
  22|     remaining = size
  23|     while remaining > 0:
  24|         chunk = fileobj.read(remaining)
  25|         if not chunk:
  26|             raise WChunkError(
  27|                 "truncated",
  28|                 f"stream ended after {size - remaining} of {size} bytes",
  29|             )
  30|         piece = bytes(chunk)
  31|         chunks.append(piece)
  32|         remaining -= len(piece)
