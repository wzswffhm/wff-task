schema_version = "1.4"                             # 照抄
# 格式： /app/output/{你的交付物名称}
artifacts = [
  "/app/output/<TASKID>_主交付物.xlsx",
  "/app/output/<TASKID>_附图.png",
  "/logs/artifacts/output",
]
[task]
name = "work/<批内短名>"                            # 任务名称
version = "1.0.0"                                  # 任务版本
description = "<一句话：基于什么产出什么>"             # 任务描述
keywords = ["<领域英文名>", "office", "<A1|A2|A3>"]
[metadata]
task_id = "<领域缩写>-<任务类型>-<序号>"              # 题目编号
author_organization = "<供应商名>"
category = "<skill-discovery|skill-generation|skill-dependency|workflow|weakness|…>"
domain = "<通用办公|金融|医疗|法律>"                  # 所属领域
domain_l2 = "<二级标签>"
domain_l3 = "<三级标签>"
domain_l4 = "<四级标签>"
capabilities = "<该任务能评测的具体专业能力>"
difficulty = "<A1|A2|A3>"
vl_dependency = "<是|否>"
source_note = "<为什么选这个任务、真实性如何保障、真实场景中的交付物是什么>"
tools = "<Word/Excel/PPT/Python…>"
domain_knowledge = "<完成任务所需的专业知识说明>"      # 选填
task_complexity = "<C1|C2|C3|C4|C5>"
weakness_tag = ["<Wxx-标签>"]                       # ≥1 项，按算法词表
environment_template = "<平台已确认的环境模板名>"
tool_set = ["filesystem", "shell", "python"]
skill_set = []                                      # 与 environment/skills/<name>/ 逐一对应；无技能写 []
expected_tool_dependencies = ["filesystem", "shell", "python"]   # tool_set 的子集
expected_skill_dependencies = []                    # skill_set 的子集
tags = []
[[metadata.deliverables]]
path = "<TASKID>_主交付物.xlsx"
required = true
desc = "<主交付物说明>"
[[metadata.deliverables]]
path = "<TASKID>_附图.png"
required = true
desc = "<附图说明>"
[agent]
timeout_sec = 72000.0
[verifier]
timeout_sec = 18000.0
user = "root"
[verifier.env]
# Judge 相关变量统一 JUDGE_ 前缀，只写在 [verifier.env]、严禁写入 [environment.env]。
# 必选项（运行环境注入，AP 必给）；可选项一律用 ${VAR:-默认值} 语法给默认值。
JUDGE_API_KEY = "${JUDGE_API_KEY:-}"
JUDGE_BASE_URL = "${JUDGE_BASE_URL:-}"
JUDGE_MODEL = "${JUDGE_MODEL:-qwen3.7-plus}"
JUDGE_PROVIDER = "${JUDGE_PROVIDER:-anthropic}"
JUDGE_API_PROTOCOL = "${JUDGE_API_PROTOCOL:-anthropic}"
# 兼容旧环境的兜底注入
EVAL_API_KEY = "${EVAL_API_KEY:-}"
EVAL_API_BASE = "${EVAL_API_BASE:-}"
LITELLM_DROP_PARAMS = "true"
[environment]
os = "linux"
build_timeout_sec = 18000.0
network_mode = "public"      # claude-code 框架下不要写 no-network
cpus = 2
memory_mb = 8192
storage_mb = 30720           # 照抄
