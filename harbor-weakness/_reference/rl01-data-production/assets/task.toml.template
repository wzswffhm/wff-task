# RL0-1 Cowork 题包 task.toml 模板。尖括号处替换为本题实际内容，不要保留占位符。
schema_version = "1.4"                 # 照抄

# 格式：/app/output/{你的交付物名称}；末尾固定保留 /logs/artifacts/output
artifacts = [
  "/app/output/<题目编号>_<交付物1>",
  "/app/output/<题目编号>_<交付物2>",
  "/logs/artifacts/output",
]

[task]
name = "work/<short-name>"             # 任务名称
version = "1.0.0"
description = "<一句话任务描述>"

[metadata]
task_id = "<题目编号>"
author_organization = "<供应商名>"
category = "<skill-discovery|skill-generation|skill-dependency|dependency-aware-workflow|subagent-workflow|weakness>"
domain = "<通用办公|金融|医疗|法律|数据分析|游戏|设计>"
domain_l2 = "<二级标签，对齐知识体系表>"
domain_l3 = "<三级标签，自行填写并保证同批次唯一性>"
domain_l4 = "<四级标签，描述细分场景>"
capabilities = "<该任务能评测的具体专业能力>"
difficulty = "<A1|A2|A3>"
vl_dependency = "<是|否>"
source_note = "<任务来源、真实性保障、真实场景中的交付物是什么>"
tools = "<Word/Excel/PPT/Python 等>"
domain_knowledge = "<完成任务所需的专业知识，选填>"
task_complexity = "<C1|C2|C3|C4|C5>"   # 按文件数/Requirement/evidence-hop 等硬指标判定
weakness_tag = ["<WXX-名称>"]          # 覆盖 ≥1 个，按算法词表填写
environment_template = "<平台已确认的环境模板名>"
tool_set = ["filesystem", "shell", "python"]
skill_set = ["<environment/skills/ 下的目录名>"]        # 无 skill 时留空数组
expected_tool_dependencies = ["filesystem", "shell", "python"]
expected_skill_dependencies = ["<skill_set 的子集>"]     # Skill Discovery 时必须严格小于 skill_set
tags = ["<领域>", "office", "<A1|A2|A3>", "<category>"]

[[metadata.deliverables]]
path = "<交付物1 文件名，与 artifacts、参考答案一致>"
required = true
desc = "<主交付物描述>"

[[metadata.deliverables]]
path = "<交付物2 文件名>"
required = true
desc = "<交付物描述>"

[agent]
timeout_sec = 72000.0

[verifier]
timeout_sec = 18000.0
user = "root"

[verifier.env]
# JUDGE_ 变量只允许写在本段，严禁写入 [environment.env]。可选项统一用 ${VAR:-默认值}。
JUDGE_API_KEY = "${JUDGE_API_KEY:-}"
JUDGE_BASE_URL = "${JUDGE_BASE_URL:-}"
JUDGE_MODEL = "${JUDGE_MODEL:-qwen3.7-plus}"
JUDGE_PROVIDER = "${JUDGE_PROVIDER:-anthropic}"
JUDGE_API_PROTOCOL = "${JUDGE_API_PROTOCOL:-anthropic}"
EVAL_API_KEY = "${EVAL_API_KEY:-}"
EVAL_API_BASE = "${EVAL_API_BASE:-}"
LITELLM_DROP_PARAMS = "true"

[environment]
os = "linux"
build_timeout_sec = 18000.0
network_mode = "public"                # claude-code 框架下不要写 no-network
cpus = 2
memory_mb = 8192
storage_mb = 30720                     # 照抄
