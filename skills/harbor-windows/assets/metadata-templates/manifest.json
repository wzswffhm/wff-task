{
  "_comment": "delivery-extras/tasks/<task-id>/metadata/manifest.json —— 身份三元组与制品哈希",
  "_identity": "唯一验收身份 = task_id + task_version + task_hash。task.toml / swelive_spec.json / harbor JSON / 本文件必须完全一致。",

  "task_id": "<task-id>",
  "task_version": "1.0",
  "task_hash": "<sha256>",

  "source_commit": "<sha>",
  "base_commit": "<sha>",

  "image_ref": "<registry>/<namespace>/<repo>:<tag>",
  "image_digest": "sha256:<digest>",

  "artifacts": {
    "task_toml_sha256": "<sha256>",
    "instruction_md_sha256": "<sha256>",
    "test_patch_sha256": "<sha256>",
    "oracle_patch_sha256": "<sha256>",
    "spec_sha256": "<sha256>",
    "dockerfile_sha256": "<sha256>"
  },

  "windows_target": {
    "version": "<Windows 11 24H2 / Server 2022>",
    "edition": "<Pro / Enterprise>",
    "arch": "<x64 / arm64>",
    "locale": "<en-US>"
  },

  "frozen_baseline": {
    "harbor_schema": "1.3",
    "harness": "harbor-rewardkit==0.1.7",
    "models": ["Qwen3.8-Max-0902", "Opus 5", "GLM-5.3", "Kimi K3"],
    "frozen_at": "<YYYY-MM-DD>",
    "tool_permissions": "<air-gapped / allowlist 说明>",
    "network_policy": "<断网要求>",
    "sampling": {
      "temperature": 0.0,
      "top_p": 1.0
    },
    "budget": {
      "agent_timeout_sec": 43200,
      "verifier_timeout_sec": 7200
    }
  },

  "checksums": {
    "algorithm": "sha256",
    "file": "checksums.sha256",
    "covers": ["outside_harbor/", "outside_harbor-assets/", "delivery-extras/"]
  },

  "reviewers": [
    {"role": "<出题人 / 质检人 / 验收人>", "name": "<name>", "reviewed_at": "<YYYY-MM-DD>"}
  ]
}
