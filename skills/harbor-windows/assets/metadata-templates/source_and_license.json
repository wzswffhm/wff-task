{
  "_comment": "delivery-extras/tasks/<task-id>/metadata/source_and_license.json —— 题目来源与授权",
  "task_id": "<task-id>",
  "task_version": "1.0",

  "source": {
    "repo": "<owner/repo>",
    "repo_url": "<https://github.com/owner/repo>",
    "base_commit": "<sha>",
    "source_commit": "<sha>",
    "issue_numbers": ["<n>"],
    "pull_number": "<n>",
    "pull_url": "<https://github.com/owner/repo/pull/n>",
    "created_at": "<YYYY-MM-DDTHH:MM:SSZ>"
  },

  "license": {
    "spdx": "<MIT / Apache-2.0 / BSD-3-Clause / ...>",
    "license_file": "<path in repo>",
    "allows_derivative": true,
    "allows_redistribution": true,
    "attribution_required": true,
    "notes": "<任何需要保留的署名/声明>"
  },

  "authorization": {
    "source": "<public repo / 客户授权 / 内部数据>",
    "obtained_by": "<获取方式>",
    "obtained_at": "<YYYY-MM-DD>",
    "evidence": "<授权凭证存放位置或引用>",
    "allows_evaluation_use": true,
    "allows_vendor_delivery": true
  },

  "privacy": {
    "contains_personal_data": false,
    "contains_secrets": false,
    "sanitized": true,
    "sanitization_notes": "<脱敏说明：替换了哪些账户目录/路径/端点>",
    "sanitization_audit_ref": "<审计文件路径>"
  },

  "windows_relevance": {
    "target_os": "Windows",
    "counterfactual_checked": true,
    "would_hold_on_linux": false,
    "reason": "<若换 Linux/macOS，主要实现/错误根因/Evaluator 会如何改变？>"
  }
}
