{
  "_comment": "delivery-extras/tasks/<task-id>/metadata/lineage_and_contamination.json —— 衍生关系与污染/重复风险",
  "task_id": "<task-id>",
  "task_version": "1.0",

  "lineage": {
    "derived_from": null,
    "derivation_type": "<original / ported / split / merged / reworked>",
    "parent_task_ids": [],
    "notes": "<若衍生自其他题，说明改了哪些部分；null 表示原创>"
  },

  "contamination": {
    "checked": true,
    "risk_level": "<none / low / medium / high>",
    "checked_against": [
      "<训练集名称/版本，如 SWE-bench-Live、公开 PR 数据集>",
      "<内部已交付题包批次>"
    ],
    "overlap_found": false,
    "mitigation": "<若存在污染风险，采取了什么缓解措施>",
    "evidence": "<检索方式与命中的记录位置>"
  },

  "duplication": {
    "checked": true,
    "is_duplicate": false,
    "is_surface_variant": false,
    "similar_tasks": [
      {
        "task_id": "<可能相似的题>",
        "similarity": "<low / medium / high>",
        "differentiator": "<与本题的实质差异>"
      }
    ],
    "notes": "<注意：'同一仓库不同 PR' 不等于重复；判断标准是实现、根因、验证是否实质相同>"
  },

  "hack_and_leak_review": {
    "reviewed": true,
    "network_seeking_answers": "<attempted / accessed / used / affected_score / none>",
    "local_answer_search": "<attempted / accessed / used / affected_score / none>",
    "verifier_tampering": "<attempted / accessed / used / affected_score / none>",
    "stale_artifact_reuse": "<attempted / accessed / used / affected_score / none>",
    "notes": "<注意：关键词未命中不等于绝对无 Hack；请求失败不等于下载成功>"
  }
}
